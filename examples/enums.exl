// Algebraic data types — all three variant forms.
//
// Declaration uses leading `|` per variant (OCaml/F# style; differs
// from Rust's trailing `,`).  A variant is one of:
//   | Name                              // unit
//   | Name(T1, T2)                      // tuple — positional payload
//   | Name { field: T, ... }            // struct — named payload
//
// Construction is qualified — `Direction::North`, `Shape::Circle(5)`,
// `Shape::Triangle { base: 3, height: 4 }`.  `match` is exhaustive,
// runs every arm only when its pattern fires, and is an expression
// (let-RHS or `return`).  Patterns may bind by position, by name, or
// shorthand: `Triangle { base, height }` ≡ `Triangle { base: base,
// height: height }`.

pub enum Direction {
    | North
    | South
    | East
    | West
}

pub enum Shape {
    | Square
    | Circle(int)
    | Rect(int, int)
    | Triangle { base: int, height: int }
}

fn describe_dir(d: Direction) {
    match d {
        | Direction::North => println("up")
        | Direction::South => println("down")
        | _ => println("sideways")           // East and West together
    }
}

fn describe_shape(s: Shape) {
    match s {
        | Shape::Square => println("a square")
        | Shape::Circle(r) => println(r)              // r : int
        | Shape::Rect(w, _) => println(w)             // height ignored
        | Shape::Triangle { base, height: h } => println(base + h)
                                                    // shorthand + rename
    }
}

fn area(s: Shape) -> int {
    return match s {
        | Shape::Square => 1
        | Shape::Circle(r) => r * r * 3             // ~pi*r*r, ints only
        | Shape::Rect(w, h) => w * h
        | Shape::Triangle { base, height } => base * height / 2
    };
}

fn main() {
    let d = Direction::East;
    describe_dir(d);                        // "sideways"

    // Enum constructors and `match` work in arbitrary sub-expression
    // positions — the compiler hoists each into an internal `__lift_N`
    // temp before the surrounding statement so C89 stays simple.
    describe_shape(Shape::Square);          // "a square"
    describe_shape(Shape::Circle(7));       // 7
    describe_shape(Shape::Rect(10, 20));    // 10

    println(area(Shape::Circle(5)));          // 75 (5 * 5 * 3)
    println(area(Shape::Rect(3, 4)));         // 12
    println(area(Shape::Triangle { base: 6, height: 8 }));  // 24
    describe_shape(Shape::Triangle { base: 1, height: 2 }); // 3

    // match-as-expression on a let RHS, with another match nested in
    // an arm.  Each variant runs only its arm — lift doesn't change
    // that.
    let total = 1 + match Shape::Circle(2) {
        | Shape::Square => 0
        | Shape::Circle(r) => r
        | Shape::Rect(w, h) => w + h
        | Shape::Triangle { base, height } => base + height
    };
    println(total);                           // 3
}
