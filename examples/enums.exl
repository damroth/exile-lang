// Algebraic data types — Phases A, B, C.
//
// Declaration uses leading `|` per variant (OCaml/F# style; differs
// from Rust's trailing `,`).  Three variant forms are designed; this
// example uses unit and tuple variants (struct-like variants land
// later).
//
// Construction is qualified: `Direction::North`, `Shape::Circle(5)`.
// `match` is exhaustive — every variant must be reached, either via
// an explicit arm or a wildcard `_`.  Tuple-variant patterns can bind
// the payload (`Shape::Rect(w, h)`); `_` skips a payload field.
//
// `match` is an expression: it can sit on a let RHS or in `return`,
// with each arm supplying a value of the common arm type.  As a
// statement (the Phase A form) it just dispatches side effects.

pub enum Direction {
    | North
    | South
    | East
    | West
}

pub enum Shape {
    | Square
    | Circle(int)
    | Rect(int, int)
}

fn describe_dir(d: Direction) {
    match d {
        | Direction::North => print("up")
        | Direction::South => print("down")
        | _ => print("sideways")           // East and West together
    }
}

fn describe_shape(s: Shape) {
    match s {
        | Shape::Square => print("a square")
        | Shape::Circle(r) => print(r)              // r : int
        | Shape::Rect(w, _) => print(w)             // height ignored
    }
}

// Phase C: match returns a value used in `return`.
fn area(s: Shape) -> int {
    return match s {
        | Shape::Square => 1
        | Shape::Circle(r) => r * r * 3             // ~pi*r*r, ints only
        | Shape::Rect(w, h) => w * h
    };
}

fn main() {
    // Enum constructors still need a let binding when used as an arg
    // (sub-expression position is queued for a later iteration).
    let d = Direction::East;
    describe_dir(d);                        // "sideways"

    let sq = Shape::Square;
    let c = Shape::Circle(7);
    let r = Shape::Rect(10, 20);
    describe_shape(sq);                     // "a square"
    describe_shape(c);                      // 7
    describe_shape(r);                      // 10

    // Phase C: match-as-expression on a let RHS.
    let a = match r {
        | Shape::Square => 0
        | Shape::Circle(rad) => rad
        | Shape::Rect(w, h) => w + h
    };
    print(a);                               // 30

    print(area(sq));                        // 1
    print(area(c));                         // 147 (7 * 7 * 3)
    print(area(r));                         // 200 (10 * 20)
}
