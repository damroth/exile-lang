fn abs(x: int) -> int {
    if x < 0 {
        return -x;
    } else {
        return x;
    }
}

fn classify(n: int) -> int {
    if n < 0 {
        return -1;
    } else if n == 0 {
        return 0;
    } else {
        return 1;
    }
}

fn main() {
    println(abs(-7));
    println(abs(3));

    println(classify(-5));
    println(classify(0));
    println(classify(42));
}
