fn lifo() {
    defer println("third");
    defer println("second");
    defer println("first");
    println("body");
}

fn block_defer() {
    defer { println("a"); println("b"); println("c"); }
    println("body");
}

fn early_exit(n: int) -> int {
    defer println("outer cleanup");
    if n > 0 {
        defer println("inner cleanup");
        return n * 2;
    }
    return 0;
}

fn void_early_exit(skip: bool) {
    defer println("cleanup");
    if skip {
        println("skipped");
        return;
    }
    println("worked");
}

fn main() {
    lifo();
    println("---");
    block_defer();
    println("---");
    println(early_exit(5));
    println("---");
    println(early_exit(-3));
    println("---");
    void_early_exit(true);
    println("---");
    void_early_exit(false);
}
