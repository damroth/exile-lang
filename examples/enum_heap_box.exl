// Heap-boxed enum tuple-variants (DR-031) + Owner-sigil ownership.
//
// `new(alloc) Enum::Variant(args)` heap-allocates the enum value and
// yields `own *Enum` - mirror of `new(alloc) Struct { ... }` for
// struct literals, extended to the enum tuple-variant constructor.
// The faithful OCaml-variant -> Exile-enum-AST port wants this: the
// typical OCaml AST type is a recursive enum whose payloads carry
// pointers to subtrees, so building a tree shape on the heap reaches
// for `new(alloc)` at every internal node.
//
// Parser dispatches on the token following `new(alloc) <path>`:
//   - `{` -> struct heap-init (`new(a) Foo { f: 1 }`)
//   - `(` -> enum tuple-variant heap-box (`new(a) Foo::Bar(1, 2)`)
// Anything else is rejected with a clear message.
//
// Struct-variant heap-boxing (`new(a) Foo::Bar { f: 1 }`) defers to a
// follow-up; the v1 ship covers the tuple-variant case the AST port
// needs.

// Recursive enum AST: the inner constructors OWN their subtrees, so
// each payload is `own *Expr` (DR-030 Owner-sigil).  A node owning its
// children is what lets `free_tree` release the whole tree exactly
// once, and is what a synthesised recursive drop will eventually do
// automatically.

enum Expr {
    Lit(int)
    | Add(own *Expr, own *Expr)
    | Mul(own *Expr, own *Expr)
}

// `eval` only reads, so it borrows the tree as `*const Expr`.  An
// `own *Expr` argument is lent to the borrow parameter without being
// consumed (DR-030 own-borrow rule), so the caller keeps ownership.
fn eval(e: *const Expr) -> int {
    match *e {
        Expr::Lit(n) => n
        | Expr::Add(a, b) => eval(a) + eval(b)
        | Expr::Mul(a, b) => eval(a) * eval(b)
    }
}

// Walk the tree depth-first and free each node.  `free_tree` takes
// ownership (`own *Expr`) plus the allocator the tree was built from:
// `free(al, e)` releases through the allocator seam, symmetric with
// `new(al)`.  Each owning child payload is moved into the recursive
// call, then the node itself is freed.  Manual today; an arena makes
// the whole walk unnecessary (free-wholesale).
fn free_tree(al: Allocator, e: own *Expr) {
    match *e {
        Expr::Lit(_n) => { }
        | Expr::Add(a, b) => { free_tree(al, a); free_tree(al, b); }
        | Expr::Mul(a, b) => { free_tree(al, a); free_tree(al, b); }
    }
    free(al, e);
}

fn main() {
    let a = default_allocator();

    // Build (3 * 7) + (5 * 4) + 1 = 42 on the heap.
    let three = new(a) Expr::Lit(3);
    let seven = new(a) Expr::Lit(7);
    let twentyone = new(a) Expr::Mul(three, seven);

    let five = new(a) Expr::Lit(5);
    let four = new(a) Expr::Lit(4);
    let twenty = new(a) Expr::Mul(five, four);

    let one = new(a) Expr::Lit(1);

    let lhs = new(a) Expr::Add(twentyone, twenty);
    let root = new(a) Expr::Add(lhs, one);

    println(eval(root));            // 42

    free_tree(a, root);
}
