// A sibling file-module loaded by main.exl.  Only `pub` items cross the
// module boundary — `private_helper` stays invisible to importers even
// under `use lib::*`.
pub fn greet(name: str) {
    println(name);
}

pub fn shout() {
    println("HEY!");
}

fn private_helper() {
    println("you cannot see me");
}
