struct Point {
    x: int,
    y: int,
}

struct Rect {
    origin: Point,
    width: int,
    height: int,
}

fn make_point(x: int, y: int) -> Point {
    return Point { x: x, y: y };
}

fn shift(p: Point, dx: int, dy: int) -> Point {
    return Point { x: p.x + dx, y: p.y + dy };
}

fn area(r: Rect) -> int {
    return r.width * r.height;
}

fn main() {
    let p = make_point(3, 4);
    print(p.x);
    print(p.y);

    let q = shift(p, 10, 20);
    print(q.x);
    print(q.y);

    let r = Rect {
        origin: make_point(0, 0),
        width: 8,
        height: 5,
    };
    print(area(r));

    r.width = 10;
    print(area(r));
}
