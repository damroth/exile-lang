struct Point {
    x: int,
    y: int,
}

struct Rect {
    origin: Point,
    width: int,
    height: int,
}

fn make_point(x: int, y: int) -> Point {
    return Point { x: x, y: y };
}

fn shift(p: Point, dx: int, dy: int) -> Point {
    return Point { x: p.x + dx, y: p.y + dy };
}

fn area(r: Rect) -> int {
    return r.width * r.height;
}

// Functional update: `..base` copies the remaining fields from `base`.
// Useful when only one or two fields change — no need to retype the rest.
fn taller(r: Rect, by: int) -> Rect {
    return Rect { height: r.height + by, ..r };
}

fn main() {
    let p = make_point(3, 4);
    print(p.x);
    print(p.y);

    let q = shift(p, 10, 20);
    print(q.x);
    print(q.y);

    let r = Rect {
        origin: make_point(0, 0),
        width: 8,
        height: 5,
    };
    print(area(r));

    r.width = 10;
    print(area(r));

    let r2 = taller(r, 3);
    print(area(r2));            // width 10 * height 8 = 80
}
