fn add(a: int, b: int) -> int {
    return a + b;
}

fn square(n: int) -> int {
    return n * n;
}

fn power(base: int, exp: int) -> int {
    let result = 1;
    let i = 0;
    while i < exp {
        result = result * base;
        i = i + 1;
    }
    return result;
}

fn greet(name: str) {
    print(name);
}

fn main() {
    print(add(3, 4));
    print(square(5));
    print(power(2, 10));
    greet("hello from functions");
}
