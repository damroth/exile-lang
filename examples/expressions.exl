// Expression-based bodies.  A block's trailing expression — the last one,
// written without a `;` — is the block's value.  A function whose body
// ends in such an expression returns it (no `return` needed), and `if` is
// an expression usable in value position: `else` is required and both
// branches must be a single expression of the same type.  `match` works
// the same way (see enums.exl).

// `if` chained as an expression — each arm is one expression; the whole
// chain is this function's returned value.
fn classify(n: int) -> str {
    if n < 0 {
        "negative"
    } else if n == 0 {
        "zero"
    } else {
        "positive"
    }
}

// A bare trailing expression is the return value.
fn twice(n: int) -> int {
    n * 2
}

fn main() {
    // `if` as an expression on the right of a binding.
    let label = if 7 > 3 { "big" } else { "small" };
    println(label);

    println(classify(-4));
    println(classify(0));
    println(classify(9));

    println(twice(21));
}
