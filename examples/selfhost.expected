(struct Point (fields (field x (int i32)) (field y (int i32))))
(enum Shape (variants (variant Circle (int i32)) (variant Rect (field w (int i32)) (field h (int i32)))))
(fn area (params (param s (const-ptr (struct Shape)))) (int i32) (body (tail (match (deref (var s)) (arm (pat-variant Shape::Circle (pat-var r)) (binop * (var r) (var r))) (arm (pat-variant Shape::Rect (field w (pat-var w)) (field h (pat-var h))) (binop * (var w) (var h)))))))
