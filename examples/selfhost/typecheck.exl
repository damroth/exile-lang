// Self-host port — `lib/typecheck.ml` (the type checker / elaborator).
//
// Staged port.  `check_program` lowers the parsed `Vec<Item>` into the
// typed IR (`Tprogram`) that codegen consumes.  This is the critical-path
// module (~12K LOC in the oracle); it is filled in feature by feature,
// verified against `exilc --emit-typed-ir --user-only` byte-for-byte.
//
// SLICE 1 (this file's current reach): function signatures — params and
// return types resolved through `resolve_type_ann` for the primitive /
// pointer type domain — plus the fixed prelude `mono-instances` footprint.
// Bodies are not yet elaborated (emitted empty); a function whose oracle
// body is non-empty therefore lands in the gate's deferred bucket.

use pos::*;
use ast::*;
use ir::*;
use error::*;

// ===== Typ node allocation =====

fn ty_node(ar: *Arena, t: Typ) -> *const Typ {
    let n: *Typ = ar.alloc_borrowed();
    *n = t;
    return n as *const Typ;
}

// ===== Type-annotation resolution (AST `TypeAnn` -> IR `Typ`) =====
//
// SLICE 1: the primitive + pointer domain.  Aggregate / nominal / generic
// forms (struct, tuple, array, fn-ptr, Self) are deferred — they resolve
// to a `TCVoid` placeholder so a fn carrying one simply diverges from the
// oracle and lands in the deferred bucket rather than crashing.

fn resolve_type_ann(a: Allocator, ar: *Arena, ann: *const TypeAnn) -> *const Typ {
    return match *ann {
        TypeAnn::TyInt { is_signed, width } =>
            ty_node(ar, Typ::TInt(IntKind { is_signed: is_signed, width: width }))
        | TypeAnn::TyCInt { is_signed } => ty_node(ar, Typ::TCInt { is_signed: is_signed })
        | TypeAnn::TyCShort { is_signed } => ty_node(ar, Typ::TCShort { is_signed: is_signed })
        | TypeAnn::TyCLong { is_signed } => ty_node(ar, Typ::TCLong { is_signed: is_signed })
        | TypeAnn::TyCChar => ty_node(ar, Typ::TCChar)
        | TypeAnn::TyCSChar => ty_node(ar, Typ::TCSChar)
        | TypeAnn::TyCUChar => ty_node(ar, Typ::TCUChar)
        | TypeAnn::TyCVoid => ty_node(ar, Typ::TCVoid)
        | TypeAnn::TyStr => ty_node(ar, Typ::TString)
        | TypeAnn::TyBool => ty_node(ar, Typ::TBool)
        | TypeAnn::TyFloat(w) => ty_node(ar, Typ::TFloat(w))
        | TypeAnn::TyPtr(t) => ty_node(ar, Typ::TPtr(resolve_type_ann(a, ar, t)))
        | TypeAnn::TyOwnPtr(t) => ty_node(ar, Typ::TOwnPtr(resolve_type_ann(a, ar, t)))
        | TypeAnn::TyConstPtr(t) => ty_node(ar, Typ::TConstPtr(resolve_type_ann(a, ar, t)))
        | _other => ty_node(ar, Typ::TCVoid)
    };
}

// ===== Named-type resolution (signature path) =====
//
// Function bodies are still masked by the differential gate, so the body
// resolver above keeps lowering named types to `c_void` there.  Signatures
// ARE compared, so they resolve names properly: a single-segment name that
// is a type-parameter in scope becomes `TVar`, a known user/prelude enum
// becomes `TEnum`, anything else a `TStruct` (generic applications keep
// their resolved arguments); tuples lower element-wise.

// A top-level integer `const` whose value is a literal — enough to fold an
// array size `[T; N]` where `N` is a named constant (the common case).
struct IntConst {
    ic_name: str,
    ic_val: int,
}

struct TyScope {
    sc_structs: *const Vec<str>,
    sc_enums: *const Vec<str>,
    sc_tparams: *const Vec<str>,
    sc_iconsts: *const Vec<IntConst>,
}

fn iconst_lookup(consts: *const Vec<IntConst>, name: str) -> int {
    let n = consts.length();
    let sl = consts.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].ic_name, name) { return sl[i].ic_val; }
        i = i + 1 as u32;
    }
    return 0 as int;
}

fn name_in(names: *const Vec<str>, n: str) -> bool {
    let cnt = names.length();
    let sl = names.as_slice();
    let mut i = 0 as u32;
    while i < cnt {
        if str::eq(sl[i], n) { return true; }
        i = i + 1 as u32;
    }
    return false;
}

fn resolve_sig_args(a: Allocator, ar: *Arena, sc: *const TyScope,
                    args: *const Vec<*const TypeAnn>) -> Vec<*const Typ> {
    let mut out: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n {
        out.push(resolve_sig_ty(a, ar, sc, sl[i]));
        i = i + 1 as u32;
    }
    return out;
}

fn resolve_named_ty(a: Allocator, ar: *Arena, sc: *const TyScope,
                    path: *const Vec<str>, args: *const Vec<*const TypeAnn>) -> *const Typ {
    let plen = path.length();
    let psl = path.as_slice();
    let last = psl[plen - 1 as u32];
    if plen == 1 as u32 {
        if name_in(sc.sc_tparams, last) { return ty_node(ar, Typ::TVar(last)); }
    }
    let newpath = copy_strs(a, path);
    let nargs = args.length();
    if name_in(sc.sc_enums, last) {
        if nargs == 0 as u32 { return ty_node(ar, Typ::TEnum(newpath)); }
        return ty_node(ar, Typ::TEnumApp { path: newpath, args: resolve_sig_args(a, ar, sc, args) });
    }
    if nargs == 0 as u32 { return ty_node(ar, Typ::TStruct(newpath)); }
    return ty_node(ar, Typ::TStructApp { path: newpath, args: resolve_sig_args(a, ar, sc, args) });
}

// Array size is a const expression: a literal, or a reference to a
// top-level integer constant (folded through the scope's const table).
// Anything else defers to 0, leaving the sig visibly off rather than
// crashing.
fn array_size_of(size: *const Expr, sc: *const TyScope) -> int {
    return match *size {
        Expr::IntLit(n, _q) => n
        | Expr::Var(nm, _q) => iconst_lookup(sc.sc_iconsts, nm)
        | _e => 0 as int
    };
}

fn resolve_sig_ty(a: Allocator, ar: *Arena, sc: *const TyScope, ann: *const TypeAnn) -> *const Typ {
    return match *ann {
        TypeAnn::TyPtr(t) => ty_node(ar, Typ::TPtr(resolve_sig_ty(a, ar, sc, t)))
        | TypeAnn::TyOwnPtr(t) => ty_node(ar, Typ::TOwnPtr(resolve_sig_ty(a, ar, sc, t)))
        | TypeAnn::TyConstPtr(t) => ty_node(ar, Typ::TConstPtr(resolve_sig_ty(a, ar, sc, t)))
        | TypeAnn::TyStruct { path, args } => resolve_named_ty(a, ar, sc, &path, &args)
        | TypeAnn::TyTuple(elems) => ty_node(ar, Typ::TTuple(resolve_sig_args(a, ar, sc, &elems)))
        | TypeAnn::TyArray { elem, size } =>
            ty_node(ar, Typ::TArray { elem: resolve_sig_ty(a, ar, sc, elem), size: array_size_of(size, sc) })
        | _other => resolve_type_ann(a, ar, ann)
    };
}

fn resolve_param_tys(a: Allocator, ar: *Arena, sc: *const TyScope, params: *const Vec<Param>) -> Vec<*const Typ> {
    let mut out: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let n = params.length();
    let sl = params.as_slice();
    let mut i = 0 as u32;
    while i < n {
        out.push(resolve_sig_ty(a, ar, sc, sl[i].pty));
        i = i + 1 as u32;
    }
    return out;
}

fn resolve_sig_ret(a: Allocator, ar: *Arena, sc: *const TyScope, ret: Option<*const TypeAnn>) -> Option<*const Typ> {
    return match ret {
        Option::Some(t) => Option::Some(resolve_sig_ty(a, ar, sc, t))
        | Option::None => Option::None
    };
}

// Body-path return resolver (masked): named types stay `c_void` until the
// body elaborator can type their constructors.
fn resolve_ret(a: Allocator, ar: *Arena, ret: Option<*const TypeAnn>) -> Option<*const Typ> {
    return match ret {
        Option::Some(t) => Option::Some(resolve_type_ann(a, ar, t))
        | Option::None => Option::None
    };
}

// `Param` is fully copyable (str / pointer / bool / Option<str>), so the
// param list can be rebuilt for the IR `Tfunc` without moving it out of
// the affine `Vec<Item>` the parser owns.
fn copy_params(a: Allocator, src: *const Vec<Param>) -> Vec<Param> {
    let mut out: Vec<Param> = Vec::with_capacity(a, 8 as u32);
    let n = src.length();
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < n {
        out.push(Param { pname: sl[i].pname, pty: sl[i].pty, is_mut: sl[i].is_mut, preg: sl[i].preg });
        i = i + 1 as u32;
    }
    return out;
}

// ===== Body elaboration (slice 2) =====
//
// Elaborates expressions / statements into typed IR (`Texpr` / `Tstmt`).
// SLICE 2 reach: scalar expressions (int / bool / str / null / float
// literals, var lookup, unary neg/bitnot/not, binops, `println`/`print`
// builtins) and `let` / `expr-stmt` statements.  Control flow, user calls,
// method calls, aggregates, etc. fall to a `c_void` placeholder so the
// enclosing fn diverges (gate: SIG-DIVERGE) rather than crashing.

fn te_node(ar: *Arena, node: TexprNode, ty: *const Typ, pos: Pos) -> *const Texpr {
    let n: *Texpr = ar.alloc_borrowed();
    *n = Texpr { e: node, ty: ty, pos: pos };
    return n as *const Texpr;
}

fn t_i32(ar: *Arena) -> *const Typ {
    return ty_node(ar, Typ::TInt(IntKind { is_signed: true, width: IntWidth::W32 }));
}
fn t_bool(ar: *Arena) -> *const Typ { return ty_node(ar, Typ::TBool); }
fn t_str(ar: *Arena) -> *const Typ { return ty_node(ar, Typ::TString); }

// Deferral marker: an unsupported construct lowers to `null :ty c_void`
// (the oracle never types `null` as `c_void`, so it is unambiguous).  Used
// for BOTH unsupported expressions AND unsupported statements so that
// incompleteness is always VISIBLE at the source / dump level — a dropped
// statement leaves a `(expr-stmt null :ty c_void)` placeholder rather than
// silently vanishing, keeping the deferred-work-must-be-visible invariant.
fn defer_expr(ar: *Arena, p: Pos) -> *const Texpr {
    return te_node(ar, TexprNode::TNullLit, ty_node(ar, Typ::TCVoid), p);
}
fn zero_pos() -> Pos { return Pos { line: 0 as int, col: 0 as int, file: "" }; }

fn none_ty() -> Option<*const Typ> {
    let n: Option<*const Typ> = Option::None;
    return n;
}

fn is_tint(t: *const Typ) -> bool {
    return match *t {
        Typ::TInt(_k) => true
        | _e => false
    };
}

// Most recent binding wins (shadowing): scan the env tail-first.
fn env_lookup(env: *const Vec<FieldTy>, name: str) -> Option<*const Typ> {
    let n = env.length();
    let sl = env.as_slice();
    let mut i = n;
    while i > 0 as u32 {
        i = i - 1 as u32;
        if str::eq(sl[i].name, name) { return Option::Some(sl[i].ty); }
    }
    return none_ty();
}

// An int literal adopts a fitting `TInt` expected type (bidirectional),
// else defaults to i32.  (The fit check is deferred — examples are valid.)
fn int_lit_ty(ar: *Arena, expected: Option<*const Typ>) -> *const Typ {
    return match expected {
        Option::Some(t) => pick_int_ty(ar, t)
        | Option::None => t_i32(ar)
    };
}
fn pick_int_ty(ar: *Arena, t: *const Typ) -> *const Typ {
    if is_tint(t) { return t; }
    return t_i32(ar);
}

// ===== Global symbol table (top-level fns + consts) =====
//
// Built in a first pass over the items so a call `foo(...)` resolves to the
// mangled C symbol + return type, and a bare `WIDTH` to its mangled const,
// before any body is elaborated.  `is_const` separates the two: a call
// dispatches on fns, a value reference on consts.  Fully copyable.
struct GlobalFn {
    name: str,
    mangled: str,
    ret: Option<*const Typ>,
    is_const: bool,
    is_top: bool,
}

// A bare name resolves only against top-level symbols (a module-internal
// symbol is reachable solely through its `mod::name` path → by mangled).
fn global_lookup(g: *const Vec<GlobalFn>, name: str) -> Option<GlobalFn> {
    let n = g.length();
    let sl = g.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if sl[i].is_top && str::eq(sl[i].name, name) {
            return Option::Some(GlobalFn { name: sl[i].name, mangled: sl[i].mangled,
                ret: sl[i].ret, is_const: sl[i].is_const, is_top: sl[i].is_top });
        }
        i = i + 1 as u32;
    }
    let none: Option<GlobalFn> = Option::None;
    return none;
}

fn global_lookup_by_mangled(g: *const Vec<GlobalFn>, mangled: str) -> Option<GlobalFn> {
    let n = g.length();
    let sl = g.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].mangled, mangled) {
            return Option::Some(GlobalFn { name: sl[i].name, mangled: sl[i].mangled,
                ret: sl[i].ret, is_const: sl[i].is_const, is_top: sl[i].is_top });
        }
        i = i + 1 as u32;
    }
    let none: Option<GlobalFn> = Option::None;
    return none;
}

// `mod::name` mangling (ir.mangle): top-level → `ex_name`, else the module
// path joined by `__` then the name (`flags::RW` → `flags__RW`).
fn mangle_path(a: Allocator, ar: *Arena, path: *const Vec<str>, name: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    if path.length() == 0 as u32 {
        sb.push_str("ex_");
        sb.push_str(name);
    } else {
        let n = path.length();
        let sl = path.as_slice();
        let mut i = 0 as u32;
        while i < n { sb.push_str(sl[i]); sb.push_str("__"); i = i + 1 as u32; }
        sb.push_str(name);
    }
    return str::from_slice(ar, sb.as_slice());
}

// A local binding resolves to `TVar(name)`; otherwise a top-level `const`
// resolves to `TVar(mangled)` with its declared type.  Unknown names defer.
fn elab_var(ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>, name: str, p: Pos) -> *const Texpr {
    return match env_lookup(env, name) {
        Option::Some(t) => te_node(ar, TexprNode::TVar(name), t, p)
        | Option::None => elab_var_global(ar, g, name, p)
    };
}

fn elab_var_global(ar: *Arena, g: *const Vec<GlobalFn>, name: str, p: Pos) -> *const Texpr {
    return match global_lookup(g, name) {
        Option::Some(gf) => const_ref(ar, gf, name, p)
        | Option::None => te_node(ar, TexprNode::TVar(name), ty_node(ar, Typ::TCVoid), p)
    };
}

fn const_ref(ar: *Arena, gf: GlobalFn, name: str, p: Pos) -> *const Texpr {
    if gf.is_const { return te_node(ar, TexprNode::TVar(gf.mangled), ret_or_void(ar, gf.ret), p); }
    return te_node(ar, TexprNode::TVar(name), ty_node(ar, Typ::TCVoid), p);
}

fn elab_neg(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
            expected: Option<*const Typ>, sub: *const Expr, p: Pos) -> *const Texpr {
    let s = elab_expr(a, ar, g, env, expected, sub);
    return te_node(ar, TexprNode::TNeg(s), s.ty, p);
}
fn elab_bitnot(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
               expected: Option<*const Typ>, sub: *const Expr, p: Pos) -> *const Texpr {
    let s = elab_expr(a, ar, g, env, expected, sub);
    return te_node(ar, TexprNode::TBitNot(s), s.ty, p);
}
fn elab_not(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
            sub: *const Expr, p: Pos) -> *const Texpr {
    let s = elab_expr(a, ar, g, env, none_ty(), sub);
    return te_node(ar, TexprNode::TNot(s), t_bool(ar), p);
}

// Push an int expected type into binop operands: arithmetic / bitwise →
// both sides; shift → left only; comparison / logical → neither.
fn left_expected(op: BinOp, expected: Option<*const Typ>) -> Option<*const Typ> {
    return match op {
        BinOp::Add => expected | BinOp::Sub => expected | BinOp::Mul => expected
        | BinOp::Div => expected | BinOp::Mod => expected | BinOp::BitAnd => expected
        | BinOp::BitOr => expected | BinOp::BitXor => expected
        | BinOp::Shl => expected | BinOp::Shr => expected
        | _e => none_ty()
    };
}
fn right_expected(op: BinOp, expected: Option<*const Typ>) -> Option<*const Typ> {
    return match op {
        BinOp::Add => expected | BinOp::Sub => expected | BinOp::Mul => expected
        | BinOp::Div => expected | BinOp::Mod => expected | BinOp::BitAnd => expected
        | BinOp::BitOr => expected | BinOp::BitXor => expected
        | _e => none_ty()
    };
}

// Arithmetic / bitwise / shift take the left operand's type (matching-type
// case; mixed-width promotion deferred); comparisons / logical → bool.
fn binop_result_ty(ar: *Arena, op: BinOp, l: *const Texpr) -> *const Typ {
    return match op {
        BinOp::Lt => t_bool(ar) | BinOp::Gt => t_bool(ar) | BinOp::LtEq => t_bool(ar)
        | BinOp::GtEq => t_bool(ar) | BinOp::EqEq => t_bool(ar) | BinOp::NotEq => t_bool(ar)
        | BinOp::And => t_bool(ar) | BinOp::Or => t_bool(ar)
        | _e => l.ty
    };
}

// ===== Compile-time string concat (`++`) =====
//
// `typ_name` (IR's pure util, primitive slice): names a type for the
// `type_name(x)` builtin, whose result folds into a `++` chain.

fn int_typ_name(sgn: bool, width: IntWidth) -> str {
    if sgn {
        return match width { IntWidth::W8 => "i8" | IntWidth::W16 => "i16" | IntWidth::W32 => "i32" };
    }
    return match width { IntWidth::W8 => "u8" | IntWidth::W16 => "u16" | IntWidth::W32 => "u32" };
}

fn typ_name(t: *const Typ) -> str {
    return match *t {
        Typ::TInt(k) => int_typ_name(k.is_signed, k.width)
        | Typ::TBool => "bool"
        | Typ::TString => "str"
        | Typ::TFloat(w) => match w { FloatWidth::F32 => "f32" | FloatWidth::F64 => "f64" }
        | Typ::TCInt { is_signed } => match is_signed { true => "c_int" | false => "c_uint" }
        | Typ::TCVoid => "c_void"
        | _other => "?"
    };
}

fn none_str() -> Option<str> {
    let n: Option<str> = Option::None;
    return n;
}

// A compile-time string: a string literal, or a `type_name(x)` call (whose
// value is the static type name).  Used to fold `++` chains.
fn extract_concat_str(te: *const Texpr) -> Option<str> {
    return match te.e {
        TexprNode::TStringLit(s) => Option::Some(s)
        | TexprNode::TBuiltinCall { name, args } => extract_type_name(name, &args)
        | _other => none_str()
    };
}
fn extract_type_name(name: str, args: *const Vec<*const Texpr>) -> Option<str> {
    if str::eq(name, "type_name") && args.length() == 1 as u32 {
        let sl = args.as_slice();
        return Option::Some(typ_name(sl[0 as u32].ty));
    }
    return none_str();
}

fn mk_concat_str(a: Allocator, ar: *Arena, l: str, r: str, p: Pos) -> *const Texpr {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(l);
    sb.push_str(r);
    return te_node(ar, TexprNode::TStringLit(str::from_slice(ar, sb.as_slice())), t_str(ar), p);
}

fn fold_concat_r(a: Allocator, ar: *Arena, l: str, r2: *const Texpr, p: Pos) -> *const Texpr {
    return match extract_concat_str(r2) {
        Option::Some(r) => mk_concat_str(a, ar, l, r, p)
        | Option::None => defer_expr(ar, p)
    };
}
fn fold_concat(a: Allocator, ar: *Arena, l2: *const Texpr, r2: *const Texpr, p: Pos) -> *const Texpr {
    return match extract_concat_str(l2) {
        Option::Some(l) => fold_concat_r(a, ar, l, r2, p)
        | Option::None => defer_expr(ar, p)
    };
}

fn is_concat(op: BinOp) -> bool {
    return match op { BinOp::Concat => true | _e => false };
}

fn elab_binop(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>, expected: Option<*const Typ>,
              op: BinOp, l: *const Expr, r: *const Expr, p: Pos) -> *const Texpr {
    let l2 = elab_expr(a, ar, g, env, left_expected(op, expected), l);
    let r2 = elab_expr(a, ar, g, env, right_expected(op, expected), r);
    if is_concat(op) { return fold_concat(a, ar, l2, r2, p); }
    let ty = binop_result_ty(ar, op, l2);
    return te_node(ar, TexprNode::TBinOp(op, l2, r2), ty, p);
}

fn elab_args(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
             args: *const Vec<*const Expr>) -> Vec<*const Texpr> {
    let mut out: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n {
        out.push(elab_expr(a, ar, g, env, none_ty(), sl[i]));
        i = i + 1 as u32;
    }
    return out;
}

// Whether the body type resolver (`resolve_type_ann`) can stand behind a
// type annotation.  Named types (struct / enum / tuple) need the program
// type scope the body elaborator does not yet carry, so a cast to one is
// deferred (visible marker) rather than silently typed as `c_void`.
fn ann_body_supported(ann: *const TypeAnn) -> bool {
    return match *ann {
        TypeAnn::TyStruct { path, args } => false
        | TypeAnn::TyTuple(_e) => false
        | TypeAnn::TyPtr(t) => ann_body_supported(t)
        | TypeAnn::TyOwnPtr(t) => ann_body_supported(t)
        | TypeAnn::TyConstPtr(t) => ann_body_supported(t)
        | _prim => true
    };
}

// `expr as T` — the sub keeps its own type; the cast node carries the
// target annotation and takes the resolved annotation type.
fn elab_cast(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
             sub: *const Expr, ann: *const TypeAnn, p: Pos) -> *const Texpr {
    let s = elab_expr(a, ar, g, env, none_ty(), sub);
    if !ann_body_supported(ann) { return defer_expr(ar, p); }
    let ty = resolve_type_ann(a, ar, ann);
    return te_node(ar, TexprNode::TCast(s, ann), ty, p);
}

// A call's result type: the declared return type, or — for a void fn used
// in statement position (the common case) — i32, matching the oracle's
// `None when allow_void -> t_i32`.
fn ret_or_void(ar: *Arena, ret: Option<*const Typ>) -> *const Typ {
    return match ret {
        Option::Some(t) => t
        | Option::None => t_i32(ar)
    };
}

// Direct call to a user / top-level fn: mangled C symbol + return type from
// the global table.  Arg-coercion against param types is deferred.
fn mk_user_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
                gf: GlobalFn, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    let targs = elab_args(a, ar, g, env, args);
    let ty = ret_or_void(ar, gf.ret);
    return te_node(ar, TexprNode::TCall { mangled: gf.mangled, args: targs }, ty, p);
}

fn call_or_defer(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
                 gf: GlobalFn, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    if gf.is_const { return defer_expr(ar, p); }
    return mk_user_call(a, ar, g, env, gf, args, p);
}

fn elab_user_or_defer(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
                      name: str, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    return match global_lookup(g, name) {
        Option::Some(gf) => call_or_defer(a, ar, g, env, gf, args, p)
        | Option::None => defer_expr(ar, p)
    };
}

fn elab_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
             callee: *const Vec<str>, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    if callee.length() != 1 as u32 { return defer_expr(ar, p); }
    let name = callee.get(0 as u32) orelse "";
    if str::eq(name, "println") || str::eq(name, "print") {
        let targs = elab_args(a, ar, g, env, args);
        return te_node(ar, TexprNode::TBuiltinCall { name: name, args: targs }, t_i32(ar), p);
    }
    if str::eq(name, "type_name") {
        let tn_args = elab_args(a, ar, g, env, args);
        return te_node(ar, TexprNode::TBuiltinCall { name: name, args: tn_args }, t_str(ar), p);
    }
    return elab_user_or_defer(a, ar, g, env, name, args, p);
}

// ===== Match elaboration (scalar scrutinee slice) =====
//
// SLICE: int / bool scrutinee (the scalar sentinel `ename_path = []`), with
// `PBool` / `PLit` / `PVar` / `_` / or-patterns.  An enum scrutinee (needs
// the enum index for variant tags) defers to a marker.

fn is_scalar_ty(t: *const Typ) -> bool {
    return match *t {
        Typ::TInt(_k) => true
        | Typ::TBool => true
        | _other => false
    };
}

fn copy_fieldtys(a: Allocator, src: *const Vec<FieldTy>) -> Vec<FieldTy> {
    let mut out: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let n = src.length();
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(FieldTy { name: sl[i].name, ty: sl[i].ty }); i = i + 1 as u32; }
    return out;
}

fn elab_pattern_list(a: Allocator, ar: *Arena, alts: *const Vec<Pattern>) -> Vec<Tpattern> {
    let mut out: Vec<Tpattern> = Vec::with_capacity(a, 8 as u32);
    let n = alts.length();
    let sl = alts.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(elab_pattern(a, ar, &sl[i])); i = i + 1 as u32; }
    return out;
}
fn elab_pattern(a: Allocator, ar: *Arena, pat: *const Pattern) -> Tpattern {
    return match *pat {
        Pattern::PWildcard(_q) => Tpattern::TPWildcard
        | Pattern::PVar(n, _q) => Tpattern::TPVar(n)
        | Pattern::PLit(n, _q) => Tpattern::TPLit(n)
        | Pattern::PBool(b, _q) => Tpattern::TPBool(b)
        | Pattern::POr(alts, _q) => Tpattern::TPOr(elab_pattern_list(a, ar, &alts))
        | _other => Tpattern::TPWildcard
    };
}

// A top-level `PVar` binds the scrutinee value into the arm body's scope.
fn pattern_binds(pat: *const Pattern, scrut_ty: *const Typ, env_out: *Vec<FieldTy>) {
    match *pat {
        Pattern::PVar(n, _q) => { env_out.push(FieldTy { name: n, ty: scrut_ty }); }
        | _other => { }
    }
}

fn elab_guard(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
              guard: Option<*const Expr>) -> Option<*const Texpr> {
    return match guard {
        Option::Some(gx) => Option::Some(elab_expr(a, ar, g, env, none_ty(), gx))
        | Option::None => none_texpr()
    };
}

fn elab_one_arm(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
                expected: Option<*const Typ>, scrut_ty: *const Typ, arm: *const MatchArm, out: *Vec<TmatchArm>) {
    let tpat = elab_pattern(a, ar, &arm.pat);
    let mut arm_env = copy_fieldtys(a, env);
    pattern_binds(&arm.pat, scrut_ty, &arm_env);
    let tguard = elab_guard(a, ar, g, &arm_env, arm.guard);
    let tbody = elab_expr(a, ar, g, &arm_env, expected, arm.body);
    out.push(TmatchArm { tpat: tpat, tguard: tguard, tbody: tbody, tdiverges: false, tarm_pos: arm.arm_pos });
}

fn elab_arms(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
             expected: Option<*const Typ>, scrut_ty: *const Typ, arms: *const Vec<MatchArm>, out: *Vec<TmatchArm>) {
    let n = arms.length();
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < n { elab_one_arm(a, ar, g, env, expected, scrut_ty, &sl[i], out); i = i + 1 as u32; }
}

fn match_result_ty(ar: *Arena, tarms: *const Vec<TmatchArm>) -> *const Typ {
    if tarms.length() == 0 as u32 { return ty_node(ar, Typ::TCVoid); }
    let sl = tarms.as_slice();
    return sl[0 as u32].tbody.ty;
}

fn elab_match(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
              expected: Option<*const Typ>, scrutinee: *const Expr, arms: *const Vec<MatchArm>, p: Pos) -> *const Texpr {
    let tscrut = elab_expr(a, ar, g, env, none_ty(), scrutinee);
    if !is_scalar_ty(tscrut.ty) { return defer_expr(ar, p); }
    let epath: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut tarms: Vec<TmatchArm> = Vec::with_capacity(a, 8 as u32);
    elab_arms(a, ar, g, env, expected, tscrut.ty, arms, &tarms);
    let mty = match_result_ty(ar, &tarms);
    return te_node(ar, TexprNode::TMatch { scrutinee: tscrut, ename_path: epath, arms: tarms }, mty, p);
}

// ===== Variable substitution (for-loop iter-var rename) =====
//
// `for IT in lo..hi { body }` renames `IT` to the gensym counter `__fvK`
// in the body before elaboration (mirrors OCaml `subst_var_*`).  Rebuilds
// the touched AST nodes; unhandled expr forms pass through unchanged, an
// unhandled statement lowers to a visible `(var )` marker.

fn ast_node(ar: *Arena, e: Expr) -> *const Expr {
    let n: *Expr = ar.alloc_borrowed();
    *n = e;
    return n as *const Expr;
}

fn subst_var_one(ar: *Arena, from: str, to: str, n: str, p: Pos, orig: *const Expr) -> *const Expr {
    if str::eq(n, from) { return ast_node(ar, Expr::Var(to, p)); }
    return orig;
}

fn subst_call(a: Allocator, ar: *Arena, from: str, to: str,
              callee: *const Vec<str>, args: *const Vec<*const Expr>, p: Pos) -> *const Expr {
    let new_callee = copy_strs(a, callee);
    let mut new_args: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n { new_args.push(subst_var_expr(a, ar, from, to, sl[i])); i = i + 1 as u32; }
    return ast_node(ar, Expr::Call { callee: new_callee, args: new_args, pos: p });
}

fn subst_else(a: Allocator, ar: *Arena, from: str, to: str, else_blk: Option<Vec<Stmt>>) -> Option<Vec<Stmt>> {
    return match else_blk {
        Option::Some(blk) => Option::Some(subst_body(a, ar, from, to, &blk))
        | Option::None => { let none: Option<Vec<Stmt>> = Option::None; none }
    };
}

fn subst_if(a: Allocator, ar: *Arena, from: str, to: str, cond: *const Expr,
            then_blk: *const Vec<Stmt>, else_blk: Option<Vec<Stmt>>, p: Pos) -> *const Expr {
    let new_cond = subst_var_expr(a, ar, from, to, cond);
    let new_then = subst_body(a, ar, from, to, then_blk);
    let new_else = subst_else(a, ar, from, to, else_blk);
    return ast_node(ar, Expr::If { cond: new_cond, then_blk: new_then, else_blk: new_else, pos: p });
}

fn subst_var_expr(a: Allocator, ar: *Arena, from: str, to: str, e: *const Expr) -> *const Expr {
    let p = expr_pos(e);
    return match *e {
        Expr::Var(n, _q) => subst_var_one(ar, from, to, n, p, e)
        | Expr::Neg(s, _q) => ast_node(ar, Expr::Neg(subst_var_expr(a, ar, from, to, s), p))
        | Expr::BitNot(s, _q) => ast_node(ar, Expr::BitNot(subst_var_expr(a, ar, from, to, s), p))
        | Expr::Not(s, _q) => ast_node(ar, Expr::Not(subst_var_expr(a, ar, from, to, s), p))
        | Expr::BinOp(op, l, r, _q) =>
            ast_node(ar, Expr::BinOp(op, subst_var_expr(a, ar, from, to, l), subst_var_expr(a, ar, from, to, r), p))
        | Expr::Cast(s, t, _q) => ast_node(ar, Expr::Cast(subst_var_expr(a, ar, from, to, s), t, p))
        | Expr::Call { callee, args } => subst_call(a, ar, from, to, &callee, &args, p)
        | Expr::If { cond, then_blk, else_blk } => subst_if(a, ar, from, to, cond, &then_blk, else_blk, p)
        | Expr::Index { base, index } =>
            ast_node(ar, Expr::Index { base: subst_var_expr(a, ar, from, to, base), index: subst_var_expr(a, ar, from, to, index), pos: p })
        | _other => e
    };
}

fn subst_var_stmt(a: Allocator, ar: *Arena, from: str, to: str, s: *const Stmt) -> Stmt {
    return match *s {
        Stmt::ExprStmt(e) => Stmt::ExprStmt(subst_var_expr(a, ar, from, to, e))
        | Stmt::Tail(e) => Stmt::Tail(subst_var_expr(a, ar, from, to, e))
        | Stmt::Assign { path, value, pos } =>
            Stmt::Assign { path: copy_strs(a, &path), value: subst_var_expr(a, ar, from, to, value), pos: pos }
        | Stmt::Break(p) => Stmt::Break(p)
        | Stmt::Continue(p) => Stmt::Continue(p)
        | _other => Stmt::ExprStmt(ast_node(ar, Expr::Var("", zero_pos())))
    };
}

fn subst_body(a: Allocator, ar: *Arena, from: str, to: str, body: *const Vec<Stmt>) -> Vec<Stmt> {
    let mut out: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    let n = body.length();
    let sl = body.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(subst_var_stmt(a, ar, from, to, &sl[i])); i = i + 1 as u32; }
    return out;
}

fn elab_expr(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
             expected: Option<*const Typ>, e: *const Expr) -> *const Texpr {
    let p = expr_pos(e);
    return match *e {
        Expr::IntLit(n, _q) => te_node(ar, TexprNode::TIntLit(n), int_lit_ty(ar, expected), p)
        | Expr::BoolLit(b, _q) => te_node(ar, TexprNode::TBoolLit(b), t_bool(ar), p)
        | Expr::StringLit(s, _q) => te_node(ar, TexprNode::TStringLit(s), t_str(ar), p)
        | Expr::NullLit(_q) => te_node(ar, TexprNode::TNullLit, ty_node(ar, Typ::TNullPtr), p)
        | Expr::FloatLit(f, w, _q) => te_node(ar, TexprNode::TFloatLit(f, w), ty_node(ar, Typ::TFloat(w)), p)
        | Expr::Var(name, _q) => elab_var(ar, g, env, name, p)
        | Expr::Neg(sub, _q) => elab_neg(a, ar, g, env, expected, sub, p)
        | Expr::BitNot(sub, _q) => elab_bitnot(a, ar, g, env, expected, sub, p)
        | Expr::Not(sub, _q) => elab_not(a, ar, g, env, sub, p)
        | Expr::BinOp(op, l, r, _q) => elab_binop(a, ar, g, env, expected, op, l, r, p)
        | Expr::Cast(sub, ann, _q) => elab_cast(a, ar, g, env, sub, ann, p)
        | Expr::Call { callee, args } => elab_call(a, ar, g, env, &callee, &args, p)
        | Expr::If { cond, then_blk, else_blk } =>
            mk_if_expr(a, ar, g, env, expected, cond, &then_blk, else_blk, p)
        | Expr::EnumLit { tname, variant } => elab_enumlit(a, ar, g, &tname, variant, p)
        | Expr::Match { scrutinee, arms } => elab_match(a, ar, g, env, expected, scrutinee, &arms, p)
        | _other => defer_expr(ar, p)
    };
}

// `A::B` parses as an enum-literal; resolve it as a module-scoped `const`
// reference when its mangled `A__B` names one, else defer (real enum
// literals are not yet elaborated).
fn elab_enumlit(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>,
                tname: *const Vec<str>, variant: str, p: Pos) -> *const Texpr {
    let m = mangle_path(a, ar, tname, variant);
    return match global_lookup_by_mangled(g, m) {
        Option::Some(gf) => enumlit_const(ar, gf, p)
        | Option::None => defer_expr(ar, p)
    };
}
fn enumlit_const(ar: *Arena, gf: GlobalFn, p: Pos) -> *const Texpr {
    if gf.is_const { return te_node(ar, TexprNode::TVar(gf.mangled), ret_or_void(ar, gf.ret), p); }
    return defer_expr(ar, p);
}

fn let_expected(a: Allocator, ar: *Arena, ty_ann: Option<*const TypeAnn>) -> Option<*const Typ> {
    return match ty_ann {
        Option::Some(t) => Option::Some(resolve_type_ann(a, ar, t))
        | Option::None => none_ty()
    };
}

// `return e` elaborates `e` against the fn's declared return type so a bare
// literal adopts the annotated width; `return;` yields no value.
fn none_texpr() -> Option<*const Texpr> {
    let n: Option<*const Texpr> = Option::None;
    return n;
}

fn elab_return_val(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
                   ret: Option<*const Typ>, val: Option<*const Expr>) -> Option<*const Texpr> {
    return match val {
        Option::Some(e) => Option::Some(elab_expr(a, ar, g, env, ret, e))
        | Option::None => none_texpr()
    };
}

fn empty_tstmts(a: Allocator) -> Vec<Tstmt> {
    let v: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    return v;
}

fn elab_else_body(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
                  else_blk: Option<Vec<Stmt>>) -> Vec<Tstmt> {
    return match else_blk {
        Option::Some(blk) => elab_body(a, ar, g, gensym, env, ret, &blk)
        | Option::None => empty_tstmts(a)
    };
}

// An expression used in statement (void) position.  `if` lowers to the
// void `TIf` statement (branches are full stmt-blocks, sharing the env —
// C hoists branch-local lets); everything else becomes a `TExprStmt`.
fn elab_stmt_pos(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
                 e: *const Expr, out: *Vec<Tstmt>) {
    match *e {
        Expr::If { cond, then_blk, else_blk } => {
            let tcond = elab_expr(a, ar, g, env, none_ty(), cond);
            let tthen = elab_body(a, ar, g, gensym, env, ret, &then_blk);
            let telse = elab_else_body(a, ar, g, gensym, env, ret, else_blk);
            out.push(Tstmt::TIf { cond: tcond, then_body: tthen, else_body: telse });
        }
        | _other => {
            let ve = elab_expr(a, ar, g, env, none_ty(), e);
            out.push(Tstmt::TExprStmt(ve));
        }
    }
}

fn is_some_ty(o: Option<*const Typ>) -> bool {
    return match o { Option::Some(_t) => true | Option::None => false };
}

fn is_tail_stmt(s: *const Stmt) -> bool {
    return match *s { Stmt::Tail(_e) => true | _other => false };
}

// A block yields a VALUE (vs diverging via returns) when its last statement
// is a trailing expression (`Tail`).  Distinguishes a value-`if` (lowered to
// `if-expr`) from a control-flow `if` whose branches `return`.
fn block_is_value(blk: *const Vec<Stmt>) -> bool {
    let n = blk.length();
    if n == 0 as u32 { return false; }
    let sl = blk.as_slice();
    return is_tail_stmt(&sl[n - 1 as u32]);
}

// ===== Value-position elaboration (if-expr) =====
//
// A value-position `if` lowers to `TIfExpr` — handled directly in
// `elab_expr` (statement-position `if` is caught by `elab_stmt_pos` first).

// The trailing value of a single-`Tail` block; multi-statement value blocks
// are deferred (a visible marker) for now.
fn block_value(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
               expected: Option<*const Typ>, blk: *const Vec<Stmt>) -> *const Texpr {
    if blk.length() != 1 as u32 { return defer_expr(ar, zero_pos()); }
    let sl = blk.as_slice();
    return tail_or_defer(a, ar, g, env, expected, &sl[0 as u32]);
}
fn tail_or_defer(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
                 expected: Option<*const Typ>, s: *const Stmt) -> *const Texpr {
    return match *s {
        Stmt::Tail(e) => elab_expr(a, ar, g, env, expected, e)
        | _other => defer_expr(ar, zero_pos())
    };
}
fn else_block_value(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
                    expected: Option<*const Typ>, else_blk: Option<Vec<Stmt>>) -> *const Texpr {
    return match else_blk {
        Option::Some(blk) => block_value(a, ar, g, env, expected, &blk)
        | Option::None => defer_expr(ar, zero_pos())
    };
}

fn mk_if_expr(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, env: *const Vec<FieldTy>,
              expected: Option<*const Typ>, cond: *const Expr, then_blk: *const Vec<Stmt>,
              else_blk: Option<Vec<Stmt>>, p: Pos) -> *const Texpr {
    let tcond = elab_expr(a, ar, g, env, none_ty(), cond);
    let tthen = block_value(a, ar, g, env, expected, then_blk);
    let telse = else_block_value(a, ar, g, env, expected, else_blk);
    return te_node(ar, TexprNode::TIfExpr { cond: tcond, then_val: tthen, else_val: telse }, tthen.ty, p);
}

// A trailing block value in a return-typed fn is an implicit `return`.  A
// value-`if` returns an `if-expr`; a control-flow `if` (diverging branches)
// stays a `TIf` statement; anything else returns its value.
fn elab_tail_if(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
                cond: *const Expr, then_blk: *const Vec<Stmt>, else_blk: Option<Vec<Stmt>>, p: Pos, out: *Vec<Tstmt>) {
    if block_is_value(then_blk) {
        let ifx = mk_if_expr(a, ar, g, env, ret, cond, then_blk, else_blk, p);
        out.push(Tstmt::TReturn { value: Option::Some(ifx), pos: zero_pos() });
    } else {
        let tcond = elab_expr(a, ar, g, env, none_ty(), cond);
        let tthen = elab_body(a, ar, g, gensym, env, ret, then_blk);
        let telse = elab_else_body(a, ar, g, gensym, env, ret, else_blk);
        out.push(Tstmt::TIf { cond: tcond, then_body: tthen, else_body: telse });
    }
}

fn elab_tail_ret(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
                 e: *const Expr, out: *Vec<Tstmt>) {
    let p = expr_pos(e);
    match *e {
        Expr::If { cond, then_blk, else_blk } => { elab_tail_if(a, ar, g, gensym, env, ret, cond, &then_blk, else_blk, p, out); }
        | _other => {
            let tv = elab_expr(a, ar, g, env, ret, e);
            out.push(Tstmt::TReturn { value: Option::Some(tv), pos: zero_pos() });
        }
    }
}

// A trailing expression: an implicit `return` in a return-typed fn, else a
// void statement (`if` → `TIf`, otherwise `TExprStmt`).
fn elab_tail(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
             e: *const Expr, out: *Vec<Tstmt>) {
    if is_some_ty(ret) { elab_tail_ret(a, ar, g, gensym, env, ret, e, out); }
    else { elab_stmt_pos(a, ar, g, gensym, env, ret, e, out); }
}

fn copy_strs(a: Allocator, src: *const Vec<str>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let n = src.length();
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}

// ===== `for IT in lo..hi` → `while` lift =====
//
// A `for` over an integer range lowers to the oracle's post-lift shape:
//   let __feK = hi; let __fvK = lo;
//   while __fvK < __feK { body[IT->__fvK] } post { __fvK = __fvK + 1 }
// (inclusive ranges compare with `<=`).  `K` is the program-global gensym
// counter, so loops never collide; the iter-var is renamed in the body
// before elaboration.  A non-range `for` (over a collection) is not yet
// supported and leaves a visible deferral marker.

fn gensym_name(a: Allocator, ar: *Arena, prefix: str, k: u32) -> str {
    let mut sb = StringBuilder::with_capacity(a, 16 as u32);
    sb.push_str(prefix);
    sb.push_int(k as int);
    return str::from_slice(ar, sb.as_slice());
}

fn mk_for_cond(ar: *Arena, fv: str, fe: str, cty: *const Typ, inclusive: bool) -> *const Texpr {
    let vfv = te_node(ar, TexprNode::TVar(fv), cty, zero_pos());
    let vfe = te_node(ar, TexprNode::TVar(fe), cty, zero_pos());
    let op = if inclusive { BinOp::LtEq } else { BinOp::Lt };
    return te_node(ar, TexprNode::TBinOp(op, vfv, vfe), t_bool(ar), zero_pos());
}

fn mk_for_post(a: Allocator, ar: *Arena, fv: str, cty: *const Typ) -> Vec<Tstmt> {
    let vfv = te_node(ar, TexprNode::TVar(fv), cty, zero_pos());
    let one = te_node(ar, TexprNode::TIntLit(1), cty, zero_pos());
    let step = te_node(ar, TexprNode::TBinOp(BinOp::Add, vfv, one), cty, zero_pos());
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(fv);
    let mut post: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    post.push(Tstmt::TAssign { path: path, value: step, pos: zero_pos() });
    return post;
}

fn elab_for(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, env: *Vec<FieldTy>,
            ret: Option<*const Typ>, iter_var: str, range: *const Expr, body: *const Vec<Stmt>, out: *Vec<Tstmt>) {
    let k = *gensym;
    *gensym = *gensym + 1 as u32;
    let fv = gensym_name(a, ar, "__fv", k);
    let fe = gensym_name(a, ar, "__fe", k);
    match *range {
        Expr::Range { lo, hi, inclusive } => {
            let tlo = elab_expr(a, ar, g, env, none_ty(), lo);
            let cty = tlo.ty;
            let thi = elab_expr(a, ar, g, env, Option::Some(cty), hi);
            let rbody = subst_body(a, ar, iter_var, fv, body);
            env.push(FieldTy { name: fv, ty: cty });
            let tbody = elab_body(a, ar, g, gensym, env, ret, &rbody);
            out.push(Tstmt::TLet { name: fe, value: thi, pos: zero_pos() });
            out.push(Tstmt::TLet { name: fv, value: tlo, pos: zero_pos() });
            let cond = mk_for_cond(ar, fv, fe, cty, inclusive);
            let post = mk_for_post(a, ar, fv, cty);
            out.push(Tstmt::TWhile { cond: cond, body: tbody, post: post });
        }
        | _other => {
            out.push(Tstmt::TExprStmt(defer_expr(ar, zero_pos())));
        }
    }
}

fn elab_stmt(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
             s: *const Stmt, out: *Vec<Tstmt>) {
    match *s {
        Stmt::Let { name, value, ty_ann } => {
            let exp = let_expected(a, ar, ty_ann);
            let vl = elab_expr(a, ar, g, env, exp, value);
            env.push(FieldTy { name: name, ty: vl.ty });
            out.push(Tstmt::TLet { name: name, value: vl, pos: expr_pos(value) });
        }
        | Stmt::ExprStmt(e) => { elab_stmt_pos(a, ar, g, gensym, env, ret, e, out); }
        | Stmt::Tail(e) => { elab_tail(a, ar, g, gensym, env, ret, e, out); }
        | Stmt::Return(val, pos) => {
            let tv = elab_return_val(a, ar, g, env, ret, val);
            out.push(Tstmt::TReturn { value: tv, pos: pos });
        }
        | Stmt::While { cond, body } => {
            let wcond = elab_expr(a, ar, g, env, none_ty(), cond);
            let wbody = elab_body(a, ar, g, gensym, env, ret, &body);
            let wpost: Vec<Tstmt> = empty_tstmts(a);
            out.push(Tstmt::TWhile { cond: wcond, body: wbody, post: wpost });
        }
        | Stmt::Assign { path, value, pos } => {
            let av = elab_expr(a, ar, g, env, none_ty(), value);
            let apath = copy_strs(a, &path);
            out.push(Tstmt::TAssign { path: apath, value: av, pos: pos });
        }
        | Stmt::Break(pos) => { out.push(Tstmt::TBreak(pos)); }
        | Stmt::Continue(pos) => { out.push(Tstmt::TContinue(pos)); }
        | Stmt::Defer { body, pos } => {
            let dbody = elab_body(a, ar, g, gensym, env, ret, &body);
            out.push(Tstmt::TDefer { body: dbody, pos: pos });
        }
        | Stmt::For { iter_var, range, body } => {
            elab_for(a, ar, g, gensym, env, ret, iter_var, range, &body, out);
        }
        | _other => {
            // Unsupported statement — emit a VISIBLE deferral marker rather
            // than silently dropping it (mirrors the expr-level marker).
            out.push(Tstmt::TExprStmt(defer_expr(ar, zero_pos())));
        }
    }
}

fn elab_body(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
             body: *const Vec<Stmt>) -> Vec<Tstmt> {
    let mut out: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let n = body.length();
    let sl = body.as_slice();
    let mut i = 0 as u32;
    while i < n {
        elab_stmt(a, ar, g, gensym, env, ret, &sl[i], &out);
        i = i + 1 as u32;
    }
    return out;
}

fn build_param_env(a: Allocator, ar: *Arena, params: *const Vec<Param>, env: *Vec<FieldTy>) {
    let n = params.length();
    let sl = params.as_slice();
    let mut i = 0 as u32;
    while i < n {
        env.push(FieldTy { name: sl[i].pname, ty: resolve_type_ann(a, ar, sl[i].pty) });
        i = i + 1 as u32;
    }
}

// ===== Function elaboration =====

// The emitted C symbol (mirrors OCaml `ir.mangle` + the flatten-time rule):
// an `extern fn` keeps its C-side name, `main` stays unprefixed, and every
// other top-level fn gets the `ex_` prefix.  Module-internal mangling
// (`path__name`) lands with the module-elaboration slice.
fn mangle_fn(a: Allocator, ar: *Arena, f: *const Func) -> str {
    if f.is_extern { return f.c_name; }
    if str::eq(f.name, "main") { return "main"; }
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str("ex_");
    sb.push_str(f.name);
    return str::from_slice(ar, sb.as_slice());
}

fn elaborate_fn(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32,
                structs: *const Vec<str>, enums: *const Vec<str>, iconsts: *const Vec<IntConst>,
                mangled: str, f: *const Func) -> Tfunc {
    let params = copy_params(a, &f.params);
    let sc = TyScope { sc_structs: structs, sc_enums: enums, sc_tparams: &f.tparams, sc_iconsts: iconsts };
    let param_tys = resolve_param_tys(a, ar, &sc, &f.params);
    let ret_ty = resolve_sig_ret(a, ar, &sc, f.ret_ty);
    let mut env: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    build_param_env(a, ar, &f.params, &env);
    let body = elab_body(a, ar, g, gensym, &env, ret_ty, &f.body);
    let lets: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let no_pos: Option<Pos> = Option::None;
    let path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    // `tf_func` only feeds the dump's flags + param names; rebuild it with
    // copied params and empty generic / body fields (the elaborated body
    // lives in `tf_body`).
    let tparams: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let tbounds: Vec<TraitBound> = Vec::with_capacity(a, 8 as u32);
    let dummy_body: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    let tf_func = Func {
        name: f.name, c_name: f.c_name, tparams: tparams, tbounds: tbounds,
        params: params, ret_ty: f.ret_ty, body: dummy_body, is_pub: f.is_pub,
        is_extern: f.is_extern, is_variadic: f.is_variadic, amiga_lib: f.amiga_lib,
        tier_hint: f.tier_hint, must_use: f.must_use, escapes_hatch: f.escapes_hatch, pos: f.pos,
    };
    return Tfunc {
        tf_path: path, tf_func: tf_func, tf_mangled: mangled, tf_param_tys: param_tys,
        tf_ret_ty: ret_ty, tf_body: body, tf_lets: lets, tf_origin_pos: no_pos,
    };
}

fn elaborate_item(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32,
                  structs: *const Vec<str>, enums: *const Vec<str>, iconsts: *const Vec<IntConst>,
                  it: *const Item, funcs: *Vec<Tfunc>) {
    match *it {
        Item::Function(f) => { funcs.push(elaborate_fn(a, ar, g, gensym, structs, enums, iconsts, mangle_fn(a, ar, &f), &f)); }
        | _e => { }
    }
}

// An inherent / trait method `impl T { fn m(...) }` elaborates as a free
// function whose C symbol is `T__m` (the target path joined by `__`, then
// the method name).  The oracle flattens every method AFTER the top-level
// free functions, so impls are elaborated in a second pass.
fn method_mangle(a: Allocator, ar: *Arena, target: *const Vec<str>, name: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    let n = target.length();
    let sl = target.as_slice();
    let mut i = 0 as u32;
    while i < n { sb.push_str(sl[i]); sb.push_str("__"); i = i + 1 as u32; }
    sb.push_str(name);
    return str::from_slice(ar, sb.as_slice());
}

// Push happens behind a fn boundary so `f` is a parameter (not the address
// of a local slice element) — same shape the free-fn path relies on to
// satisfy the escape checker.
fn elaborate_method_into(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32,
                         structs: *const Vec<str>, enums: *const Vec<str>, iconsts: *const Vec<IntConst>,
                         target: *const Vec<str>, f: *const Func, funcs: *Vec<Tfunc>) {
    funcs.push(elaborate_fn(a, ar, g, gensym, structs, enums, iconsts,
                            method_mangle(a, ar, target, f.name), f));
}

fn elaborate_impl(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32,
                  structs: *const Vec<str>, enums: *const Vec<str>, iconsts: *const Vec<IntConst>,
                  ib: *const ImplBlock, funcs: *Vec<Tfunc>) {
    let n = ib.iitems.length();
    let sl = ib.iitems.as_slice();
    let mut i = 0 as u32;
    while i < n {
        elaborate_method_into(a, ar, g, gensym, structs, enums, iconsts, &ib.itarget, &sl[i], funcs);
        i = i + 1 as u32;
    }
}

fn elaborate_impl_item(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32,
                       structs: *const Vec<str>, enums: *const Vec<str>, iconsts: *const Vec<IntConst>,
                       it: *const Item, funcs: *Vec<Tfunc>) {
    match *it {
        Item::Impl(ib) => { elaborate_impl(a, ar, g, gensym, structs, enums, iconsts, &ib, funcs); }
        | _e => { }
    }
}

// Collect every user-declared struct / enum name (recursing into modules)
// so signatures resolve them and the mono-instances footer lists them.
fn collect_type_names_one(it: *const Item, snames: *Vec<str>, enames: *Vec<str>) {
    match *it {
        Item::Struct(sd) => { snames.push(sd.sname); }
        | Item::Enum(ed) => { enames.push(ed.ename); }
        | Item::Module(md) => { collect_type_names(&md.mitems, snames, enames); }
        | _e => { }
    }
}

fn collect_type_names(items: *const Vec<Item>, snames: *Vec<str>, enames: *Vec<str>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        collect_type_names_one(&sl[i], snames, enames);
        i = i + 1 as u32;
    }
}

// Collect top-level integer constants with a literal value so array sizes
// `[T; N]` and other size expressions can fold `N`.
fn collect_int_consts_one(it: *const Item, out: *Vec<IntConst>) {
    match *it {
        Item::Const(c) => {
            match *c.kvalue {
                Expr::IntLit(n, _q) => { out.push(IntConst { ic_name: c.kname, ic_val: n }); }
                | _e => { }
            }
        }
        | Item::Module(md) => { collect_int_consts(&md.mitems, out); }
        | _e => { }
    }
}

fn collect_int_consts(items: *const Vec<Item>, out: *Vec<IntConst>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        collect_int_consts_one(&sl[i], out);
        i = i + 1 as u32;
    }
}

// First pass: collect the signature of every top-level fn so a direct call
// resolves to (mangled symbol, return type) before bodies are elaborated.
// `is_top` is true only at the top level (path empty); module-internal
// symbols are reachable solely via their `mod::name` path.  An `extern fn`
// keeps its C name; otherwise `mangle_path` applies.
fn collect_one(a: Allocator, ar: *Arena, it: *const Item, path: *const Vec<str>, g: *Vec<GlobalFn>) {
    let is_top = path.length() == 0 as u32;
    match *it {
        Item::Function(f) => {
            let m = collect_fn_mangle(a, ar, &f, path);
            g.push(GlobalFn { name: f.name, mangled: m, ret: resolve_ret(a, ar, f.ret_ty),
                              is_const: false, is_top: is_top });
        }
        | Item::Const(c) => {
            g.push(GlobalFn { name: c.kname, mangled: mangle_path(a, ar, path, c.kname),
                              ret: Option::Some(resolve_type_ann(a, ar, c.kty)),
                              is_const: true, is_top: is_top });
        }
        | Item::Module(md) => {
            let mut p2: Vec<str> = copy_strs(a, path);
            p2.push(md.mname);
            collect_into(a, ar, &md.mitems, &p2, g);
        }
        | _e => { }
    }
}

fn collect_fn_mangle(a: Allocator, ar: *Arena, f: *const Func, path: *const Vec<str>) -> str {
    if f.is_extern { return f.c_name; }
    if path.length() == 0 as u32 && str::eq(f.name, "main") { return "main"; }
    return mangle_path(a, ar, path, f.name);
}

fn collect_into(a: Allocator, ar: *Arena, items: *const Vec<Item>, path: *const Vec<str>, g: *Vec<GlobalFn>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        collect_one(a, ar, &sl[i], path, g);
        i = i + 1 as u32;
    }
}

fn collect_globals(a: Allocator, ar: *Arena, items: *const Vec<Item>) -> Vec<GlobalFn> {
    let mut g: Vec<GlobalFn> = Vec::with_capacity(a, 16 as u32);
    let top: Vec<str> = Vec::with_capacity(a, 8 as u32);
    collect_into(a, ar, items, &top, &g);
    return g;
}

// ===== Prelude `mono-instances` footprint =====
//
// Every IR dump carries the registered prelude struct / enum skeletons.
// Until the prelude itself is ported these are registered by name only
// (the dump renders just `sname_path` / `ename_path`).

fn push_struct_name(a: Allocator, sigs: *Vec<StructSig>, name: str) {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(name);
    let fields: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let tparams: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let no_args: Option<Vec<*const Typ>> = Option::None;
    sigs.push(StructSig {
        sname_path: path, sfields_ty: fields, sis_pub: true, stparams: tparams,
        sinstance_args: no_args, sis_debug: false, ss_is_move: false,
    });
}

fn push_enum_name(a: Allocator, sigs: *Vec<EnumSig>, name: str) {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(name);
    let variants: Vec<VariantSig> = Vec::with_capacity(a, 8 as u32);
    let tparams: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let no_args: Option<Vec<*const Typ>> = Option::None;
    sigs.push(EnumSig {
        ename_path: path, evariants: variants, eis_pub: true, etparams: tparams,
        einstance_args: no_args, eis_must_use: false, eis_debug: false,
    });
}

fn prelude_struct_index(a: Allocator) -> Vec<StructSig> {
    let mut sigs: Vec<StructSig> = Vec::with_capacity(a, 16 as u32);
    push_struct_name(a, &sigs, "Enumerate");
    push_struct_name(a, &sigs, "Filter");
    push_struct_name(a, &sigs, "HashMap");
    push_struct_name(a, &sigs, "HashMapIter");
    push_struct_name(a, &sigs, "Map");
    push_struct_name(a, &sigs, "Range");
    push_struct_name(a, &sigs, "RangeInclusive");
    push_struct_name(a, &sigs, "Slice");
    push_struct_name(a, &sigs, "Slot");
    push_struct_name(a, &sigs, "Take");
    push_struct_name(a, &sigs, "Vec");
    push_struct_name(a, &sigs, "VecIter");
    return sigs;
}

fn prelude_enum_index(a: Allocator) -> Vec<EnumSig> {
    let mut sigs: Vec<EnumSig> = Vec::with_capacity(a, 8 as u32);
    push_enum_name(a, &sigs, "Option");
    push_enum_name(a, &sigs, "Result");
    return sigs;
}

// ===== Program assembly =====

pub fn check_program(a: Allocator, ar: *Arena, items: *const Vec<Item>)
        -> Result<Tprogram, *const CompileError> {
    let globals = collect_globals(a, ar, items);
    // User-declared struct / enum names: signatures resolve them and they
    // join the prelude in the sorted `mono-instances` footer.
    let mut snames: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut enames: Vec<str> = Vec::with_capacity(a, 8 as u32);
    collect_type_names(items, &snames, &enames);
    let mut iconsts: Vec<IntConst> = Vec::with_capacity(a, 8 as u32);
    collect_int_consts(items, &iconsts);
    // Program-global `for`-loop gensym counter (`__fvK` / `__feK`), reset
    // once per program to match the oracle's `for_gensym := 0`.
    let mut gensym: u32 = 0 as u32;
    let mut funcs: Vec<Tfunc> = Vec::with_capacity(a, 16 as u32);
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        elaborate_item(a, ar, &globals, &gensym, &snames, &enames, &iconsts, &sl[i], &funcs);
        i = i + 1 as u32;
    }
    // Second pass: impl methods are flattened after the free functions.
    let mut j = 0 as u32;
    while j < n {
        elaborate_impl_item(a, ar, &globals, &gensym, &snames, &enames, &iconsts, &sl[j], &funcs);
        j = j + 1 as u32;
    }

    let mut structs = prelude_struct_index(a);
    let mut enums = prelude_enum_index(a);
    let sn = snames.length();
    let ssl = snames.as_slice();
    let mut si = 0 as u32;
    while si < sn { push_struct_name(a, &structs, ssl[si]); si = si + 1 as u32; }
    let en = enames.length();
    let esl = enames.as_slice();
    let mut ei = 0 as u32;
    while ei < en { push_enum_name(a, &enums, esl[ei]); ei = ei + 1 as u32; }

    let sdecls: Vec<StructDeclEntry> = Vec::with_capacity(a, 8 as u32);
    let global: Vec<GlobalEntry> = Vec::with_capacity(a, 8 as u32);
    let modules: Vec<ModuleEntry> = Vec::with_capacity(a, 8 as u32);
    let tuples: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let fnptrs: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let cincludes: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let econsts: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let evars: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let arrays: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let consts: Vec<StrPair> = Vec::with_capacity(a, 8 as u32);

    return Result::Ok(Tprogram {
        tp_funcs: funcs, tp_struct_decls: sdecls, tp_struct_index: structs,
        tp_enum_index: enums, tp_global: global, tp_modules: modules,
        tp_uses_heap: false, tp_uses_string_h: false, tp_uses_default_allocator: false,
        tp_tuple_types: tuples, tp_fnptr_types: fnptrs, tp_c_includes: cincludes,
        tp_ext_consts: econsts, tp_ext_vars: evars, tp_array_types: arrays, tp_consts: consts,
    });
}
