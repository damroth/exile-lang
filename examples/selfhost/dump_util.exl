// Self-host dump — shared literal-escaping helpers.
//
// String escaping is the one piece the AST, IR, and token dumpers all
// need (string literals, char payloads, `String` tokens), so it lives
// in its own leaf module rather than being duplicated or forcing a
// token-only driver to pull in the whole AST/IR dumper.  Mirrors the
// `escape_string` / `\xHH` machinery in `lib/dump.ml`.

// `\xHH` lower-case hex byte, mirroring OCaml's `Printf.bprintf "\\x%02x"`.
fn hex_digit(v: int) -> u8 {
    if v < 10 { return (48 + v) as u8; }
    return (87 + v) as u8;
}

pub fn push_hex_byte(out: *StringBuilder, code: int) {
    out.push_str("\\x");
    out.push_byte(hex_digit(code / 16));
    out.push_byte(hex_digit(code % 16));
}

pub fn escape_other(out: *StringBuilder, b: u8, code: int) {
    if code < 32 || code >= 127 { push_hex_byte(out, code); }
    else { out.push_byte(b); }
}

// Render an f64 as a C99 hex-float (`%h`): `0x1.<frac>p<exp>`, frac trimmed of
// trailing zeros.  Shared by the AST and IR dumpers.  Normalisation to [1,2)
// and the 13-digit hex extraction are exact f64 ops (multiply / divide by
// powers of two and sixteen), so the output matches the oracle's `%h`
// bit-for-bit.
pub fn fmt_hexfloat(out: *StringBuilder, x: f64) {
    if x == 0.0 { out.push_str("0x0p+0"); return; }
    let mut v = x;
    if v < 0.0 { out.push_byte('-' as u8); v = 0.0 - v; }
    let mut e: int = 0;
    while v >= 2.0 { v = v / 2.0; e = e + 1; }
    while v < 1.0 { v = v * 2.0; e = e - 1; }
    out.push_str("0x1");
    let mut f1 = v - 1.0;
    let mut keep = 0;
    let mut k1 = 0;
    while k1 < 13 {
        f1 = f1 * 16.0;
        let d1 = f1 as int;
        f1 = f1 - (d1 as f64);
        k1 = k1 + 1;
        if d1 != 0 { keep = k1; }
    }
    if keep > 0 {
        out.push_byte('.' as u8);
        let mut f2 = v - 1.0;
        let mut k2 = 0;
        while k2 < keep {
            f2 = f2 * 16.0;
            let d2 = f2 as int;
            f2 = f2 - (d2 as f64);
            out.push_byte(hex_digit(d2));
            k2 = k2 + 1;
        }
    }
    out.push_byte('p' as u8);
    if e >= 0 as int { out.push_byte('+' as u8); } else { out.push_byte('-' as u8); e = 0 as int - e; }
    out.push_int(e);
}

// C-style string escape for dump literals.  Named escapes for newline /
// tab / quote / backslash; everything else below 0x20 or at/above 0x7f
// goes through the byte-level `\xHH` form; printable 7-bit ASCII passes
// through.  Mirrors OCaml `escape_string`.
pub fn escape_string(s: str, out: *StringBuilder) {
    out.push_byte(34 as u8);
    let bytes = str::as_bytes(s);
    let n = str::length(s);
    let mut i = 0 as u32;
    while i < n {
        let code = bytes[i] as int;
        match code {
            10 => { out.push_str("\\n"); }
            | 9 => { out.push_str("\\t"); }
            | 34 => { out.push_str("\\\""); }
            | 92 => { out.push_str("\\\\"); }
            | _ => { escape_other(out, bytes[i], code); }
        }
        i = i + 1 as u32;
    }
    out.push_byte(34 as u8);
}
