// Self-host AST stage — differential verification driver.
//
// Builds a hand-rolled `ast::Program` for `fixture.exl` (a small but
// broad source), renders it through the ported `dump_ast`, and writes
// the bytes to stdout.  The output is diffed against the OCaml oracle
// (`exilc --emit-ast examples/selfhost/fixture.exl`) — byte-identical
// is the gate (see examples/selfhost.expected).
//
// Each module is imported explicitly for the names it provides — `pos`
// for `Pos`, `ast` for the node types, `dump` for `dump_ast`.  `pos` is
// a shared leaf (`ast` imports it too); the loader hoists it once, so a
// module DAG is fine — no double-inlining.
//
// AST nodes live in an `Arena`: each is bump-allocated and handed back
// as a read-only `*const` borrow; the whole tree is released in one
// wholesale free when the arena leaves scope.  This is the parser's
// node-building shape (examples/arena.exl).  By-value nodes (`Stmt`,
// `Pattern`, `Param`, decls) ride in their `Vec`s directly.

use pos;
use ast::*;
use ir::*;
use dump::*;

// ===== str / Vec helpers =====

fn empty_strs(a: Allocator) -> Vec<str> {
    return Vec::with_capacity(a, 8 as u32);
}

fn one_str(a: Allocator, s: str) -> Vec<str> {
    let mut v: Vec<str> = Vec::with_capacity(a, 8 as u32);
    v.push(s);
    return v;
}

// ===== Type builders =====

fn ty_i32(ar: *Arena) -> *const TypeAnn {
    let t: *TypeAnn = ar.alloc_borrowed();
    *t = TypeAnn::TyInt { is_signed: true, width: IntWidth::W32 };
    return t as *const TypeAnn;
}

fn ty_const_ptr(ar: *Arena, inner: *const TypeAnn) -> *const TypeAnn {
    let t: *TypeAnn = ar.alloc_borrowed();
    *t = TypeAnn::TyConstPtr(inner);
    return t as *const TypeAnn;
}

fn ty_struct(a: Allocator, ar: *Arena, name: str) -> *const TypeAnn {
    let args: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    let t: *TypeAnn = ar.alloc_borrowed();
    *t = TypeAnn::TyStruct { path: one_str(a, name), args: args };
    return t as *const TypeAnn;
}

// ===== Expression builders =====

fn mk_string_lit(ar: *Arena, s: str) -> *const Expr {
    let e: *Expr = ar.alloc_borrowed();
    *e = Expr::StringLit(s, pos::Pos::zero());
    return e as *const Expr;
}

fn mk_var(ar: *Arena, name: str) -> *const Expr {
    let e: *Expr = ar.alloc_borrowed();
    *e = Expr::Var(name, pos::Pos::zero());
    return e as *const Expr;
}

fn mk_deref(ar: *Arena, sub: *const Expr) -> *const Expr {
    let e: *Expr = ar.alloc_borrowed();
    *e = Expr::Deref(sub, pos::Pos::zero());
    return e as *const Expr;
}

fn mk_mul(ar: *Arena, l: *const Expr, r: *const Expr) -> *const Expr {
    let e: *Expr = ar.alloc_borrowed();
    *e = Expr::BinOp(BinOp::Mul, l, r, pos::Pos::zero());
    return e as *const Expr;
}

// `f(arg)` — a single-argument call (the `println("…")` shape).
fn mk_call1(a: Allocator, ar: *Arena, fn_name: str, arg: *const Expr) -> *const Expr {
    let mut args: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    args.push(arg);
    let e: *Expr = ar.alloc_borrowed();
    *e = Expr::Call { callee: one_str(a, fn_name), args: args, pos: pos::Pos::zero() };
    return e as *const Expr;
}

// ===== Declaration builders =====

// `struct Point { x: int, y: int }`
fn build_point_struct(a: Allocator, ar: *Arena) -> StructDecl {
    let mut fields: Vec<FieldDef> = Vec::with_capacity(a, 8 as u32);
    fields.push(FieldDef { name: "x", ty: ty_i32(ar) });
    fields.push(FieldDef { name: "y", ty: ty_i32(ar) });
    let no_str: Option<str> = Option::None;
    return StructDecl {
        sname: "Point",
        stparams: empty_strs(a),
        sfields: fields,
        spos: pos::Pos::zero(),
        sis_pub: false,
        stier_hint: no_str,
        sis_debug: false,
        sderives: empty_strs(a),
        sis_move: false,
    };
}

// `enum Shape { Circle(int) | Rect { w: int, h: int } }`
fn build_shape_enum(a: Allocator, ar: *Arena) -> EnumDecl {
    let mut circle_tys: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    circle_tys.push(ty_i32(ar));

    let mut rect_fields: Vec<FieldDef> = Vec::with_capacity(a, 8 as u32);
    rect_fields.push(FieldDef { name: "w", ty: ty_i32(ar) });
    rect_fields.push(FieldDef { name: "h", ty: ty_i32(ar) });

    let mut variants: Vec<EnumVariant> = Vec::with_capacity(a, 8 as u32);
    variants.push(EnumVariant {
        vname: "Circle", vkind: VariantKind::VTuple(circle_tys), vpos: pos::Pos::zero(),
    });
    variants.push(EnumVariant {
        vname: "Rect", vkind: VariantKind::VStruct(rect_fields), vpos: pos::Pos::zero(),
    });

    let no_str: Option<str> = Option::None;
    return EnumDecl {
        ename: "Shape",
        etparams: empty_strs(a),
        evariants: variants,
        epos: pos::Pos::zero(),
        eis_pub: false,
        etier_hint: no_str,
        emust_use: false,
        eis_debug: false,
        ederives: empty_strs(a),
    };
}

// One unguarded match arm `<pat> => <body>`.
fn unguarded_arm(pat: Pattern, body: *const Expr) -> MatchArm {
    let no_guard: Option<*const Expr> = Option::None;
    return MatchArm { pat: pat, guard: no_guard, body: body, arm_pos: pos::Pos::zero() };
}

// `fn area(s: *const Shape) -> int { match *s { … } }`
fn build_area_fn(a: Allocator, ar: *Arena) -> Func {
    let no_preg: Option<str> = Option::None;
    let mut params: Vec<Param> = Vec::with_capacity(a, 8 as u32);
    params.push(Param {
        pname: "s",
        pty: ty_const_ptr(ar, ty_struct(a, ar, "Shape")),
        is_mut: false,
        preg: no_preg,
    });

    // Shape::Circle(r) => r * r
    let mut circle_binds: Vec<Pattern> = Vec::with_capacity(a, 8 as u32);
    circle_binds.push(Pattern::PVar("r", pos::Pos::zero()));
    let circle_pat = Pattern::PVariant {
        tname: one_str(a, "Shape"), variant: "Circle",
        binds: PatBinds::PBTuple(circle_binds), pos: pos::Pos::zero(),
    };
    let arm1 = unguarded_arm(circle_pat, mk_mul(ar, mk_var(ar, "r"), mk_var(ar, "r")));

    // Shape::Rect { w, h } => w * h
    let mut rect_binds: Vec<FieldPat> = Vec::with_capacity(a, 8 as u32);
    rect_binds.push(FieldPat { name: "w", pat: Pattern::PVar("w", pos::Pos::zero()) });
    rect_binds.push(FieldPat { name: "h", pat: Pattern::PVar("h", pos::Pos::zero()) });
    let rect_pat = Pattern::PVariant {
        tname: one_str(a, "Shape"), variant: "Rect",
        binds: PatBinds::PBStruct(rect_binds), pos: pos::Pos::zero(),
    };
    let arm2 = unguarded_arm(rect_pat, mk_mul(ar, mk_var(ar, "w"), mk_var(ar, "h")));

    let mut arms: Vec<MatchArm> = Vec::with_capacity(a, 8 as u32);
    arms.push(arm1);
    arms.push(arm2);

    let match_expr: *Expr = ar.alloc_borrowed();
    *match_expr = Expr::Match {
        scrutinee: mk_deref(ar, mk_var(ar, "s")), arms: arms, pos: pos::Pos::zero(),
    };

    let mut body: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    body.push(Stmt::Tail(match_expr as *const Expr));

    let ret: Option<*const TypeAnn> = Option::Some(ty_i32(ar));
    let no_str: Option<str> = Option::None;
    let tbounds: Vec<TraitBound> = Vec::with_capacity(a, 8 as u32);
    return Func {
        name: "area", c_name: "area",
        tparams: empty_strs(a), tbounds: tbounds,
        params: params, ret_ty: ret, body: body,
        is_pub: false, is_extern: false, is_variadic: false,
        amiga_lib: no_str, tier_hint: no_str,
        must_use: false, escapes_hatch: false, pos: pos::Pos::zero(),
    };
}

// `fn main() { println("Hello, World!"); }`
fn build_main_fn(a: Allocator, ar: *Arena) -> Func {
    let call = mk_call1(a, ar, "println", mk_string_lit(ar, "Hello, World!"));
    let mut body: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    body.push(Stmt::ExprStmt(call));

    let no_ret: Option<*const TypeAnn> = Option::None;
    let no_str: Option<str> = Option::None;
    let tbounds: Vec<TraitBound> = Vec::with_capacity(a, 8 as u32);
    let params: Vec<Param> = Vec::with_capacity(a, 8 as u32);
    return Func {
        name: "main", c_name: "main",
        tparams: empty_strs(a), tbounds: tbounds,
        params: params, ret_ty: no_ret, body: body,
        is_pub: false, is_extern: false, is_variadic: false,
        amiga_lib: no_str, tier_hint: no_str,
        must_use: false, escapes_hatch: false, pos: pos::Pos::zero(),
    };
}

fn build_fixture(a: Allocator, ar: *Arena) -> Vec<Item> {
    let mut prog: Vec<Item> = Vec::with_capacity(a, 8 as u32);
    prog.push(Item::Struct(build_point_struct(a, ar)));
    prog.push(Item::Enum(build_shape_enum(a, ar)));
    prog.push(Item::Function(build_area_fn(a, ar)));
    prog.push(Item::Function(build_main_fn(a, ar)));
    return prog;
}

// ===== Typed-IR fixture: examples/selfhost/ir_fixture.exl =====
//
//   fn add(a: int, b: int) -> int { return a + b; }
//   fn main() { println(add(40, 2)); }

fn ir_i32(ar: *Arena) -> *const Typ {
    let t: *Typ = ar.alloc_borrowed();
    *t = Typ::TInt(IntKind { is_signed: true, width: IntWidth::W32 });
    return t as *const Typ;
}

fn ir_node(ar: *Arena, node: TexprNode, ty: *const Typ) -> *const Texpr {
    let e: *Texpr = ar.alloc_borrowed();
    *e = Texpr { e: node, ty: ty, pos: pos::Pos::zero() };
    return e as *const Texpr;
}

// A non-extern, non-generic `ast::Func` with the given name + params +
// return type.  Only the name / params / flags / pos are read by the IR
// dumper (the typed body lives in `Tfunc.tf_body`), so the AST body is
// left empty.
fn ir_ast_func(a: Allocator, name: str, params: Vec<Param>,
               ret_ty: Option<*const TypeAnn>) -> Func {
    let no_str: Option<str> = Option::None;
    let tbounds: Vec<TraitBound> = Vec::with_capacity(a, 8 as u32);
    let body: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    return Func {
        name: name, c_name: name,
        tparams: empty_strs(a), tbounds: tbounds,
        params: params, ret_ty: ret_ty, body: body,
        is_pub: false, is_extern: false, is_variadic: false,
        amiga_lib: no_str, tier_hint: no_str,
        must_use: false, escapes_hatch: false, pos: pos::Pos::zero(),
    };
}

fn build_add_tfunc(a: Allocator, ar: *Arena) -> Tfunc {
    let no_preg: Option<str> = Option::None;
    let mut params: Vec<Param> = Vec::with_capacity(a, 8 as u32);
    params.push(Param { pname: "a", pty: ty_i32(ar), is_mut: false, preg: no_preg });
    params.push(Param { pname: "b", pty: ty_i32(ar), is_mut: false, preg: no_preg });
    let ast_ret: Option<*const TypeAnn> = Option::Some(ty_i32(ar));
    let f = ir_ast_func(a, "add", params, ast_ret);

    let mut ptys: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    ptys.push(ir_i32(ar));
    ptys.push(ir_i32(ar));

    // return a + b
    let va = ir_node(ar, TexprNode::TVar("a"), ir_i32(ar));
    let vb = ir_node(ar, TexprNode::TVar("b"), ir_i32(ar));
    let sum = ir_node(ar, TexprNode::TBinOp(BinOp::Add, va, vb), ir_i32(ar));
    let ret_val: Option<*const Texpr> = Option::Some(sum);
    let mut body: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    body.push(Tstmt::TReturn { value: ret_val, pos: pos::Pos::zero() });

    let ir_ret: Option<*const Typ> = Option::Some(ir_i32(ar));
    let tlets: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let no_origin: Option<pos::Pos> = Option::None;
    return Tfunc {
        tf_path: empty_strs(a), tf_func: f, tf_mangled: "ex_add",
        tf_param_tys: ptys, tf_ret_ty: ir_ret, tf_body: body,
        tf_lets: tlets, tf_origin_pos: no_origin,
    };
}

fn build_main_tfunc(a: Allocator, ar: *Arena) -> Tfunc {
    let params: Vec<Param> = Vec::with_capacity(a, 8 as u32);
    let no_ret: Option<*const TypeAnn> = Option::None;
    let f = ir_ast_func(a, "main", params, no_ret);

    // println(add(40, 2))
    let i40 = ir_node(ar, TexprNode::TIntLit(40), ir_i32(ar));
    let i2 = ir_node(ar, TexprNode::TIntLit(2), ir_i32(ar));
    let mut call_args: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    call_args.push(i40);
    call_args.push(i2);
    let call = ir_node(ar, TexprNode::TCall { mangled: "ex_add", args: call_args }, ir_i32(ar));
    let mut pr_args: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    pr_args.push(call);
    let pr = ir_node(ar, TexprNode::TBuiltinCall { name: "println", args: pr_args }, ir_i32(ar));
    let mut body: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    body.push(Tstmt::TExprStmt(pr));

    let no_ret_ty: Option<*const Typ> = Option::None;
    let ptys: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let tlets: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let no_origin: Option<pos::Pos> = Option::None;
    return Tfunc {
        tf_path: empty_strs(a), tf_func: f, tf_mangled: "main",
        tf_param_tys: ptys, tf_ret_ty: no_ret_ty, tf_body: body,
        tf_lets: tlets, tf_origin_pos: no_origin,
    };
}

// A minimal mono-instance entry: only the name is read by the dump.
fn prelude_struct(a: Allocator, name: str) -> StructSig {
    let fields: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let stparams: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let no_args: Option<Vec<*const Typ>> = Option::None;
    return StructSig {
        sname_path: one_str(a, name), sfields_ty: fields, sis_pub: true,
        stparams: stparams, sinstance_args: no_args,
        sis_debug: false, ss_is_move: false,
    };
}

fn prelude_enum(a: Allocator, name: str) -> EnumSig {
    let variants: Vec<VariantSig> = Vec::with_capacity(a, 8 as u32);
    let etparams: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let no_args: Option<Vec<*const Typ>> = Option::None;
    return EnumSig {
        ename_path: one_str(a, name), evariants: variants, eis_pub: true,
        etparams: etparams, einstance_args: no_args,
        eis_must_use: false, eis_debug: false,
    };
}

// The 12 prelude collection structs + 2 prelude enums that are always
// registered in the type index (pushed unsorted — the dumper sorts).
fn build_ir_program(a: Allocator, ar: *Arena) -> Tprogram {
    let mut funcs: Vec<Tfunc> = Vec::with_capacity(a, 8 as u32);
    funcs.push(build_add_tfunc(a, ar));
    funcs.push(build_main_tfunc(a, ar));

    let mut structs: Vec<StructSig> = Vec::with_capacity(a, 16 as u32);
    structs.push(prelude_struct(a, "Vec"));
    structs.push(prelude_struct(a, "VecIter"));
    structs.push(prelude_struct(a, "Slice"));
    structs.push(prelude_struct(a, "HashMap"));
    structs.push(prelude_struct(a, "HashMapIter"));
    structs.push(prelude_struct(a, "Slot"));
    structs.push(prelude_struct(a, "Range"));
    structs.push(prelude_struct(a, "RangeInclusive"));
    structs.push(prelude_struct(a, "Map"));
    structs.push(prelude_struct(a, "Filter"));
    structs.push(prelude_struct(a, "Take"));
    structs.push(prelude_struct(a, "Enumerate"));

    let mut enums: Vec<EnumSig> = Vec::with_capacity(a, 8 as u32);
    enums.push(prelude_enum(a, "Result"));
    enums.push(prelude_enum(a, "Option"));

    let struct_decls: Vec<StructDeclEntry> = Vec::with_capacity(a, 8 as u32);
    let global: Vec<GlobalEntry> = Vec::with_capacity(a, 8 as u32);
    let modules: Vec<ModuleEntry> = Vec::with_capacity(a, 8 as u32);
    let tuple_types: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let fnptr_types: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let c_includes: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let ext_consts: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let ext_vars: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let array_types: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let consts: Vec<StrPair> = Vec::with_capacity(a, 8 as u32);
    return Tprogram {
        tp_funcs: funcs,
        tp_struct_decls: struct_decls,
        tp_struct_index: structs,
        tp_enum_index: enums,
        tp_global: global,
        tp_modules: modules,
        tp_uses_heap: false,
        tp_uses_string_h: false,
        tp_uses_default_allocator: false,
        tp_tuple_types: tuple_types,
        tp_fnptr_types: fnptr_types,
        tp_c_includes: c_includes,
        tp_ext_consts: ext_consts,
        tp_ext_vars: ext_vars,
        tp_array_types: array_types,
        tp_consts: consts,
    };
}

// Flush a builder to stdout through the sys seam — the shape the
// self-host compiler uses to emit a dump to `-o` / stdout.
fn flush(sb: *const StringBuilder) {
    let bytes = sb.as_slice();
    sys::sys_write(1 as c_int, &bytes[0] as *const c_uchar, sb.length() as c_ulong);
}

fn main() {
    let a = default_allocator();
    let mut ar = Arena::with_capacity(a, 16384 as u32);

    let mut sb = StringBuilder::with_capacity(a, 2048 as u32);

    // AST stage fixture, then the typed-IR stage fixture — concatenated,
    // diffed as one stream against examples/selfhost.expected.
    let prog = build_fixture(a, &ar);
    dump_ast(&prog, "examples/selfhost/fixture.exl", &sb);

    let tp = build_ir_program(a, &ar);
    dump_typed_ir(&tp, "examples/selfhost/ir_fixture.exl", true, &sb);

    flush(&sb);
}
