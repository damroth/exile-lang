// Self-host port — the `--emit-ast` / `--emit-typed-ir` dumpers of
// `lib/dump.ml` (the token dumper lives in `dump_token`, shared
// escaping in `dump_util`).
//
// The canonical AST dump: one structural s-expression per top-level
// item, positions elided.  This is the differential-harness oracle the
// whole port is verified against — emission is decision-free by design
// (`"(" kind children ")"`), so the bytes match the OCaml emitter
// exactly.
//
// The OCaml renderers return strings and compose with `Printf.sprintf`;
// the exile port follows the prelude's writer pattern instead — every
// `render_*` writes into a shared `*StringBuilder`, so no heap string
// is allocated per node and the whole dump lands in one buffer.  The
// composition is identical byte-for-byte; only the plumbing differs.
//
// Two renderings are deliberately deferred (no prelude primitive yet),
// matching the token port:
//   - `FloatLit` uses OCaml's `%h` hexadecimal-float format, which has
//     no exile counterpart; the placeholder keeps the node shape.  The
//     differential corpus is verified on float-free inputs until a
//     `f64 -> str` formatter lands.

use ast::*;
use ir::*;
use dump_util::*;

// ===== Small literal-rendering helpers =====

fn int_width_suffix(w: IntWidth) -> str {
    match w {
        IntWidth::W8 => "8"
        | IntWidth::W16 => "16"
        | IntWidth::W32 => "32"
    }
}

fn signed_word(b: bool) -> str {
    if b { return "signed"; }
    return "unsigned";
}

fn float_width_tag(w: FloatWidth) -> str {
    match w {
        FloatWidth::F32 => "f32"
        | FloatWidth::F64 => "f64"
    }
}

// ===== List helpers =====
//
// The OCaml dumper leans on `String.concat " " (List.map f xs)` and
// `String.concat "::" path`.  These reproduce the same separators in
// the writer style: a space (or `::`) before every element but the
// first, nothing leading or trailing.

fn render_path(path: *const Vec<str>, out: *StringBuilder) {
    let n = path.length();
    let sl = path.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str("::"); }
        out.push_str(sl[i]);
        i = i + 1 as u32;
    }
}

fn render_str_list(xs: *const Vec<str>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        out.push_str(sl[i]);
        i = i + 1 as u32;
    }
}

fn render_expr_list(xs: *const Vec<*const Expr>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        render_expr(sl[i], out);
        i = i + 1 as u32;
    }
}

fn render_type_list(xs: *const Vec<*const TypeAnn>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        render_type_ann(sl[i], out);
        i = i + 1 as u32;
    }
}

// `(field <name> <expr>)` initialisers, space-separated.
fn render_field_list(xs: *const Vec<Field>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        out.push_str("(field ");
        out.push_str(sl[i].name);
        out.push_str(" ");
        render_expr(sl[i].value, out);
        out.push_str(")");
        i = i + 1 as u32;
    }
}

// `(field <name> <type>)` declarations, space-separated.
fn render_fielddef_list(xs: *const Vec<FieldDef>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        out.push_str("(field ");
        out.push_str(sl[i].name);
        out.push_str(" ");
        render_type_ann(sl[i].ty, out);
        out.push_str(")");
        i = i + 1 as u32;
    }
}

fn render_stmt_list(xs: *const Vec<Stmt>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        render_stmt(&sl[i], out);
        i = i + 1 as u32;
    }
}

fn render_pattern_list(xs: *const Vec<Pattern>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        render_pattern(&sl[i], out);
        i = i + 1 as u32;
    }
}

// ===== Type annotations =====

// `Foo` (no args) renders as `(struct Foo)`; a generic application
// `Option<int>` as `(struct-app Option (int i32))`.  Pulled out of the
// `render_type_ann` arm so the branching `if` lives in a fn body, not
// as a match-arm trailing value (a parser deferral — see WORKLOG).
fn render_struct_ty(path: *const Vec<str>, args: *const Vec<*const TypeAnn>,
                        out: *StringBuilder) {
    if args.length() == 0 as u32 {
        out.push_str("(struct ");
        render_path(path, out);
        out.push_str(")");
    } else {
        out.push_str("(struct-app ");
        render_path(path, out);
        out.push_str(" ");
        render_type_list(args, out);
        out.push_str(")");
    }
}

fn render_type_ann(ann: *const TypeAnn, out: *StringBuilder) {
    match *ann {
        TypeAnn::TyInt { is_signed, width } => {
            out.push_str("(int ");
            if is_signed { out.push_str("i"); } else { out.push_str("u"); }
            out.push_str(int_width_suffix(width));
            out.push_str(")");
        }
        | TypeAnn::TyCInt { is_signed } => {
            out.push_str("(c_int ");
            out.push_str(signed_word(is_signed));
            out.push_str(")");
        }
        | TypeAnn::TyCShort { is_signed } => {
            out.push_str("(c_short ");
            out.push_str(signed_word(is_signed));
            out.push_str(")");
        }
        | TypeAnn::TyCLong { is_signed } => {
            out.push_str("(c_long ");
            out.push_str(signed_word(is_signed));
            out.push_str(")");
        }
        | TypeAnn::TyCChar => { out.push_str("c_char"); }
        | TypeAnn::TyCSChar => { out.push_str("c_schar"); }
        | TypeAnn::TyCUChar => { out.push_str("c_uchar"); }
        | TypeAnn::TyCVoid => { out.push_str("c_void"); }
        | TypeAnn::TyStr => { out.push_str("str"); }
        | TypeAnn::TyBool => { out.push_str("bool"); }
        | TypeAnn::TyFloat(w) => {
            out.push_str("(float ");
            out.push_str(float_width_tag(w));
            out.push_str(")");
        }
        | TypeAnn::TyTuple(ts) => {
            out.push_str("(tuple ");
            render_type_list(&ts, out);
            out.push_str(")");
        }
        | TypeAnn::TyStruct { path, args } => {
            render_struct_ty(&path, &args, out);
        }
        | TypeAnn::TyPtr(t) => {
            out.push_str("(ptr ");
            render_type_ann(t, out);
            out.push_str(")");
        }
        | TypeAnn::TyOwnPtr(t) => {
            out.push_str("(own-ptr ");
            render_type_ann(t, out);
            out.push_str(")");
        }
        | TypeAnn::TyConstPtr(t) => {
            out.push_str("(const-ptr ");
            render_type_ann(t, out);
            out.push_str(")");
        }
        | TypeAnn::TyArray { elem } => {
            // Size is a const-expr; the AST dump only marks the
            // array shape (the resolved IR dump carries the number).
            out.push_str("(array ");
            render_type_ann(elem, out);
            out.push_str(" ?)");
        }
        | TypeAnn::TySelf => { out.push_str("self"); }
        | TypeAnn::TyFnPtr { params, ret } => {
            out.push_str("(fn-ptr ");
            if params.length() == 0 as u32 {
                out.push_str("()");
            } else {
                out.push_str("(");
                render_type_list(&params, out);
                out.push_str(")");
            }
            out.push_str(" ");
            render_ret(ret, out);
            out.push_str(")");
        }
    }
}

// `void` for a missing return type, else the rendered type.  Shared by
// fn-ptr types, lambdas, and function decls.
fn render_ret(ret: Option<*const TypeAnn>, out: *StringBuilder) {
    match ret {
        Option::Some(t) => { render_type_ann(t, out); }
        | Option::None => { out.push_str("void"); }
    }
}

// ===== Expressions =====

fn render_expr(e: *const Expr, out: *StringBuilder) {
    match *e {
        Expr::IntLit(n, _) => {
            out.push_str("(int ");
            out.push_int(n);
            out.push_str(")");
        }
        | Expr::FloatLit(_f, w, _) => {
            // `%h` hex-float deferred (no prelude primitive); the tag
            // keeps the node shape for the float-free corpus.
            out.push_str("(float ?? ");
            out.push_str(float_width_tag(w));
            out.push_str(")");
        }
        | Expr::BoolLit(b, _) => {
            out.push_str("(bool ");
            if b { out.push_str("true"); } else { out.push_str("false"); }
            out.push_str(")");
        }
        | Expr::StringLit(s, _) => {
            out.push_str("(string ");
            escape_string(s, out);
            out.push_str(")");
        }
        | Expr::NullLit(_) => { out.push_str("null"); }
        | Expr::Var(n, _) => {
            out.push_str("(var ");
            out.push_str(n);
            out.push_str(")");
        }
        | Expr::Neg(sub, _) => {
            out.push_str("(neg ");
            render_expr(sub, out);
            out.push_str(")");
        }
        | Expr::BitNot(sub, _) => {
            out.push_str("(bit-not ");
            render_expr(sub, out);
            out.push_str(")");
        }
        | Expr::Not(sub, _) => {
            out.push_str("(not ");
            render_expr(sub, out);
            out.push_str(")");
        }
        | Expr::BinOp(op, l, r, _) => {
            out.push_str("(binop ");
            out.push_str(binop_name(op));
            out.push_str(" ");
            render_expr(l, out);
            out.push_str(" ");
            render_expr(r, out);
            out.push_str(")");
        }
        | Expr::Orelse(a, b, _) => {
            out.push_str("(orelse ");
            render_expr(a, out);
            out.push_str(" ");
            render_expr(b, out);
            out.push_str(")");
        }
        | Expr::Try(a, _) => {
            out.push_str("(try ");
            render_expr(a, out);
            out.push_str(")");
        }
        | Expr::Cast(sub, ann, _) => {
            out.push_str("(cast ");
            render_expr(sub, out);
            out.push_str(" ");
            render_type_ann(ann, out);
            out.push_str(")");
        }
        | Expr::SizeOf(ann, _) => {
            out.push_str("(size-of ");
            render_type_ann(ann, out);
            out.push_str(")");
        }
        | Expr::TupleLit(es, _) => {
            out.push_str("(tuple-lit ");
            render_expr_list(&es, out);
            out.push_str(")");
        }
        | Expr::Call { callee, args } => {
            out.push_str("(call ");
            render_path(&callee, out);
            out.push_str(" ");
            render_expr_list(&args, out);
            out.push_str(")");
        }
        | Expr::MethodCall { receiver, name, args } => {
            out.push_str("(method-call ");
            render_expr(receiver, out);
            out.push_str(" ");
            out.push_str(name);
            out.push_str(" ");
            render_expr_list(&args, out);
            out.push_str(")");
        }
        | Expr::StructLit { tname, fields, base } => {
            out.push_str("(struct-lit ");
            render_path(&tname, out);
            out.push_str(" ");
            render_field_list(&fields, out);
            render_base(base, out);
            out.push_str(")");
        }
        | Expr::FieldAccess(sub, n, _) => {
            out.push_str("(field-access ");
            render_expr(sub, out);
            out.push_str(" ");
            out.push_str(n);
            out.push_str(")");
        }
        | Expr::Ref(sub, _) => {
            out.push_str("(ref ");
            render_expr(sub, out);
            out.push_str(")");
        }
        | Expr::Deref(sub, _) => {
            out.push_str("(deref ");
            render_expr(sub, out);
            out.push_str(")");
        }
        | Expr::New { tname, fields, base } => {
            out.push_str("(new ");
            render_path(&tname, out);
            out.push_str(" ");
            render_field_list(&fields, out);
            render_base(base, out);
            out.push_str(")");
        }
        | Expr::NewEnum { tname, args } => {
            out.push_str("(new-enum ");
            render_path(&tname, out);
            out.push_str(" ");
            render_expr_list(&args, out);
            out.push_str(")");
        }
        | Expr::EnumLit { tname, variant, args } => {
            out.push_str("(enum-lit ");
            render_path(&tname, out);
            out.push_str("::");
            out.push_str(variant);
            render_enum_args(&args, out);
            out.push_str(")");
        }
        | Expr::Match { scrutinee, arms } => {
            out.push_str("(match ");
            render_expr(scrutinee, out);
            out.push_str(" ");
            render_arm_list(&arms, out);
            out.push_str(")");
        }
        | Expr::If { cond, then_blk, else_blk } => {
            out.push_str("(if ");
            render_expr(cond, out);
            out.push_str(" (then ");
            render_stmt_list(&then_blk, out);
            out.push_str(")");
            render_else(else_blk, out);
            out.push_str(")");
        }
        | Expr::ArrayLit(es, _) => {
            out.push_str("(array-lit ");
            render_expr_list(&es, out);
            out.push_str(")");
        }
        | Expr::ArrayRepeat { value, count } => {
            out.push_str("(array-repeat ");
            render_expr(value, out);
            out.push_str(" ");
            render_expr(count, out);
            out.push_str(")");
        }
        | Expr::Index { base, index } => {
            out.push_str("(index ");
            render_expr(base, out);
            out.push_str(" ");
            render_expr(index, out);
            out.push_str(")");
        }
        | Expr::Range { lo, hi, inclusive } => {
            out.push_str("(range ");
            render_expr(lo, out);
            out.push_str(" ");
            render_expr(hi, out);
            out.push_str(" ");
            if inclusive { out.push_str("inclusive"); }
            else { out.push_str("exclusive"); }
            out.push_str(")");
        }
        | Expr::Block(stmts, _) => {
            out.push_str("(block ");
            render_stmt_list(&stmts, out);
            out.push_str(")");
        }
        | Expr::Lambda { params, ret_ty, body } => {
            out.push_str("(lambda (");
            render_fielddef_as_params(&params, out);
            out.push_str(") ");
            render_ret(ret_ty, out);
            out.push_str(" ");
            render_expr(body, out);
            out.push_str(")");
        }
    }
}

// `(base <expr>)` suffix on struct-lit / new, or nothing.
fn render_base(base: Option<*const Expr>, out: *StringBuilder) {
    match base {
        Option::Some(b) => {
            out.push_str(" (base ");
            render_expr(b, out);
            out.push_str(")");
        }
        | Option::None => { }
    }
}

// Enum-constructor argument tail: empty for a unit ctor, ` <e1> <e2>`
// for tuple args, ` (field n e)...` for struct args.  The conditional
// leading space lives in void helpers (a match arm can't trail a bare
// `if` — it would be read as the arm's value).
fn render_enum_args(args: *const EnumLitArgs, out: *StringBuilder) {
    match *args {
        EnumLitArgs::EATuple(es) => { render_tuple_tail(&es, out); }
        | EnumLitArgs::EAStruct(fs) => { render_struct_tail(&fs, out); }
    }
}

fn render_tuple_tail(es: *const Vec<*const Expr>, out: *StringBuilder) {
    if es.length() > 0 as u32 {
        out.push_str(" ");
        render_expr_list(es, out);
    }
}

fn render_struct_tail(fs: *const Vec<Field>, out: *StringBuilder) {
    if fs.length() > 0 as u32 {
        out.push_str(" ");
        render_field_list(fs, out);
    }
}

// ` (else <stmts>)` suffix on an if-expr, or nothing.
fn render_else(else_blk: Option<Vec<Stmt>>, out: *StringBuilder) {
    match else_blk {
        Option::Some(b) => {
            out.push_str(" (else ");
            render_stmt_list(&b, out);
            out.push_str(")");
        }
        | Option::None => { }
    }
}

// Lambda parameters render as `(param <name> <type>)`, unlike struct
// fields (`(field ...)`), so they get their own loop.
fn render_fielddef_as_params(xs: *const Vec<FieldDef>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        out.push_str("(param ");
        out.push_str(sl[i].name);
        out.push_str(" ");
        render_type_ann(sl[i].ty, out);
        out.push_str(")");
        i = i + 1 as u32;
    }
}

// ===== Match arms =====

fn render_arm_list(xs: *const Vec<MatchArm>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        render_arm(&sl[i], out);
        i = i + 1 as u32;
    }
}

fn render_arm(a: *const MatchArm, out: *StringBuilder) {
    out.push_str("(arm ");
    render_pattern(&a.pat, out);
    render_guard(a.guard, out);
    out.push_str(" ");
    render_expr(a.body, out);
    out.push_str(")");
}

fn render_guard(guard: Option<*const Expr>, out: *StringBuilder) {
    match guard {
        Option::Some(g) => {
            out.push_str(" (guard ");
            render_expr(g, out);
            out.push_str(")");
        }
        | Option::None => { }
    }
}

// ===== Patterns =====

fn render_pattern(p: *const Pattern, out: *StringBuilder) {
    match *p {
        Pattern::PWildcard(_) => { out.push_str("_"); }
        | Pattern::PVar(n, _) => {
            out.push_str("(pat-var ");
            out.push_str(n);
            out.push_str(")");
        }
        | Pattern::PLit(n, _) => {
            out.push_str("(pat-lit ");
            out.push_int(n);
            out.push_str(")");
        }
        | Pattern::PVariant { tname, variant, binds } => {
            out.push_str("(pat-variant ");
            render_path(&tname, out);
            out.push_str("::");
            out.push_str(variant);
            render_binds(&binds, out);
            out.push_str(")");
        }
        | Pattern::POr(alts, _) => {
            out.push_str("(pat-or ");
            render_pattern_list(&alts, out);
            out.push_str(")");
        }
    }
}

// A variant pattern's payload tail: empty for a unit variant, ` <p1>
// <p2>` for tuple binds, ` (field n p)...` for struct binds.
fn render_binds(binds: *const PatBinds, out: *StringBuilder) {
    match *binds {
        PatBinds::PBTuple(ps) => { render_tuple_binds(&ps, out); }
        | PatBinds::PBStruct(fs) => { render_struct_binds(&fs, out); }
    }
}

fn render_tuple_binds(ps: *const Vec<Pattern>, out: *StringBuilder) {
    if ps.length() > 0 as u32 {
        out.push_str(" ");
        render_pattern_list(ps, out);
    }
}

fn render_struct_binds(fs: *const Vec<FieldPat>, out: *StringBuilder) {
    if fs.length() > 0 as u32 {
        out.push_str(" ");
        render_fieldpat_list(fs, out);
    }
}

fn render_fieldpat_list(xs: *const Vec<FieldPat>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        out.push_str("(field ");
        out.push_str(sl[i].name);
        out.push_str(" ");
        render_pattern(&sl[i].pat, out);
        out.push_str(")");
        i = i + 1 as u32;
    }
}

// ===== Statements =====

fn render_stmt(s: *const Stmt, out: *StringBuilder) {
    match *s {
        Stmt::Let { name, value, ty_ann, is_mut } => {
            out.push_str("(let");
            if is_mut { out.push_str(" mut"); }
            out.push_str(" ");
            out.push_str(name);
            render_let_ty(ty_ann, out);
            out.push_str(" ");
            render_expr(value, out);
            out.push_str(")");
        }
        | Stmt::LetTuple { names, value, is_mut } => {
            out.push_str("(let-tuple");
            if is_mut { out.push_str(" mut"); }
            out.push_str(" (");
            render_str_list(&names, out);
            out.push_str(") ");
            render_expr(value, out);
            out.push_str(")");
        }
        | Stmt::LetElse { pat, value, else_body } => {
            out.push_str("(let-else ");
            render_pattern(&pat, out);
            out.push_str(" ");
            render_expr(value, out);
            out.push_str(" (else ");
            render_stmt_list(&else_body, out);
            out.push_str("))");
        }
        | Stmt::Assign { path, value } => {
            out.push_str("(assign ");
            render_path(&path, out);
            out.push_str(" ");
            render_expr(value, out);
            out.push_str(")");
        }
        | Stmt::AssignField { target, field, value } => {
            out.push_str("(assign-field ");
            render_expr(target, out);
            out.push_str(" ");
            out.push_str(field);
            out.push_str(" ");
            render_expr(value, out);
            out.push_str(")");
        }
        | Stmt::AssignIndex { base, index, value } => {
            out.push_str("(assign-index ");
            render_expr(base, out);
            out.push_str(" ");
            render_expr(index, out);
            out.push_str(" ");
            render_expr(value, out);
            out.push_str(")");
        }
        | Stmt::AssignDeref { target, value } => {
            out.push_str("(assign-deref ");
            render_expr(target, out);
            out.push_str(" ");
            render_expr(value, out);
            out.push_str(")");
        }
        | Stmt::Return(value, _) => {
            match value {
                Option::Some(e) => {
                    out.push_str("(return ");
                    render_expr(e, out);
                    out.push_str(")");
                }
                | Option::None => { out.push_str("(return)"); }
            }
        }
        | Stmt::ExprStmt(e) => {
            out.push_str("(expr-stmt ");
            render_expr(e, out);
            out.push_str(")");
        }
        | Stmt::Tail(e) => {
            out.push_str("(tail ");
            render_expr(e, out);
            out.push_str(")");
        }
        | Stmt::While { cond, body } => {
            out.push_str("(while ");
            render_expr(cond, out);
            out.push_str(" ");
            render_stmt_list(&body, out);
            out.push_str(")");
        }
        | Stmt::For { iter_var, range, body } => {
            out.push_str("(for ");
            out.push_str(iter_var);
            out.push_str(" ");
            render_expr(range, out);
            out.push_str(" ");
            render_stmt_list(&body, out);
            out.push_str(")");
        }
        | Stmt::Defer { body } => {
            out.push_str("(defer ");
            render_stmt_list(&body, out);
            out.push_str(")");
        }
        | Stmt::With { target, name, body } => {
            out.push_str("(with ");
            out.push_str(name);
            out.push_str(" ");
            render_expr(target, out);
            out.push_str(" ");
            render_stmt_list(&body, out);
            out.push_str(")");
        }
        | Stmt::Break(_) => { out.push_str("(break)"); }
        | Stmt::Continue(_) => { out.push_str("(continue)"); }
    }
}

// ` (ty <type>)` annotation on a `let`, or nothing.
fn render_let_ty(ty_ann: Option<*const TypeAnn>, out: *StringBuilder) {
    match ty_ann {
        Option::Some(t) => {
            out.push_str(" (ty ");
            render_type_ann(t, out);
            out.push_str(")");
        }
        | Option::None => { }
    }
}

// ===== Declarations =====

fn render_param(p: *const Param, out: *StringBuilder) {
    out.push_str("(param");
    if p.is_mut { out.push_str(" mut"); }
    out.push_str(" ");
    out.push_str(p.pname);
    out.push_str(" ");
    render_type_ann(p.pty, out);
    out.push_str(")");
}

fn render_param_list(xs: *const Vec<Param>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        render_param(&sl[i], out);
        i = i + 1 as u32;
    }
}

fn render_func(f: *const Func, out: *StringBuilder) {
    out.push_str("(fn ");
    out.push_str(f.name);
    if f.is_extern { out.push_str(" extern"); }
    if f.is_pub { out.push_str(" pub"); }
    if f.is_variadic { out.push_str(" variadic"); }
    if f.must_use { out.push_str(" must-use"); }
    if f.escapes_hatch { out.push_str(" escapes"); }
    render_tparams(&f.tparams, out);
    out.push_str(" (params ");
    render_param_list(&f.params, out);
    out.push_str(") ");
    render_ret(f.ret_ty, out);
    if !f.is_extern {
        out.push_str(" (body ");
        render_stmt_list(&f.body, out);
        out.push_str(")");
    }
    out.push_str(")");
}

// ` (tparams A B)` on a generic decl, or nothing.
fn render_tparams(tparams: *const Vec<str>, out: *StringBuilder) {
    if tparams.length() > 0 as u32 {
        out.push_str(" (tparams ");
        render_str_list(tparams, out);
        out.push_str(")");
    }
}

fn render_func_list(xs: *const Vec<Func>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        render_func(&sl[i], out);
        i = i + 1 as u32;
    }
}

fn render_struct_decl(s: *const StructDecl, out: *StringBuilder) {
    out.push_str("(struct ");
    out.push_str(s.sname);
    if s.sis_pub { out.push_str(" pub"); }
    if s.sis_move { out.push_str(" move"); }
    render_tparams(&s.stparams, out);
    out.push_str(" (fields ");
    render_fielddef_list(&s.sfields, out);
    out.push_str("))");
}

fn render_enum_decl(e: *const EnumDecl, out: *StringBuilder) {
    out.push_str("(enum ");
    out.push_str(e.ename);
    if e.eis_pub { out.push_str(" pub"); }
    render_tparams(&e.etparams, out);
    out.push_str(" (variants ");
    render_variant_list(&e.evariants, out);
    out.push_str("))");
}

fn render_variant_list(xs: *const Vec<EnumVariant>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        out.push_str("(variant ");
        out.push_str(sl[i].vname);
        render_variant_kind(&sl[i].vkind, out);
        out.push_str(")");
        i = i + 1 as u32;
    }
}

fn render_variant_kind(k: *const VariantKind, out: *StringBuilder) {
    match *k {
        VariantKind::VUnit => { }
        | VariantKind::VTuple(ts) => {
            out.push_str(" ");
            render_type_list(&ts, out);
        }
        | VariantKind::VStruct(fs) => {
            out.push_str(" ");
            render_fielddef_list(&fs, out);
        }
    }
}

// ===== Top-level items =====

fn render_item(it: *const Item, out: *StringBuilder) {
    match *it {
        Item::Function(f) => { render_func(&f, out); }
        | Item::Struct(s) => { render_struct_decl(&s, out); }
        | Item::Enum(e) => { render_enum_decl(&e, out); }
        | Item::Const(c) => {
            out.push_str("(const ");
            out.push_str(c.kname);
            out.push_str(" ");
            render_type_ann(c.kty, out);
            out.push_str(" ");
            render_expr(c.kvalue, out);
            out.push_str(")");
        }
        | Item::TypeAlias(ta) => {
            out.push_str("(type-alias ");
            out.push_str(ta.taname);
            render_tparams(&ta.tatparams, out);
            out.push_str(" ");
            render_type_ann(ta.tatarget, out);
            out.push_str(")");
        }
        | Item::ExternStruct(es) => {
            out.push_str("(extern-struct ");
            out.push_str(es.esname);
            out.push_str(")");
        }
        | Item::ExternType(et) => {
            out.push_str("(extern-type ");
            out.push_str(et.xtname);
            out.push_str(")");
        }
        | Item::ExternConst(ec) => {
            out.push_str("(extern-const ");
            out.push_str(ec.ecname);
            out.push_str(" ");
            render_type_ann(ec.ecty, out);
            out.push_str(")");
        }
        | Item::ExternVar(ev) => {
            out.push_str("(extern-var ");
            out.push_str(ev.evname);
            out.push_str(" ");
            render_type_ann(ev.evty, out);
            out.push_str(")");
        }
        | Item::Impl(ib) => {
            out.push_str("(impl ");
            render_path(&ib.itarget, out);
            render_impl_trait(ib.itrait, out);
            out.push_str(" ");
            render_func_list(&ib.iitems, out);
            out.push_str(")");
        }
        | Item::Trait(td) => {
            out.push_str("(trait ");
            out.push_str(td.trname);
            out.push_str(" ");
            render_func_list(&td.trmethods, out);
            out.push_str(")");
        }
        | Item::View(v) => {
            out.push_str("(view ");
            out.push_str(v.vname);
            out.push_str(" ");
            render_param(&v.vparam, out);
            out.push_str(" ");
            render_view_cases(&v.vcases, out);
            out.push_str(" (body ");
            render_stmt_list(&v.vbody, out);
            out.push_str("))");
        }
        | Item::Module(m) => {
            out.push_str("(module ");
            out.push_str(m.mname);
            out.push_str("\n  ");
            render_module_items(&m.mitems, out);
            out.push_str(")");
        }
        | Item::Use { path, is_wildcard, is_pub } => {
            out.push_str("(use ");
            if is_pub { out.push_str("pub "); }
            render_path(&path, out);
            if is_wildcard { out.push_str("::*"); }
            out.push_str(")");
        }
        | Item::CInclude { path } => {
            out.push_str("(c-include ");
            escape_string(path, out);
            out.push_str(")");
        }
    }
}

// `impl Foo` is bare; `impl Trait for Foo` carries ` (trait Trait)`.
fn render_impl_trait(itrait: Option<Vec<str>>, out: *StringBuilder) {
    match itrait {
        Option::Some(p) => {
            out.push_str(" (trait ");
            render_path(&p, out);
            out.push_str(")");
        }
        | Option::None => { }
    }
}

fn render_view_cases(xs: *const Vec<ViewCase>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        out.push_str("(case ");
        out.push_str(sl[i].vcname);
        if sl[i].vcfields.length() > 0 as u32 {
            out.push_str(" ");
            render_fielddef_list(&sl[i].vcfields, out);
        }
        out.push_str(")");
        i = i + 1 as u32;
    }
}

// Module bodies render their items joined by `\n  ` (two-space indent),
// matching the OCaml `String.concat "\n  "`.
fn render_module_items(xs: *const Vec<Item>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str("\n  "); }
        render_item(&sl[i], out);
        i = i + 1 as u32;
    }
}

// ===== Top-level driver =====

// `dump_ast` — the whole program as one line per top-level item, under
// the `;; exile-ast-dump v1 <file>` header.  Mirrors OCaml `dump_ast`.
pub fn dump_ast(program: *const Vec<Item>, file: str, out: *StringBuilder) {
    out.push_str(";; exile-ast-dump v1 ");
    out.push_str(file);
    out.push_str("\n");
    let n = program.length();
    let sl = program.as_slice();
    let mut i = 0 as u32;
    while i < n {
        render_item(&sl[i], out);
        out.push_str("\n");
        i = i + 1 as u32;
    }
}

// =====================================================================
// Typed IR dump — the `--emit-typed-ir` half of `lib/dump.ml`.
//
// Runs post-typecheck and post-lift, so `TFor` / `TForEach` are gone:
// their appearance in the dump is an internal-compiler-bug signal.
// Every `texpr` carries an explicit `:ty <render_typ_canonical>` so
// inference / dispatch / mono decisions are visible in the diff.  A
// sorted `(mono-instances ...)` section follows the fn list so the
// type index's iteration order never leaks into the output.
// =====================================================================

// ===== Canonical type rendering =====
//
// Distinct from the (deferred) `typ_name` / `mangle_typ` utilities:
// int / c-int variants always carry explicit width + signedness, paths
// are absolute, structural constructors are prefixed.

fn render_typ_canon_list(xs: *const Vec<*const Typ>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        render_typ_canonical(sl[i], out);
        i = i + 1 as u32;
    }
}

// `()` for a no-arg fn-ptr, `(T1 T2)` otherwise.
fn render_fnptr_params(params: *const Vec<*const Typ>, out: *StringBuilder) {
    if params.length() == 0 as u32 {
        out.push_str("()");
    } else {
        out.push_str("(");
        render_typ_canon_list(params, out);
        out.push_str(")");
    }
}

// `void` for a missing return type, else the rendered type.
fn render_typ_canon_ret(ret: Option<*const Typ>, out: *StringBuilder) {
    match ret {
        Option::Some(t) => { render_typ_canonical(t, out); }
        | Option::None => { out.push_str("void"); }
    }
}

fn render_typ_canonical(t: *const Typ, out: *StringBuilder) {
    match *t {
        Typ::TInt(k) => {
            out.push_str("(int ");
            if k.is_signed { out.push_str("i"); } else { out.push_str("u"); }
            out.push_str(int_width_suffix(k.width));
            out.push_str(")");
        }
        | Typ::TCInt { is_signed } => {
            out.push_str("(c_int ");
            out.push_str(signed_word(is_signed));
            out.push_str(")");
        }
        | Typ::TCShort { is_signed } => {
            out.push_str("(c_short ");
            out.push_str(signed_word(is_signed));
            out.push_str(")");
        }
        | Typ::TCLong { is_signed } => {
            out.push_str("(c_long ");
            out.push_str(signed_word(is_signed));
            out.push_str(")");
        }
        | Typ::TCChar => { out.push_str("c_char"); }
        | Typ::TCSChar => { out.push_str("c_schar"); }
        | Typ::TCUChar => { out.push_str("c_uchar"); }
        | Typ::TCVoid => { out.push_str("c_void"); }
        | Typ::TBool => { out.push_str("bool"); }
        | Typ::TFloat(w) => {
            out.push_str("(float ");
            out.push_str(float_width_tag(w));
            out.push_str(")");
        }
        | Typ::TString => { out.push_str("str"); }
        | Typ::TNullPtr => { out.push_str("null-ptr"); }
        | Typ::TStruct(path) => {
            out.push_str("(struct ");
            render_path(&path, out);
            out.push_str(")");
        }
        | Typ::TEnum(path) => {
            out.push_str("(enum ");
            render_path(&path, out);
            out.push_str(")");
        }
        | Typ::TExtStruct(n) => {
            out.push_str("(ext-struct ");
            out.push_str(n);
            out.push_str(")");
        }
        | Typ::TExtAlias(n) => {
            out.push_str("(ext-alias ");
            out.push_str(n);
            out.push_str(")");
        }
        | Typ::TPtr(inner) => {
            out.push_str("(ptr ");
            render_typ_canonical(inner, out);
            out.push_str(")");
        }
        | Typ::TOwnPtr(inner) => {
            out.push_str("(own-ptr ");
            render_typ_canonical(inner, out);
            out.push_str(")");
        }
        | Typ::TConstPtr(inner) => {
            out.push_str("(const-ptr ");
            render_typ_canonical(inner, out);
            out.push_str(")");
        }
        | Typ::TArray { elem, size } => {
            out.push_str("(array ");
            render_typ_canonical(elem, out);
            out.push_str(" ");
            out.push_int(size);
            out.push_str(")");
        }
        | Typ::TTuple(ts) => {
            out.push_str("(tuple ");
            render_typ_canon_list(&ts, out);
            out.push_str(")");
        }
        | Typ::TFnPtr { params, ret } => {
            out.push_str("(fn-ptr ");
            render_fnptr_params(&params, out);
            out.push_str(" ");
            render_typ_canon_ret(ret, out);
            out.push_str(")");
        }
        | Typ::TVar(n) => {
            out.push_str("(tvar ");
            out.push_str(n);
            out.push_str(")");
        }
        | Typ::TStructApp { path, args } => {
            out.push_str("(struct-app ");
            render_path(&path, out);
            out.push_str(" ");
            render_typ_canon_list(&args, out);
            out.push_str(")");
        }
        | Typ::TEnumApp { path, args } => {
            out.push_str("(enum-app ");
            render_path(&path, out);
            out.push_str(" ");
            render_typ_canon_list(&args, out);
            out.push_str(")");
        }
        | Typ::TAssocProj { head, assoc } => {
            out.push_str("(assoc-proj ");
            render_typ_canonical(head, out);
            out.push_str(" ");
            out.push_str(assoc);
            out.push_str(")");
        }
    }
}

// ===== Typed patterns =====

fn render_tpattern_list(xs: *const Vec<Tpattern>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        render_tpattern(&sl[i], out);
        i = i + 1 as u32;
    }
}

fn render_tfieldpat_list(xs: *const Vec<TFieldPat>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        out.push_str("(field ");
        out.push_str(sl[i].name);
        out.push_str(" ");
        render_tpattern(&sl[i].pat, out);
        out.push_str(")");
        i = i + 1 as u32;
    }
}

// A variant pattern's bind tail: empty, or ` (field n p)...` (leading
// space).  Pulled into a void helper so the `if` is not a match-arm
// trailing value.
fn render_tbinds_tail(binds: *const Vec<TFieldPat>, out: *StringBuilder) {
    if binds.length() > 0 as u32 {
        out.push_str(" ");
        render_tfieldpat_list(binds, out);
    }
}

fn render_tpattern(p: *const Tpattern, out: *StringBuilder) {
    match *p {
        Tpattern::TPWildcard => { out.push_str("_"); }
        | Tpattern::TPVar(n) => {
            out.push_str("(pat-var ");
            out.push_str(n);
            out.push_str(")");
        }
        | Tpattern::TPLit(n) => {
            out.push_str("(pat-lit ");
            out.push_int(n);
            out.push_str(")");
        }
        | Tpattern::TPVariant { variant, tag, binds } => {
            out.push_str("(pat-variant ");
            out.push_str(variant);
            out.push_str(" tag=");
            out.push_int(tag);
            render_tbinds_tail(&binds, out);
            out.push_str(")");
        }
        | Tpattern::TPOr(alts) => {
            out.push_str("(pat-or ");
            render_tpattern_list(&alts, out);
            out.push_str(")");
        }
    }
}

// ===== Typed expressions =====

fn render_texpr_list(xs: *const Vec<*const Texpr>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        render_texpr(sl[i], out);
        i = i + 1 as u32;
    }
}

fn render_texprfield_list(xs: *const Vec<TexprField>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        out.push_str("(field ");
        out.push_str(sl[i].name);
        out.push_str(" ");
        render_texpr(sl[i].value, out);
        out.push_str(")");
        i = i + 1 as u32;
    }
}

// ` <e1> <e2>` argument tail (leading space) for a non-empty arg list.
fn render_targs_tail(args: *const Vec<*const Texpr>, out: *StringBuilder) {
    if args.length() > 0 as u32 {
        out.push_str(" ");
        render_texpr_list(args, out);
    }
}

// ` (field n e)...` field tail (leading space) for non-empty enum args.
fn render_tfields_tail(args: *const Vec<TexprField>, out: *StringBuilder) {
    if args.length() > 0 as u32 {
        out.push_str(" ");
        render_texprfield_list(args, out);
    }
}

// ` (base <e>)` suffix or nothing.
fn render_tbase(base: Option<*const Texpr>, out: *StringBuilder) {
    match base {
        Option::Some(b) => {
            out.push_str(" (base ");
            render_texpr(b, out);
            out.push_str(")");
        }
        | Option::None => { }
    }
}

// ` (guard <e>)` suffix or nothing.
fn render_tguard(guard: Option<*const Texpr>, out: *StringBuilder) {
    match guard {
        Option::Some(g) => {
            out.push_str(" (guard ");
            render_texpr(g, out);
            out.push_str(")");
        }
        | Option::None => { }
    }
}

// ` (trailing <e>)` suffix on a block, or nothing.
fn render_ttrailing(trailing: Option<*const Texpr>, out: *StringBuilder) {
    match trailing {
        Option::Some(t) => {
            out.push_str(" (trailing ");
            render_texpr(t, out);
            out.push_str(")");
        }
        | Option::None => { }
    }
}

fn render_tarm(a: *const TmatchArm, out: *StringBuilder) {
    out.push_str("(arm ");
    render_tpattern(&a.tpat, out);
    render_tguard(a.tguard, out);
    if a.tdiverges { out.push_str(" diverges"); }
    out.push_str(" ");
    render_texpr(a.tbody, out);
    out.push_str(")");
}

fn render_tarm_list(xs: *const Vec<TmatchArm>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        render_tarm(&sl[i], out);
        i = i + 1 as u32;
    }
}

// `Foo::Variant` head shared by enum-lit / new-enum / match.
fn render_variant_head(prefix: str, path: *const Vec<str>, variant: str,
                       tag: int, out: *StringBuilder) {
    out.push_str(prefix);
    render_path(path, out);
    out.push_str("::");
    out.push_str(variant);
    out.push_str(" tag=");
    out.push_int(tag);
}

fn render_texpr(te: *const Texpr, out: *StringBuilder) {
    render_texpr_node(te, out);
    out.push_str(" :ty ");
    render_typ_canonical(te.ty, out);
}

fn render_texpr_node(te: *const Texpr, out: *StringBuilder) {
    match te.e {
        TexprNode::TIntLit(n) => {
            out.push_str("(int ");
            out.push_int(n);
            out.push_str(")");
        }
        | TexprNode::TFloatLit(_f, w) => {
            // `%h` hex-float deferred (no prelude primitive yet).
            out.push_str("(float ?? ");
            out.push_str(float_width_tag(w));
            out.push_str(")");
        }
        | TexprNode::TBoolLit(b) => {
            out.push_str("(bool ");
            if b { out.push_str("true"); } else { out.push_str("false"); }
            out.push_str(")");
        }
        | TexprNode::TNullLit => { out.push_str("null"); }
        | TexprNode::TStringLit(s) => {
            out.push_str("(string ");
            escape_string(s, out);
            out.push_str(")");
        }
        | TexprNode::TVar(n) => {
            out.push_str("(var ");
            out.push_str(n);
            out.push_str(")");
        }
        | TexprNode::TFnRef(n) => {
            out.push_str("(fn-ref ");
            out.push_str(n);
            out.push_str(")");
        }
        | TexprNode::TNeg(sub) => {
            out.push_str("(neg ");
            render_texpr(sub, out);
            out.push_str(")");
        }
        | TexprNode::TBitNot(sub) => {
            out.push_str("(bit-not ");
            render_texpr(sub, out);
            out.push_str(")");
        }
        | TexprNode::TNot(sub) => {
            out.push_str("(not ");
            render_texpr(sub, out);
            out.push_str(")");
        }
        | TexprNode::TBinOp(op, l, r) => {
            out.push_str("(binop ");
            out.push_str(binop_name(op));
            out.push_str(" ");
            render_texpr(l, out);
            out.push_str(" ");
            render_texpr(r, out);
            out.push_str(")");
        }
        | TexprNode::TCall { mangled, args } => {
            out.push_str("(call ");
            out.push_str(mangled);
            render_targs_tail(&args, out);
            out.push_str(")");
        }
        | TexprNode::TBuiltinCall { name, args } => {
            out.push_str("(builtin-call ");
            out.push_str(name);
            render_targs_tail(&args, out);
            out.push_str(")");
        }
        | TexprNode::TIndirectCall { fn_expr, args } => {
            out.push_str("(indirect-call ");
            render_texpr(fn_expr, out);
            render_targs_tail(&args, out);
            out.push_str(")");
        }
        | TexprNode::TCast(sub, ann) => {
            out.push_str("(cast ");
            render_texpr(sub, out);
            out.push_str(" ");
            render_type_ann(ann, out);
            out.push_str(")");
        }
        | TexprNode::TTupleLit(es) => {
            out.push_str("(tuple-lit ");
            render_texpr_list(&es, out);
            out.push_str(")");
        }
        | TexprNode::TStructLit { sname_path, fields, base } => {
            out.push_str("(struct-lit ");
            render_path(&sname_path, out);
            out.push_str(" ");
            render_texprfield_list(&fields, out);
            render_tbase(base, out);
            out.push_str(")");
        }
        | TexprNode::TFieldAccess { target, field } => {
            out.push_str("(field-access ");
            render_texpr(target, out);
            out.push_str(" ");
            out.push_str(field);
            out.push_str(")");
        }
        | TexprNode::TRef(sub) => {
            out.push_str("(ref ");
            render_texpr(sub, out);
            out.push_str(")");
        }
        | TexprNode::TDeref(sub) => {
            out.push_str("(deref ");
            render_texpr(sub, out);
            out.push_str(")");
        }
        | TexprNode::TNew { sname_path, fields, base } => {
            out.push_str("(new ");
            render_path(&sname_path, out);
            out.push_str(" ");
            render_texprfield_list(&fields, out);
            render_tbase(base, out);
            out.push_str(")");
        }
        | TexprNode::TEnumLit { ename_path, variant, tag, args } => {
            render_variant_head("(enum-lit ", &ename_path, variant, tag, out);
            render_tfields_tail(&args, out);
            out.push_str(")");
        }
        | TexprNode::TNewEnum { ename_path, variant, tag, args } => {
            render_variant_head("(new-enum ", &ename_path, variant, tag, out);
            render_tfields_tail(&args, out);
            out.push_str(")");
        }
        | TexprNode::TMatch { scrutinee, ename_path, arms } => {
            out.push_str("(match ");
            render_texpr(scrutinee, out);
            out.push_str(" :enum ");
            render_path(&ename_path, out);
            out.push_str(" ");
            render_tarm_list(&arms, out);
            out.push_str(")");
        }
        | TexprNode::TArrayLit(es) => {
            out.push_str("(array-lit ");
            render_texpr_list(&es, out);
            out.push_str(")");
        }
        | TexprNode::TArrayRepeat { value, count } => {
            out.push_str("(array-repeat ");
            render_texpr(value, out);
            out.push_str(" ");
            out.push_int(count);
            out.push_str(")");
        }
        | TexprNode::TIndex { base, index } => {
            out.push_str("(index ");
            render_texpr(base, out);
            out.push_str(" ");
            render_texpr(index, out);
            out.push_str(")");
        }
        | TexprNode::TIfExpr { cond, then_val, else_val } => {
            out.push_str("(if-expr ");
            render_texpr(cond, out);
            out.push_str(" ");
            render_texpr(then_val, out);
            out.push_str(" ");
            render_texpr(else_val, out);
            out.push_str(")");
        }
        | TexprNode::TSizeOf(t) => {
            out.push_str("(size-of ");
            render_typ_canonical(t, out);
            out.push_str(")");
        }
        | TexprNode::TBlock { stmts, trailing } => {
            out.push_str("(block (stmts ");
            render_tstmt_list(&stmts, out);
            out.push_str(")");
            render_ttrailing(trailing, out);
            out.push_str(")");
        }
    }
}

// ===== Typed statements =====

fn render_tstmt_list(xs: *const Vec<Tstmt>, out: *StringBuilder) {
    let n = xs.length();
    let sl = xs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        render_tstmt(&sl[i], out);
        i = i + 1 as u32;
    }
}

// `(while ...)` optional ` (post <stmts>)` tail.
fn render_tpost(post: *const Vec<Tstmt>, out: *StringBuilder) {
    if post.length() > 0 as u32 {
        out.push_str(" (post ");
        render_tstmt_list(post, out);
        out.push_str(")");
    }
}

fn render_treturn(value: Option<*const Texpr>, out: *StringBuilder) {
    match value {
        Option::Some(v) => {
            out.push_str("(return ");
            render_texpr(v, out);
            out.push_str(")");
        }
        | Option::None => { out.push_str("(return)"); }
    }
}

fn render_tstmt(s: *const Tstmt, out: *StringBuilder) {
    match *s {
        Tstmt::TLet { name, value } => {
            out.push_str("(let ");
            out.push_str(name);
            out.push_str(" ");
            render_texpr(value, out);
            out.push_str(")");
        }
        | Tstmt::TLetTuple { names, value } => {
            out.push_str("(let-tuple (");
            render_str_list(&names, out);
            out.push_str(") ");
            render_texpr(value, out);
            out.push_str(")");
        }
        | Tstmt::TAssign { path, value } => {
            out.push_str("(assign ");
            render_path(&path, out);
            out.push_str(" ");
            render_texpr(value, out);
            out.push_str(")");
        }
        | Tstmt::TAssignField { target, field, value } => {
            out.push_str("(assign-field ");
            render_texpr(target, out);
            out.push_str(" ");
            out.push_str(field);
            out.push_str(" ");
            render_texpr(value, out);
            out.push_str(")");
        }
        | Tstmt::TAssignIndex { base, index, value } => {
            out.push_str("(assign-index ");
            render_texpr(base, out);
            out.push_str(" ");
            render_texpr(index, out);
            out.push_str(" ");
            render_texpr(value, out);
            out.push_str(")");
        }
        | Tstmt::TAssignDeref { target, value } => {
            out.push_str("(assign-deref ");
            render_texpr(target, out);
            out.push_str(" ");
            render_texpr(value, out);
            out.push_str(")");
        }
        | Tstmt::TReturn { value } => { render_treturn(value, out); }
        | Tstmt::TExprStmt(e) => {
            out.push_str("(expr-stmt ");
            render_texpr(e, out);
            out.push_str(")");
        }
        | Tstmt::TIf { cond, then_body, else_body } => {
            out.push_str("(if ");
            render_texpr(cond, out);
            out.push_str(" (then ");
            render_tstmt_list(&then_body, out);
            out.push_str(") (else ");
            render_tstmt_list(&else_body, out);
            out.push_str("))");
        }
        | Tstmt::TWhile { cond, body, post } => {
            out.push_str("(while ");
            render_texpr(cond, out);
            out.push_str(" (body ");
            render_tstmt_list(&body, out);
            out.push_str(")");
            render_tpost(&post, out);
            out.push_str(")");
        }
        | Tstmt::TFor { pos } => { out.push_str("(t-for-transient!)"); }
        | Tstmt::TForEach { pos } => { out.push_str("(t-for-each-transient!)"); }
        | Tstmt::TDefer { body } => {
            out.push_str("(defer ");
            render_tstmt_list(&body, out);
            out.push_str(")");
        }
        | Tstmt::TBreak(_) => { out.push_str("(break)"); }
        | Tstmt::TContinue(_) => { out.push_str("(continue)"); }
    }
}

// ===== Functions =====

// `(param[ mut] <name> <type>)` per parameter, zipping the user-side
// param trivia with the scope-resolved param types.
fn render_tfunc_params(tf: *const Tfunc, out: *StringBuilder) {
    let n = tf.tf_func.params.length();
    let ps = tf.tf_func.params.as_slice();
    let ts = tf.tf_param_tys.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { out.push_str(" "); }
        out.push_str("(param");
        if ps[i].is_mut { out.push_str(" mut"); }
        out.push_str(" ");
        out.push_str(ps[i].pname);
        out.push_str(" ");
        render_typ_canonical(ts[i], out);
        out.push_str(")");
        i = i + 1 as u32;
    }
}

fn render_tfunc(tf: *const Tfunc, out: *StringBuilder) {
    out.push_str("(tfn ");
    out.push_str(tf.tf_mangled);
    if tf.tf_func.is_extern { out.push_str(" extern"); }
    if tf.tf_func.is_pub { out.push_str(" pub"); }
    if tf.tf_func.is_variadic { out.push_str(" variadic"); }
    out.push_str(" (params ");
    render_tfunc_params(tf, out);
    out.push_str(") ");
    render_typ_canon_ret(tf.tf_ret_ty, out);
    if !tf.tf_func.is_extern {
        out.push_str(" (body ");
        render_tstmt_list(&tf.tf_body, out);
        out.push_str(")");
    }
    out.push_str(")");
}

// ===== Mono-instances section =====
//
// Vec has no in-place sort, so the struct / enum names are emitted in
// ascending order by a read-only "find the smallest name strictly
// greater than the last one emitted" scan — which sorts AND deduplicates
// without mutating the index (mirrors OCaml `List.sort_uniq`).  Names are
// compared by path (`str::cmp` segment by segment), equivalent to
// comparing the `::`-joined strings for real identifier paths.

fn path_cmp(a: *const Vec<str>, b: *const Vec<str>) -> int {
    let na = a.length();
    let nb = b.length();
    let sa = a.as_slice();
    let sb = b.as_slice();
    let mut i = 0 as u32;
    while i < na && i < nb {
        let c = str::cmp(sa[i], sb[i]) as int;
        if c != 0 { return c; }
        i = i + 1 as u32;
    }
    if na < nb { return -1; }
    if na > nb { return 1; }
    return 0;
}

fn emit_mono_structs(sigs: *const Vec<StructSig>, out: *StringBuilder) {
    let n = sigs.length();
    let sl = sigs.as_slice();
    let mut has_prev = false;
    let mut prev = 0 as u32;
    let mut more = true;
    while more {
        let mut has_best = false;
        let mut best = 0 as u32;
        let mut i = 0 as u32;
        while i < n {
            let mut after = true;
            if has_prev {
                if path_cmp(&sl[i].sname_path, &sl[prev].sname_path) <= 0 { after = false; }
            }
            if after {
                if !has_best { best = i; has_best = true; }
                else { if path_cmp(&sl[i].sname_path, &sl[best].sname_path) < 0 { best = i; } }
            }
            i = i + 1 as u32;
        }
        if has_best {
            out.push_str("  (struct ");
            render_path(&sl[best].sname_path, out);
            out.push_str(")\n");
            prev = best;
            has_prev = true;
        } else {
            more = false;
        }
    }
}

fn emit_mono_enums(sigs: *const Vec<EnumSig>, out: *StringBuilder) {
    let n = sigs.length();
    let sl = sigs.as_slice();
    let mut has_prev = false;
    let mut prev = 0 as u32;
    let mut more = true;
    while more {
        let mut has_best = false;
        let mut best = 0 as u32;
        let mut i = 0 as u32;
        while i < n {
            let mut after = true;
            if has_prev {
                if path_cmp(&sl[i].ename_path, &sl[prev].ename_path) <= 0 { after = false; }
            }
            if after {
                if !has_best { best = i; has_best = true; }
                else { if path_cmp(&sl[i].ename_path, &sl[best].ename_path) < 0 { best = i; } }
            }
            i = i + 1 as u32;
        }
        if has_best {
            out.push_str("  (enum ");
            render_path(&sl[best].ename_path, out);
            out.push_str(")\n");
            prev = best;
            has_prev = true;
        } else {
            more = false;
        }
    }
}

// A user (non-prelude) function — the `--user-only` filter.
fn is_user_func(tf: *const Tfunc) -> bool {
    return !str::eq(tf.tf_func.pos.file, "<prelude>");
}

// `dump_typed_ir` — the function list (each on its own line) under the
// `;; exile-typed-ir-dump v1 <file>` header, then a sorted
// `(mono-instances ...)` block.  `user_only` drops prelude functions.
// Mirrors OCaml `dump_typed_ir`.
pub fn dump_typed_ir(tp: *const Tprogram, file: str, user_only: bool,
                     out: *StringBuilder) {
    out.push_str(";; exile-typed-ir-dump v1 ");
    out.push_str(file);
    out.push_str("\n");
    let n = tp.tp_funcs.length();
    let fs = tp.tp_funcs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        let mut keep = true;
        if user_only {
            if !is_user_func(&fs[i]) { keep = false; }
        }
        if keep {
            render_tfunc(&fs[i], out);
            out.push_str("\n");
        }
        i = i + 1 as u32;
    }
    out.push_str("(mono-instances\n");
    emit_mono_structs(&tp.tp_struct_index, out);
    emit_mono_enums(&tp.tp_enum_index, out);
    out.push_str(")\n");
}
