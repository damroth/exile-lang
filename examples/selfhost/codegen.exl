// Self-host port — `lib/codegen.ml` (+ the C-rendering utilities that live in
// `lib/ir.ml`: mangle_typ / c_type_prefix / c_decl).
//
// The final pass: typed-IR (post Move / Escape / Drop) -> C89 text.  This file
// is filled in STAGE by stage, mirroring how typecheck was sub-staged:
//   (a) type rendering    — mangle_typ / c_type_prefix / c_decl  [THIS STAGE]
//   (b) aggregate typedefs — struct / enum / tuple / array decls, topo-sorted
//   (c) gen_expr           — expression -> C
//   (d) stmt / block / if  — statement -> C
//   (e) emit_match_stmt    — match -> C (the gnarliest, ~400 LOC)
//   (f) gen_function       — signature + body
//   (g) gen_program        — includes / sections / DCE / footer
//   (h) @debug printers / default_allocator / builtin emitters
//
// The differential is the emitted C compared byte-for-byte against the oracle's
// `--c-out`; a `codegen_corpus.exl` driver runs the pipeline and flushes C to
// stdout, the same playbook that drove the tc and drop layers.

use ast::*;
use ir::*;

// ===== Stage (a): type rendering =====

// `i32` / `u16` / ... — the fixed-width integer mangled name.
pub fn int_typ_name(is_signed: bool, width: IntWidth) -> str {
    if is_signed {
        return match width { IntWidth::W8 => "i8" | IntWidth::W16 => "i16" | IntWidth::W32 => "i32" };
    }
    return match width { IntWidth::W8 => "u8" | IntWidth::W16 => "u16" | IntWidth::W32 => "u32" };
}

// A named-type C symbol: top-level `name` -> `ex_name`, a module-nested path
// `["parser","Deco"]` -> `parser__Deco` (segments joined by `__`).
fn mangle_name(a: Allocator, ar: *Arena, path: *const Vec<str>, name: str) -> str {
    if path.length() == 0 as u32 {
        let mut eb = StringBuilder::with_capacity(a, 16 as u32);
        eb.push_str("ex_");
        eb.push_str(name);
        return str::from_slice(ar, eb.as_slice());
    }
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    let sl = path.as_slice();
    let mut i = 0 as u32;
    while i < path.length() { sb.push_str(sl[i]); sb.push_str("__"); i = i + 1 as u32; }
    sb.push_str(name);
    return str::from_slice(ar, sb.as_slice());
}

// Split any colon-joined path segment so `["pos::Pos"]` becomes `["pos","Pos"]`.
// The port's typed-IR stores a module type path colon-joined in the struct/enum
// index but the oracle mangles from the split form; normalising here keeps the
// C symbol (`pos__Pos`, not `pos::Pos`) byte-identical.
fn split_colons(a: Allocator, ar: *Arena, path: *const Vec<str>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let sl = path.as_slice();
    let mut i = 0 as u32;
    while i < path.length() {
        let seg = sl[i];
        let bytes = str::as_bytes(seg);
        let n = str::length(seg);
        let mut start = 0 as u32;
        let mut j = 0 as u32;
        while j < n {
            if j + 1 as u32 < n && bytes[j] == 58 as u8 && bytes[j + 1 as u32] == 58 as u8 {
                if j > start { out.push(str::from_slice(ar, bytes[start..j])); }
                j = j + 2 as u32;
                start = j;
            } else {
                j = j + 1 as u32;
            }
        }
        if n > start { out.push(str::from_slice(ar, bytes[start..n])); }
        i = i + 1 as u32;
    }
    return out;
}

// A named-type path `["a","b","Name"]` splits into the module prefix `["a","b"]`
// and the final `Name`, then mangles as `a__b__Name`.
fn mangle_named_path(a: Allocator, ar: *Arena, path0: *const Vec<str>) -> str {
    let path = split_colons(a, ar, path0);
    let n = path.length();
    if n == 0 as u32 { return "ex_"; }
    let sl = path.as_slice();
    let name = sl[n - 1 as u32];
    let mut prefix: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut i = 0 as u32;
    while i < n - 1 as u32 { prefix.push(sl[i]); i = i + 1 as u32; }
    return mangle_name(a, ar, &prefix, name);
}

// The C-identifier-safe mangle of a type (used to build emitted C symbol
// names).  Distinct from `typ_name`, which reproduces source syntax for
// diagnostics.  `TVar` / `TStructApp` / `TEnumApp` / `TAssocProj` / `TNullPtr`
// are pre-mono / never-mangled and yield a visible `<mangle?>` marker (they
// must not survive to codegen in concrete IR).
pub fn mangle_typ(a: Allocator, ar: *Arena, t: *const Typ) -> str {
    return match *t {
        Typ::TInt(k) => int_typ_name(k.is_signed, k.width)
        | Typ::TCInt { is_signed } => { if is_signed { "cint" } else { "cuint" } }
        | Typ::TCShort { is_signed } => { if is_signed { "cshort" } else { "cushort" } }
        | Typ::TCLong { is_signed } => { if is_signed { "clong" } else { "culong" } }
        | Typ::TCChar => "cchar"
        | Typ::TCSChar => "cschar"
        | Typ::TCUChar => "cuchar"
        | Typ::TCVoid => "cvoid"
        | Typ::TBool => "bool"
        | Typ::TFloat(w) => { match w { FloatWidth::F32 => "f32" | FloatWidth::F64 => "f64" } }
        | Typ::TString => "str"
        | Typ::TTuple(ts) => {
            let mut tb = StringBuilder::with_capacity(a, 32 as u32);
            tb.push_str("tup");
            tb.push_int(ts.length() as int);
            let sl = ts.as_slice();
            let mut ti = 0 as u32;
            while ti < ts.length() { tb.push_str("_"); tb.push_str(mangle_typ(a, ar, sl[ti])); ti = ti + 1 as u32; }
            str::from_slice(ar, tb.as_slice())
        }
        | Typ::TStruct(path) => mangle_named_path(a, ar, &path)
        | Typ::TEnum(path) => mangle_named_path(a, ar, &path)
        | Typ::TExtStruct(n) => n
        | Typ::TExtAlias(n) => n
        | Typ::TPtr(inner) => concat2(a, ar, "ptr_", mangle_typ(a, ar, inner))
        | Typ::TOwnPtr(inner) => concat2(a, ar, "ownptr_", mangle_typ(a, ar, inner))
        | Typ::TConstPtr(inner) => concat2(a, ar, "cptr_", mangle_typ(a, ar, inner))
        | Typ::TArray { elem, size } => {
            let mut arb = StringBuilder::with_capacity(a, 24 as u32);
            arb.push_str("arr");
            arb.push_int(size);
            arb.push_str("_");
            arb.push_str(mangle_typ(a, ar, elem));
            str::from_slice(ar, arb.as_slice())
        }
        | Typ::TFnPtr { params, ret } => {
            let mut fb = StringBuilder::with_capacity(a, 32 as u32);
            fb.push_str("fn");
            fb.push_int(params.length() as int);
            fb.push_str("_");
            let psl = params.as_slice();
            let mut fi = 0 as u32;
            while fi < params.length() { if fi > 0 as u32 { fb.push_str("_"); } fb.push_str(mangle_typ(a, ar, psl[fi])); fi = fi + 1 as u32; }
            fb.push_str("_to_");
            match ret { Option::Some(rt) => fb.push_str(mangle_typ(a, ar, rt)) | Option::None => fb.push_str("void") }
            str::from_slice(ar, fb.as_slice())
        }
        | _other => "<mangle?>"
    };
}

// `ex_tupN_...` — the C struct name of a tuple shape.
pub fn tuple_struct_name(a: Allocator, ar: *Arena, ts: *const Vec<*const Typ>) -> str {
    let tt = ty_node(ar, Typ::TTuple(copy_typs(a, ts)));
    return concat2(a, ar, "ex_", mangle_typ(a, ar, tt));
}

fn concat2(a: Allocator, ar: *Arena, x: str, y: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(x);
    sb.push_str(y);
    return str::from_slice(ar, sb.as_slice());
}

fn copy_typs(a: Allocator, src: *const Vec<*const Typ>) -> Vec<*const Typ> {
    let mut out: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < src.length() { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}

fn ty_node(ar: *Arena, node: Typ) -> *const Typ {
    let n: *Typ = ar.alloc_borrowed();
    *n = node;
    return n as *const Typ;
}

// Drop a single trailing space so `c_decl prefix name` reads `<base> *name`.
fn strip_trailing_space(ar: *Arena, s: str) -> str {
    let n = str::length(s);
    if n > 0 as u32 {
        let bytes = str::as_bytes(s);
        if bytes[n - 1 as u32] == 32 as u8 {
            return str::from_slice(ar, bytes[0 as u32..n - 1 as u32]);
        }
    }
    return s;
}

fn str_starts_with_const(s: str) -> bool {
    let n = str::length(s);
    if n < 6 as u32 { return false; }
    let b = str::as_bytes(s);
    // "const "
    return b[0 as u32] == 99 as u8 && b[1 as u32] == 111 as u8 && b[2 as u32] == 110 as u8
        && b[3 as u32] == 115 as u8 && b[4 as u32] == 116 as u8 && b[5 as u32] == 32 as u8;
}

// The C declaration prefix for a type — width-variable c_* map to the target's
// native int/short/long; fixed i32/u32 map to `long` for cross-compiler width
// stability (C89 only guarantees int>=16, long>=32).  Own/const pointers erase
// per DR-030 (ownership lives in the checker, not the C type).
pub fn c_type_prefix(a: Allocator, ar: *Arena, t: *const Typ) -> str {
    return match *t {
        Typ::TCInt { is_signed } => { if is_signed { "int " } else { "unsigned int " } }
        | Typ::TCShort { is_signed } => { if is_signed { "short " } else { "unsigned short " } }
        | Typ::TCLong { is_signed } => { if is_signed { "long " } else { "unsigned long " } }
        | Typ::TCChar => "char "
        | Typ::TCSChar => "signed char "
        | Typ::TCUChar => "unsigned char "
        | Typ::TCVoid => "<cvoid?> "
        | Typ::TInt(k) => {
            let s = if k.is_signed { "" } else { "unsigned " };
            let core = match k.width { IntWidth::W8 => "char" | IntWidth::W16 => "short" | IntWidth::W32 => "long" };
            let signed_core = if k.is_signed { match k.width { IntWidth::W8 => "signed char " | _o => concat2(a, ar, core, " ") } } else { concat2(a, ar, core, " ") };
            concat2(a, ar, s, signed_core)
        }
        | Typ::TBool => "int "
        | Typ::TFloat(w) => { match w { FloatWidth::F32 => "float " | FloatWidth::F64 => "double " } }
        | Typ::TString => "const char *"
        | Typ::TTuple(ts) => concat3(a, ar, "struct ", tuple_struct_name(a, ar, &ts), " ")
        | Typ::TStruct(_p) => concat3(a, ar, "struct ", mangle_typ(a, ar, t), " ")
        | Typ::TEnum(_p) => concat3(a, ar, "struct ", mangle_typ(a, ar, t), " ")
        | Typ::TExtStruct(n) => concat3(a, ar, "struct ", n, " ")
        | Typ::TExtAlias(n) => concat2(a, ar, n, " ")
        | Typ::TArray { elem: _e, size: _s } => concat3(a, ar, "struct ex_", mangle_typ(a, ar, t), " ")
        | Typ::TPtr(inner) => c_ptr_prefix(a, ar, inner, false)
        | Typ::TOwnPtr(inner) => c_ptr_prefix(a, ar, inner, false)
        | Typ::TConstPtr(inner) => c_ptr_prefix(a, ar, inner, true)
        | Typ::TFnPtr { params: _p, ret: _r } => concat2(a, ar, mangle_typ(a, ar, t), " ")
        | _other => "<ctype?> "
    };
}

// Shared pointer rendering.  `*c_void` -> `void *` (or `const void *`);
// otherwise `<base> *`, with a single `const ` for const pointers (skipped
// when the base already renders const, e.g. `str` = `const char *`).
fn c_ptr_prefix(a: Allocator, ar: *Arena, inner: *const Typ, is_const: bool) -> str {
    let is_void = match *inner { Typ::TCVoid => true | _o => false };
    if is_void {
        if is_const { return "const void *"; }
        return "void *";
    }
    let inner_c = strip_trailing_space(ar, c_type_prefix(a, ar, inner));
    if is_const {
        if str_starts_with_const(inner_c) { return concat2(a, ar, inner_c, " *"); }
        return concat3(a, ar, "const ", inner_c, " *");
    }
    return concat2(a, ar, inner_c, " *");
}

fn concat3(a: Allocator, ar: *Arena, x: str, y: str, z: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(x);
    sb.push_str(y);
    sb.push_str(z);
    return str::from_slice(ar, sb.as_slice());
}

// `c_decl t name` = the full declarator, `<prefix>name`.
pub fn c_decl(a: Allocator, ar: *Arena, t: *const Typ, name: str) -> str {
    return concat2(a, ar, c_type_prefix(a, ar, t), name);
}

// ===== Stage (b): aggregate typedefs (struct / enum / tuple / array) =====
//
// Every C-level typedef the program needs, topologically ordered so each
// precedes any other that embeds it BY VALUE (struct field / tuple element /
// array element).  Ordering stops at pointers and fn-ptrs (a `*T` field needs
// only a forward name, satisfied by C's incomplete-type rule).  Generic decls
// (any field carrying a TVar) are skipped — the monomorphiser emits concrete
// instances.

// No TVar anywhere in the type — the codegen concreteness filter.
fn is_concrete(t: *const Typ) -> bool {
    return match *t {
        Typ::TVar(_n) => false
        | Typ::TPtr(i) => is_concrete(i)
        | Typ::TOwnPtr(i) => is_concrete(i)
        | Typ::TConstPtr(i) => is_concrete(i)
        | Typ::TTuple(ts) => all_concrete(&ts)
        | Typ::TArray { elem, size } => is_concrete(elem)
        | Typ::TFnPtr { params, ret } => all_concrete(&params) && match ret { Option::Some(rt) => is_concrete(rt) | Option::None => true }
        | Typ::TStructApp { path, args } => all_concrete(&args)
        | Typ::TEnumApp { path, args } => all_concrete(&args)
        | Typ::TAssocProj { head, assoc } => is_concrete(head)
        | _other => true
    };
}
fn all_concrete(ts: *const Vec<*const Typ>) -> bool {
    let sl = ts.as_slice();
    let mut i = 0 as u32;
    while i < ts.length() { if !is_concrete(sl[i]) { return false; } i = i + 1 as u32; }
    return true;
}
fn fields_concrete(fs: *const Vec<FieldTy>) -> bool {
    let sl = fs.as_slice();
    let mut i = 0 as u32;
    while i < fs.length() { if !is_concrete(sl[i].ty) { return false; } i = i + 1 as u32; }
    return true;
}

// `struct <cname> { <c_decl>; <c_decl>; };` on one line.
fn emit_struct_decl(a: Allocator, ar: *Arena, out: *StringBuilder, cname: str, fields: *const Vec<FieldTy>) {
    out.push_str("struct ");
    out.push_str(cname);
    out.push_str(" {");
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < fields.length() {
        out.push_str(" ");
        out.push_str(c_decl(a, ar, sl[i].ty, sl[i].name));
        out.push_str(";");
        i = i + 1 as u32;
    }
    out.push_str(" };\n");
}

fn emit_named_struct(a: Allocator, ar: *Arena, out: *StringBuilder, s: *const StructSig) {
    let cname = mangle_typ(a, ar, ty_node(ar, Typ::TStruct(copy_strs_cg(a, &s.sname_path))));
    emit_struct_decl(a, ar, out, cname, &s.sfields_ty);
}

// Tuple wrapper `struct ex_tupN_... { T _0; T _1; };`.
fn emit_tuple_struct(a: Allocator, ar: *Arena, out: *StringBuilder, ty: *const Typ) {
    match *ty {
        Typ::TTuple(ts) => {
            let mut fields: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
            let sl = ts.as_slice();
            let mut i = 0 as u32;
            while i < ts.length() {
                let mut nb = StringBuilder::with_capacity(a, 8 as u32);
                nb.push_str("_");
                nb.push_int(i as int);
                fields.push(FieldTy { name: str::from_slice(ar, nb.as_slice()), ty: sl[i] });
                i = i + 1 as u32;
            }
            emit_struct_decl(a, ar, out, tuple_struct_name(a, ar, &ts), &fields);
        }
        | _o => {}
    }
}

// Array wrapper `struct ex_arrN_T { T data[N]; };`.
fn emit_array_struct(a: Allocator, ar: *Arena, out: *StringBuilder, ty: *const Typ) {
    match *ty {
        Typ::TArray { elem, size } => {
            out.push_str("struct ex_");
            out.push_str(mangle_typ(a, ar, ty));
            out.push_str(" { ");
            out.push_str(c_decl(a, ar, elem, "data"));
            out.push_str("[");
            out.push_int(size);
            out.push_str("]; };\n");
        }
        | _o => {}
    }
}

// Tag enum + wrapper struct; a `union data` of per-variant inner structs when
// any variant carries payload (unit variants stay out of the union — C89
// forbids empty structs).
fn emit_named_enum(a: Allocator, ar: *Arena, out: *StringBuilder, e: *const EnumSig) {
    let cname = mangle_typ(a, ar, ty_node(ar, Typ::TEnum(copy_strs_cg(a, &e.ename_path))));
    out.push_str("enum ");
    out.push_str(cname);
    out.push_str("_tag {");
    let vs = e.evariants.as_slice();
    let mut i = 0 as u32;
    while i < e.evariants.length() {
        if i > 0 as u32 { out.push_str(","); }
        out.push_str(" ");
        out.push_str(cname);
        out.push_str("_");
        out.push_str(vs[i].vsname);
        i = i + 1 as u32;
    }
    out.push_str(" };\n");
    out.push_str("struct ");
    out.push_str(cname);
    out.push_str(" { enum ");
    out.push_str(cname);
    out.push_str("_tag tag;");
    let mut has_payload = false;
    let mut j = 0 as u32;
    while j < e.evariants.length() { if vs[j].vsfields.length() > 0 as u32 { has_payload = true; } j = j + 1 as u32; }
    if has_payload {
        out.push_str(" union {");
        let mut k = 0 as u32;
        while k < e.evariants.length() {
            if vs[k].vsfields.length() > 0 as u32 {
                out.push_str(" struct {");
                let fsl = vs[k].vsfields.as_slice();
                let mut f = 0 as u32;
                while f < vs[k].vsfields.length() {
                    out.push_str(" ");
                    out.push_str(c_decl(a, ar, fsl[f].ty, fsl[f].name));
                    out.push_str(";");
                    f = f + 1 as u32;
                }
                out.push_str(" } ");
                out.push_str(vs[k].vsname);
                out.push_str(";");
            }
            k = k + 1 as u32;
        }
        out.push_str(" } data;");
    }
    out.push_str(" };\n");
}

fn copy_strs_cg(a: Allocator, src: *const Vec<str>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < src.length() { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}

// The unified aggregate view for topo-ordered emission.  Structs / enums are
// referenced by pointer into the program's indices (avoids copying their
// owned Vec fields); tuples / arrays carry their mangled name + shape.
enum Agg {
    AStruct(*const StructSig)
    | AEnum(*const EnumSig)
    | ATuple { aname: str, aty: *const Typ }
    | AArray { aname: str, aty: *const Typ }
}

fn agg_cname(a: Allocator, ar: *Arena, agg: *const Agg) -> str {
    return match *agg {
        Agg::AStruct(s) => mangle_typ(a, ar, ty_node(ar, Typ::TStruct(copy_strs_cg(a, &s.sname_path))))
        | Agg::AEnum(e) => mangle_typ(a, ar, ty_node(ar, Typ::TEnum(copy_strs_cg(a, &e.ename_path))))
        | Agg::ATuple { aname, aty } => concat2(a, ar, "ex_", mangle_typ(a, ar, aty))
        | Agg::AArray { aname, aty } => concat2(a, ar, "ex_", mangle_typ(a, ar, aty))
    };
}

// C struct names this type embeds BY VALUE (stops at pointers / fn-ptrs).
fn value_agg_keys(a: Allocator, ar: *Arena, t: *const Typ, out: *Vec<str>) {
    match *t {
        Typ::TStruct(_p) => out.push(mangle_typ(a, ar, t))
        | Typ::TEnum(_p) => out.push(mangle_typ(a, ar, t))
        | Typ::TTuple(ts) => {
            out.push(concat2(a, ar, "ex_", mangle_typ(a, ar, t)));
            let sl = ts.as_slice();
            let mut i = 0 as u32;
            while i < ts.length() { value_agg_keys(a, ar, sl[i], out); i = i + 1 as u32; }
        }
        | Typ::TArray { elem, size } => {
            out.push(concat2(a, ar, "ex_", mangle_typ(a, ar, t)));
            value_agg_keys(a, ar, elem, out);
        }
        | _o => {}
    }
}

fn agg_deps(a: Allocator, ar: *Arena, agg: *const Agg) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    match *agg {
        Agg::AStruct(s) => {
            let ssl = s.sfields_ty.as_slice();
            let mut si = 0 as u32;
            while si < s.sfields_ty.length() { value_agg_keys(a, ar, ssl[si].ty, &out); si = si + 1 as u32; }
        }
        | Agg::AEnum(e) => {
            let vs = e.evariants.as_slice();
            let mut ei = 0 as u32;
            while ei < e.evariants.length() {
                let fsl = vs[ei].vsfields.as_slice();
                let mut f = 0 as u32;
                while f < vs[ei].vsfields.length() { value_agg_keys(a, ar, fsl[f].ty, &out); f = f + 1 as u32; }
                ei = ei + 1 as u32;
            }
        }
        | Agg::ATuple { aname, aty } => {
            match *aty { Typ::TTuple(ts) => { let tsl = ts.as_slice(); let mut ti = 0 as u32; while ti < ts.length() { value_agg_keys(a, ar, tsl[ti], &out); ti = ti + 1 as u32; } } | _o => {} }
        }
        | Agg::AArray { aname, aty } => {
            match *aty { Typ::TArray { elem, size } => value_agg_keys(a, ar, elem, &out) | _o => {} }
        }
    }
    return out;
}

fn emit_agg(a: Allocator, ar: *Arena, out: *StringBuilder, agg: *const Agg) {
    match *agg {
        Agg::AStruct(s) => emit_named_struct(a, ar, out, s)
        | Agg::AEnum(e) => emit_named_enum(a, ar, out, e)
        | Agg::ATuple { aname, aty } => emit_tuple_struct(a, ar, out, aty)
        | Agg::AArray { aname, aty } => emit_array_struct(a, ar, out, aty)
    }
}

fn agg_index_by_key(a: Allocator, ar: *Arena, aggs: *const Vec<Agg>, key: str) -> int {
    let sl = aggs.as_slice();
    let mut i = 0 as u32;
    while i < aggs.length() { if str::eq(agg_cname(a, ar, &sl[i]), key) { return i as int; } i = i + 1 as u32; }
    return 0 - 1;
}

// DFS on the input list in source order, recursing into each entry's value
// deps first (post-order emit); `done` dedups.  Deps not in the list are
// primitives / externs / fn-ptrs and skip.
fn visit_agg(a: Allocator, ar: *Arena, out: *StringBuilder, aggs: *const Vec<Agg>, idx: u32, done: *Vec<str>) {
    let sl = aggs.as_slice();
    let key = agg_cname(a, ar, &sl[idx]);
    if str_in_cg(done, key) { return; }
    done.push(key);
    let deps = agg_deps(a, ar, &sl[idx]);
    let dsl = deps.as_slice();
    let mut i = 0 as u32;
    while i < deps.length() {
        let di = agg_index_by_key(a, ar, aggs, dsl[i]);
        if di >= 0 as int { visit_agg(a, ar, out, aggs, di as u32, done); }
        i = i + 1 as u32;
    }
    emit_agg(a, ar, out, &sl[idx]);
}

fn str_in_cg(v: *const Vec<str>, s: str) -> bool {
    let sl = v.as_slice();
    let mut i = 0 as u32;
    while i < v.length() { if str::eq(sl[i], s) { return true; } i = i + 1 as u32; }
    return false;
}

fn emit_aggs_topo(a: Allocator, ar: *Arena, out: *StringBuilder, aggs: *const Vec<Agg>) {
    let mut done: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut i = 0 as u32;
    while i < aggs.length() { visit_agg(a, ar, out, aggs, i, &done); i = i + 1 as u32; }
}

// fn-ptr typedef: `typedef <r>(*<name>)(<ps>);`.
fn emit_fnptr_typedef(a: Allocator, ar: *Arena, out: *StringBuilder, name: str, t: *const Typ) {
    match *t {
        Typ::TFnPtr { params, ret } => {
            out.push_str("typedef ");
            match ret { Option::Some(rt) => out.push_str(c_type_prefix(a, ar, rt)) | Option::None => out.push_str("void ") }
            out.push_str("(*");
            out.push_str(name);
            out.push_str(")(");
            if params.length() == 0 as u32 {
                out.push_str("void");
            } else {
                let sl = params.as_slice();
                let mut i = 0 as u32;
                while i < params.length() {
                    if i > 0 as u32 { out.push_str(", "); }
                    out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, sl[i])));
                    i = i + 1 as u32;
                }
            }
            out.push_str(");\n");
        }
        | _o => {}
    }
}

// Stage-(b) entry: the fn-ptr typedefs + topo-ordered aggregate typedefs.  The
// concreteness filter drops generic skeletons; struct / enum indices seed the
// aggregate list in source order (tuples then arrays after).
pub fn emit_type_decls(a: Allocator, ar: *Arena, tp: *const Tprogram, out: *StringBuilder) {
    let fpt = tp.tp_fnptr_types.as_slice();
    let mut i = 0 as u32;
    while i < tp.tp_fnptr_types.length() { emit_fnptr_typedef(a, ar, out, fpt[i].name, fpt[i].ty); i = i + 1 as u32; }

    let mut aggs: Vec<Agg> = Vec::with_capacity(a, 8 as u32);
    let ssl = tp.tp_struct_index.as_slice();
    let mut si = 0 as u32;
    while si < tp.tp_struct_index.length() {
        if fields_concrete(&ssl[si].sfields_ty) { aggs.push(Agg::AStruct(&ssl[si])); }
        si = si + 1 as u32;
    }
    let esl = tp.tp_enum_index.as_slice();
    let mut ei = 0 as u32;
    while ei < tp.tp_enum_index.length() {
        if enum_concrete(&esl[ei]) { aggs.push(Agg::AEnum(&esl[ei])); }
        ei = ei + 1 as u32;
    }
    let tsl = tp.tp_tuple_types.as_slice();
    let mut ti = 0 as u32;
    while ti < tp.tp_tuple_types.length() { aggs.push(Agg::ATuple { aname: tsl[ti].name, aty: tsl[ti].ty }); ti = ti + 1 as u32; }
    let asl = tp.tp_array_types.as_slice();
    let mut ai = 0 as u32;
    while ai < tp.tp_array_types.length() { aggs.push(Agg::AArray { aname: asl[ai].name, aty: asl[ai].ty }); ai = ai + 1 as u32; }

    emit_aggs_topo(a, ar, out, &aggs);
}

fn enum_concrete(e: *const EnumSig) -> bool {
    let vs = e.evariants.as_slice();
    let mut i = 0 as u32;
    while i < e.evariants.length() { if !fields_concrete(&vs[i].vsfields) { return false; } i = i + 1 as u32; }
    return true;
}

// ===== Stage (c): gen_expr — expression -> C =====
//
// Block-shaped expressions (tuple/struct/new/enum-lit/match/if-expr/array
// lit/repeat/block) never reach here: the typecheck lift pass hoisted them to
// `__lift_N` temps.  TBuiltinCall dispatches to the builtin emitters (stage h);
// TFloatLit's decimal-round-trip value format is deferred (same as the typed-IR
// dump) — the self-host source is integer-only so no literal reaches codegen.

fn prec(op: BinOp) -> int {
    return match op {
        BinOp::Mul => 10 | BinOp::Div => 10 | BinOp::Mod => 10
        | BinOp::Add => 9 | BinOp::Sub => 9
        | BinOp::Shl => 8 | BinOp::Shr => 8
        | BinOp::Lt => 7 | BinOp::Gt => 7 | BinOp::LtEq => 7 | BinOp::GtEq => 7
        | BinOp::EqEq => 6 | BinOp::NotEq => 6
        | BinOp::BitAnd => 5
        | BinOp::BitXor => 4
        | BinOp::BitOr => 3
        | BinOp::And => 2
        | BinOp::Or => 1
        | BinOp::Concat => 0
    };
}

fn binop_str(op: BinOp) -> str {
    return match op {
        BinOp::Add => " + " | BinOp::Sub => " - " | BinOp::Mul => " * "
        | BinOp::Div => " / " | BinOp::Mod => " % "
        | BinOp::BitAnd => " & " | BinOp::BitOr => " | " | BinOp::BitXor => " ^ "
        | BinOp::Shl => " << " | BinOp::Shr => " >> "
        | BinOp::And => " && " | BinOp::Or => " || "
        | BinOp::Lt => " < " | BinOp::Gt => " > "
        | BinOp::LtEq => " <= " | BinOp::GtEq => " >= "
        | BinOp::EqEq => " == " | BinOp::NotEq => " != "
        | BinOp::Concat => " ?concat? "
    };
}

// `a - (b - c)` / `/` / `%` / `<<` / `>>` change meaning without parens on a
// same-precedence right operand; commutative ops are exempt.
fn is_left_assoc(op: BinOp) -> bool {
    return match op {
        BinOp::Sub => true | BinOp::Div => true | BinOp::Mod => true
        | BinOp::Shl => true | BinOp::Shr => true | _o => false
    };
}

// `-Wparentheses` fires (Wall) on `&&` under `||` and on `+`/`-` under a
// bitwise op even where C precedence is unambiguous — paren those children.
fn nest_warn(op: BinOp, child: BinOp) -> bool {
    let child_and = match child { BinOp::And => true | _o => false };
    let child_addsub = match child { BinOp::Add => true | BinOp::Sub => true | _o => false };
    return match op {
        BinOp::Or => child_and
        | BinOp::BitAnd => child_addsub
        | BinOp::BitOr => child_addsub
        | BinOp::BitXor => child_addsub
        | _o => false
    };
}

fn lvalue_like(n: *const TexprNode) -> bool {
    return match *n { TexprNode::TVar(_x) => true | TexprNode::TFieldAccess { target, field } => true | TexprNode::TDeref(_s) => true | _o => false };
}

fn is_slice_path(path: *const Vec<str>) -> bool {
    let n = path.length();
    if n == 0 as u32 { return false; }
    let last = path.as_slice()[n - 1 as u32];
    return str::eq(last, "Slice") || str_starts_with_pfx(last, "Slice_");
}
fn is_vec_path(path: *const Vec<str>) -> bool {
    let n = path.length();
    if n == 0 as u32 { return false; }
    let last = path.as_slice()[n - 1 as u32];
    return str::eq(last, "Vec") || str_starts_with_pfx(last, "Vec_");
}
fn str_starts_with_pfx(s: str, pfx: str) -> bool {
    let pn = str::length(pfx);
    if str::length(s) < pn { return false; }
    let sb = str::as_bytes(s);
    let pb = str::as_bytes(pfx);
    let mut i = 0 as u32;
    while i < pn { if sb[i] != pb[i] { return false; } i = i + 1 as u32; }
    return true;
}

fn escape_c_into(out: *StringBuilder, s: str) {
    let b = str::as_bytes(s);
    let n = str::length(s);
    let mut i = 0 as u32;
    while i < n {
        let c = b[i];
        if c == 10 as u8 { out.push_str("\\n"); }
        else if c == 13 as u8 { out.push_str("\\r"); }
        else if c == 9 as u8 { out.push_str("\\t"); }
        else if c == 8 as u8 { out.push_str("\\b"); }
        else if c == 0 as u8 { out.push_str("\\0"); }
        else if c == 92 as u8 { out.push_str("\\\\"); }
        else if c == 34 as u8 { out.push_str("\\\""); }
        else { out.push_byte(c); }
        i = i + 1 as u32;
    }
}

// unary prefix; the operand is parenthesised unless `simple`.
fn emit_unary(a: Allocator, ar: *Arena, out: *StringBuilder, prefix: str, simple: bool, sub: *const Texpr) {
    out.push_str(prefix);
    if simple { gen_expr(a, ar, out, sub); }
    else { out.push_str("("); gen_expr(a, ar, out, sub); out.push_str(")"); }
}

fn is_atom_cast(n: *const TexprNode) -> bool {
    return match *n {
        TexprNode::TIntLit(_x) => true | TexprNode::TFloatLit(_f, _w) => true
        | TexprNode::TBoolLit(_b) => true | TexprNode::TVar(_v) => true | _o => false
    };
}
fn is_simple_field_target(n: *const TexprNode) -> bool {
    return match *n {
        TexprNode::TVar(_x) => true | TexprNode::TFieldAccess { target, field } => true
        | TexprNode::TIndex { base, index } => true | TexprNode::TCall { mangled, args } => true
        | TexprNode::TBuiltinCall { name, args } => true | TexprNode::TIndirectCall { fn_expr, args } => true
        | _o => false
    };
}
fn is_ptr_ty(t: *const Typ) -> bool {
    return match *t { Typ::TPtr(_i) => true | Typ::TOwnPtr(_i) => true | Typ::TConstPtr(_i) => true | _o => false };
}

fn emit_args(a: Allocator, ar: *Arena, out: *StringBuilder, args: *const Vec<*const Texpr>) {
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < args.length() {
        if i > 0 as u32 { out.push_str(", "); }
        gen_expr(a, ar, out, sl[i]);
        i = i + 1 as u32;
    }
}

pub fn gen_expr(a: Allocator, ar: *Arena, out: *StringBuilder, te: *const Texpr) {
    match te.e {
        TexprNode::TIntLit(n) => out.push_int(n)
        | TexprNode::TFloatLit(f, w) => out.push_str("/*float?*/")
        | TexprNode::TBoolLit(b) => { let s = if b { "1" } else { "0" }; out.push_str(s); }
        | TexprNode::TNullLit => out.push_str("((void *)0)")
        | TexprNode::TStringLit(s) => { out.push_str("\""); escape_c_into(out, s); out.push_str("\""); }
        | TexprNode::TVar(name) => out.push_str(name)
        | TexprNode::TFnRef(name) => out.push_str(name)
        | TexprNode::TNeg(sub) => emit_unary(a, ar, out, "-", is_atom_int_var(sub.e), sub)
        | TexprNode::TBitNot(sub) => emit_unary(a, ar, out, "~", is_atom_int_var(sub.e), sub)
        | TexprNode::TNot(sub) => emit_unary(a, ar, out, "!", is_atom_bool_var(sub.e), sub)
        | TexprNode::TRef(sub) => emit_unary(a, ar, out, "&", lvalue_like(&sub.e), sub)
        | TexprNode::TDeref(sub) => emit_unary(a, ar, out, "*", lvalue_like(&sub.e), sub)
        | TexprNode::TCast(sub, ann) => {
            out.push_str("((");
            out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, te.ty)));
            out.push_str(")");
            if is_atom_cast(&sub.e) { gen_expr(a, ar, out, sub); }
            else { out.push_str("("); gen_expr(a, ar, out, sub); out.push_str(")"); }
            out.push_str(")");
        }
        | TexprNode::TBinOp(op, l, r) => {
            let p = prec(op);
            emit_binop_operand(a, ar, out, l, p, op, false);
            out.push_str(binop_str(op));
            emit_binop_operand(a, ar, out, r, p, op, true);
        }
        | TexprNode::TBuiltinCall { name, args } => { out.push_str("/*builtin:"); out.push_str(name); out.push_str("*/"); }
        | TexprNode::TCall { mangled, args } => {
            out.push_str(mangled);
            out.push_str("(");
            emit_args(a, ar, out, &args);
            out.push_str(")");
        }
        | TexprNode::TIndirectCall { fn_expr, args } => {
            out.push_str("(");
            gen_expr(a, ar, out, fn_expr);
            out.push_str(")(");
            emit_args(a, ar, out, &args);
            out.push_str(")");
        }
        | TexprNode::TIndex { base, index } => {
            let suffix = index_suffix(base.ty);
            if is_index_simple_base(base.e) { gen_expr(a, ar, out, base); }
            else { out.push_str("("); gen_expr(a, ar, out, base); out.push_str(")"); }
            out.push_str(suffix);
            gen_expr(a, ar, out, index);
            out.push_str("]");
        }
        | TexprNode::TFieldAccess { target, field } => emit_field_access(a, ar, out, target, field)
        | TexprNode::TSizeOf(t) => { out.push_str("sizeof("); out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, t))); out.push_str(")"); }
        | _other => out.push_str("/*expr?*/")
    }
}

fn is_atom_int_var(n: TexprNode) -> bool {
    return match n { TexprNode::TIntLit(_x) => true | TexprNode::TVar(_v) => true | _o => false };
}
fn is_atom_bool_var(n: TexprNode) -> bool {
    return match n { TexprNode::TBoolLit(_x) => true | TexprNode::TVar(_v) => true | _o => false };
}
fn is_index_simple_base(n: TexprNode) -> bool {
    return match n { TexprNode::TVar(_x) => true | TexprNode::TFieldAccess { target, field } => true | TexprNode::TIndex { base, index } => true | _o => false };
}

fn index_suffix(bty: *const Typ) -> str {
    return match *bty {
        Typ::TStruct(path) => { if is_slice_path(&path) || is_vec_path(&path) { ".ptr[" } else { ".data[" } }
        | Typ::TPtr(_i) => "["
        | Typ::TOwnPtr(_i) => "["
        | Typ::TConstPtr(_i) => "["
        | _o => ".data["
    };
}

// `(*p).field` -> `p->field` (C `.` binds tighter than leading `*`); a
// pointer-typed target auto-derefs via `->`, else `.`; non-postfix targets
// are parenthesised.
fn emit_field_access(a: Allocator, ar: *Arena, out: *StringBuilder, target: *const Texpr, field: str) {
    match target.e {
        TexprNode::TDeref(inner) => { gen_expr(a, ar, out, inner); out.push_str("->"); out.push_str(field); }
        | _o => {
            let sep = if is_ptr_ty(target.ty) { "->" } else { "." };
            if is_simple_field_target(&target.e) { gen_expr(a, ar, out, target); }
            else { out.push_str("("); gen_expr(a, ar, out, target); out.push_str(")"); }
            out.push_str(sep);
            out.push_str(field);
        }
    }
}

fn binop_operand_parens(operand: *const Texpr, p: int, op: BinOp, is_right: bool) -> bool {
    return match operand.e {
        TexprNode::TBinOp(cop, cl, cr) => {
            let cp = prec(cop);
            cp < p || (is_right && cp == p && is_left_assoc(op)) || nest_warn(op, cop)
        }
        | _o => false
    };
}
fn emit_binop_operand(a: Allocator, ar: *Arena, out: *StringBuilder, operand: *const Texpr, p: int, op: BinOp, is_right: bool) {
    if binop_operand_parens(operand, p, op, is_right) { out.push_str("("); gen_expr(a, ar, out, operand); out.push_str(")"); }
    else { gen_expr(a, ar, out, operand); }
}
