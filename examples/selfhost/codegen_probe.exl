// Stage-(a) verification probe: render representative types via mangle_typ /
// c_type_prefix and print, to diff against the oracle's known C forms.

use ast::*;
use ir::*;
use codegen::*;

fn ty(ar: *Arena, node: Typ) -> *const Typ {
    let n: *Typ = ar.alloc_borrowed();
    *n = node;
    return n as *const Typ;
}

fn line(out: *StringBuilder, label: str, m: str, c: str) {
    out.push_str(label);
    out.push_str(" | mangle=");
    out.push_str(m);
    out.push_str(" | ctype=[");
    out.push_str(c);
    out.push_str("]\n");
}

fn emit(a: Allocator, ar: *Arena, out: *StringBuilder, label: str, t: *const Typ) {
    line(out, label, mangle_typ(a, ar, t), c_type_prefix(a, ar, t));
}

fn main() {
    let a = default_allocator();
    let mut ar = Arena::with_capacity(a, 65536 as u32);
    let mut out = StringBuilder::with_capacity(a, 4096 as u32);

    let i32t = ty(&ar, Typ::TInt(IntKind { is_signed: true, width: IntWidth::W32 }));
    let u8t = ty(&ar, Typ::TInt(IntKind { is_signed: false, width: IntWidth::W8 }));
    let i8t = ty(&ar, Typ::TInt(IntKind { is_signed: true, width: IntWidth::W8 }));
    let boolt = ty(&ar, Typ::TBool);
    let strt = ty(&ar, Typ::TString);
    let f64t = ty(&ar, Typ::TFloat(FloatWidth::F64));

    emit(a, &ar, &out, "i32", i32t);
    emit(a, &ar, &out, "u8 ", u8t);
    emit(a, &ar, &out, "i8 ", i8t);
    emit(a, &ar, &out, "bool", boolt);
    emit(a, &ar, &out, "str", strt);
    emit(a, &ar, &out, "f64", f64t);

    // *const str, own *u8, *i32
    let cptr_str = ty(&ar, Typ::TConstPtr(strt));
    let own_u8 = ty(&ar, Typ::TOwnPtr(u8t));
    let ptr_i32 = ty(&ar, Typ::TPtr(i32t));
    emit(a, &ar, &out, "*const str", cptr_str);
    emit(a, &ar, &out, "own *u8", own_u8);
    emit(a, &ar, &out, "*i32", ptr_i32);

    // struct paths: bare and module-qualified
    let mut deco_path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    deco_path.push("parser");
    deco_path.push("Deco");
    let deco = ty(&ar, Typ::TStruct(deco_path));
    let mut vec_path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    vec_path.push("Vec_str");
    let vecstr = ty(&ar, Typ::TStruct(vec_path));
    emit(a, &ar, &out, "parser::Deco", deco);
    emit(a, &ar, &out, "Vec_str", vecstr);
    emit(a, &ar, &out, "*const parser::Deco", ty(&ar, Typ::TConstPtr(deco)));

    // fn-ptr: fn(*void,*void,u32)->void  (the Allocator free_fn shape)
    let voidt = ty(&ar, Typ::TCVoid);
    let pvoid = ty(&ar, Typ::TPtr(voidt));
    let mut fparams: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    fparams.push(pvoid);
    fparams.push(pvoid);
    fparams.push(ty(&ar, Typ::TInt(IntKind { is_signed: false, width: IntWidth::W32 })));
    let none_ret: Option<*const Typ> = Option::None;
    let fnptr = ty(&ar, Typ::TFnPtr { params: fparams, ret: none_ret });
    emit(a, &ar, &out, "fn(*v,*v,u32)->void", fnptr);

    // array [i32; 4]
    let arr = ty(&ar, Typ::TArray { elem: i32t, size: 4 as int });
    emit(a, &ar, &out, "[i32;4]", arr);

    let bytes = out.as_slice();
    sys::sys_write(1 as c_int, &bytes[0] as *const c_uchar, out.length() as c_ulong);
}
