fn split(n: int) -> (int, int) {
    return (n * 2, n * 3);
}

fn min_max(a: int, b: int) -> (int, int) {
    if a < b {
        return (a, b);
    } else {
        return (b, a);
    }
}

fn label_score(score: int) -> (str, int) {
    if score >= 90 {
        return ("A", score);
    } else if score >= 70 {
        return ("B", score);
    } else {
        return ("C", score);
    }
}

fn main() {
    let (a, b) = split(5);
    println(a);
    println(b);

    let (lo, hi) = min_max(7, 3);
    println(lo);
    println(hi);

    let (grade, points) = label_score(85);
    println(grade);
    println(points);

    let (x, y) = (10, 20);
    println(x);
    println(y);
}
