struct Point {
    x: int,
    y: int,
}

fn make_point(x: int, y: int) -> *Point {
    return new Point { x: x, y: y };
}

fn shift(p: *Point, dx: int, dy: int) {
    p.x = p.x + dx;
    p.y = p.y + dy;
}

fn main() {
    let p = new Point { x: 1, y: 2 };
    defer free(p);

    p.x = 10;
    p.y = 20;
    print(p.x);
    print(p.y);

    let q = make_point(100, 200);
    defer free(q);

    shift(q, 5, 7);
    print(q.x);
    print(q.y);
}
