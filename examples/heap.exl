struct Point {
    x: int,
    y: int,
}

fn make_point(a: Allocator, x: int, y: int) -> own *Point {
    return new(a) Point { x: x, y: y };
}

fn shift(p: *Point, dx: int, dy: int) {
    p.x = p.x + dx;
    p.y = p.y + dy;
}

fn main() {
    let a = default_allocator();

    let p = new(a) Point { x: 1, y: 2 };
    defer free(p);

    p.x = 10;
    p.y = 20;
    println(p.x);
    println(p.y);

    let q = make_point(a, 100, 200);
    defer free(q);

    shift(q, 5, 7);
    println(q.x);
    println(q.y);
}
