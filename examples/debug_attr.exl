// `@debug` marks a struct or enum as Rust-Debug-style printable.  Codegen
// synthesizes a one-line printer per marked type and `print(v)` dispatches
// to it.  Zero runtime cost on types you didn't mark; opt-in keeps the
// emitted C small on tight targets like Amiga 256K.
//
// Each field must be itself debug-able — int-like, bool, str, pointer
// (rendered as address), or another `@debug` aggregate.  Opaque C types,
// fn-ptrs, and tuple fields are rejected at compile time.
//
// `@debug` works on generic struct/enum too: monomorphization gives each
// instance concrete fields, so the printer is synthesized per instance
// (`Pair<i32, bool> { ... }`).  No trait bounds needed.

@debug
struct Point { x: int, y: int }

@debug
struct Pair<A, B> { fst: A, snd: B }

@debug
struct Rect {
    origin: Point,
    width: int,
    height: int,
}

@debug
enum Shape {
    | Circle(int)
    | Rectangle { w: int, h: int }
    | None
}

fn main() {
    let p = Point { x: 3, y: 4 };
    let r = Rect { origin: p, width: 100, height: 50 };

    println(p);                                       // Point { x: 3, y: 4 }
    println(r);                                       // Rect { origin: Point { x: 3, y: 4 }, width: 100, height: 50 }

    println(Shape::Circle(7));                        // Shape::Circle(7)
    println(Shape::Rectangle { w: 80, h: 20 });       // Shape::Rectangle { w: 80, h: 20 }
    println(Shape::None);                             // Shape::None

    // Generic @debug — each instance prints with its concrete type.
    println(Pair { fst: 1, snd: true });              // Pair<i32, bool> { fst: 1, snd: true }
    println(Pair { fst: p, snd: 9 });                 // Pair<Point, i32> { fst: Point { x: 3, y: 4 }, snd: 9 }
}
