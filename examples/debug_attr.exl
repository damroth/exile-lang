// `@debug` marks a struct or enum as Rust-Debug-style printable.  Codegen
// synthesizes a one-line printer per marked type and `print(v)` dispatches
// to it.  Zero runtime cost on types you didn't mark; opt-in keeps the
// emitted C small on tight targets like Amiga 256K.
//
// MVP scope: only non-generic struct/enum.  Each field must be itself
// debug-able — int-like, bool, str, pointer (rendered as address), or
// another `@debug` aggregate.  Opaque C types and fn-ptrs are rejected
// at compile time.
//
// Generics (`@debug struct Box<T>`) are deferred until the language has
// trait bounds (`T: Debug` analogue).

@debug
struct Point { x: int, y: int }

@debug
struct Rect {
    origin: Point,
    width: int,
    height: int,
}

@debug
enum Shape {
    | Circle(int)
    | Rectangle { w: int, h: int }
    | None
}

fn main() {
    let p = Point { x: 3, y: 4 };
    let r = Rect { origin: p, width: 100, height: 50 };

    print(p);                                       // Point { x: 3, y: 4 }
    print(r);                                       // Rect { origin: Point { x: 3, y: 4 }, width: 100, height: 50 }

    print(Shape::Circle(7));                        // Shape::Circle(7)
    print(Shape::Rectangle { w: 80, h: 20 });       // Shape::Rectangle { w: 80, h: 20 }
    print(Shape::None);                             // Shape::None
}
