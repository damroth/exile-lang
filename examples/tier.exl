// `@tier(core|standard|full)` is a comfort-tier hint on a declaration.
// The compiler runs with a `--profile {core,standard,full}` setting;
// the linter classifies each fn into a tier and warns when code under
// a stricter profile reaches for a higher-tier feature (e.g. a generic
// fn instance inside a `core` build).
//
// Attaching `@tier(core)` to a decl pins it to the lowest tier — it
// stays silent under every profile.  `@tier(standard)` keeps the warn
// under `--profile core` but quiets `--profile standard`.  The default
// (no attribute) is inferred from the decl shape (generic fns default
// to `standard`, mono fns to `core`).
//
// Generated code is identical regardless of `@tier` — this is purely
// linter metadata.  Legal on fn / struct / enum decls only.

@tier(core)
fn id<T>(x: T) -> T {
    return x;
}

@tier(standard)
struct Pair<A, B> {
    fst: A,
    snd: B,
}

@tier(full)
enum Maybe<T> {
    | Just(T)
    | Nothing
}

fn main() {
    print(id(7));                                // 7
    let p = Pair { fst: 42, snd: true };
    print(p.fst);                                // 42
    if p.snd { print(1); } else { print(0); }    // 1

    let m: Maybe<int> = Maybe::Just(99);
    match m {
        | Maybe::Just(n)  => print(n)            // 99
        | Maybe::Nothing  => print(-1)
    }
}
