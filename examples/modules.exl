mod math {
    pub fn double(n: int) -> int {
        return n * 2;
    }

    fn bump(n: int) -> int {
        return n + 1;
    }

    pub fn double_then_bump(n: int) -> int {
        return bump(double(n));
    }
}

// A type declared inside a module is named module-relative from within it: the
// bare `Point` in `norm`'s signature IS `geom::Point`.  A signature resolves in
// its own module's scope, exactly like the body that declares it.
mod geom {
    pub struct Point {
        x: int,
        y: int,
    }

    pub fn norm(p: *const Point) -> int {
        return p.x * p.x + p.y * p.y;
    }
}

mod greet {
    pub fn hi(name: str) {
        println(name);
    }
}

// `pub use foo::bar;` re-exports `bar` into the enclosing scope, so
// callers can use the short name without the module qualifier.  The
// wildcard form `pub use foo::*;` re-exports every public item at once
// (file-modules only — see examples/multi_file).
pub use math::double;

fn main() {
    println(math::double(21));
    println(math::double_then_bump(10));
    println(double(15));                       // 30 — same fn, no `math::`
    let pt = geom::Point { x: 3, y: 4 };
    println(geom::norm(&pt));                  // 25 — `*Point` lent as `*const Point`
    greet::hi("hello from modules");
}
