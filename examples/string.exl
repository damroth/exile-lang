// String — owned, NUL-terminated buffer in the prelude (Faza 1
// of the OwnedStr/String design).  Sits next to `StringBuilder`:
// SB is mutable / growable, `String` is the frozen owner you
// hand around (Vec<String>, HashMap<String, ...>, etc.).
//
// Surface: `with_str`, `empty`, `build`, `length`, `as_slice`,
// `as_str`, `free`.  Every constructor writes the trailing NUL so
// `as_str()` hands back a libc-`%s`-safe pointer by construction
// (graft G1 from the design).
//
// `String` and `StringBuilder` are both `@move`: the move-pass
// rejects silent by-value copies of the buffer.  `let s2 = s;`
// followed by `s.free()` is a use-after-consume error.  Reads go
// through `*const String` (auto-ref'd by method dispatch), and
// `defer s.free()` is the idiomatic single-point cleanup.
//
// `eq` / `hash` / `clone` for String are still pending: the
// prelude `Eq` / `Hash` traits take by-value `self` (their
// signatures haven't been re-borrowed yet).  They'll land
// hand-written once the trait surfaces flip to `*const self`.

pub mod raw {
    extern fn make_c_allocator() -> Allocator;
}

fn main() {
    let a = raw::make_c_allocator();

    // `with_str(a, s)` allocates `len(s)+1` bytes through the
    // allocator seam, copies through a Slice<u8> + Delta-B, and
    // writes NUL at [len].
    let hi = String::with_str(a, "Hello, exile!");
    println(hi.length() as int);          // 13

    // `as_slice()` exposes the bytes without the NUL — read-only
    // Slice<u8>, indexable.
    let v = hi.as_slice();
    println(v[0] as int);                  // 72  ('H')
    println(v[7] as int);                  // 101 ('e' — start of "exile!")
    println(v[12] as int);                 // 33  ('!')

    // `defer hi.free()` would be idiomatic; the explicit call here
    // makes the lifetime visible in the trace.
    hi.free();

    // `empty(a)` allocates a 1-byte buffer holding just NUL —
    // avoids malloc(0) and keeps as_str() %s-safe.
    let e = String::empty(a);
    println(e.length() as int);            // 0
    e.free();

    // `build(sb)` consumes a StringBuilder and projects its
    // backing buffer into a String — O(1) transfer, no extra
    // copy.  The move-pass forbids reusing `sb` after `build`
    // (it would alias the buffer that String now owns).
    let mut sb = StringBuilder::with_capacity(a, 4 as u32);
    sb.push_str("built ");                 // 6 bytes
    sb.push_int(2026);                     // 4 bytes
    let s = String::build(sb);             // sb consumed here
    println(s.length() as int);            // 10
    let v2 = s.as_slice();
    println(v2[0] as int);                  // 98  ('b')
    println(v2[6] as int);                  // 50  ('2')
    s.free();
}
