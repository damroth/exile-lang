# syntax=docker/dockerfile:1.7
#
# CI image for exile-lang. 
#
# ---------- Stage 1: amiga-gcc toolchain ----------
FROM debian:bookworm AS toolchain-builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates make wget git xz-utils gcc g++ patch \
        libgmp-dev libmpfr-dev libmpc-dev \
        flex bison gettext texinfo libncurses-dev autoconf rsync \
        lhasa \
 && rm -rf /var/lib/apt/lists/*
COPY tools/amiga-gcc /src/amiga-gcc
RUN cd /src/amiga-gcc && make min PREFIX=/opt/amiga-gcc

# ---------- Stage 2: vamos (amitools, gita HEAD) ----------
FROM debian:bookworm-slim AS vamos-builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates git gcc \
        python3 python3-dev python3-pip python3-venv pipx \
 && rm -rf /var/lib/apt/lists/*
ENV PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/opt/pipx/bin
RUN pipx install amitools \
 && pipx runpip amitools install --force-reinstall --no-deps \
        git+https://github.com/cnvogelg/machine68k.git \
 && pipx runpip amitools install --force-reinstall --no-deps \
        git+https://github.com/cnvogelg/amitools.git \
 && pipx runpip amitools install greenlet lhafile

# ---------- Stage 3: final image ----------
FROM ocaml/opam:debian-ocaml-5.4

USER root
ENV DEBIAN_FRONTEND=noninteractive


RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        libgmp10 libmpfr6 libmpc3 python3 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=toolchain-builder /opt/amiga-gcc /opt/amiga-gcc
COPY --from=vamos-builder /opt/pipx /opt/pipx

ENV PATH="/opt/amiga-gcc/bin:/opt/pipx/bin:${PATH}" \
    TOOLCHAIN_PREFIX=/opt/amiga-gcc \
    OPAMROOT=/home/opam/.opam

USER opam
WORKDIR /home/opam

RUN opam install dune.3.22.0 --yes \
 && opam clean --all-switches --download-cache --logs --repo-cache --yes

WORKDIR /workspace
