// Register #126, positive: a `defer` in a `with` body that reads a live owner,
// refused by the port as in an `if` block.
fn main() { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); let mut arr = [1, 2]; with x in arr[0] { defer { println(v.length() as int); } *x = 3; } }
