// Register #116, positive: a user trait named `Iterator`. A `for` over a prelude
// iterator still runs in the port; the reference has lost the protocol.
trait Iterator { fn step(self) -> int; }
fn main() { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); let mut t = 0; for x in v.iter() { t = t + x; } println(t); }
