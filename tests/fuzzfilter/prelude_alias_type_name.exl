// A user alias named like the prelude's `Allocator`: #136's positive until #226.
// The port now refuses the alias where it is declared, the reference in its
// prelude, in words that do not name it: both refuse, at different positions.
type Allocator = int;
fn main() { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); println(v.length() as int); }
