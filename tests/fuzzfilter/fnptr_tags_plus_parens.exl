// Register #81, negative: the same declared tag AND a mixed bitwise nesting, so
// the emissions differ in two registered ways at once. Neither recogniser may
// claim it - #81's asks that only tag declarations were added, #7's that only
// parentheses moved.
struct P { x: int, y: int }
fn sum(p: P) -> int { return p.x + p.y; }
fn mix(old: int) -> int { return 32768 | (old & 64); }
fn main() { let f: fn(P) -> int = sum; let q = P { x: 2, y: 5 }; println(f(q) + mix(64)); }
