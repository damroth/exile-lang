// Register #81, positive: a function-pointer type takes a struct by value. The
// port declares the struct ahead of the typedef and the reference does not, and
// nothing else in the two emissions differs.
struct P { x: int, y: int }
fn sum(p: P) -> int { return p.x + p.y; }
fn main() { let f: fn(P) -> int = sum; let q = P { x: 2, y: 5 }; println(f(q)); }
