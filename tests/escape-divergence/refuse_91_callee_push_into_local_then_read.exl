// A callee pushes a local's address into the caller's local Vec; the caller reads it back and pushes it into a non-local one.
fn put(v: *Vec<*int>, p: *int) { v.push(p); return; }
fn keep(out: *Vec<*int>) {
    let a = default_allocator();
    let x = 5;
    let mut local: Vec<*int> = Vec::with_capacity(a, 8 as u32);
    put(&local, &x);
    out.push(local[0 as u32]);
    return;
}
fn main() {
    let a = default_allocator();
    let mut out: Vec<*int> = Vec::with_capacity(a, 8 as u32);
    keep(&out);
    println(out.length() as int);
}
