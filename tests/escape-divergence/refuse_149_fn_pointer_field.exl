// The same through a function pointer held in a struct field, reached through a parameter.
fn id(p: *const int) -> *const int { return p; }
struct H { f: fn(*const int) -> *const int }
fn launder(h: *const H) -> *const int { let x = 5; return h.f(&x); }
fn main() { let h = H { f: id }; let p = launder(&h); println(*p); }
