// The address of a pattern's binding itself is this frame's: the binding is a copy of the payload.
enum E { A(Vec<int>) | B }
fn first(e: *const E, d: *const Vec<int>) -> *const Vec<int> { return match *e { E::A(v) => &v as *const Vec<int> | E::B => d }; }
fn main() { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(4); let d: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); let e = E::A(v); let p = first(&e, &d); println(p.length() as int); }
