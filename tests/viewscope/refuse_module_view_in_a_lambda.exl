// A module view matched bare inside a lambda in the module.
mod m {
    pub view Sign(n: int) -> Neg | Pos {
        if n < 0 { return Sign::Neg; }
        return Sign::Pos;
    }
    pub fn s(n: int) -> int {
        let f = |k: int| -> int match k { Sign::Neg => 0 - 1 | Sign::Pos => 1 };
        return f(n);
    }
}
fn main() { println(m::s(0 - 5)); println(m::s(5)); }
