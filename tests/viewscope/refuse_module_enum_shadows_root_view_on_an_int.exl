// A root view, and in `k` a plain enum of its name matched bare on an int.
view Sign(n: int) -> Neg | Pos {
    if n < 0 { return Sign::Neg; }
    return Sign::Pos;
}
mod k {
    pub enum Sign { Neg | Pos }
    pub fn f(n: int) -> int { return match n { Sign::Neg => 0 - 1 | Sign::Pos => 1 }; }
}
fn main() { println(k::f(3)); }
