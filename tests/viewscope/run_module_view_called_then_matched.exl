// A module view called explicitly, its result matched by the bare name inside the module.
mod m {
    pub view Sign(n: int) -> Neg | Pos {
        if n < 0 { return Sign::Neg; }
        return Sign::Pos;
    }
    pub fn s(n: int) -> int { let v = Sign(n); return match v { Sign::Neg => 0 - 1 | Sign::Pos => 1 }; }
}
fn main() { println(m::s(0 - 3)); println(m::s(4)); }
