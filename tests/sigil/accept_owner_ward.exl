// The OWNER side of ward-field coverage: the gate must not
// break the module that legitimately owns the resource. Same overlay, same
// address as reject_ward_field.exl — only the claiming module differs.
sigil Blitter { 0xDFF040 .. 0xDFF05A }
ward Custom { bltsize: u16 at 0x058 write; }

mod gfx {
    own Blitter;
    ward custom: Custom at 0xDFF000;
    pub fn blit_now() { custom.bltsize.write(64); }
}

fn main() { gfx::blit_now(); }
