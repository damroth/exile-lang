// LIMIT: v1 proves "only the owner can OBTAIN a handle", not "only the owner
// can touch the register". A TOP-LEVEL rune declared INSIDE the owner is legal
// (its materialisation site is the owner) — and top-level runes are visible in
// every function's benv, so this is a STANDING delegation to the whole program.
// Legal by construction, and named here so it is a contract rather than a
// discovery: an owner that wants a narrow surface declares its runes locally.
mod ndk { sigil Blitter { 0xDFF040 .. 0xDFF05A } }

mod gfx   { own Blitter; rune bltsize: u16 at 0xDFF058 write; }
mod sound { pub fn use_lent() { bltsize.write(64); } }

fn main() { sound::use_lent(); }
