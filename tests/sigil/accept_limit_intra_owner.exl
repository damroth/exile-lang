// §7 LIMIT: a sigil says WHO may hold the register, never WHEN. Two functions of
// the same owner writing it in any order is legal — sequencing and atomicity are
// the seal era's domain (and the blitter's BBUSY protocol is a third thing again).
mod ndk { sigil Blitter { 0xDFF040 .. 0xDFF05A } }

mod gfx {
    own Blitter;
    rune bs: u16 at 0xDFF058 write;
    pub fn start_a() { bs.write(1); }
    pub fn start_b() { bs.write(2); }
}

fn main() { gfx::start_a(); gfx::start_b(); }
