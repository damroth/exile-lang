// The spine.
//
// The canonical story: a library declares the resource, one module claims it, and
// that module materialises and uses a covered register. The sigil declaration and
// the claim emit NOTHING — a claim is a compile-time fact.
sigil Blitter { 0xDFF040 .. 0xDFF05A }
sigil Sprite0 { 0xDFF120 .. 0xDFF124, 0xDFF140 .. 0xDFF148 }   // non-contiguous

mod gfx {
    own Blitter;
    rune bltsize: u16 at 0xDFF058 write;
    pub fn blit_now() { bltsize.write(64); }
}

fn main() { gfx::blit_now(); }
