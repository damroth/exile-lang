// A user's trait named like the prelude's `Iterator` does not take over the
// protocol `for` and the combinators use: a prelude iterator still drives them.
trait Iterator { fn step(self) -> int; }
struct Tag { n: int }
impl Iterator for Tag { fn step(self) -> int { self.n + 1 } }
fn main() {
    let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32);
    v.push(1);
    v.push(2);
    let z: int = 0;
    let mut t = 0;
    for x in v.iter() { t = t + x; }
    println(t);
    println(v.iter().fold(10, |acc: int, x: int| -> int acc + x + z));
    let g = Tag { n: 4 };
    println(g.step());
}
