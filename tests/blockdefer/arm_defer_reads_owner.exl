// A `defer` in a match arm that reads a live owner is refused even where nothing
// after it in the arm leaves early, as the same `defer` in an `if` block is: the
// rule is about what the defer reads, not about the path it runs on.
enum S { A | B }
fn pick(i: int) -> S { if i == 2 { return S::B; } return S::A; }
fn run(i: int) -> int {
    let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32);
    v.push(41);
    match pick(i) { S::A => { } | S::B => { defer { println(v.length() as int); } println(1); } }
    return 0;
}
fn main() { println(run(1)); println(run(2)); }
