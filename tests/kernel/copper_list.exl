// The copper round's main product: the first observable in this NDK that is NOT a
// store. A copper list is DATA the hardware interprets - MOVE pairs, WAIT pairs,
// and an end marker - so a test can build one and check its WORDS, on a host,
// without any of the silicon that would execute it.
//
// The list lives in a STATIC array. That is a decision, not an accident: the chip
// follows this pointer frame after frame for as long as its DMA is on, so the
// memory has to outlive everything the program does. A per-frame list rebuilt in
// an allocator's buffer is the shape that needs chip-RAM awareness, and it waits
// for the round that brings it.
use ndk::*;

mod raw {
    extern var CHIPREGS: [u8; 256];
    extern var COPLIST:  [u16; 16];
}

// COLOR00 is the background colour register; a copper MOVE names a register by
// its offset in the custom chip, with the low bit clear.
const COLOR00: u16 = 384;

// The list is written THROUGH a pointer, which is what a driver does anyway and
// what the language allows: an `extern var` scalar is assignable, an element of an
// `extern var` array is not, and a pointer into one is. Measured, not assumed.
//
// A MOVE is two words: the register offset, then the value.
fn put_move(l: *u16, i: u32, reg: u16, val: u16) -> u32 {
    l[i] = reg;
    l[i + 1 as u32] = val;
    return i + 2 as u32;
}

// A WAIT is two words: the beam position with its low bit SET, then a mask whose
// low bit is CLEAR - that low-bit pair is how the chip tells a wait from a move.
fn put_wait(l: *u16, i: u32, vpos: u16, hpos: u16) -> u32 {
    l[i] = (vpos * 256 as u16) | (hpos & 254 as u16) | 1 as u16;
    l[i + 1 as u32] = COP_WAIT_MASK;
    return i + 2 as u32;
}

fn put_end(l: *u16, i: u32) -> u32 {
    l[i] = COP_END_HI;
    l[i + 1 as u32] = COP_END_LO;
    return i + 2 as u32;
}

// Two colour bands and an end: wait for line 0x2C, go blue; wait for line 0x80,
// go black; stop.
pub fn build(l: *u16) -> u32 {
    let mut i = 0 as u32;
    i = put_wait(l, i, 44 as u16, 1 as u16);
    i = put_move(l, i, COLOR00, 15 as u16);
    i = put_wait(l, i, 128 as u16, 1 as u16);
    i = put_move(l, i, COLOR00, 0 as u16);
    i = put_end(l, i);
    return i;
}

fn main() {
    let n = build(&raw::COPLIST[0]);
    install(&raw::COPLIST[0]);
    println(n as int);
    let mut k = 0 as u32;
    while k < n { println(raw::COPLIST[k] as int); k = k + 1 as u32; }
}

// ---- installing it, and the tension this round was sent to witness -----------
//
// Pointing the chip at the list is `addr` doing the job it was ratified for. But
// turning the copper's DMA on touches DMACON, which the NDK declares in an ATOMIC
// group with DMACONR - so this function is REQUIRED to seal, and that requirement
// is the witness.
//
// Inside a VBlank handler the same write would still be required to seal, and
// there it is redundant: the handler already runs with the level masked by the
// hardware that dispatched it, and the region's exit restores a status register
// the `rte` is about to restore from the exception frame anyway. A handler is
// forced to write a second mask around a write that is already indivisible.
//
// That is not a defect in the region rule - the rule cannot know it is inside a
// handler - and it is the sharpest question a future ISR notation would have to
// answer. It is written here, in a running program, because a vote wants a
// program and not a table.
pub fn install(l: *u16) {
    ward c: Control at &raw::CHIPREGS;
    ward k: Copper  at &raw::CHIPREGS;
    k.cop1lc.write(l);
    k.copjmp1.write(0 as u16);
    seal {
        c.dmacon.write(DMAF_SETCLR | DMAF_COPPER);
    }
}
