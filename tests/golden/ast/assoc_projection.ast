;; exile-ast-dump v1 examples/assoc_projection.exl
(struct Count (fields (field n (int i32)) (field stop (int i32))))
(impl Count (trait Iterator) (fn next pub (params (param self (ptr (struct Count)))) (struct-app Option (int i32)) (body (expr-stmt (if (binop >= (field-access (var self) n) (field-access (var self) stop)) (then (return (enum-lit Option::None))))) (let v (field-access (var self) n)) (assign-field (var self) n (binop + (field-access (var self) n) (int 1))) (tail (call Option::Some (var v))))))
(struct Words (fields (field ws (array str ?)) (field i (int i32))))
(impl Words (trait Iterator) (fn next pub (params (param self (ptr (struct Words)))) (struct-app Option str) (body (expr-stmt (if (binop >= (field-access (var self) i) (int 3)) (then (return (enum-lit Option::None))))) (let s (index (field-access (var self) ws) (field-access (var self) i))) (assign-field (var self) i (binop + (field-access (var self) i) (int 1))) (tail (call Option::Some (var s))))))
(fn first (tparams I) (params (param it (ptr (struct I)))) (struct-app Option (struct I::Item)) (body (return (method-call (var it) next ))))
(fn main (params ) void (body (let counts (struct-lit Count (field n (int 10)) (field stop (int 12)))) (expr-stmt (match (call first (ref (var counts))) (arm (pat-variant Option::Some (pat-var v)) (block (expr-stmt (call println (var v))))) (arm (pat-variant Option::None) (block (expr-stmt (call println (int 99))))))) (let words (struct-lit Words (field ws (array-lit (string "one") (string "two") (string "three"))) (field i (int 0)))) (tail (match (call first (ref (var words))) (arm (pat-variant Option::Some (pat-var s)) (block (expr-stmt (call println (var s))))) (arm (pat-variant Option::None) (block (expr-stmt (call println (string "end")))))))))
