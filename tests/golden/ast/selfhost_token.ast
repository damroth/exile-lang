(fn main (params ) void (body (let kw (enum-lit Token::Fn)) (expr-stmt (call println (var kw))) (let arrow (enum-lit Token::FatArrow)) (expr-stmt (call println (var arrow))) (let id (call Token::Ident (string "main"))) (expr-stmt (call println (var id))) (let n (call Token::Int (int 42))) (expr-stmt (call println (var n))) (let f (call Token::Float (float 0x1.91eb851eb851fp+1 f64) (bool false))) (expr-stmt (call println (var f))) (let s (call Token::StringTok (string "hello"))) (expr-stmt (call println (var s))) (let end (enum-lit Token::Eof)) (expr-stmt (call println (var end)))))
