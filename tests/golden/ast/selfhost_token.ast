(enum Token pub (variants (variant Fn) (variant Let) (variant Mut) (variant Return) (variant If) (variant Else) (variant While) (variant Loop) (variant Break) (variant Continue) (variant For) (variant In) (variant Mod) (variant Pub) (variant Use) (variant As) (variant Defer) (variant Struct) (variant Impl) (variant Trait) (variant View) (variant With) (variant Enum) (variant Match) (variant FatArrow) (variant Pipe) (variant PipePipe) (variant PipeGt) (variant AmpAmp) (variant Dot) (variant DotDot) (variant DotDotEq) (variant Amp) (variant New) (variant Null) (variant LParen) (variant RParen) (variant LBrace) (variant RBrace) (variant LBracket) (variant RBracket) (variant Semicolon) (variant Comma) (variant Colon) (variant DoubleColon) (variant Arrow) (variant Eq) (variant EqEq) (variant NotEq) (variant Bang) (variant Lt) (variant Gt) (variant LtEq) (variant GtEq) (variant Plus) (variant PlusPlus) (variant Minus) (variant Star) (variant Slash) (variant Percent) (variant Caret) (variant Tilde) (variant Shl) (variant Shr) (variant True) (variant False) (variant Question) (variant Orelse) (variant TryTok) (variant Extern) (variant Ellipsis) (variant At) (variant TypeTok) (variant Const) (variant VarTok) (variant SizeOf) (variant Ident str) (variant Int (int i32)) (variant Float (float f64) bool) (variant StringTok str) (variant Eof)))
(fn push_float_suffix (params (param out (ptr (struct StringBuilder))) (param is32 bool)) void (body (tail (if (var is32) (then (expr-stmt (method-call (var out) push_str (string "<f32>")))) (else (expr-stmt (method-call (var out) push_str (string "<f64>"))))))))
