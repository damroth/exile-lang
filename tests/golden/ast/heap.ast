;; exile-ast-dump v1 examples/heap.exl
(struct Point (fields (field x (int i32)) (field y (int i32))))
(fn make_point (params (param a (struct Allocator)) (param x (int i32)) (param y (int i32))) (own-ptr (struct Point)) (body (return (new Point (field x (var x)) (field y (var y))))))
(fn shift (params (param p (ptr (struct Point))) (param dx (int i32)) (param dy (int i32))) void (body (assign-field (var p) x (binop + (field-access (var p) x) (var dx))) (assign-field (var p) y (binop + (field-access (var p) y) (var dy)))))
(fn main (params ) void (body (let a (call default_allocator )) (let p (new Point (field x (int 1)) (field y (int 2)))) (defer (expr-stmt (call free (var p)))) (assign-field (var p) x (int 10)) (assign-field (var p) y (int 20)) (expr-stmt (call println (field-access (var p) x))) (expr-stmt (call println (field-access (var p) y))) (let q (call make_point (var a) (int 100) (int 200))) (defer (expr-stmt (call free (var q)))) (expr-stmt (call shift (var q) (int 5) (int 7))) (expr-stmt (call println (field-access (var q) x))) (expr-stmt (call println (field-access (var q) y)))))
