;; exile-ast-dump v1 examples/sibling_shadowing.exl
(enum Shape (variants (variant Circle (int i32)) (variant Square (int i32))))
(fn area (params (param s (struct Shape))) (int i32) (body (return (match (var s) (arm (pat-variant Shape::Circle (pat-var r)) (block (let v (binop * (binop * (int 3) (var r)) (var r))) (tail (var v)))) (arm (pat-variant Shape::Square (pat-var w)) (block (let v (binop * (var w) (var w))) (tail (var v))))))))
(fn weighted (params (param n (int i32))) (int i32) (body (let mut total (int 0)) (let mut i (int 0)) (while (binop < (var i) (var n)) (let step (binop * (var i) (int 2))) (assign total (binop + (var total) (var step))) (assign i (binop + (var i) (int 1)))) (let mut j (int 0)) (while (binop < (var j) (var n)) (let step (binop * (var j) (int 3))) (assign total (binop + (var total) (var step))) (assign j (binop + (var j) (int 1)))) (return (var total))))
(fn pick (params (param b bool)) (int i32) (body (let mut out (int 0)) (expr-stmt (if (var b) (then (let chosen (int 10)) (assign out (var chosen))) (else (let chosen (int 20)) (assign out (var chosen))))) (return (var out))))
(fn counted (params (param n (int i32))) (int i32) (body (let mut total (int 0)) (for i (range (int 0) (var n) exclusive) (assign total (binop + (var total) (var i)))) (for i (range (int 0) (var n) exclusive) (assign total (binop + (var total) (binop * (var i) (int 10))))) (return (var total))))
(fn arm_over_visible (params (param s (struct Shape))) (int i32) (body (let v (int 100)) (let inner (match (var s) (arm (pat-variant Shape::Circle (pat-var v)) (block (tail (binop + (var v) (int 1))))) (arm (pat-variant Shape::Square (pat-var v)) (block (tail (binop + (var v) (int 2))))))) (return (binop + (var v) (var inner)))))
(fn twice (params (param f (fn-ptr ((int i32)) (int i32))) (param x (int i32))) (int i32) (body (return (call f (call f (var x))))))
(fn lambda_over_visible (params ) (int i32) (body (let v (int 100)) (let bump (lambda ((param v (int i32))) (int i32) (binop + (var v) (int 1)))) (return (binop + (var v) (call twice (var bump) (int 5))))))
(fn main (params ) void (body (expr-stmt (call println (call area (call Shape::Circle (int 2))))) (expr-stmt (call println (call area (call Shape::Square (int 4))))) (expr-stmt (call println (call weighted (int 3)))) (expr-stmt (call println (call pick (bool true)))) (expr-stmt (call println (call pick (bool false)))) (expr-stmt (call println (call counted (int 3)))) (expr-stmt (call println (call arm_over_visible (call Shape::Circle (int 2))))) (expr-stmt (call println (call arm_over_visible (call Shape::Square (int 4))))) (expr-stmt (call println (call lambda_over_visible )))))
