;; exile-ast-dump v1 examples/enums.exl
(enum Direction pub (variants (variant North) (variant South) (variant East) (variant West)))
(enum Shape pub (variants (variant Square) (variant Circle (int i32)) (variant Rect (int i32) (int i32)) (variant Triangle (field base (int i32)) (field height (int i32)))))
(fn describe_dir (params (param d (struct Direction))) void (body (tail (match (var d) (arm (pat-variant Direction::North) (call println (string "up"))) (arm (pat-variant Direction::South) (call println (string "down"))) (arm _ (call println (string "sideways")))))))
(fn describe_shape (params (param s (struct Shape))) void (body (tail (match (var s) (arm (pat-variant Shape::Square) (call println (string "a square"))) (arm (pat-variant Shape::Circle (pat-var r)) (call println (var r))) (arm (pat-variant Shape::Rect (pat-var w) _) (call println (var w))) (arm (pat-variant Shape::Triangle (field base (pat-var base)) (field height (pat-var h))) (call println (binop + (var base) (var h))))))))
(fn area (params (param s (struct Shape))) (int i32) (body (return (match (var s) (arm (pat-variant Shape::Square) (int 1)) (arm (pat-variant Shape::Circle (pat-var r)) (binop * (binop * (var r) (var r)) (int 3))) (arm (pat-variant Shape::Rect (pat-var w) (pat-var h)) (binop * (var w) (var h))) (arm (pat-variant Shape::Triangle (field base (pat-var base)) (field height (pat-var height))) (binop / (binop * (var base) (var height)) (int 2)))))))
(enum Tree pub (variants (variant Leaf (int i32)) (variant Node (struct Shape))))
(fn tree_kind (params (param t (struct Tree))) (int i32) (body (return (match (var t) (arm (pat-variant Tree::Leaf (pat-var n)) (var n)) (arm (pat-variant Tree::Node (pat-variant Shape::Circle (pat-var r))) (var r)) (arm (pat-variant Tree::Node (pat-variant Shape::Square)) (int 0)) (arm (pat-variant Tree::Node (pat-variant Shape::Rect (pat-var w) (pat-var h))) (binop + (var w) (var h))) (arm (pat-variant Tree::Node (pat-variant Shape::Triangle (field base (pat-var base)) (field height (pat-var height)))) (binop + (var base) (var height)))))))
(fn main (params ) void (body (let d (enum-lit Direction::East)) (expr-stmt (call describe_dir (var d))) (expr-stmt (call describe_shape (enum-lit Shape::Square))) (expr-stmt (call describe_shape (call Shape::Circle (int 7)))) (expr-stmt (call describe_shape (call Shape::Rect (int 10) (int 20)))) (expr-stmt (call println (call area (call Shape::Circle (int 5))))) (expr-stmt (call println (call area (call Shape::Rect (int 3) (int 4))))) (expr-stmt (call println (call area (struct-lit Shape::Triangle (field base (int 6)) (field height (int 8)))))) (expr-stmt (call describe_shape (struct-lit Shape::Triangle (field base (int 1)) (field height (int 2))))) (let total (binop + (int 1) (match (call Shape::Circle (int 2)) (arm (pat-variant Shape::Square) (int 0)) (arm (pat-variant Shape::Circle (pat-var r)) (var r)) (arm (pat-variant Shape::Rect (pat-var w) (pat-var h)) (binop + (var w) (var h))) (arm (pat-variant Shape::Triangle (field base (pat-var base)) (field height (pat-var height))) (binop + (var base) (var height)))))) (expr-stmt (call println (var total))) (expr-stmt (call println (call tree_kind (call Tree::Leaf (int 42))))) (expr-stmt (call println (call tree_kind (call Tree::Node (call Shape::Circle (int 5)))))) (expr-stmt (call println (call tree_kind (call Tree::Node (call Shape::Rect (int 3) (int 4))))))))
