;; exile-ast-dump v1 examples/active_patterns.exl
(view Sign (param n (int i32)) (case Negative) (case Zero) (case Positive) (body (expr-stmt (if (binop < (var n) (int 0)) (then (return (enum-lit Sign::Negative))))) (expr-stmt (if (binop == (var n) (int 0)) (then (return (enum-lit Sign::Zero))))) (return (enum-lit Sign::Positive))))
(view Magnitude (param n (int i32)) (case Small) (case Medium) (case Large (field _0 (int i32))) (body (expr-stmt (if (binop < (var n) (int 10)) (then (return (enum-lit Magnitude::Small))))) (expr-stmt (if (binop < (var n) (int 100)) (then (return (enum-lit Magnitude::Medium))))) (return (call Magnitude::Large (var n)))))
(fn classify (params (param n (int i32))) void (body (tail (match (var n) (arm (pat-variant Sign::Negative) (block (expr-stmt (call println (neg (int 1)))))) (arm (pat-variant Sign::Zero) (block (expr-stmt (call println (int 0))))) (arm (pat-variant Sign::Positive) (block (expr-stmt (call println (int 1)))))))))
(fn weigh (params (param n (int i32))) void (body (tail (match (var n) (arm (pat-variant Magnitude::Small) (block (expr-stmt (call println (int 1))))) (arm (pat-variant Magnitude::Medium) (block (expr-stmt (call println (int 2))))) (arm (pat-variant Magnitude::Large (pat-var v)) (block (expr-stmt (call println (var v)))))))))
(fn main (params ) void (body (expr-stmt (call classify (neg (int 5)))) (expr-stmt (call classify (int 0))) (expr-stmt (call classify (int 42))) (expr-stmt (call weigh (int 7))) (expr-stmt (call weigh (int 50))) (expr-stmt (call weigh (int 2500))) (let s (call Sign (int 99))) (tail (match (var s) (arm (pat-variant Sign::Negative) (block (expr-stmt (call println (neg (int 1)))))) (arm (pat-variant Sign::Zero) (block (expr-stmt (call println (int 0))))) (arm (pat-variant Sign::Positive) (block (expr-stmt (call println (int 1)))))))))
