;; exile-ast-dump v1 examples/selfhost_error.exl
(module pos
  (struct Pos pub (fields (field line (int i32)) (field col (int i32)) (field file str)))
  (impl Pos (fn zero pub (params ) (struct Pos) (body (tail (struct-lit Pos (field line (int 1)) (field col (int 1)) (field file (string "<unknown>")))))))
  (impl Pos (trait Display) (fn fmt pub (params (param self (const-ptr (struct Pos))) (param out (ptr (struct StringBuilder)))) void (body (expr-stmt (method-call (var out) push_str (field-access (var self) file))) (expr-stmt (method-call (var out) push_str (string ":"))) (expr-stmt (method-call (var out) push_int (field-access (var self) line))) (expr-stmt (method-call (var out) push_str (string ":"))) (expr-stmt (method-call (var out) push_int (field-access (var self) col)))))))
(struct CompileError pub (fields (field pos (struct pos::Pos)) (field msg str)))
(impl CompileError (fn make pub (params (param p (const-ptr (struct pos::Pos))) (param msg str)) (struct CompileError) (body (tail (struct-lit CompileError (field pos (deref (var p))) (field msg (var msg)))))))
(impl CompileError (trait Display) (fn fmt pub (params (param self (const-ptr (struct CompileError))) (param out (ptr (struct StringBuilder)))) void (body (expr-stmt (method-call (var out) push_str (field-access (field-access (var self) pos) file))) (expr-stmt (method-call (var out) push_str (string ":"))) (expr-stmt (method-call (var out) push_int (field-access (field-access (var self) pos) line))) (expr-stmt (method-call (var out) push_str (string ":"))) (expr-stmt (method-call (var out) push_int (field-access (field-access (var self) pos) col))) (expr-stmt (method-call (var out) push_str (string ": error: "))) (expr-stmt (method-call (var out) push_str (field-access (var self) msg))))))
(fn main (params ) void (body (let p (struct-lit pos::Pos (field line (int 42)) (field col (int 7)) (field file (string "parser.exl")))) (let e (call CompileError::make (ref (var p)) (string "expected ';' after statement"))) (expr-stmt (call println (var e))) (let z (call pos::Pos::zero )) (let internal (call CompileError::make (ref (var z)) (string "internal: unhandled IR variant reached codegen"))) (expr-stmt (call println (var internal)))))
