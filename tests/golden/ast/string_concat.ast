;; exile-ast-dump v1 examples/string_concat.exl
(fn main (params ) void (body (let greeting (ty str) (binop ++ (string "Hello, ") (string "World!"))) (expr-stmt (call println (var greeting))) (let banner (ty str) (binop ++ (binop ++ (string "===") (string " exile-lang ")) (string "==="))) (expr-stmt (call println (var banner))) (let version (ty str) (binop ++ (binop ++ (binop ++ (binop ++ (binop ++ (string "v") (string "0")) (string ".")) (string "4")) (string ".")) (string "0"))) (expr-stmt (call println (var version))) (let labelled (ty str) (binop ++ (string "type: ") (call type_name (int 42)))) (expr-stmt (call println (var labelled)))))
