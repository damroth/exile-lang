;; exile-ast-dump v1 examples/for_iterator.exl
(struct Countdown (fields (field n (int i32))))
(impl Countdown (trait Iterator) (fn next pub (params (param self (ptr (struct Countdown)))) (struct-app Option (int i32)) (body (expr-stmt (if (binop <= (field-access (var self) n) (int 0)) (then (return (enum-lit Option::None))))) (let v (field-access (var self) n)) (assign-field (var self) n (binop - (field-access (var self) n) (int 1))) (tail (call Option::Some (var v))))))
(struct Range2 (fields (field cur (int i32)) (field stop (int i32)) (field step (int i32))))
(impl Range2 (trait Iterator) (fn next pub (params (param self (ptr (struct Range2)))) (struct-app Option (int i32)) (body (expr-stmt (if (binop >= (field-access (var self) cur) (field-access (var self) stop)) (then (return (enum-lit Option::None))))) (let v (field-access (var self) cur)) (assign-field (var self) cur (binop + (field-access (var self) cur) (field-access (var self) step))) (tail (call Option::Some (var v))))))
(fn main (params ) void (body (let cd (struct-lit Countdown (field n (int 4)))) (for x (var cd) (expr-stmt (call println (var x)))) (let r (struct-lit Range2 (field cur (int 0)) (field stop (int 20)) (field step (int 1)))) (for y (var r) (expr-stmt (if (binop == (var y) (int 5)) (then (break)))) (expr-stmt (if (binop == (var y) (int 2)) (then (continue)))) (expr-stmt (call println (binop * (var y) (int 10)))))))
