;; exile-ast-dump v1 examples/tuples.exl
(fn split (params (param n (int i32))) (tuple (int i32) (int i32)) (body (return (tuple-lit (binop * (var n) (int 2)) (binop * (var n) (int 3))))))
(fn min_max (params (param a (int i32)) (param b (int i32))) (tuple (int i32) (int i32)) (body (tail (if (binop < (var a) (var b)) (then (return (tuple-lit (var a) (var b)))) (else (return (tuple-lit (var b) (var a))))))))
(fn label_score (params (param score (int i32))) (tuple str (int i32)) (body (tail (if (binop >= (var score) (int 90)) (then (return (tuple-lit (string "A") (var score)))) (else (tail (if (binop >= (var score) (int 70)) (then (return (tuple-lit (string "B") (var score)))) (else (return (tuple-lit (string "C") (var score)))))))))))
(fn main (params ) void (body (let-tuple (a b) (call split (int 5))) (expr-stmt (call println (var a))) (expr-stmt (call println (var b))) (let-tuple (lo hi) (call min_max (int 7) (int 3))) (expr-stmt (call println (var lo))) (expr-stmt (call println (var hi))) (let-tuple (grade points) (call label_score (int 85))) (expr-stmt (call println (var grade))) (expr-stmt (call println (var points))) (let-tuple (x y) (tuple-lit (int 10) (int 20))) (expr-stmt (call println (var x))) (expr-stmt (call println (var y)))))
