;; exile-ast-dump v1 examples/multi_stmt_match.exl
(enum Shape (variants (variant Square (int i32)) (variant Circle (int i32)) (variant Rect (int i32) (int i32))))
(fn area (params (param s (struct Shape))) (int i32) (body (tail (match (var s) (arm (pat-variant Shape::Square (pat-var side)) (block (let sq (binop * (var side) (var side))) (tail (var sq)))) (arm (pat-variant Shape::Circle (pat-var r)) (block (let r2 (binop * (var r) (var r))) (tail (binop / (binop * (var r2) (int 314)) (int 100))))) (arm (pat-variant Shape::Rect (pat-var w) (pat-var h)) (binop * (var w) (var h)))))))
(fn describe (params (param s (struct Shape))) void (body (tail (match (var s) (arm (pat-variant Shape::Square (pat-var side)) (block (expr-stmt (call println (int 1))) (expr-stmt (call println (var side))))) (arm (pat-variant Shape::Circle (pat-var r)) (block (expr-stmt (call println (int 2))) (expr-stmt (call println (var r))))) (arm (pat-variant Shape::Rect (pat-var w) (pat-var h)) (block (expr-stmt (call println (int 3))) (expr-stmt (call println (var w))) (expr-stmt (call println (var h)))))))))
(fn main (params ) void (body (expr-stmt (call println (call area (call Shape::Square (int 4))))) (expr-stmt (call println (call area (call Shape::Circle (int 10))))) (expr-stmt (call println (call area (call Shape::Rect (int 3) (int 5))))) (expr-stmt (call describe (call Shape::Rect (int 7) (int 9))))))
