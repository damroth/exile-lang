;; exile-ast-dump v1 examples/generics.exl
(struct Pair (tparams A B) (fields (field fst (struct A)) (field snd (struct B))))
(fn first_int_or (params (param d (int i32)) (param opt (struct-app Option (int i32)))) (int i32) (body (return (orelse (var opt) (var d)))))
(fn incr_opt (params (param o (struct-app Option (int i32)))) (struct-app Option (int i32)) (body (let v (try (var o))) (return (call Option::Some (binop + (var v) (int 1))))))
(enum IoErr (variants (variant NotFound) (variant Denied)))
(fn read_count (params (param ok bool)) (struct-app Result (int i32) (struct IoErr)) (body (expr-stmt (if (var ok) (then (return (call Result::Ok (int 42)))))) (return (call Result::Err (enum-lit IoErr::NotFound)))))
(fn read_doubled (params (param ok bool)) (struct-app Result (int i32) (struct IoErr)) (body (let v (try (call read_count (var ok)))) (return (call Result::Ok (binop * (var v) (int 2))))))
(fn describe (params (param r (struct-app Result (int i32) (struct IoErr)))) void (body (tail (match (var r) (arm (pat-variant Result::Ok (pat-var v)) (call println (var v))) (arm (pat-variant Result::Err _) (call println (int 0)))))))
(fn main (params ) void (body (let p (struct-lit Pair (field fst (int 5)) (field snd (string "hi")))) (expr-stmt (call println (field-access (var p) fst))) (let p2 (struct-lit Pair (field fst (int 6)) (base (var p)))) (expr-stmt (call println (field-access (var p2) fst))) (expr-stmt (call println (field-access (var p2) snd))) (let some (call Option::Some (int 7))) (let none (ty (struct-app Option (int i32))) (enum-lit Option::None)) (expr-stmt (call println (call first_int_or (int 99) (var some)))) (expr-stmt (call println (call first_int_or (int 99) (var none)))) (expr-stmt (call describe (call read_count (bool true)))) (expr-stmt (call describe (call read_count (bool false)))) (expr-stmt (match (call incr_opt (var some)) (arm (pat-variant Option::Some (pat-var x)) (call println (var x))) (arm (pat-variant Option::None) (call println (neg (int 1)))))) (expr-stmt (match (call incr_opt (var none)) (arm (pat-variant Option::Some (pat-var x)) (call println (var x))) (arm (pat-variant Option::None) (call println (neg (int 1)))))) (expr-stmt (call describe (call read_doubled (bool true)))) (expr-stmt (call describe (call read_doubled (bool false))))))
