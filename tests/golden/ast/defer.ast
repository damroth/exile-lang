;; exile-ast-dump v1 examples/defer.exl
(fn lifo (params ) void (body (defer (expr-stmt (call println (string "third")))) (defer (expr-stmt (call println (string "second")))) (defer (expr-stmt (call println (string "first")))) (expr-stmt (call println (string "body")))))
(fn block_defer (params ) void (body (defer (expr-stmt (call println (string "a"))) (expr-stmt (call println (string "b"))) (expr-stmt (call println (string "c")))) (expr-stmt (call println (string "body")))))
(fn early_exit (params (param n (int i32))) (int i32) (body (defer (expr-stmt (call println (string "outer cleanup")))) (expr-stmt (if (binop > (var n) (int 0)) (then (defer (expr-stmt (call println (string "inner cleanup")))) (return (binop * (var n) (int 2)))))) (return (int 0))))
(fn void_early_exit (params (param skip bool)) void (body (defer (expr-stmt (call println (string "cleanup")))) (expr-stmt (if (var skip) (then (expr-stmt (call println (string "skipped"))) (return)))) (expr-stmt (call println (string "worked")))))
(fn main (params ) void (body (expr-stmt (call lifo )) (expr-stmt (call println (string "---"))) (expr-stmt (call block_defer )) (expr-stmt (call println (string "---"))) (expr-stmt (call println (call early_exit (int 5)))) (expr-stmt (call println (string "---"))) (expr-stmt (call println (call early_exit (neg (int 3))))) (expr-stmt (call println (string "---"))) (expr-stmt (call void_early_exit (bool true))) (expr-stmt (call println (string "---"))) (expr-stmt (call void_early_exit (bool false)))))
