;; exile-typed-ir-dump v1 examples/bool_match.exl
(tfn ex_yes_no (params (param b bool)) str (body (return (match (var b) :ty bool :enum  (arm (pat-bool true) (string "yes") :ty str) (arm (pat-bool false) (string "no") :ty str)) :ty str)))
(tfn ex_parity_word (params (param n (int i32))) str (body (return (match (binop == (binop % (var n) :ty (int i32) (int 2) :ty (int i32)) :ty (int i32) (int 0) :ty (int i32)) :ty bool :enum  (arm (pat-bool true) (string "even") :ty str) (arm (pat-bool false) (string "odd") :ty str)) :ty str)))
(tfn main (params ) void (body (expr-stmt (builtin-call println (call ex_yes_no (bool true) :ty bool) :ty str) :ty (int i32)) (expr-stmt (builtin-call println (call ex_yes_no (bool false) :ty bool) :ty str) :ty (int i32)) (expr-stmt (builtin-call println (call ex_parity_word (int 4) :ty (int i32)) :ty str) :ty (int i32)) (expr-stmt (builtin-call println (call ex_parity_word (int 7) :ty (int i32)) :ty str) :ty (int i32))))
(mono-instances
  (struct Enumerate)
  (struct Filter)
  (struct HashMap)
  (struct HashMapIter)
  (struct Map)
  (struct Range)
  (struct RangeInclusive)
  (struct Slice)
  (struct Slot)
  (struct Take)
  (struct Vec)
  (struct VecIter)
  (enum Option)
  (enum Result)
)
