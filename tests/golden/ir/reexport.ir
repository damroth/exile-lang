;; exile-typed-ir-dump v1 examples/reexport.exl
(tfn ex_hello pub (params ) void (body (expr-stmt (builtin-call println (string "hello from the prelude") :ty str) :ty (int i32))))
(tfn ex_goodbye pub (params ) void (body (expr-stmt (builtin-call println (string "goodbye from the prelude") :ty str) :ty (int i32))))
(tfn main (params ) void (body (expr-stmt (call ex_hello) :ty (int i32)) (expr-stmt (call ex_goodbye) :ty (int i32))))
(mono-instances
  (struct HashMap)
  (struct HashMapIter)
  (struct Map)
  (struct Range)
  (struct RangeInclusive)
  (struct Slice)
  (struct Slot)
  (struct Vec)
  (struct VecIter)
  (enum Option)
  (enum Result)
)
