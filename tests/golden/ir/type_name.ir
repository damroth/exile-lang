;; exile-typed-ir-dump v1 examples/type_name.exl
(tfn ex_dbg (params (param label str) (param x (tvar T))) (tvar T) (body ))
(tfn main (params ) void (body (let a (int 5) :ty (int i8)) (let b (int 100) :ty (int u16)) (let c (neg (int 1) :ty (int i32)) :ty (int i32)) (let s (string "hi") :ty str) (expr-stmt (builtin-call println (builtin-call type_name (var a) :ty (int i8)) :ty str) :ty (int i32)) (expr-stmt (builtin-call println (builtin-call type_name (var b) :ty (int u16)) :ty str) :ty (int i32)) (expr-stmt (builtin-call println (builtin-call type_name (var c) :ty (int i32)) :ty str) :ty (int i32)) (expr-stmt (builtin-call println (builtin-call type_name (var s) :ty str) :ty str) :ty (int i32)) (expr-stmt (builtin-call println (builtin-call type_name (int 42) :ty (int i32)) :ty str) :ty (int i32)) (let p (struct-lit Point (field x (int 1) :ty (int i32)) (field y (int 2) :ty (int i32))) :ty (struct Point)) (expr-stmt (builtin-call println (builtin-call type_name (var p) :ty (struct Point)) :ty str) :ty (int i32)) (expr-stmt (builtin-call println (builtin-call type_name (ref (var p) :ty (struct Point)) :ty (ptr (struct Point))) :ty str) :ty (int i32)) (let r (enum-lit Result_i32_str::Ok tag=0 (field _0 (int 7) :ty (int i32))) :ty (enum Result_i32_str)) (expr-stmt (builtin-call println (builtin-call type_name (var r) :ty (enum Result_i32_str)) :ty str) :ty (int i32)) (let _v1 (call ex_dbg_i32 (string "v1:") :ty str (int 42) :ty (int i32)) :ty (int i32)) (let _v2 (call ex_dbg_str (string "v2:") :ty str (string "text") :ty str) :ty str) (let _v3 (call ex_dbg_ex_Point (string "v3:") :ty str (var p) :ty (struct Point)) :ty (struct Point))))
(tfn ex_dbg_i32 (params (param label str) (param x (int i32))) (int i32) (body (expr-stmt (builtin-call println (var label) :ty str) :ty (int i32)) (expr-stmt (builtin-call println (builtin-call type_name (var x) :ty (int i32)) :ty str) :ty (int i32)) (return (var x) :ty (int i32))))
(tfn ex_dbg_str (params (param label str) (param x str)) str (body (expr-stmt (builtin-call println (var label) :ty str) :ty (int i32)) (expr-stmt (builtin-call println (builtin-call type_name (var x) :ty str) :ty str) :ty (int i32)) (return (var x) :ty str)))
(tfn ex_dbg_ex_Point (params (param label str) (param x (struct Point))) (struct Point) (body (expr-stmt (builtin-call println (var label) :ty str) :ty (int i32)) (expr-stmt (builtin-call println (builtin-call type_name (var x) :ty (struct Point)) :ty str) :ty (int i32)) (return (var x) :ty (struct Point))))
(mono-instances
  (struct HashMap)
  (struct HashMapIter)
  (struct Map)
  (struct Point)
  (struct Range)
  (struct RangeInclusive)
  (struct Slice)
  (struct Slot)
  (struct Vec)
  (struct VecIter)
  (enum Option)
  (enum Result)
  (enum Result_i32_str)
)
