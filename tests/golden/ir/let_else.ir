;; exile-typed-ir-dump v1 examples/let_else.exl
(tfn ex_parse (params (param ok bool)) (enum Parsed) (body (if (var ok) :ty bool (then (return (enum-lit Parsed::Num tag=0 (field value (int 42) :ty (int i32)) (field digits (int 2) :ty (int i32))) :ty (enum Parsed))) (else )) (return (enum-lit Parsed::Bad tag=1) :ty (enum Parsed))))
(tfn ex_find (params (param ok bool)) (enum Option_i32) (body (if (var ok) :ty bool (then (return (enum-lit Option_i32::Some tag=1 (field _0 (int 7) :ty (int i32))) :ty (enum Option_i32))) (else )) (return (enum-lit Option_i32::None tag=0) :ty (enum Option_i32))))
(tfn ex_doubled (params (param ok bool)) (int i32) (body (let v (match (call ex_find (var ok) :ty bool) :ty (enum Option_i32) :enum Option_i32 (arm (pat-variant Some tag=1 (field _0 (pat-var __le_a0))) (var __le_a0) :ty (int i32)) (arm _ diverges (block (stmts (return (binop - (int 0) :ty (int i32) (int 1) :ty (int i32)) :ty (int i32)))) :ty (int i32))) :ty (int i32)) (return (binop * (var v) :ty (int i32) (int 2) :ty (int i32)) :ty (int i32))))
(tfn ex_describe (params (param ok bool)) (int i32) (body (let-tuple (value digits) (match (call ex_parse (var ok) :ty bool) :ty (enum Parsed) :enum Parsed (arm (pat-variant Num tag=0 (field value (pat-var __le_a_value)) (field digits (pat-var __le_a_digits))) (tuple-lit (var __le_a_value) :ty (int i32) (var __le_a_digits) :ty (int i32)) :ty (tuple (int i32) (int i32))) (arm _ diverges (block (stmts (expr-stmt (builtin-call println (string "not a number") :ty str) :ty (int i32)) (return (int 0) :ty (int i32)))) :ty (tuple (int i32) (int i32)))) :ty (tuple (int i32) (int i32))) (expr-stmt (builtin-call println (var value) :ty (int i32)) :ty (int i32)) (return (var digits) :ty (int i32))))
(tfn main (params ) void (body (expr-stmt (builtin-call println (call ex_doubled (bool true) :ty bool) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (call ex_doubled (bool false) :ty bool) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (call ex_describe (bool true) :ty bool) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (call ex_describe (bool false) :ty bool) :ty (int i32)) :ty (int i32))))
(mono-instances
  (struct Enumerate)
  (struct Filter)
  (struct HashMap)
  (struct HashMapIter)
  (struct Map)
  (struct Range)
  (struct RangeInclusive)
  (struct Slice)
  (struct Slot)
  (struct Take)
  (struct Vec)
  (struct VecIter)
  (enum Option)
  (enum Option_i32)
  (enum Parsed)
  (enum Result)
)
