;; exile-typed-ir-dump v1 examples/heap.exl
(tfn ex_make_point (params (param x (int i32)) (param y (int i32))) (ptr (struct Point)) (body (return (new Point (field x (var x) :ty (int i32)) (field y (var y) :ty (int i32))) :ty (ptr (struct Point)))))
(tfn ex_shift (params (param p (ptr (struct Point))) (param dx (int i32)) (param dy (int i32))) void (body (assign-field (var p) :ty (ptr (struct Point)) x (binop + (field-access (var p) :ty (ptr (struct Point)) x) :ty (int i32) (var dx) :ty (int i32)) :ty (int i32)) (assign-field (var p) :ty (ptr (struct Point)) y (binop + (field-access (var p) :ty (ptr (struct Point)) y) :ty (int i32) (var dy) :ty (int i32)) :ty (int i32))))
(tfn main (params ) void (body (let p (new Point (field x (int 1) :ty (int i32)) (field y (int 2) :ty (int i32))) :ty (ptr (struct Point))) (defer (expr-stmt (builtin-call free (var p) :ty (ptr (struct Point))) :ty (int i32))) (assign-field (var p) :ty (ptr (struct Point)) x (int 10) :ty (int i32)) (assign-field (var p) :ty (ptr (struct Point)) y (int 20) :ty (int i32)) (expr-stmt (builtin-call println (field-access (var p) :ty (ptr (struct Point)) x) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (field-access (var p) :ty (ptr (struct Point)) y) :ty (int i32)) :ty (int i32)) (let q (call ex_make_point (int 100) :ty (int i32) (int 200) :ty (int i32)) :ty (ptr (struct Point))) (defer (expr-stmt (builtin-call free (var q) :ty (ptr (struct Point))) :ty (int i32))) (expr-stmt (call ex_shift (var q) :ty (ptr (struct Point)) (int 5) :ty (int i32) (int 7) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (field-access (var q) :ty (ptr (struct Point)) x) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (field-access (var q) :ty (ptr (struct Point)) y) :ty (int i32)) :ty (int i32))))
