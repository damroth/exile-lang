(tfn main (params ) void (body (expr-stmt (builtin-call println (call ex_use_buffer) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (call ex_string_autodrop) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (call ex_explicit_drop_no_double) :ty (int i32)) :ty (int i32))))
