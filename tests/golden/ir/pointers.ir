;; exile-typed-ir-dump v1 examples/pointers.exl
(tfn ex_shift (params (param p (ptr (struct Point))) (param dx (int i32)) (param dy (int i32))) void (body (assign-field (var p) :ty (ptr (struct Point)) x (binop + (field-access (var p) :ty (ptr (struct Point)) x) :ty (int i32) (var dx) :ty (int i32)) :ty (int i32)) (assign-field (var p) :ty (ptr (struct Point)) y (binop + (field-access (var p) :ty (ptr (struct Point)) y) :ty (int i32) (var dy) :ty (int i32)) :ty (int i32))))
(tfn ex_deref_int (params (param pn (ptr (int i32)))) (int i32) (body (return (deref (var pn) :ty (ptr (int i32))) :ty (int i32))))
(tfn ex_set_via_ptr (params (param pn (ptr (int i32))) (param v (int i32))) void (body (assign-deref (var pn) :ty (ptr (int i32)) (var v) :ty (int i32))))
(tfn ex_swap (params (param a (ptr (int i32))) (param b (ptr (int i32)))) void (body (let tmp (deref (var a) :ty (ptr (int i32))) :ty (int i32)) (assign-deref (var a) :ty (ptr (int i32)) (deref (var b) :ty (ptr (int i32))) :ty (int i32)) (assign-deref (var b) :ty (ptr (int i32)) (var tmp) :ty (int i32))))
(tfn main (params ) void (body (let p (struct-lit Point (field x (int 1) :ty (int i32)) (field y (int 2) :ty (int i32))) :ty (struct Point)) (expr-stmt (call ex_shift (ref (var p) :ty (struct Point)) :ty (ptr (struct Point)) (int 10) :ty (int i32) (int 20) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (field-access (var p) :ty (struct Point) x) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (field-access (var p) :ty (struct Point) y) :ty (int i32)) :ty (int i32)) (let n (int 5) :ty (int i32)) (expr-stmt (builtin-call println (call ex_deref_int (ref (var n) :ty (int i32)) :ty (ptr (int i32))) :ty (int i32)) :ty (int i32)) (expr-stmt (call ex_set_via_ptr (ref (var n) :ty (int i32)) :ty (ptr (int i32)) (int 99) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (var n) :ty (int i32)) :ty (int i32)) (let x (int 1) :ty (int i32)) (let y (int 2) :ty (int i32)) (expr-stmt (call ex_swap (ref (var x) :ty (int i32)) :ty (ptr (int i32)) (ref (var y) :ty (int i32)) :ty (ptr (int i32))) :ty (int i32)) (expr-stmt (builtin-call println (var x) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (var y) :ty (int i32)) :ty (int i32))))
(mono-instances
  (struct HashMap)
  (struct HashMapIter)
  (struct Point)
  (struct Range)
  (struct RangeInclusive)
  (struct Slice)
  (struct Slot)
