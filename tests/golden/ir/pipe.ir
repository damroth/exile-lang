;; exile-typed-ir-dump v1 examples/pipe.exl
(tfn ex_dbl (params (param x (int i32))) (int i32) (body (return (binop + (var x) :ty (int i32) (var x) :ty (int i32)) :ty (int i32))))
(tfn ex_inc (params (param x (int i32))) (int i32) (body (return (binop + (var x) :ty (int i32) (int 1) :ty (int i32)) :ty (int i32))))
(tfn ex_clamp (params (param x (int i32)) (param lo (int i32)) (param hi (int i32))) (int i32) (body (return (if-expr (binop < (var x) :ty (int i32) (var lo) :ty (int i32)) :ty bool (var lo) :ty (int i32) (if-expr (binop > (var x) :ty (int i32) (var hi) :ty (int i32)) :ty bool (var hi) :ty (int i32) (var x) :ty (int i32)) :ty (int i32)) :ty (int i32))))
(tfn main (params ) void (body (expr-stmt (builtin-call println (call ex_dbl (int 5) :ty (int i32)) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (call ex_clamp (int 7) :ty (int i32) (int 0) :ty (int i32) (int 10) :ty (int i32)) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (call ex_clamp (int 42) :ty (int i32) (int 0) :ty (int i32) (int 10) :ty (int i32)) :ty (int i32)) :ty (int i32)) (let r (call ex_dbl (call ex_inc (call ex_dbl (int 3) :ty (int i32)) :ty (int i32)) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (var r) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (binop + (int 2) :ty (int i32) (call ex_dbl (int 3) :ty (int i32)) :ty (int i32)) :ty (int i32)) :ty (int i32))))
