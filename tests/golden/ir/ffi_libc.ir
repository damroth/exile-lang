;; exile-typed-ir-dump v1 examples/ffi_libc.exl
(tfn putchar extern pub (params (param c (c_int signed))) (c_int signed))
(tfn printf extern pub variadic (params (param fmt str)) (c_int signed))
(tfn main (params ) void (body (expr-stmt (call putchar (int 72) :ty (int i32)) :ty (c_int signed)) (expr-stmt (call putchar (int 105) :ty (int i32)) :ty (c_int signed)) (expr-stmt (call putchar (int 33) :ty (int i32)) :ty (c_int signed)) (expr-stmt (call putchar (int 10) :ty (int i32)) :ty (c_int signed)) (expr-stmt (call printf (string "answer: %d\n") :ty str (int 42) :ty (int i32)) :ty (c_int signed)) (expr-stmt (call printf (string "two ints: %d %d\n") :ty str (int 7) :ty (int i32) (int 13) :ty (int i32)) :ty (c_int signed))))
(mono-instances
  (struct HashMap)
  (struct HashMapIter)
  (struct Range)
  (struct RangeInclusive)
  (struct Slice)
  (struct Slot)
  (struct Vec)
  (struct VecIter)
  (enum Option)
  (enum Result)
)
