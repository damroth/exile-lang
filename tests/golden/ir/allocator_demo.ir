(tfn main (params ) void (body (let a (call make_c_allocator) :ty (struct Allocator)) (let p (call Allocator__alloc_i32 (var a) :ty (struct Allocator)) :ty (ptr (int i32))) (if (binop == (var p) :ty (ptr (int i32)) null :ty null-ptr) :ty bool (then (expr-stmt (builtin-call println (neg (int 1) :ty (int i32)) :ty (int i32)) :ty (int i32))) (else (assign-deref (var p) :ty (ptr (int i32)) (int 42) :ty (int i32)) (expr-stmt (builtin-call println (deref (var p) :ty (ptr (int i32))) :ty (int i32)) :ty (int i32)) (expr-stmt (call Allocator__free_i32 (var a) :ty (struct Allocator) (var p) :ty (ptr (int i32))) :ty (int i32)))) (let q (call Allocator__alloc_bool (var a) :ty (struct Allocator)) :ty (ptr bool)) (if (binop != (var q) :ty (ptr bool) null :ty null-ptr) :ty bool (then (assign-deref (var q) :ty (ptr bool) (bool true) :ty bool) (if (deref (var q) :ty (ptr bool)) :ty bool (then (expr-stmt (builtin-call println (int 1) :ty (int i32)) :ty (int i32))) (else (expr-stmt (builtin-call println (int 0) :ty (int i32)) :ty (int i32)))) (expr-stmt (call Allocator__free_bool (var a) :ty (struct Allocator) (var q) :ty (ptr bool)) :ty (int i32))) (else ))))
