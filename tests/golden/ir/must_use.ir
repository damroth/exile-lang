;; exile-typed-ir-dump v1 examples/must_use.exl
(tfn ex_checksum (params (param payload (int i32))) (int i32) (body (return (binop + (binop * (var payload) :ty (int i32) (int 31) :ty (int i32)) :ty (int i32) (int 7) :ty (int i32)) :ty (int i32))))
(tfn ex_try_div (params (param n (int i32)) (param d (int i32))) (enum Result_i32_str) (body (if (binop == (var d) :ty (int i32) (int 0) :ty (int i32)) :ty bool (then (return (enum-lit Result_i32_str::Err tag=1 (field _0 (string "div by zero") :ty str)) :ty (enum Result_i32_str))) (else )) (return (enum-lit Result_i32_str::Ok tag=0 (field _0 (binop / (var n) :ty (int i32) (var d) :ty (int i32)) :ty (int i32))) :ty (enum Result_i32_str))))
(tfn main (params ) void (body (let c (call ex_checksum (int 42) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (var c) :ty (int i32)) :ty (int i32)) (let _ignored (call ex_checksum (int 99) :ty (int i32)) :ty (int i32)) (expr-stmt (match (call ex_try_div (int 10) :ty (int i32) (int 2) :ty (int i32)) :ty (enum Result_i32_str) :enum Result_i32_str (arm (pat-variant Ok tag=0 (field _0 (pat-var q))) (builtin-call println (var q) :ty (int i32)) :ty (int i32)) (arm (pat-variant Err tag=1 (field _0 _)) (builtin-call println (neg (int 1) :ty (int i32)) :ty (int i32)) :ty (int i32))) :ty (int i32))))
(mono-instances
  (struct HashMap)
  (struct HashMapIter)
  (struct Range)
  (struct RangeInclusive)
  (struct Slice)
  (struct Slot)
  (struct Vec)
  (struct VecIter)
