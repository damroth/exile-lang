;; exile-typed-ir-dump v1 examples/ffi_full.exl
(tfn PretendOpenLibrary extern pub (params (param name str) (param version (ext-alias ULONG))) (ptr (ext-struct Library)))
(tfn PretendCloseLibrary extern pub (params (param lib (ptr (ext-struct Library)))) void)
(tfn PretendLibraryID extern pub (params (param lib (ptr (ext-struct Library)))) (ext-alias ULONG))
(tfn main (params ) void (body (let lib (call PretendOpenLibrary (string "pretend.library") :ty str (var PRETEND_VERSION) :ty (ext-alias ULONG)) :ty (ptr (ext-struct Library))) (expr-stmt (builtin-call println (cast (call PretendLibraryID (var lib) :ty (ptr (ext-struct Library))) :ty (ext-alias ULONG) (int i32)) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (cast (var PRETEND_FLAGS) :ty (ext-alias ULONG) (int i32)) :ty (int i32)) :ty (int i32)) (expr-stmt (call PretendCloseLibrary (var lib) :ty (ptr (ext-struct Library))) :ty (int i32))))
(mono-instances
  (struct Enumerate)
  (struct HashMap)
  (struct HashMapIter)
  (struct Map)
  (struct Range)
  (struct RangeInclusive)
  (struct Slice)
  (struct Slot)
  (struct Take)
  (struct Vec)
  (struct VecIter)
  (enum Option)
  (enum Result)
)
