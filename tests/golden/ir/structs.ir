;; exile-typed-ir-dump v1 examples/structs.exl
(tfn ex_make_point (params (param x (int i32)) (param y (int i32))) (struct Point) (body (return (struct-lit Point (field x (var x) :ty (int i32)) (field y (var y) :ty (int i32))) :ty (struct Point))))
(tfn ex_shift (params (param p (struct Point)) (param dx (int i32)) (param dy (int i32))) (struct Point) (body (return (struct-lit Point (field x (binop + (field-access (var p) :ty (struct Point) x) :ty (int i32) (var dx) :ty (int i32)) :ty (int i32)) (field y (binop + (field-access (var p) :ty (struct Point) y) :ty (int i32) (var dy) :ty (int i32)) :ty (int i32))) :ty (struct Point))))
(tfn ex_area (params (param r (struct Rect))) (int i32) (body (return (binop * (field-access (var r) :ty (struct Rect) width) :ty (int i32) (field-access (var r) :ty (struct Rect) height) :ty (int i32)) :ty (int i32))))
(tfn ex_taller (params (param r (struct Rect)) (param by (int i32))) (struct Rect) (body (return (struct-lit Rect (field height (binop + (field-access (var r) :ty (struct Rect) height) :ty (int i32) (var by) :ty (int i32)) :ty (int i32)) (base (var r) :ty (struct Rect))) :ty (struct Rect))))
(tfn main (params ) void (body (let p (call ex_make_point (int 3) :ty (int i32) (int 4) :ty (int i32)) :ty (struct Point)) (expr-stmt (builtin-call println (field-access (var p) :ty (struct Point) x) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (field-access (var p) :ty (struct Point) y) :ty (int i32)) :ty (int i32)) (let q (call ex_shift (var p) :ty (struct Point) (int 10) :ty (int i32) (int 20) :ty (int i32)) :ty (struct Point)) (expr-stmt (builtin-call println (field-access (var q) :ty (struct Point) x) :ty (int i32)) :ty (int i32)) (expr-stmt (builtin-call println (field-access (var q) :ty (struct Point) y) :ty (int i32)) :ty (int i32)) (let r (struct-lit Rect (field origin (call ex_make_point (int 0) :ty (int i32) (int 0) :ty (int i32)) :ty (struct Point)) (field width (int 8) :ty (int i32)) (field height (int 5) :ty (int i32))) :ty (struct Rect)) (expr-stmt (builtin-call println (call ex_area (var r) :ty (struct Rect)) :ty (int i32)) :ty (int i32)) (assign-field (var r) :ty (struct Rect) width (int 10) :ty (int i32)) (expr-stmt (builtin-call println (call ex_area (var r) :ty (struct Rect)) :ty (int i32)) :ty (int i32)) (let r2 (call ex_taller (var r) :ty (struct Rect) (int 3) :ty (int i32)) :ty (struct Rect)) (expr-stmt (builtin-call println (call ex_area (var r2) :ty (struct Rect)) :ty (int i32)) :ty (int i32))))
