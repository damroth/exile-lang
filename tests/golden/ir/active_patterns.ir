(tfn ex_Sign (params (param n (int i32))) (enum Sign) (body (if (binop < (var n) :ty (int i32) (int 0) :ty (int i32)) :ty bool (then (return (enum-lit Sign::Negative tag=0) :ty (enum Sign))) (else )) (if (binop == (var n) :ty (int i32) (int 0) :ty (int i32)) :ty bool (then (return (enum-lit Sign::Zero tag=1) :ty (enum Sign))) (else )) (return (enum-lit Sign::Positive tag=2) :ty (enum Sign))))
(tfn ex_Magnitude (params (param n (int i32))) (enum Magnitude) (body (if (binop < (var n) :ty (int i32) (int 10) :ty (int i32)) :ty bool (then (return (enum-lit Magnitude::Small tag=0) :ty (enum Magnitude))) (else )) (if (binop < (var n) :ty (int i32) (int 100) :ty (int i32)) :ty bool (then (return (enum-lit Magnitude::Medium tag=1) :ty (enum Magnitude))) (else )) (return (enum-lit Magnitude::Large tag=2 (field _0 (var n) :ty (int i32))) :ty (enum Magnitude))))
