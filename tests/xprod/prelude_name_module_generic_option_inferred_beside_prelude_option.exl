// The same beside the prelude's own `Option<int>` (#196).
mod m { pub enum Option<T> { A(T) | B } }
fn main() {
    let o: Option<int> = Option::Some(5); match o { Option::Some(n) => println(n) | Option::None => println(0) }
    let r = m::Option::A(3);
    match r { m::Option::A(n) => println(n) | m::Option::B => println(0) }
}
