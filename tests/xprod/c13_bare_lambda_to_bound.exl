// NOT a parity fixture — a NAMED open divergence, kept for the fabrication scan.
//
// The reference REJECTS this program: a bare non-capturing lambda has fn-ptr
// type, which does not implement the closure bound.  The port accepts it, and
// used to mangle the fn-ptr type to `?`, emitting `ex_apply2_?(...)` — C that
// `cc` had to reject.  The mangler now names it; the missing REJECTION is the
// open half, tracked as its own item.

fn apply2<F: |int|->int>(f: F, n: int) -> int { f(n) }
fn main() {
    let g = |x: int| -> int x + 1;
    println(apply2(g, 5));
    return;
}
