// A module enum named `Range` is the module's enum in a qualified annotation, not the prelude struct (#194).
mod m { pub enum Range { A(int) | B } }
struct Holder { r: m::Range, k: int }
fn main() {
    let h = Holder { r: m::Range::A(5), k: 4 };
    println(h.k);
    match h.r { m::Range::A(n) => println(n) | m::Range::B => println(0) }
}
