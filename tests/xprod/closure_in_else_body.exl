enum E { A(int) | B }
enum W { V(int) }
fn run<F: |int|->int>(f: F, x: int) -> int { f(x) }
fn none_int() -> Option<int> { return Option::Some(1); }
fn main() { let t = 5; let o: Option<int> = Option::None; let Option::Some(k) = o else { println(run(|x: int| -> int x + t, 1)); return; }; println(k); }
