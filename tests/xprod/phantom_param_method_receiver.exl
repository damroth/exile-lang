// A method on an instance whose parameter no field uses (#188).
struct V<T> { n: int }
impl<T> V<T> { pub fn get(*const self) -> int { return self.n; } }
fn mk<T>(k: int) -> V<T> { if k > 0 { return mk(k - 1); } return mk(k + 1); }
fn main() { if false { let v: V<int> = mk(1); println(v.get()); } println(0); }
