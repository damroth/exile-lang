// `impl Fn1 for a::D` and `for b::D`: two targets, each with its own `Output`, used as adapters (#198).
mod a { pub struct D { t: int } }
mod b { pub struct D { t: int } }
impl Fn1 for a::D { type Arg = int; type Output = int; fn call(*const self, x: int) -> int { x + 1 } }
impl Fn1 for b::D { type Arg = int; type Output = bool; fn call(*const self, x: int) -> bool { x > 1 } }
fn main() {
    let al = default_allocator();
    let mut v: Vec<int> = Vec::with_capacity(al, 8 as u32);
    v.push(1); v.push(2); v.push(3);
    let mut s = 0;
    for x in v.iter().map(a::D { t: 0 }) { s = s + x; }
    for x in v.iter().filter(b::D { t: 0 }) { s = s + x; }
    println(s);
}
