// A derived Debug on a struct with no fields renders the name alone, with no
// braces.
pub mod raw { extern fn make_c_allocator() -> Allocator; }

@derive(Debug)
struct Empty { }

fn main() {
    let a = raw::make_c_allocator();
    let mut sb = StringBuilder::with_capacity(a, 8 as u32);
    let e = Empty { };
    e.fmt_debug(&sb);
    let out = String::build(sb);
    println(out.as_str());
}
