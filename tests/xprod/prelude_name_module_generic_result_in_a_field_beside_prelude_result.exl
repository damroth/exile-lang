// The same beside the prelude's own `Result<int, int>` (#196).
mod m { pub enum Result<T> { A(T) | B } }
struct H { r: m::Result<int>, k: int }
fn main() {
    let r: Result<int, int> = Result::Ok(5); match r { Result::Ok(n) => println(n) | Result::Err(e) => println(e) }
    let h = H { r: m::Result::A(3), k: 4 };
    println(h.k);
    match h.r { m::Result::A(n) => println(n) | m::Result::B => println(0) }
}
