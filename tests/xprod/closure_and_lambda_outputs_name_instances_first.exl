// A closure's Output names G<bool>, a lambda's Output G<u8>, a fn's param G<int>: the instances in the reference's order (#231).
struct G<T> { v: T }
fn f(x: G<int>) -> int { return x.v; }
fn main() { let m = 1; let c = |q: int| -> G<bool> G { v: q > m }; let k = |q: int| -> G<u8> G { v: q as u8 }; if c(2).v { println(f(G { v: 3 }) + k(1).v as int); } }
