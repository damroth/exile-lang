// A `Vec<int>` slice is no hoisted instance; this agreed before #187 too.
fn run<F: |int|->int>(f: F, x: int) -> int { f(x) }
fn main() { let t = 5; let a = default_allocator(); let mut v: Vec<int> = Vec::with_capacity(a, 2); v.push(1); let s = v.as_slice(); println(run(|y: int| -> int y + t, s[0])); }
