// Crossing: generic fn x trait bound.  `fn twice<T: Show>` monomorphises to a
// direct call of the concrete type's method.

trait Show { fn show(self) -> int; }
struct Rect { w: int }
impl Show for Rect { fn show(self) -> int { return self.w; } }
fn twice<T: Show>(x: T) -> int { return x.show() * 2; }
fn main() { println(twice(Rect { w: 6 })); return; }
