// The accept side of the fold's boundary: it walks a CHAIN of pointers, not one
// level, so `*const *const Self` is folded and the program stands.
//
// Kept next to the refusals because the rule is a boundary, and a boundary needs
// a witness on both sides of it.
struct S { v: int }

impl S {
    pub fn go(*const self, o: *const *const Self) -> int { let inner: *const S = *o; return inner.v; }
    pub fn plain(*const self, o: *const Self) -> int { return o.v; }
}

fn main() {
    let s: S = S { v: 6 };
    let p: *const S = &s;
    println(s.go(&p));
    println(s.plain(&s));
}
