// A derived Debug renders each field by the type it was written with: an integer
// as decimal, a bool as its word, a str quoted, and anything else through its own
// Debug impl with the same builder.
pub mod raw { extern fn make_c_allocator() -> Allocator; }

@derive(Debug)
struct Inner { a: int }

@derive(Debug)
enum Color { Red | Green(bool) | Blue { s: str } }

@derive(Debug)
struct Rec { i: int, b: bool, s: str, inner: Inner, c: Color }

fn show(r: *const Rec, a: Allocator) {
    let mut sb = StringBuilder::with_capacity(a, 16 as u32);
    r.fmt_debug(&sb);
    let out = String::build(sb);
    println(out.as_str());
}

fn main() {
    let a = raw::make_c_allocator();
    let r = Rec { i: 3, b: true, s: "q", inner: Inner { a: 4 }, c: Color::Green(false) };
    show(&r, a);
    let r2 = Rec { i: 0 - 1, b: false, s: "", inner: Inner { a: 0 }, c: Color::Blue { s: "z" } };
    show(&r2, a);
}
