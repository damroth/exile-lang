// An impl in a module for `a::D` written relative to it names the nested module's type (#198).
mod x { pub trait Get { fn get(*const self) -> int; } pub mod a { pub struct D { t: int } } impl Get for a::D { fn get(*const self) -> int { return self.t + 2; } } }
fn main() { let d = x::a::D { t: 4 }; println(d.get()); }
