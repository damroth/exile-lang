// The accept side of the constructor cell, and the floor for the CHOICE inside it:
// a generic variant built with the RIGHT number of arguments and no annotation must
// still infer its type parameter from the payload.
//
// The refusal fixtures do not pin this. Making inference refuse whenever it cannot
// bind keeps every one of them green while turning this legal program away - which
// is what a floor for a choice is for, as against a floor for a feature.
enum E<T> { P(T) | Q }
struct Pair<A, B> { a: A, b: B }
enum Two<A, B> { Both(A, B) | Neither }

fn main() {
    let e = E::P(5);
    println(match e { E::P(v) => v | E::Q => 0 });

    let t = Two::Both(7, true);
    println(match t { Two::Both(x, y) => if y { x } else { 0 } | Two::Neither => 0 });

    let p: Pair<int, bool> = Pair { a: 1, b: false };
    println(p.a);
}
