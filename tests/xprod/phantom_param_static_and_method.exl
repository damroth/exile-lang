// A static method building it and a method reading it (#188).
struct V<T> { n: int }
impl<T> V<T> { pub fn make(k: int) -> V<T> { if k > 0 { return V::make(k - 1); } return V::make(k + 1); } pub fn get(*const self) -> int { return self.n; } }
fn main() { if false { let v: V<int> = V::make(1); println(v.get()); } println(2); }
