// After the functions, the methods: impl by impl, the written ones and then
// the trait defaults the impl does not write, each return first and its
// parameters right after.
struct A1<T> { a: T }
struct B1<T> { b: T }
struct C1<T> { c: T }
struct D1<T> { d: T }
struct A2<T> { a: T }
struct B2<T> { b: T }
struct C2<T> { c: T }
struct D2<T> { d: T }
struct P { x: int }
struct Q { y: int }
struct R { z: int }
struct S { w: int }
trait Tr { fn d1(*const self, x: A1<int>) -> B1<int> { return B1 { b: x.a + 1 }; } }
impl Tr for P { }
impl Q { pub fn m(*const self, x: C1<int>) -> D1<int> { return D1 { d: x.c + self.y }; } }
impl R { pub fn m2(*const self, x: C2<int>) -> D2<int> { return D2 { d: x.c + self.z }; } }
trait Ts { fn d2(*const self, x: A2<int>) -> B2<int> { return B2 { b: x.a + 2 }; } }
impl Ts for S { }
fn main() {
    let p = P { x: 1 };
    println(p.d1(A1 { a: 1 }).b);
    let q = Q { y: 1 };
    println(q.m(C1 { c: 2 }).d);
    let r = R { z: 1 };
    println(r.m2(C2 { c: 3 }).d);
    let s = S { w: 1 };
    println(s.d2(A2 { a: 4 }).b);
}
