// A module's generic `m::Option<int>` in a field carries its own payload, not the prelude's (#196).
mod m { pub enum Option<T> { A(T) | B } }
struct H { r: m::Option<int>, k: int }
fn main() {
    let h = H { r: m::Option::A(3), k: 4 };
    println(h.k);
    match h.r { m::Option::A(n) => println(n) | m::Option::B => println(0) }
}
