// Every impl is resolved before any signature, so the generic instances a
// trait impl's conformance names are registered - and their C types emitted -
// ahead of a function's written above it.  Within the phase: an associated
// type first, even one of a later impl; then each trait method in the TRAIT's
// order, whatever order the impl writes them in, each parameter in turn and
// the return last.
struct A1<T> { a: T }
struct B1<T> { b: T }
struct C1<T> { c: T }
struct D1<T> { d: T }
struct A2<T> { a: T }
struct B2<T> { b: T }
struct C2<T> { c: T }
struct E1<T> { e: T }
struct P { x: int }
struct Q { y: int }
fn g(x: C1<int>) -> D1<int> { return D1 { d: x.c * 2 }; }
trait Tr {
    fn one(*const self, x: A1<int>, y: C2<int>) -> B1<int>;
    fn two(*const self, x: A2<int>) -> B2<int>;
}
impl Tr for P {
    fn two(*const self, x: A2<int>) -> B2<int> { return B2 { b: x.a + self.x }; }
    fn one(*const self, x: A1<int>, y: C2<int>) -> B1<int> { return B1 { b: x.a + y.c }; }
}
trait Ts { type Out; fn k(*const self) -> int; }
impl Ts for Q { type Out = E1<int>; fn k(*const self) -> int { return self.y; } }
fn main() {
    let p = P { x: 1 };
    println(p.one(A1 { a: 2 }, C2 { c: 3 }).b);
    println(p.two(A2 { a: 4 }).b);
    println(g(C1 { c: 5 }).d);
    let q = Q { y: 6 };
    let e = E1 { e: q.k() };
    println(e.e);
}
