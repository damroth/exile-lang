// A `return` inside a `with` body leaves the function from inside the block the
// binding is scoped to, so the owners live there are released before it, in a
// loop body as in the function - except one a `defer` in the body consumes, which
// the return runs. Each line is a value the program computes; with the allocation
// witness on, the last line counts the blocks never released.
fn fresh(n: int) -> Vec<int> {
    let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32);
    let mut k = 0;
    while k < n { v.push(k); k = k + 1; }
    return v;
}
fn plain(i: int) -> int {
    let v = fresh(1);
    let mut arr = [1, 2];
    with x in arr[0] { if i == 2 { return 9; } *x = *x + 1; }
    return v.length() as int + arr[0];
}
fn loop_local(n: int) -> int {
    let mut arr = [0, 0];
    let mut i = 0;
    while i < n {
        let v = fresh(i);
        with x in arr[1] { *x = *x + v.length() as int; if i == 3 { return *x; } }
        i = i + 1;
    }
    return arr[1];
}
fn take(v: Vec<int>) -> int { return v.length() as int; }
fn defer_consumes(i: int) -> int {
    let v = fresh(4);
    let mut arr = [i, 0];
    with x in arr[0] { defer { let k = take(v); println(k + 100); } if *x == 2 { return 9; } *x = *x + 1; }
    return arr[0];
}
fn main() {
    println(defer_consumes(1)); println(defer_consumes(2));
    println(plain(1)); println(plain(2));
    println(loop_local(3)); println(loop_local(6));
}
