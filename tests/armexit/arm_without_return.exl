// The control: arms that finish, as statements and as values, and a `with` body
// that finishes, next to a live owner - the reference's C, byte for byte. Each
// line is a value the program computes; with the allocation witness on, the last
// line counts the blocks never released.
enum S { A | B }
fn pick(i: int) -> S { if i == 2 { return S::B; } return S::A; }
fn fresh(n: int) -> Vec<int> {
    let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32);
    let mut k = 0;
    while k < n { v.push(k); k = k + 1; }
    return v;
}
fn run(i: int) -> int {
    let v = fresh(2);
    let mut t = 0;
    match pick(i) { S::A => { t = t + 1; } | S::B => { t = t + 2; } }
    let n = match pick(i) { S::A => { 10 } | S::B => { match pick(1) { S::A => { 20 } | S::B => { 30 } } } };
    let mut arr = [0, 0];
    with x in arr[0] { *x = n + t; }
    return arr[0] + v.length() as int;
}
fn main() { println(run(1)); println(run(2)); }
