// A derive on a generic enum: every variant shape, instantiated over int and over
// a derived struct, which the payload compares, hashes and clones through its own
// impls.
@derive(Eq, Hash, Clone)
struct Inner { a: int }

@derive(Eq, Hash, Clone)
enum Opt<T> { Some(T) | Nothing | Pair { a: T, b: int } }

fn main() {
    let x: Opt<int> = Opt::Some(3);
    let y: Opt<int> = Opt::Some(3);
    let z: Opt<int> = Opt::Nothing;
    let w: Opt<int> = Opt::Pair { a: 5, b: 6 };
    if x == y { println(1); } else { println(0); }
    if x == z { println(1); } else { println(0); }
    if w.clone() == w { println(1); } else { println(0); }
    if z.clone().eq(&z) { println(1); } else { println(0); }
    if x.hash() == y.hash() { println(1); } else { println(0); }
    let i: Opt<Inner> = Opt::Pair { a: Inner { a: 2 }, b: 7 };
    let j = i.clone();
    if i == j { println(1); } else { println(0); }
    if i.hash() == j.hash() { println(1); } else { println(0); }
}
