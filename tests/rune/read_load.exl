// Read as a volatile load. `.read()` on a read /
// readwrite rune lowers to `(*p)`, a volatile load the backend may not elide or
// coalesce. Here a status register feeds a control register: `*out = *status`,
// one volatile load into one volatile store.
fn main() {
    rune status: u32 at 0xDFF002 read;
    rune out: u32 at 0xDFF080 write;
    out.write(status.read());
}
