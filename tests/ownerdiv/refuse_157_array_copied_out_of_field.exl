// Copying an array of owners out of a field: the copy and the binding the array was built in would both release its elements.
struct W { a: [String; 2] }
fn main() { let w = W { a: [String::with_str(default_allocator(), "ab"), String::with_str(default_allocator(), "cde")] }; let b = w.a; println(b[1].length() as int); }
