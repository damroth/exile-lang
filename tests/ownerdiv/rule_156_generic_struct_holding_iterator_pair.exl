// A generic struct holding a map iterator's pair at an owning key: refused by the rule; the reference aliases the key and runs clean.
struct W<T> { p: (T, int) }
fn main() { let mut m: HashMap<String, int> = HashMap::with_capacity(default_allocator(), 8); m.insert(String::with_str(default_allocator(), "ab"), 1); for p in m.iter() { let w = W { p: p }; let (k, v) = w.p; println(v); } }
