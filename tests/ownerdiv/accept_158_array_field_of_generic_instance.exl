// An array of a generic instance in a struct's field, built: the reference compares the element type after one side was renamed (#158, found by #235).
struct G<T> { t: T }
struct A { gs: [G<int>; 2] }
fn main() { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 1); v.push(1); let a = A { gs: [G { t: 1 }, G { t: 2 }] }; println(a.gs[1].t + v.length() as int); }
