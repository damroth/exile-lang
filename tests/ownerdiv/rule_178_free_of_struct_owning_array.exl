// free() of a struct that owns an array: refused as for any payload that owns, since the elements would leak; the reference releases them with the literal's binding.
struct B { a: [String; 1] }
fn main() { let al = default_allocator(); let p: own *B = new(al) B { a: [String::with_str(default_allocator(), "ab")] }; println(p.a[0].length() as int); free(al, p); }
