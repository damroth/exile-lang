// An array of owners passed by value moves: the callee releases the elements, the caller does not.
fn take(a: [String; 2]) -> int { return a[0].length() as int + a[1].length() as int; }
fn main() { let a: [String; 2] = [String::with_str(default_allocator(), "ab"), String::with_str(default_allocator(), "cde")]; println(take(a)); }
