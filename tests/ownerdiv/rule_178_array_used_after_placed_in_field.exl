// A local array of owners read after it was placed in a struct field: the struct took it; the reference aliases it and runs clean.
struct W { a: [String; 2] }
fn main() { let a: [String; 2] = [String::with_str(default_allocator(), "ab"), String::with_str(default_allocator(), "cde")]; let w = W { a: a }; println(w.a[1].length() as int + a[0].length() as int); }
