// A let-else binding two owners: the port releases both at scope exit, the reference leaks them.
enum Two { P(String, String) | N }
fn main() { let t = Two::P(String::with_str(default_allocator(), "ab"), String::with_str(default_allocator(), "ab")); let Two::P(a, b) = t else { return; }; println(a.length() as int + b.length() as int); }
