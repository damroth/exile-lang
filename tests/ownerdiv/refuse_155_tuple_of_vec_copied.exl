// A tuple holding a Vec, copied and both copies consumed: the reference frees the storage twice.
fn eatv(v: Vec<int>) { println(v.length() as int); }
fn main() { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); let t = (v, 1); let u = t; let (a, x) = t; let (b, y) = u; eatv(a); eatv(b); }
