// Since #217 the port refuses a root type named like a prelude type where it is
// declared; the text below describes the reference, whose verdict `.reference` pins.
// A user enum named like a prelude struct, bound by a let, mentions no struct: the prelude's `StringBuilder` is not kept (#194).
enum StringBuilder { A(int) | B }
fn main() {
    let e = StringBuilder::A(7);
    match e { StringBuilder::A(n) => println(n) | StringBuilder::B => println(0) }
}
