// A user struct named like Option<*Option<int>>: an instance behind a pointer in source form.
struct Option_ptr_ex_Option_i32 { x: int }
fn main() { let mut v: Option<int> = Option::Some(3); let o: Option<*Option<int>> = Option::Some(&v); match o { Option::Some(_p) => println(1) | Option::None => println(0) } }
