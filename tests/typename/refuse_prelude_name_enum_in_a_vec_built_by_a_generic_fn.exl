// Since #217 the port refuses a root type named like a prelude type where it is
// declared; the text below describes the reference, whose verdict `.reference` pins.
// A `Vec` of a user enum `Arena`, built by a generic function and read through `get`, mentions no struct (#194).
enum Arena { A(int) | B }
fn one<T>(a: Allocator, x: T) -> Vec<T> {
    let mut v: Vec<T> = Vec::with_capacity(a, 8 as u32);
    v.push(x);
    return v;
}
fn main() {
    let v = one(default_allocator(), Arena::A(7));
    match v.get(0 as u32) {
        Option::Some(e) => match e { Arena::A(n) => println(n) | Arena::B => println(0) }
        | Option::None => println(1)
    }
}
