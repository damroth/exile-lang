// Since #217 the port refuses a root type named like a prelude type where it is
// declared; the text below describes the reference, whose verdict `.reference` pins.
// The same enum as a match scrutinee with no let: the lift's temp mentions no struct (#194).
enum StringBuilder { A(int) | B }
fn main() {
    match StringBuilder::A(7) { StringBuilder::A(n) => println(n) | StringBuilder::B => println(0) }
}
