// A match inside an `if` that is itself a statement inside an arm.
fn take(v: Vec<int>) -> u32 { return v.length(); }
enum S { A | B | C }
fn pick(i: int) -> S { if i == 2 { return S::B; } if i == 3 { return S::C; } return S::A; }
fn main() {
    let a = default_allocator();
    let mut v: Vec<int> = Vec::with_capacity(a, 8 as u32);
    v.push(1);
    let c = true;
    let mut n = 0 as u32;
    match pick(1) { S::A => { if c { match pick(2) { S::A => { n = take(v); } | S::B => { } | S::C => { n = take(v); } } } else { n = take(v); } n = n + 0 as u32; } | S::B => { n = take(v); } | S::C => { n = take(v); } }
    println(n as int); }
