// Every arm moves the owner out, so after the match it is consumed on every
// path and nothing is left to free - both compilers accept it and the run
// releases everything it made.
fn take(v: Vec<int>) -> u32 { return v.length(); }
enum S { A | B | C }
fn pick(i: int) -> S { if i == 2 { return S::B; } if i == 3 { return S::C; } return S::A; }
struct Box2 { v: Vec<int>, k: int }
fn main() {
    let a = default_allocator();
    let mut v: Vec<int> = Vec::with_capacity(a, 8 as u32);
    v.push(1);
    let n = match pick(2) { S::A => { take(v) } | S::B => { take(v) + 1 as u32 } | S::C => { take(v) } };
    println(n as int); }
