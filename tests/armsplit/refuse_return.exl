// The split in a match whose value is returned.
fn take(v: Vec<int>) -> u32 { return v.length(); }
enum S { A | B | C }
fn pick(i: int) -> S { if i == 2 { return S::B; } if i == 3 { return S::C; } return S::A; }
struct Box2 { v: Vec<int>, k: int }
fn run() -> u32 {
    let a = default_allocator();
    let mut v: Vec<int> = Vec::with_capacity(a, 8 as u32);
    v.push(1);
    return match pick(2) { S::A => { take(v) } | S::B => { 7 as u32 } | S::C => { take(v) } }; }
fn main() { println(run() as int); }
