// A statement `if` inside a match arm, moving the owner out on one branch only.
fn take(v: Vec<int>) -> u32 { return v.length(); }
enum S { A | B }
fn pick(i: int) -> S { if i == 2 { return S::B; } return S::A; }
fn fresh() -> Vec<int> { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); return v; }
fn main() { let c = false; let v = fresh(); let mut n = 0 as u32; match pick(1) { S::A => { if c { n = n + take(v); } n = n + 1 as u32; } | S::B => { n = n + take(v); } } println(n as int); }
