// A value `if` that moves the owner out on one branch only: after it the owner is in no single state.
fn take(v: Vec<int>) -> u32 { return v.length(); }
enum S { A | B }
fn pick(i: int) -> S { if i == 2 { return S::B; } return S::A; }
fn fresh() -> Vec<int> { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); return v; }
fn main() { let c = false; let v = fresh(); let n = if c { take(v) } else { 5 as u32 }; println(n as int); }
