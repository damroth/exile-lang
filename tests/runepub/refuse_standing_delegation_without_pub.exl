// Without `pub` the owner keeps its register: the standing delegation is refused where it is used.
mod ndk { sigil Blitter { 0xDFF040 .. 0xDFF05A } }

mod gfx   { own Blitter; rune bltsize: u16 at 0xDFF058 write; }
mod sound { pub fn use_lent() { gfx::bltsize.write(64); } }

fn main() { sound::use_lent(); }
