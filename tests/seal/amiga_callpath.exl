// SEAL-SPEC §7(c): the AmigaOS call path, on m68k, under vamos.  Nested, so the
// exec Disable() counter is exercised at depth — and so I-T2 is executed rather
// than asserted.  This proves the SEAM, not the masking: vamos has nothing to
// race (§7d owns that level).
fn run(n: int) -> int {
    let mut acc = 0;
    seal {
        acc = acc + 1;
        seal {
            acc = acc + 10;
            if n == 0 { return acc; }
        }
        acc = acc + 100;
    }
    return acc;
}
fn main() {
    println(run(0));
    println(run(1));
}
