// The sibling arm, which never opened a region at all.
//
// Same leak, uglier face: with the seal's chain left published, an arm that never
// sealed anything still emitted `sys_seal_exit` — reading a token that was never
// assigned. Before the fix this did not even compile (`__seal0 is used
// uninitialized`), and past that it measured `seal-balance -2 misnest 2`.
fn f(n: int) -> int {
    match n {
        0 => { seal { println(1); } return 10; }
        | _o => { return 20; }
    }
}
fn main() { println(f(0)); println(f(1)); }
