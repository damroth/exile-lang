// A `continue` inside a `seal` in a match arm goes round the loop either way.
enum K { Stop | Go }
fn kind(i: int) -> K { if i == 3 { return K::Stop; } return K::Go; }
fn main() {
    let mut n = 0;
    for i in 0..10 {
        match kind(i) { K::Stop => { seal { continue; } } | K::Go => { } }
        n = n + 1;
    }
    println(n);
}
