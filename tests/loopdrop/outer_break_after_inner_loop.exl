// An outer `break` that comes AFTER an inner loop has finished. The walker's loop
// depth has to come back to the outer loop's when the inner one ends; if it did
// not, the outer break would look for owners born in a loop that is already gone
// and release nothing.
fn main() {
    let mut i = 0;
    while i < 3 {
        let mut outer: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32);
        outer.push(i);
        let mut j = 0;
        while j < 2 { j = j + 1; }
        if i == 1 { break; }
        i = i + 1;
    }
    println(i);
}
