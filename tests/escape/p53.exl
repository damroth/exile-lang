// A match on a pattern's binding: the inner binding's buffer is still the pointee's.
enum F { X(Vec<int>) | Y }
enum E { A(F) | B }
fn first(e: *const E, d: *const Vec<int>) -> Slice<int> { return match *e { E::A(f) => match f { F::X(v) => v.as_slice() | F::Y => d.as_slice() } | E::B => d.as_slice() }; }
fn main() { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(4); let d: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); let e = E::A(F::X(v)); println(first(&e, &d)[0]); }
