// Through a mutable pointer, with the other arm a slice of a Vec the caller owns.
enum E { A(Vec<int>) | B }
fn first(e: *E, d: *const Vec<int>) -> Slice<int> { return match *e { E::A(v) => v.as_slice() | E::B => d.as_slice() }; }
fn main() { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(4); let d: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); let mut e = E::A(v); println(first(&e, &d)[0]); }
