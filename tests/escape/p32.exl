// A local's address read back through a slice of a local Vec.
fn keep(out: *Vec<*int>) {
    let a = default_allocator();
    let x = 5;
    let mut local: Vec<*int> = Vec::with_capacity(a, 8 as u32);
    local.push(&x);
    let sl = local.as_slice();
    out.push(sl[0 as u32]);
    return; }
fn main() {
    let a = default_allocator();
    let mut out: Vec<*int> = Vec::with_capacity(a, 8 as u32);
    keep(&out);
    println(out.length() as int); }
