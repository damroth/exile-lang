// The binding's address handed to a function that slices what it points at: its result is the pointee's buffer.
enum E { A(Vec<int>) | B }
fn fwd(p: *const Vec<int>) -> Slice<int> { return p.as_slice(); }
fn first(e: *const E, d: *const Vec<int>) -> Slice<int> { return match *e { E::A(v) => fwd(&v) | E::B => d.as_slice() }; }
fn main() { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(4); let d: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); let e = E::A(v); println(first(&e, &d)[0]); }
