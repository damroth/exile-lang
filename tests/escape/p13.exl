// p13 — a diagnostic on a RENAMED binding.  The two `s` bindings are disjoint
// siblings, so both hoist to the C function top and the compiler mints `s__1`
// for the second.  The invalidation error must quote what the USER wrote (`s`),
// not the minted name — i.e. it must render through the Tfunc's tf_srcnames.
//
// p1..p12 all name bindings the compiler left alone, so every one of them passes
// whether or not srcnames is threaded.  This is the shape that tells them apart.
fn main() {
    let a = default_allocator();
    if 1 as int > 0 as int { let s: int = 1; println(s); }
    let mut v: Vec<int> = Vec::with_capacity(a, 8 as u32);
    v.push(1 as int);
    let s = v.as_slice();
    v.push(2 as int);
    println(s[0 as u32]);
}
