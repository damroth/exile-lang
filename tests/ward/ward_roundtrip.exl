// The runnable ward-over-RAM witness, on BOTH targets.
//
// A ward instance over a real static cell, MIXED-WIDTH fields with a GAP
// between them, written and read back - proving the offsets land AND that a
// u16 field and its neighbours do not collide, by execution. Pattern:
// field -> gap -> field -> field.
//
// THE BACKING IS SIZED EXPLICITLY, and that is the whole point of this file's
// second life. It used to be a single `c_ulong`, which is 8 bytes on a 64-bit
// host and 4 on the m68k target - so a layout reaching offset 6 fit on the host
// and ran off the end of the object on the target. The era measured this file
// on the host only, so nobody asked: cross-compiled and run under the emulator
// it took an invalid-memory-access exception, silently, for two eras.
//
// `[u8; 8]` is the same eight bytes wherever it is compiled, so the layout below
// means the same thing on both. The companion stub defines the object; the
// emission declares it as an incomplete type and only ever takes its address,
// which is why the stub and the emitted C have to agree on the TYPE NAME. That
// coupling is real and `selfhost-ward` asserts it rather than trusting it.

mod raw { extern var SCRATCH: [u8; 8]; }

ward Regs {
    a: u16 at 0x00 readwrite;   // [0, 2)
    // gap [2, 4) — a hole in the overlay, touched by nothing
    b: u16 at 0x04 readwrite;   // [4, 6)
    c: u8  at 0x06 readwrite;   // [6, 7) — a narrower field, right against b
}

fn main() {
    ward regs: Regs at &raw::SCRATCH;
    regs.a.write(43981);              // 0xABCD
    regs.b.write(4660);              // 0x1234
    regs.c.write(255);               // 0xFF
    println(regs.a.read() as i32);   // 43981 — u16, not spilled into the gap
    println(regs.b.read() as i32);   // 4660  — u16, disjoint from a and c
    println(regs.c.read() as i32);   // 255   — u8, right against b, no collision
}
