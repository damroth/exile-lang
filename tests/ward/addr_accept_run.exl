// AC1 + AC3 - a static buffer's address into an `addr` register, and the address
// crossing a function boundary on the way. The overlay sits on RAM so the whole
// idiom RUNS: without an oracle for this ground, a row that only compiles proves
// nothing about what the notation let through.
mod raw { extern var CHIP: [u8; 64]; extern var BUF: [u16; 4] chip writes; }

ward W {
    p:  addr at 0x00 write;
    sz: u16  at 0x08 write;
}

// The address is computed HERE and written THERE: the kind travels with the value,
// which is the row that separated variant A from a use-site operator.
fn where_to() -> *chip u16 { return &raw::BUF[0]; }

fn main() {
    ward w: W at &raw::CHIP;
    let dst = where_to();
    seal {
        w.p.write(dst);
        w.sz.write(4 as u16);
    }
    println(raw::BUF[0] as int + 41);   // 42 - the stub seeds BUF[0] with 1
}
