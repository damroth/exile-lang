// ward Increment 1 — the type + one field spine (WARD-SPEC §9 Inc1).
//
// A ward TYPE (layout only, no base — emits nothing), a local INSTANCE binding a
// base (zero runtime storage, I-W1), and a field access folding to a rune at
// (base + offset), base and offset kept SEPARATE (§6). The field IS a rune (I-W3),
// so it inherits every rune rule — this spine writes and strobes through fields.
ward Custom {
    cop1lc:  u32 at 0x080 write;
    copjmp1: u16 at 0x088 write;
}

fn main() {
    ward custom: Custom at 0xDFF000;
    custom.cop1lc.write(74565);       // *(volatile u32*)(0xDFF000 + 0x080) = 74565
    custom.copjmp1.strobe();          // *(volatile u16*)(0xDFF000 + 0x088) = 0
}
