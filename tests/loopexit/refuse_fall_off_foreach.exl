// A `for` over an iterator ending a function that returns a value: its end is a `break` in the match it lowers to.
fn find(v: *const Vec<int>, k: int) -> int {
    for x in v.iter() { if x == k { return x; } println(x); }
}
fn main() { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); v.push(2); println(find(&v, 2)); println(find(&v, 7)); }
