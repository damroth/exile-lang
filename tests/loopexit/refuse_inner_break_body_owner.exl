// The inner loop's `break` moves out an owner the outer loop's body declared, which that body's end releases.
fn take(v: Vec<int>) -> int { return v.length() as int; }
fn fresh() -> Vec<int> { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); return v; }
fn run(n: int) -> int {
    let mut i = 0;
    while i < n {
        i = i + 1;
        let w = fresh();
        let mut j = 0;
        while j < 3 { j = j + 1; if j == 2 { println(take(w)); break; } }
    }
    return i;
}
fn main() { println(run(1)); println(run(5)); }
