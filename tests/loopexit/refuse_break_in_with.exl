// A `break` in a `with` body after the owner is moved out.
fn take(v: Vec<int>) -> int { return v.length() as int; }
fn fresh() -> Vec<int> { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); return v; }
fn run(n: int) -> int {
    let v = fresh();
    let mut i = 0;
    let mut arr = [0, 0];
    while i < n { i = i + 1; with x in arr[0] { *x = i; if i == 2 { println(take(v)); break; } } }
    return i + arr[0];
}
fn main() { println(run(1)); println(run(5)); }
