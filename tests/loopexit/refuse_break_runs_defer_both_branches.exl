// The defer a `break` runs moves the owner out in both branches of an `if`: counted as a consume, as at a block's close.
fn take(v: Vec<int>) -> int { return v.length() as int; }
fn fresh() -> Vec<int> { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); return v; }
fn run(n: int) -> int {
    let v = fresh();
    let mut i = 0;
    while i < n {
        i = i + 1;
        if i == 2 { defer { if n > 3 { println(take(v)); } else { println(take(v) + 5); } } break; }
    }
    return i;
}
fn main() { println(run(1)); println(run(5)); }
