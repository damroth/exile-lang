// The owner was moved out before the loop, and a `break` gives it a new value first.
fn take(v: Vec<int>) -> int { return v.length() as int; }
fn fresh() -> Vec<int> { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); return v; }
fn run(n: int) -> int {
    let mut v = fresh();
    println(take(v));
    let mut i = 0;
    while i < n { i = i + 1; if i == 1 { v = fresh(); break; } }
    return i;
}
fn main() { println(run(1)); println(run(5)); }
