// A break in a match value assigned to a variable, inside a defer body: refused; the reference stops first, at its block-value rule.
enum E { A | B }
fn main() { let mut i = 0; let mut q = 0; while i < 5 { defer { q = match E::A { E::A => { break; } | E::B => 1 }; } i = i + 1; } println(i); println(q); }
