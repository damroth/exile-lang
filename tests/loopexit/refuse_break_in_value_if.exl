// A `break` in the value `if`'s branch, a match every arm of which moves the owner out and breaks.
fn take(v: Vec<int>) -> int { return v.length() as int; }
fn fresh() -> Vec<int> { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); return v; }
enum S { A | B }
fn pick(i: int) -> S { if i == 2 { return S::B; } return S::A; }
fn run(n: int) -> int {
    let v = fresh();
    let mut i = 0;
    let mut t = 0;
    while i < n {
        i = i + 1;
        let x = if i < 2 { 1 } else { match pick(i) { S::A => { println(take(v)); break; } | S::B => { println(take(v) + 5); break; } } };
        t = t + x;
    }
    return t;
}
fn main() { println(run(1)); println(run(5)); }
