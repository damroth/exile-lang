// The `else` branch moves the owner out and the `then` branch goes round, so the `break` after them leaves with it gone.
fn take(v: Vec<int>) -> int { return v.length() as int; }
fn fresh() -> Vec<int> { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); return v; }
fn run(n: int) -> int {
    let v = fresh();
    let mut i = 0;
    while i < n { i = i + 1; if i < 2 { continue; } else { println(take(v)); } break; }
    return i;
}
fn main() { println(run(1)); println(run(5)); }
