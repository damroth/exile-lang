// Both branches of an inner `if` move the owner out in a defer, which runs at the branch's close - before the `break`.
fn take(v: Vec<int>) -> int { return v.length() as int; }
fn fresh() -> Vec<int> { let mut v: Vec<int> = Vec::with_capacity(default_allocator(), 8 as u32); v.push(1); return v; }
fn run(n: int) -> int {
    let v = fresh();
    let mut i = 0;
    while i < n {
        i = i + 1;
        if i == 2 {
            if n > 3 { defer { println(take(v)); } } else { defer { println(take(v) + 5); } }
            break;
        }
    }
    return i;
}
fn main() { println(run(1)); println(run(5)); }
