    sb.push_str("    }\n");
    sb.push_str("    pub fn insert(*self, k: K, v: V) {\n");
    sb.push_str("        if (self.count + 1 as u32) * 4 as u32 > self.cap * 3 as u32 { self.grow(self.cap * 2 as u32); }\n");
    sb.push_str("        let h: u32 = k.hash();\n");
    sb.push_str("        let sview: Slice<Slot<K, V>> = Slice { ptr: self.slots as *const Slot<K, V>, len: self.cap };\n");
    sb.push_str("        let mut i: u32 = h & (self.cap - 1 as u32);\n");
    sb.push_str("        while true {\n");
    sb.push_str("            let s: Slot<K, V> = sview[i];\n");
    sb.push_str("            if s.state != 1 as u8 {\n");
    sb.push_str("                self.slots[i] = Slot { state: 1 as u8, hash: h, key: k, value: v };\n");
    sb.push_str("                self.count = self.count + 1 as u32;\n");
    sb.push_str("                return;\n");
    sb.push_str("            }\n");
    sb.push_str("            if s.hash == h && k.eq(s.key) {\n");
    sb.push_str("                self.slots[i] = Slot { state: 1 as u8, hash: h, key: k, value: v };\n");
    sb.push_str("                return;\n");
    sb.push_str("            }\n");
    sb.push_str("            i = (i + 1 as u32) & (self.cap - 1 as u32);\n");
    sb.push_str("        }\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn remove(*self, k: K) {\n");
    sb.push_str("        let h: u32 = k.hash();\n");
    sb.push_str("        let sview: Slice<Slot<K, V>> = Slice { ptr: self.slots as *const Slot<K, V>, len: self.cap };\n");
    sb.push_str("        let mut i: u32 = h & (self.cap - 1 as u32);\n");
    sb.push_str("        while true {\n");
    sb.push_str("            let s: Slot<K, V> = sview[i];\n");
    sb.push_str("            if s.state == 0 as u8 { return; }\n");
    sb.push_str("            if s.state == 1 as u8 && s.hash == h {\n");
    sb.push_str("                if k.eq(s.key) {\n");
    sb.push_str("                    self.slots[i] = Slot { state: 2 as u8, hash: s.hash, key: s.key, value: s.value };\n");
    sb.push_str("                    self.count = self.count - 1 as u32;\n");
    sb.push_str("                    return;\n");
    sb.push_str("                }\n");
    sb.push_str("            }\n");
    sb.push_str("            i = (i + 1 as u32) & (self.cap - 1 as u32);\n");
    sb.push_str("        }\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn iter(*const self) -> HashMapIter<K, V> {\n");
    sb.push_str("        return HashMapIter { data: self.slots as *const Slot<K, V>, len: self.cap, pos: 0 as u32 };\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("impl Iterator for HashMapIter<K, V> {\n");
    sb.push_str("    pub fn next(*self) -> Option<(K, V)> {\n");
    sb.push_str("        let sview: Slice<Slot<K, V>> = Slice { ptr: self.data, len: self.len };\n");
    sb.push_str("        while self.pos < self.len {\n");
    sb.push_str("            let s: Slot<K, V> = sview[self.pos];\n");
    sb.push_str("            self.pos = self.pos + 1 as u32;\n");
    sb.push_str("            if s.state == 1 as u8 { return Option::Some((s.key, s.value)); }\n");
    sb.push_str("        }\n");
    sb.push_str("        return Option::None;\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("trait Iterator {\n");
    sb.push_str("    type Item;\n");
    sb.push_str("    fn next(*self) -> Option<Self::Item>;\n");
    sb.push_str("    fn map<F: Fn1>(self, f: F) -> Map<Self, F> { Map { inner: self, f: f } }\n");
    sb.push_str("    fn take(self, n: u32) -> Take<Self> { Take { inner: self, remaining: n } }\n");
    sb.push_str("    fn enumerate(self) -> Enumerate<Self> { Enumerate { inner: self, idx: 0 as u32 } }\n");
    sb.push_str("    fn filter<P: Fn1>(self, p: P) -> Filter<Self, P> { Filter { inner: self, p: p } }\n");
    sb.push_str("    fn fold<Acc, G: Fn2>(self, init: Acc, f: G) -> Acc {\n");
    sb.push_str("        let mut acc: Acc = init;\n");
    sb.push_str("        for v in self { acc = f.call(acc, v); }\n");
    sb.push_str("        acc\n");
    sb.push_str("    }\n");
    sb.push_str("    fn collect(self, a: Allocator) -> Vec<Self::Item> {\n");
    sb.push_str("        let mut out: Vec<Self::Item> = Vec::with_capacity(a, 8 as u32);\n");
    sb.push_str("        for v in self { out.push(v); }\n");
    sb.push_str("        out\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("struct Map<I, F> { inner: I, f: F }\n");
    sb.push_str("impl<I: Iterator, F: Fn1> Iterator for Map<I, F> {\n");
    sb.push_str("    type Item = F::Output;\n");
    sb.push_str("    pub fn next(*self) -> Option<F::Output> {\n");
    sb.push_str("        match self.inner.next() {\n");
    sb.push_str("            Option::Some(v) => Option::Some(self.f.call(v))\n");
    sb.push_str("            | Option::None => Option::None\n");
    sb.push_str("        }\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("struct Take<I> { inner: I, remaining: u32 }\n");
    sb.push_str("impl<I: Iterator> Iterator for Take<I> {\n");
    sb.push_str("    type Item = I::Item;\n");
    sb.push_str("    pub fn next(*self) -> Option<I::Item> {\n");
    sb.push_str("        if self.remaining == 0 as u32 { return Option::None; }\n");
    sb.push_str("        self.remaining = self.remaining - 1 as u32;\n");
    sb.push_str("        self.inner.next()\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("struct Enumerate<I> { inner: I, idx: u32 }\n");
    sb.push_str("impl<I: Iterator> Iterator for Enumerate<I> {\n");
    sb.push_str("    type Item = (u32, I::Item);\n");
    sb.push_str("    pub fn next(*self) -> Option<(u32, I::Item)> {\n");
    sb.push_str("        match self.inner.next() {\n");
    sb.push_str("            Option::Some(v) => {\n");
    sb.push_str("                let i: u32 = self.idx;\n");
    sb.push_str("                self.idx = i + 1 as u32;\n");
    sb.push_str("                let pair: (u32, I::Item) = (i, v);\n");
    sb.push_str("                Option::Some(pair)\n");
    sb.push_str("            }\n");
    sb.push_str("            | Option::None => Option::None\n");
    sb.push_str("        }\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("struct Filter<I, P> { inner: I, p: P }\n");
    sb.push_str("impl<I: Iterator, P: Fn1> Iterator for Filter<I, P> {\n");
    sb.push_str("    type Item = I::Item;\n");
    sb.push_str("    pub fn next(*self) -> Option<I::Item> {\n");
    sb.push_str("        let mut keep: bool = true;\n");
    sb.push_str("        let mut result: Option<I::Item> = Option::None;\n");
    sb.push_str("        while keep {\n");
    sb.push_str("            match self.inner.next() {\n");
    sb.push_str("                Option::Some(v) => {\n");
    sb.push_str("                    if self.p.call(v) { result = Option::Some(v); keep = false; }\n");
    sb.push_str("                }\n");
    sb.push_str("                | Option::None => { keep = false; }\n");
    sb.push_str("            }\n");
    sb.push_str("        }\n");
    sb.push_str("        result\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("struct Arena { buf: own *u8, cap: u32, off: u32, alloc: Allocator }\n");
    sb.push_str("impl Arena {\n");
    sb.push_str("    pub fn with_capacity(a: Allocator, bytes: u32) -> Arena {\n");
    sb.push_str("        let buf: own *u8 = a.alloc_fn(a.state, bytes) as own *u8;\n");
    sb.push_str("        return Arena { buf: buf, cap: bytes, off: 0 as u32, alloc: a };\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn alloc_borrowed<T>(*self) -> *T {\n");
    sb.push_str("        let aligned: u32 = (self.off + 7 as u32) & ~(7 as u32);\n");
    sb.push_str("        let need: u32 = size_of(T) as u32;\n");
    sb.push_str("        if aligned + need > self.cap { return null; }\n");
    sb.push_str("        let p: *u8 = ptr_offset(self.buf, aligned);\n");
    sb.push_str("        self.off = aligned + need;\n");
    sb.push_str("        return p as *T;\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    return str::from_slice(ar, sb.as_slice());
}
// One prelude method, located by its (impl, method) index into the parsed
// prelude items so the drain can re-derive its body (mirrors the GenJob idx
// pattern; no dangling pointer into a match-bound copy).  `pm_order` is the
// declaration-order key: emission lists prelude methods in impl-block order,
// not demand-discovery order (measured against the oracle).
struct PreludeMethod {
    pm_type: str,
    pm_name: str,
    pm_impl_idx: u32,
    pm_meth_idx: u32,
    pm_order: u32,
}
// A parse failure here is an ICE (the prelude is compiler source, not user
// input): report it and abort rather than returning an empty registry, which
// would silently disable the whole prelude.
fn parse_prelude_items(a: Allocator, ar: *Arena) -> Vec<Item> {
    return match tokenize(a, ar, "<prelude>", prelude_source(a, ar)) {
        Result::Ok(toks) => match parse_program(a, ar, toks.as_slice(), toks.length()) {
            Result::Ok(pit) => pit
            | Result::Err(e) => { prelude_ice(a, e); Vec::with_capacity(a, 8 as u32) }
        }
        | Result::Err(e) => { prelude_ice(a, e); Vec::with_capacity(a, 8 as u32) }
    };
}
fn build_prelude_registry(a: Allocator, items: *const Vec<Item>) -> Vec<PreludeMethod> {
    let mut out: Vec<PreludeMethod> = Vec::with_capacity(a, 16 as u32);
    let sl = items.as_slice();
    let mut ord = 0 as u32;
    let mut i = 0 as u32;
    while i < items.length() {
        match sl[i] {
            Item::Impl(ib) => {
                let ty = path_last(&ib.itarget);
                let msl = ib.iitems.as_slice();
                let mut j = 0 as u32;
                while j < ib.iitems.length() {
                    out.push(PreludeMethod { pm_type: ty, pm_name: msl[j].name, pm_impl_idx: i, pm_meth_idx: j, pm_order: ord });
                    ord = ord + 1 as u32;
                    j = j + 1 as u32;
                }
            }
            // `trait Iterator { fn map(..) { .. } }` — a trait DEFAULT method
            // (body-bearing).  Registered under the trait name; the drain finds
            // it by name when the receiver type has no own entry, and pins Self
            // from the receiver instance.  Body-less signatures are skipped.
            | Item::Trait(td) => {
                let tsl = td.trmethods.as_slice();
                let mut tj = 0 as u32;
                while tj < td.trmethods.length() {
                    if tsl[tj].body.length() > 0 as u32 {
                        out.push(PreludeMethod { pm_type: td.trname, pm_name: tsl[tj].name, pm_impl_idx: i, pm_meth_idx: tj, pm_order: ord });
                        ord = ord + 1 as u32;
                    }
                    tj = tj + 1 as u32;
                }
            }
            // `mod str { fn ... }` — the prelude's free-function module.  Each
            // member registers under pm_type = module name (str); pm_impl_idx is
            // the module item index and pm_meth_idx the fn's position inside it.
            | Item::Module(md) => {
                let mmsl = md.mitems.as_slice();
                let mut mj = 0 as u32;
                while mj < md.mitems.length() {
                    match mmsl[mj] {
                        Item::Function(mf) => {
                            out.push(PreludeMethod { pm_type: md.mname, pm_name: mf.name, pm_impl_idx: i, pm_meth_idx: mj, pm_order: ord });
                            ord = ord + 1 as u32;
                        }
                        | _mo => {}
                    }
                    mj = mj + 1 as u32;
                }
            }
            | _o => {}
        }
        i = i + 1 as u32;
    }
    return out;
}
// Registry index for a prelude method by (type, name), or -1 when the type's
// source is not yet in prelude_source (HashMap / adapters) — the drain skips
// those, leaving them unmaterialized (a link error if actually used, never
// silent-wrong), exactly as before this generic path existed.
fn prelude_reg_find(reg: *const Vec<PreludeMethod>, ty: str, nm: str) -> int {
    let sl = reg.as_slice();
    let mut i = 0 as u32;
    while i < reg.length() {
        if str::eq(sl[i].pm_type, ty) && str::eq(sl[i].pm_name, nm) { return i as int; }
        i = i + 1 as u32;
    }
    return 0 as int - 1 as int;
}
// A trait DEFAULT method (`Iterator::map`) is demanded as `VecIter::map` — the
// receiver type owns no entry, so fall back to the trait's registry entry by
// method name.  Only body-bearing trait methods are registered, so a bare
// signature (`next`) never matches here.
fn prelude_reg_find_default(reg: *const Vec<PreludeMethod>, prelude_items: *const Vec<Item>, nm: str) -> int {
    let sl = reg.as_slice();
    let isl = prelude_items.as_slice();
    let mut i = 0 as u32;
    while i < reg.length() {
        if str::eq(sl[i].pm_name, nm) {
            let is_trait = match isl[sl[i].pm_impl_idx] { Item::Trait(_td) => true | _o => false };
            if is_trait { return i as int; }
        }
        i = i + 1 as u32;
    }
    return 0 as int - 1 as int;
}
// Drop the [pm_type, pm_name] prefix: the tail is the receiver instance path
// used to pin `Self` in a trait default's body.
fn gj_self_path(a: Allocator, jt: *const Vec<str>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let sl = jt.as_slice();
    let mut i = 2 as u32;
    while i < jt.length() { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}

// --- Workstream-B: demand-driven prelude materialization ---
// Reachability scan: does any elaborated function body call the mangled symbol
// `m`?  Mirrors the oracle's `referenced_mangled` BFS; the fixpoint below runs
// it over a growing `funcs` so a prelude body that pulls in another prelude
// method (push_str -> grow) is discovered transitively.
fn args_call_m(args: *const Vec<*const Texpr>, m: str) -> bool {
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < args.length() { if expr_calls_m(sl[i], m) { return true; } i = i + 1 as u32; }
    return false;
}
fn fields_call_m(fields: *const Vec<TexprField>, m: str) -> bool {
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < fields.length() { if expr_calls_m(sl[i].value, m) { return true; } i = i + 1 as u32; }
    return false;
}
fn opt_call_m(o: Option<*const Texpr>, m: str) -> bool {
    return match o { Option::Some(e) => expr_calls_m(e, m) | Option::None => false };
}
fn arms_call_m(arms: *const Vec<TmatchArm>, m: str) -> bool {
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < arms.length() {
        if expr_calls_m(sl[i].tbody, m) { return true; }
        let gh = match sl[i].tguard { Option::Some(gg) => expr_calls_m(gg, m) | Option::None => false };
        if gh { return true; }
        i = i + 1 as u32;
    }
    return false;
}
fn stmts_call_m(stmts: *const Vec<Tstmt>, m: str) -> bool {
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() { if stmt_calls_m(&sl[i], m) { return true; } i = i + 1 as u32; }
    return false;
}
fn stmt_calls_m(s: *const Tstmt, m: str) -> bool {
    return match *s {
        Tstmt::TLet { name, value, decl_ty, pos } => expr_calls_m(value, m)
        | Tstmt::TLetTuple { names, value, pos } => expr_calls_m(value, m)
        | Tstmt::TAssign { path, value, pos } => expr_calls_m(value, m)
        | Tstmt::TAssignField { target, field, value, pos } => expr_calls_m(target, m) || expr_calls_m(value, m)
        | Tstmt::TAssignDeref { target, value, pos } => expr_calls_m(target, m) || expr_calls_m(value, m)
        | Tstmt::TAssignIndex { base, index, value, pos } => expr_calls_m(base, m) || expr_calls_m(index, m) || expr_calls_m(value, m)
        | Tstmt::TReturn { value, pos } => match value { Option::Some(e) => expr_calls_m(e, m) | Option::None => false }
        | Tstmt::TExprStmt(e) => expr_calls_m(e, m)
        | Tstmt::TIf { cond, then_body, else_body } => expr_calls_m(cond, m) || stmts_call_m(&then_body, m) || stmts_call_m(&else_body, m)
        | Tstmt::TWhile { cond, body, post } => expr_calls_m(cond, m) || stmts_call_m(&body, m) || stmts_call_m(&post, m)
        | Tstmt::TDefer { body, pos } => stmts_call_m(&body, m)
        | _leaf => false
    };
}
fn expr_calls_m(te: *const Texpr, m: str) -> bool {
    return match te.e {
        TexprNode::TCall { mangled, args } => str::eq(mangled, m) || args_call_m(&args, m)
        | TexprNode::TBuiltinCall { name, args } => args_call_m(&args, m)
        | TexprNode::TIndirectCall { fn_expr, args } => expr_calls_m(fn_expr, m) || args_call_m(&args, m)
        | TexprNode::TNeg(s) => expr_calls_m(s, m)
        | TexprNode::TBitNot(s) => expr_calls_m(s, m)
        | TexprNode::TNot(s) => expr_calls_m(s, m)
        | TexprNode::TRef(s) => expr_calls_m(s, m)
        | TexprNode::TDeref(s) => expr_calls_m(s, m)
        | TexprNode::TCast(s, ann) => expr_calls_m(s, m)
        | TexprNode::TBinOp(op, l, r) => expr_calls_m(l, m) || expr_calls_m(r, m)
        | TexprNode::TFieldAccess { target, field } => expr_calls_m(target, m)
        | TexprNode::TIndex { base, index } => expr_calls_m(base, m) || expr_calls_m(index, m)
        | TexprNode::TTupleLit(es) => args_call_m(&es, m)
        | TexprNode::TArrayLit(es) => args_call_m(&es, m)
        | TexprNode::TArrayRepeat { value, count } => expr_calls_m(value, m)
        | TexprNode::TIfExpr { cond, then_val, else_val } => expr_calls_m(cond, m) || expr_calls_m(then_val, m) || expr_calls_m(else_val, m)
        | TexprNode::TMatch { scrutinee, ename_path, arms } => expr_calls_m(scrutinee, m) || arms_call_m(&arms, m)
        | TexprNode::TBlock { stmts, trailing } => stmts_call_m(&stmts, m) || opt_call_m(trailing, m)
        | TexprNode::TNew { sname_path, fields, base, alloc } => fields_call_m(&fields, m) || opt_call_m(base, m) || opt_call_m(alloc, m)
        | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => fields_call_m(&args, m) || opt_call_m(alloc, m)
        | TexprNode::TStructLit { sname_path, fields, base } => fields_call_m(&fields, m) || opt_call_m(base, m)
        | TexprNode::TEnumLit { ename_path, variant, tag, args } => fields_call_m(&args, m)
        | _leaf => false
    };
}
fn funcs_call_m(funcs: *const Vec<Tfunc>, m: str) -> bool {
    let sl = funcs.as_slice();
    let mut i = 0 as u32;
    while i < funcs.length() { if stmts_call_m(&sl[i].tf_body, m) { return true; } i = i + 1 as u32; }
    return false;
}
fn pm_mangle(a: Allocator, ar: *Arena, ty: str, nm: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(ty); sb.push_str("__"); sb.push_str(nm);
    return str::from_slice(ar, sb.as_slice());
}
// Elaborate every demanded prelude method body into `funcs` (reachability
// fixpoint: a materialized body's own calls may demand further prelude
// methods).  Bodies come from the parsed prelude items via
// `elaborate_method_instance`; the type is already registered by the hand-
// registration (the reason it was demanded), so the body typechecks.
// Source-AST scan: does the prelude method body call `self.<nm>(...)`?  Used
// for transitive demand discovery WITHOUT elaborating (elaborating twice would
// double-register footer types and drift gensym counters).  Under-approx (a
// missed form) surfaces as a missing body at link time, never silently wrong.
fn is_self_recv(e: *const Expr) -> bool {
    return match *e { Expr::Var(n, _p) => str::eq(n, "self") | _o => false };
}
// The scall family scans a source body for a demanded call.  `pm` selects the
// mode: pm == "" matches a `self.<nm>(...)` method call (same-type transitive);
// pm != "" matches a `pm::<nm>(...)` two-segment path call (cross-type, e.g.
// String::eq's body calling `str::eq`, str::eq's calling `str::as_bytes`).
fn scall_args(args: *const Vec<*const Expr>, nm: str, pm: str) -> bool {
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < args.length() { if scall_e(sl[i], nm, pm) { return true; } i = i + 1 as u32; }
    return false;
}
fn scall_fields(fields: *const Vec<Field>, nm: str, pm: str) -> bool {
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < fields.length() { if scall_e(sl[i].value, nm, pm) { return true; } i = i + 1 as u32; }
    return false;
}
fn scall_opt_body(o: Option<Vec<Stmt>>, nm: str, pm: str) -> bool {
    return match o { Option::Some(b) => body_calls_self(&b, nm, pm) | Option::None => false };
}
fn scall_e(e: *const Expr, nm: str, pm: str) -> bool {
    return match *e {
        Expr::MethodCall { receiver, name, args, pos } => (str::eq(pm, "") && str::eq(name, nm) && is_self_recv(receiver)) || scall_e(receiver, nm, pm) || scall_args(&args, nm, pm)
        | Expr::Call { callee, args, pos } => (!str::eq(pm, "") && callee.length() == 2 as u32 && str::eq(callee.as_slice()[0 as u32], pm) && str::eq(callee.as_slice()[1 as u32], nm)) || scall_args(&args, nm, pm)
        | Expr::BinOp(op, l, r, pos) => scall_e(l, nm, pm) || scall_e(r, nm, pm)
        | Expr::Neg(x, pos) => scall_e(x, nm, pm)
        | Expr::BitNot(x, pos) => scall_e(x, nm, pm)
        | Expr::Not(x, pos) => scall_e(x, nm, pm)
        | Expr::Ref(x, pos) => scall_e(x, nm, pm)
        | Expr::Deref(x, pos) => scall_e(x, nm, pm)
        | Expr::Cast(x, ann, pos) => scall_e(x, nm, pm)
        | Expr::FieldAccess(x, f, pos) => scall_e(x, nm, pm)
        | Expr::Index { base, index, pos } => scall_e(base, nm, pm) || scall_e(index, nm, pm)
        | Expr::If { cond, then_blk, else_blk } => scall_e(cond, nm, pm) || body_calls_self(&then_blk, nm, pm) || scall_opt_body(else_blk, nm, pm)
        | Expr::Block(stmts, pos) => body_calls_self(&stmts, nm, pm)
        | Expr::StructLit { tname, fields, base, pos } => scall_fields(&fields, nm, pm)
        | Expr::TupleLit(es, pos) => scall_args(&es, nm, pm)
        | Expr::ArrayLit(es, pos) => scall_args(&es, nm, pm)
        | Expr::ArrayRepeat { value, count, pos } => scall_e(value, nm, pm) || scall_e(count, nm, pm)
        | _leaf => false
    };
}
fn scall_stmt(s: *const Stmt, nm: str, pm: str) -> bool {
    return match *s {
        Stmt::Let { name, value, ty_ann, is_mut, pos } => scall_e(value, nm, pm)
        | Stmt::LetTuple { names, value, is_mut, pos } => scall_e(value, nm, pm)
        | Stmt::Assign { path, value, pos } => scall_e(value, nm, pm)
        | Stmt::AssignField { target, field, value, pos } => scall_e(target, nm, pm) || scall_e(value, nm, pm)
        | Stmt::AssignIndex { base, index, value, pos } => scall_e(base, nm, pm) || scall_e(index, nm, pm) || scall_e(value, nm, pm)
        | Stmt::AssignDeref { target, value, pos } => scall_e(target, nm, pm) || scall_e(value, nm, pm)
        | Stmt::Return(o, pos) => match o { Option::Some(e) => scall_e(e, nm, pm) | Option::None => false }
        | Stmt::ExprStmt(e) => scall_e(e, nm, pm)
        | Stmt::Tail(e) => scall_e(e, nm, pm)
        | Stmt::While { cond, body } => scall_e(cond, nm, pm) || body_calls_self(&body, nm, pm)
        | Stmt::For { iter_var, range, body, pos } => scall_e(range, nm, pm) || body_calls_self(&body, nm, pm)
        | Stmt::Defer { body, pos } => body_calls_self(&body, nm, pm)
        | _leaf => false
    };
}
fn body_calls_self(body: *const Vec<Stmt>, nm: str, pm: str) -> bool {
    let sl = body.as_slice();
    let mut i = 0 as u32;
    while i < body.length() { if scall_stmt(&sl[i], nm, pm) { return true; } i = i + 1 as u32; }
    return false;
}
fn has_u32(v: *const Vec<u32>, x: u32) -> bool {
    let sl = v.as_slice();
    let mut i = 0 as u32;
    while i < v.length() { if sl[i] == x { return true; } i = i + 1 as u32; }
    return false;
}
// Scan the source body of registry entry (impl_idx, meth_idx) for a call —
// handles both impl methods and `mod str` free functions.
fn prelude_func_calls(prelude_items: *const Vec<Item>, impl_idx: u32, meth_idx: u32, nm: str, pm: str) -> bool {
    let sl = prelude_items.as_slice();
    return match sl[impl_idx] {
        Item::Impl(ib) => body_calls_self(&ib.iitems.as_slice()[meth_idx].body, nm, pm)
        | Item::Module(md) => match md.mitems.as_slice()[meth_idx] { Item::Function(mf) => body_calls_self(&mf.body, nm, pm) | _o => false }
        | _o => false
    };
}
// Any already-demanded method of type `t` whose source body calls `self.nm(...)`.
fn demanded_calls(reg: *const Vec<PreludeMethod>, demset: *const Vec<u32>, prelude_items: *const Vec<Item>, t: str, nm: str) -> bool {
    let rsl = reg.as_slice();
    let mut j = 0 as u32;
    while j < reg.length() {
        if has_u32(demset, j) && str::eq(rsl[j].pm_type, t) {
            if prelude_func_calls(prelude_items, rsl[j].pm_impl_idx, rsl[j].pm_meth_idx, nm, "") { return true; }
        }
        j = j + 1 as u32;
    }
    return false;
}
// Any already-demanded method (ANY type) whose source body calls `m::nm(...)` —
// the cross-type transitive path for `mod str` free functions (String::eq calls
// str::eq; str::eq calls str::as_bytes).
fn demanded_path_calls(reg: *const Vec<PreludeMethod>, demset: *const Vec<u32>, prelude_items: *const Vec<Item>, m: str, nm: str) -> bool {
    let rsl = reg.as_slice();
    let mut j = 0 as u32;
    while j < reg.length() {
        if has_u32(demset, j) {
            if prelude_func_calls(prelude_items, rsl[j].pm_impl_idx, rsl[j].pm_meth_idx, nm, m) { return true; }
        }
        j = j + 1 as u32;
    }
    return false;
}
// Is the registry entry a `mod` free function (str::*), not an impl method?
// Module free-fns route to `pfree` (emitted before user free-fns).
fn is_module_entry(prelude_items: *const Vec<Item>, impl_idx: u32) -> bool {
    let sl = prelude_items.as_slice();
    return match sl[impl_idx] { Item::Module(_md) => true | _o => false };
}
fn prelude_materialize(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx,
                       prelude_items: *const Vec<Item>, reg: *const Vec<PreludeMethod>, pmeth: *Vec<Tfunc>, pfree: *Vec<Tfunc>, funcs: *const Vec<Tfunc>) {
    let rsl = reg.as_slice();
    let n = reg.length();
    // Phase 1: discover the demanded set (a method is demanded if a user body
    // calls its mangled name, or a demanded same-type method's SOURCE calls it).
    let mut demset: Vec<u32> = Vec::with_capacity(a, n + 1 as u32);
    let mut progress = true;
    while progress {
        progress = false;
        let mut i = 0 as u32;
        while i < n {
            if !has_u32(&demset, i) {
                let mm = pm_mangle(a, ar, rsl[i].pm_type, rsl[i].pm_name);
                let is_mod = is_module_entry(prelude_items, rsl[i].pm_impl_idx);
                let d = funcs_call_m(funcs, mm)
                        || demanded_calls(reg, &demset, prelude_items, rsl[i].pm_type, rsl[i].pm_name)
                        || (is_mod && demanded_path_calls(reg, &demset, prelude_items, rsl[i].pm_type, rsl[i].pm_name));
                if d { demset.push(i); progress = true; }
            }
            i = i + 1 as u32;
        }
    }
    // Phase 2: materialize demanded methods in registry (= declaration) order.
    let mut mi = 0 as u32;
    while mi < n {
        if has_u32(&demset, mi) {
            let mm2 = pm_mangle(a, ar, rsl[mi].pm_type, rsl[mi].pm_name);
            let mut binds: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
            let tgt: Vec<str> = single_str(a, rsl[mi].pm_type);
            if is_module_entry(prelude_items, rsl[mi].pm_impl_idx) {
                elaborate_method_instance(a, ar, g, gensym, idx, prelude_items, rsl[mi].pm_impl_idx, rsl[mi].pm_meth_idx, &binds, mm2, &tgt, pfree);
            } else {
                // Prelude non-generic impl methods emit at the HEAD of the impl
                // section (measured: main, StringBuilder__*, then user impls).
                elaborate_method_instance(a, ar, g, gensym, idx, prelude_items, rsl[mi].pm_impl_idx, rsl[mi].pm_meth_idx, &binds, mm2, &tgt, pmeth);
            }
        }
        mi = mi + 1 as u32;
    }
}


// ===== sys seam extern decls =====
//
// The oracle declares `mod sys { extern fn sys_* }` in its prepended prelude, so
// the referenced ones emit as extern fwd-decls in the prelude free-fn section —
// measured: str__* , then extern sys_*, then Arena__* .  The port used to
// hard-code the sys_alloc / sys_free pair at the head of the fwd-decl block
// (LVII), which put them in the wrong place and missed read/open/close entirely.
// Build them as real extern Tfuncs, demand-driven, appended to pfree: position
// and completeness then fall out of the same mechanism as everything else.
fn sys_extern_tfunc(a: Allocator, ar: *Arena, name: str, pnames: Vec<str>, ptys: Vec<*const Typ>,
                    ret: Option<*const Typ>) -> Tfunc {
    let no_ann: Option<*const TypeAnn> = Option::None;
    let no_str: Option<str> = Option::None;
    let no_pos: Option<Pos> = Option::None;
    let mut params: Vec<Param> = Vec::with_capacity(a, 8 as u32);
    let nsl = pnames.as_slice();
    let mut i = 0 as u32;
    while i < pnames.length() {
        params.push(Param { pname: nsl[i], pty: ann_struct(a, ar, "c_void"), is_mut: false, preg: no_str });
        i = i + 1 as u32;
    }
    let tp0: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let tb0: Vec<TraitBound> = Vec::with_capacity(a, 8 as u32);
    let bd0: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    let f = Func { name: name, c_name: name, tparams: tp0, tbounds: tb0, params: params,
                   ret_ty: no_ann, body: bd0, is_pub: true, is_extern: true, is_variadic: false,
                   amiga_lib: no_str, tier_hint: no_str, must_use: false, escapes_hatch: false,
                   pos: Pos { line: 0 as int, col: 0 as int, file: "<prelude>" } };
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(name);
    let body0: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let lets0: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    return Tfunc { tf_path: path, tf_func: f, tf_mangled: name, tf_param_tys: ptys,
                   tf_ret_ty: ret, tf_body: body0, tf_lets: lets0, tf_origin_pos: no_pos };
}
fn sys_p2(a: Allocator, n1: str, n2: str) -> Vec<str> {
    let mut v: Vec<str> = Vec::with_capacity(a, 8 as u32);
    v.push(n1); v.push(n2);
    return v;
}
fn sys_p3(a: Allocator, n1: str, n2: str, n3: str) -> Vec<str> {
    let mut v: Vec<str> = Vec::with_capacity(a, 8 as u32);
    v.push(n1); v.push(n2); v.push(n3);
    return v;
}
fn sys_t2(a: Allocator, t1: *const Typ, t2: *const Typ) -> Vec<*const Typ> {
    let mut v: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    v.push(t1); v.push(t2);
    return v;
}
fn sys_t3(a: Allocator, t1: *const Typ, t2: *const Typ, t3: *const Typ) -> Vec<*const Typ> {
    let mut v: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    v.push(t1); v.push(t2); v.push(t3);
    return v;
}
// A sys fn is emitted when a body calls it; `default_allocator()` lowers to a
// helper whose body wires sys_alloc / sys_free, so it counts as a reference.
fn sys_referenced(funcs: *const Vec<Tfunc>, pfree: *const Vec<Tfunc>, pmeth: *const Vec<Tfunc>,
                  name: str, uses_da: bool) -> bool {
    if uses_da && (str::eq(name, "sys_alloc") || str::eq(name, "sys_free")) { return true; }
    return funcs_call_m(funcs, name) || funcs_call_m(pfree, name) || funcs_call_m(pmeth, name);
}
// Append the referenced sys externs, in `mod sys` declaration order, to pfree.
fn append_sys_externs(a: Allocator, ar: *Arena, funcs: *const Vec<Tfunc>, pmeth: *const Vec<Tfunc>,
                      uses_da: bool, pfree: *Vec<Tfunc>) {
    let cvp = ty_node(ar, Typ::TPtr(ty_node(ar, Typ::TCVoid)));
    let culong = ty_node(ar, Typ::TCLong { is_signed: false });
    let clong = ty_node(ar, Typ::TCLong { is_signed: true });
    let cint = ty_node(ar, Typ::TCInt { is_signed: true });
    let cucharc = ty_node(ar, Typ::TConstPtr(ty_node(ar, Typ::TCUChar)));
    let cucharp = ty_node(ar, Typ::TPtr(ty_node(ar, Typ::TCUChar)));
    let ccharc = ty_node(ar, Typ::TConstPtr(ty_node(ar, Typ::TCChar)));
    let f64t = ty_node(ar, Typ::TFloat(FloatWidth::F64));
    let novoid: Option<*const Typ> = Option::None;
    if sys_referenced(funcs, pfree, pmeth, "sys_alloc", uses_da) {
        pfree.push(sys_extern_tfunc(a, ar, "sys_alloc", sys_p2(a, "state", "n"), sys_t2(a, cvp, culong), Option::Some(cvp)));
    }
    if sys_referenced(funcs, pfree, pmeth, "sys_free", uses_da) {
        pfree.push(sys_extern_tfunc(a, ar, "sys_free", sys_p3(a, "state", "p", "n"), sys_t3(a, cvp, cvp, culong), novoid));
    }
    if sys_referenced(funcs, pfree, pmeth, "sys_write", uses_da) {
        pfree.push(sys_extern_tfunc(a, ar, "sys_write", sys_p3(a, "fd", "buf", "n"), sys_t3(a, cint, cucharc, culong), Option::Some(clong)));
    }
    if sys_referenced(funcs, pfree, pmeth, "sys_read", uses_da) {
        pfree.push(sys_extern_tfunc(a, ar, "sys_read", sys_p3(a, "fd", "buf", "n"), sys_t3(a, cint, cucharp, culong), Option::Some(clong)));
    }
    if sys_referenced(funcs, pfree, pmeth, "sys_open", uses_da) {
        pfree.push(sys_extern_tfunc(a, ar, "sys_open", sys_p2(a, "path", "flags"), sys_t2(a, ccharc, cint), Option::Some(cint)));
    }
    if sys_referenced(funcs, pfree, pmeth, "sys_close", uses_da) {
        let mut p1: Vec<str> = Vec::with_capacity(a, 8 as u32);
        p1.push("fd");
        let mut t1: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
        t1.push(cint);
        pfree.push(sys_extern_tfunc(a, ar, "sys_close", p1, t1, Option::Some(cint)));
    }
    if sys_referenced(funcs, pfree, pmeth, "sys_fmt_f64", uses_da) {
        pfree.push(sys_extern_tfunc(a, ar, "sys_fmt_f64", sys_p3(a, "f", "is32", "buf"), sys_t3(a, f64t, cint, cucharp), Option::Some(culong)));
    }
    return;
}

// Raise a diagnostic.  First one wins: later sites see the latch already set and
// leave it alone, so the error reported is the one the reference implementation
// would have raised first (the traversal order is the same).
fn tc_fail(ar: *Arena, sc: *const TyScope, pos: Pos, msg: str) {
    match *sc.sc_err {
        Option::Some(_e) => { }
        | Option::None => { *sc.sc_err = Option::Some(mk_err(ar, pos, msg)); }
    }
    return;
}
fn rebase_srcnames(sc: *const TyScope) {
    *sc.sc_srcbase = sc.sc_srcnames.length();
    return;
}
// Seed the binding registry for one function: its params, tagged by mutability.
// `let mut` bindings register as they elaborate.
fn rebase_binds(sc: *const TyScope, params: *const Vec<Param>) {
    *sc.sc_bindbase = sc.sc_binds.length();
    let sl = params.as_slice();
    let mut i = 0 as u32;
    while i < params.length() {
        let tag = if sl[i].is_mut { "P" } else { "p" };
        sc.sc_binds.push(StrPair { a: sl[i].pname, b: tag });
        i = i + 1 as u32;
    }
    return;
}
fn note_let_mut(sc: *const TyScope, n: str) {
    sc.sc_binds.push(StrPair { a: n, b: "m" });
    return;
}
fn note_let_muts(sc: *const TyScope, names: *const Vec<str>) {
    let sl = names.as_slice();
    let mut i = 0 as u32;
    while i < names.length() { note_let_mut(sc, sl[i]); i = i + 1 as u32; }
    return;
}
// `cannot <what> immutable 'x' — declare it with `let mut`[ (or mark the parameter
// `mut`)]`.  The name is rendered as the USER wrote it: the scope pass may have
// minted `v__1`, and an error naming that is a bug in the compiler, not a hint.
fn require_mut(a: Allocator, ar: *Arena, sc: *const TyScope, name: str, what: str, pos: Pos) {
    let tag = bind_tag(sc, name);
    if str::eq(tag, "P") { return; }
    if str::eq(tag, "m") { return; }
    let mut sb = StringBuilder::with_capacity(a, 96 as u32);
    sb.push_str("cannot "); sb.push_str(what);
    sb.push_str(" immutable '"); sb.push_str(src_name(sc, name));
    sb.push_str("' — declare it with `let mut`");
    if str::eq(tag, "p") { sb.push_str(" (or mark the parameter `mut`)"); }
    tc_fail(ar, sc, pos, str::from_slice(ar, sb.as_slice()));
    return;
}
// The local an l-value path roots at: `x` / `x.f` / `x[i]` all root at `x`.
fn assign_root(t: *const Texpr) -> Option<str> {
    let none: Option<str> = Option::None;
    return match t.e {
        TexprNode::TVar(n) => Option::Some(n)
        | TexprNode::TFieldAccess { target, field } => assign_root(target)
        | TexprNode::TIndex { base, index } => assign_root(base)
        | _o => none
    };
}
// Mutating an OWNED value needs a mutable root binding.  THROUGH A POINTER it is
// pointee mutation — governed by the pointer's own constness, not the binding's —
// and the reference leaves that axis ungated (same as `*p = v`).  Without this the
// prelude fails to elaborate: `Vec::push(self: *Vec<T>)` writes `self.ptr[i]`, and
// `self` is not a `mut` param.
fn ty_is_value(t: *const Typ) -> bool {
    return match *t {
        Typ::TPtr(_i) => false
        | Typ::TConstPtr(_i) => false
        | Typ::TOwnPtr(_i) => false
        | _o => true
    };
}
fn require_mut_root(a: Allocator, ar: *Arena, sc: *const TyScope, t: *const Texpr, what: str, pos: Pos) {
    if !ty_is_value(t.ty) { return; }
    match assign_root(t) {
        Option::Some(n) => { require_mut(a, ar, sc, n, what, pos); }
        | Option::None => { }
    }
    return;
}
fn bind_tag(sc: *const TyScope, n: str) -> str {
    let sl = sc.sc_binds.as_slice();
    let mut i = *sc.sc_bindbase;
    while i < sc.sc_binds.length() {
        if str::eq(sl[i].a, n) { return sl[i].b; }
        i = i + 1 as u32;
    }
    return "";
}
fn note_rename(sc: *const TyScope, minted: str, user: str) {
    sc.sc_srcnames.push(StrPair { a: minted, b: user });
    return;
}
// Render a binding name as the USER wrote it.
pub fn src_name(sc: *const TyScope, n: str) -> str {
    let sl = sc.sc_srcnames.as_slice();
    let mut i = *sc.sc_srcbase;
    while i < sc.sc_srcnames.length() {
        if str::eq(sl[i].a, n) { return sl[i].b; }
        i = i + 1 as u32;
    }
    return n;
}
fn err_latched(e: *const Option<*const CompileError>) -> bool {
    return match *e { Option::Some(_x) => true | Option::None => false };
}
fn err_unwrap(ar: *Arena, e: Option<*const CompileError>) -> *const CompileError {
    return match e {
        Option::Some(x) => x
        | Option::None => mk_err(ar, zero_pos(), "internal: no diagnostic latched")
    };
}
fn mk_err(ar: *Arena, pos: Pos, msg: str) -> *const CompileError {
    let n: *CompileError = ar.alloc_borrowed();
    if n == null { arena_oom(); }
    *n = CompileError { pos: pos, msg: msg };
    return n as *const CompileError;
}

pub fn check_program(a: Allocator, ar: *Arena, items: *const Vec<Item>)
        -> Result<Tprogram, *const CompileError> {
    let mut tc_err: Option<*const CompileError> = Option::None;
    let mut tc_srcnames: Vec<StrPair> = Vec::with_capacity(a, 16 as u32);
    let mut tc_srcbase: u32 = 0 as u32;
    let mut tc_binds: Vec<StrPair> = Vec::with_capacity(a, 16 as u32);
    let mut tc_bindbase: u32 = 0 as u32;
    // Parse the source prelude once; the registry is passive until the demand
    // fixpoint (post-drain) materializes the methods a program actually uses.
    let prelude_items: Vec<Item> = parse_prelude_items(a, ar);
    let prelude_reg: Vec<PreludeMethod> = build_prelude_registry(a, &prelude_items);
    // User-declared struct / enum names: signatures resolve them and they
    // join the prelude in the sorted `mono-instances` footer.
    let mut snames: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut enames: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut fstructs: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut fenums: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let top_modpath: Vec<str> = Vec::with_capacity(a, 8 as u32);
    collect_type_names(a, ar, &top_modpath, items, &snames, &enames, &fstructs, &fenums);
    // Type-level `use foo::Bar;` aliases (collected after type names so the
    // `foo::Bar` marker is available to confirm Bar is a declared type).
    let mut taliases: Vec<TypeAlias> = Vec::with_capacity(a, 8 as u32);
    collect_type_aliases(a, ar, items, &snames, &enames, &fstructs, &fenums, &taliases);
    let mut xstructs: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut xaliases: Vec<str> = Vec::with_capacity(a, 8 as u32);
    collect_ext_types(items, &xstructs, &xaliases);
    let mut iconsts: Vec<IntConst> = Vec::with_capacity(a, 8 as u32);
    collect_int_consts(items, &iconsts);
    // Name-scope used to resolve field / signature types (no per-fn tparams,
    // no struct/enum index needed at this stage).
    let empty_tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let empty_sinfo: Vec<StructField> = Vec::with_capacity(a, 8 as u32);
    let empty_etags: Vec<EnumVariantTag> = Vec::with_capacity(a, 8 as u32);
    let empty_efields: Vec<EnumFieldE> = Vec::with_capacity(a, 8 as u32);
    let empty_methods: Vec<MethodInfo> = Vec::with_capacity(a, 8 as u32);
    // Accumulators for generated monomorphic instances (footer); shared by
    // the base scope and every per-fn scope so registration is program-wide.
    let mut mono_structs: Vec<Vec<str>> = Vec::with_capacity(a, 8 as u32);
    let mut mono_sargs: Vec<Vec<*const Typ>> = Vec::with_capacity(a, 8 as u32);
    let mut mono_enums: Vec<Vec<str>> = Vec::with_capacity(a, 8 as u32);
    let mut mono_eargs: Vec<Vec<*const Typ>> = Vec::with_capacity(a, 8 as u32);
    let mut mono_fields: Vec<StructField> = Vec::with_capacity(a, 8 as u32);
    let mut mono_efields: Vec<EnumFieldE> = Vec::with_capacity(a, 8 as u32);
    // Generic-fn registry + instance work-queue + dedup set; `empty_tbinds`
    // is the no-bindings scope used everywhere except inside an instance.
    let empty_tbinds: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
    let mut genfns: Vec<GenFn> = Vec::with_capacity(a, 8 as u32);
    collect_gen_fns(a, ar, items, &genfns);
    let mut genjobs: Vec<GenJob> = Vec::with_capacity(a, 8 as u32);
    let mut geninsts: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut etps: Vec<EnumTP> = Vec::with_capacity(a, 8 as u32);
    collect_enum_tps(a, items, &etps);
    prelude_enum_tps(a, &etps);
    let mut stps: Vec<StructTP> = Vec::with_capacity(a, 8 as u32);
    collect_struct_tps(a, items, &stps);
    prelude_struct_tps(a, &stps);
    let mut assoc_binds: Vec<AssocBind> = Vec::with_capacity(a, 8 as u32);
    collect_assoc_binds(a, items, &assoc_binds);
    register_prelude_assoc(a, ar, &assoc_binds);
    let mut lifted_lambdas: Vec<LiftedLambda> = Vec::with_capacity(a, 8 as u32);
    // Fn parameter-type index (for `own *T` → `*T` arg coercion); populated
    // below once the scope can resolve param types, but referenced by the
    // base scope now (collecting it doesn't read the index back).
    let mut gsigs: Vec<FnSig> = Vec::with_capacity(a, 16 as u32);
    // The collection-phase scope never elaborates a body, so its gensym is a
    // throwaway; the real per-fn counter rides through elaborate_fn.
    let mut gensym_unused: u32 = 0 as u32;
    let base_scope = TyScope { sc_structs: &snames, sc_enums: &enames, sc_tparams: &empty_tp,
                               sc_iconsts: &iconsts, sc_sinfo: &empty_sinfo,
                               sc_etags: &empty_etags, sc_efields: &empty_efields, sc_methods: &empty_methods,
                               sc_mono_structs: &mono_structs, sc_mono_sargs: &mono_sargs, sc_mono_enums: &mono_enums, sc_mono_eargs: &mono_eargs, sc_mono_fields: &mono_fields, sc_mono_efields: &mono_efields,
                               sc_tbinds: &empty_tbinds, sc_genfns: &genfns, sc_genjobs: &genjobs, sc_geninsts: &geninsts, sc_etps: &etps, sc_stps: &stps, sc_assoc: &assoc_binds, sc_lifted: &lifted_lambdas, sc_gensym: &gensym_unused, sc_modpath: &empty_tp, sc_ret: none_ty() , sc_self: none_ty() , sc_gsigs: &gsigs , sc_xstructs: &xstructs, sc_xaliases: &xaliases, sc_taliases: &taliases, sc_err: &tc_err, sc_srcnames: &tc_srcnames, sc_srcbase: &tc_srcbase, sc_binds: &tc_binds, sc_bindbase: &tc_bindbase, sc_is_main: false };
    // Global fn / const table — return types resolved through the name-scope
    // so a call to a struct-returning fn types as that struct.
    let globals = collect_globals(a, ar, &base_scope, items);
    collect_fn_sigs_into(a, ar, &base_scope, items, &empty_tp, &gsigs);
    register_prelude_sigs(a, ar, &gsigs);
    // Every concrete `impl Iterator for X` eagerly carries its default
    // methods' Self-pinned return types in the footer.
    // The oracle's tp_funcs still holds the eagerly-specialised Iterator trait
    // defaults (`Count__enumerate`) at mentioned-paths time, even though it never
    // emits them — so their Self-pinned return instances survive its DCE.  The
    // port's mirror of that artifact is register_iter_footprints; record the
    // window it registers so the DCE below exempts exactly those instances.
    let fp_start = mono_structs.length();
    register_iter_footprints(a, ar, &base_scope, items, &assoc_binds, false);
    let fp_end = mono_structs.length();
    // Struct field index + enum variant/field index + method index, carried
    // in every fn's body scope so `s.field`, struct/enum literals, variant
    // patterns and method calls type-check.
    let mut sinfo: Vec<StructField> = Vec::with_capacity(a, 8 as u32);
    collect_struct_info(a, ar, &base_scope, &empty_tp, items, &sinfo);
    prelude_struct_info(a, ar, &sinfo);
    // Second field-type resolution with the skeleton in place: a generic
    // struct-field type (`Vec<TypeAlias>`) registers its instance fields into
    // the shared mono-fields table, so a `.length()` receiver's element tparam
    // recovers even before the Vec is first constructed (the throwaway output
    // is discarded — only the instance-field side effect matters).
    let sinfo_scope = scope_with_sinfo(&base_scope, &sinfo);
    let mut sinfo_throwaway: Vec<StructField> = Vec::with_capacity(a, 8 as u32);
    collect_struct_info(a, ar, &sinfo_scope, &empty_tp, items, &sinfo_throwaway);
    register_iter_footprints(a, ar, &sinfo_scope, items, &assoc_binds, true);
    let mut etags: Vec<EnumVariantTag> = Vec::with_capacity(a, 8 as u32);
    let mut efields: Vec<EnumFieldE> = Vec::with_capacity(a, 8 as u32);
    collect_enum_info(a, ar, &base_scope, &top_modpath, items, &etags, &efields);
    prelude_enum_variants(a, ar, &etags, &efields);
    let mut methods: Vec<MethodInfo> = Vec::with_capacity(a, 8 as u32);
    collect_method_info(a, ar, &base_scope, items, &methods);
    collect_trait_default_methods(a, ar, &base_scope, items, &methods);
    register_prelude_methods(a, ar, &methods);
    // A2 capturing closures: synthesise env struct / Fn impl / assoc bindings
    // into the (still mutable) registries; lambda exprs are matched at elab.
    prepass_closures(a, ar, &base_scope, items, &sinfo, &methods, &assoc_binds, &stps, &lifted_lambdas);
    // @derive(Eq/Hash/Clone/Debug): synthesise the per-type methods into the
    // method table + drain queue.
    collect_derives(a, ar, &base_scope, items, &methods, &lifted_lambdas, &gsigs);
    // DR-030 drop synthesis: a `<Struct>__drop` for every own-field struct.
    collect_drops(a, ar, items, &methods, &lifted_lambdas);
    let idx = ProgIdx { pi_snames: &snames, pi_enames: &enames, pi_iconsts: &iconsts,
                        pi_sinfo: &sinfo, pi_etags: &etags, pi_efields: &efields, pi_methods: &methods,
                        pi_mono_structs: &mono_structs, pi_mono_sargs: &mono_sargs, pi_mono_enums: &mono_enums, pi_mono_eargs: &mono_eargs, pi_mono_fields: &mono_fields, pi_mono_efields: &mono_efields,
                        pi_tbinds: &empty_tbinds, pi_genfns: &genfns, pi_genjobs: &genjobs, pi_geninsts: &geninsts, pi_etps: &etps, pi_stps: &stps, pi_assoc: &assoc_binds, pi_lifted: &lifted_lambdas, pi_modpath: &empty_tp, pi_gsigs: &gsigs , pi_xstructs: &xstructs, pi_xaliases: &xaliases, pi_taliases: &taliases, pi_err: &tc_err, pi_srcnames: &tc_srcnames, pi_srcbase: &tc_srcbase, pi_binds: &tc_binds, pi_bindbase: &tc_bindbase };
    // Program-global `for`-loop gensym counter (`__fvK` / `__feK`), reset
    // once per program to match the oracle's `for_gensym := 0`.
    let mut gensym: u32 = 0 as u32;
    let mut funcs: Vec<Tfunc> = Vec::with_capacity(a, 16 as u32);
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        elaborate_item(a, ar, &globals, &gensym, &idx, &sl[i], &funcs);
        i = i + 1 as u32;
    }
    // Boundary: everything pushed so far is a user FREE fn.  tp_pmeth (the
    // prelude non-generic impl methods) is emitted here, ahead of the user impls.
    let free_end: u32 = funcs.length();
    // Second pass: impl methods are flattened after the free functions.
    let empty_mp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut j = 0 as u32;
    while j < n {
        elaborate_impl_item(a, ar, &globals, &gensym, &idx, items, &empty_mp, &sl[j], &funcs);
        j = j + 1 as u32;
    }
    // Drain lifted lambdas / closures BEFORE the generic instances so the
    // `__closure_N__call` / `__lambda_N` fns precede the bounded-generic
    // instances they dispatch into (matching the oracle's emission order).
    // A1 (captureless) re-derive from the stored `Lambda` node; A2 closures
    // elaborate the pre-pass's capture-substituted body under `self + params`.
    let mut li = 0 as u32;
    while li < lifted_lambdas.length() {
        let lls = lifted_lambdas.as_slice();
        if lls[li].ll_kind == 0 as int {
            drain_one_lifted(a, ar, &globals, &gensym, &idx, lls[li].ll_mangled, lls[li].ll_name, lls[li].ll_expr, &funcs);
        } else {
            if lls[li].ll_kind == 3 as int {
                // Drop method: `ll_params` already carries the full `*self`.
                elaborate_lifted(a, ar, &globals, &gensym, &idx, lls[li].ll_mangled, lls[li].ll_name, &lls[li].ll_params, lls[li].ll_ret, lls[li].ll_expr, &funcs, true, zero_pos());
            } else {
                let cps = closure_call_params(a, ar, lls[li].ll_closure, &lls[li].ll_params);
                elaborate_lifted(a, ar, &globals, &gensym, &idx, lls[li].ll_mangled, lls[li].ll_name, &cps, lls[li].ll_ret, lls[li].ll_expr, &funcs, true, lifted_pos(lls[li].ll_kind));
            }
        }
        li = li + 1 as u32;
    }

    // Drain the generic-fn instance queue (jobs may queue further jobs as
    // their bodies elaborate; re-read the length each round and copy each
    // job's bindings out so a queue re-grow can't dangle them).
    let mut k = 0 as u32;
    while k < genjobs.length() {
        let gsl = genjobs.as_slice();
        let jm = gsl[k].gj_mangled;
        let ji = gsl[k].gj_idx;
        let jmeth = gsl[k].gj_meth;
        let jb = copy_tvarbinds(a, &gsl[k].gj_binds);
        // Copy the target out too: elaborating the body may queue more jobs,
        // re-growing `genjobs` and dangling the slice borrow.
        let jt = copy_strs(a, &gsl[k].gj_target);
        let jprelude = gsl[k].gj_prelude;
        if jprelude {
            // Generic prelude instance: re-derive from the source-prelude items
            // via (type, name) = jt.  Demand-order drain matches the oracle's
            // generic emission order; `grow` (transitive from `push`) is queued
            // mid-drain and picked up by the length re-read.
            let jtsl = jt.as_slice();
            let mut ri = prelude_reg_find(&prelude_reg, jtsl[0 as u32], jtsl[1 as u32]);
            if ri < 0 as int { ri = prelude_reg_find_default(&prelude_reg, &prelude_items, jtsl[1 as u32]); }
            if ri >= 0 as int {
                let rsl = prelude_reg.as_slice();
                let self_tgt: Vec<str> = gj_self_path(a, &jt);
                elaborate_method_instance(a, ar, &globals, &gensym, &idx, &prelude_items, rsl[ri as u32].pm_impl_idx, rsl[ri as u32].pm_meth_idx, &jb, jm, &self_tgt, &funcs);
            }
        } else if jmeth < 0 as int {
            elaborate_instance(a, ar, &globals, &gensym, &idx, items, ji, &jb, jm, &funcs);
        } else {
            elaborate_method_instance(a, ar, &globals, &gensym, &idx, items, ji, jmeth as u32, &jb, jm, &jt, &funcs);
        }
        k = k + 1 as u32;
    }

    // Materialize demanded source-prelude method bodies (workstream-B).  Module
    // free-fns (str::*) land in `pfree` (emitted ahead of user free-fns).
    let mut pfree: Vec<Tfunc> = Vec::with_capacity(a, 8 as u32);
    let mut pmeth: Vec<Tfunc> = Vec::with_capacity(a, 8 as u32);
    prelude_materialize(a, ar, &globals, &gensym, &idx, &prelude_items, &prelude_reg, &pmeth, &pfree, &funcs);
    // Same DCE exemption as the footprint window: these are ghosts of DCE'd
    // prelude methods, so no surviving fn mentions them.
    let sv_start = mono_structs.length();
    register_vec_slice_views(a, ar, &sinfo_scope, &mono_structs, &mono_sargs);
    let sv_end = mono_structs.length();

    let mut structs = prelude_struct_index(a);
    let mut enums = prelude_enum_index(a);
    // Non-generic prelude structs (Allocator / StringBuilder / String / Arena)
    // are TOP-LEVEL declarations in the oracle, emitted ahead of user structs.
    // Push them here, by declaration rank, before the user structs.
    let mn = mono_structs.length();
    let msl = mono_structs.as_slice();
    let sasl = mono_sargs.as_slice();
    let mut rk = 0 as int;
    while rk < 4 as int {
        let mut mi = 0 as u32;
        while mi < mn {
            if nongeneric_prelude_rank(path_last(&msl[mi])) == rk { push_struct_path(a, &structs, &msl[mi], &mono_fields, &sasl[mi]); }
            mi = mi + 1 as u32;
        }
        rk = rk + 1 as int;
    }
    let sn = fstructs.length();
    let ssl = fstructs.as_slice();
    let mut si = 0 as u32;
    while si < sn { push_struct_name(a, &structs, ssl[si]); si = si + 1 as u32; }
    let en = fenums.length();
    let esl = fenums.as_slice();
    let mut ei = 0 as u32;
    while ei < en { push_enum_name(a, &enums, esl[ei]); ei = ei + 1 as u32; }
    // Mono-instance DCE (see the helper block).  Non-generic prelude structs
    // (rank >= 0) are top-level in the oracle, so they are never pruned.
    let mut mentioned: Vec<Vec<str>> = Vec::with_capacity(a, 32 as u32);
    mention_funcs(a, &funcs, &mentioned);
    mention_funcs(a, &pfree, &mentioned);
    mention_funcs(a, &pmeth, &mentioned);
    let tsl = structs.as_slice();
    let mut ti = 0 as u32;
    while ti < structs.length() { add_path_uniq(a, &mentioned, &tsl[ti].sname_path); ti = ti + 1 as u32; }
    let tel = enums.as_slice();
    let mut tj = 0 as u32;
    while tj < enums.length() { add_path_uniq(a, &mentioned, &tel[tj].ename_path); tj = tj + 1 as u32; }
    let mut mprog = true;
    while mprog {
        let n0 = mentioned.length();
        mention_fields_round(a, &sinfo, &efields, &mentioned);
        mention_fields_round(a, &mono_fields, &mono_efields, &mentioned);
        mprog = mentioned.length() != n0;
    }
    // Generated monomorphic instances.  The non-generic prelude structs
    // (Allocator / StringBuilder / String / Arena) are demand-registered here in
    // use order, but the oracle prepends the whole prelude, so it emits them in
    // DECLARATION order ahead of the true generic mono instances (Slice_u8,
    // Vec_i32, ...).  Reproduce that: pass A pushes the demanded non-generic
    // prelude structs by declaration rank, pass B the rest in registration order.
    // `Slice<u8>` is the str seam's view type: it comes from `mod str`, the FIRST
    // prelude module, so the oracle registers it ahead of every other mono
    // instance.  The port materializes str's ops on demand, i.e. late — hoist it.
    let mut ms = 0 as u32;
    let mut su8_done = false;
    while ms < mn {
        let is_fp0 = (ms >= fp_start && ms < fp_end) || (ms >= sv_start && ms < sv_end);
        if str::eq(path_last(&msl[ms]), "Slice_u8") && !su8_done
           && (is_fp0 || path_in_paths(&mentioned, &msl[ms])) {
            push_struct_path(a, &structs, &msl[ms], &mono_fields, &sasl[ms]);
            su8_done = true;
        }
        ms = ms + 1 as u32;
    }
    let mut mj = 0 as u32;
    while mj < mn {
        let is_footprint = (mj >= fp_start && mj < fp_end) || (mj >= sv_start && mj < sv_end);
        let skip = str::eq(path_last(&msl[mj]), "Slice_u8") && su8_done;
        if !skip && nongeneric_prelude_rank(path_last(&msl[mj])) < 0 as int && (is_footprint || path_in_paths(&mentioned, &msl[mj])) { push_struct_path(a, &structs, &msl[mj], &mono_fields, &sasl[mj]); }
        mj = mj + 1 as u32;
    }
    let men = mono_enums.length();
    let mesl = mono_enums.as_slice();
    let easl = mono_eargs.as_slice();
    let mut mei = 0 as u32;
    while mei < men { if path_in_paths(&mentioned, &mesl[mei]) { push_enum_path(a, &enums, &mesl[mei], &easl[mei]); } mei = mei + 1 as u32; }
    // Backfill field lists for every struct pushed field-less above (prelude
    // + user structs), so downstream field-tree walks (the drop pass) see
    // each struct's `own *T` fields.
    let mut ci = 0 as u32;
    while ci < structs.length() {
        fill_struct_fields(a, ar, &structs, ci, &sinfo, &mono_fields);
        ci = ci + 1 as u32;
    }
    let mut cj = 0 as u32;
    while cj < enums.length() {
        fill_enum_variants(a, &enums, cj, &etags, &efields, &mono_efields);
        cj = cj + 1 as u32;
    }

    let mut dbg_snames: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut dbg_enames: Vec<str> = Vec::with_capacity(a, 8 as u32);
    collect_debug_names(a, ar, items, &dbg_snames, &dbg_enames);
    let mut di = 0 as u32;
    while di < structs.length() { mark_struct_debug(&structs, di, &dbg_snames); di = di + 1 as u32; }
    let mut dj = 0 as u32;
    while dj < enums.length() { mark_enum_debug(&enums, dj, &dbg_enames); dj = dj + 1 as u32; }

    let sdecls: Vec<StructDeclEntry> = Vec::with_capacity(a, 8 as u32);
    let global: Vec<GlobalEntry> = Vec::with_capacity(a, 8 as u32);
    let modules: Vec<ModuleEntry> = Vec::with_capacity(a, 8 as u32);
    let mut cincludes: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut econsts: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let mut evars: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    collect_ffi_decls(a, ar, &sinfo_scope, items, &cincludes, &econsts, &evars);
    let mut consts: Vec<StrPair> = Vec::with_capacity(a, 8 as u32);
    let mut const_vals: Vec<IntConst> = Vec::with_capacity(a, 8 as u32);
    let empty_cpath: Vec<str> = Vec::with_capacity(a, 8 as u32);
    collect_tp_consts(a, ar, items, &empty_cpath, &const_vals, &consts);

    // Footer type collection (codegen support): one post-pass over the checked
    // program gathering distinct tuple / fn-ptr / array shapes + include flags.
    let ftr = collect_footer_types2(a, ar, &funcs, &pmeth, &structs, &enums);
    let tuples = ftr_to_fieldtys(a, &ftr.tup);
    let fnptrs = ftr_to_fieldtys(a, &ftr.fnp);
    let arrays = ftr_to_fieldtys(a, &ftr.arr);
    let uses_heap = any_builtin(&funcs, 0 as int) || any_builtin(&pfree, 0 as int) || any_builtin(&pmeth, 0 as int);
    let uses_default_alloc = any_builtin(&funcs, 1 as int) || any_builtin(&pfree, 1 as int) || any_builtin(&pmeth, 1 as int);
    let uses_string_h = any_builtin(&funcs, 2 as int) || any_builtin(&pfree, 2 as int) || any_builtin(&pmeth, 2 as int);
    // The referenced sys-seam externs close the prelude free-fn section.
    append_sys_externs(a, ar, &funcs, &pmeth, uses_default_alloc, &pfree);

    // A latched diagnostic wins over the elaborated program: the placeholders the
    // failing sites produced are meaningless, and emitting C from them is exactly
    // the silent-miscompile this pass exists to stop.
    if err_latched(&tc_err) { return Result::Err(err_unwrap(ar, tc_err)); }
    return Result::Ok(Tprogram {
        tp_funcs: funcs, tp_pfree: pfree, tp_pmeth: pmeth, tp_free_end: free_end, tp_struct_decls: sdecls, tp_struct_index: structs,
        tp_enum_index: enums, tp_global: global, tp_modules: modules,
        tp_uses_heap: uses_heap, tp_uses_string_h: uses_string_h, tp_uses_default_allocator: uses_default_alloc,
        tp_tuple_types: tuples, tp_fnptr_types: fnptrs, tp_c_includes: cincludes,
        tp_ext_consts: econsts, tp_ext_vars: evars, tp_array_types: arrays, tp_consts: consts,
    });
}
