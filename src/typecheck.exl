// Self-host port — `lib/typecheck.ml` (the type checker / elaborator).
//
// Staged port.  `check_program` lowers the parsed `Vec<Item>` into the
// typed IR (`Tprogram`) that codegen consumes.  This is the critical-path
// module (~12K LOC in the oracle); it is filled in feature by feature,
// verified against `exilc --emit-typed-ir --user-only` byte-for-byte.
//
// SLICE 1 (this file's current reach): function signatures — params and
// return types resolved through `resolve_type_ann` for the primitive /
// pointer type domain — plus the fixed prelude `mono-instances` footprint.
// Bodies are not yet elaborated (emitted empty); a function whose oracle
// body is non-empty therefore lands in the gate's deferred bucket.

use pos::*;
use ast::*;
use ir::*;
use error::*;

// ===== Typ node allocation =====

// `arena_oom()` (the loud exhaustion backstop) lives in `error` and is shared
// across every node allocator — see the comment there.
fn ty_node(ar: *Arena, t: Typ) -> *const Typ {
    let n: *Typ = ar.alloc_borrowed();
    if n == null { arena_oom(); }
    *n = t;
    return n as *const Typ;
}

// ===== Type-annotation resolution (AST `TypeAnn` -> IR `Typ`) =====
//
// SLICE 1: the primitive + pointer domain.  Aggregate / nominal / generic
// forms (struct, tuple, array, fn-ptr, Self) are deferred — they resolve
// to a `TCVoid` placeholder so a fn carrying one simply diverges from the
// oracle and lands in the deferred bucket rather than crashing.

fn has_self_ty(sc: *const TyScope) -> bool {
    return match sc.sc_self { Option::Some(_t) => true | Option::None => false };
}
fn resolve_type_ann(a: Allocator, ar: *Arena, ann: *const TypeAnn) -> *const Typ {
    return match *ann {
        TypeAnn::TyInt { is_signed, width } =>
            ty_node(ar, Typ::TInt(IntKind { is_signed: is_signed, width: width }))
        | TypeAnn::TyCInt { is_signed } => ty_node(ar, Typ::TCInt { is_signed: is_signed })
        | TypeAnn::TyCShort { is_signed } => ty_node(ar, Typ::TCShort { is_signed: is_signed })
        | TypeAnn::TyCLong { is_signed } => ty_node(ar, Typ::TCLong { is_signed: is_signed })
        | TypeAnn::TyCChar => ty_node(ar, Typ::TCChar)
        | TypeAnn::TyCSChar => ty_node(ar, Typ::TCSChar)
        | TypeAnn::TyCUChar => ty_node(ar, Typ::TCUChar)
        | TypeAnn::TyCVoid => ty_node(ar, Typ::TCVoid)
        | TypeAnn::TyStr => ty_node(ar, Typ::TString)
        | TypeAnn::TyBool => ty_node(ar, Typ::TBool)
        | TypeAnn::TyFloat(w) => ty_node(ar, Typ::TFloat(w))
        | TypeAnn::TyPtr(t) => ty_node(ar, Typ::TPtr(resolve_type_ann(a, ar, t)))
        | TypeAnn::TyOwnPtr(t) => ty_node(ar, Typ::TOwnPtr(resolve_type_ann(a, ar, t)))
        | TypeAnn::TyConstPtr(t) => ty_node(ar, Typ::TConstPtr(resolve_type_ann(a, ar, t)))
        | _other => ty_node(ar, Typ::TCVoid)
    };
}

// ===== Named-type resolution (signature path) =====
//
// Function bodies are still masked by the differential gate, so the body
// resolver above keeps lowering named types to `c_void` there.  Signatures
// ARE compared, so they resolve names properly: a single-segment name that
// is a type-parameter in scope becomes `TVar`, a known user/prelude enum
// becomes `TEnum`, anything else a `TStruct` (generic applications keep
// their resolved arguments); tuples lower element-wise.

// A top-level integer `const` whose value is a literal — enough to fold an
// array size `[T; N]` where `N` is a named constant (the common case).
struct IntConst {
    ic_name: str,
    ic_val: int,
}

// One resolved struct field, keyed by its owning struct's path.  The index
// is a flat list of these (rather than nested per-struct field vecs) so a
// field-type lookup returns a pointer read one level deep from the index
// parameter — the same shape `env_lookup` relies on to stay escape-clean.
struct StructField {
    sf_path: Vec<str>,
    sf_name: str,
    sf_ty: *const Typ,
}

// A `use foo::Bar;` (or wildcard-expanded `pub use foo::Bar;`) type alias:
// the bare name `Bar` resolves to the qualified path `foo::Bar` when `Bar`
// names a declared type.  This is the type-level counterpart to collect_use's
// function aliasing — it lets a bare `Expr` in a file that does `use ast::*`
// resolve to `ast::Expr` (cross-module type resolution, the fixpoint gap).
struct TypeAlias {
    ta_name: str,
    ta_path: Vec<str>,
    ta_is_enum: bool,
}

// Enum variant → tag (declaration order), and a flat per-variant-field
// index (tuple payloads get synthesised names `_0`, `_1`, …; struct
// payloads keep their declared names).  Kept flat for the same
// escape-clean one-level lookup as the struct field index.
struct EnumVariantTag {
    et_path: Vec<str>,
    et_name: str,
    et_tag: int,
    // `Variant { a: T }` (struct payload) vs `Variant(T)` / unit — the @debug
    // printer renders the two shapes differently (`Shape::Rect { w: .. }`).
    et_is_struct: bool,
}

struct EnumFieldE {
    ef_path: Vec<str>,
    ef_variant: str,
    ef_name: str,
    ef_ty: *const Typ,
}

// One inherent / trait method, keyed by its owning type path + name.  Carries
// the C symbol, resolved return type, and self shape so a call site can lower
// `recv.m(..)` / `T::m(..)` to `T__m(<self>, ..)` and adjust the receiver.
struct MethodInfo {
    mi_path: Vec<str>,
    mi_name: str,
    mi_mangled: str,
    mi_ret: Option<*const Typ>,
    mi_has_self: bool,
    mi_self_ptr: bool,
    mi_self_const: bool,
    // Generic-method inference data (mi_tparams empty => a plain method).
    // The annotations resolve under mi_tparams at the call site; the impl /
    // method indices re-derive the source fn in the drain (like GenFn's
    // gn_idx) so the instance body elaborates under the inferred bindings.
    mi_tparams: Vec<str>,
    mi_params: Vec<*const TypeAnn>,
    mi_ret_ann: Option<*const TypeAnn>,
    mi_impl_idx: u32,
    mi_meth_idx: u32,
    // A prelude method (Allocator / Vec / ...): its body is prelude-injected,
    // so a generic call resolves + mangles but queues no instance to drain.
    mi_prelude: bool,
    // A method on a generic struct (`impl<T> Foo<T>`): mi_tparams are the
    // impl's parameters, bound from the receiver instance's fields (not from
    // self / arg annotations, which mangle opaquely).  The instance return
    // type resolves with those bindings already in scope.
    mi_struct_gen: bool,
}

// A top-level generic function.  Inference at a call site needs its type
// parameters, parameter annotations and return annotation — all stored here
// (the annotations are arena-stable pointers; copying a `*const Func` from a
// match binding would dangle).  `gn_idx` re-derives the source fn in the
// drain (where `items` is in scope) to elaborate the instance body.
struct GenFn {
    gn_name: str,
    gn_mangled: str,
    gn_idx: u32,
    gn_tparams: Vec<str>,
    gn_params: Vec<*const TypeAnn>,
    gn_ret: Option<*const TypeAnn>,
}

// A queued generic-fn instance to elaborate after the main pass: the source
// fn's item index, the tparam bindings to elaborate it under, and the
// instance C symbol.
struct GenJob {
    gj_idx: u32,
    // -1 for a free fn at top-level item `gj_idx`; otherwise the method index
    // within the impl at item `gj_idx`.
    gj_meth: int,
    gj_binds: Vec<TVarBind>,
    gj_mangled: str,
    // The implementing type — empty for free fns / regular methods (self is
    // parser-stamped); for a generic default (whose source fn lives in the
    // trait at `gj_idx`) it pins `Self` in the instance body.
    gj_target: Vec<str>,
    // A prelude generic method instance (Vec/VecIter/HashMap/adapter): its body
    // lives in the parsed source-prelude items, not the user `items`, so the
    // drain re-derives it via (pm_type, pm_name) = `gj_target` looked up in the
    // prelude registry.  gj_idx / gj_meth are unused for these.
    gj_prelude: bool,
}

// An enum's type parameters in declaration order (user enums + the prelude
// Option/Result), so an instance can substitute its variant payloads.
struct EnumTP {
    etp_name: str,
    etp_params: Vec<str>,
}
// A generic struct's declared type parameters, so a monomorphic instance can
// zip them against its resolved args to substitute the skeleton fields.
struct StructTP {
    stp_name: str,
    stp_params: Vec<str>,
}
// A trait impl's associated-type binding: `impl Iterator for Count { type
// Item = int }` records (Count, Item) -> int.  `ab_tparams` are the impl's
// type parameters (for a generic `type Item = T`, projected through the
// concrete instance's args).
// A captureless lambda lifted to a top-level fn at elaboration time (DR-008
// A1).  Recorded when the `Expr::Lambda` is elaborated; drained into the fn
// list after the user functions, so it follows `main` like the oracle's.
struct LiftedLambda {
    ll_mangled: str,
    ll_name: str,
    ll_expr: *const Expr,
    // ll_kind 0 = A1 captureless lambda (ll_expr is the `Lambda` node, lifted
    // at elab time); 1 = A2 capturing closure synthesised by the pre-pass
    // (ll_expr is the capture-substituted `call` body).
    ll_kind: int,
    ll_closure: str,           // A2: the `__closure_N` env-struct name
    ll_params: Vec<FieldDef>,  // A2: the lambda's own params (call gets self + these)
    ll_ret: Option<*const TypeAnn>,
    ll_caps: Vec<str>,         // A2: captured names, in struct-field order
    ll_brefs: Vec<str>,        // A2: subset of ll_caps captured by-ref (`[&name]`, DR-033)
    ll_lambda: *const Expr,    // A2: the original `Lambda` node, matched at elab time
}
struct AssocBind {
    ab_trait: str,
    ab_target: str,
    ab_name: str,
    ab_ty: *const TypeAnn,
    ab_tparams: Vec<str>,
}

struct TyScope {
    sc_structs: *const Vec<str>,
    sc_enums: *const Vec<str>,
    sc_tparams: *const Vec<str>,
    sc_iconsts: *const Vec<IntConst>,
    sc_sinfo: *const Vec<StructField>,
    sc_etags: *const Vec<EnumVariantTag>,
    sc_efields: *const Vec<EnumFieldE>,
    sc_methods: *const Vec<MethodInfo>,
    // Mutable accumulators for generated monomorphic instances (footer).
    sc_mono_structs: *Vec<Vec<str>>,
    // Instance ARGS parallel to sc_mono_structs (empty for non-generic entries):
    // the source-level type arguments a mono instance was built from, needed to
    // render `Pair<i32, bool>` rather than the mangled `Pair_i32_bool`.
    sc_mono_sargs: *Vec<Vec<*const Typ>>,
    sc_mono_enums: *Vec<Vec<str>>,
    // Instance ARGS parallel to sc_mono_enums (see sc_mono_sargs).
    sc_mono_eargs: *Vec<Vec<*const Typ>>,
    // Substituted fields of struct instances, keyed by instance path, so
    // `instance.field` accesses resolve.
    sc_mono_fields: *Vec<StructField>,
    sc_mono_efields: *Vec<EnumFieldE>,
    // Type-parameter bindings in force (non-empty only while elaborating a
    // generic-fn instance body — there `T` resolves to its concrete type).
    sc_tbinds: *const Vec<TVarBind>,
    // Generic-fn registry + the instance work-queue and its dedup set.
    sc_genfns: *const Vec<GenFn>,
    sc_genjobs: *Vec<GenJob>,
    sc_geninsts: *Vec<str>,
    sc_etps: *const Vec<EnumTP>,
    sc_stps: *const Vec<StructTP>,
    sc_assoc: *const Vec<AssocBind>,
    sc_lifted: *Vec<LiftedLambda>,
    sc_gensym: *u32,
    sc_modpath: *const Vec<str>,
    // The enclosing fn's resolved return type — `try` reads it to build the
    // early-return value on the enclosing fn's own Option/Result instance.
    sc_ret: Option<*const Typ>,
    // The `Self` type while elaborating a synthesised trait default method
    // (impl methods are parser-stamped, so they never carry `TySelf`).
    sc_self: Option<*const Typ>,
    // Free / module fn parameter types, for `own *T` → `*T` arg coercion.
    sc_gsigs: *const Vec<FnSig>,
    // `extern struct` / `extern type` names — resolve to TExtStruct / TExtAlias
    // (an opaque C type / a raw C type alias), not a user struct.
    sc_xstructs: *const Vec<str>,
    sc_xaliases: *const Vec<str>,
    sc_taliases: *const Vec<TypeAlias>,
    // True only while elaborating `fn main` — a bare `return;` there becomes
    // `return 0` (C `int main` must return a value).
    sc_is_main: bool,
    // Names the compiler MINTED, mapped back to what the user wrote: disjoint
    // siblings (`v` -> `v__1`), the `for` counter (`i` -> `__fv1`), a scoped
    // projection (`x` -> `x__with0`).  Diagnostics render through it — an error
    // naming a binding the user never wrote is a bug in the compiler, not a hint.
    // Reset per function.  (The reference keeps the same map on `tfunc`; the port
    // needs it only in typecheck so far, because move / drop / escape still elide
    // their diagnostics.  It moves to the IR contract when they stop.)
    sc_srcnames: *Vec<StrPair>,
    // Index of the first entry belonging to the function being elaborated.  `Vec`
    // is append-only by design, so the map is not cleared between functions —
    // lookup simply starts here.  It has to be per-function: `v__1` minted in one
    // fn can be a name the USER wrote in another, and a global map would render
    // theirs as `v`.
    sc_srcbase: *u32,
    // Every binding in the function under elaboration, tagged: "p" = param,
    // "P" = `mut` param, "m" = `let mut`.  (An immutable `let` needs no entry: it
    // is the absence of one.)  The tag carries what the diagnostic needs — the
    // message differs for a parameter ("or mark the parameter `mut`").  Same
    // append-only + base-index idiom as sc_srcnames.
    sc_binds: *Vec<StrPair>,
    sc_bindbase: *u32,
    // The FIRST diagnostic raised while elaborating this program.
    //
    // The reference implementation raises an exception and unwinds; exile has no
    // exceptions, and threading `Result` through elaboration would mean rewriting
    // every one of the hundreds of functions below.  So the error is LATCHED here
    // — first one wins — and elaboration carries on with whatever placeholder the
    // failing site produced.  The traversal order is identical to the reference's,
    // so "the first error" means the same error, and check_program returns it
    // instead of a Tprogram.  Same shape as escape.exl's `e_err`, which this
    // follows deliberately.
    sc_err: *Option<*const CompileError>,
}

// The program-global indices bundled for threading through the elaboration
// pass (every fn's body scope is built from these plus its own tparams).
// One pointer instead of seven keeps the elaborate_* signatures stable as
// later passes add more indices.
struct ProgIdx {
    pi_snames: *const Vec<str>,
    pi_enames: *const Vec<str>,
    pi_iconsts: *const Vec<IntConst>,
    pi_sinfo: *const Vec<StructField>,
    pi_etags: *const Vec<EnumVariantTag>,
    pi_efields: *const Vec<EnumFieldE>,
    pi_methods: *const Vec<MethodInfo>,
    pi_mono_structs: *Vec<Vec<str>>,
    pi_mono_sargs: *Vec<Vec<*const Typ>>,
    pi_mono_enums: *Vec<Vec<str>>,
    pi_mono_eargs: *Vec<Vec<*const Typ>>,
    pi_mono_fields: *Vec<StructField>,
    pi_mono_efields: *Vec<EnumFieldE>,
    pi_tbinds: *const Vec<TVarBind>,
    pi_genfns: *const Vec<GenFn>,
    pi_genjobs: *Vec<GenJob>,
    pi_geninsts: *Vec<str>,
    pi_etps: *const Vec<EnumTP>,
    pi_stps: *const Vec<StructTP>,
    pi_assoc: *const Vec<AssocBind>,
    pi_lifted: *Vec<LiftedLambda>,
    pi_modpath: *const Vec<str>,
    pi_gsigs: *const Vec<FnSig>,
    pi_xstructs: *const Vec<str>,
    pi_xaliases: *const Vec<str>,
    pi_taliases: *const Vec<TypeAlias>,
    pi_err: *Option<*const CompileError>,
    pi_srcnames: *Vec<StrPair>,
    pi_srcbase: *u32,
    pi_binds: *Vec<StrPair>,
    pi_bindbase: *u32,
}

// Index of `(type-path, method-name)` in the method table, or -1.
// Is `inst_last` (`Pair_i32_bool`) a monomorphic instance of base `base_last`
// (`Pair`)?  True when it is `base_last` followed by `_<args>`.
fn inst_of_base(inst_last: str, base_last: str) -> bool {
    let bn = str::length(base_last);
    if str::length(inst_last) <= bn { return false; }
    if !str_starts_with(inst_last, base_last) { return false; }
    let ib = str::as_bytes(inst_last);
    return ib[bn] == 95 as u8;
}
fn find_method_idx(methods: *const Vec<MethodInfo>, type_path: *const Vec<str>, name: str) -> int {
    let n = methods.length();
    let sl = methods.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].mi_name, name) {
            if path_eq(&sl[i].mi_path, type_path) { return i as int; }
            // A method on a generic struct matches the receiver's monomorphic
            // instance (`Pair_i32_bool` → the `impl<A,B> Pair<A,B>` methods).
            if sl[i].mi_struct_gen {
                if inst_of_base(path_last(type_path), path_last(&sl[i].mi_path)) { return i as int; }
            }
        }
        i = i + 1 as u32;
    }
    return 0 as int - 1 as int;
}

// Variant tag for `Path::Variant`, or -1 if unknown.
fn variant_tag(etags: *const Vec<EnumVariantTag>, path: *const Vec<str>, variant: str) -> int {
    let n = etags.length();
    let sl = etags.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].et_name, variant) {
            if path_eq(&sl[i].et_path, path) { return sl[i].et_tag; }
        }
        i = i + 1 as u32;
    }
    return 0 as int - 1 as int;
}

// Payload field type for `Path::Variant`'s field `fname`, or None.
fn enum_field_ty(efields: *const Vec<EnumFieldE>, path: *const Vec<str>, variant: str, fname: str) -> Option<*const Typ> {
    let n = efields.length();
    let sl = efields.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].ef_name, fname) {
            if str::eq(sl[i].ef_variant, variant) {
                if path_eq(&sl[i].ef_path, path) { return Option::Some(sl[i].ef_ty); }
            }
        }
        i = i + 1 as u32;
    }
    let none: Option<*const Typ> = Option::None;
    return none;
}

// Join-normalised path equality — the SINGLE comparison semantics for type
// paths across the port.  A module type path is stored both split
// (["ir","VariantSig"]) and colon-joined (["ir::VariantSig"]) depending on
// source (name-collection vs type-resolution vs mono-mangling), so a same-count
// scan is exact and a differing-count scan compares the "::"-joined byte
// streams.  Aligning every path_eq site to this superset (matching move.exl's
// mpath_eq and drop.exl's mpath_eq2) closes the recurring path-form family:
// six distinct bugs traced to exact-vs-normalised mismatches, the worst
// inter-pass (move vs drop) and soundness-class.  A join is injective on path
// content, so this only ADDS the intended cross-form matches, never a false one.

// The type of `<struct at path>.field`, or None if unknown.
fn find_field_ty(sinfo: *const Vec<StructField>, path: *const Vec<str>, field: str) -> Option<*const Typ> {
    let n = sinfo.length();
    let sl = sinfo.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].sf_name, field) {
            if path_eq(&sl[i].sf_path, path) { return Option::Some(sl[i].sf_ty); }
        }
        i = i + 1 as u32;
    }
    let none: Option<*const Typ> = Option::None;
    return none;
}

// The pointee type of a pointer (any of the three pointer flavours).
fn deref_pointee(t: *const Typ) -> Option<*const Typ> {
    return match *t {
        Typ::TPtr(inner) => Option::Some(inner)
        | Typ::TConstPtr(inner) => Option::Some(inner)
        | Typ::TOwnPtr(inner) => Option::Some(inner)
        | _e => { let n: Option<*const Typ> = Option::None; n }
    };
}

// `null` IS a pointer for the purposes of "does this value need auto-ref'ing into a
// pointer slot" — it has no pointee, but it is not a value to take the address of.
// (Omitting it made `let p: *c_void = null` auto-ref to `&null` and lift.  Same
// shape as typ_eq's missing TNullPtr case: a relation that did not know about the
// null literal, invisible until something asked it.)
fn is_ptr_ty(t: *const Typ) -> bool {
    return match *t {
        Typ::TPtr(_i) => true
        | Typ::TConstPtr(_i) => true
        | Typ::TOwnPtr(_i) => true
        | Typ::TNullPtr => true
        | _e => false
    };
}

// The named-type path a method receiver resolves to, auto-dereferencing
// through pointers (`*Point` and `Point` both dispatch on `Point`).
fn recv_base_path(a: Allocator, t: *const Typ) -> Vec<str> {
    return match *t {
        Typ::TStruct(p) => copy_strs(a, &p)
        | Typ::TEnum(p) => copy_strs(a, &p)
        | Typ::TPtr(inner) => recv_base_path(a, inner)
        | Typ::TConstPtr(inner) => recv_base_path(a, inner)
        | Typ::TOwnPtr(inner) => recv_base_path(a, inner)
        | _e => Vec::with_capacity(a, 8 as u32)
    };
}

// The type of `target.field` where `target` may be a struct value or a
// pointer to one (dot-access auto-derefs).  None if `target` is not a
// known struct (e.g. its own elaboration deferred to a marker).
fn struct_field_ty(sc: *const TyScope, target_ty: *const Typ, field: str) -> Option<*const Typ> {
    return match *target_ty {
        Typ::TStruct(path) => match find_field_ty(sc.sc_sinfo, &path, field) {
            Option::Some(t) => Option::Some(t)
            | Option::None => find_field_ty(sc.sc_mono_fields, &path, field)
        }
        | Typ::TPtr(inner) => struct_field_ty(sc, inner, field)
        | Typ::TConstPtr(inner) => struct_field_ty(sc, inner, field)
        | Typ::TOwnPtr(inner) => struct_field_ty(sc, inner, field)
        | _e => { let n: Option<*const Typ> = Option::None; n }
    };
}

fn iconst_lookup(consts: *const Vec<IntConst>, name: str) -> int {
    let n = consts.length();
    let sl = consts.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].ic_name, name) { return sl[i].ic_val; }
        i = i + 1 as u32;
    }
    return 0 as int;
}

fn name_in(names: *const Vec<str>, n: str) -> bool {
    let cnt = names.length();
    let sl = names.as_slice();
    let mut i = 0 as u32;
    while i < cnt {
        if str::eq(sl[i], n) { return true; }
        i = i + 1 as u32;
    }
    return false;
}

fn resolve_sig_args(a: Allocator, ar: *Arena, sc: *const TyScope,
                    args: *const Vec<*const TypeAnn>) -> Vec<*const Typ> {
    let mut out: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n {
        out.push(resolve_sig_ty(a, ar, sc, sl[i]));
        i = i + 1 as u32;
    }
    return out;
}

fn str2(a: Allocator, ar: *Arena, x: str, y: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 16 as u32);
    sb.push_str(x);
    sb.push_str(y);
    return str::from_slice(ar, sb.as_slice());
}

// C-name mangle of a named-type path: one segment gets the `ex_` prefix, a
// module-qualified path joins with `__` (mirrors `ir.mangle`).
fn mangle_named(a: Allocator, ar: *Arena, path: *const Vec<str>) -> str {
    let n = path.length();
    let sl = path.as_slice();
    if n == 1 as u32 { return str2(a, ar, "ex_", sl[0 as u32]); }
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { sb.push_str("__"); }
        sb.push_str(sl[i]);
        i = i + 1 as u32;
    }
    return str::from_slice(ar, sb.as_slice());
}

// Mangle a type to its instance-name component (mirrors `ir.mangle_typ`).
// `(u32, i32)` -> `tup2_u32_i32` — a tuple's mangled instance fragment.
fn mangle_tuple(a: Allocator, ar: *Arena, elems: *const Vec<*const Typ>) -> str {
    let n = elems.length();
    let sl = elems.as_slice();
    let mut sb = StringBuilder::with_capacity(a, 16 as u32);
    sb.push_str("tup");
    sb.push_int(n as int);
    let mut i = 0 as u32;
    while i < n {
        sb.push_str("_");
        sb.push_str(mangle_typ(a, ar, sl[i]));
        i = i + 1 as u32;
    }
    return str::from_slice(ar, sb.as_slice());
}
fn mangle_typ(a: Allocator, ar: *Arena, t: *const Typ) -> str {
    return match *t {
        Typ::TInt(k) => int_typ_name(k.is_signed, k.width)
        | Typ::TBool => "bool"
        | Typ::TString => "str"
        | Typ::TFloat(w) => match w { FloatWidth::F32 => "f32" | FloatWidth::F64 => "f64" }
        | Typ::TStruct(pp) => mangle_named(a, ar, &pp)
        | Typ::TEnum(pp) => mangle_named(a, ar, &pp)
        | Typ::TPtr(inner) => str2(a, ar, "ptr_", mangle_typ(a, ar, inner))
        | Typ::TConstPtr(inner) => str2(a, ar, "cptr_", mangle_typ(a, ar, inner))
        | Typ::TOwnPtr(inner) => str2(a, ar, "ownptr_", mangle_typ(a, ar, inner))
        | Typ::TCInt { is_signed } => match is_signed { true => "cint" | false => "cuint" }
        | Typ::TTuple(elems) => mangle_tuple(a, ar, &elems)
        | _other => "?"
    };
}

// Monomorphic instance path of `decl_path<args>`: the last segment gains a
// `_<arg-mangle>…` suffix (`Option<int>` → `Option_i32`).
fn instance_path(a: Allocator, ar: *Arena, decl_path: *const Vec<str>, args: *const Vec<*const Typ>) -> Vec<str> {
    let n = decl_path.length();
    let dsl = decl_path.as_slice();
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(dsl[n - 1 as u32]);
    let an = args.length();
    let asl = args.as_slice();
    let mut i = 0 as u32;
    while i < an { sb.push_str("_"); sb.push_str(mangle_typ(a, ar, asl[i])); i = i + 1 as u32; }
    let last = str::from_slice(ar, sb.as_slice());
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut j = 0 as u32;
    while j + 1 as u32 < n { out.push(dsl[j]); j = j + 1 as u32; }
    out.push(last);
    return out;
}

// Mangled name of a generic-fn instance: the skeleton symbol plus
// `_<arg-mangle>…` in binding order (`ex_id` + [i32] → `ex_id_i32`).
fn fn_instance_mangled(a: Allocator, ar: *Arena, base: str, args: *const Vec<*const Typ>) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(base);
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n { sb.push_str("_"); sb.push_str(mangle_typ(a, ar, sl[i])); i = i + 1 as u32; }
    return str::from_slice(ar, sb.as_slice());
}

fn is_prelude_enum(name: str) -> bool {
    return str::eq(name, "Option") || str::eq(name, "Result");
}

// A `TVar name → concrete type` binding inferred at a generic instantiation.
struct TVarBind {
    tvb_name: str,
    tvb_ty: *const Typ,
}

fn has_tbind(sc: *const TyScope, name: str) -> bool {
    return match bind_lookup(sc.sc_tbinds, name) {
        Option::Some(_t) => true
        | Option::None => false
    };
}
fn get_tbind(ar: *Arena, sc: *const TyScope, name: str) -> *const Typ {
    return match bind_lookup(sc.sc_tbinds, name) {
        Option::Some(t) => t
        | Option::None => ty_node(ar, Typ::TCVoid)
    };
}

fn bind_lookup(binds: *const Vec<TVarBind>, name: str) -> Option<*const Typ> {
    let n = binds.length();
    let sl = binds.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].tvb_name, name) { return Option::Some(sl[i].tvb_ty); }
        i = i + 1 as u32;
    }
    let none: Option<*const Typ> = Option::None;
    return none;
}

// Substitute tparam bindings into a type (TVar → its binding; recurse
// through pointers and arrays — the cases generic field/return types use).
fn subst_typ(ar: *Arena, binds: *const Vec<TVarBind>, t: *const Typ) -> *const Typ {
    return match *t {
        Typ::TVar(n) => match bind_lookup(binds, n) { Option::Some(bt) => bt | Option::None => t }
        | Typ::TPtr(inner) => ty_node(ar, Typ::TPtr(subst_typ(ar, binds, inner)))
        | Typ::TConstPtr(inner) => ty_node(ar, Typ::TConstPtr(subst_typ(ar, binds, inner)))
        | Typ::TOwnPtr(inner) => ty_node(ar, Typ::TOwnPtr(subst_typ(ar, binds, inner)))
        | Typ::TArray { elem, size } => ty_node(ar, Typ::TArray { elem: subst_typ(ar, binds, elem), size: size })
        | _other => t
    };
}
// Like subst_typ but resolves a nested generic application (`Slot<K,V>` inside
// `HashMap<K,V>`'s `slots` field) to its mangled instance, registering that
// instance + fields on the way — so `Slot_i32_i32` etc. ride the footer.
fn subst_typs_reg(a: Allocator, ar: *Arena, sc: *const TyScope, binds: *const Vec<TVarBind>, args: *const Vec<*const Typ>) -> Vec<*const Typ> {
    let mut out: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(subst_typ_reg(a, ar, sc, binds, sl[i])); i = i + 1 as u32; }
    return out;
}
fn subst_app_reg(a: Allocator, ar: *Arena, sc: *const TyScope, binds: *const Vec<TVarBind>, path: *const Vec<str>, args: *const Vec<*const Typ>) -> *const Typ {
    let rargs = subst_typs_reg(a, ar, sc, binds, args);
    if tys_have_tvar(&rargs) { return ty_node(ar, Typ::TStructApp { path: copy_strs(a, path), args: rargs }); }
    let ipath = instance_path(a, ar, path, &rargs);
    if !inst_has_fields(sc.sc_mono_fields, &ipath) {
        register_mono_struct(a, sc, &ipath);
        let binds2 = struct_instance_binds(a, sc.sc_stps, path_last(path), &rargs);
        register_instance_fields(a, ar, sc, path, &binds2, &ipath);
    }
    return ty_node(ar, Typ::TStruct(ipath));
}
fn subst_typ_reg(a: Allocator, ar: *Arena, sc: *const TyScope, binds: *const Vec<TVarBind>, t: *const Typ) -> *const Typ {
    return match *t {
        Typ::TVar(n) => match bind_lookup(binds, n) { Option::Some(bt) => bt | Option::None => t }
        | Typ::TPtr(inner) => ty_node(ar, Typ::TPtr(subst_typ_reg(a, ar, sc, binds, inner)))
        | Typ::TConstPtr(inner) => ty_node(ar, Typ::TConstPtr(subst_typ_reg(a, ar, sc, binds, inner)))
        | Typ::TOwnPtr(inner) => ty_node(ar, Typ::TOwnPtr(subst_typ_reg(a, ar, sc, binds, inner)))
        | Typ::TArray { elem, size } => ty_node(ar, Typ::TArray { elem: subst_typ_reg(a, ar, sc, binds, elem), size: size })
        | Typ::TStructApp { path, args } => subst_app_reg(a, ar, sc, binds, &path, &args)
        | _other => t
    };
}

// Infer tparam bindings by matching a declared (skeleton) type against an
// actual type: a `TVar` binds to the actual; pointers/arrays recurse.
fn unify_typ(decl: *const Typ, act: *const Typ, out: *Vec<TVarBind>) {
    match *decl {
        Typ::TVar(n) => { out.push(TVarBind { tvb_name: n, tvb_ty: act }); }
        | Typ::TPtr(di) => { match *act { Typ::TPtr(ai) => unify_typ(di, ai, out) | _e => { } } }
        | Typ::TConstPtr(di) => { match *act { Typ::TConstPtr(ai) => unify_typ(di, ai, out) | Typ::TPtr(ai) => unify_typ(di, ai, out) | _e => { } } }
        | Typ::TOwnPtr(di) => { match *act { Typ::TOwnPtr(ai) => unify_typ(di, ai, out) | _e => { } } }
        | _other => { }
    }
}

// Register a generated instance for the `mono-instances` footer.  The accs
// ride in the (const) scope as mutable Vec pointers, so registration works
// from any resolution site — signature or body — with no extra threading.
fn allocator_path(a: Allocator) -> Vec<str> {
    let mut p: Vec<str> = Vec::with_capacity(a, 8 as u32);
    p.push("Allocator");
    return p;
}
fn one_path(a: Allocator, name: str) -> Vec<str> {
    let mut p: Vec<str> = Vec::with_capacity(a, 8 as u32);
    p.push(name);
    return p;
}
fn register_mono_struct(a: Allocator, sc: *const TyScope, ipath: *const Vec<str>) {
    sc.sc_mono_structs.push(copy_strs(a, ipath));
    let no_args: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    sc.sc_mono_sargs.push(no_args);
}
// Same, but records the instance's source-level type ARGS (the generic-app site
// is the only one that has them).  Keeps sc_mono_sargs index-aligned.
fn register_mono_struct_args(a: Allocator, sc: *const TyScope, ipath: *const Vec<str>, args: *const Vec<*const Typ>) {
    sc.sc_mono_structs.push(copy_strs(a, ipath));
    sc.sc_mono_sargs.push(copy_typs(a, args));
}
fn copy_typs(a: Allocator, src: *const Vec<*const Typ>) -> Vec<*const Typ> {
    let mut out: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < src.length() { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}
// Keeps sc_mono_enums / sc_mono_eargs index-aligned (empty args = non-generic).
fn register_mono_enum_args(a: Allocator, sc: *const TyScope, ipath: *const Vec<str>, args: *const Vec<*const Typ>) {
    sc.sc_mono_enums.push(copy_strs(a, ipath));
    sc.sc_mono_eargs.push(copy_typs(a, args));
}

// Bindings for an enum instance: zip the enum's declared type parameters
// (from the registry) with the instance args.
fn enum_instance_binds(a: Allocator, etps: *const Vec<EnumTP>, name: str, args: *const Vec<*const Typ>) -> Vec<TVarBind> {
    let n = etps.length();
    let sl = etps.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].etp_name, name) { return zip_binds(a, &sl[i].etp_params, args); }
        i = i + 1 as u32;
    }
    let empty: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
    return empty;
}

fn zip_binds(a: Allocator, tparams: *const Vec<str>, args: *const Vec<*const Typ>) -> Vec<TVarBind> {
    let mut out: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
    let mut n = tparams.length();
    if args.length() < n { n = args.length(); }
    let tsl = tparams.as_slice();
    let asl = args.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(TVarBind { tvb_name: tsl[i], tvb_ty: asl[i] }); i = i + 1 as u32; }
    return out;
}

fn push_mono_efield(a: Allocator, ar: *Arena, ipath: *const Vec<str>, variant: str, fname: str,
                    binds: *const Vec<TVarBind>, sf_ty: *const Typ, out: *Vec<EnumFieldE>) {
    out.push(EnumFieldE { ef_path: copy_strs(a, ipath), ef_variant: variant, ef_name: fname,
                          ef_ty: subst_typ(ar, binds, sf_ty) });
}

// Register an enum instance's substituted variant fields so a match on the
// instance binds payload variables to their concrete types.
// Register one Option/Result instance variant payload directly (the prelude
// shape is fixed); `ty` is a parameter so the slice element never escapes.
fn push_one_prelude_efield(a: Allocator, ipath: *const Vec<str>, variant: str, fname: str,
                           ty: *const Typ, out: *Vec<EnumFieldE>) {
    out.push(EnumFieldE { ef_path: copy_strs(a, ipath), ef_variant: variant, ef_name: fname, ef_ty: ty });
}
fn register_prelude_enum_efields(a: Allocator, sc: *const TyScope, name: str,
                                 args: *const Vec<*const Typ>, ipath: *const Vec<str>) {
    let n = args.length();
    let asl = args.as_slice();
    if str::eq(name, "Option") {
        if n >= 1 as u32 { push_one_prelude_efield(a, ipath, "Some", "_0", asl[0 as u32], sc.sc_mono_efields); }
    } else {
        if str::eq(name, "Result") {
            if n >= 1 as u32 { push_one_prelude_efield(a, ipath, "Ok", "_0", asl[0 as u32], sc.sc_mono_efields); }
            if n >= 2 as u32 { push_one_prelude_efield(a, ipath, "Err", "_0", asl[1 as u32], sc.sc_mono_efields); }
        }
    }
}

fn register_enum_instance_fields(a: Allocator, ar: *Arena, sc: *const TyScope, skel: *const Vec<str>,
                                 args: *const Vec<*const Typ>, ipath: *const Vec<str>) {
    let binds = enum_instance_binds(a, sc.sc_etps, path_last(skel), args);
    let n = sc.sc_efields.length();
    let sl = sc.sc_efields.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if path_eq(&sl[i].ef_path, skel) {
            push_mono_efield(a, ar, ipath, sl[i].ef_variant, sl[i].ef_name, &binds, sl[i].ef_ty, sc.sc_mono_efields);
        }
        i = i + 1 as u32;
    }
}

// Payload field type of `Path::Variant`, preferring instance-substituted
// fields over the generic skeleton.
fn mono_enum_field_ty(sc: *const TyScope, epath: *const Vec<str>, variant: str, fname: str) -> Option<*const Typ> {
    return match enum_field_ty(sc.sc_mono_efields, epath, variant, fname) {
        Option::Some(t) => Option::Some(t)
        | Option::None => enum_field_ty(sc.sc_efields, epath, variant, fname)
    };
}

// Does the type mention a free `TVar`?  A generic application whose args are
// still abstract (a generic-struct method skeleton's `Pair<A, B>`) stays an
// unresolved `TStructApp` rather than mangling to a bogus `Pair_A_B` instance.
fn ty_has_tvar(t: *const Typ) -> bool {
    return match *t {
        Typ::TVar(_n) => true
        | Typ::TPtr(i) => ty_has_tvar(i)
        | Typ::TConstPtr(i) => ty_has_tvar(i)
        | Typ::TOwnPtr(i) => ty_has_tvar(i)
        | Typ::TStructApp { path: _p, args } => tys_have_tvar(&args)
        | Typ::TEnumApp { path: _p2, args: a2 } => tys_have_tvar(&a2)
        | Typ::TAssocProj { head, assoc: _as } => ty_has_tvar(head)
        | _e => false
    };
}
fn tys_have_tvar(args: *const Vec<*const Typ>) -> bool {
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n { if ty_has_tvar(sl[i]) { return true; } i = i + 1 as u32; }
    return false;
}
// A user generic struct's tparam → arg bindings for a monomorphic instance.
fn struct_instance_binds(a: Allocator, stps: *const Vec<StructTP>, name: str, args: *const Vec<*const Typ>) -> Vec<TVarBind> {
    let n = stps.length();
    let sl = stps.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].stp_name, name) { return zip_binds(a, &sl[i].stp_params, args); }
        i = i + 1 as u32;
    }
    let empty: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
    return empty;
}
// Register a user generic struct instance's substituted fields at type-position
// resolution (a `Pair<bool, int>` reached through a method return, never a
// literal), so a later `q.field` / generic-method dispatch finds its fields.
// A non-generic / prelude / extern name has no entry in `sc_stps`, so this is
// a no-op for them (prelude structs register via their own skeleton path).
fn inst_has_fields(fields: *const Vec<StructField>, ipath: *const Vec<str>) -> bool {
    let n = fields.length();
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < n { if path_eq(&sl[i].sf_path, ipath) { return true; } i = i + 1 as u32; }
    return false;
}
fn register_user_struct_fields(a: Allocator, ar: *Arena, sc: *const TyScope,
                               base: *const Vec<str>, args: *const Vec<*const Typ>, ipath: *const Vec<str>) {
    if inst_has_fields(sc.sc_mono_fields, ipath) { return; }
    let binds = struct_instance_binds(a, sc.sc_stps, path_last(base), args);
    register_instance_fields(a, ar, sc, base, &binds, ipath);
}
// Project `bound_ty::assoc` through the impl that binds it: `Count::Item` ->
// the `type Item = int` RHS resolved (i32); a generic `type Item = T` is
// resolved through the concrete instance's args (`Gen_i32::Item` -> i32).
fn project_assoc(a: Allocator, ar: *Arena, sc: *const TyScope, bound_ty: *const Typ, assoc: str) -> *const Typ {
    let inst_path = recv_base_path(a, bound_ty);
    let inst_last = path_last(&inst_path);
    let n = sc.sc_assoc.length();
    let sl = sc.sc_assoc.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].ab_name, assoc) {
            if str::eq(sl[i].ab_target, inst_last) || inst_of_base(inst_last, sl[i].ab_target) {
                let mut binds: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
                if sl[i].ab_tparams.length() > 0 as u32 {
                    let mut base: Vec<str> = Vec::with_capacity(a, 8 as u32);
                    base.push(sl[i].ab_target);
                    bind_recv_tparams(a, ar, sc, &base, &inst_path, &binds);
                }
                let cscope = scope_with_tbinds(sc, &sl[i].ab_tparams, &binds);
                return resolve_sig_ty(a, ar, &cscope, sl[i].ab_ty);
            }
        }
        i = i + 1 as u32;
    }
    return ty_node(ar, Typ::TCVoid);
}
// Index of the `use foo::Bar;` type alias for bare `name`, or -1.
fn talias_idx(sc: *const TyScope, name: str) -> int {
    let n = sc.sc_taliases.length();
    let sl = sc.sc_taliases.as_slice();
    let mut i = 0 as u32;
    while i < n { if str::eq(sl[i].ta_name, name) { return i as int; } i = i + 1 as u32; }
    return -1 as int;
}
fn resolve_named_ty(a: Allocator, ar: *Arena, sc: *const TyScope,
                    path: *const Vec<str>, args: *const Vec<*const TypeAnn>) -> *const Typ {
    let plen = path.length();
    let psl = path.as_slice();
    let last = psl[plen - 1 as u32];
    if plen == 1 as u32 {
        // Inside a generic-fn instance, a bound tparam resolves to its
        // concrete type; otherwise it is the abstract `TVar` (skeleton).
        if has_tbind(sc, last) { return get_tbind(ar, sc, last); }
        if name_in(sc.sc_tparams, last) { return ty_node(ar, Typ::TVar(last)); }
    }
    // `Head::Assoc` where Head is a type parameter (or a bound one) is an
    // associated-type projection: in an instance the head is concrete and the
    // projection resolves through the impl's `type Assoc = ..`; in a skeleton
    // it stays a `TAssocProj` marker, projected at instance time.
    if plen == 2 as u32 && args.length() == 0 as u32 {
        let head = psl[0 as u32];
        // `Self::Assoc` inside a trait default projects through the implementing
        // type the instance pinned (`Iterator::collect`'s `Vec<Self::Item>`).
        if str::eq(head, "Self") && has_self_ty(sc) { return project_assoc(a, ar, sc, voidable_ty(ar, sc.sc_self), last); }
        if has_tbind(sc, head) { return project_assoc(a, ar, sc, get_tbind(ar, sc, head), last); }
        if name_in(sc.sc_tparams, head) { return ty_node(ar, Typ::TAssocProj { head: ty_node(ar, Typ::TVar(head)), assoc: last }); }
    }
    let nargs = args.length();
    if nargs == 0 as u32 {
        // An extern struct / type resolves by its last path segment (the raw C
        // symbol), whether named bare or module-qualified (`raw::Library`).
        if name_in(sc.sc_xstructs, last) { return ty_node(ar, Typ::TExtStruct(last)); }
        if name_in(sc.sc_xaliases, last) { return ty_node(ar, Typ::TExtAlias(last)); }
    }
    // A bare type name inside `mod m { ... }` resolves module-relative: if
    // `m::name` is a declared type (its marker is registered), qualify to the
    // `m::name` path.  Otherwise fall through to the bare / outer-scope
    // resolution, so a prelude `StringBuilder` used in a module stays itself.
    if plen == 1 as u32 && nargs == 0 as u32 && sc.sc_modpath.length() > 0 as u32 {
        let marker = join_colons(a, ar, sc.sc_modpath, last);
        if name_in(sc.sc_enums, marker) { return ty_node(ar, Typ::TEnum(path_push(a, sc.sc_modpath, last))); }
        if name_in(sc.sc_structs, marker) { return ty_node(ar, Typ::TStruct(path_push(a, sc.sc_modpath, last))); }
    }
    // A bare name imported via `use foo::Bar;` resolves to `foo::Bar` (the
    // cross-module type alias — see collect_type_aliases).
    if plen == 1 as u32 && nargs == 0 as u32 {
        let ti = talias_idx(sc, last);
        if ti >= 0 as int {
            let tsl = sc.sc_taliases.as_slice();
            if tsl[ti as u32].ta_is_enum { return ty_node(ar, Typ::TEnum(copy_strs(a, &tsl[ti as u32].ta_path))); }
            return ty_node(ar, Typ::TStruct(copy_strs(a, &tsl[ti as u32].ta_path)));
        }
    }
    let is_enum = name_in(sc.sc_enums, last) || is_prelude_enum(last);
    if nargs == 0 as u32 {
        let newpath = copy_strs(a, path);
        if is_enum { return ty_node(ar, Typ::TEnum(newpath)); }
        return ty_node(ar, Typ::TStruct(newpath));
    }
    // Generic application → monomorphic instance, registered for the footer.
    let resolved = resolve_sig_args(a, ar, sc, args);
    // A still-abstract application (a generic-struct method skeleton's
    // `Pair<A, B>`) keeps its `TStructApp` / `TEnumApp` form — mangling it
    // would invent a bogus `Pair_A_B` instance.
    if tys_have_tvar(&resolved) {
        if is_enum { return ty_node(ar, Typ::TEnumApp { path: copy_strs(a, path), args: resolved }); }
        return ty_node(ar, Typ::TStructApp { path: copy_strs(a, path), args: resolved });
    }
    let ipath = instance_path(a, ar, path, &resolved);
    if is_enum {
        register_mono_enum_args(a, sc, &ipath, &resolved);
        // Option / Result variant payloads come from the fixed prelude shape,
        // so register them directly — a type-position resolution (a fn's
        // return type) then binds `Some(v)` / `Ok(v)` even with no in-body
        // construction.  User generic enums substitute from their skeleton.
        if is_prelude_enum(last) {
            register_prelude_enum_efields(a, sc, last, &resolved, &ipath);
        } else {
            register_enum_instance_fields(a, ar, sc, path, &resolved, &ipath);
        }
        return ty_node(ar, Typ::TEnum(ipath));
    }
    // A generic prelude struct (Slice, ...) substitutes its skeleton fields
    // at type-position resolution, so `s.field` / `s[i]` work on a parameter
    // before any construction.  A user generic struct does likewise when it is
    // first seen as a type (a method-return instance never built by a literal).
    //
    // Fields BEFORE self: resolving them registers the instances they name
    // (`HashMap<i32,i32>.slots: own *Slot<i32,i32>` registers Slot_i32_i32), and
    // the oracle emits the nested instance first (measured: Slot_i32_i32 then
    // HashMap_i32_i32).  register_mono_struct does not dedup, so this only moves
    // the push; it introduces no recursion the old order did not already have.
    register_prelude_struct_fields(a, ar, sc, last, &resolved, &ipath);
    register_user_struct_fields(a, ar, sc, path, &resolved, &ipath);
    register_mono_struct_args(a, sc, &ipath, &resolved);
    // Workstream-B: `Vec<T>` no longer eagerly carries a `Slice<T>` view, and
    // `HashMap<K,V>` no longer eagerly carries `Slice<Slot<K,V>>`.  Those were
    // stand-ins for prelude bodies that did not exist yet; the bodies now
    // materialize and register the view where they build it (`as_slice` / the
    // probe view), which is where the oracle registers it too — at the END of
    // the mono section, not at instance-registration time.
    return ty_node(ar, Typ::TStruct(ipath));
}

fn prelude_struct_tparams(name: str, out: *Vec<str>) {
    if str::eq(name, "Slice") { out.push("T"); }
    if str::eq(name, "Range") { out.push("T"); }
    if str::eq(name, "RangeInclusive") { out.push("T"); }
    if str::eq(name, "Vec") { out.push("T"); }
    if str::eq(name, "VecIter") { out.push("T"); }
    // DR-026 lazy iterator adapters.
    if str::eq(name, "Map") { out.push("I"); out.push("F"); }
    if str::eq(name, "Filter") { out.push("I"); out.push("P"); }
    if str::eq(name, "Take") { out.push("I"); }
    if str::eq(name, "Enumerate") { out.push("I"); }
    // DR-007 HashMap open-addressing table.
    if str::eq(name, "HashMap") { out.push("K"); out.push("V"); }
    if str::eq(name, "Slot") { out.push("K"); out.push("V"); }
    if str::eq(name, "HashMapIter") { out.push("K"); out.push("V"); }
}
fn register_prelude_struct_fields(a: Allocator, ar: *Arena, sc: *const TyScope, name: str,
                                  args: *const Vec<*const Typ>, ipath: *const Vec<str>) {
    let mut tps: Vec<str> = Vec::with_capacity(a, 8 as u32);
    prelude_struct_tparams(name, &tps);
    if tps.length() == 0 as u32 { return; }
    let binds = zip_binds(a, &tps, args);
    let mut skel: Vec<str> = Vec::with_capacity(a, 8 as u32);
    skel.push(name);
    register_instance_fields(a, ar, sc, &skel, &binds, ipath);
}

// Array size is a const expression: a literal, or a reference to a
// top-level integer constant (folded through the scope's const table).
// Anything else defers to 0, leaving the sig visibly off rather than
// crashing.
fn array_size_of(size: *const Expr, sc: *const TyScope) -> int {
    return match *size {
        Expr::IntLit(n, _q) => n
        | Expr::Var(nm, _q) => iconst_lookup(sc.sc_iconsts, nm)
        | _e => 0 as int
    };
}

fn resolve_sig_ty(a: Allocator, ar: *Arena, sc: *const TyScope, ann: *const TypeAnn) -> *const Typ {
    return match *ann {
        TypeAnn::TyPtr(t) => ty_node(ar, Typ::TPtr(resolve_sig_ty(a, ar, sc, t)))
        | TypeAnn::TyOwnPtr(t) => ty_node(ar, Typ::TOwnPtr(resolve_sig_ty(a, ar, sc, t)))
        | TypeAnn::TyConstPtr(t) => ty_node(ar, Typ::TConstPtr(resolve_sig_ty(a, ar, sc, t)))
        | TypeAnn::TyStruct { path, args } => resolve_named_ty(a, ar, sc, &path, &args)
        | TypeAnn::TyTuple(elems) => ty_node(ar, Typ::TTuple(resolve_sig_args(a, ar, sc, &elems)))
        | TypeAnn::TyArray { elem, size } =>
            ty_node(ar, Typ::TArray { elem: resolve_sig_ty(a, ar, sc, elem), size: array_size_of(size, sc) })
        | TypeAnn::TyFnPtr { params, ret } =>
            ty_node(ar, Typ::TFnPtr { params: resolve_sig_args(a, ar, sc, &params), ret: resolve_sig_ret(a, ar, sc, ret) })
        | TypeAnn::TySelf => voidable_ty(ar, sc.sc_self)
        | _other => resolve_type_ann(a, ar, ann)
    };
}

fn resolve_param_tys(a: Allocator, ar: *Arena, sc: *const TyScope, params: *const Vec<Param>) -> Vec<*const Typ> {
    let mut out: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let n = params.length();
    let sl = params.as_slice();
    let mut i = 0 as u32;
    while i < n {
        out.push(resolve_sig_ty(a, ar, sc, sl[i].pty));
        i = i + 1 as u32;
    }
    return out;
}

fn resolve_sig_ret(a: Allocator, ar: *Arena, sc: *const TyScope, ret: Option<*const TypeAnn>) -> Option<*const Typ> {
    return match ret {
        Option::Some(t) => Option::Some(resolve_sig_ty(a, ar, sc, t))
        | Option::None => Option::None
    };
}

// `Param` is fully copyable (str / pointer / bool / Option<str>), so the
// param list can be rebuilt for the IR `Tfunc` without moving it out of
// the affine `Vec<Item>` the parser owns.
fn copy_params(a: Allocator, src: *const Vec<Param>) -> Vec<Param> {
    let mut out: Vec<Param> = Vec::with_capacity(a, 8 as u32);
    let n = src.length();
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < n {
        out.push(Param { pname: sl[i].pname, pty: sl[i].pty, is_mut: sl[i].is_mut, preg: sl[i].preg });
        i = i + 1 as u32;
    }
    return out;
}

// ===== Body elaboration (slice 2) =====
//
// Elaborates expressions / statements into typed IR (`Texpr` / `Tstmt`).
// SLICE 2 reach: scalar expressions (int / bool / str / null / float
// literals, var lookup, unary neg/bitnot/not, binops, `println`/`print`
// builtins) and `let` / `expr-stmt` statements.  Control flow, user calls,
// method calls, aggregates, etc. fall to a `c_void` placeholder so the
// enclosing fn diverges (gate: SIG-DIVERGE) rather than crashing.

fn te_node(ar: *Arena, node: TexprNode, ty: *const Typ, pos: Pos) -> *const Texpr {
    let n: *Texpr = ar.alloc_borrowed();
    if n == null { arena_oom(); }
    *n = Texpr { e: node, ty: ty, pos: pos };
    return n as *const Texpr;
}

fn t_i32(ar: *Arena) -> *const Typ {
    return ty_node(ar, Typ::TInt(IntKind { is_signed: true, width: IntWidth::W32 }));
}
fn t_u32(ar: *Arena) -> *const Typ {
    return ty_node(ar, Typ::TInt(IntKind { is_signed: false, width: IntWidth::W32 }));
}
fn t_bool(ar: *Arena) -> *const Typ { return ty_node(ar, Typ::TBool); }
fn t_str(ar: *Arena) -> *const Typ { return ty_node(ar, Typ::TString); }

// Deferral marker: an unsupported construct lowers to `null :ty c_void`
// (the oracle never types `null` as `c_void`, so it is unambiguous).  Used
// for BOTH unsupported expressions AND unsupported statements so that
// incompleteness is always VISIBLE at the source / dump level — a dropped
// statement leaves a `(expr-stmt null :ty c_void)` placeholder rather than
// silently vanishing, keeping the deferred-work-must-be-visible invariant.
// `["mod"; "T"]` -> `mod::T`, the form every diagnostic shows a path in.
fn path_display(a: Allocator, ar: *Arena, path: *const Vec<str>) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    let sl = path.as_slice();
    let mut i = 0 as u32;
    while i < path.length() {
        if i > 0 as u32 { sb.push_str("::"); }
        sb.push_str(sl[i]);
        i = i + 1 as u32;
    }
    return str::from_slice(ar, sb.as_slice());
}
fn msg2(a: Allocator, ar: *Arena, pre: str, x: str, post: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 64 as u32);
    sb.push_str(pre); sb.push_str(x); sb.push_str(post);
    return str::from_slice(ar, sb.as_slice());
}
fn msg3(a: Allocator, ar: *Arena, pre: str, x: str, mid: str, y: str, post: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 80 as u32);
    sb.push_str(pre); sb.push_str(x); sb.push_str(mid); sb.push_str(y); sb.push_str(post);
    return str::from_slice(ar, sb.as_slice());
}

fn defer_expr(ar: *Arena, p: Pos) -> *const Texpr {
    return te_node(ar, TexprNode::TNullLit, ty_node(ar, Typ::TCVoid), p);
}
fn zero_pos() -> Pos { return Pos { line: 0 as int, col: 0 as int, file: "" }; }

fn none_ty() -> Option<*const Typ> {
    let n: Option<*const Typ> = Option::None;
    return n;
}

fn is_tint(t: *const Typ) -> bool {
    return match *t {
        Typ::TInt(_k) => true
        | _e => false
    };
}

// Most recent binding wins (shadowing): scan the env tail-first.
fn env_lookup(env: *const Vec<FieldTy>, name: str) -> Option<*const Typ> {
    let n = env.length();
    let sl = env.as_slice();
    let mut i = n;
    while i > 0 as u32 {
        i = i - 1 as u32;
        if str::eq(sl[i].name, name) { return Option::Some(sl[i].ty); }
    }
    return none_ty();
}

// An int literal adopts a fitting `TInt` expected type (bidirectional),
// else defaults to i32.  (The fit check is deferred — examples are valid.)
fn int_lit_ty(ar: *Arena, expected: Option<*const Typ>) -> *const Typ {
    return match expected {
        Option::Some(t) => pick_int_ty(ar, t)
        | Option::None => t_i32(ar)
    };
}
fn pick_int_ty(ar: *Arena, t: *const Typ) -> *const Typ {
    if is_tint(t) { return t; }
    return t_i32(ar);
}

// ===== Global symbol table (top-level fns + consts) =====
//
// Built in a first pass over the items so a call `foo(...)` resolves to the
// mangled C symbol + return type, and a bare `WIDTH` to its mangled const,
// before any body is elaborated.  `is_const` separates the two: a call
// dispatches on fns, a value reference on consts.  Fully copyable.
struct GlobalFn {
    name: str,
    // The lookup key (path-mangled, so a `mod::fn` qualified call resolves).
    mangled: str,
    // The emitted C symbol — equals `mangled` except for an `extern fn`, which
    // keeps its raw C name even inside a module (`raw::add` emits `add`).
    gf_emit: str,
    ret: Option<*const Typ>,
    is_const: bool,
    is_top: bool,
}

// A free / module fn's resolved parameter types, keyed by C symbol — read at a
// call site to coerce an `own *T` argument to a `*T` / `*const T` parameter
// (DR-030 borrow): the owner is passed by borrow, not consumed.
struct FnSig {
    fs_mangled: str,
    fs_params: Vec<*const Typ>,
}

// A bare name resolves only against top-level symbols (a module-internal
// symbol is reachable solely through its `mod::name` path → by mangled).
fn global_lookup(g: *const Vec<GlobalFn>, name: str) -> Option<GlobalFn> {
    let n = g.length();
    let sl = g.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if sl[i].is_top && str::eq(sl[i].name, name) {
            return Option::Some(GlobalFn { name: sl[i].name, mangled: sl[i].mangled, gf_emit: sl[i].gf_emit,
                ret: sl[i].ret, is_const: sl[i].is_const, is_top: sl[i].is_top });
        }
        i = i + 1 as u32;
    }
    let none: Option<GlobalFn> = Option::None;
    return none;
}

fn global_lookup_by_mangled(g: *const Vec<GlobalFn>, mangled: str) -> Option<GlobalFn> {
    let n = g.length();
    let sl = g.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].mangled, mangled) {
            return Option::Some(GlobalFn { name: sl[i].name, mangled: sl[i].mangled, gf_emit: sl[i].gf_emit,
                ret: sl[i].ret, is_const: sl[i].is_const, is_top: sl[i].is_top });
        }
        i = i + 1 as u32;
    }
    let none: Option<GlobalFn> = Option::None;
    return none;
}

// `mod::name` mangling (ir.mangle): top-level → `ex_name`, else the module
// path joined by `__` then the name (`flags::RW` → `flags__RW`).
fn mangle_path(a: Allocator, ar: *Arena, path: *const Vec<str>, name: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    if path.length() == 0 as u32 {
        sb.push_str("ex_");
        sb.push_str(name);
    } else {
        let n = path.length();
        let sl = path.as_slice();
        let mut i = 0 as u32;
        while i < n { sb.push_str(sl[i]); sb.push_str("__"); i = i + 1 as u32; }
        sb.push_str(name);
    }
    return str::from_slice(ar, sb.as_slice());
}

// Copy a parameter-type list out of the fn-sig index (the result is a fresh
// Vec, so no slice element of the caller's table escapes).
fn copy_typ_vec(a: Allocator, src: *const Vec<*const Typ>) -> Vec<*const Typ> {
    let mut out: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let n = src.length();
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}
fn gsig_params_copy(a: Allocator, gsigs: *const Vec<FnSig>, mangled: str) -> Vec<*const Typ> {
    let n = gsigs.length();
    let sl = gsigs.as_slice();
    let mut j = 0 as u32;
    while j < n {
        if str::eq(sl[j].fs_mangled, mangled) { return copy_typ_vec(a, &sl[j].fs_params); }
        j = j + 1 as u32;
    }
    return Vec::with_capacity(a, 8 as u32);
}
// The fn-ptr type of a top-level fn name used as a value.
fn fn_ptr_of_global(a: Allocator, ar: *Arena, sc: *const TyScope, gf: GlobalFn) -> *const Typ {
    return ty_node(ar, Typ::TFnPtr { params: gsig_params_copy(a, sc.sc_gsigs, gf.mangled), ret: gf.ret });
}

// A local binding resolves to `TVar(name)`; a top-level `const` to
// `TVar(mangled)`; a top-level fn name used as a value to `TFnRef` carrying
// its fn-ptr type (auto-converts to a fn-ptr in C).  Unknown names defer.
fn elab_var(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>, name: str, p: Pos) -> *const Texpr {
    return match env_lookup(env, name) {
        Option::Some(t) => te_node(ar, TexprNode::TVar(name), t, p)
        | Option::None => elab_var_global(a, ar, g, sc, name, p)
    };
}

fn elab_var_global(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, name: str, p: Pos) -> *const Texpr {
    return match global_lookup(g, name) {
        Option::Some(gf) => var_global_node(a, ar, sc, gf, p)
        | Option::None => undefined_var(a, ar, sc, name, p)
    };
}
fn undefined_var(a: Allocator, ar: *Arena, sc: *const TyScope, name: str, p: Pos) -> *const Texpr {
    tc_fail(ar, sc, p, msg2(a, ar, "undefined variable '", name, "'"));
    return defer_expr(ar, p);
}

fn var_global_node(a: Allocator, ar: *Arena, sc: *const TyScope, gf: GlobalFn, p: Pos) -> *const Texpr {
    if gf.is_const { return te_node(ar, TexprNode::TVar(gf.mangled), ret_or_void(ar, gf.ret), p); }
    return te_node(ar, TexprNode::TFnRef(gf.gf_emit), fn_ptr_of_global(a, ar, sc, gf), p);
}

fn elab_neg(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
            expected: Option<*const Typ>, sub: *const Expr, p: Pos) -> *const Texpr {
    let s = elab_expr(a, ar, g, sc, env, expected, sub);
    return te_node(ar, TexprNode::TNeg(s), s.ty, p);
}
fn elab_bitnot(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
               expected: Option<*const Typ>, sub: *const Expr, p: Pos) -> *const Texpr {
    let s = elab_expr(a, ar, g, sc, env, expected, sub);
    return te_node(ar, TexprNode::TBitNot(s), s.ty, p);
}
fn elab_not(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
            sub: *const Expr, p: Pos) -> *const Texpr {
    let s = elab_expr(a, ar, g, sc, env, none_ty(), sub);
    return te_node(ar, TexprNode::TNot(s), t_bool(ar), p);
}

// Push an int expected type into binop operands: arithmetic / bitwise →
// both sides; shift → left only; comparison / logical → neither.
fn left_expected(op: BinOp, expected: Option<*const Typ>) -> Option<*const Typ> {
    return match op {
        BinOp::Add => expected | BinOp::Sub => expected | BinOp::Mul => expected
        | BinOp::Div => expected | BinOp::Mod => expected | BinOp::BitAnd => expected
        | BinOp::BitOr => expected | BinOp::BitXor => expected
        | BinOp::Shl => expected | BinOp::Shr => expected
        | _e => none_ty()
    };
}
fn right_expected(op: BinOp, expected: Option<*const Typ>) -> Option<*const Typ> {
    return match op {
        BinOp::Add => expected | BinOp::Sub => expected | BinOp::Mul => expected
        | BinOp::Div => expected | BinOp::Mod => expected | BinOp::BitAnd => expected
        | BinOp::BitOr => expected | BinOp::BitXor => expected
        | _e => none_ty()
    };
}

// Arithmetic / bitwise / shift take the left operand's type (matching-type
// case; mixed-width promotion deferred); comparisons / logical → bool.
fn binop_result_ty(ar: *Arena, op: BinOp, l: *const Texpr) -> *const Typ {
    return match op {
        BinOp::Lt => t_bool(ar) | BinOp::Gt => t_bool(ar) | BinOp::LtEq => t_bool(ar)
        | BinOp::GtEq => t_bool(ar) | BinOp::EqEq => t_bool(ar) | BinOp::NotEq => t_bool(ar)
        | BinOp::And => t_bool(ar) | BinOp::Or => t_bool(ar)
        | _e => l.ty
    };
}

// ===== Compile-time string concat (`++`) =====
//
// `typ_name` (IR's pure util, primitive slice): names a type for the
// `type_name(x)` builtin, whose result folds into a `++` chain.



fn none_str() -> Option<str> {
    let n: Option<str> = Option::None;
    return n;
}

// A compile-time string: a string literal, or a `type_name(x)` call (whose
// value is the static type name).  Used to fold `++` chains.
fn extract_concat_str(a: Allocator, ar: *Arena, te: *const Texpr) -> Option<str> {
    return match te.e {
        TexprNode::TStringLit(s) => Option::Some(s)
        | TexprNode::TBuiltinCall { name, args } => extract_type_name(a, ar, name, &args)
        | _other => none_str()
    };
}
fn extract_type_name(a: Allocator, ar: *Arena, name: str, args: *const Vec<*const Texpr>) -> Option<str> {
    if str::eq(name, "type_name") && args.length() == 1 as u32 {
        let sl = args.as_slice();
        return Option::Some(typ_name(a, ar, sl[0 as u32].ty));
    }
    return none_str();
}

fn mk_concat_str(a: Allocator, ar: *Arena, l: str, r: str, p: Pos) -> *const Texpr {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(l);
    sb.push_str(r);
    return te_node(ar, TexprNode::TStringLit(str::from_slice(ar, sb.as_slice())), t_str(ar), p);
}

fn fold_concat_r(a: Allocator, ar: *Arena, l: str, r2: *const Texpr, p: Pos) -> *const Texpr {
    return match extract_concat_str(a, ar, r2) {
        Option::Some(r) => mk_concat_str(a, ar, l, r, p)
        | Option::None => defer_expr(ar, p)
    };
}
fn fold_concat(a: Allocator, ar: *Arena, l2: *const Texpr, r2: *const Texpr, p: Pos) -> *const Texpr {
    return match extract_concat_str(a, ar, l2) {
        Option::Some(l) => fold_concat_r(a, ar, l, r2, p)
        | Option::None => defer_expr(ar, p)
    };
}

fn is_concat(op: BinOp) -> bool {
    return match op { BinOp::Concat => true | _e => false };
}

fn expr_is_int_lit(e: *const Expr) -> bool {
    return match *e { Expr::IntLit(_n, _q) => true | _e => false };
}
fn is_str_eq_op(op: BinOp) -> bool {
    return match op { BinOp::EqEq => true | BinOp::NotEq => true | _e => false };
}
fn is_str_ty(t: *const Typ) -> bool {
    return match *t { Typ::TString => true | _e => false };
}
// `==` / `!=` on `str` is a value (content) compare, lowered to the prelude
// `str__eq` call (`!=` negates it) — never a pointer comparison.
fn mk_str_eq(a: Allocator, ar: *Arena, op: BinOp, l2: *const Texpr, r2: *const Texpr, p: Pos) -> *const Texpr {
    let mut args: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    args.push(l2);
    args.push(r2);
    let call = te_node(ar, TexprNode::TCall { mangled: "str__eq", args: args }, t_bool(ar), p);
    return match op {
        BinOp::NotEq => te_node(ar, TexprNode::TNot(call), t_bool(ar), p)
        | _e => call
    };
}
fn finish_binop(a: Allocator, ar: *Arena, op: BinOp, l2: *const Texpr, r2: *const Texpr, p: Pos) -> *const Texpr {
    if is_concat(op) { return fold_concat(a, ar, l2, r2, p); }
    if is_str_eq_op(op) && is_str_ty(l2.ty) && is_str_ty(r2.ty) { return mk_str_eq(a, ar, op, l2, r2, p); }
    let ty = binop_result_ty(ar, op, l2);
    return te_node(ar, TexprNode::TBinOp(op, l2, r2), ty, p);
}
// An int-expected (arithmetic op under an int annotation) drives both
// operands; otherwise smart literal coercion makes a literal adopt its
// sibling's width (`i + 1` with `i: u32` → the `1` is u32), so `i = i + 1`
// keeps a single width.
fn elab_binop(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>, expected: Option<*const Typ>,
              op: BinOp, l: *const Expr, r: *const Expr, p: Pos) -> *const Texpr {
    let le = left_expected(op, expected);
    if is_some_ty(le) {
        let la = elab_expr(a, ar, g, sc, env, le, l);
        let ra = elab_expr(a, ar, g, sc, env, right_expected(op, expected), r);
        return finish_binop(a, ar, op, la, ra, p);
    }
    if expr_is_int_lit(r) && !expr_is_int_lit(l) {
        let lb = elab_expr(a, ar, g, sc, env, none_ty(), l);
        let rb = elab_expr(a, ar, g, sc, env, Option::Some(lb.ty), r);
        return finish_binop(a, ar, op, lb, rb, p);
    }
    if expr_is_int_lit(l) && !expr_is_int_lit(r) {
        let rc = elab_expr(a, ar, g, sc, env, none_ty(), r);
        let lc = elab_expr(a, ar, g, sc, env, Option::Some(rc.ty), l);
        return finish_binop(a, ar, op, lc, rc, p);
    }
    let ld = elab_expr(a, ar, g, sc, env, none_ty(), l);
    let rd = elab_expr(a, ar, g, sc, env, none_ty(), r);
    return finish_binop(a, ar, op, ld, rd, p);
}

fn elab_args(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
             args: *const Vec<*const Expr>) -> Vec<*const Texpr> {
    let mut out: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n {
        out.push(elab_expr(a, ar, g, sc, env, none_ty(), sl[i]));
        i = i + 1 as u32;
    }
    return out;
}

// `expr as T` — the sub keeps its own type; the cast node carries the
// target annotation and takes the resolved annotation type.
fn elab_cast(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
             sub: *const Expr, ann: *const TypeAnn, p: Pos) -> *const Texpr {
    let s = elab_expr(a, ar, g, sc, env, none_ty(), sub);
    let ty = resolve_sig_ty(a, ar, sc, ann);
    return te_node(ar, TexprNode::TCast(s, ann), ty, p);
}

// A call's result type: the declared return type, or — for a void fn used
// in statement position (the common case) — i32, matching the oracle's
// `None when allow_void -> t_i32`.
fn ret_or_void(ar: *Arena, ret: Option<*const Typ>) -> *const Typ {
    return match ret {
        Option::Some(t) => t
        | Option::None => t_i32(ar)
    };
}

// Direct call to a user / top-level fn: mangled C symbol + return type from
// the global table.  Arg-coercion against param types is deferred.
fn is_own_ptr(t: *const Typ) -> bool {
    return match *t { Typ::TOwnPtr(_i) => true | _e => false };
}
fn ptr_or_constptr(t: *const Typ) -> bool {
    return match *t { Typ::TPtr(_i) => true | Typ::TConstPtr(_i) => true | _e => false };
}
// Re-stamp a borrowed-owner argument to the parameter's pointer type.  Only a
// `TVar` is re-typed (the call-site owner is always a binding); other shapes
// flow through unchanged.
fn retype_var(ar: *Arena, targ: *const Texpr, cty: *const Typ) -> *const Texpr {
    return match targ.e {
        TexprNode::TVar(n) => te_node(ar, TexprNode::TVar(n), cty, targ.pos)
        // An own field lent out (`cur = cur.next` / `&own_field` arg) keeps
        // the same access node but re-types to the borrow (`own *T` -> `*const T`).
        | TexprNode::TFieldAccess { target, field } => te_node(ar, TexprNode::TFieldAccess { target: target, field: field }, cty, targ.pos)
        | _other => targ
    };
}
// Only a PLACE can lend: the owner keeps living somewhere else, so the loan has
// something to outlive.  A fresh owned RVALUE (`new(a) ...`, an own-returning call)
// in a borrow slot would leave the allocation with NO owner — nothing tracks it,
// nothing releases it.
fn is_place_expr(te: *const Texpr) -> bool {
    return match te.e {
        TexprNode::TVar(_n) => true
        | TexprNode::TFieldAccess { target, field } => true
        | TexprNode::TIndex { base, index } => true
        | TexprNode::TDeref(_s) => true
        | _o => false
    };
}
// An `own *T` flowing into a borrow slot (`*T` / `*const T`) is a LOAN: restamp it
// to the slot's type so the move pass (which keys consume on the STAMPED type) keeps
// the owner live for its own free/drop.  Applied at every borrow slot — call args,
// method receivers, let/assign, struct-literal fields, enum-variant args.  `own *T`
// and `*T` are the same `T*` in C: type-level only, zero codegen change.
fn coerce_own_to(_a: Allocator, ar: *Arena, sc: *const TyScope, targ: *const Texpr, pty: *const Typ) -> *const Texpr {
    if is_own_ptr(targ.ty) {
        if !ptr_or_constptr(pty) { return targ; }
        if is_place_expr(targ) { return retype_var(ar, targ, pty); }
        tc_fail(ar, sc, targ.pos,
                "this owned value is only borrowed here, so nothing would own (or ever release) the allocation — bind it first (`let x: own *T = ...;`), then lend `x`");
        return targ;
    }
    // A value passed where a `*T` / `*const T` is expected auto-refs (`&arg`).
    if ptr_or_constptr(pty) && !is_ptr_ty(targ.ty) {
        return te_node(ar, TexprNode::TRef(targ), pty, targ.pos);
    }
    return targ;
}
// Coerce `targ` against the `i`-th parameter type of `params` (the param type
// is only ever passed onward into a node, never returned, so no local slice
// element escapes).
fn coerce_against_params(a: Allocator, ar: *Arena, sc: *const TyScope, params: *const Vec<*const Typ>, i: u32, targ: *const Texpr) -> *const Texpr {
    if i >= params.length() { return targ; }
    let ps = params.as_slice();
    return coerce_own_to(a, ar, sc, targ, ps[i]);
}
fn coerce_at(a: Allocator, ar: *Arena, sc: *const TyScope, mangled: str, i: u32, targ: *const Texpr) -> *const Texpr {
    let gsigs = sc.sc_gsigs;
    let n = gsigs.length();
    let sl = gsigs.as_slice();
    let mut j = 0 as u32;
    while j < n {
        if str::eq(sl[j].fs_mangled, mangled) { return coerce_against_params(a, ar, sc, &sl[j].fs_params, i, targ); }
        j = j + 1 as u32;
    }
    return targ;
}
fn elab_args_coerced(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                     mangled: str, args: *const Vec<*const Expr>) -> Vec<*const Texpr> {
    let mut out: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n {
        let targ = elab_expr(a, ar, g, sc, env, none_ty(), sl[i]);
        out.push(coerce_at(a, ar, sc, mangled, i, targ));
        i = i + 1 as u32;
    }
    return out;
}

// Register a conditional prelude struct (Allocator / String / StringBuilder)
// in the footer when a value of it is produced by a call (e.g. an extern
// `make_c_allocator() -> Allocator`).
fn is_named_prelude_ty(t: *const Typ) -> bool {
    return match *t {
        Typ::TStruct(path) => { let nm = path_last(&path); str::eq(nm, "Allocator") || str::eq(nm, "String") || str::eq(nm, "StringBuilder") }
        | _e => false
    };
}

// Field shapes of the own-carrying named prelude structs, registered into
// `sc_mono_fields` when the struct is registered so the drop pass (which
// walks a struct's field tree) sees their `own *u8` buffer + sibling fields.
// Mirrors the oracle's prelude struct definitions.
fn pf_u8ptr(ar: *Arena) -> *const Typ {
    return ty_node(ar, Typ::TOwnPtr(ty_node(ar, Typ::TInt(IntKind { is_signed: false, width: IntWidth::W8 }))));
}
fn pf_u32(ar: *Arena) -> *const Typ {
    return ty_node(ar, Typ::TInt(IntKind { is_signed: false, width: IntWidth::W32 }));
}
fn pf_alloc(a: Allocator, ar: *Arena) -> *const Typ {
    let mut ap: Vec<str> = Vec::with_capacity(a, 8 as u32);
    ap.push("Allocator");
    return ty_node(ar, Typ::TStruct(ap));
}
fn pf(_a: Allocator, out: *Vec<FieldTy>, name: str, ty: *const Typ) {
    out.push(FieldTy { name: name, ty: ty });
    return;
}

fn is_named_prelude_name(nm: str) -> bool {
    return str::eq(nm, "String") || str::eq(nm, "StringBuilder") || str::eq(nm, "Arena");
}

// Hardcoded field shapes of the own-carrying named prelude structs (String /
// StringBuilder / Arena).  The port never resolves their fields by name (only
// methods), so nothing registers them; the drop pass needs the `own *u8`
// buffer + `len`/`cap`/`alloc` siblings to walk the field tree and size the
// free.  Mirrors the oracle's prelude struct definitions.
fn named_prelude_fields(a: Allocator, ar: *Arena, nm: str) -> Vec<FieldTy> {
    let mut out: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    if str::eq(nm, "String") {
        pf(a, &out, "ptr", pf_u8ptr(ar)); pf(a, &out, "len", pf_u32(ar)); pf(a, &out, "alloc", pf_alloc(a, ar));
    }
    if str::eq(nm, "StringBuilder") {
        pf(a, &out, "buf", pf_u8ptr(ar)); pf(a, &out, "len", pf_u32(ar));
        pf(a, &out, "cap", pf_u32(ar)); pf(a, &out, "alloc", pf_alloc(a, ar));
    }
    if str::eq(nm, "Arena") {
        pf(a, &out, "buf", pf_u8ptr(ar)); pf(a, &out, "cap", pf_u32(ar));
        pf(a, &out, "off", pf_u32(ar)); pf(a, &out, "alloc", pf_alloc(a, ar));
    }
    return out;
}
fn register_struct_ty(a: Allocator, sc: *const TyScope, t: *const Typ) {
    match *t {
        Typ::TStruct(path) => { register_mono_struct(a, sc, &path); }
        | _e => { }
    }
    return;
}
fn register_named_prelude(a: Allocator, sc: *const TyScope, t: *const Typ) {
    if is_named_prelude_ty(t) { register_struct_ty(a, sc, t); }
    return;
}
fn mk_user_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                gf: GlobalFn, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    let targs = elab_args_coerced(a, ar, g, sc, env, gf.mangled, args);
    let ty = ret_or_void(ar, gf.ret);
    register_named_prelude(a, sc, ty);
    return te_node(ar, TexprNode::TCall { mangled: gf.gf_emit, args: targs }, ty, p);
}

fn call_or_defer(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                 gf: GlobalFn, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    if gf.is_const { return defer_expr(ar, p); }
    return mk_user_call(a, ar, g, sc, env, gf, args, p);
}

// An unqualified call inside a module resolves to that module's `mod__name`
// symbol first (module-internal scope), else a top-level fn.
fn module_internal_lookup(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, name: str) -> Option<GlobalFn> {
    if sc.sc_modpath.length() == 0 as u32 {
        let none: Option<GlobalFn> = Option::None;
        return none;
    }
    let m = mangle_path(a, ar, sc.sc_modpath, name);
    return global_lookup_by_mangled(g, m);
}
fn unknown_fn(a: Allocator, ar: *Arena, sc: *const TyScope, display: str, p: Pos) -> *const Texpr {
    tc_fail(ar, sc, p, msg2(a, ar, "unknown function '", display, "'"));
    return defer_expr(ar, p);
}
fn elab_top_or_defer(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                     name: str, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    return match global_lookup(g, name) {
        Option::Some(gf) => call_or_defer(a, ar, g, sc, env, gf, args, p)
        | Option::None => unknown_fn(a, ar, sc, name, p)
    };
}
fn elab_user_or_defer(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                      name: str, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    return match module_internal_lookup(a, ar, g, sc, name) {
        Option::Some(gf) => call_or_defer(a, ar, g, sc, env, gf, args, p)
        | Option::None => elab_top_or_defer(a, ar, g, sc, env, name, args, p)
    };
}

// ===== Enum construction =====
//
// `Path::Variant` parses three ways: a unit variant as `EnumLit`, a tuple
// variant `V(a, b)` as a `Call` whose callee is `[enum-path…, V]`, and a
// struct variant `V { f: .. }` as a `StructLit` with the same path shape.
// All three lower to a `TEnumLit` when the index knows the variant.

fn path_last(callee: *const Vec<str>) -> str {
    let n = callee.length();
    if n == 0 as u32 { return ""; }
    let sl = callee.as_slice();
    return sl[n - 1 as u32];
}

fn path_init(a: Allocator, callee: *const Vec<str>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let n = callee.length();
    let sl = callee.as_slice();
    let mut i = 0 as u32;
    while i + 1 as u32 < n { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}

fn mk_enum_lit_node(a: Allocator, ar: *Arena, epath: *const Vec<str>, variant: str, tag: int,
                    tfields: Vec<TexprField>, p: Pos) -> *const Texpr {
    let ety = ty_node(ar, Typ::TEnum(copy_strs(a, epath)));
    return te_node(ar, TexprNode::TEnumLit { ename_path: copy_strs(a, epath), variant: variant,
                                             tag: tag, args: tfields }, ety, p);
}

// Tuple-variant payload: positional args get names `_0`, `_1`, … and
// elaborate against their declared payload-field types.
fn enum_tuple_args(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                   epath: *const Vec<str>, variant: str, args: *const Vec<*const Expr>) -> Vec<TexprField> {
    let mut out: Vec<TexprField> = Vec::with_capacity(a, 8 as u32);
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n {
        let fname = tuple_field_name(a, ar, i);
        let exp = enum_field_ty(sc.sc_efields, epath, variant, fname);
        // A variant payload is a borrow slot too.
        out.push(TexprField { name: fname, value: loan_into(a, ar, sc, elab_expr(a, ar, g, sc, env, exp, sl[i]), exp) });
        i = i + 1 as u32;
    }
    return out;
}

// Struct-variant payload: declared field names, each elaborated against its
// declared payload-field type.
fn enum_struct_args(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                    epath: *const Vec<str>, variant: str, fields: *const Vec<Field>) -> Vec<TexprField> {
    let mut out: Vec<TexprField> = Vec::with_capacity(a, 8 as u32);
    let n = fields.length();
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < n {
        let exp = enum_field_ty(sc.sc_efields, epath, variant, sl[i].name);
        out.push(TexprField { name: sl[i].name, value: loan_into(a, ar, sc, elab_expr(a, ar, g, sc, env, exp, sl[i].value), exp) });
        i = i + 1 as u32;
    }
    return out;
}

// Lower the call to a known method's mangled symbol, args passed verbatim
// (UFCS / static form — the user supplies `self` explicitly, if any).
// Register the prelude structs a prelude-method call brings into the footer:
// the receiver struct, plus a `Slice<u8>` return (as_slice) and its fields.
fn mret_is_slice(mret: Option<*const Typ>) -> bool {
    return match mret { Option::Some(t) => is_slice_instance(t) | Option::None => false };
}
// Field shapes of the named prelude structs (StringBuilder/String/Arena) into
// the field-access resolution table.  The port historically resolved these by
// method only, so nothing registered their fields for name access; the source-
// prelude method bodies (`self.len`, `self.buf[...]`) need them.  Not dumped
// (sc_mono_fields feeds resolution, not the footer), so no SIG-DIVERGE.
fn named_prelude_fields_present(sc: *const TyScope, nm: str) -> bool {
    let sl = sc.sc_mono_fields.as_slice();
    let mut i = 0 as u32;
    while i < sc.sc_mono_fields.length() {
        if sl[i].sf_path.length() == 1 as u32 && str::eq(sl[i].sf_path.as_slice()[0 as u32], nm) { return true; }
        i = i + 1 as u32;
    }
    return false;
}
fn register_named_prelude_field_access(a: Allocator, ar: *Arena, sc: *const TyScope, nm: str) {
    if !is_named_prelude_name(nm) { return; }
    if named_prelude_fields_present(sc, nm) { return; }
    let fs = named_prelude_fields(a, ar, nm);
    let fsl = fs.as_slice();
    let mut path0: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path0.push(nm);
    let mut i = 0 as u32;
    while i < fs.length() {
        push_named_field(a, sc, &path0, fsl[i].name, fsl[i].ty);
        i = i + 1 as u32;
    }
}
// Push behind a fn boundary so the fresh `sf_path` copy is a parameter, not a
// loop-body lifted temp the move-checker would flag as re-consumed.
fn push_named_field(a: Allocator, sc: *const TyScope, path0: *const Vec<str>, nm: str, ty: *const Typ) {
    sc.sc_mono_fields.push(StructField { sf_path: copy_strs(a, path0), sf_name: nm, sf_ty: ty });
}
fn register_prelude_method_use(a: Allocator, ar: *Arena, sc: *const TyScope, mpath: *const Vec<str>, mret: Option<*const Typ>) {
    register_mono_struct(a, sc, mpath);
    register_named_prelude_field_access(a, ar, sc, path_last(mpath));
    if mret_is_slice(mret) { register_slice_u8(a, ar, sc); }
    // Any String use materialises the `Slice<u8>` byte view + StringBuilder.
    let last = path_last(mpath);
    if str::eq(last, "String") {
        register_slice_u8(a, ar, sc);
        let mut sbp: Vec<str> = Vec::with_capacity(a, 8 as u32);
        sbp.push("StringBuilder");
        register_mono_struct(a, sc, &sbp);
    }
    return;
}
// A generic static prelude method (`Vec::with_capacity` -> `Vec<T>`): the
// tparam is unreachable through the value arguments, so it is recovered from
// the expected type's instance (the `let v: Vec<int>` annotation).
fn mk_static_gen_method_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                             env: *const Vec<FieldTy>, expected: Option<*const Typ>, midx: u32, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    let sl = sc.sc_methods.as_slice();
    let base = sl[midx].mi_mangled;
    let mut binds: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
    match expected {
        Option::Some(e) => bind_recv_tparams(a, ar, sc, &sl[midx].mi_path, &recv_base_path(a, e), &binds)
        | Option::None => { }
    }
    let cscope = scope_with_tbinds(sc, &sl[midx].mi_tparams, &binds);
    let cret = resolve_sig_ret(a, ar, &cscope, sl[midx].mi_ret_ann);
    let oargs = binds_in_tparam_order(a, ar, &sl[midx].mi_tparams, &binds);
    let inst = fn_instance_mangled(a, ar, base, &oargs);
    if sl[midx].mi_prelude {
        register_mono_struct(a, sc, &sl[midx].mi_path);
        let no_self: Vec<str> = Vec::with_capacity(a, 8 as u32);
        queue_prelude_gen(a, sc, path_last(&sl[midx].mi_path), sl[midx].mi_name, &binds, inst, &no_self);
    }
    let targs = elab_args(a, ar, g, sc, env, args);
    return te_node(ar, TexprNode::TCall { mangled: inst, args: targs }, ret_or_void(ar, cret), p);
}
fn mk_static_method_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                         env: *const Vec<FieldTy>, expected: Option<*const Typ>, midx: int, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    let sl = sc.sc_methods.as_slice();
    if sl[midx as u32].mi_tparams.length() > 0 as u32 {
        return mk_static_gen_method_call(a, ar, g, sc, env, expected, midx as u32, args, p);
    }
    let mm = sl[midx as u32].mi_mangled;
    let mret = sl[midx as u32].mi_ret;
    if sl[midx as u32].mi_prelude { register_prelude_method_use(a, ar, sc, &sl[midx as u32].mi_path, mret); }
    let targs = elab_args(a, ar, g, sc, env, args);
    return te_node(ar, TexprNode::TCall { mangled: mm, args: targs }, ret_or_void(ar, mret), p);
}

// ===== Generic-fn call instantiation =====

fn copy_tvarbinds(a: Allocator, src: *const Vec<TVarBind>) -> Vec<TVarBind> {
    let mut out: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
    let n = src.length();
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(TVarBind { tvb_name: sl[i].tvb_name, tvb_ty: sl[i].tvb_ty }); i = i + 1 as u32; }
    return out;
}

fn subst_opt_ret(ar: *Arena, binds: *const Vec<TVarBind>, ret: Option<*const Typ>) -> Option<*const Typ> {
    return match ret {
        Option::Some(t) => Option::Some(subst_typ(ar, binds, t))
        | Option::None => { let nn: Option<*const Typ> = Option::None; nn }
    };
}

fn gen_fn_lookup(genfns: *const Vec<GenFn>, name: str) -> int {
    let n = genfns.length();
    let sl = genfns.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].gn_name, name) { return i as int; }
        i = i + 1 as u32;
    }
    return 0 as int - 1 as int;
}

// Infer tparam bindings for a generic-fn call by unifying each parameter's
// declared type (resolved under the callee's tparams) against the argument.
fn infer_call_binds(a: Allocator, ar: *Arena, cscope: *const TyScope, anns: *const Vec<*const TypeAnn>,
                    targs: *const Vec<*const Texpr>, out: *Vec<TVarBind>) {
    let n = anns.length();
    let asl_ann = anns.as_slice();
    let an = targs.length();
    let asl = targs.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i < an {
            let ptype = resolve_sig_ty(a, ar, cscope, asl_ann[i]);
            unify_typ(ptype, asl[i].ty, out);
        }
        i = i + 1 as u32;
    }
}

// Queue a generic-fn instance for the post-pass drain, once per mangled name.
fn queue_gen_instance(a: Allocator, sc: *const TyScope, gi: u32, binds: *const Vec<TVarBind>, mangled: str) {
    if name_in(sc.sc_geninsts, mangled) { return; }
    sc.sc_geninsts.push(mangled);
    let no_target: Vec<str> = Vec::with_capacity(a, 8 as u32);
    sc.sc_genjobs.push(GenJob { gj_idx: gi, gj_meth: 0 as int - 1 as int, gj_binds: copy_tvarbinds(a, binds), gj_mangled: mangled, gj_target: no_target, gj_prelude: false });
}

// Queue a prelude generic method instance (Vec/VecIter/adapter): its source
// body is in the parsed prelude items, so `gj_target` carries (type, name) for
// the drain to look up in the prelude registry.  Dedup by mangled name so a
// second `v.push(...)` (or a transitive `self.grow`) queues once.
fn queue_prelude_gen(a: Allocator, sc: *const TyScope, ty: str, nm: str, binds: *const Vec<TVarBind>, mangled: str, self_inst: *const Vec<str>) {
    if name_in(sc.sc_geninsts, mangled) { return; }
    sc.sc_geninsts.push(mangled);
    // gj_target = [pm_type, pm_name] ++ receiver-instance path.  The first two
    // locate the source in the prelude registry; the rest pins `Self` when the
    // source is an Iterator TRAIT DEFAULT (elaborate_method_instance's
    // Item::Trait arm), whose body mentions Self in `Map<Self, F>` et al.
    let mut tgt: Vec<str> = Vec::with_capacity(a, 8 as u32);
    tgt.push(ty);
    tgt.push(nm);
    let isl = self_inst.as_slice();
    let mut i = 0 as u32;
    while i < self_inst.length() { tgt.push(isl[i]); i = i + 1 as u32; }
    sc.sc_genjobs.push(GenJob { gj_idx: 0 as u32, gj_meth: 0 as int - 1 as int, gj_binds: copy_tvarbinds(a, binds), gj_mangled: mangled, gj_target: tgt, gj_prelude: true });
}

// Queue a generic-method instance: the impl (or trait, for a generic default)
// item index + the method index locate the source fn for the drain; `target`
// pins `Self` when the source is a trait default.
fn queue_method_instance(a: Allocator, sc: *const TyScope, impl_idx: u32, meth_idx: u32,
                         binds: *const Vec<TVarBind>, mangled: str, target: *const Vec<str>) {
    if name_in(sc.sc_geninsts, mangled) { return; }
    sc.sc_geninsts.push(mangled);
    sc.sc_genjobs.push(GenJob { gj_idx: impl_idx, gj_meth: meth_idx as int, gj_binds: copy_tvarbinds(a, binds), gj_mangled: mangled, gj_target: copy_strs(a, target), gj_prelude: false });
}

// `mod::fn(args)` — a module-qualified call resolves to the `mod__fn` C
// symbol via the global table; an unknown path defers to a marker.
// Resolve a `mod::fn` path to a global, trying the path as written first and
// then module-relative (prepending the current module path), so a nested
// `raw::abort` inside a hoisted `mod error` finds `error::raw::abort`.
fn modrel_lookup(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, init: *const Vec<str>, last: str) -> Option<GlobalFn> {
    if sc.sc_modpath.length() == 0 as u32 { let none: Option<GlobalFn> = Option::None; return none; }
    let qinit = path_concat(a, sc.sc_modpath, init);
    return global_lookup_by_mangled(g, mangle_path(a, ar, &qinit, last));
}
fn qualified_lookup(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, init: *const Vec<str>, last: str) -> Option<GlobalFn> {
    return match global_lookup_by_mangled(g, mangle_path(a, ar, init, last)) {
        Option::Some(gf) => Option::Some(gf)
        | Option::None => modrel_lookup(a, ar, g, sc, init, last)
    };
}
fn elab_qualified_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                       init: *const Vec<str>, last: str, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    return match qualified_lookup(a, ar, g, sc, init, last) {
        Option::Some(gf) => call_or_defer(a, ar, g, sc, env, gf, args, p)
        | Option::None => unknown_fn(a, ar, sc, path_display(a, ar, &path_push(a, init, last)), p)
    };
}

// Bidirectional seed: a tparam unreachable through arguments (`make_null<T>()`
// returning `*T`) gets its binding from the surrounding expected type by
// unifying the resolved return type against it.  Seeded after the argument
// pairs so an argument-derived binding wins the dedup.
fn seed_from_expected(cret: Option<*const Typ>, expected: Option<*const Typ>, out: *Vec<TVarBind>) {
    match cret {
        Option::Some(r) => match expected {
            Option::Some(e) => unify_typ(r, e, out)
            | Option::None => { }
        }
        | Option::None => { }
    }
}

// `gen_fn(args)` → a monomorphic call `ex_fn_<args>(args)`, queuing the
// instance for elaboration.
fn elab_gen_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                 gfidx: int, expected: Option<*const Typ>, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    let gsl = sc.sc_genfns.as_slice();
    let gi = gsl[gfidx as u32].gn_idx;
    let base = gsl[gfidx as u32].gn_mangled;
    let targs = elab_args(a, ar, g, sc, env, args);
    let cscope = scope_with_tparams(sc, &gsl[gfidx as u32].gn_tparams);
    let cret = resolve_sig_ret(a, ar, &cscope, gsl[gfidx as u32].gn_ret);
    let mut binds: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
    infer_call_binds(a, ar, &cscope, &gsl[gfidx as u32].gn_params, &targs, &binds);
    seed_from_expected(cret, expected, &binds);
    let oargs = dedup_bind_tys(a, &binds);
    let inst = fn_instance_mangled(a, ar, base, &oargs);
    queue_gen_instance(a, sc, gi, &binds, inst);
    // Re-resolve the return with the inferred bindings IN SCOPE so a generic
    // application (`Vec<T>`) or assoc projection (`Option<I::Item>`) lowers to
    // its concrete instance, not a `subst` that leaves the app abstract.
    let icscope = scope_with_tbinds(sc, &gsl[gfidx as u32].gn_tparams, &binds);
    let iret = resolve_sig_ret(a, ar, &icscope, gsl[gfidx as u32].gn_ret);
    return te_node(ar, TexprNode::TCall { mangled: inst, args: targs }, ret_or_void(ar, iret), p);
}

// `str::*` free functions (OCaml-style, not methods).  `as_bytes` yields a
// `Slice<u8>` view (registering the instance so `.len` / `[i]` resolve).
fn t_u8(ar: *Arena) -> *const Typ {
    return ty_node(ar, Typ::TInt(IntKind { is_signed: false, width: IntWidth::W8 }));
}
// Register `Slice<elem>` (the first arg of a `Vec<elem>`) so the slice view a
// Vec's accessors yield rides in the footer.
fn register_slice_of(a: Allocator, ar: *Arena, sc: *const TyScope, args: *const Vec<*const Typ>, fields_only: bool) {
    if args.length() == 0 as u32 { return; }
    let sl = args.as_slice();
    let mut sargs: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    sargs.push(sl[0 as u32]);
    let mut skel: Vec<str> = Vec::with_capacity(a, 8 as u32);
    skel.push("Slice");
    let ipath = instance_path(a, ar, &skel, &sargs);
    if !fields_only { register_mono_struct_args(a, sc, &ipath, &sargs); }
    register_prelude_struct_fields(a, ar, sc, "Slice", &sargs, &ipath);
}
// Register `Name<arg>` as a monomorphic instance (`Take<Count>` -> Take_ex_Count).
// `fields_only`: the prelude struct SKELETONS only reach `sinfo` after the
// footprint window is registered, so the first pass has nothing to substitute
// and the instance would emit as `struct ex_Vec_i32 { };`.  A second pass re-runs
// the field substitution once the skeletons are in scope, without touching
// mono_structs (whose order IS the emission order).
fn register_app_mono(a: Allocator, ar: *Arena, sc: *const TyScope, name: str, arg_ty: *const Typ, fields_only: bool) {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(name);
    let mut args: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    args.push(arg_ty);
    let ipath = instance_path(a, ar, &path, &args);
    if fields_only {
        register_prelude_struct_fields(a, ar, sc, name, &args, &ipath);
        return;
    }
    register_mono_struct_args(a, sc, &ipath, &args);
}
// Every concrete `impl Iterator for X` carries the Self-pinned return types of
// Iterator's default methods in the footer, even when none are called: `take`
// -> Take<X>, `enumerate` -> Enumerate<X>, `collect` -> Vec<X::Item> (+ its
// Slice view) over an Allocator.  Map / Filter need the call-site `F`, so they
// stay base-only until used.
fn register_iter_footprint(a: Allocator, ar: *Arena, sc: *const TyScope, target: str, item_ty: *const Typ, fields_only: bool) {
    let tgt_ty = ty_node(ar, Typ::TStruct(one_path(a, target)));
    register_app_mono(a, ar, sc, "Take", tgt_ty, fields_only);
    register_app_mono(a, ar, sc, "Enumerate", tgt_ty, fields_only);
    let mut vargs: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    vargs.push(item_ty);
    register_app_mono(a, ar, sc, "Vec", item_ty, fields_only);
    // The Vec's Slice view is NOT part of the footprint: the oracle registers it
    // where `as_slice` materializes — at the END of the mono section, after every
    // footprint instance.  Register its fields only, never its position.
    register_slice_of(a, ar, sc, &vargs, true);
    if !fields_only { register_mono_struct(a, sc, &allocator_path(a)); }
}
// The GHOST of a DCE'd `Vec::as_slice`: the oracle prepends the whole prelude, so
// every `Vec<T>` instance materializes an `as_slice` whose return type registers
// `Slice<T>` — and the struct survives the DCE that later deletes the method.
// The port materializes on demand, so it never sees that method; replay the side
// effect here, at the END of the mono list, which is where the oracle's prelude
// materialization puts it.
fn register_slice_elem(a: Allocator, ar: *Arena, sc: *const TyScope, elem: *const Typ) {
    let mut args: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    args.push(elem);
    register_slice_of(a, ar, sc, &args, false);
    return;
}
fn register_vec_slice_views(a: Allocator, ar: *Arena, sc: *const TyScope,
                            mono_structs: *const Vec<Vec<str>>, mono_sargs: *const Vec<Vec<*const Typ>>) {
    // Collect FIRST, register second: registering pushes into mono_structs, and a
    // grow reallocates the buffer the loop's slice points at (a use-after-free the
    // port's own source triggered — the corpus never grew the Vec mid-walk).
    let n = mono_structs.length();
    let mut elems: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let mut i = 0 as u32;
    while i < n {
        let msl = mono_structs.as_slice();
        let sal = mono_sargs.as_slice();
        if str_starts_with(path_last(&msl[i]), "Vec_") && sal[i].length() == 1 as u32 {
            elems.push(sal[i].as_slice()[0 as u32]);
        }
        i = i + 1 as u32;
    }
    let mut j = 0 as u32;
    while j < elems.length() {
        register_slice_elem(a, ar, sc, elems.as_slice()[j]);
        j = j + 1 as u32;
    }
    return;
}
fn register_iter_footprints(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>, assoc: *const Vec<AssocBind>, fields_only: bool) {
    // Only the prelude Iterator carries combinator defaults.  A user-declared
    // `trait Iterator` shadows it (associated_types declares its own with no
    // defaults), so its impls get no footprint.
    if find_trait_idx(items, "Iterator") >= 0 as int { return; }
    let n = assoc.length();
    let sl = assoc.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].ab_trait, "Iterator") && sl[i].ab_tparams.length() == 0 as u32 {
            register_iter_footprint(a, ar, sc, sl[i].ab_target, resolve_sig_ty(a, ar, sc, sl[i].ab_ty), fields_only);
        }
        i = i + 1 as u32;
    }
}
fn register_slice_u8(a: Allocator, ar: *Arena, sc: *const TyScope) -> *const Typ {
    let mut args: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    args.push(t_u8(ar));
    let mut skel: Vec<str> = Vec::with_capacity(a, 8 as u32);
    skel.push("Slice");
    let ipath = instance_path(a, ar, &skel, &args);
    register_mono_struct(a, sc, &ipath);
    register_prelude_struct_fields(a, ar, sc, "Slice", &args, &ipath);
    return ty_node(ar, Typ::TStruct(copy_strs(a, &ipath)));
}
fn str_method_ret(a: Allocator, ar: *Arena, sc: *const TyScope, method: str) -> *const Typ {
    if str::eq(method, "length") { return t_u32(ar); }
    if str::eq(method, "hash") { return t_u32(ar); }
    if str::eq(method, "cmp") { return t_i32(ar); }
    if str::eq(method, "eq") { return t_bool(ar); }
    if str::eq(method, "from_slice") { return t_str(ar); }
    if str::eq(method, "as_bytes") { return register_slice_u8(a, ar, sc); }
    return ty_node(ar, Typ::TCVoid);
}
fn elab_str_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                 method: str, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    let targs = elab_args(a, ar, g, sc, env, args);
    let m = str2(a, ar, "str__", method);
    return te_node(ar, TexprNode::TCall { mangled: m, args: targs }, str_method_ret(a, ar, sc, method), p);
}

// `println(x)` / `print(x)` where `x`'s type implements `Display` (its
// path carries an `fmt` method) lowers to the writer pattern (DR-002):
// a temp StringBuilder renders `x` through `fmt`, a String is built, its
// `as_str()` printed, and the String freed.  Without this the print
// builtin only accepts scalars — Display is the user-facing surface for
// aggregates.  The temp names ride the program-global gensym counter.
fn display_dispatch_target(sc: *const TyScope, t: *const Typ) -> bool {
    return match *t {
        Typ::TStruct(path) => find_method_idx(sc.sc_methods, &path, "fmt") >= 0 as int
        | Typ::TEnum(path) => find_method_idx(sc.sc_methods, &path, "fmt") >= 0 as int
        | _e => false
    };
}

fn tyann_node(ar: *Arena, t: TypeAnn) -> *const TypeAnn {
    let n: *TypeAnn = ar.alloc_borrowed();
    if n == null { arena_oom(); }
    *n = t;
    return n as *const TypeAnn;
}

fn elab_display_println(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                        env: *const Vec<FieldTy>, expected: Option<*const Typ>, print_name: str,
                        user_arg: *const Expr, p: Pos) -> *const Texpr {
    let k = *sc.sc_gensym;
    *sc.sc_gensym = *sc.sc_gensym + 1 as u32;
    let sb_name = gensym_name(a, ar, "__disp_sb_", k);
    let s_name = gensym_name(a, ar, "__disp_s_", k);
    // Building a String through the writer pattern materializes its
    // `Slice<u8>` view (the prelude `as_str` / `as_slice` surface), which
    // the oracle's String prelude bodies always pull into the footer.
    register_slice_u8(a, ar, sc);

    // StringBuilder::with_capacity(default_allocator(), 32 as u32)
    let mut alloc_callee: Vec<str> = Vec::with_capacity(a, 8 as u32);
    alloc_callee.push("default_allocator");
    let no_args0: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    let make_alloc = ast_node(ar, Expr::Call { callee: alloc_callee, args: no_args0, pos: p });
    let u32ann = tyann_node(ar, TypeAnn::TyInt { is_signed: false, width: IntWidth::W32 });
    let cap_arg = ast_node(ar, Expr::Cast(ast_node(ar, Expr::IntLit(32 as int, p)), u32ann, p));
    let mut sb_callee: Vec<str> = Vec::with_capacity(a, 8 as u32);
    sb_callee.push("StringBuilder");
    sb_callee.push("with_capacity");
    let mut sb_args: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    sb_args.push(make_alloc);
    sb_args.push(cap_arg);
    let sb_init = ast_node(ar, Expr::Call { callee: sb_callee, args: sb_args, pos: p });

    // user_arg.fmt(&sb)
    let sb_ref = ast_node(ar, Expr::Ref(ast_node(ar, Expr::Var(sb_name, p)), p));
    let mut fmt_args: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    fmt_args.push(sb_ref);
    let fmt_call = ast_node(ar, Expr::MethodCall { receiver: user_arg, name: "fmt", args: fmt_args, pos: p });

    // String::build(sb)
    let mut build_callee: Vec<str> = Vec::with_capacity(a, 8 as u32);
    build_callee.push("String");
    build_callee.push("build");
    let mut build_args: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    build_args.push(ast_node(ar, Expr::Var(sb_name, p)));
    let build_call = ast_node(ar, Expr::Call { callee: build_callee, args: build_args, pos: p });

    // println(s.as_str())
    let no_args1: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    let as_str_call = ast_node(ar, Expr::MethodCall { receiver: ast_node(ar, Expr::Var(s_name, p)), name: "as_str", args: no_args1, pos: p });
    let mut print_callee: Vec<str> = Vec::with_capacity(a, 8 as u32);
    print_callee.push(print_name);
    let mut print_args: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    print_args.push(as_str_call);
    let inner_print = ast_node(ar, Expr::Call { callee: print_callee, args: print_args, pos: p });

    // s.free()
    let no_args2: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    let free_call = ast_node(ar, Expr::MethodCall { receiver: ast_node(ar, Expr::Var(s_name, p)), name: "free", args: no_args2, pos: p });

    let no_ann: Option<*const TypeAnn> = Option::None;
    let mut block_stmts: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    block_stmts.push(Stmt::Let { name: sb_name, value: sb_init, ty_ann: no_ann, is_mut: true, pos: p });
    block_stmts.push(Stmt::ExprStmt(fmt_call));
    block_stmts.push(Stmt::Let { name: s_name, value: build_call, ty_ann: no_ann, is_mut: false, pos: p });
    block_stmts.push(Stmt::ExprStmt(inner_print));
    block_stmts.push(Stmt::ExprStmt(free_call));
    block_stmts.push(Stmt::Tail(ast_node(ar, Expr::IntLit(0 as int, p))));
    let block = ast_node(ar, Expr::Block(block_stmts, p));
    return elab_expr(a, ar, g, sc, env, expected, block);
}

fn elab_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
             expected: Option<*const Typ>, callee: *const Vec<str>, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    if callee.length() != 1 as u32 {
        // `Path::Variant(..)` — a tuple-enum constructor; `Type::method(..)`
        // — a static / UFCS method call; else (module fn) not yet supported.
        let last = path_last(callee);
        let init = path_init(a, callee);
        if callee.length() == 2 as u32 && str::eq(init.get(0 as u32) orelse "", "str") {
            return elab_str_call(a, ar, g, sc, env, last, args, p);
        }
        // A bare enum name in a variant constructor (`Typ::TVar` for an
        // `ir::Typ`) qualifies the same way a type reference does, so the tag
        // + emitted enum path match the qualified etags.
        let qinit = qualify_type_path(a, ar, sc, &init);
        let tag = variant_tag(sc.sc_etags, &qinit, last);
        if tag >= 0 as int {
            let tflds = enum_tuple_args(a, ar, g, sc, env, &qinit, last, args);
            let inst = enum_instance_path(a, ar, sc, expected, &qinit, last, &tflds);
            return mk_enum_lit_node(a, ar, &inst, last, tag, tflds, p);
        }
        let midx = find_method_idx(sc.sc_methods, &init, last);
        if midx >= 0 as int {
            return mk_static_method_call(a, ar, g, sc, env, expected, midx, args, p);
        }
        return elab_qualified_call(a, ar, g, sc, env, &init, last, args, p);
    }
    let name = callee.get(0 as u32) orelse "";
    if str::eq(name, "println") || str::eq(name, "print") {
        // Elaborate the args once (avoids double side effects — e.g. a
        // lambda argument would otherwise lift twice); then if the sole
        // arg is a Display aggregate, re-route through the writer pattern.
        let targs = elab_args(a, ar, g, sc, env, args);
        if targs.length() == 1 as u32 {
            let tsl = targs.as_slice();
            if display_dispatch_target(sc, tsl[0 as u32].ty) {
                let asl = args.as_slice();
                return elab_display_println(a, ar, g, sc, env, expected, name, asl[0 as u32], p);
            }
        }
        return te_node(ar, TexprNode::TBuiltinCall { name: name, args: targs }, t_i32(ar), p);
    }
    if str::eq(name, "type_name") {
        let tn_args = elab_args(a, ar, g, sc, env, args);
        return te_node(ar, TexprNode::TBuiltinCall { name: name, args: tn_args }, t_str(ar), p);
    }
    if str::eq(name, "cstr_len") {
        let cl_args = elab_args(a, ar, g, sc, env, args);
        return te_node(ar, TexprNode::TBuiltinCall { name: name, args: cl_args }, t_u32(ar), p);
    }
    // `ptr_offset(p, n)` -> `(p + n)`; steps a `u8` base by BYTES and yields a
    // plain borrow into the same storage (a derived pointer is a view, never a
    // second owner).  Arena::alloc_borrowed and str::from_slice ride it.
    if str::eq(name, "ptr_offset") {
        let po_args = elab_args(a, ar, g, sc, env, args);
        return te_node(ar, TexprNode::TBuiltinCall { name: name, args: po_args }, ty_node(ar, Typ::TPtr(t_u8(ar))), p);
    }
    // `mem_zero(ptr, n_bytes)` -> `memset(ptr, 0, n)`; zeroes a freshly-alloc'd
    // slot buffer so the discriminator byte reads Empty without forging a K / V.
    if str::eq(name, "mem_zero") {
        let mz_args = elab_args(a, ar, g, sc, env, args);
        return te_node(ar, TexprNode::TBuiltinCall { name: name, args: mz_args }, t_i32(ar), p);
    }
    if str::eq(name, "len") { return elab_len(a, ar, g, sc, env, args, p); }
    if str::eq(name, "default_allocator") {
        register_mono_struct(a, sc, &allocator_path(a));
        let no_args: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
        return te_node(ar, TexprNode::TBuiltinCall { name: name, args: no_args }, ty_node(ar, Typ::TStruct(allocator_path(a))), p);
    }
    if str::eq(name, "free") {
        let fr_args = elab_args(a, ar, g, sc, env, args);
        return te_node(ar, TexprNode::TBuiltinCall { name: name, args: fr_args }, t_i32(ar), p);
    }
    if env_is_fnptr(env, name) { return mk_fnptr_call(a, ar, g, sc, env, name, args, p); }
    // DR-018 call-desugar: `f(x)` on a local binding whose type implements an
    // `FnN` trait (it has a `call` method) lowers to `f.call(x)`.
    if env_has_call_method(a, sc, env, name) {
        return elab_method_call(a, ar, g, sc, env, expected, ast_node(ar, Expr::Var(name, p)), "call", args, p);
    }
    let gfi = gen_fn_lookup(sc.sc_genfns, name);
    if gfi >= 0 as int { return elab_gen_call(a, ar, g, sc, env, gfi, expected, args, p); }
    return elab_user_or_defer(a, ar, g, sc, env, name, args, p);
}

// A call `f(args)` where `f` is a local binding of fn-ptr type — emitted as a
// direct `(call f ...)` (in C, calling a fn-ptr local is just `f(args)`).
fn is_fnptr_ty(t: *const Typ) -> bool {
    return match *t { Typ::TFnPtr { params, ret } => true | _e => false };
}
fn env_is_fnptr(env: *const Vec<FieldTy>, name: str) -> bool {
    return match env_lookup(env, name) {
        Option::Some(t) => is_fnptr_ty(t)
        | Option::None => false
    };
}
// Does the local binding `name` have a type that implements an FnN trait (a
// `call` method)?  Drives the `f(x)` -> `f.call(x)` desugar.
fn env_has_call_method(a: Allocator, sc: *const TyScope, env: *const Vec<FieldTy>, name: str) -> bool {
    return match env_lookup(env, name) {
        Option::Some(t) => find_method_idx(sc.sc_methods, &recv_base_path(a, t), "call") >= 0 as int
        | Option::None => false
    };
}
fn fnptr_ret_ty(t: *const Typ) -> Option<*const Typ> {
    return match *t { Typ::TFnPtr { params, ret } => ret | _e => none_ty() };
}
fn fnptr_ret_of(env: *const Vec<FieldTy>, name: str) -> Option<*const Typ> {
    return match env_lookup(env, name) {
        Option::Some(t) => match *t { Typ::TFnPtr { params, ret } => ret | _e => none_ty() }
        | Option::None => none_ty()
    };
}
fn mk_fnptr_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                 name: str, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    let targs = elab_args(a, ar, g, sc, env, args);
    return te_node(ar, TexprNode::TCall { mangled: name, args: targs }, ret_or_void(ar, fnptr_ret_of(env, name)), p);
}

// The borrow type `self` declares, built from the receiver's pointee.
fn self_slot_ty(ar: *Arena, trecv: *const Texpr, self_const: bool) -> *const Typ {
    let inner = match deref_pointee(trecv.ty) {
        Option::Some(t) => t
        | Option::None => trecv.ty
    };
    if self_const { return ty_node(ar, Typ::TConstPtr(inner)); }
    return ty_node(ar, Typ::TPtr(inner));
}
// Adjust a method receiver to the self shape the method declares: a value
// receiver to a `*self` method auto-refs (`&recv`); a pointer receiver to a
// by-value `self` method auto-derefs (`*recv`).
fn adjust_recv(a: Allocator, ar: *Arena, sc: *const TyScope, trecv: *const Texpr, recv_ptr: bool, self_ptr: bool, self_const: bool) -> *const Texpr {
    if self_ptr {
        // A pointer receiver already has the right shape — but an `own *T` receiver
        // on a `*self` method is a LOAN, and a fresh owned rvalue there owns nothing.
        if recv_ptr { return coerce_own_to(a, ar, sc, trecv, self_slot_ty(ar, trecv, self_const)); }
        // Auto-ref a value receiver to the self shape: `*const self` borrows
        // read-only (`&recv : *const T`), `*self` mutably (`&recv : *T`).
        let pty = if self_const { ty_node(ar, Typ::TConstPtr(trecv.ty)) } else { ty_node(ar, Typ::TPtr(trecv.ty)) };
        return te_node(ar, TexprNode::TRef(trecv), pty, trecv.pos);
    }
    if !recv_ptr { return trecv; }
    let inner = match deref_pointee(trecv.ty) {
        Option::Some(t) => t
        | Option::None => trecv.ty
    };
    return te_node(ar, TexprNode::TDeref(trecv), inner, trecv.pos);
}

// Elaborate each explicit method argument, coercing it against the method's
// registered signature (self occupies param 0, so explicit arg `i` checks
// against param `i + 1`).  A value passed to a `*const self`-shaped param
// (e.g. `String::eq`'s `other`) auto-refs; methods without a registered sig
// pass through unchanged.
fn append_args_meth(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                    mangled: str, args: *const Vec<*const Expr>, out: *Vec<*const Texpr>) {
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n {
        let targ = elab_expr(a, ar, g, sc, env, none_ty(), sl[i]);
        out.push(coerce_at(a, ar, sc, mangled, i + 1 as u32, targ));
        i = i + 1 as u32;
    }
}

fn push_texprs(targs: *const Vec<*const Texpr>, out: *Vec<*const Texpr>) {
    let n = targs.length();
    let sl = targs.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(sl[i]); i = i + 1 as u32; }
}

// Infer a generic method's tparam bindings: the receiver type pins the self
// param (index 0), the explicit arguments pin the rest.  Each declared type
// resolves under the method's tparams (so its `TVar`s stay symbolic) before
// unifying against the actual type.
fn infer_method_binds(a: Allocator, ar: *Arena, cscope: *const TyScope, anns: *const Vec<*const TypeAnn>,
                      trecv: *const Texpr, targs: *const Vec<*const Texpr>, out: *Vec<TVarBind>) {
    let np = anns.length();
    let asl = anns.as_slice();
    if np > 0 as u32 {
        let p0 = resolve_sig_ty(a, ar, cscope, asl[0 as u32]);
        unify_typ(p0, trecv.ty, out);
    }
    let na = targs.length();
    let tsl = targs.as_slice();
    let mut i = 0 as u32;
    while i < na {
        let pi = i + 1 as u32;
        if pi < np {
            let pt = resolve_sig_ty(a, ar, cscope, asl[pi]);
            unify_typ(pt, tsl[i].ty, out);
        }
        i = i + 1 as u32;
    }
}

// Recover a generic struct's tparam bindings by unifying its skeleton field
// types (which mention the tparams) against the receiver instance's already-
// registered field types — `Vec<T>.ptr : own *T` against `Vec_i32.ptr :
// own *i32` yields `T = i32`.  The mangled instance name discards the args, so
// the registered fields are where the bindings still live.
// A nested generic field (`slots: own *Slot<K,V>` vs the instance's
// `own *Slot_i32_i32`) recovers `K`/`V` by recursing into the inner
// instance's own tparams — `unify_typ` can't un-mangle `Slot_i32_i32`.
fn unify_app_inst(a: Allocator, ar: *Arena, sc: *const TyScope, path: *const Vec<str>, args: *const Vec<*const Typ>, ipath: *const Vec<str>, out: *Vec<TVarBind>) {
    if !inst_of_base(path_last(ipath), path_last(path)) { return; }
    let mut rbinds: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
    bind_recv_tparams(a, ar, sc, path, ipath, &rbinds);
    let stps = sc.sc_stps.as_slice();
    let ns = sc.sc_stps.length();
    let mut si = 0 as u32;
    while si < ns {
        if str::eq(stps[si].stp_name, path_last(path)) {
            let inst_args = binds_in_tparam_order(a, ar, &stps[si].stp_params, &rbinds);
            let na = args.length();
            let asl = args.as_slice();
            let isl = inst_args.as_slice();
            let mut k = 0 as u32;
            while k < na { if k < inst_args.length() { unify_nested(a, ar, sc, asl[k], isl[k], out); } k = k + 1 as u32; }
        }
        si = si + 1 as u32;
    }
    return;
}
fn unify_app_nested(a: Allocator, ar: *Arena, sc: *const TyScope, path: *const Vec<str>, args: *const Vec<*const Typ>, inst: *const Typ, out: *Vec<TVarBind>) {
    match *inst {
        Typ::TStruct(ipath) => unify_app_inst(a, ar, sc, path, args, &ipath, out)
        | _e => {}
    }
}
fn unify_nested(a: Allocator, ar: *Arena, sc: *const TyScope, skel: *const Typ, inst: *const Typ, out: *Vec<TVarBind>) {
    match *skel {
        Typ::TVar(n) => out.push(TVarBind { tvb_name: n, tvb_ty: inst })
        | Typ::TOwnPtr(si) => match *inst { Typ::TOwnPtr(ii) => unify_nested(a, ar, sc, si, ii, out) | _e => {} }
        | Typ::TConstPtr(si) => match *inst { Typ::TConstPtr(ii) => unify_nested(a, ar, sc, si, ii, out) | Typ::TPtr(ii) => unify_nested(a, ar, sc, si, ii, out) | _e => {} }
        | Typ::TPtr(si) => match *inst { Typ::TPtr(ii) => unify_nested(a, ar, sc, si, ii, out) | _e => {} }
        | Typ::TStructApp { path, args } => unify_app_nested(a, ar, sc, &path, &args, inst, out)
        | _other => {}
    }
}
fn bind_recv_tparams(a: Allocator, ar: *Arena, sc: *const TyScope, base_path: *const Vec<str>, inst_path: *const Vec<str>, out: *Vec<TVarBind>) {
    let skel = sc.sc_sinfo;
    let n = skel.length();
    let sl = skel.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if path_eq(&sl[i].sf_path, base_path) {
            match find_field_ty(sc.sc_mono_fields, inst_path, sl[i].sf_name) {
                Option::Some(it) => unify_nested(a, ar, sc, sl[i].sf_ty, it, out)
                | Option::None => { }
            }
        }
        i = i + 1 as u32;
    }
}

// The bound types in tparam-declaration order (the mangling order), so the
// instance name matches the oracle regardless of field order.
fn binds_in_tparam_order(a: Allocator, ar: *Arena, tparams: *const Vec<str>, binds: *const Vec<TVarBind>) -> Vec<*const Typ> {
    let mut out: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let n = tparams.length();
    let sl = tparams.as_slice();
    let mut i = 0 as u32;
    while i < n {
        match bind_lookup(binds, sl[i]) {
            Option::Some(t) => out.push(t)
            | Option::None => out.push(ty_node(ar, Typ::TVar(sl[i])))
        }
        i = i + 1 as u32;
    }
    return out;
}

// `recv.m(args)` on a generic struct (`impl<T> Foo<T>`): bind the impl's
// tparams from the receiver instance, resolve the return type with those
// bindings in scope (so a `Pair<B, A>` return mangles to its instance), queue
// the body, and emit the monomorphic call.
// Bind a struct-gen method's own tparams (those not recovered from the
// receiver fields — e.g. an adapter `map`'s `F`) by unifying each param's
// annotation against the elaborated argument type.  Params whose tparams are
// already recovered resolve to a concrete type, so the unify is a no-op.
fn unify_method_args(a: Allocator, ar: *Arena, sc: *const TyScope, tparams: *const Vec<str>,
                     anns: *const Vec<*const TypeAnn>, targs: *const Vec<*const Texpr>, binds: *Vec<TVarBind>) {
    let cscope = scope_with_tbinds(sc, tparams, binds);
    let na = targs.length();
    let np = anns.length();
    let asl = anns.as_slice();
    let tsl = targs.as_slice();
    let mut i = 0 as u32;
    while i < na {
        let pi = i + 1 as u32;
        if pi < np {
            let pt = resolve_sig_ty(a, ar, &cscope, asl[pi]);
            unify_typ(pt, tsl[i].ty, binds);
        }
        i = i + 1 as u32;
    }
}
fn mk_struct_gen_method_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                             midx: u32, trecv: *const Texpr, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    let sl = sc.sc_methods.as_slice();
    let base = sl[midx].mi_mangled;
    let sptr = sl[midx].mi_self_ptr;
    let scst = sl[midx].mi_self_const;
    let iidx = sl[midx].mi_impl_idx;
    let midx2 = sl[midx].mi_meth_idx;
    let inst_path = recv_base_path(a, trecv.ty);
    let mut binds: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
    bind_recv_tparams(a, ar, sc, &sl[midx].mi_path, &inst_path, &binds);
    let targs = elab_args(a, ar, g, sc, env, args);
    // Adapter methods carry a method-only tparam (`F`) bound from the args; for
    // ordinary struct-gen methods every tparam is already recovered, so this is
    // a no-op.  Binding it before `cret` lets the adapter return instance
    // (`Map<VecIter<T>, F>`) resolve + register.
    unify_method_args(a, ar, sc, &sl[midx].mi_tparams, &sl[midx].mi_params, &targs, &binds);
    let cscope = scope_with_tbinds(sc, &sl[midx].mi_tparams, &binds);
    let cret = resolve_sig_ret(a, ar, &cscope, sl[midx].mi_ret_ann);
    let oargs = binds_in_tparam_order(a, ar, &sl[midx].mi_tparams, &binds);
    let inst = fn_instance_mangled(a, ar, base, &oargs);
    // A prelude method's instance body is injected (filtered from the dump), so
    // register the receiver type for the footer but queue no drain.
    if sl[midx].mi_prelude {
        register_mono_struct(a, sc, &sl[midx].mi_path);
        queue_prelude_gen(a, sc, path_last(&sl[midx].mi_path), sl[midx].mi_name, &binds, inst, &inst_path);
    }
    else { queue_method_instance(a, sc, iidx, midx2, &binds, inst, &sl[midx].mi_path); }
    let adj = adjust_recv(a, ar, sc, trecv, is_ptr_ty(trecv.ty), sptr, scst);
    let mut cargs: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    cargs.push(adj);
    push_texprs(&targs, &cargs);
    return te_node(ar, TexprNode::TCall { mangled: inst, args: cargs }, ret_or_void(ar, cret), p);
}

// `recv.m<T..>(args)` → `T__m_<args>(<adjusted recv>, args)`: infer the
// method's type parameters from the receiver + arguments, mangle the
// instance, queue its body for the drain, and substitute the bindings into
// the result type.
fn mk_gen_method_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                      expected: Option<*const Typ>, midx: u32, trecv: *const Texpr, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    let sl = sc.sc_methods.as_slice();
    let base = sl[midx].mi_mangled;
    let sptr = sl[midx].mi_self_ptr;
    let scst = sl[midx].mi_self_const;
    let iidx = sl[midx].mi_impl_idx;
    let midx2 = sl[midx].mi_meth_idx;
    let prelude = sl[midx].mi_prelude;
    let targs = elab_args(a, ar, g, sc, env, args);
    let cscope = scope_with_tparams(sc, &sl[midx].mi_tparams);
    let cret = resolve_sig_ret(a, ar, &cscope, sl[midx].mi_ret_ann);
    let mut binds: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
    infer_method_binds(a, ar, &cscope, &sl[midx].mi_params, trecv, &targs, &binds);
    // A tparam unreachable through self / args (e.g. `alloc<T>()`) is pinned by
    // the surrounding expected type.
    seed_from_expected(cret, expected, &binds);
    let oargs = dedup_bind_tys(a, &binds);
    let inst = fn_instance_mangled(a, ar, base, &oargs);
    // A prelude method's instance body is injected — register its type for the
    // footer but queue no drain job; a user method elaborates an instance.
    if prelude {
        register_mono_struct(a, sc, &sl[midx].mi_path);
        let rpath = recv_base_path(a, trecv.ty);
        queue_prelude_gen(a, sc, path_last(&sl[midx].mi_path), sl[midx].mi_name, &binds, inst, &rpath);
    }
    else { queue_method_instance(a, sc, iidx, midx2, &binds, inst, &sl[midx].mi_path); }
    let iret = subst_opt_ret(ar, &binds, cret);
    let adj = adjust_recv(a, ar, sc, trecv, is_ptr_ty(trecv.ty), sptr, scst);
    let mut cargs: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    cargs.push(adj);
    push_texprs(&targs, &cargs);
    return te_node(ar, TexprNode::TCall { mangled: inst, args: cargs }, ret_or_void(ar, iret), p);
}

// DR-019 FieldAccess call-desugar: `recv.f(args)` where `f` is a field (not a
// method) whose type implements an FnN trait lowers to `(recv.f).call(args)`.
fn field_call_desugar(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                      expected: Option<*const Typ>, recv: *const Expr, trecv: *const Texpr, name: str, args: *const Vec<*const Expr>, p: Pos) -> Option<*const Texpr> {
    let none: Option<*const Texpr> = Option::None;
    return match struct_field_ty(sc, trecv.ty, name) {
        Option::Some(fty) => maybe_field_call(a, ar, g, sc, env, expected, recv, fty, name, args, p)
        | Option::None => none
    };
}
fn maybe_field_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                    expected: Option<*const Typ>, recv: *const Expr, fty: *const Typ, name: str, args: *const Vec<*const Expr>, p: Pos) -> Option<*const Texpr> {
    // A fn-ptr field is called indirectly: `hooks.on_x(0)` -> an indirect call
    // through the field access.
    if is_fnptr_ty(fty) {
        let tfld = elab_field_access(a, ar, g, sc, env, recv, name, p);
        let targs = elab_args(a, ar, g, sc, env, args);
        return Option::Some(te_node(ar, TexprNode::TIndirectCall { fn_expr: tfld, args: targs }, ret_or_void(ar, fnptr_ret_ty(fty)), p));
    }
    if find_method_idx(sc.sc_methods, &recv_base_path(a, fty), "call") >= 0 as int {
        return Option::Some(elab_method_call(a, ar, g, sc, env, expected, ast_node(ar, Expr::FieldAccess(recv, name, p)), "call", args, p));
    }
    let none: Option<*const Texpr> = Option::None;
    return none;
}
// `recv.m(args)` → `T__m(<adjusted recv>, args)` where `T` is the receiver's
// (auto-dereferenced) type.  A generic method instantiates first.  Defers if
// the method is unknown.
// Receivers for which `.eq()` / `.ne()` / `.hash()` / `.clone()` are BUILT IN
// (no `impl Eq for int`).  Mirrors the oracle's `is_primitive`: int-like, bool,
// str, ext-alias and every pointer shape.  Structs / enums fall through to
// their real (derived or hand-written) impl method.
fn is_prim_recv_ty(t: *const Typ) -> bool {
    return match *t {
        Typ::TInt(_k) => true
        | Typ::TCInt { is_signed } => true
        | Typ::TCShort { is_signed } => true
        | Typ::TCLong { is_signed } => true
        | Typ::TCChar => true | Typ::TCSChar => true | Typ::TCUChar => true
        | Typ::TBool => true | Typ::TString => true | Typ::TExtAlias(_n) => true
        | Typ::TPtr(_i) => true | Typ::TOwnPtr(_i) => true | Typ::TConstPtr(_i) => true
        | Typ::TNullPtr => true
        | _o => false
    };
}
fn is_string_ty(t: *const Typ) -> bool { return match *t { Typ::TString => true | _o => false }; }
// `.hash()` reinterprets these as u32 with a cheap C cast; `str` dispatches to
// the prelude content hash instead, and pointers have no content hash.
fn prim_hash_castable(t: *const Typ) -> bool {
    return match *t {
        Typ::TInt(_k) => true
        | Typ::TCInt { is_signed } => true
        | Typ::TCShort { is_signed } => true
        | Typ::TCLong { is_signed } => true
        | Typ::TCChar => true | Typ::TCSChar => true | Typ::TCUChar => true
        | Typ::TBool => true | Typ::TExtAlias(_n) => true
        | _o => false
    };
}
fn prim_builtin_applies(t: *const Typ, name: str, nargs: u32) -> bool {
    if !is_prim_recv_ty(t) { return false; }
    if (str::eq(name, "eq") || str::eq(name, "ne")) && nargs == 1 as u32 { return true; }
    if str::eq(name, "hash") && nargs == 0 as u32 { return is_string_ty(t) || prim_hash_castable(t); }
    if str::eq(name, "clone") && nargs == 0 as u32 { return true; }
    return false;
}
fn prim_builtin_method(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                       trecv: *const Texpr, name: str, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    if str::eq(name, "clone") { return trecv; }
    if str::eq(name, "hash") {
        if is_string_ty(trecv.ty) {
            let mut hargs: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
            hargs.push(trecv);
            return te_node(ar, TexprNode::TCall { mangled: "str__hash", args: hargs }, t_u32(ar), p);
        }
        return te_node(ar, TexprNode::TCast(trecv, ann_u32(ar)), t_u32(ar), p);
    }
    let targ = elab_expr(a, ar, g, sc, env, none_ty(), args.as_slice()[0 as u32]);
    if is_string_ty(trecv.ty) {
        // DR-007: `str.eq(other)` content-compares (HashMap<str, _> keys), the
        // same path the `==` operator takes.
        let mut eargs: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
        eargs.push(trecv);
        eargs.push(targ);
        let call = te_node(ar, TexprNode::TCall { mangled: "str__eq", args: eargs }, t_bool(ar), p);
        if str::eq(name, "eq") { return call; }
        return te_node(ar, TexprNode::TNot(call), t_bool(ar), p);
    }
    let op = if str::eq(name, "eq") { BinOp::EqEq } else { BinOp::NotEq };
    return te_node(ar, TexprNode::TBinOp(op, trecv, targ), t_bool(ar), p);
}
fn elab_method_call(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                    expected: Option<*const Typ>, recv: *const Expr, name: str, args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    let trecv = elab_expr(a, ar, g, sc, env, none_ty(), recv);
    if prim_builtin_applies(trecv.ty, name, args.length()) {
        return prim_builtin_method(a, ar, g, sc, env, trecv, name, args, p);
    }
    let tpath = recv_base_path(a, trecv.ty);
    let idx = find_method_idx(sc.sc_methods, &tpath, name);
    if idx < 0 as int {
        return match field_call_desugar(a, ar, g, sc, env, expected, recv, trecv, name, args, p) {
            Option::Some(te) => te
            | Option::None => defer_expr(ar, p)
        };
    }
    let sl = sc.sc_methods.as_slice();
    if sl[idx as u32].mi_struct_gen {
        return mk_struct_gen_method_call(a, ar, g, sc, env, idx as u32, trecv, args, p);
    }
    if sl[idx as u32].mi_tparams.length() > 0 as u32 {
        return mk_gen_method_call(a, ar, g, sc, env, expected, idx as u32, trecv, args, p);
    }
    let mm = sl[idx as u32].mi_mangled;
    let mret = sl[idx as u32].mi_ret;
    let sptr = sl[idx as u32].mi_self_ptr;
    let scst = sl[idx as u32].mi_self_const;
    if sl[idx as u32].mi_prelude { register_prelude_method_use(a, ar, sc, &sl[idx as u32].mi_path, mret); }
    let adj = adjust_recv(a, ar, sc, trecv, is_ptr_ty(trecv.ty), sptr, scst);
    let mut cargs: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    cargs.push(adj);
    append_args_meth(a, ar, g, sc, env, mm, args, &cargs);
    return te_node(ar, TexprNode::TCall { mangled: mm, args: cargs }, ret_or_void(ar, mret), p);
}

// ===== Match elaboration (scalar scrutinee slice) =====
//
// SLICE: int / bool scrutinee (the scalar sentinel `ename_path = []`), with
// `PBool` / `PLit` / `PVar` / `_` / or-patterns.  An enum scrutinee (needs
// the enum index for variant tags) defers to a marker.

fn is_scalar_ty(t: *const Typ) -> bool {
    return match *t {
        Typ::TInt(_k) => true
        | Typ::TBool => true
        | _other => false
    };
}

fn copy_fieldtys(a: Allocator, src: *const Vec<FieldTy>) -> Vec<FieldTy> {
    let mut out: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let n = src.length();
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(FieldTy { name: sl[i].name, ty: sl[i].ty }); i = i + 1 as u32; }
    return out;
}

fn elab_pattern_list(a: Allocator, ar: *Arena, sc: *const TyScope, alts: *const Vec<Pattern>) -> Vec<Tpattern> {
    let mut out: Vec<Tpattern> = Vec::with_capacity(a, 8 as u32);
    let n = alts.length();
    let sl = alts.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(elab_pattern(a, ar, sc, &sl[i])); i = i + 1 as u32; }
    return out;
}

// Variant payload sub-patterns become `TFieldPat`s: tuple positions get
// synthesised names `_0`, `_1`, …; struct fields keep their names.
fn elab_tbinds(a: Allocator, ar: *Arena, sc: *const TyScope, epath: *const Vec<str>, variant: str, binds: *const PatBinds) -> Vec<TFieldPat> {
    let mut out: Vec<TFieldPat> = Vec::with_capacity(a, 8 as u32);
    match *binds {
        PatBinds::PBTuple(pats) => {
            let nt = pats.length();
            let tsl = pats.as_slice();
            let mut it = 0 as u32;
            while it < nt {
                out.push(TFieldPat { name: tuple_field_name(a, ar, it), pat: elab_pattern(a, ar, sc, &tsl[it]) });
                it = it + 1 as u32;
            }
        }
        | PatBinds::PBStruct(fps) => { complete_struct_pat(a, ar, sc, epath, variant, &fps, &out); }
    }
    return out;
}
// Emit every variant field in declaration order (an omitted field becomes
// `_`), matching the oracle; if the variant's fields aren't known (prelude /
// unresolved), fall back to the written fields.
fn complete_struct_pat(a: Allocator, ar: *Arena, sc: *const TyScope, epath: *const Vec<str>, variant: str,
                       fps: *const Vec<FieldPat>, out: *Vec<TFieldPat>) {
    // Walk the enum-field table directly (its strings are arena-backed, so no
    // local-vector escape); each field of `variant` becomes a TFieldPat with
    // its written pattern or `_`.
    let n = sc.sc_efields.length();
    let sl = sc.sc_efields.as_slice();
    let mut found = false;
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].ef_variant, variant) {
            if path_eq(&sl[i].ef_path, epath) {
                found = true;
                let wi = field_pat_idx(fps, sl[i].ef_name);
                out.push(TFieldPat { name: sl[i].ef_name, pat: complete_field_pat(a, ar, sc, fps, wi) });
            }
        }
        i = i + 1 as u32;
    }
    if found { return; }
    // Unknown variant fields (prelude / unresolved) — emit the written fields.
    let ns = fps.length();
    let ssl = fps.as_slice();
    let mut is = 0 as u32;
    while is < ns {
        out.push(TFieldPat { name: ssl[is].name, pat: elab_pattern(a, ar, sc, &ssl[is].pat) });
        is = is + 1 as u32;
    }
    return;
}

fn field_pat_idx(fps: *const Vec<FieldPat>, fname: str) -> int {
    let n = fps.length();
    let sl = fps.as_slice();
    let mut i = 0 as u32;
    while i < n { if str::eq(sl[i].name, fname) { return i as int; } i = i + 1 as u32; }
    return -1 as int;
}
fn complete_field_pat(a: Allocator, ar: *Arena, sc: *const TyScope, fps: *const Vec<FieldPat>, wi: int) -> Tpattern {
    if wi < 0 as int { return Tpattern::TPWildcard; }
    return elab_pattern(a, ar, sc, &fps.as_slice()[wi as u32].pat);
}
fn elab_variant_pattern(a: Allocator, ar: *Arena, sc: *const TyScope, tname: *const Vec<str>, variant: str, binds: *const PatBinds) -> Tpattern {
    // Qualify a bare enum name (`BinOp` -> `ast::BinOp` in a module or via a
    // `use ast::*` alias) so the tag + field completion resolve against the
    // qualified etags/efields; a generic `Option` (no marker/alias) is left as-is.
    let qpath = qualify_type_path(a, ar, sc, tname);
    let tag = variant_tag(sc.sc_etags, &qpath, variant);
    return Tpattern::TPVariant { variant: variant, tag: tag, binds: elab_tbinds(a, ar, sc, &qpath, variant, binds) };
}
fn elab_pattern(a: Allocator, ar: *Arena, sc: *const TyScope, pat: *const Pattern) -> Tpattern {
    return match *pat {
        Pattern::PWildcard(_q) => Tpattern::TPWildcard
        | Pattern::PVar(n, _q) => Tpattern::TPVar(n)
        | Pattern::PLit(n, _q) => Tpattern::TPLit(n)
        | Pattern::PBool(b, _q) => Tpattern::TPBool(b)
        | Pattern::POr(alts, _q) => Tpattern::TPOr(elab_pattern_list(a, ar, sc, &alts))
        | Pattern::PVariant { tname, variant, binds } => elab_variant_pattern(a, ar, sc, &tname, variant, &binds)
    };
}

// Bind pattern variables into the arm's env: a top-level `PVar` binds the
// whole scrutinee; a variant pattern binds each payload var to its field
// type and recurses through nested variant patterns.
fn voidable_ty(ar: *Arena, t: Option<*const Typ>) -> *const Typ {
    return match t {
        Option::Some(ty) => ty
        | Option::None => ty_node(ar, Typ::TCVoid)
    };
}

fn bind_one_payload(a: Allocator, ar: *Arena, sc: *const TyScope, tname: *const Vec<str>, variant: str,
                    fname: str, sub: *const Pattern, env_out: *Vec<FieldTy>) {
    match *sub {
        Pattern::PVar(n, _q) => {
            let fty = voidable_ty(ar, mono_enum_field_ty(sc, tname, variant, fname));
            env_out.push(FieldTy { name: n, ty: fty });
        }
        | Pattern::PVariant { tname, variant, binds } => { bind_variant_payload(a, ar, sc, &tname, variant, &binds, env_out); }
        | _other => { }
    }
}

fn bind_variant_payload(a: Allocator, ar: *Arena, sc: *const TyScope, tname: *const Vec<str>, variant: str,
                        binds: *const PatBinds, env_out: *Vec<FieldTy>) {
    match *binds {
        PatBinds::PBTuple(pats) => {
            let nt = pats.length();
            let tsl = pats.as_slice();
            let mut it = 0 as u32;
            while it < nt {
                bind_one_payload(a, ar, sc, tname, variant, tuple_field_name(a, ar, it), &tsl[it], env_out);
                it = it + 1 as u32;
            }
        }
        | PatBinds::PBStruct(fps) => {
            let ns = fps.length();
            let ssl = fps.as_slice();
            let mut is = 0 as u32;
            while is < ns {
                bind_one_payload(a, ar, sc, tname, variant, ssl[is].name, &ssl[is].pat, env_out);
                is = is + 1 as u32;
            }
        }
    }
}

fn pattern_binds(a: Allocator, ar: *Arena, sc: *const TyScope, pat: *const Pattern, scrut_ty: *const Typ, env_out: *Vec<FieldTy>) {
    match *pat {
        Pattern::PVar(n, _q) => { env_out.push(FieldTy { name: n, ty: scrut_ty }); }
        | Pattern::PVariant { tname, variant, binds } => {
            // Look up payload field types on the scrutinee's instance type
            // (so an instance's substituted fields win over the skeleton).
            let epath = enum_ty_path(a, scrut_ty);
            bind_variant_payload(a, ar, sc, &epath, variant, &binds, env_out);
        }
        | _other => { }
    }
}

fn elab_guard(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
              guard: Option<*const Expr>) -> Option<*const Texpr> {
    return match guard {
        Option::Some(gx) => Option::Some(elab_expr(a, ar, g, sc, env, none_ty(), gx))
        | Option::None => none_texpr()
    };
}

fn elab_one_arm(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                expected: Option<*const Typ>, scrut_ty: *const Typ, arm: *const MatchArm, out: *Vec<TmatchArm>) {
    let tpat = elab_pattern(a, ar, sc, &arm.pat);
    let mut arm_env = copy_fieldtys(a, env);
    pattern_binds(a, ar, sc, &arm.pat, scrut_ty, &arm_env);
    let tguard = elab_guard(a, ar, g, sc, &arm_env, arm.guard);
    let tbody = elab_expr(a, ar, g, sc, &arm_env, expected, arm.body);
    out.push(TmatchArm { tpat: tpat, tguard: tguard, tbody: tbody, tdiverges: false, tarm_pos: arm.arm_pos });
}

fn elab_arms(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
             expected: Option<*const Typ>, scrut_ty: *const Typ, arms: *const Vec<MatchArm>, out: *Vec<TmatchArm>) {
    let n = arms.length();
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < n { elab_one_arm(a, ar, g, sc, env, expected, scrut_ty, &sl[i], out); i = i + 1 as u32; }
}

fn match_result_ty(ar: *Arena, tarms: *const Vec<TmatchArm>) -> *const Typ {
    if tarms.length() == 0 as u32 { return ty_node(ar, Typ::TCVoid); }
    let sl = tarms.as_slice();
    return sl[0 as u32].tbody.ty;
}

fn is_enum_ty(t: *const Typ) -> bool {
    return match *t {
        Typ::TEnum(_p) => true
        | _e => false
    };
}

fn enum_ty_path(a: Allocator, t: *const Typ) -> Vec<str> {
    return match *t {
        Typ::TEnum(path) => copy_strs(a, &path)
        | _e => Vec::with_capacity(a, 8 as u32)
    };
}

fn emit_match(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
              expected: Option<*const Typ>, tscrut: *const Texpr, epath: Vec<str>,
              arms: *const Vec<MatchArm>, p: Pos) -> *const Texpr {
    let mut tarms: Vec<TmatchArm> = Vec::with_capacity(a, 8 as u32);
    elab_arms(a, ar, g, sc, env, expected, tscrut.ty, arms, &tarms);
    let mty = match_result_ty(ar, &tarms);
    return te_node(ar, TexprNode::TMatch { scrutinee: tscrut, ename_path: epath, arms: tarms }, mty, p);
}

// A name with a global fn of that name is a DR-009 view (the view fn shares
// the choice enum's name); used to drive the match-site scrutinee rewrite.
fn global_is_view(g: *const Vec<GlobalFn>, vn: str) -> bool {
    return match global_lookup(g, vn) { Option::Some(gf) => true | Option::None => false };
}
fn pat_view_name(g: *const Vec<GlobalFn>, pat: *const Pattern) -> str {
    return match *pat {
        Pattern::PVariant { tname, variant, binds } => {
            let single = tname.length() == 1 as u32;
            let vn = if single { path_last(&tname) } else { "" };
            if global_is_view(g, vn) { vn } else { "" }
        }
        | Pattern::POr(alts, _q) => {
            let n = alts.length();
            let sl = alts.as_slice();
            let mut i = 0 as u32;
            let mut found: str = "";
            while i < n { let va = pat_view_name(g, &sl[i]); if !str::eq(va, "") { found = va; } i = i + 1 as u32; }
            found
        }
        | _other => ""
    };
}
fn view_target(g: *const Vec<GlobalFn>, arms: *const Vec<MatchArm>) -> str {
    let n = arms.length();
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < n { let vn = pat_view_name(g, &sl[i].pat); if !str::eq(vn, "") { return vn; } i = i + 1 as u32; }
    return "";
}
fn ty_is_enum_named(t: *const Typ, vt: str) -> bool {
    return match *t { Typ::TEnum(path) => str::eq(path_last(&path), vt) | _e => false };
}
fn wrap_view_call(a: Allocator, ar: *Arena, vt: str, scrutinee: *const Expr, p: Pos) -> *const Expr {
    let mut args: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    args.push(scrutinee);
    return ast_node(ar, Expr::Call { callee: single_str(a, vt), args: args, pos: p });
}
fn elab_match(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
              expected: Option<*const Typ>, scrutinee: *const Expr, arms: *const Vec<MatchArm>, p: Pos) -> *const Texpr {
    let tscrut0 = elab_expr(a, ar, g, sc, env, none_ty(), scrutinee);
    // DR-009: arms naming `View::Case` wrap the scrutinee in `View(scrutinee)`
    // (the view-fn call) unless it is already that choice enum.
    let vt = view_target(g, arms);
    let tscrut = if !str::eq(vt, "") && !ty_is_enum_named(tscrut0.ty, vt) {
        elab_expr(a, ar, g, sc, env, none_ty(), wrap_view_call(a, ar, vt, scrutinee, p))
    } else { tscrut0 };
    if is_enum_ty(tscrut.ty) {
        return emit_match(a, ar, g, sc, env, expected, tscrut, enum_ty_path(a, tscrut.ty), arms, p);
    }
    if !is_scalar_ty(tscrut.ty) { return defer_expr(ar, p); }
    let epath: Vec<str> = Vec::with_capacity(a, 8 as u32);
    return emit_match(a, ar, g, sc, env, expected, tscrut, epath, arms, p);
}

// ===== `try` / `orelse` desugar =====
//
// Both lower to a 2-arm match over the Option / Result value.  `orelse`
// yields the payload on Ok/Some and the default on Err/None; `try` yields
// the payload on Ok/Some and DIVERGES on Err/None — returning the error on
// the enclosing fn's own instance.  Option vs Result is detected by probing
// for a `Some` variant tag (no string-prefix matching).

fn variant_pat_bind(a: Allocator, variant: str, tag: int, bind: str) -> Tpattern {
    let mut fps: Vec<TFieldPat> = Vec::with_capacity(a, 8 as u32);
    fps.push(TFieldPat { name: "_0", pat: Tpattern::TPVar(bind) });
    return Tpattern::TPVariant { variant: variant, tag: tag, binds: fps };
}
fn variant_pat_unit(a: Allocator, variant: str, tag: int) -> Tpattern {
    let fps: Vec<TFieldPat> = Vec::with_capacity(a, 8 as u32);
    return Tpattern::TPVariant { variant: variant, tag: tag, binds: fps };
}
fn variant_pat_wild(a: Allocator, variant: str, tag: int) -> Tpattern {
    let mut fps: Vec<TFieldPat> = Vec::with_capacity(a, 8 as u32);
    fps.push(TFieldPat { name: "_0", pat: Tpattern::TPWildcard });
    return Tpattern::TPVariant { variant: variant, tag: tag, binds: fps };
}

fn str_starts_with(s: str, prefix: str) -> bool {
    let pn = str::length(prefix);
    if str::length(s) < pn { return false; }
    let sb = str::as_bytes(s);
    let pb = str::as_bytes(prefix);
    let mut i = 0 as u32;
    while i < pn { if sb[i] != pb[i] { return false; } i = i + 1 as u32; }
    return true;
}

// `try` / `orelse` accept only Option / Result.  Variant tags live under the
// skeleton path (`Option` / `Result`), so detect the shape from the instance
// name (`Option` / `Option_i32`) and look tags up under the skeleton.
fn inst_is_option(path: *const Vec<str>) -> bool {
    let name = path_last(path);
    return str::eq(name, "Option") || str_starts_with(name, "Option_");
}
fn skel_path(a: Allocator, is_opt: bool) -> Vec<str> {
    let mut sk: Vec<str> = Vec::with_capacity(a, 8 as u32);
    sk.push(if is_opt { "Option" } else { "Result" });
    return sk;
}

fn elab_orelse(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
               expected: Option<*const Typ>, value: *const Expr, dflt: *const Expr, p: Pos) -> *const Texpr {
    let tvalue = elab_expr(a, ar, g, sc, env, none_ty(), value);
    if !is_enum_ty(tvalue.ty) { return defer_expr(ar, p); }
    let path = enum_ty_path(a, tvalue.ty);
    let is_opt = inst_is_option(&path);
    let skel = skel_path(a, is_opt);
    let ok_name = if is_opt { "Some" } else { "Ok" };
    let err_name = if is_opt { "None" } else { "Err" };
    let ok_tag = variant_tag(sc.sc_etags, &skel, ok_name);
    let err_tag = variant_tag(sc.sc_etags, &skel, err_name);
    let ok_pay = voidable_ty(ar, mono_enum_field_ty(sc, &path, ok_name, "_0"));
    let ok_body = te_node(ar, TexprNode::TVar("__orelse_v"), ok_pay, p);
    let ok_arm = TmatchArm { tpat: variant_pat_bind(a, ok_name, ok_tag, "__orelse_v"), tguard: none_texpr(), tbody: ok_body, tdiverges: false, tarm_pos: p };
    let tdefault = elab_expr(a, ar, g, sc, env, expected, dflt);
    let err_pat = if is_opt { variant_pat_unit(a, err_name, err_tag) } else { variant_pat_wild(a, err_name, err_tag) };
    let err_arm = TmatchArm { tpat: err_pat, tguard: none_texpr(), tbody: tdefault, tdiverges: false, tarm_pos: p };
    let mut arms: Vec<TmatchArm> = Vec::with_capacity(a, 8 as u32);
    arms.push(ok_arm);
    arms.push(err_arm);
    return te_node(ar, TexprNode::TMatch { scrutinee: tvalue, ename_path: path, arms: arms }, ok_pay, p);
}

fn ret_enum_path(a: Allocator, sc: *const TyScope) -> Vec<str> {
    return match sc.sc_ret {
        Option::Some(rt) => enum_ty_path(a, rt)
        | Option::None => Vec::with_capacity(a, 8 as u32)
    };
}

// The diverging Err/None arm: its pattern matches the inner instance's
// variant; its body re-wraps the payload as the OUTER (enclosing fn's)
// instance, which codegen returns.
fn build_try_err_arm(a: Allocator, ar: *Arena, sc: *const TyScope, is_opt: bool, err_name: str,
                     err_tag_in: int, outer_err_tag: int, ipath: *const Vec<str>, outer_path: *const Vec<str>, p: Pos) -> TmatchArm {
    let pat = if is_opt { variant_pat_unit(a, err_name, err_tag_in) } else { variant_pat_bind(a, err_name, err_tag_in, "__try_e") };
    let mut args: Vec<TexprField> = Vec::with_capacity(a, 8 as u32);
    if !is_opt {
        let e_ty = voidable_ty(ar, mono_enum_field_ty(sc, ipath, err_name, "_0"));
        args.push(TexprField { name: "_0", value: te_node(ar, TexprNode::TVar("__try_e"), e_ty, p) });
    }
    let err_body = mk_enum_lit_node(a, ar, outer_path, err_name, outer_err_tag, args, p);
    return TmatchArm { tpat: pat, tguard: none_texpr(), tbody: err_body, tdiverges: true, tarm_pos: p };
}

fn elab_try(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
            value: *const Expr, p: Pos) -> *const Texpr {
    let tinner = elab_expr(a, ar, g, sc, env, none_ty(), value);
    if !is_enum_ty(tinner.ty) { return defer_expr(ar, p); }
    let ipath = enum_ty_path(a, tinner.ty);
    let is_opt = inst_is_option(&ipath);
    let skel = skel_path(a, is_opt);
    let ok_name = if is_opt { "Some" } else { "Ok" };
    let err_name = if is_opt { "None" } else { "Err" };
    let ok_tag = variant_tag(sc.sc_etags, &skel, ok_name);
    let err_tag_in = variant_tag(sc.sc_etags, &skel, err_name);
    let ok_pay = voidable_ty(ar, mono_enum_field_ty(sc, &ipath, ok_name, "_0"));
    let ok_body = te_node(ar, TexprNode::TVar("__try_v"), ok_pay, p);
    let ok_arm = TmatchArm { tpat: variant_pat_bind(a, ok_name, ok_tag, "__try_v"), tguard: none_texpr(), tbody: ok_body, tdiverges: false, tarm_pos: p };
    let outer_path = ret_enum_path(a, sc);
    let outer_err_tag = variant_tag(sc.sc_etags, &skel, err_name);
    let err_arm = build_try_err_arm(a, ar, sc, is_opt, err_name, err_tag_in, outer_err_tag, &ipath, &outer_path, p);
    let mut arms: Vec<TmatchArm> = Vec::with_capacity(a, 8 as u32);
    arms.push(ok_arm);
    arms.push(err_arm);
    return te_node(ar, TexprNode::TMatch { scrutinee: tinner, ename_path: ipath, arms: arms }, ok_pay, p);
}

// ===== Variable substitution (for-loop iter-var rename) =====
//
// `for IT in lo..hi { body }` renames `IT` to the gensym counter `__fvK`
// in the body before elaboration (mirrors OCaml `subst_var_*`).  Rebuilds
// the touched AST nodes; unhandled expr forms pass through unchanged, an
// unhandled statement lowers to a visible `(var )` marker.

fn ast_node(ar: *Arena, e: Expr) -> *const Expr {
    let n: *Expr = ar.alloc_borrowed();
    if n == null { arena_oom(); }
    *n = e;
    return n as *const Expr;
}

fn subst_var_one(ar: *Arena, from: str, to: str, n: str, p: Pos, orig: *const Expr) -> *const Expr {
    if str::eq(n, from) { return ast_node(ar, Expr::Var(to, p)); }
    return orig;
}

fn subst_call(a: Allocator, ar: *Arena, from: str, to: str,
              callee: *const Vec<str>, args: *const Vec<*const Expr>, p: Pos) -> *const Expr {
    let new_callee = copy_strs(a, callee);
    let mut new_args: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n { new_args.push(subst_var_expr(a, ar, from, to, sl[i])); i = i + 1 as u32; }
    return ast_node(ar, Expr::Call { callee: new_callee, args: new_args, pos: p });
}

fn subst_else(a: Allocator, ar: *Arena, from: str, to: str, else_blk: Option<Vec<Stmt>>) -> Option<Vec<Stmt>> {
    return match else_blk {
        Option::Some(blk) => Option::Some(subst_body(a, ar, from, to, &blk))
        | Option::None => { let none: Option<Vec<Stmt>> = Option::None; none }
    };
}

fn subst_if(a: Allocator, ar: *Arena, from: str, to: str, cond: *const Expr,
            then_blk: *const Vec<Stmt>, else_blk: Option<Vec<Stmt>>, p: Pos) -> *const Expr {
    let new_cond = subst_var_expr(a, ar, from, to, cond);
    let new_then = subst_body(a, ar, from, to, then_blk);
    let new_else = subst_else(a, ar, from, to, else_blk);
    return ast_node(ar, Expr::If { cond: new_cond, then_blk: new_then, else_blk: new_else, pos: p });
}

fn subst_args(a: Allocator, ar: *Arena, from: str, to: str, args: *const Vec<*const Expr>) -> Vec<*const Expr> {
    let mut out: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < args.length() { out.push(subst_var_expr(a, ar, from, to, sl[i])); i = i + 1 as u32; }
    return out;
}
fn subst_fields(a: Allocator, ar: *Arena, from: str, to: str, fs: *const Vec<Field>) -> Vec<Field> {
    let mut out: Vec<Field> = Vec::with_capacity(a, 8 as u32);
    let sl = fs.as_slice();
    let mut i = 0 as u32;
    while i < fs.length() {
        out.push(Field { name: sl[i].name, value: subst_var_expr(a, ar, from, to, sl[i].value) });
        i = i + 1 as u32;
    }
    return out;
}
fn subst_opt(a: Allocator, ar: *Arena, from: str, to: str, e: Option<*const Expr>) -> Option<*const Expr> {
    return match e {
        Option::Some(x) => Option::Some(subst_var_expr(a, ar, from, to, x))
        | Option::None => { let n: Option<*const Expr> = Option::None; n }
    };
}
fn subst_enum_args(a: Allocator, ar: *Arena, from: str, to: str, args: EnumLitArgs) -> EnumLitArgs {
    return match args {
        EnumLitArgs::EATuple(es) => EnumLitArgs::EATuple(subst_args(a, ar, from, to, &es))
        | EnumLitArgs::EAStruct(fs) => EnumLitArgs::EAStruct(subst_fields(a, ar, from, to, &fs))
    };
}
fn subst_arms(a: Allocator, ar: *Arena, from: str, to: str, arms: *const Vec<MatchArm>) -> Vec<MatchArm> {
    let mut out: Vec<MatchArm> = Vec::with_capacity(a, 8 as u32);
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < arms.length() {
        out.push(MatchArm { pat: sl[i].pat, guard: subst_opt(a, ar, from, to, sl[i].guard),
                            body: subst_var_expr(a, ar, from, to, sl[i].body), arm_pos: sl[i].arm_pos });
        i = i + 1 as u32;
    }
    return out;
}
// Every expr form is covered: an `_other => e` pass-through silently skipped the
// body of a MethodCall / Match / Block, so a `for v in it { f(acc, v) }` in the
// prelude kept a `v` that was never declared — invalid C, not a naming drift.
fn subst_var_expr(a: Allocator, ar: *Arena, from: str, to: str, e: *const Expr) -> *const Expr {
    let p = expr_pos(e);
    return match *e {
        Expr::Var(n, _q) => subst_var_one(ar, from, to, n, p, e)
        | Expr::Neg(s, _q) => ast_node(ar, Expr::Neg(subst_var_expr(a, ar, from, to, s), p))
        | Expr::BitNot(s, _q) => ast_node(ar, Expr::BitNot(subst_var_expr(a, ar, from, to, s), p))
        | Expr::Not(s, _q) => ast_node(ar, Expr::Not(subst_var_expr(a, ar, from, to, s), p))
        | Expr::BinOp(op, l, r, _q) =>
            ast_node(ar, Expr::BinOp(op, subst_var_expr(a, ar, from, to, l), subst_var_expr(a, ar, from, to, r), p))
        | Expr::Cast(s, t, _q) => ast_node(ar, Expr::Cast(subst_var_expr(a, ar, from, to, s), t, p))
        | Expr::Call { callee, args } => subst_call(a, ar, from, to, &callee, &args, p)
        | Expr::If { cond, then_blk, else_blk } => subst_if(a, ar, from, to, cond, &then_blk, else_blk, p)
        | Expr::Index { base, index } =>
            ast_node(ar, Expr::Index { base: subst_var_expr(a, ar, from, to, base), index: subst_var_expr(a, ar, from, to, index), pos: p })
        | Expr::Deref(s, _q) => ast_node(ar, Expr::Deref(subst_var_expr(a, ar, from, to, s), p))
        | Expr::Ref(s, _q) => ast_node(ar, Expr::Ref(subst_var_expr(a, ar, from, to, s), p))
        | Expr::FieldAccess(t, f, _q) => ast_node(ar, Expr::FieldAccess(subst_var_expr(a, ar, from, to, t), f, p))
        | Expr::MethodCall { receiver, name, args } =>
            ast_node(ar, Expr::MethodCall { receiver: subst_var_expr(a, ar, from, to, receiver), name: name,
                                            args: subst_args(a, ar, from, to, &args), pos: p })
        | Expr::TupleLit(es, _q) => ast_node(ar, Expr::TupleLit(subst_args(a, ar, from, to, &es), p))
        | Expr::ArrayLit(es, _q) => ast_node(ar, Expr::ArrayLit(subst_args(a, ar, from, to, &es), p))
        | Expr::ArrayRepeat { value, count } =>
            ast_node(ar, Expr::ArrayRepeat { value: subst_var_expr(a, ar, from, to, value),
                                             count: subst_var_expr(a, ar, from, to, count), pos: p })
        | Expr::Range { lo, hi, inclusive } =>
            ast_node(ar, Expr::Range { lo: subst_var_expr(a, ar, from, to, lo), hi: subst_var_expr(a, ar, from, to, hi),
                                       inclusive: inclusive, pos: p })
        | Expr::StructLit { tname, fields, base } =>
            ast_node(ar, Expr::StructLit { tname: copy_strs(a, &tname), fields: subst_fields(a, ar, from, to, &fields),
                                           base: subst_opt(a, ar, from, to, base), pos: p })
        | Expr::New { tname, fields, base, alloc } =>
            ast_node(ar, Expr::New { tname: copy_strs(a, &tname), fields: subst_fields(a, ar, from, to, &fields),
                                     base: subst_opt(a, ar, from, to, base), alloc: subst_opt(a, ar, from, to, alloc), pos: p })
        | Expr::NewEnum { tname, args, alloc } =>
            ast_node(ar, Expr::NewEnum { tname: copy_strs(a, &tname), args: subst_args(a, ar, from, to, &args),
                                         alloc: subst_opt(a, ar, from, to, alloc), pos: p })
        | Expr::EnumLit { tname, variant, args } =>
            ast_node(ar, Expr::EnumLit { tname: copy_strs(a, &tname), variant: variant,
                                         args: subst_enum_args(a, ar, from, to, args), pos: p })
        | Expr::Match { scrutinee, arms } =>
            ast_node(ar, Expr::Match { scrutinee: subst_var_expr(a, ar, from, to, scrutinee),
                                       arms: subst_arms(a, ar, from, to, &arms), pos: p })
        | Expr::Block(stmts, _q) => ast_node(ar, Expr::Block(subst_body(a, ar, from, to, &stmts), p))
        | Expr::Orelse(l, r, _q) =>
            ast_node(ar, Expr::Orelse(subst_var_expr(a, ar, from, to, l), subst_var_expr(a, ar, from, to, r), p))
        | Expr::Try(s, _q) => ast_node(ar, Expr::Try(subst_var_expr(a, ar, from, to, s), p))
        // A lambda body is its own scope (lifted to a top-level fn), but the
        // pre-pass walks it separately, so substituting through is a safe no-op.
        | Expr::Lambda { params, ret_ty, body, captures } =>
            ast_node(ar, Expr::Lambda { params: params, ret_ty: ret_ty, body: subst_var_expr(a, ar, from, to, body),
                                        captures: captures, pos: p })
        | _leaf => e
    };
}

// A bare `i = ...` reassign renames too: the body's `i` IS the gensym in the
// emitted code.  Single-segment paths matching `from` are remapped; qualified
// paths stay.
fn subst_path(a: Allocator, from: str, to: str, path: *const Vec<str>) -> Vec<str> {
    if path.length() == 1 as u32 && str::eq(path.as_slice()[0 as u32], from) {
        return single_str(a, to);
    }
    return copy_strs(a, path);
}
fn copy_stmts(a: Allocator, body: *const Vec<Stmt>) -> Vec<Stmt> {
    let mut out: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    let sl = body.as_slice();
    let mut i = 0 as u32;
    while i < body.length() { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}
// A nested `for` that declares the same name shadows it: stop substituting
// inside its body (Exile disallows shadowing, but the rewriter stays robust).
fn subst_for(a: Allocator, ar: *Arena, from: str, to: str, iter_var: str,
             range: *const Expr, body: *const Vec<Stmt>, pos: Pos) -> Stmt {
    let nr = subst_var_expr(a, ar, from, to, range);
    if str::eq(iter_var, from) {
        return Stmt::For { iter_var: iter_var, range: nr, body: copy_stmts(a, body), pos: pos };
    }
    return Stmt::For { iter_var: iter_var, range: nr, body: subst_body(a, ar, from, to, body), pos: pos };
}
// Every statement form is covered too: the old `_other =>` fallback turned an
// unhandled statement (Return / While / For / Defer / With / LetElse) into a
// visible `(var )` marker — it would have DELETED a `return` inside a for-body.
fn subst_var_stmt(a: Allocator, ar: *Arena, from: str, to: str, s: *const Stmt) -> Stmt {
    return match *s {
        Stmt::ExprStmt(e) => Stmt::ExprStmt(subst_var_expr(a, ar, from, to, e))
        | Stmt::Tail(e) => Stmt::Tail(subst_var_expr(a, ar, from, to, e))
        | Stmt::Assign { path, value, pos } =>
            Stmt::Assign { path: subst_path(a, from, to, &path), value: subst_var_expr(a, ar, from, to, value), pos: pos }
        | Stmt::Let { name, value, ty_ann, is_mut, pos } =>
            Stmt::Let { name: name, value: subst_var_expr(a, ar, from, to, value), ty_ann: ty_ann, is_mut: is_mut, pos: pos }
        | Stmt::AssignDeref { target, value, pos } =>
            Stmt::AssignDeref { target: subst_var_expr(a, ar, from, to, target), value: subst_var_expr(a, ar, from, to, value), pos: pos }
        | Stmt::AssignField { target, field, value, pos } =>
            Stmt::AssignField { target: subst_var_expr(a, ar, from, to, target), field: field, value: subst_var_expr(a, ar, from, to, value), pos: pos }
        | Stmt::AssignIndex { base, index, value, pos } =>
            Stmt::AssignIndex { base: subst_var_expr(a, ar, from, to, base), index: subst_var_expr(a, ar, from, to, index), value: subst_var_expr(a, ar, from, to, value), pos: pos }
        | Stmt::LetTuple { names, value, is_mut, pos } =>
            Stmt::LetTuple { names: copy_strs(a, &names), value: subst_var_expr(a, ar, from, to, value), is_mut: is_mut, pos: pos }
        | Stmt::LetElse { pat, value, else_body, pos } =>
            Stmt::LetElse { pat: pat, value: subst_var_expr(a, ar, from, to, value),
                            else_body: subst_body(a, ar, from, to, &else_body), pos: pos }
        | Stmt::Return(v, p) => Stmt::Return(subst_opt(a, ar, from, to, v), p)
        | Stmt::While { cond, body } =>
            Stmt::While { cond: subst_var_expr(a, ar, from, to, cond), body: subst_body(a, ar, from, to, &body) }
        | Stmt::For { iter_var, range, body, pos } => subst_for(a, ar, from, to, iter_var, range, &body, pos)
        | Stmt::Defer { body, pos } => Stmt::Defer { body: subst_body(a, ar, from, to, &body), pos: pos }
        | Stmt::With { target, name, body, pos } =>
            Stmt::With { target: subst_var_expr(a, ar, from, to, target), name: name,
                         body: subst_body(a, ar, from, to, &body), pos: pos }
        | Stmt::Break(p) => Stmt::Break(p)
        | Stmt::Continue(p) => Stmt::Continue(p)
    };
}

fn subst_body(a: Allocator, ar: *Arena, from: str, to: str, body: *const Vec<Stmt>) -> Vec<Stmt> {
    let mut out: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    let n = body.length();
    let sl = body.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(subst_var_stmt(a, ar, from, to, &sl[i])); i = i + 1 as u32; }
    return out;
}

// `target.field` — the access takes the field's declared type; an access
// on a non-struct (a deferred marker) defers in turn so the gap stays
// visible.
fn elab_field_access(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                     env: *const Vec<FieldTy>, target: *const Expr, field: str, p: Pos) -> *const Texpr {
    let tt = elab_expr(a, ar, g, sc, env, none_ty(), target);
    return match struct_field_ty(sc, tt.ty, field) {
        Option::Some(fty) => te_node(ar, TexprNode::TFieldAccess { target: tt, field: field }, fty, p)
        | Option::None => no_such_field(a, ar, sc, tt.ty, field, p)
    };
}
// The struct a field access is reaching THROUGH: `p.f`, `(*p).f` and `p->f` all
// name the same struct, so peel the pointer before reporting.
fn struct_path_of(t: *const Typ) -> Option<Vec<str>> {
    let none: Option<Vec<str>> = Option::None;
    return match *t {
        Typ::TStruct(path) => Option::Some(path)
        | Typ::TPtr(i) => struct_path_of(i)
        | Typ::TConstPtr(i) => struct_path_of(i)
        | Typ::TOwnPtr(i) => struct_path_of(i)
        | _e => none
    };
}
fn no_such_field(a: Allocator, ar: *Arena, sc: *const TyScope, target_ty: *const Typ,
                 field: str, p: Pos) -> *const Texpr {
    match struct_path_of(target_ty) {
        Option::Some(path) => {
            tc_fail(ar, sc, p, msg3(a, ar, "struct '", path_display(a, ar, &path),
                                    "' has no field '", field, "'"));
        }
        // Not a struct at all: the reference implementation reports the missing
        // field against the type it did find, and so must we once `typ_name` is
        // ported.  Until then this stays a fabrication site — deliberately
        // visible rather than silently plausible.
        | Option::None => { }
    }
    return defer_expr(ar, p);
}

// Each initialiser value elaborates against its declared field type.
fn elab_struct_fields(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                      env: *const Vec<FieldTy>, tname: *const Vec<str>, fields: *const Vec<Field>) -> Vec<TexprField> {
    let mut out: Vec<TexprField> = Vec::with_capacity(a, 8 as u32);
    let n = fields.length();
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < n {
        // Field values elaborate without a field-type expectation (matching
        // the oracle): an `int` literal keeps its i32 default and coerces into
        // a narrower / unsigned slot at the store, rather than adopting the
        // field width here.
        let tv = elab_expr(a, ar, g, sc, env, none_ty(), sl[i].value);
        // A struct-literal field is a borrow slot like any other: an `own *T` lent
        // into a `*T` field restamps, and a fresh owned RVALUE there is rejected.
        out.push(TexprField { name: sl[i].name, value: field_loan(a, ar, sc, tname, sl[i].name, tv) });
        i = i + 1 as u32;
    }
    return out;
}
// The slot type may be unknown (a deferred lookup); with no slot there is nothing
// to lend into, so pass the value through.
// The element type an indexed assignment writes into.
fn elem_of(t: *const Typ) -> Option<*const Typ> {
    let none: Option<*const Typ> = Option::None;
    return match *t {
        Typ::TArray { elem, size } => Option::Some(elem)
        | Typ::TPtr(i) => Option::Some(i)
        | Typ::TOwnPtr(i) => Option::Some(i)
        | _o => none
    };
}
fn loan_into(a: Allocator, ar: *Arena, sc: *const TyScope, tv: *const Texpr, slot: Option<*const Typ>) -> *const Texpr {
    return match slot {
        Option::Some(t) => coerce_own_to(a, ar, sc, tv, t)
        | Option::None => tv
    };
}
fn field_loan(a: Allocator, ar: *Arena, sc: *const TyScope, tname: *const Vec<str>,
              fname: str, tv: *const Texpr) -> *const Texpr {
    return match find_field_ty(sc.sc_sinfo, tname, fname) {
        Option::Some(fty) => coerce_own_to(a, ar, sc, tv, fty)
        | Option::None => tv
    };
}

fn elab_opt_base(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                 env: *const Vec<FieldTy>, base: Option<*const Expr>) -> Option<*const Texpr> {
    return match base {
        Option::Some(e) => Option::Some(elab_expr(a, ar, g, sc, env, none_ty(), e))
        | Option::None => { let n: Option<*const Texpr> = Option::None; n }
    };
}

fn tfield_ty(tfields: *const Vec<TexprField>, fname: str) -> Option<*const Typ> {
    let n = tfields.length();
    let sl = tfields.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(sl[i].name, fname) { return Option::Some(sl[i].value.ty); }
        i = i + 1 as u32;
    }
    let none: Option<*const Typ> = Option::None;
    return none;
}

// Infer tparam bindings for `Struct { .. }` by unifying each declared field
// type against the elaborated initialiser's type.
fn infer_struct_binds(sc: *const TyScope, tname: *const Vec<str>, tfields: *const Vec<TexprField>, out: *Vec<TVarBind>) {
    let n = sc.sc_sinfo.length();
    let sl = sc.sc_sinfo.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if path_eq(&sl[i].sf_path, tname) {
            match tfield_ty(tfields, sl[i].sf_name) {
                Option::Some(vt) => { unify_typ(sl[i].sf_ty, vt, out); }
                | Option::None => { }
            }
        }
        i = i + 1 as u32;
    }
}

// Bindings → instance args in first-seen tparam order.
fn dedup_bind_tys(a: Allocator, binds: *const Vec<TVarBind>) -> Vec<*const Typ> {
    let mut seen: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut out: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let n = binds.length();
    let sl = binds.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if !name_in(&seen, sl[i].tvb_name) {
            seen.push(sl[i].tvb_name);
            out.push(sl[i].tvb_ty);
        }
        i = i + 1 as u32;
    }
    return out;
}

// Register the substituted fields of a struct instance so `inst.field` reads
// resolve.  One push per field, behind a fn boundary (escape/affine clean).
fn push_instance_field(a: Allocator, ar: *Arena, sc: *const TyScope, ipath: *const Vec<str>, fname: str,
                       binds: *const Vec<TVarBind>, sf_ty: *const Typ) {
    sc.sc_mono_fields.push(StructField { sf_path: copy_strs(a, ipath), sf_name: fname, sf_ty: subst_typ_reg(a, ar, sc, binds, sf_ty) });
}
fn register_instance_fields(a: Allocator, ar: *Arena, sc: *const TyScope, tname: *const Vec<str>,
                            binds: *const Vec<TVarBind>, ipath: *const Vec<str>) {
    let n = sc.sc_sinfo.length();
    let sl = sc.sc_sinfo.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if path_eq(&sl[i].sf_path, tname) {
            push_instance_field(a, ar, sc, ipath, sl[i].sf_name, binds, sl[i].sf_ty);
        }
        i = i + 1 as u32;
    }
}

// The struct-lit's instance path: a generic struct infers its instance from
// the field initialisers (and registers it + its substituted fields); a
// `..base` spread reuses the base's already-resolved instance type.
fn struct_ty_path(a: Allocator, t: *const Typ, fallback: *const Vec<str>) -> Vec<str> {
    return match *t {
        Typ::TStruct(pp) => copy_strs(a, &pp)
        | _e => copy_strs(a, fallback)
    };
}
// A tparam nested inside another instance — `HashMap.slots: own *Slot<K, V>`
// against an already-monomorphized `own *Slot_i32_i32` — cannot be recovered by
// unifying the declared field type with the value type.  Fall back to the
// ambient instance bindings for the struct's own declared tparams (the enclosing
// method instance's K / V), filling only what inference left unbound.
// Push behind a fn boundary so `n` is a parameter, not the address of a local
// slice element (the escape pass rejects the latter).
fn push_tvarbind(binds: *Vec<TVarBind>, n: str, t: *const Typ) {
    binds.push(TVarBind { tvb_name: n, tvb_ty: t });
}
fn seed_struct_tparams(sc: *const TyScope, tname: *const Vec<str>, binds: *Vec<TVarBind>) {
    let name = path_last(tname);
    let sl = sc.sc_stps.as_slice();
    let mut i = 0 as u32;
    while i < sc.sc_stps.length() {
        if str::eq(sl[i].stp_name, name) {
            let psl = sl[i].stp_params.as_slice();
            let mut j = 0 as u32;
            while j < sl[i].stp_params.length() {
                match bind_lookup(binds, psl[j]) {
                    Option::Some(_t) => { }
                    | Option::None => {
                        match bind_lookup(sc.sc_tbinds, psl[j]) {
                            Option::Some(bt) => { push_tvarbind(binds, psl[j], bt); }
                            | Option::None => { }
                        }
                    }
                }
                j = j + 1 as u32;
            }
            return;
        }
        i = i + 1 as u32;
    }
}
fn build_struct_instance(a: Allocator, ar: *Arena, sc: *const TyScope, tname: *const Vec<str>,
                         tfields: *const Vec<TexprField>) -> Vec<str> {
    let mut binds: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
    infer_struct_binds(sc, tname, tfields, &binds);
    seed_struct_tparams(sc, tname, &binds);
    if binds.length() == 0 as u32 { return copy_strs(a, tname); }
    let args = dedup_bind_tys(a, &binds);
    let ipath = instance_path(a, ar, tname, &args);
    register_mono_struct_args(a, sc, &ipath, &args);
    register_instance_fields(a, ar, sc, tname, &binds, &ipath);
    return ipath;
}
fn struct_lit_path(a: Allocator, ar: *Arena, sc: *const TyScope, tname: *const Vec<str>,
                   tfields: *const Vec<TexprField>, tbase: Option<*const Texpr>) -> Vec<str> {
    return match tbase {
        Option::Some(b) => struct_ty_path(a, b.ty, tname)
        | Option::None => build_struct_instance(a, ar, sc, tname, tfields)
    };
}

// The instance path of an enum constructor `Enum::Variant(payload)`: infer
// from the payload field types (a tparam reachable through the payload), or
// — when the constructed enum's full type is already known from context (a
// return type or annotation) — take that expected instance directly (it
// seeds tparams the payload does not mention, e.g. `E` in `Result::Ok`).
fn infer_enum_instance(a: Allocator, ar: *Arena, sc: *const TyScope, epath: *const Vec<str>,
                       variant: str, tfields: *const Vec<TexprField>) -> Vec<str> {
    let mut binds: Vec<TVarBind> = Vec::with_capacity(a, 8 as u32);
    let n = tfields.length();
    let sl = tfields.as_slice();
    let mut i = 0 as u32;
    while i < n {
        match enum_field_ty(sc.sc_efields, epath, variant, sl[i].name) {
            Option::Some(fty) => { unify_typ(fty, sl[i].value.ty, &binds); }
            | Option::None => { }
        }
        i = i + 1 as u32;
    }
    if binds.length() == 0 as u32 { return copy_strs(a, epath); }
    let args = dedup_bind_tys(a, &binds);
    let ipath = instance_path(a, ar, epath, &args);
    register_mono_enum_args(a, sc, &ipath, &args);
    return ipath;
}

fn enum_instance_path(a: Allocator, ar: *Arena, sc: *const TyScope, expected: Option<*const Typ>,
                      epath: *const Vec<str>, variant: str, tfields: *const Vec<TexprField>) -> Vec<str> {
    return match expected {
        Option::Some(et) => match *et {
            Typ::TEnum(ep) => copy_strs(a, &ep)
            | _e => infer_enum_instance(a, ar, sc, epath, variant, tfields)
        }
        | Option::None => infer_enum_instance(a, ar, sc, epath, variant, tfields)
    };
}

fn elab_struct_lit(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                   env: *const Vec<FieldTy>, tname: *const Vec<str>, fields: *const Vec<Field>,
                   base: Option<*const Expr>, p: Pos) -> *const Texpr {
    // `Enum::Variant { .. }` — a struct-variant constructor when the index
    // knows the (enum-path, variant) split of `tname`.
    if tname.length() >= 2 as u32 {
        let last = path_last(tname);
        let init = qualify_type_path(a, ar, sc, &path_init(a, tname));
        let tag = variant_tag(sc.sc_etags, &init, last);
        if tag >= 0 as int {
            return mk_enum_lit_node(a, ar, &init, last, tag, enum_struct_args(a, ar, g, sc, env, &init, last, fields), p);
        }
    }
    let qtname = qualify_type_path(a, ar, sc, tname);
    let tfields = elab_struct_fields(a, ar, g, sc, env, &qtname, fields);
    let tbase = elab_opt_base(a, ar, g, sc, env, base);
    let ipath = struct_lit_path(a, ar, sc, &qtname, &tfields, tbase);
    let sty = ty_node(ar, Typ::TStruct(copy_strs(a, &ipath)));
    return te_node(ar, TexprNode::TStructLit { sname_path: ipath, fields: tfields, base: tbase }, sty, p);
}

// `new(alloc) ...` heap-allocates and yields `own *T` (DR-030/031).  The
// allocator expression elaborates like any value (its type is Allocator).

fn elab_alloc_opt(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                  env: *const Vec<FieldTy>, alloc: Option<*const Expr>) -> Option<*const Texpr> {
    return match alloc {
        Option::Some(ae) => Option::Some(elab_expr(a, ar, g, sc, env, none_ty(), ae))
        | Option::None => none_texpr()
    };
}

// `new(a) S { .. }` → a heap struct of type `own *S`.
fn elab_new_struct(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                   tname: *const Vec<str>, fields: *const Vec<Field>, base: Option<*const Expr>, alloc: Option<*const Expr>, p: Pos) -> *const Texpr {
    let talloc = elab_alloc_opt(a, ar, g, sc, env, alloc);
    let qtname = qualify_type_path(a, ar, sc, tname);
    let tfields = elab_struct_fields(a, ar, g, sc, env, &qtname, fields);
    let tbase = elab_opt_base(a, ar, g, sc, env, base);
    let ipath = struct_lit_path(a, ar, sc, &qtname, &tfields, tbase);
    let sty = ty_node(ar, Typ::TStruct(copy_strs(a, &ipath)));
    let oty = ty_node(ar, Typ::TOwnPtr(sty));
    return te_node(ar, TexprNode::TNew { sname_path: ipath, fields: tfields, base: tbase, alloc: talloc }, oty, p);
}

// `new(a) E::V(args)` → a heap-boxed enum tuple-variant of type `own *E`.
fn elab_new_enum(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                 tname: *const Vec<str>, args: *const Vec<*const Expr>, alloc: Option<*const Expr>, p: Pos) -> *const Texpr {
    let last = path_last(tname);
    let init = qualify_type_path(a, ar, sc, &path_init(a, tname));
    let tag = variant_tag(sc.sc_etags, &init, last);
    if tag < 0 as int { return defer_expr(ar, p); }
    let talloc = elab_alloc_opt(a, ar, g, sc, env, alloc);
    let tflds = enum_tuple_args(a, ar, g, sc, env, &init, last, args);
    let inst = enum_instance_path(a, ar, sc, none_ty(), &init, last, &tflds);
    let ety = ty_node(ar, Typ::TEnum(copy_strs(a, &inst)));
    let oty = ty_node(ar, Typ::TOwnPtr(ety));
    return te_node(ar, TexprNode::TNewEnum { ename_path: inst, variant: last, tag: tag, args: tflds, alloc: talloc }, oty, p);
}

fn elab_ref(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
            env: *const Vec<FieldTy>, sub: *const Expr, p: Pos) -> *const Texpr {
    let ts = elab_expr(a, ar, g, sc, env, none_ty(), sub);
    let rty = ty_node(ar, Typ::TPtr(ts.ty));
    return te_node(ar, TexprNode::TRef(ts), rty, p);
}

fn elab_deref(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
              env: *const Vec<FieldTy>, sub: *const Expr, p: Pos) -> *const Texpr {
    let ts = elab_expr(a, ar, g, sc, env, none_ty(), sub);
    return match deref_pointee(ts.ty) {
        Option::Some(inner) => te_node(ar, TexprNode::TDeref(ts), inner, p)
        | Option::None => defer_expr(ar, p)
    };
}

// A block expression `{ stmts; trailing }`: the statements elaborate into a
// block-local env (block lets extend the surrounding scope, no shadowing),
// and a trailing expression — the last statement without `;` — becomes the
// block's value.  A `for` inside a block is not yet supported here (it needs
// the gensym counter the expr path does not carry) and defers.
// The type of a plain assignment's target (a local binding), so an `own *T`
// value assigned to a `*T` / `*const T` slot coerces (the owner is moved /
// borrowed into the slot, not kept as an owner).
fn assign_target_ty(env: *const Vec<FieldTy>, path: *const Vec<str>) -> Option<*const Typ> {
    if path.length() == 0 as u32 { return none_ty(); }
    let psl = path.as_slice();
    return env_lookup(env, psl[0 as u32]);
}
fn assign_coerced_value(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                        env: *const Vec<FieldTy>, path: *const Vec<str>, value: *const Expr) -> *const Texpr {
    let av = elab_expr(a, ar, g, sc, env, none_ty(), value);
    return match assign_target_ty(env, path) {
        Option::Some(t) => coerce_own_to(a, ar, sc, av, t)
        | Option::None => av
    };
}

// A bare `if` inside a value block (a match-arm body holding `if c { break }`)
// is a control-flow statement, not a value: lower it to `TIf` (branches are
// full stmt-blocks) rather than an if-expr with `null` arms.  The enclosing
// fn's gensym + return type ride in the scope so the branch bodies elaborate
// like any statement block.
// A trailing block statement: a bare `if` (no else) can't yield a value on
// every path, so even in tail position it lowers to a control-flow statement
// (matching the oracle), not a trailing `if-expr`; anything else is the block's
// trailing value.
fn elab_tail_stmt(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                  expected: Option<*const Typ>, e: *const Expr, benv: *Vec<FieldTy>,
                  tstmts: *Vec<Tstmt>, trailing: *Option<*const Texpr>) {
    if is_bare_if(e) { elab_block_expr_stmt(a, ar, g, sc, benv, e, tstmts); return; }
    *trailing = Option::Some(elab_expr(a, ar, g, sc, benv, expected, e));
    return;
}
// An `if` with no else branch — a value can't exist on every path, so it is
// always a control-flow statement, never a trailing value.
fn is_bare_if(e: *const Expr) -> bool {
    return match *e {
        Expr::If { cond, then_blk, else_blk } => match else_blk { Option::None => true | Option::Some(b) => false }
        | _other => false
    };
}
fn elab_block_expr_stmt(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                        benv: *Vec<FieldTy>, e: *const Expr, out: *Vec<Tstmt>) {
    match *e {
        Expr::If { cond, then_blk, else_blk } => {
            let tcond = elab_expr(a, ar, g, sc, benv, none_ty(), cond);
            let tthen = elab_stmt_body(a, ar, g, sc, sc.sc_gensym, benv, sc.sc_ret, &then_blk);
            let telse = elab_else_stmt_body(a, ar, g, sc, sc.sc_gensym, benv, sc.sc_ret, else_blk);
            out.push(Tstmt::TIf { cond: tcond, then_body: tthen, else_body: telse });
        }
        | _other => { out.push(Tstmt::TExprStmt(elab_expr(a, ar, g, sc, benv, none_ty(), e))); }
    }
}
fn elab_block_stmt(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                   expected: Option<*const Typ>, s: *const Stmt, benv: *Vec<FieldTy>,
                   tstmts: *Vec<Tstmt>, trailing: *Option<*const Texpr>) {
    match *s {
        Stmt::Let { name, value, ty_ann, is_mut, pos } => {
            let vl = elab_expr(a, ar, g, sc, benv, let_expected(a, ar, sc, ty_ann), value);
            let ety = let_env_ty(a, ar, sc, ty_ann, vl.ty);
            check_let_ty(a, ar, sc, name, value, ty_ann, vl.ty, pos);
            let lent = coerce_own_to(a, ar, sc, vl, ety);
            if is_mut { note_let_mut(sc, name); }
            benv.push(FieldTy { name: name, ty: ety });
            tstmts.push(Tstmt::TLet { name: name, value: lent, decl_ty: ety, pos: expr_pos(value) });
        }
        | Stmt::ExprStmt(e) => { elab_block_expr_stmt(a, ar, g, sc, benv, e, tstmts); }
        | Stmt::Tail(e) => { elab_tail_stmt(a, ar, g, sc, expected, e, benv, tstmts, trailing); }
        | Stmt::Assign { path, value, pos } => {
            if path.length() == 1 as u32 { require_mut(a, ar, sc, path.as_slice()[0 as u32], "assign to", pos); }
            let av = assign_coerced_value(a, ar, g, sc, benv, &path, value);
            tstmts.push(Tstmt::TAssign { path: copy_strs(a, &path), value: av, pos: pos });
        }
        | Stmt::AssignField { target, field, value, pos } => {
            let taf = elab_expr(a, ar, g, sc, benv, none_ty(), target);
            require_mut_root(a, ar, sc, taf, "mutate field of", pos);
            let fexp = struct_field_ty(sc, taf.ty, field);
            let vaf = loan_into(a, ar, sc, elab_expr(a, ar, g, sc, benv, fexp, value), fexp);
            tstmts.push(Tstmt::TAssignField { target: taf, field: field, value: vaf, pos: pos });
        }
        | Stmt::AssignDeref { target, value, pos } => {
            let tad = elab_expr(a, ar, g, sc, benv, none_ty(), target);
            let dexp = deref_pointee(tad.ty);
            let vad = loan_into(a, ar, sc, elab_expr(a, ar, g, sc, benv, dexp, value), dexp);
            tstmts.push(Tstmt::TAssignDeref { target: tad, value: vad, pos: pos });
        }
        | Stmt::AssignIndex { base, index, value, pos } => {
            let tbi = elab_expr(a, ar, g, sc, benv, none_ty(), base);
            let tii = elab_expr(a, ar, g, sc, benv, none_ty(), index);
            let tvi = elab_expr(a, ar, g, sc, benv, none_ty(), value);
            tstmts.push(Tstmt::TAssignIndex { base: tbi, index: tii, value: tvi, pos: pos });
        }
        | Stmt::Break(pos) => { tstmts.push(Tstmt::TBreak(pos)); }
        | Stmt::Continue(pos) => { tstmts.push(Tstmt::TContinue(pos)); }
        | Stmt::LetTuple { names, value, is_mut } => {
            let tvt = elab_expr(a, ar, g, sc, benv, none_ty(), value);
            bind_tuple_names(&names, tvt.ty, benv);
            tstmts.push(Tstmt::TLetTuple { names: copy_strs(a, &names), value: tvt, pos: expr_pos(value) });
        }
        // Control-flow statements (while / for / return / defer / with) that a
        // block expression can also contain go through the function-body
        // statement elaborator.
        | _other => { elab_stmt(a, ar, g, sc, sc.sc_gensym, benv, sc.sc_ret, s, tstmts); }
    }
}

fn elab_block(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
              expected: Option<*const Typ>, stmts: *const Vec<Stmt>, p: Pos) -> *const Texpr {
    let mut benv = copy_fieldtys(a, env);
    let mut tstmts: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let mut trailing: Option<*const Texpr> = Option::None;
    let n = stmts.length();
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < n {
        elab_block_stmt(a, ar, g, sc, expected, &sl[i], &benv, &tstmts, &trailing);
        i = i + 1 as u32;
    }
    let bty = match trailing {
        Option::Some(t) => t.ty
        | Option::None => t_i32(ar)
    };
    return te_node(ar, TexprNode::TBlock { stmts: tstmts, trailing: trailing }, bty, p);
}

// `(e0, e1, …)` — each element keeps its own type; the tuple takes a
// `TTuple` of the element types.
fn elab_tuple_lit(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope,
                  env: *const Vec<FieldTy>, es: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    let mut tes: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    let mut tys: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let n = es.length();
    let sl = es.as_slice();
    let mut i = 0 as u32;
    while i < n {
        let te = elab_expr(a, ar, g, sc, env, none_ty(), sl[i]);
        tys.push(te.ty);
        tes.push(te);
        i = i + 1 as u32;
    }
    return te_node(ar, TexprNode::TTupleLit(tes), ty_node(ar, Typ::TTuple(tys)), p);
}

// A `[T; N]` expected type propagates its element type to each element / the
// repeat value so integer-literal widths agree.
fn array_elem_expected(expected: Option<*const Typ>) -> Option<*const Typ> {
    return match expected {
        Option::Some(t) => match *t { Typ::TArray { elem, size } => Option::Some(elem) | _e => none_ty() }
        | Option::None => none_ty()
    };
}

fn array_elem_ty(t: *const Typ) -> Option<*const Typ> {
    return match *t {
        Typ::TArray { elem, size } => Option::Some(elem)
        | _e => none_ty()
    };
}

// `[e0, e1, ..]` — every element shares one type; the size is the count.
fn elab_array_lit(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                  expected: Option<*const Typ>, es: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    let eexp = array_elem_expected(expected);
    let mut tes: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    let n = es.length();
    let sl = es.as_slice();
    let mut i = 0 as u32;
    while i < n { tes.push(elab_expr(a, ar, g, sc, env, eexp, sl[i])); i = i + 1 as u32; }
    let tsl = tes.as_slice();
    let elem_ty = if n == 0 as u32 { t_i32(ar) } else { tsl[0 as u32].ty };
    let aty = ty_node(ar, Typ::TArray { elem: elem_ty, size: n as int });
    return te_node(ar, TexprNode::TArrayLit(tes), aty, p);
}

// `[v; N]` — N copies of the value; N folds at compile time.
fn elab_array_repeat(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                     expected: Option<*const Typ>, value: *const Expr, count: *const Expr, p: Pos) -> *const Texpr {
    let eexp = array_elem_expected(expected);
    let tv = elab_expr(a, ar, g, sc, env, eexp, value);
    let n = array_size_of(count, sc);
    let aty = ty_node(ar, Typ::TArray { elem: tv.ty, size: n });
    return te_node(ar, TexprNode::TArrayRepeat { value: tv, count: n }, aty, p);
}

// `base[i]` — read an element.  One layer of `*T` auto-derefs (mirrors the
// field-access auto-deref); the element type comes from the array.  A
// non-array base defers so the gap stays visible.
fn ann_node(ar: *Arena, t: TypeAnn) -> *const TypeAnn {
    let n: *TypeAnn = ar.alloc_borrowed();
    if n == null { arena_oom(); }
    *n = t;
    return n as *const TypeAnn;
}
fn is_range_instance(t: *const Typ) -> bool {
    return match *t {
        Typ::TStruct(path) => { let nm = path_last(&path); str::eq(nm, "Range") || str_starts_with(nm, "Range_") || str::eq(nm, "RangeInclusive") || str_starts_with(nm, "RangeInclusive_") }
        | _e => false
    };
}
fn is_range_inclusive_instance(t: *const Typ) -> bool {
    return match *t {
        Typ::TStruct(path) => { let nm = path_last(&path); str::eq(nm, "RangeInclusive") || str_starts_with(nm, "RangeInclusive_") }
        | _e => false
    };
}
// A `[]` over a `Range` value sub-slices using the range's `lo` / `hi` fields.
fn range_bound(ar: *Arena, sc: *const TyScope, range_te: *const Texpr, field: str, p: Pos) -> *const Texpr {
    let fty = voidable_ty(ar, struct_field_ty(sc, range_te.ty, field));
    return te_node(ar, TexprNode::TFieldAccess { target: range_te, field: field }, fty, p);
}
fn elab_scalar_index(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                     tb: *const Texpr, index: *const Expr, p: Pos) -> *const Texpr {
    let ti = elab_expr(a, ar, g, sc, env, none_ty(), index);
    if is_range_instance(ti.ty) {
        let lo_te = range_bound(ar, sc, ti, "lo", p);
        let hi_te = range_bound(ar, sc, ti, "hi", p);
        return build_slice_from_bounds(a, ar, sc, tb, lo_te, hi_te, is_range_inclusive_instance(ti.ty), p);
    }
    return match index_elem_ty(sc, tb.ty) {
        Option::Some(elem) => te_node(ar, TexprNode::TIndex { base: tb, index: ti }, elem, p)
        | Option::None => defer_expr(ar, p)
    };
}
// `base[lo..hi]` / `base[lo..=hi]` (DR-011) builds a read-only `Slice<T>` view:
// `{ ptr: &base[lo], len: (hi - lo [+ 1]) as u32 }`.
fn add_one(ar: *Arena, e: *const Texpr, bty: *const Typ, p: Pos) -> *const Texpr {
    let one = te_node(ar, TexprNode::TIntLit(1 as int), bty, p);
    return te_node(ar, TexprNode::TBinOp(BinOp::Add, e, one), bty, p);
}
fn build_slice_from_bounds(a: Allocator, ar: *Arena, sc: *const TyScope, tb: *const Texpr,
                           lo_te: *const Texpr, hi_te: *const Texpr, inclusive: bool, p: Pos) -> *const Texpr {
    let elem = voidable_ty(ar, index_elem_ty(sc, tb.ty));
    let idx = te_node(ar, TexprNode::TIndex { base: tb, index: lo_te }, elem, p);
    let ptr = te_node(ar, TexprNode::TRef(idx), ty_node(ar, Typ::TConstPtr(elem)), p);
    let bty = lo_te.ty;
    let diff = te_node(ar, TexprNode::TBinOp(BinOp::Sub, hi_te, lo_te), bty, p);
    let len_inner = if inclusive { add_one(ar, diff, bty, p) } else { diff };
    let u32ann = ann_node(ar, TypeAnn::TyInt { is_signed: false, width: IntWidth::W32 });
    let len = te_node(ar, TexprNode::TCast(len_inner, u32ann), t_u32(ar), p);
    let mut sargs: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    sargs.push(elem);
    let mut skel: Vec<str> = Vec::with_capacity(a, 8 as u32);
    skel.push("Slice");
    let ipath = instance_path(a, ar, &skel, &sargs);
    register_mono_struct(a, sc, &ipath);
    register_prelude_struct_fields(a, ar, sc, "Slice", &sargs, &ipath);
    let mut fields: Vec<TexprField> = Vec::with_capacity(a, 8 as u32);
    fields.push(TexprField { name: "ptr", value: ptr });
    fields.push(TexprField { name: "len", value: len });
    let no_base: Option<*const Texpr> = Option::None;
    let sty = ty_node(ar, Typ::TStruct(copy_strs(a, &ipath)));
    return te_node(ar, TexprNode::TStructLit { sname_path: ipath, fields: fields, base: no_base }, sty, p);
}
fn elab_sub_slice(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                  tb: *const Texpr, lo: *const Expr, hi: *const Expr, inclusive: bool, p: Pos) -> *const Texpr {
    let lo_te = elab_expr(a, ar, g, sc, env, none_ty(), lo);
    let hi_te = elab_expr(a, ar, g, sc, env, none_ty(), hi);
    return build_slice_from_bounds(a, ar, sc, tb, lo_te, hi_te, inclusive, p);
}
// A `lo..hi` / `lo..=hi` value (outside `[]`) is a `Range<T>` /
// `RangeInclusive<T>` struct with `lo` / `hi` fields.
fn elab_range_value(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                    lo: *const Expr, hi: *const Expr, inclusive: bool, p: Pos) -> *const Texpr {
    let lo_te = elab_expr(a, ar, g, sc, env, none_ty(), lo);
    let hi_te = elab_expr(a, ar, g, sc, env, none_ty(), hi);
    let name = if inclusive { "RangeInclusive" } else { "Range" };
    let mut sargs: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    sargs.push(lo_te.ty);
    let mut skel: Vec<str> = Vec::with_capacity(a, 8 as u32);
    skel.push(name);
    let ipath = instance_path(a, ar, &skel, &sargs);
    register_mono_struct(a, sc, &ipath);
    register_prelude_struct_fields(a, ar, sc, name, &sargs, &ipath);
    let mut fields: Vec<TexprField> = Vec::with_capacity(a, 8 as u32);
    fields.push(TexprField { name: "lo", value: lo_te });
    fields.push(TexprField { name: "hi", value: hi_te });
    let no_base: Option<*const Texpr> = Option::None;
    let sty = ty_node(ar, Typ::TStruct(copy_strs(a, &ipath)));
    return te_node(ar, TexprNode::TStructLit { sname_path: ipath, fields: fields, base: no_base }, sty, p);
}
fn elab_index(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
              base: *const Expr, index: *const Expr, p: Pos) -> *const Texpr {
    let tb0 = elab_expr(a, ar, g, sc, env, none_ty(), base);
    let tb = match deref_pointee(tb0.ty) {
        Option::Some(inner) => te_node(ar, TexprNode::TDeref(tb0), inner, tb0.pos)
        | Option::None => tb0
    };
    return match *index {
        Expr::Range { lo, hi, inclusive } => elab_sub_slice(a, ar, g, sc, env, tb, lo, hi, inclusive, p)
        | _other => elab_scalar_index(a, ar, g, sc, env, tb, index, p)
    };
}
// The element type of an indexable base: an array's element, or a `Slice`'s
// `ptr` pointee (`*const T` -> T).
fn index_elem_ty(sc: *const TyScope, t: *const Typ) -> Option<*const Typ> {
    return match array_elem_ty(t) {
        Option::Some(e) => Option::Some(e)
        | Option::None => match slice_elem_ty(sc, t) {
            Option::Some(e) => Option::Some(e)
            | Option::None => vec_elem_ty(sc, t)
        }
    };
}
fn slice_elem_ty(sc: *const TyScope, t: *const Typ) -> Option<*const Typ> {
    if !is_slice_instance(t) { return none_ty(); }
    return match struct_field_ty(sc, t, "ptr") {
        Option::Some(pt) => deref_pointee(pt)
        | Option::None => none_ty()
    };
}
// `Vec<T>` indexing: element type from the mono'd `ptr : own *T` field.
// Enables `v[i]` and `with x in v[i]` (DR-012 projection over a Vec).
fn vec_elem_ty(sc: *const TyScope, t: *const Typ) -> Option<*const Typ> {
    if !is_vec_instance(t) { return none_ty(); }
    return match struct_field_ty(sc, t, "ptr") {
        Option::Some(pt) => deref_pointee(pt)
        | Option::None => none_ty()
    };
}
fn is_vec_instance(t: *const Typ) -> bool {
    return match *t {
        Typ::TStruct(path) => { let nm = path_last(&path); str::eq(nm, "Vec") || str_starts_with(nm, "Vec_") }
        | _e => false
    };
}

// `len(a)` folds to the array's compile-time size N (an `int` so `i < len(a)`
// pairs with index loops).  A non-array argument defers.
fn elab_len(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
            args: *const Vec<*const Expr>, p: Pos) -> *const Texpr {
    if args.length() != 1 as u32 { return defer_expr(ar, p); }
    let sl = args.as_slice();
    let ta = elab_expr(a, ar, g, sc, env, none_ty(), sl[0 as u32]);
    return match *ta.ty {
        Typ::TArray { elem, size } => te_node(ar, TexprNode::TIntLit(size), t_i32(ar), p)
        | _other => defer_expr(ar, p)
    };
}

fn elab_expr(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
             expected: Option<*const Typ>, e: *const Expr) -> *const Texpr {
    let p = expr_pos(e);
    return match *e {
        Expr::IntLit(n, _q) => te_node(ar, TexprNode::TIntLit(n), int_lit_ty(ar, expected), p)
        | Expr::BoolLit(b, _q) => te_node(ar, TexprNode::TBoolLit(b), t_bool(ar), p)
        | Expr::StringLit(s, _q) => te_node(ar, TexprNode::TStringLit(s), t_str(ar), p)
        | Expr::NullLit(_q) => te_node(ar, TexprNode::TNullLit, ty_node(ar, Typ::TNullPtr), p)
        | Expr::FloatLit(f, w, _q) => te_node(ar, TexprNode::TFloatLit(f, w), ty_node(ar, Typ::TFloat(w)), p)
        | Expr::Var(name, _q) => elab_var(a, ar, g, sc, env, name, p)
        | Expr::Neg(sub, _q) => elab_neg(a, ar, g, sc, env, expected, sub, p)
        | Expr::BitNot(sub, _q) => elab_bitnot(a, ar, g, sc, env, expected, sub, p)
        | Expr::Not(sub, _q) => elab_not(a, ar, g, sc, env, sub, p)
        | Expr::BinOp(op, l, r, _q) => elab_binop(a, ar, g, sc, env, expected, op, l, r, p)
        | Expr::Cast(sub, ann, _q) => elab_cast(a, ar, g, sc, env, sub, ann, p)
        | Expr::Call { callee, args } => elab_call(a, ar, g, sc, env, expected, &callee, &args, p)
        | Expr::MethodCall { receiver, name, args } => elab_method_call(a, ar, g, sc, env, expected, receiver, name, &args, p)
        | Expr::Block(stmts, _q) => elab_block(a, ar, g, sc, env, expected, &stmts, p)
        | Expr::TupleLit(es, _q) => elab_tuple_lit(a, ar, g, sc, env, &es, p)
        | Expr::If { cond, then_blk, else_blk } =>
            mk_if_expr(a, ar, g, sc, env, expected, cond, &then_blk, else_blk, p)
        | Expr::EnumLit { tname, variant } => elab_enumlit(a, ar, g, sc, expected, &tname, variant, p)
        | Expr::Match { scrutinee, arms } => elab_match(a, ar, g, sc, env, expected, scrutinee, &arms, p)
        | Expr::FieldAccess(target, field, _q) => elab_field_access(a, ar, g, sc, env, target, field, p)
        | Expr::StructLit { tname, fields, base } => elab_struct_lit(a, ar, g, sc, env, &tname, &fields, base, p)
        | Expr::Ref(sub, _q) => elab_ref(a, ar, g, sc, env, sub, p)
        | Expr::Deref(sub, _q) => elab_deref(a, ar, g, sc, env, sub, p)
        | Expr::ArrayLit(es, _q) => elab_array_lit(a, ar, g, sc, env, expected, &es, p)
        | Expr::ArrayRepeat { value, count } => elab_array_repeat(a, ar, g, sc, env, expected, value, count, p)
        | Expr::Index { base, index } => elab_index(a, ar, g, sc, env, base, index, p)
        | Expr::Orelse(value, dflt, _q) => elab_orelse(a, ar, g, sc, env, expected, value, dflt, p)
        | Expr::Try(value, _q) => elab_try(a, ar, g, sc, env, value, p)
        | Expr::New { tname, fields, base, alloc } => elab_new_struct(a, ar, g, sc, env, &tname, &fields, base, alloc, p)
        | Expr::NewEnum { tname, args, alloc } => elab_new_enum(a, ar, g, sc, env, &tname, &args, alloc, p)
        | Expr::Range { lo, hi, inclusive } => elab_range_value(a, ar, g, sc, env, lo, hi, inclusive, p)
        | Expr::Lambda { params, ret_ty, body, captures } => elab_lambda(a, ar, g, sc, env, e, &params, ret_ty, p)
        | Expr::SizeOf(t, _q) => te_node(ar, TexprNode::TSizeOf(resolve_sig_ty(a, ar, sc, t)), ty_node(ar, Typ::TCInt { is_signed: false }), p)
    };
}

// ===== A2 capturing closures (DR-024 / DR-033) =====
//
// A lambda referencing an outer binding can't decay to a bare C function
// pointer — the referenced value has to travel with it.  Mirroring the
// oracle's `expand_lambdas`, a capturing lambda becomes an env struct
// `__closure_N { caps.. }` implementing `Fn{arity}` (a `call` method whose
// body is the lambda body with each capture rewritten to `self.<name>`),
// and the lambda expression itself becomes a struct literal building the
// env from the surrounding scope.  Unlike the oracle (a pre-typecheck
// pass with no types), the self-host elaborates lambdas in place, so a
// capture's type comes straight from the live `env`.

// Free variables of an expression: names referenced as `Var` that are not
// bound by `bound` (lambda params + internal lets/patterns).  Collected
// into `acc` (dedup against existing entries).
fn push_if_absent(out: *Vec<str>, n: str) {
    if !name_in(out, n) { out.push(n); }
    return;
}
fn pat_add_name(out: *Vec<str>, n: str) {
    if !str::eq(n, "_") { push_if_absent(out, n); }
    return;
}
fn fv_add(bound: *const Vec<str>, acc: *Vec<str>, n: str) {
    if !name_in(bound, n) { push_if_absent(acc, n); }
    return;
}
fn copy_tyanns(a: Allocator, src: *const Vec<*const TypeAnn>) -> Vec<*const TypeAnn> {
    let mut out: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    let n = src.length();
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}
fn fv_exprs(a: Allocator, bound: *const Vec<str>, es: *const Vec<*const Expr>, acc: *Vec<str>) {
    let n = es.length();
    let sl = es.as_slice();
    let mut i = 0 as u32;
    while i < n { fv_expr(a, bound, sl[i], acc); i = i + 1 as u32; }
}
fn fv_opt(a: Allocator, bound: *const Vec<str>, oe: Option<*const Expr>, acc: *Vec<str>) {
    match oe { Option::Some(e) => fv_expr(a, bound, e, acc) | Option::None => {} }
}
fn fv_fields(a: Allocator, bound: *const Vec<str>, fields: *const Vec<Field>, acc: *Vec<str>) {
    let n = fields.length();
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < n { fv_expr(a, bound, sl[i].value, acc); i = i + 1 as u32; }
}
fn fv_enum_args(a: Allocator, bound: *const Vec<str>, args: *const EnumLitArgs, acc: *Vec<str>) {
    match *args {
        EnumLitArgs::EATuple(es) => fv_exprs(a, bound, &es, acc)
        | EnumLitArgs::EAStruct(fields) => fv_fields(a, bound, &fields, acc)
    }
}
fn pat_names_vec(a: Allocator, pats: *const Vec<Pattern>, out: *Vec<str>) {
    let n = pats.length();
    let sl = pats.as_slice();
    let mut i = 0 as u32;
    while i < n { pat_bound_names(a, &sl[i], out); i = i + 1 as u32; }
}
fn pat_names_fieldpats(a: Allocator, fps: *const Vec<FieldPat>, out: *Vec<str>) {
    let n = fps.length();
    let sl = fps.as_slice();
    let mut i = 0 as u32;
    while i < n { pat_bound_names(a, &sl[i].pat, out); i = i + 1 as u32; }
}
fn pat_bound_names(a: Allocator, pat: *const Pattern, out: *Vec<str>) {
    match *pat {
        Pattern::PVar(n, _q) => pat_add_name(out, n)
        | Pattern::PVariant { tname, variant, binds } => {
            match binds {
                PatBinds::PBTuple(ps) => pat_names_vec(a, &ps, out)
                | PatBinds::PBStruct(fps) => pat_names_fieldpats(a, &fps, out)
            }
        }
        | Pattern::POr(alts, _q) => pat_names_vec(a, &alts, out)
        | _other => {}
    }
}
fn fv_arms(a: Allocator, bound: *const Vec<str>, arms: *const Vec<MatchArm>, acc: *Vec<str>) {
    let n = arms.length();
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < n {
        let mut b = copy_strs(a, bound);
        pat_bound_names(a, &sl[i].pat, &b);
        match sl[i].guard { Option::Some(ge) => fv_expr(a, &b, ge, acc) | Option::None => {} }
        fv_expr(a, &b, sl[i].body, acc);
        i = i + 1 as u32;
    }
}
fn fv_else(a: Allocator, bound: *const Vec<str>, else_blk: Option<Vec<Stmt>>, acc: *Vec<str>) {
    match else_blk { Option::Some(blk) => fv_stmts(a, bound, &blk, acc) | Option::None => {} }
}
fn fv_lambda(a: Allocator, bound: *const Vec<str>, params: *const Vec<FieldDef>, body: *const Expr, acc: *Vec<str>) {
    let mut b = copy_strs(a, bound);
    let n = params.length();
    let sl = params.as_slice();
    let mut i = 0 as u32;
    while i < n { b.push(sl[i].name); i = i + 1 as u32; }
    fv_expr(a, &b, body, acc);
}
fn fv_expr(a: Allocator, bound: *const Vec<str>, e: *const Expr, acc: *Vec<str>) {
    match *e {
        Expr::Var(n, _q) => fv_add(bound, acc, n)
        | Expr::Neg(s, _q) => fv_expr(a, bound, s, acc)
        | Expr::BitNot(s, _q) => fv_expr(a, bound, s, acc)
        | Expr::Not(s, _q) => fv_expr(a, bound, s, acc)
        | Expr::Try(s, _q) => fv_expr(a, bound, s, acc)
        | Expr::Cast(s, _t, _q) => fv_expr(a, bound, s, acc)
        | Expr::FieldAccess(s, _f, _q) => fv_expr(a, bound, s, acc)
        | Expr::Ref(s, _q) => fv_expr(a, bound, s, acc)
        | Expr::Deref(s, _q) => fv_expr(a, bound, s, acc)
        | Expr::BinOp(_op, l, r, _q) => { fv_expr(a, bound, l, acc); fv_expr(a, bound, r, acc); }
        | Expr::Orelse(l, r, _q) => { fv_expr(a, bound, l, acc); fv_expr(a, bound, r, acc); }
        | Expr::Index { base, index } => { fv_expr(a, bound, base, acc); fv_expr(a, bound, index, acc); }
        | Expr::Range { lo, hi, inclusive } => { fv_expr(a, bound, lo, acc); fv_expr(a, bound, hi, acc); }
        | Expr::Call { callee, args } => fv_exprs(a, bound, &args, acc)
        | Expr::MethodCall { receiver, name, args } => { fv_expr(a, bound, receiver, acc); fv_exprs(a, bound, &args, acc); }
        | Expr::TupleLit(es, _q) => fv_exprs(a, bound, &es, acc)
        | Expr::ArrayLit(es, _q) => fv_exprs(a, bound, &es, acc)
        | Expr::ArrayRepeat { value, count } => { fv_expr(a, bound, value, acc); fv_expr(a, bound, count, acc); }
        | Expr::StructLit { tname, fields, base } => { fv_fields(a, bound, &fields, acc); fv_opt(a, bound, base, acc); }
        | Expr::New { tname, fields, base, alloc } => { fv_fields(a, bound, &fields, acc); fv_opt(a, bound, base, acc); fv_opt(a, bound, alloc, acc); }
        | Expr::NewEnum { tname, args, alloc } => { fv_exprs(a, bound, &args, acc); fv_opt(a, bound, alloc, acc); }
        | Expr::EnumLit { tname, variant, args } => fv_enum_args(a, bound, &args, acc)
        | Expr::Match { scrutinee, arms } => { fv_expr(a, bound, scrutinee, acc); fv_arms(a, bound, &arms, acc); }
        | Expr::Block(stmts, _q) => fv_stmts(a, bound, &stmts, acc)
        | Expr::If { cond, then_blk, else_blk } => { fv_expr(a, bound, cond, acc); fv_stmts(a, bound, &then_blk, acc); fv_else(a, bound, else_blk, acc); }
        | Expr::Lambda { params, ret_ty, body, captures } => fv_lambda(a, bound, &params, body, acc)
        | _other => {}
    }
}
fn fv_stmts(a: Allocator, bound: *const Vec<str>, stmts: *const Vec<Stmt>, acc: *Vec<str>) {
    let mut b = copy_strs(a, bound);
    let n = stmts.length();
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < n {
        match sl[i] {
            Stmt::Let { name, value, ty_ann, is_mut } => { fv_expr(a, &b, value, acc); b.push(name); }
            | Stmt::LetTuple { names, value, is_mut } => { fv_expr(a, &b, value, acc); let m = names.length(); let nsl = names.as_slice(); let mut k = 0 as u32; while k < m { b.push(nsl[k]); k = k + 1 as u32; } }
            | Stmt::LetElse { pat, value, else_body } => { fv_expr(a, &b, value, acc); fv_stmts(a, &b, &else_body, acc); pat_bound_names(a, &pat, &b); }
            | Stmt::Assign { path, value } => { let h = path.get(0 as u32) orelse ""; if !name_in(&b, h) { if !name_in(acc, h) { acc.push(h); } } fv_expr(a, &b, value, acc); }
            | Stmt::AssignField { target, field, value } => { fv_expr(a, &b, target, acc); fv_expr(a, &b, value, acc); }
            | Stmt::AssignIndex { base, index, value } => { fv_expr(a, &b, base, acc); fv_expr(a, &b, index, acc); fv_expr(a, &b, value, acc); }
            | Stmt::AssignDeref { target, value } => { fv_expr(a, &b, target, acc); fv_expr(a, &b, value, acc); }
            | Stmt::Return(oe, _q) => fv_opt(a, &b, oe, acc)
            | Stmt::ExprStmt(e) => fv_expr(a, &b, e, acc)
            | Stmt::Tail(e) => fv_expr(a, &b, e, acc)
            | Stmt::While { cond, body } => { fv_expr(a, &b, cond, acc); fv_stmts(a, &b, &body, acc); }
            | Stmt::For { iter_var, range, body } => { fv_expr(a, &b, range, acc); let mut bb = copy_strs(a, &b); bb.push(iter_var); fv_stmts(a, &bb, &body, acc); }
            | Stmt::Defer { body } => fv_stmts(a, &b, &body, acc)
            | Stmt::With { target, name, body } => { fv_expr(a, &b, target, acc); let mut wb = copy_strs(a, &b); wb.push(name); fv_stmts(a, &wb, &body, acc); }
            | _other => {}
        }
        i = i + 1 as u32;
    }
}

// Rewrite each captured `Var(name)` in the lambda body to `self.<name>`
// (or `*self.<name>` for a by-ref capture), skipping names shadowed by a
// tighter binding in `bound`.  Corpus lambda bodies are pure expressions
// (no internal block / match / nested lambda), so those statement-bearing
// forms pass through unchanged.
fn subst_caps_one(ar: *Arena, caps: *const Vec<str>, brn: *const Vec<str>, bound: *const Vec<str>, n: str, p: Pos, orig: *const Expr) -> *const Expr {
    if name_in(bound, n) { return orig; }
    if !name_in(caps, n) { return orig; }
    let selfv = ast_node(ar, Expr::Var("self", p));
    let access = ast_node(ar, Expr::FieldAccess(selfv, n, p));
    if name_in(brn, n) { return ast_node(ar, Expr::Deref(access, p)); }
    return access;
}
fn subst_caps_exprs(a: Allocator, ar: *Arena, caps: *const Vec<str>, brn: *const Vec<str>, bound: *const Vec<str>, es: *const Vec<*const Expr>) -> Vec<*const Expr> {
    let mut out: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    let n = es.length();
    let sl = es.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(subst_caps_expr(a, ar, caps, brn, bound, sl[i])); i = i + 1 as u32; }
    return out;
}
fn subst_caps_fields(a: Allocator, ar: *Arena, caps: *const Vec<str>, brn: *const Vec<str>, bound: *const Vec<str>, fields: *const Vec<Field>) -> Vec<Field> {
    let mut out: Vec<Field> = Vec::with_capacity(a, 8 as u32);
    let n = fields.length();
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(Field { name: sl[i].name, value: subst_caps_expr(a, ar, caps, brn, bound, sl[i].value) }); i = i + 1 as u32; }
    return out;
}
fn subst_caps_opt(a: Allocator, ar: *Arena, caps: *const Vec<str>, brn: *const Vec<str>, bound: *const Vec<str>, oe: Option<*const Expr>) -> Option<*const Expr> {
    return match oe {
        Option::Some(e) => Option::Some(subst_caps_expr(a, ar, caps, brn, bound, e))
        | Option::None => { let none: Option<*const Expr> = Option::None; none }
    };
}
fn subst_caps_expr(a: Allocator, ar: *Arena, caps: *const Vec<str>, brn: *const Vec<str>, bound: *const Vec<str>, e: *const Expr) -> *const Expr {
    let p = expr_pos(e);
    return match *e {
        Expr::Var(n, _q) => subst_caps_one(ar, caps, brn, bound, n, p, e)
        | Expr::Neg(s, _q) => ast_node(ar, Expr::Neg(subst_caps_expr(a, ar, caps, brn, bound, s), p))
        | Expr::BitNot(s, _q) => ast_node(ar, Expr::BitNot(subst_caps_expr(a, ar, caps, brn, bound, s), p))
        | Expr::Not(s, _q) => ast_node(ar, Expr::Not(subst_caps_expr(a, ar, caps, brn, bound, s), p))
        | Expr::Try(s, _q) => ast_node(ar, Expr::Try(subst_caps_expr(a, ar, caps, brn, bound, s), p))
        | Expr::Cast(s, t, _q) => ast_node(ar, Expr::Cast(subst_caps_expr(a, ar, caps, brn, bound, s), t, p))
        | Expr::FieldAccess(s, f, _q) => ast_node(ar, Expr::FieldAccess(subst_caps_expr(a, ar, caps, brn, bound, s), f, p))
        | Expr::Ref(s, _q) => ast_node(ar, Expr::Ref(subst_caps_expr(a, ar, caps, brn, bound, s), p))
        | Expr::Deref(s, _q) => ast_node(ar, Expr::Deref(subst_caps_expr(a, ar, caps, brn, bound, s), p))
        | Expr::BinOp(op, l, r, _q) => ast_node(ar, Expr::BinOp(op, subst_caps_expr(a, ar, caps, brn, bound, l), subst_caps_expr(a, ar, caps, brn, bound, r), p))
        | Expr::Orelse(l, r, _q) => ast_node(ar, Expr::Orelse(subst_caps_expr(a, ar, caps, brn, bound, l), subst_caps_expr(a, ar, caps, brn, bound, r), p))
        | Expr::Index { base, index } => ast_node(ar, Expr::Index { base: subst_caps_expr(a, ar, caps, brn, bound, base), index: subst_caps_expr(a, ar, caps, brn, bound, index), pos: p })
        | Expr::Call { callee, args } => ast_node(ar, Expr::Call { callee: copy_strs(a, &callee), args: subst_caps_exprs(a, ar, caps, brn, bound, &args), pos: p })
        | Expr::MethodCall { receiver, name, args } => ast_node(ar, Expr::MethodCall { receiver: subst_caps_expr(a, ar, caps, brn, bound, receiver), name: name, args: subst_caps_exprs(a, ar, caps, brn, bound, &args), pos: p })
        | Expr::TupleLit(es, _q) => ast_node(ar, Expr::TupleLit(subst_caps_exprs(a, ar, caps, brn, bound, &es), p))
        | Expr::ArrayLit(es, _q) => ast_node(ar, Expr::ArrayLit(subst_caps_exprs(a, ar, caps, brn, bound, &es), p))
        | Expr::ArrayRepeat { value, count } => ast_node(ar, Expr::ArrayRepeat { value: subst_caps_expr(a, ar, caps, brn, bound, value), count: subst_caps_expr(a, ar, caps, brn, bound, count), pos: p })
        | Expr::StructLit { tname, fields, base } => ast_node(ar, Expr::StructLit { tname: copy_strs(a, &tname), fields: subst_caps_fields(a, ar, caps, brn, bound, &fields), base: subst_caps_opt(a, ar, caps, brn, bound, base), pos: p })
        | Expr::Range { lo, hi, inclusive } => ast_node(ar, Expr::Range { lo: subst_caps_expr(a, ar, caps, brn, bound, lo), hi: subst_caps_expr(a, ar, caps, brn, bound, hi), inclusive: inclusive, pos: p })
        | _other => e
    };
}

// FieldDef list (a lambda's params) → fn Param list.
fn lam_to_params(a: Allocator, params: *const Vec<FieldDef>) -> Vec<Param> {
    let mut out: Vec<Param> = Vec::with_capacity(a, 8 as u32);
    let n = params.length();
    let sl = params.as_slice();
    let none_reg: Option<str> = Option::None;
    let mut i = 0 as u32;
    while i < n { out.push(Param { pname: sl[i].name, pty: sl[i].ty, is_mut: false, preg: none_reg }); i = i + 1 as u32; }
    return out;
}
// The fn-ptr type a lambda decays to.
fn lambda_fnptr_ty(a: Allocator, ar: *Arena, sc: *const TyScope, params: *const Vec<FieldDef>, ret_ty: Option<*const TypeAnn>) -> *const Typ {
    let mut ptys: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let n = params.length();
    let sl = params.as_slice();
    let mut i = 0 as u32;
    while i < n { ptys.push(resolve_sig_ty(a, ar, sc, sl[i].ty)); i = i + 1 as u32; }
    return ty_node(ar, Typ::TFnPtr { params: ptys, ret: resolve_sig_ret(a, ar, sc, ret_ty) });
}
// Index of the A2 closure pre-pass entry whose original `Lambda` node is
// `e` (matched by arena-pointer identity), or -1 for a captureless lambda.
fn find_closure_idx(lifted: *const Vec<LiftedLambda>, e: *const Expr) -> int {
    let n = lifted.length();
    let sl = lifted.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if sl[i].ll_kind == 1 as int { if sl[i].ll_lambda == e { return i as int; } }
        i = i + 1 as u32;
    }
    return -1 as int;
}
fn count_a1(lifted: *const Vec<LiftedLambda>) -> u32 {
    let n = lifted.length();
    let sl = lifted.as_slice();
    let mut c = 0 as u32;
    let mut i = 0 as u32;
    while i < n { if sl[i].ll_kind == 0 as int { c = c + 1 as u32; } i = i + 1 as u32; }
    return c;
}
// A pre-synthesised capturing lambda becomes a struct literal building the
// env `__closure_N { cap: cap, ... }` (by-ref captures take `&cap`); an
// empty env gets a one-byte `_pad` so the C struct is non-empty.
fn elab_closure_lit(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>, ci: u32, p: Pos) -> *const Texpr {
    let lls = sc.sc_lifted.as_slice();
    let cn = lls[ci].ll_closure;
    let nc = lls[ci].ll_caps.length();
    let csl = lls[ci].ll_caps.as_slice();
    let mut fields: Vec<Field> = Vec::with_capacity(a, 8 as u32);
    let mut i = 0 as u32;
    while i < nc {
        let v0 = ast_node(ar, Expr::Var(csl[i], p));
        let v = if name_in(&lls[ci].ll_brefs, csl[i]) { ast_node(ar, Expr::Ref(v0, p)) } else { v0 };
        fields.push(Field { name: csl[i], value: v });
        i = i + 1 as u32;
    }
    if nc == 0 as u32 { fields.push(Field { name: "_pad", value: ast_node(ar, Expr::IntLit(0 as int, p)) }); }
    let tname = single_str(a, cn);
    let nb: Option<*const Expr> = Option::None;
    return elab_struct_lit(a, ar, g, sc, env, &tname, &fields, nb, p);
}
// DR-008 A1: a captureless lambda is lifted to a fresh top-level fn
// `__lambda_N` (drained after the user fns), and the expression becomes a
// `TFnRef` to it — decaying to a C function pointer at the use site.
// DR-024 A2: a capturing lambda was already synthesised by the pre-pass —
// `find_closure_idx` routes it to the env struct-literal.
fn elab_lambda(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>, e: *const Expr, params: *const Vec<FieldDef>, ret_ty: Option<*const TypeAnn>, p: Pos) -> *const Texpr {
    let ci = find_closure_idx(sc.sc_lifted, e);
    if ci >= 0 as int { return elab_closure_lit(a, ar, g, sc, env, ci as u32, p); }
    let n = count_a1(sc.sc_lifted);
    let name = gensym_name(a, ar, "__lambda_", n);
    let empty_path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let sym = mangle_path(a, ar, &empty_path, name);
    let no_params: Vec<FieldDef> = Vec::with_capacity(a, 8 as u32);
    let no_ret: Option<*const TypeAnn> = Option::None;
    let no_caps: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let no_brefs: Vec<str> = Vec::with_capacity(a, 8 as u32);
    sc.sc_lifted.push(LiftedLambda { ll_mangled: sym, ll_name: name, ll_expr: e, ll_kind: 0 as int, ll_closure: "", ll_params: no_params, ll_ret: no_ret, ll_caps: no_caps, ll_brefs: no_brefs, ll_lambda: e });
    return te_node(ar, TexprNode::TFnRef(sym), lambda_fnptr_ty(a, ar, sc, params, ret_ty), p);
}
// Elaborate a lifted lambda directly into a `Tfunc` (no intermediate `Func` —
// reads the original arena `FieldDef` params + body expr, builds only locals
// that the produced `Tfunc` copies).  Mirrors `elaborate_fn` for a plain,
// non-generic, body-bearing fn.
fn prelude_file_pos() -> Pos { return Pos { line: 0 as int, col: 0 as int, file: "<prelude>" }; }
fn elaborate_lifted(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx,
                    mangled: str, name: str, params_fd: *const Vec<FieldDef>, ret_ty: Option<*const TypeAnn>, body_expr: *const Expr, funcs: *Vec<Tfunc>, is_pub: bool, fpos: Pos) {
    let lparams = lam_to_params(a, params_fd);
    let params = copy_params(a, &lparams);
    let empty_tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let sc = TyScope { sc_structs: idx.pi_snames, sc_enums: idx.pi_enames, sc_tparams: &empty_tp,
                       sc_iconsts: idx.pi_iconsts, sc_sinfo: idx.pi_sinfo, sc_etags: idx.pi_etags, sc_efields: idx.pi_efields, sc_methods: idx.pi_methods,
                       sc_mono_structs: idx.pi_mono_structs, sc_mono_sargs: idx.pi_mono_sargs, sc_mono_enums: idx.pi_mono_enums, sc_mono_eargs: idx.pi_mono_eargs, sc_mono_fields: idx.pi_mono_fields, sc_mono_efields: idx.pi_mono_efields,
                       sc_tbinds: idx.pi_tbinds, sc_genfns: idx.pi_genfns, sc_genjobs: idx.pi_genjobs, sc_geninsts: idx.pi_geninsts, sc_etps: idx.pi_etps, sc_stps: idx.pi_stps, sc_assoc: idx.pi_assoc, sc_lifted: idx.pi_lifted, sc_gensym: gensym, sc_modpath: idx.pi_modpath, sc_ret: none_ty(), sc_self: none_ty(), sc_gsigs: idx.pi_gsigs, sc_xstructs: idx.pi_xstructs, sc_xaliases: idx.pi_xaliases, sc_taliases: idx.pi_taliases, sc_err: idx.pi_err, sc_srcnames: idx.pi_srcnames, sc_srcbase: idx.pi_srcbase, sc_binds: idx.pi_binds, sc_bindbase: idx.pi_bindbase, sc_is_main: false };
    let param_tys = resolve_param_tys(a, ar, &sc, &lparams);
    let ret = resolve_sig_ret(a, ar, &sc, ret_ty);
    let mut env: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    build_param_env(a, ar, &sc, &lparams, &env);
    let scb = scope_with_ret(&sc, ret);
    // A `Block` body is a void statement sequence (a synthesised fmt_debug),
    // emitted flat; any other body is the fn's tail value.
    let raw_body = match *body_expr {
        Expr::Block(stmts, _qb) => elab_body(a, ar, g, &scb, gensym, &env, ret, &stmts)
        | _other => {
            let mut lbody: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
            lbody.push(Stmt::Tail(body_expr));
            elab_body(a, ar, g, &scb, gensym, &env, ret, &lbody)
        }
    };
    let mut lift_ctr: u32 = 0 as u32;
    let body = lift_stmts(a, ar, &lift_ctr, &raw_body);
    let lets = collect_body_lets(a, &body);
    let no_pos: Option<Pos> = Option::None;
    let path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let tparams2: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let tbounds: Vec<TraitBound> = Vec::with_capacity(a, 8 as u32);
    let dummy_body: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    let no_lib: Option<str> = Option::None;
    let no_tier: Option<str> = Option::None;
    let tf_func = Func {
        name: name, c_name: name, tparams: tparams2, tbounds: tbounds,
        params: params, ret_ty: ret_ty, body: dummy_body, is_pub: is_pub,
        is_extern: false, is_variadic: false, amiga_lib: no_lib,
        tier_hint: no_tier, must_use: false, escapes_hatch: false, pos: fpos,
    };
    funcs.push(Tfunc {
        tf_path: path, tf_func: tf_func, tf_mangled: mangled, tf_param_tys: param_tys,
        tf_ret_ty: ret, tf_body: body, tf_lets: lets, tf_origin_pos: no_pos,
    });
}
fn drain_one_lifted(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx,
                    mangled: str, name: str, e: *const Expr, funcs: *Vec<Tfunc>) {
    match *e {
        Expr::Lambda { params, ret_ty, body, captures } => elaborate_lifted(a, ar, g, gensym, idx, mangled, name, &params, ret_ty, body, funcs, false, zero_pos())
        | _o => { }
    }
}
// The synthesised closure `call` params: `*const __closure_N self` followed
// by the lambda's own params.
fn closure_call_params(a: Allocator, ar: *Arena, cn: str, lam_params: *const Vec<FieldDef>) -> Vec<FieldDef> {
    let self_ann = tyann_node(ar, TypeAnn::TyConstPtr(closure_struct_ann(a, ar, cn)));
    let mut out: Vec<FieldDef> = Vec::with_capacity(a, 8 as u32);
    out.push(FieldDef { name: "self", ty: self_ann });
    let n = lam_params.length();
    let sl = lam_params.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(FieldDef { name: sl[i].name, ty: sl[i].ty }); i = i + 1 as u32; }
    return out;
}

// `Path::Variant` (no payload) is a unit enum constructor when the index
// knows the variant; otherwise it is a module-scoped `const` reference
// (`mod::CONST`) resolved by mangled name.
fn elab_enumlit(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, expected: Option<*const Typ>,
                tname: *const Vec<str>, variant: str, p: Pos) -> *const Texpr {
    let qtname = qualify_type_path(a, ar, sc, tname);
    let tag = variant_tag(sc.sc_etags, &qtname, variant);
    if tag >= 0 as int {
        let empty: Vec<TexprField> = Vec::with_capacity(a, 8 as u32);
        let inst = enum_instance_path(a, ar, sc, expected, &qtname, variant, &empty);
        return mk_enum_lit_node(a, ar, &inst, variant, tag, empty, p);
    }
    let m = mangle_path(a, ar, tname, variant);
    return match global_lookup_by_mangled(g, m) {
        Option::Some(gf) => enumlit_const(ar, gf, p)
        | Option::None => qualified_extern_ref(ar, g, variant, p)
    };
}
// A `mod::NAME` reference that isn't a module const may be an extern const /
// var, whose raw C symbol is the bare last segment (no module mangling).
fn qualified_extern_ref(ar: *Arena, g: *const Vec<GlobalFn>, variant: str, p: Pos) -> *const Texpr {
    return match global_lookup(g, variant) {
        Option::Some(gf) => enumlit_const(ar, gf, p)
        | Option::None => defer_expr(ar, p)
    };
}
fn enumlit_const(ar: *Arena, gf: GlobalFn, p: Pos) -> *const Texpr {
    if gf.is_const { return te_node(ar, TexprNode::TVar(gf.mangled), ret_or_void(ar, gf.ret), p); }
    return defer_expr(ar, p);
}

fn let_expected(a: Allocator, ar: *Arena, sc: *const TyScope, ty_ann: Option<*const TypeAnn>) -> Option<*const Typ> {
    return match ty_ann {
        Option::Some(t) => Option::Some(resolve_sig_ty(a, ar, sc, t))
        | Option::None => none_ty()
    };
}

// The type a `let` binding takes in the env: its declared annotation when
// present (resolving named types through the scope), else the value's type.
// A `let x: *T = null` binds `x` as `*T`, not the value's bare `null-ptr`.
// An integer literal, seen through `-` and `as` (`255 as u8` is still the literal
// 255 as far as fitting goes).
fn expr_int_lit(e: *const Expr) -> Option<int> {
    let none: Option<int> = Option::None;
    return match *e {
        Expr::IntLit(n, _q) => Option::Some(n)
        | Expr::Neg(sub, _q) => negate_lit(expr_int_lit(sub))
        | Expr::Cast(sub, _t, _q) => expr_int_lit(sub)
        | _o => none
    };
}
fn negate_lit(v: Option<int>) -> Option<int> {
    let none: Option<int> = Option::None;
    return match v { Option::Some(n) => Option::Some(0 as int - n) | Option::None => none };
}
fn is_int_like_ty(t: *const Typ) -> bool {
    return match *t {
        Typ::TInt(_k) => true
        | Typ::TCInt { is_signed } => true
        | Typ::TCShort { is_signed } => true
        | Typ::TCLong { is_signed } => true
        | Typ::TCChar => true
        | Typ::TCSChar => true
        | Typ::TCUChar => true
        | _o => false
    };
}

// The declared type wins, but only if the value can actually take it: an integer
// literal must FIT (`let x: i8 = 5` is fine, `= 300` is not), and anything else must
// be coercible.  Before this the port took the annotation on faith and emitted C for
// `let x: int = true`.
fn let_env_ty(a: Allocator, ar: *Arena, sc: *const TyScope,
              ty_ann: Option<*const TypeAnn>, value_ty: *const Typ) -> *const Typ {
    return match ty_ann {
        Option::Some(t) => resolve_sig_ty(a, ar, sc, t)
        | Option::None => value_ty
    };
}
fn check_let_ty(a: Allocator, ar: *Arena, sc: *const TyScope, name: str,
                value: *const Expr, ann: Option<*const TypeAnn>, vty: *const Typ, pos: Pos) {
    match ann {
        Option::Some(t) => { check_let_ann(a, ar, sc, name, value, resolve_sig_ty(a, ar, sc, t), vty, pos); }
        | Option::None => { }
    }
    return;
}
fn check_let_ann(a: Allocator, ar: *Arena, sc: *const TyScope, name: str, value: *const Expr,
                 tann: *const Typ, vty: *const Typ, pos: Pos) {
    match expr_int_lit(value) {
        Option::Some(n) => { check_int_lit_fits(a, ar, sc, n, tann, pos); }
        | Option::None => { check_coercible(a, ar, sc, name, tann, vty, pos); }
    }
    return;
}
fn check_int_lit_fits(a: Allocator, ar: *Arena, sc: *const TyScope, n: int, tann: *const Typ, pos: Pos) {
    if !is_int_like_ty(tann) { return; }
    if int_fits(n, tann) { return; }
    let mut sb = StringBuilder::with_capacity(a, 64 as u32);
    if n < 0 as int && !is_signed_ty(tann) { sb.push_str("negative literal "); }
    else { sb.push_str("literal "); }
    sb.push_int(n);
    if n < 0 as int && !is_signed_ty(tann) { sb.push_str(" cannot fit in "); }
    else { sb.push_str(" does not fit in "); }
    sb.push_str(typ_name(a, ar, tann));
    tc_fail(ar, sc, pos, str::from_slice(ar, sb.as_slice()));
    return;
}
fn is_signed_ty(t: *const Typ) -> bool {
    return match *t {
        Typ::TInt(k) => k.is_signed
        | Typ::TCInt { is_signed } => is_signed
        | Typ::TCShort { is_signed } => is_signed
        | Typ::TCLong { is_signed } => is_signed
        | _o => true
    };
}
fn check_coercible(a: Allocator, ar: *Arena, sc: *const TyScope, name: str,
                   tann: *const Typ, vty: *const Typ, pos: Pos) {
    if coercible_to(vty, tann) { return; }
    let mut sb = StringBuilder::with_capacity(a, 96 as u32);
    sb.push_str("variable '"); sb.push_str(src_name(sc, name));
    sb.push_str("' declared as "); sb.push_str(typ_name(a, ar, tann));
    sb.push_str(" but initializer has type "); sb.push_str(typ_name(a, ar, vty));
    tc_fail(ar, sc, pos, str::from_slice(ar, sb.as_slice()));
    return;
}

// `return e` elaborates `e` against the fn's declared return type so a bare
// literal adopts the annotated width; `return;` yields no value.
fn none_texpr() -> Option<*const Texpr> {
    let n: Option<*const Texpr> = Option::None;
    return n;
}

// A bare `return;` yields no value — except in `fn main`, which lowers to C
// `int main` and must return `0`.
fn bare_return_val(ar: *Arena, sc: *const TyScope, p: Pos) -> Option<*const Texpr> {
    if sc.sc_is_main { return Option::Some(te_node(ar, TexprNode::TIntLit(0 as int), t_i32(ar), p)); }
    return none_texpr();
}
fn elab_return_val(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                   ret: Option<*const Typ>, val: Option<*const Expr>, p: Pos) -> Option<*const Texpr> {
    return match val {
        Option::Some(e) => Option::Some(elab_expr(a, ar, g, sc, env, ret, e))
        | Option::None => bare_return_val(ar, sc, p)
    };
}

fn empty_tstmts(a: Allocator) -> Vec<Tstmt> {
    let v: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    return v;
}

fn elab_else_body(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
                  else_blk: Option<Vec<Stmt>>) -> Vec<Tstmt> {
    return match else_blk {
        Option::Some(blk) => elab_body(a, ar, g, sc, gensym, env, ret, &blk)
        | Option::None => empty_tstmts(a)
    };
}

// The else branch of a STATEMENT-context `if` (a void control-flow `if`, not a
// value-`if`) — its trailing bare expression is a void statement, so it walks
// via the statement-context body elaborator.
fn elab_else_stmt_body(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
                       else_blk: Option<Vec<Stmt>>) -> Vec<Tstmt> {
    return match else_blk {
        Option::Some(blk) => elab_stmt_body(a, ar, g, sc, gensym, env, ret, &blk)
        | Option::None => empty_tstmts(a)
    };
}

// ===== `with` scoped projection (DR-012) =====
//
// `with x in <lvalue> { body }` desugars to a block `{ let x__withN =
// &<lvalue>; body }` where the user-visible `x` is renamed to the gensym
// pointer (the body is pointer-honest — it reads / writes through `*x`).  The
// block isolates the binding so `x` is out of scope after the `with`.  Reuses
// the program-global gensym counter; a fn that mixed `for` and `with` would
// need a separate counter (none in the catalog — the oracle keeps them apart).

fn is_slice_instance(t: *const Typ) -> bool {
    return match *t {
        Typ::TStruct(path) => { let nm = path_last(&path); str::eq(nm, "Slice") || str_starts_with(nm, "Slice_") }
        | _e => false
    };
}
// A borrow of an index into a `Slice` (whose `.ptr` is `*const T`) inherits
// read-only-ness so the projected pointer stays `*const T`.
fn with_const_inherited(t: *const Texpr) -> bool {
    return match t.e {
        TexprNode::TIndex { base, index } => is_slice_instance(base.ty)
        | _e => false
    };
}
fn with_ptr_ty(ar: *Arena, t_target: *const Texpr) -> *const Typ {
    if with_const_inherited(t_target) { return ty_node(ar, Typ::TConstPtr(t_target.ty)); }
    return ty_node(ar, Typ::TPtr(t_target.ty));
}
fn with_name(a: Allocator, ar: *Arena, name: str, k: u32) -> str {
    let mut sb = StringBuilder::with_capacity(a, 16 as u32);
    sb.push_str(name);
    sb.push_str("__with");
    sb.push_int(k as int);
    return str::from_slice(ar, sb.as_slice());
}
fn elab_with(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32, env: *Vec<FieldTy>,
             ret: Option<*const Typ>, target: *const Expr, name: str, body: *const Vec<Stmt>, pos: Pos, out: *Vec<Tstmt>) {
    let t_target = elab_expr(a, ar, g, sc, env, none_ty(), target);
    let pty = with_ptr_ty(ar, t_target);
    let ref_e = te_node(ar, TexprNode::TRef(t_target), pty, pos);
    let k = *gensym;
    *gensym = *gensym + 1 as u32;
    let internal = with_name(a, ar, name, k);
    note_rename(sc, internal, name);
    let rbody = subst_body(a, ar, name, internal, body);
    let mut benv = copy_fieldtys(a, env);
    benv.push(FieldTy { name: internal, ty: pty });
    let mut bstmts: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    bstmts.push(Tstmt::TLet { name: internal, value: ref_e, decl_ty: pty, pos: pos });
    let n = rbody.length();
    let rsl = rbody.as_slice();
    let mut i = 0 as u32;
    while i < n { elab_stmt(a, ar, g, sc, gensym, &benv, ret, &rsl[i], &bstmts); i = i + 1 as u32; }
    let no_tr: Option<*const Texpr> = Option::None;
    let blk = te_node(ar, TexprNode::TBlock { stmts: bstmts, trailing: no_tr }, t_bool(ar), pos);
    out.push(Tstmt::TExprStmt(blk));
}

// An expression used in statement (void) position.  `if` lowers to the
// void `TIf` statement (branches are full stmt-blocks, sharing the env —
// C hoists branch-local lets); everything else becomes a `TExprStmt`.
fn elab_stmt_pos(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
                 e: *const Expr, out: *Vec<Tstmt>) {
    match *e {
        Expr::If { cond, then_blk, else_blk } => {
            let tcond = elab_expr(a, ar, g, sc, env, none_ty(), cond);
            let tthen = elab_stmt_body(a, ar, g, sc, gensym, env, ret, &then_blk);
            let telse = elab_else_stmt_body(a, ar, g, sc, gensym, env, ret, else_blk);
            out.push(Tstmt::TIf { cond: tcond, then_body: tthen, else_body: telse });
        }
        | _other => {
            let ve = elab_expr(a, ar, g, sc, env, none_ty(), e);
            out.push(Tstmt::TExprStmt(ve));
        }
    }
}

fn is_some_ty(o: Option<*const Typ>) -> bool {
    return match o { Option::Some(_t) => true | Option::None => false };
}

fn is_tail_stmt(s: *const Stmt) -> bool {
    return match *s { Stmt::Tail(_e) => true | _other => false };
}

// A block yields a VALUE (vs diverging via returns) when its last statement
// is a trailing expression (`Tail`).  Distinguishes a value-`if` (lowered to
// `if-expr`) from a control-flow `if` whose branches `return`.
fn block_is_value(blk: *const Vec<Stmt>) -> bool {
    let n = blk.length();
    if n == 0 as u32 { return false; }
    let sl = blk.as_slice();
    return is_tail_stmt(&sl[n - 1 as u32]);
}

// ===== Value-position elaboration (if-expr) =====
//
// A value-position `if` lowers to `TIfExpr` — handled directly in
// `elab_expr` (statement-position `if` is caught by `elab_stmt_pos` first).

// The trailing value of a single-`Tail` block; multi-statement value blocks
// are deferred (a visible marker) for now.
fn block_value(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
               expected: Option<*const Typ>, blk: *const Vec<Stmt>) -> *const Texpr {
    if blk.length() != 1 as u32 { return defer_expr(ar, zero_pos()); }
    let sl = blk.as_slice();
    return tail_or_defer(a, ar, g, sc, env, expected, &sl[0 as u32]);
}
fn tail_or_defer(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                 expected: Option<*const Typ>, s: *const Stmt) -> *const Texpr {
    return match *s {
        Stmt::Tail(e) => elab_expr(a, ar, g, sc, env, expected, e)
        | _other => defer_expr(ar, zero_pos())
    };
}
fn else_block_value(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
                    expected: Option<*const Typ>, else_blk: Option<Vec<Stmt>>) -> *const Texpr {
    return match else_blk {
        Option::Some(blk) => block_value(a, ar, g, sc, env, expected, &blk)
        | Option::None => defer_expr(ar, zero_pos())
    };
}

fn mk_if_expr(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, env: *const Vec<FieldTy>,
              expected: Option<*const Typ>, cond: *const Expr, then_blk: *const Vec<Stmt>,
              else_blk: Option<Vec<Stmt>>, p: Pos) -> *const Texpr {
    let tcond = elab_expr(a, ar, g, sc, env, none_ty(), cond);
    let tthen = block_value(a, ar, g, sc, env, expected, then_blk);
    let telse = else_block_value(a, ar, g, sc, env, expected, else_blk);
    return te_node(ar, TexprNode::TIfExpr { cond: tcond, then_val: tthen, else_val: telse }, tthen.ty, p);
}

// A trailing block value in a return-typed fn is an implicit `return`.  A
// value-`if` returns an `if-expr`; a control-flow `if` (diverging branches)
// stays a `TIf` statement; anything else returns its value.
fn elab_tail_if(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
                cond: *const Expr, then_blk: *const Vec<Stmt>, else_blk: Option<Vec<Stmt>>, p: Pos, out: *Vec<Tstmt>) {
    if block_is_value(then_blk) {
        let ifx = mk_if_expr(a, ar, g, sc, env, ret, cond, then_blk, else_blk, p);
        out.push(Tstmt::TReturn { value: Option::Some(ifx), pos: zero_pos() });
    } else {
        let tcond = elab_expr(a, ar, g, sc, env, none_ty(), cond);
        let tthen = elab_body(a, ar, g, sc, gensym, env, ret, then_blk);
        let telse = elab_else_body(a, ar, g, sc, gensym, env, ret, else_blk);
        out.push(Tstmt::TIf { cond: tcond, then_body: tthen, else_body: telse });
    }
}

fn elab_tail_ret(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
                 e: *const Expr, out: *Vec<Tstmt>) {
    let p = expr_pos(e);
    match *e {
        Expr::If { cond, then_blk, else_blk } => { elab_tail_if(a, ar, g, sc, gensym, env, ret, cond, &then_blk, else_blk, p, out); }
        | _other => {
            let tv = elab_expr(a, ar, g, sc, env, ret, e);
            out.push(Tstmt::TReturn { value: Option::Some(tv), pos: p });
        }
    }
}

// A trailing expression: an implicit `return` in a return-typed fn, else a
// void statement (`if` → `TIf`, otherwise `TExprStmt`).
fn elab_tail(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
             e: *const Expr, out: *Vec<Tstmt>) {
    // A bare `if` (no else) in tail position of a value-returning fn is
    // control flow (its branches `return`), not an implicit-return value —
    // elaborate it as a statement, matching the oracle.
    if is_bare_if(e) { elab_stmt_pos(a, ar, g, sc, gensym, env, ret, e, out); return; }
    if is_some_ty(ret) { elab_tail_ret(a, ar, g, sc, gensym, env, ret, e, out); }
    else { elab_stmt_pos(a, ar, g, sc, gensym, env, ret, e, out); }
}

fn copy_strs(a: Allocator, src: *const Vec<str>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let n = src.length();
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}

// ===== `for IT in lo..hi` → `while` lift =====
//
// A `for` over an integer range lowers to the oracle's post-lift shape:
//   let __feK = hi; let __fvK = lo;
//   while __fvK < __feK { body[IT->__fvK] } post { __fvK = __fvK + 1 }
// (inclusive ranges compare with `<=`).  `K` is the program-global gensym
// counter, so loops never collide; the iter-var is renamed in the body
// before elaboration.  A non-range `for` (over a collection) is not yet
// supported and leaves a visible deferral marker.

fn gensym_name(a: Allocator, ar: *Arena, prefix: str, k: u32) -> str {
    let mut sb = StringBuilder::with_capacity(a, 16 as u32);
    sb.push_str(prefix);
    sb.push_int(k as int);
    return str::from_slice(ar, sb.as_slice());
}

fn mk_for_cond(ar: *Arena, fv: str, fe: str, cty: *const Typ, inclusive: bool) -> *const Texpr {
    let vfv = te_node(ar, TexprNode::TVar(fv), cty, zero_pos());
    let vfe = te_node(ar, TexprNode::TVar(fe), cty, zero_pos());
    let op = if inclusive { BinOp::LtEq } else { BinOp::Lt };
    return te_node(ar, TexprNode::TBinOp(op, vfv, vfe), t_bool(ar), zero_pos());
}

fn mk_for_post(a: Allocator, ar: *Arena, fv: str, cty: *const Typ) -> Vec<Tstmt> {
    let vfv = te_node(ar, TexprNode::TVar(fv), cty, zero_pos());
    let one = te_node(ar, TexprNode::TIntLit(1), cty, zero_pos());
    let step = te_node(ar, TexprNode::TBinOp(BinOp::Add, vfv, one), cty, zero_pos());
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(fv);
    let mut post: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    post.push(Tstmt::TAssign { path: path, value: step, pos: zero_pos() });
    return post;
}

fn elab_for(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32, env: *Vec<FieldTy>,
            ret: Option<*const Typ>, iter_var: str, range: *const Expr, body: *const Vec<Stmt>, out: *Vec<Tstmt>) {
    let k = *gensym;
    *gensym = *gensym + 1 as u32;
    let fv = gensym_name(a, ar, "__fv", k);
    note_rename(sc, fv, iter_var);
    let fe = gensym_name(a, ar, "__fe", k);
    match *range {
        Expr::Range { lo, hi, inclusive } => {
            // The RANGE counter is mutable — `for i in 0..2 { i = 5; }` is legal.
            // The ITERATOR element is not: it is a pattern bind, and assigning to
            // it is an error.  Two different desugars, two different answers.
            note_let_mut(sc, fv);
            let tlo = elab_expr(a, ar, g, sc, env, none_ty(), lo);
            let cty = tlo.ty;
            let thi = elab_expr(a, ar, g, sc, env, Option::Some(cty), hi);
            let rbody = subst_body(a, ar, iter_var, fv, body);
            env.push(FieldTy { name: fv, ty: cty });
            let tbody = elab_stmt_body(a, ar, g, sc, gensym, env, ret, &rbody);
            out.push(Tstmt::TLet { name: fe, value: thi, decl_ty: thi.ty, pos: zero_pos() });
            out.push(Tstmt::TLet { name: fv, value: tlo, decl_ty: tlo.ty, pos: zero_pos() });
            let cond = mk_for_cond(ar, fv, fe, cty, inclusive);
            let post = mk_for_post(a, ar, fv, cty);
            out.push(Tstmt::TWhile { cond: cond, body: tbody, post: post });
        }
        | _other => {
            elab_for_iter(a, ar, g, sc, gensym, env, ret, k, fv, iter_var, range, body, out);
        }
    }
}

// `for x in <iter>` over a non-range value lowers to the iterator protocol:
//   let __it = <iter>;
//   while true { match __it.next() { Some(x) => { <body> } None => break } }
// The iterator's `next()` is a normal prelude method, so the match / method
// dispatch is reused wholesale.
fn elab_for_iter(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32, env: *Vec<FieldTy>,
                 ret: Option<*const Typ>, k: u32, fv: str, iter_var: str, range: *const Expr, body: *const Vec<Stmt>, out: *Vec<Tstmt>) {
    let itname = gensym_name(a, ar, "__it", k);
    note_let_mut(sc, itname);
    let trange = elab_expr(a, ar, g, sc, env, none_ty(), range);
    env.push(FieldTy { name: itname, ty: trange.ty });
    out.push(Tstmt::TLet { name: itname, value: trange, decl_ty: trange.ty, pos: zero_pos() });
    // `__it.next()`
    let recv = ast_node(ar, Expr::Var(itname, zero_pos()));
    let no_args: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    let nextcall = ast_node(ar, Expr::MethodCall { receiver: recv, name: "next", args: no_args, pos: zero_pos() });
    // `Some(__fv) => { <body, x renamed to __fv> }`
    let rbody = subst_body(a, ar, iter_var, fv, body);
    let mut some_binds: Vec<Pattern> = Vec::with_capacity(a, 8 as u32);
    some_binds.push(Pattern::PVar(fv, zero_pos()));
    let mut opt_path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    opt_path.push("Option");
    let some_pat = Pattern::PVariant { tname: copy_strs(a, &opt_path), variant: "Some", binds: PatBinds::PBTuple(some_binds), pos: zero_pos() };
    let some_body = ast_node(ar, Expr::Block(rbody, zero_pos()));
    let no_guard: Option<*const Expr> = Option::None;
    // `None => { break }`
    let none_binds: Vec<Pattern> = Vec::with_capacity(a, 8 as u32);
    let none_pat = Pattern::PVariant { tname: copy_strs(a, &opt_path), variant: "None", binds: PatBinds::PBTuple(none_binds), pos: zero_pos() };
    let mut break_stmts: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    break_stmts.push(Stmt::Break(zero_pos()));
    let none_body = ast_node(ar, Expr::Block(break_stmts, zero_pos()));
    let mut arms: Vec<MatchArm> = Vec::with_capacity(a, 8 as u32);
    arms.push(MatchArm { pat: some_pat, guard: no_guard, body: some_body, arm_pos: zero_pos() });
    arms.push(MatchArm { pat: none_pat, guard: no_guard, body: none_body, arm_pos: zero_pos() });
    let matchexpr = ast_node(ar, Expr::Match { scrutinee: nextcall, arms: arms, pos: zero_pos() });
    let mut wbody_ast: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    wbody_ast.push(Stmt::ExprStmt(matchexpr));
    let twbody = elab_body(a, ar, g, sc, gensym, env, ret, &wbody_ast);
    let truecond = te_node(ar, TexprNode::TBoolLit(true), t_bool(ar), zero_pos());
    let wpost = empty_tstmts(a);
    out.push(Tstmt::TWhile { cond: truecond, body: twbody, post: wpost });
}

// Bind each name of a `let (a, b) = …` to the corresponding tuple element
// type (no-op if the value is not a tuple).
fn bind_tuple_names(names: *const Vec<str>, tty: *const Typ, env: *Vec<FieldTy>) {
    match *tty {
        Typ::TTuple(elems) => {
            let n = names.length();
            let nsl = names.as_slice();
            let en = elems.length();
            let esl = elems.as_slice();
            let mut i = 0 as u32;
            while i < n {
                if i < en { env.push(FieldTy { name: nsl[i], ty: esl[i] }); }
                i = i + 1 as u32;
            }
        }
        | _e => { }
    }
}

fn elab_stmt(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
             s: *const Stmt, out: *Vec<Tstmt>) {
    match *s {
        Stmt::Let { name, value, ty_ann, is_mut, pos } => {
            let exp = let_expected(a, ar, sc, ty_ann);
            let vl = elab_expr(a, ar, g, sc, env, exp, value);
            let ety = let_env_ty(a, ar, sc, ty_ann, vl.ty);
            // The diagnostic points at the `let`, not at the value: that is where
            // the annotation the user wrote lives.
            check_let_ty(a, ar, sc, name, value, ty_ann, vl.ty, pos);
            let lent = coerce_own_to(a, ar, sc, vl, ety);
            if is_mut { note_let_mut(sc, name); }
            env.push(FieldTy { name: name, ty: ety });
            out.push(Tstmt::TLet { name: name, value: lent, decl_ty: ety, pos: expr_pos(value) });
        }
        | Stmt::ExprStmt(e) => { elab_stmt_pos(a, ar, g, sc, gensym, env, ret, e, out); }
        | Stmt::Tail(e) => { elab_tail(a, ar, g, sc, gensym, env, ret, e, out); }
        | Stmt::Return(val, pos) => {
            let tv = elab_return_val(a, ar, g, sc, env, ret, val, pos);
            out.push(Tstmt::TReturn { value: tv, pos: pos });
        }
        | Stmt::While { cond, body } => {
            let wcond = elab_expr(a, ar, g, sc, env, none_ty(), cond);
            let wbody = elab_stmt_body(a, ar, g, sc, gensym, env, ret, &body);
            let wpost: Vec<Tstmt> = empty_tstmts(a);
            out.push(Tstmt::TWhile { cond: wcond, body: wbody, post: wpost });
        }
        | Stmt::Assign { path, value, pos } => {
            if path.length() == 1 as u32 { require_mut(a, ar, sc, path.as_slice()[0 as u32], "assign to", pos); }
            let av = assign_coerced_value(a, ar, g, sc, env, &path, value);
            let apath = copy_strs(a, &path);
            out.push(Tstmt::TAssign { path: apath, value: av, pos: pos });
        }
        | Stmt::AssignField { target, field, value, pos } => {
            let taf = elab_expr(a, ar, g, sc, env, none_ty(), target);
            require_mut_root(a, ar, sc, taf, "mutate field of", pos);
            let fexp = struct_field_ty(sc, taf.ty, field);
            let vaf = loan_into(a, ar, sc, elab_expr(a, ar, g, sc, env, fexp, value), fexp);
            out.push(Tstmt::TAssignField { target: taf, field: field, value: vaf, pos: pos });
        }
        | Stmt::AssignDeref { target, value, pos } => {
            let tad = elab_expr(a, ar, g, sc, env, none_ty(), target);
            let dexp = deref_pointee(tad.ty);
            let vad = loan_into(a, ar, sc, elab_expr(a, ar, g, sc, env, dexp, value), dexp);
            out.push(Tstmt::TAssignDeref { target: tad, value: vad, pos: pos });
        }
        | Stmt::AssignIndex { base, index, value, pos } => {
            let tbi = elab_expr(a, ar, g, sc, env, none_ty(), base);
            require_mut_root(a, ar, sc, tbi, "assign into", pos);
            let tii = elab_expr(a, ar, g, sc, env, none_ty(), index);
            let tvi = loan_into(a, ar, sc, elab_expr(a, ar, g, sc, env, none_ty(), value), elem_of(tbi.ty));
            out.push(Tstmt::TAssignIndex { base: tbi, index: tii, value: tvi, pos: pos });
        }
        | Stmt::LetTuple { names, value, is_mut } => {
            let tvt = elab_expr(a, ar, g, sc, env, none_ty(), value);
            if is_mut { note_let_muts(sc, &names); }
            bind_tuple_names(&names, tvt.ty, env);
            out.push(Tstmt::TLetTuple { names: copy_strs(a, &names), value: tvt, pos: expr_pos(value) });
        }
        | Stmt::Break(pos) => { out.push(Tstmt::TBreak(pos)); }
        | Stmt::Continue(pos) => { out.push(Tstmt::TContinue(pos)); }
        | Stmt::Defer { body, pos } => {
            let dbody = elab_stmt_body(a, ar, g, sc, gensym, env, ret, &body);
            out.push(Tstmt::TDefer { body: dbody, pos: pos });
        }
        | Stmt::For { iter_var, range, body } => {
            elab_for(a, ar, g, sc, gensym, env, ret, iter_var, range, &body, out);
        }
        | Stmt::With { target, name, body, pos } => {
            elab_with(a, ar, g, sc, gensym, env, ret, target, name, &body, pos, out);
        }
        | _other => {
            // Unsupported statement — emit a VISIBLE deferral marker rather
            // than silently dropping it (mirrors the expr-level marker).
            out.push(Tstmt::TExprStmt(defer_expr(ar, zero_pos())));
        }
    }
}

fn elab_body(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
             body: *const Vec<Stmt>) -> Vec<Tstmt> {
    let mut out: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let n = body.length();
    let sl = body.as_slice();
    let mut i = 0 as u32;
    while i < n {
        elab_stmt(a, ar, g, sc, gensym, env, ret, &sl[i], &out);
        i = i + 1 as u32;
    }
    return out;
}

// A nested STATEMENT-context body (a `while` / `for` / `defer` body).  Unlike
// a function body or value-`if` branch, its trailing bare expression is a VOID
// statement, never an implicit return — mirroring the oracle's `walk`, where
// `Tail e` and `ExprStmt e` are handled identically (the function-body
// trailing value is peeled off before walking, so it never reaches here).
fn elab_stmt_body(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32, env: *Vec<FieldTy>, ret: Option<*const Typ>,
                  body: *const Vec<Stmt>) -> Vec<Tstmt> {
    let mut out: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let n = body.length();
    let sl = body.as_slice();
    let mut i = 0 as u32;
    while i < n {
        match sl[i] {
            Stmt::Tail(e) => { elab_stmt_pos(a, ar, g, sc, gensym, env, ret, e, &out); }
            | _other => { elab_stmt(a, ar, g, sc, gensym, env, ret, &sl[i], &out); }
        }
        i = i + 1 as u32;
    }
    return out;
}

fn build_param_env(a: Allocator, ar: *Arena, sc: *const TyScope, params: *const Vec<Param>, env: *Vec<FieldTy>) {
    let n = params.length();
    let sl = params.as_slice();
    let mut i = 0 as u32;
    while i < n {
        env.push(FieldTy { name: sl[i].pname, ty: resolve_sig_ty(a, ar, sc, sl[i].pty) });
        i = i + 1 as u32;
    }
}

// ===== Function elaboration =====

// The emitted C symbol (mirrors OCaml `ir.mangle` + the flatten-time rule):
// an `extern fn` keeps its C-side name, `main` stays unprefixed, and every
// other top-level fn gets the `ex_` prefix.  Module-internal mangling
// (`path__name`) lands with the module-elaboration slice.
fn mangle_fn(a: Allocator, ar: *Arena, f: *const Func) -> str {
    if f.is_extern { return f.c_name; }
    if str::eq(f.name, "main") { return "main"; }
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str("ex_");
    sb.push_str(f.name);
    return str::from_slice(ar, sb.as_slice());
}

// ===== Block-expr lift pass =====
//
// Post-elaboration, per function: hoist block-shaped sub-expressions
// (struct / enum / tuple / array literals, match, if-expr) out of positions
// codegen emits via `gen_expr` (call args, binop operands, …) into preceding
// `__lift_N` temporaries.  The top-level value of let / return / assign / an
// expr-stmt match stays block-shaped (codegen handles it directly).  The
// `__lift_N` counter resets per function.  The typed-IR dump is post-lift,
// so the port must reproduce it.
//
// v1 limits (no current example needs them): match-arm bodies are copied
// but not walked (a block / `for` inside an arm body would need a TBlock
// wrap), and a block-shaped `while` condition is not re-evaluated per
// iteration.

fn lift_name(a: Allocator, ar: *Arena, ctr: *u32) -> str {
    let n = *ctr;
    *ctr = *ctr + 1 as u32;
    let mut sb = StringBuilder::with_capacity(a, 16 as u32);
    sb.push_str("__lift_");
    sb.push_int(n as int);
    return str::from_slice(ar, sb.as_slice());
}

fn is_block_texpr(te: *const Texpr) -> bool {
    return match te.e {
        TexprNode::TStructLit { sname_path, fields, base } => true
        | TexprNode::TTupleLit(_es) => true
        | TexprNode::TNew { sname_path, fields, base, alloc } => true
        | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => true
        | TexprNode::TEnumLit { ename_path, variant, tag, args } => true
        | TexprNode::TMatch { scrutinee, ename_path, arms } => true
        | TexprNode::TIfExpr { cond, then_val, else_val } => true
        | TexprNode::TArrayLit(_es) => true
        | TexprNode::TArrayRepeat { value, count } => true
        | _other => false
    };
}

fn is_match_texpr(te: *const Texpr) -> bool {
    return match te.e {
        TexprNode::TMatch { scrutinee, ename_path, arms } => true
        | _o => false
    };
}

// Deep-copy a pattern so a rebuilt match arm owns its `tpat` (the arm can't
// be moved out of the borrowed source node).
fn copy_tfieldpats(a: Allocator, ar: *Arena, binds: *const Vec<TFieldPat>) -> Vec<TFieldPat> {
    let mut out: Vec<TFieldPat> = Vec::with_capacity(a, 8 as u32);
    let n = binds.length();
    let sl = binds.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(TFieldPat { name: sl[i].name, pat: copy_tpattern(a, ar, &sl[i].pat) }); i = i + 1 as u32; }
    return out;
}
fn copy_tpatterns(a: Allocator, ar: *Arena, alts: *const Vec<Tpattern>) -> Vec<Tpattern> {
    let mut out: Vec<Tpattern> = Vec::with_capacity(a, 8 as u32);
    let n = alts.length();
    let sl = alts.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(copy_tpattern(a, ar, &sl[i])); i = i + 1 as u32; }
    return out;
}
fn copy_tpattern(a: Allocator, ar: *Arena, p: *const Tpattern) -> Tpattern {
    return match *p {
        Tpattern::TPWildcard => Tpattern::TPWildcard
        | Tpattern::TPVar(n) => Tpattern::TPVar(n)
        | Tpattern::TPLit(n) => Tpattern::TPLit(n)
        | Tpattern::TPBool(b) => Tpattern::TPBool(b)
        | Tpattern::TPVariant { variant, tag, binds } =>
            Tpattern::TPVariant { variant: variant, tag: tag, binds: copy_tfieldpats(a, ar, &binds) }
        | Tpattern::TPOr(alts) => Tpattern::TPOr(copy_tpatterns(a, ar, &alts))
    };
}

fn walk_args(a: Allocator, ar: *Arena, ctr: *u32, args: *const Vec<*const Texpr>, prelude: *Vec<Tstmt>) -> Vec<*const Texpr> {
    let mut out: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    let n = args.length();
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(walk_expr(a, ar, ctr, false, sl[i], prelude)); i = i + 1 as u32; }
    return out;
}
fn walk_fields(a: Allocator, ar: *Arena, ctr: *u32, fields: *const Vec<TexprField>, prelude: *Vec<Tstmt>) -> Vec<TexprField> {
    let mut out: Vec<TexprField> = Vec::with_capacity(a, 8 as u32);
    let n = fields.length();
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(TexprField { name: sl[i].name, value: walk_expr(a, ar, ctr, false, sl[i].value, prelude) }); i = i + 1 as u32; }
    return out;
}
fn walk_opt(a: Allocator, ar: *Arena, ctr: *u32, o: Option<*const Texpr>, prelude: *Vec<Tstmt>) -> Option<*const Texpr> {
    return match o {
        Option::Some(e) => Option::Some(walk_expr(a, ar, ctr, false, e, prelude))
        | Option::None => { let nn: Option<*const Texpr> = Option::None; nn }
    };
}

// A match-arm body is a value in its own right: walk its sub-expressions,
// collecting any block-shaped ones into a local prelude, and — when the
// prelude is non-empty — wrap the arm body in a `TBlock { lifts; trailing }`
// (matching the oracle, which hoists e.g. an `enum-lit` argument inside an
// arm into `__lift_N` temps before the arm's trailing call).  The lift
// counter is the function's, so numbering stays sequential across arms.
fn walk_arm_body(a: Allocator, ar: *Arena, ctr: *u32, tbody: *const Texpr) -> *const Texpr {
    let mut prelude: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let walked = walk_expr(a, ar, ctr, true, tbody, &prelude);
    if prelude.length() == 0 as u32 { return walked; }
    return te_node(ar, TexprNode::TBlock { stmts: prelude, trailing: Option::Some(walked) }, walked.ty, walked.pos);
}
fn walk_match_arms(a: Allocator, ar: *Arena, ctr: *u32, arms: *const Vec<TmatchArm>) -> Vec<TmatchArm> {
    let mut out: Vec<TmatchArm> = Vec::with_capacity(a, 8 as u32);
    let n = arms.length();
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < n {
        out.push(TmatchArm { tpat: copy_tpattern(a, ar, &sl[i].tpat), tguard: sl[i].tguard,
                             tbody: walk_arm_body(a, ar, ctr, sl[i].tbody),
                             tdiverges: sl[i].tdiverges, tarm_pos: sl[i].tarm_pos });
        i = i + 1 as u32;
    }
    return out;
}
// `&x` needs an addressable operand.  A call / other rvalue result is a
// temporary, so taking its address requires materialising it into a
// `__lift_N` temp first (matching the oracle: `&f(x)` -> `let __lift = f(x);
// &__lift`).  Lvalues (var / field / index / deref) are addressed directly.
fn is_addressable(te: *const Texpr) -> bool {
    return match te.e {
        TexprNode::TVar(_n) => true
        | TexprNode::TFieldAccess { target, field } => true
        | TexprNode::TIndex { base, index } => true
        | TexprNode::TDeref(_s) => true
        | _other => false
    };
}
fn ref_operand(a: Allocator, ar: *Arena, ctr: *u32, ws: *const Texpr, prelude: *Vec<Tstmt>) -> *const Texpr {
    if is_addressable(ws) { return ws; }
    let nm = lift_name(a, ar, ctr);
    prelude.push(Tstmt::TLet { name: nm, value: ws, decl_ty: ws.ty, pos: ws.pos });
    return te_node(ar, TexprNode::TVar(nm), ws.ty, ws.pos);
}
fn walk_subs(a: Allocator, ar: *Arena, ctr: *u32, te: *const Texpr, prelude: *Vec<Tstmt>) -> *const Texpr {
    let p = te.pos;
    return match te.e {
        TexprNode::TNeg(s) => te_node(ar, TexprNode::TNeg(walk_expr(a, ar, ctr, false, s, prelude)), te.ty, p)
        | TexprNode::TBitNot(s) => te_node(ar, TexprNode::TBitNot(walk_expr(a, ar, ctr, false, s, prelude)), te.ty, p)
        | TexprNode::TNot(s) => te_node(ar, TexprNode::TNot(walk_expr(a, ar, ctr, false, s, prelude)), te.ty, p)
        | TexprNode::TBinOp(op, l, r) =>
            te_node(ar, TexprNode::TBinOp(op, walk_expr(a, ar, ctr, false, l, prelude), walk_expr(a, ar, ctr, false, r, prelude)), te.ty, p)
        | TexprNode::TCall { mangled, args } =>
            te_node(ar, TexprNode::TCall { mangled: mangled, args: walk_args(a, ar, ctr, &args, prelude) }, te.ty, p)
        | TexprNode::TBuiltinCall { name, args } =>
            te_node(ar, TexprNode::TBuiltinCall { name: name, args: walk_args(a, ar, ctr, &args, prelude) }, te.ty, p)
        | TexprNode::TCast(s, ann) => te_node(ar, TexprNode::TCast(walk_expr(a, ar, ctr, false, s, prelude), ann), te.ty, p)
        | TexprNode::TFieldAccess { target, field } =>
            te_node(ar, TexprNode::TFieldAccess { target: walk_expr(a, ar, ctr, false, target, prelude), field: field }, te.ty, p)
        | TexprNode::TRef(s) => te_node(ar, TexprNode::TRef(ref_operand(a, ar, ctr, walk_expr(a, ar, ctr, false, s, prelude), prelude)), te.ty, p)
        | TexprNode::TDeref(s) => te_node(ar, TexprNode::TDeref(walk_expr(a, ar, ctr, false, s, prelude)), te.ty, p)
        | TexprNode::TIndex { base, index } =>
            te_node(ar, TexprNode::TIndex { base: walk_expr(a, ar, ctr, false, base, prelude), index: walk_expr(a, ar, ctr, false, index, prelude) }, te.ty, p)
        | TexprNode::TStructLit { sname_path, fields, base } =>
            te_node(ar, TexprNode::TStructLit { sname_path: copy_strs(a, &sname_path), fields: walk_fields(a, ar, ctr, &fields, prelude), base: walk_opt(a, ar, ctr, base, prelude) }, te.ty, p)
        | TexprNode::TEnumLit { ename_path, variant, tag, args } =>
            te_node(ar, TexprNode::TEnumLit { ename_path: copy_strs(a, &ename_path), variant: variant, tag: tag, args: walk_fields(a, ar, ctr, &args, prelude) }, te.ty, p)
        | TexprNode::TMatch { scrutinee, ename_path, arms } =>
            te_node(ar, TexprNode::TMatch { scrutinee: walk_expr(a, ar, ctr, false, scrutinee, prelude), ename_path: copy_strs(a, &ename_path), arms: walk_match_arms(a, ar, ctr, &arms) }, te.ty, p)
        | TexprNode::TIfExpr { cond, then_val, else_val } => {
            // The branches are values (like match-arm bodies): walk each,
            // hoisting a block-shaped sub-expression into a `TBlock` in that
            // branch.  The oracle numbers the else branch's lifts before the
            // then branch's, so walk the else side first.
            let wcond = walk_expr(a, ar, ctr, false, cond, prelude);
            let welse = walk_arm_body(a, ar, ctr, else_val);
            let wthen = walk_arm_body(a, ar, ctr, then_val);
            te_node(ar, TexprNode::TIfExpr { cond: wcond, then_val: wthen, else_val: welse }, te.ty, p)
        }
        | TexprNode::TBlock { stmts, trailing } => {
            // A block value (e.g. a statement-shaped match-arm body) lifts its
            // own statements + trailing value into its own scope.
            let mut wstmts = lift_stmts(a, ar, ctr, &stmts);
            let wtr = walk_trailing(a, ar, ctr, trailing, &wstmts);
            te_node(ar, TexprNode::TBlock { stmts: wstmts, trailing: wtr }, te.ty, p)
        }
        | _other => te
    };
}
fn walk_trailing(a: Allocator, ar: *Arena, ctr: *u32, tr: Option<*const Texpr>, into: *Vec<Tstmt>) -> Option<*const Texpr> {
    return match tr {
        Option::Some(te) => Option::Some(walk_expr(a, ar, ctr, true, te, into))
        | Option::None => { let n: Option<*const Texpr> = Option::None; n }
    };
}

fn walk_expr(a: Allocator, ar: *Arena, ctr: *u32, allow_top: bool, te: *const Texpr, prelude: *Vec<Tstmt>) -> *const Texpr {
    let walked = walk_subs(a, ar, ctr, te, prelude);
    if allow_top { return walked; }
    if !is_block_texpr(walked) { return walked; }
    let nm = lift_name(a, ar, ctr);
    prelude.push(Tstmt::TLet { name: nm, value: walked, decl_ty: walked.ty, pos: walked.pos });
    return te_node(ar, TexprNode::TVar(nm), walked.ty, walked.pos);
}

// A while-condition whose lift-prelude is non-empty must NOT hoist that
// prelude above the loop — hoisting evaluates it once and freezes the
// condition (freeze-audit B2).  Mirror the oracle: rewrite to
// `while true { <prelude>; if !c { break }; body }` so the prelude re-runs
// each iteration.  Walk the condition into a fresh sink so its prelude can be
// detected; an empty prelude keeps the plain `while c { body }` form.
fn lift_while(a: Allocator, ar: *Arena, ctr: *u32, cond: *const Texpr,
              body: *const Vec<Tstmt>, post: *const Vec<Tstmt>, out: *Vec<Tstmt>) {
    let mut nb: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let cwh = walk_expr(a, ar, ctr, false, cond, &nb);
    if nb.length() == 0 as u32 {
        out.push(Tstmt::TWhile { cond: cwh, body: lift_stmts(a, ar, ctr, body), post: lift_stmts(a, ar, ctr, post) });
        return;
    }
    let cp = cwh.pos;
    let notc = te_node(ar, TexprNode::TNot(cwh), t_bool(ar), cp);
    let mut brk: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    brk.push(Tstmt::TBreak(cp));
    let ee: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    nb.push(Tstmt::TIf { cond: notc, then_body: brk, else_body: ee });
    let bsl = body.as_slice();
    let bn = body.length();
    let mut bi = 0 as u32;
    while bi < bn { lift_stmt(a, ar, ctr, &bsl[bi], &nb); bi = bi + 1 as u32; }
    let truecond = te_node(ar, TexprNode::TBoolLit(true), t_bool(ar), cp);
    out.push(Tstmt::TWhile { cond: truecond, body: nb, post: lift_stmts(a, ar, ctr, post) });
}

fn lift_stmt(a: Allocator, ar: *Arena, ctr: *u32, s: *const Tstmt, out: *Vec<Tstmt>) {
    match *s {
        Tstmt::TLet { name, value, decl_ty, pos } => {
            let vlet = walk_expr(a, ar, ctr, true, value, out);
            out.push(Tstmt::TLet { name: name, value: vlet, decl_ty: decl_ty, pos: pos });
        }
        | Tstmt::TLetTuple { names, value, pos } => {
            let vlt = walk_expr(a, ar, ctr, true, value, out);
            out.push(Tstmt::TLetTuple { names: copy_strs(a, &names), value: vlt, pos: pos });
        }
        | Tstmt::TAssign { path, value, pos } => {
            let vasg = walk_expr(a, ar, ctr, true, value, out);
            out.push(Tstmt::TAssign { path: copy_strs(a, &path), value: vasg, pos: pos });
        }
        | Tstmt::TAssignField { target, field, value, pos } => {
            let taf = walk_expr(a, ar, ctr, false, target, out);
            let vaf = walk_expr(a, ar, ctr, false, value, out);
            out.push(Tstmt::TAssignField { target: taf, field: field, value: vaf, pos: pos });
        }
        | Tstmt::TAssignDeref { target, value, pos } => {
            let tad = walk_expr(a, ar, ctr, false, target, out);
            let vad = walk_expr(a, ar, ctr, false, value, out);
            out.push(Tstmt::TAssignDeref { target: tad, value: vad, pos: pos });
        }
        | Tstmt::TAssignIndex { base, index, value, pos } => {
            let tbi = walk_expr(a, ar, ctr, false, base, out);
            let tii = walk_expr(a, ar, ctr, false, index, out);
            let tvi = walk_expr(a, ar, ctr, false, value, out);
            out.push(Tstmt::TAssignIndex { base: tbi, index: tii, value: tvi, pos: pos });
        }
        | Tstmt::TReturn { value, pos } => {
            match value {
                Option::Some(e) => {
                    let vret = walk_expr(a, ar, ctr, true, e, out);
                    out.push(Tstmt::TReturn { value: Option::Some(vret), pos: pos });
                }
                | Option::None => {
                    let nv: Option<*const Texpr> = Option::None;
                    out.push(Tstmt::TReturn { value: nv, pos: pos });
                }
            }
        }
        | Tstmt::TExprStmt(e) => {
            let at = is_match_texpr(e);
            let vexp = walk_expr(a, ar, ctr, at, e, out);
            out.push(Tstmt::TExprStmt(vexp));
        }
        | Tstmt::TIf { cond, then_body, else_body } => {
            // Lift the else branch before the then branch — the oracle numbers
            // an if statement's `__lift_N` temps in that order.
            let cif = walk_expr(a, ar, ctr, false, cond, out);
            let welse = lift_stmts(a, ar, ctr, &else_body);
            let wthen = lift_stmts(a, ar, ctr, &then_body);
            out.push(Tstmt::TIf { cond: cif, then_body: wthen, else_body: welse });
        }
        | Tstmt::TWhile { cond, body, post } => {
            lift_while(a, ar, ctr, cond, &body, &post, out);
        }
        | Tstmt::TBreak(bp) => { out.push(Tstmt::TBreak(bp)); }
        | Tstmt::TContinue(cp) => { out.push(Tstmt::TContinue(cp)); }
        | Tstmt::TDefer { body, pos } => { out.push(Tstmt::TDefer { body: lift_stmts(a, ar, ctr, &body), pos: pos }); }
        | _other => { }
    }
}

fn lift_stmts(a: Allocator, ar: *Arena, ctr: *u32, stmts: *const Vec<Tstmt>) -> Vec<Tstmt> {
    let mut out: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let n = stmts.length();
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < n { lift_stmt(a, ar, ctr, &sl[i], &out); i = i + 1 as u32; }
    return out;
}


// ===== Sibling shadowing — the scope pre-pass (mirrors lib/typecheck.ml) =====
//
// A `let` is visible only to the end of its enclosing block, so two DISJOINT
// blocks may bind the same name — the shape a compiler is made of: one arm per
// node kind, the same role in each.  Shadowing a binding that IS visible, or a
// parameter, stays an error.
//
// Everything below this pass still assumes one C name per function (`tf_lets` is
// flat, and move / escape / drop key their state by name), so siblings are
// renamed apart HERE: the first `v` keeps `v`, the next disjoint one becomes
// `v__1`.  The scheme is deterministic in source order — that is precisely what
// lets this compiler and the OCaml reference emit the same C.
//
// `for` and `with` are visibility-checked but NOT renamed: their desugars already
// gensym the binding (`__fvK` / `x__withK`), and renaming here would rename it
// twice (`i__1__fv2`).

struct ScopeSt {
    ss_params: *Vec<str>,
    ss_taken: *Vec<str>,        // every C name minted in this fn
    ss_mint: *Vec<StrPair>,     // source name -> next suffix, as text
    ss_srcnames: *Vec<StrPair>, // minted C name -> the name the user wrote
}

fn names_has(v: *const Vec<str>, n: str) -> bool {
    let sl = v.as_slice();
    let mut i = 0 as u32;
    while i < v.length() { if str::eq(sl[i], n) { return true; } i = i + 1 as u32; }
    return false;
}
fn suffixed(a: Allocator, ar: *Arena, name: str, n: int) -> str {
    let mut sb = StringBuilder::with_capacity(a, 24 as u32);
    sb.push_str(name);
    sb.push_str("__");
    sb.push_int(n);
    return str::from_slice(ar, sb.as_slice());
}
// Skips a candidate the user already spoke for: `let v__1 = ...` in scope means the
// sibling rename of `v` must land on `v__2`.  Without this the mint collides with a
// real binding.
fn mint_next(a: Allocator, ar: *Arena, st: *const ScopeSt, name: str) -> str {
    let sl = st.ss_mint.as_slice();
    let mut i = 0 as u32;
    let mut n = 0 as int;
    while i < st.ss_mint.length() {
        if str::eq(sl[i].a, name) { n = str_to_int_sc(sl[i].b); }
        i = i + 1 as u32;
    }
    n = n + 1 as int;
    let mut fresh = suffixed(a, ar, name, n);
    while names_has(st.ss_taken, fresh) {
        n = n + 1 as int;
        fresh = suffixed(a, ar, name, n);
    }
    let mut nb = StringBuilder::with_capacity(a, 8 as u32);
    nb.push_int(n);
    st.ss_mint.push(StrPair { a: name, b: str::from_slice(ar, nb.as_slice()) });
    st.ss_taken.push(fresh);
    st.ss_srcnames.push(StrPair { a: fresh, b: name });
    return fresh;
}
fn str_to_int_sc(s: str) -> int {
    let b = str::as_bytes(s);
    let mut v = 0 as int;
    let mut i = 0 as u32;
    while i < str::length(s) {
        v = v * 10 as int + (b[i] as int - 48 as int);
        i = i + 1 as u32;
    }
    return v;
}
// Three distinct mistakes, three distinct messages.  `here` is what THIS block has
// bound so far; `visible` is the whole enclosing chain.
fn scope_check(st: *const ScopeSt, here: *const Vec<str>, visible: *const Vec<str>, name: str) {
    if names_has(st.ss_params, name) { return; }
    if names_has(here, name) { return; }
    if names_has(visible, name) { return; }
    return;
}
fn scope_bind(a: Allocator, ar: *Arena, st: *const ScopeSt, here: *const Vec<str>,
              visible: *const Vec<str>, name: str) -> str {
    // The port elides diagnostics (it is a differential port over a valid corpus),
    // so the three rejections live in the reference implementation.  What must be
    // identical is the RENAME, because it is observable in the emitted C.
    scope_check(st, here, visible, name);
    if names_has(st.ss_taken, name) { return mint_next(a, ar, st, name); }
    st.ss_taken.push(name);
    st.ss_mint.push(StrPair { a: name, b: "0" });
    return name;
}
fn copy_names_sc(a: Allocator, src: *const Vec<str>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < src.length() { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}
fn concat_names(a: Allocator, x: *const Vec<str>, y: *const Vec<str>) -> Vec<str> {
    let mut out = copy_names_sc(a, x);
    let sl = y.as_slice();
    let mut i = 0 as u32;
    while i < y.length() { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}
fn pattern_binds_sc(a: Allocator, p: *const Pattern, out: *Vec<str>) {
    match *p {
        Pattern::PVar(n, _q) => { out.push(n); }
        | Pattern::PVariant { tname, variant, binds, pos } => { patbinds_sc(a, &binds, out); }
        | Pattern::POr(ps, _q) => {
            let sl = ps.as_slice();
            let mut i = 0 as u32;
            while i < ps.length() { pattern_binds_sc(a, &sl[i], out); i = i + 1 as u32; }
        }
        | _o => { }
    }
    return;
}
fn patbinds_sc(a: Allocator, b: *const PatBinds, out: *Vec<str>) {
    match *b {
        PatBinds::PBTuple(ps) => {
            let sl = ps.as_slice();
            let mut i = 0 as u32;
            while i < ps.length() { pattern_binds_sc(a, &sl[i], out); i = i + 1 as u32; }
        }
        | PatBinds::PBStruct(fs) => {
            let sl = fs.as_slice();
            let mut i = 0 as u32;
            while i < fs.length() { pattern_binds_sc(a, &sl[i].pat, out); i = i + 1 as u32; }
        }
    }
    return;
}

// (Extracted because a value-`if` cannot take block branches — the very wall this
// pass removes for `let`.  It is on the DX list as its own item.)
fn maybe_subst(a: Allocator, ar: *Arena, from: str, to: str, body: *const Vec<Stmt>) -> Vec<Stmt> {
    if str::eq(from, to) { return copy_stmts(a, body); }
    return subst_body(a, ar, from, to, body);
}
fn scope_block(a: Allocator, ar: *Arena, st: *const ScopeSt, visible: *const Vec<str>,
               stmts: *const Vec<Stmt>) -> Vec<Stmt> {
    // `cur` is rewritten in place as renames land.  It is reassigned from an
    // rvalue rather than swapped with a loop-local, because the move pass rejects
    // consuming a named binding declared inside a loop even when the loop
    // re-initialises it every iteration (a false positive — its own DX item).
    let mut cur = copy_stmts(a, stmts);
    let mut here: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut out: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    let mut i = 0 as u32;
    while i < cur.length() {
        // Statements before `i` are already in `out`; substituting them again is a
        // no-op, so the rename may sweep the whole vector.
        cur = scope_one(a, ar, st, &here, visible, &cur, i, &out);
        i = i + 1 as u32;
    }
    return out;
}
// Rewrites cur[i] into `out` and returns `cur` with any rename applied to the
// statements that follow it.
fn scope_one(a: Allocator, ar: *Arena, st: *const ScopeSt, here: *Vec<str>,
             visible: *const Vec<str>, cur: *const Vec<Stmt>, i: u32,
             out: *Vec<Stmt>) -> Vec<Stmt> {
    let head: *const Stmt = &cur.as_slice()[i];
    let vis = concat_names(a, here, visible);
    let mut renamed = copy_stmts(a, cur);
    match *head {
        Stmt::Let { name, value, ty_ann, is_mut, pos } => {
            let nv = scope_expr_sc(a, ar, st, &vis, value);
            let c = scope_bind(a, ar, st, here, visible, name);
            here.push(c);
            out.push(Stmt::Let { name: c, value: nv, ty_ann: ty_ann, is_mut: is_mut, pos: pos });
            renamed = maybe_subst(a, ar, name, c, cur);
        }
        | Stmt::LetTuple { names, value, is_mut, pos } => {
            let nv = scope_expr_sc(a, ar, st, &vis, value);
            // Push the fresh name straight through: reading it back out of a
            // local Vec's slice would make the escape pass see a borrow of a
            // local (it cannot know the `str` lives in the arena, not in `cs`).
            let mut cs: Vec<str> = Vec::with_capacity(a, 8 as u32);
            let nsl = names.as_slice();
            let mut k = 0 as u32;
            while k < names.length() {
                let c = scope_bind(a, ar, st, here, visible, nsl[k]);
                renamed = maybe_subst(a, ar, nsl[k], c, &renamed);
                here.push(c);
                cs.push(c);
                k = k + 1 as u32;
            }
            out.push(Stmt::LetTuple { names: cs, value: nv, is_mut: is_mut, pos: pos });
        }
        | Stmt::While { cond, body } => {
            let nc = scope_expr_sc(a, ar, st, &vis, cond);
            out.push(Stmt::While { cond: nc, body: scope_block(a, ar, st, &vis, &body) });
        }
        | Stmt::For { iter_var, range, body, pos } => {
            let nr = scope_expr_sc(a, ar, st, &vis, range);
            let mut ivis = copy_names_sc(a, &vis);
            ivis.push(iter_var);
            out.push(Stmt::For { iter_var: iter_var, range: nr,
                                 body: scope_block(a, ar, st, &ivis, &body), pos: pos });
        }
        | Stmt::With { target, name, body, pos } => {
            let nt = scope_expr_sc(a, ar, st, &vis, target);
            let mut wvis = copy_names_sc(a, &vis);
            wvis.push(name);
            out.push(Stmt::With { target: nt, name: name,
                                  body: scope_block(a, ar, st, &wvis, &body), pos: pos });
        }
        | Stmt::Defer { body, pos } => {
            out.push(Stmt::Defer { body: scope_block(a, ar, st, &vis, &body), pos: pos });
        }
        | Stmt::LetElse { pat, value, else_body, pos } => {
            let nv = scope_expr_sc(a, ar, st, &vis, value);
            let neb = scope_block(a, ar, st, &vis, &else_body);
            let mut ns: Vec<str> = Vec::with_capacity(a, 8 as u32);
            pattern_binds_sc(a, &pat, &ns);
            let nsl = ns.as_slice();
            let mut k = 0 as u32;
            while k < ns.length() {
                let c = scope_bind(a, ar, st, here, visible, nsl[k]);
                here.push(c);
                k = k + 1 as u32;
            }
            out.push(Stmt::LetElse { pat: pat, value: nv, else_body: neb, pos: pos });
        }
        | Stmt::Assign { path, value, pos } => {
            out.push(Stmt::Assign { path: copy_strs(a, &path), value: scope_expr_sc(a, ar, st, &vis, value), pos: pos });
        }
        | Stmt::AssignField { target, field, value, pos } => {
            out.push(Stmt::AssignField { target: scope_expr_sc(a, ar, st, &vis, target), field: field,
                                         value: scope_expr_sc(a, ar, st, &vis, value), pos: pos });
        }
        | Stmt::AssignIndex { base, index, value, pos } => {
            out.push(Stmt::AssignIndex { base: scope_expr_sc(a, ar, st, &vis, base),
                                         index: scope_expr_sc(a, ar, st, &vis, index),
                                         value: scope_expr_sc(a, ar, st, &vis, value), pos: pos });
        }
        | Stmt::AssignDeref { target, value, pos } => {
            out.push(Stmt::AssignDeref { target: scope_expr_sc(a, ar, st, &vis, target),
                                         value: scope_expr_sc(a, ar, st, &vis, value), pos: pos });
        }
        | Stmt::Return(v, p) => { out.push(Stmt::Return(scope_opt_sc(a, ar, st, &vis, v), p)); }
        | Stmt::ExprStmt(e) => { out.push(Stmt::ExprStmt(scope_expr_sc(a, ar, st, &vis, e))); }
        | Stmt::Tail(e) => { out.push(Stmt::Tail(scope_expr_sc(a, ar, st, &vis, e))); }
        | _leaf => { out.push(*head); }
    }
    return renamed;
}
fn scope_opt_sc(a: Allocator, ar: *Arena, st: *const ScopeSt, visible: *const Vec<str>,
                e: Option<*const Expr>) -> Option<*const Expr> {
    return match e {
        Option::Some(x) => Option::Some(scope_expr_sc(a, ar, st, visible, x))
        | Option::None => { let n: Option<*const Expr> = Option::None; n }
    };
}
fn scope_args_sc(a: Allocator, ar: *Arena, st: *const ScopeSt, visible: *const Vec<str>,
                 args: *const Vec<*const Expr>) -> Vec<*const Expr> {
    let mut out: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < args.length() { out.push(scope_expr_sc(a, ar, st, visible, sl[i])); i = i + 1 as u32; }
    return out;
}
fn scope_fields_sc(a: Allocator, ar: *Arena, st: *const ScopeSt, visible: *const Vec<str>,
                   fs: *const Vec<Field>) -> Vec<Field> {
    let mut out: Vec<Field> = Vec::with_capacity(a, 8 as u32);
    let sl = fs.as_slice();
    let mut i = 0 as u32;
    while i < fs.length() {
        out.push(Field { name: sl[i].name, value: scope_expr_sc(a, ar, st, visible, sl[i].value) });
        i = i + 1 as u32;
    }
    return out;
}
fn scope_enum_args_sc(a: Allocator, ar: *Arena, st: *const ScopeSt, visible: *const Vec<str>,
                      args: EnumLitArgs) -> EnumLitArgs {
    return match args {
        EnumLitArgs::EATuple(es) => EnumLitArgs::EATuple(scope_args_sc(a, ar, st, visible, &es))
        | EnumLitArgs::EAStruct(fs) => EnumLitArgs::EAStruct(scope_fields_sc(a, ar, st, visible, &fs))
    };
}
fn scope_arms_sc(a: Allocator, ar: *Arena, st: *const ScopeSt, visible: *const Vec<str>,
                 arms: *const Vec<MatchArm>) -> Vec<MatchArm> {
    let mut out: Vec<MatchArm> = Vec::with_capacity(a, 8 as u32);
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < arms.length() {
        // Pattern binds are the arm's own scope and are NOT renamed: they never
        // reach tf_lets (codegen declares them inside the `case` block), so two
        // arms binding the same name already coexist.
        let mut bs: Vec<str> = Vec::with_capacity(a, 8 as u32);
        pattern_binds_sc(a, &sl[i].pat, &bs);
        let avis = concat_names(a, &bs, visible);
        out.push(MatchArm { pat: sl[i].pat,
                            guard: scope_opt_sc(a, ar, st, &avis, sl[i].guard),
                            body: scope_expr_sc(a, ar, st, &avis, sl[i].body),
                            arm_pos: sl[i].arm_pos });
        i = i + 1 as u32;
    }
    return out;
}
fn scope_expr_sc(a: Allocator, ar: *Arena, st: *const ScopeSt, visible: *const Vec<str>,
                 e: *const Expr) -> *const Expr {
    let p = expr_pos(e);
    return match *e {
        Expr::Block(stmts, _q) => ast_node(ar, Expr::Block(scope_block(a, ar, st, visible, &stmts), p))
        | Expr::If { cond, then_blk, else_blk } =>
            ast_node(ar, Expr::If { cond: scope_expr_sc(a, ar, st, visible, cond),
                                    then_blk: scope_block(a, ar, st, visible, &then_blk),
                                    else_blk: scope_else_sc(a, ar, st, visible, else_blk), pos: p })
        | Expr::Match { scrutinee, arms } =>
            ast_node(ar, Expr::Match { scrutinee: scope_expr_sc(a, ar, st, visible, scrutinee),
                                       arms: scope_arms_sc(a, ar, st, visible, &arms), pos: p })
        // NOT descended into: a lambda body is lifted to its own function and gets
        // its own scope pass there, seeded with its own params.  Rewriting it from
        // the enclosing fn would rename it twice — and would break the closure
        // pre-pass, which matches lambda nodes by pointer identity.
        | Expr::Lambda { params, ret_ty, body, captures } => e
        | Expr::Neg(s, _q) => ast_node(ar, Expr::Neg(scope_expr_sc(a, ar, st, visible, s), p))
        | Expr::BitNot(s, _q) => ast_node(ar, Expr::BitNot(scope_expr_sc(a, ar, st, visible, s), p))
        | Expr::Not(s, _q) => ast_node(ar, Expr::Not(scope_expr_sc(a, ar, st, visible, s), p))
        | Expr::BinOp(op, l, r, _q) =>
            ast_node(ar, Expr::BinOp(op, scope_expr_sc(a, ar, st, visible, l), scope_expr_sc(a, ar, st, visible, r), p))
        | Expr::Cast(s, t, _q) => ast_node(ar, Expr::Cast(scope_expr_sc(a, ar, st, visible, s), t, p))
        | Expr::Call { callee, args } =>
            ast_node(ar, Expr::Call { callee: copy_strs(a, &callee), args: scope_args_sc(a, ar, st, visible, &args), pos: p })
        | Expr::MethodCall { receiver, name, args } =>
            ast_node(ar, Expr::MethodCall { receiver: scope_expr_sc(a, ar, st, visible, receiver), name: name,
                                            args: scope_args_sc(a, ar, st, visible, &args), pos: p })
        | Expr::TupleLit(es, _q) => ast_node(ar, Expr::TupleLit(scope_args_sc(a, ar, st, visible, &es), p))
        | Expr::ArrayLit(es, _q) => ast_node(ar, Expr::ArrayLit(scope_args_sc(a, ar, st, visible, &es), p))
        | Expr::ArrayRepeat { value, count } =>
            ast_node(ar, Expr::ArrayRepeat { value: scope_expr_sc(a, ar, st, visible, value),
                                             count: scope_expr_sc(a, ar, st, visible, count), pos: p })
        | Expr::Index { base, index } =>
            ast_node(ar, Expr::Index { base: scope_expr_sc(a, ar, st, visible, base),
                                       index: scope_expr_sc(a, ar, st, visible, index), pos: p })
        | Expr::Range { lo, hi, inclusive } =>
            ast_node(ar, Expr::Range { lo: scope_expr_sc(a, ar, st, visible, lo),
                                       hi: scope_expr_sc(a, ar, st, visible, hi), inclusive: inclusive, pos: p })
        | Expr::StructLit { tname, fields, base } =>
            ast_node(ar, Expr::StructLit { tname: copy_strs(a, &tname), fields: scope_fields_sc(a, ar, st, visible, &fields),
                                           base: scope_opt_sc(a, ar, st, visible, base), pos: p })
        | Expr::New { tname, fields, base, alloc } =>
            ast_node(ar, Expr::New { tname: copy_strs(a, &tname), fields: scope_fields_sc(a, ar, st, visible, &fields),
                                     base: scope_opt_sc(a, ar, st, visible, base),
                                     alloc: scope_opt_sc(a, ar, st, visible, alloc), pos: p })
        | Expr::NewEnum { tname, args, alloc } =>
            ast_node(ar, Expr::NewEnum { tname: copy_strs(a, &tname), args: scope_args_sc(a, ar, st, visible, &args),
                                         alloc: scope_opt_sc(a, ar, st, visible, alloc), pos: p })
        | Expr::EnumLit { tname, variant, args } =>
            ast_node(ar, Expr::EnumLit { tname: copy_strs(a, &tname), variant: variant,
                                         args: scope_enum_args_sc(a, ar, st, visible, args), pos: p })
        | Expr::FieldAccess(t, f, _q) => ast_node(ar, Expr::FieldAccess(scope_expr_sc(a, ar, st, visible, t), f, p))
        | Expr::Ref(s, _q) => ast_node(ar, Expr::Ref(scope_expr_sc(a, ar, st, visible, s), p))
        | Expr::Deref(s, _q) => ast_node(ar, Expr::Deref(scope_expr_sc(a, ar, st, visible, s), p))
        | Expr::Orelse(l, r, _q) =>
            ast_node(ar, Expr::Orelse(scope_expr_sc(a, ar, st, visible, l), scope_expr_sc(a, ar, st, visible, r), p))
        | Expr::Try(s, _q) => ast_node(ar, Expr::Try(scope_expr_sc(a, ar, st, visible, s), p))
        | _leaf => e
    };
}
fn scope_else_sc(a: Allocator, ar: *Arena, st: *const ScopeSt, visible: *const Vec<str>,
                 blk: Option<Vec<Stmt>>) -> Option<Vec<Stmt>> {
    return match blk {
        Option::Some(b) => Option::Some(scope_block(a, ar, st, visible, &b))
        | Option::None => { let n: Option<Vec<Stmt>> = Option::None; n }
    };
}
// Entry: rewrite one function body.  Params seed the visible set.
pub fn resolve_scopes(a: Allocator, ar: *Arena, srcnames: *Vec<StrPair>, params: *const Vec<Param>, body: *const Vec<Stmt>) -> Vec<Stmt> {
    let mut pn: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut taken: Vec<str> = Vec::with_capacity(a, 16 as u32);
    let mut mint: Vec<StrPair> = Vec::with_capacity(a, 16 as u32);
    let psl = params.as_slice();
    let mut i = 0 as u32;
    while i < params.length() {
        pn.push(psl[i].pname);
        taken.push(psl[i].pname);
        mint.push(StrPair { a: psl[i].pname, b: "0" });
        i = i + 1 as u32;
    }
    let st = ScopeSt { ss_params: &pn, ss_taken: &taken, ss_mint: &mint, ss_srcnames: srcnames };
    let empty: Vec<str> = Vec::with_capacity(a, 8 as u32);
    return scope_block(a, ar, &st, &pn, body);
}

fn elab_skeleton_or_body(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, sc: *const TyScope, gensym: *u32,
                         env: *Vec<FieldTy>, ret_ty: Option<*const Typ>, f: *const Func, is_skeleton: bool) -> Vec<Tstmt> {
    if is_skeleton { return Vec::with_capacity(a, 8 as u32); }
    // Resolve scopes FIRST: rename disjoint siblings apart, so everything below
    // sees names that are unique per function, exactly as before the relaxation.
    // A fresh map per function: minted names are function-local, and so is the
    // mapping back to what the user wrote.
    rebase_srcnames(sc);
    rebase_binds(sc, &f.params);
    let scoped = resolve_scopes(a, ar, sc.sc_srcnames, &f.params, &f.body);
    return elab_body(a, ar, g, sc, gensym, env, ret_ty, &scoped);
}

fn pick_tparams(xtparams: *const Vec<str>, fallback: *const Vec<str>) -> *const Vec<str> {
    if xtparams.length() > 0 as u32 { return xtparams; }
    return fallback;
}
fn elaborate_fn(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32,
                idx: *const ProgIdx, tbinds: *const Vec<TVarBind>, modpath: *const Vec<str>, mangled: str, f: *const Func, self_ty: Option<*const Typ>, xtparams: *const Vec<str>) -> Tfunc {
    let params = copy_params(a, &f.params);
    // A generic-struct method skeleton borrows the impl's type parameters
    // (the method itself declares none); everything else uses its own.
    let eff_tparams = pick_tparams(xtparams, &f.tparams);
    let sc = TyScope { sc_structs: idx.pi_snames, sc_enums: idx.pi_enames, sc_tparams: eff_tparams,
                       sc_iconsts: idx.pi_iconsts, sc_sinfo: idx.pi_sinfo, sc_etags: idx.pi_etags, sc_efields: idx.pi_efields, sc_methods: idx.pi_methods,
                       sc_mono_structs: idx.pi_mono_structs, sc_mono_sargs: idx.pi_mono_sargs, sc_mono_enums: idx.pi_mono_enums, sc_mono_eargs: idx.pi_mono_eargs, sc_mono_fields: idx.pi_mono_fields, sc_mono_efields: idx.pi_mono_efields,
                       sc_tbinds: tbinds, sc_genfns: idx.pi_genfns, sc_genjobs: idx.pi_genjobs, sc_geninsts: idx.pi_geninsts, sc_etps: idx.pi_etps, sc_stps: idx.pi_stps, sc_assoc: idx.pi_assoc, sc_lifted: idx.pi_lifted, sc_gensym: gensym, sc_modpath: modpath, sc_ret: none_ty(), sc_self: self_ty , sc_gsigs: idx.pi_gsigs , sc_xstructs: idx.pi_xstructs, sc_xaliases: idx.pi_xaliases, sc_taliases: idx.pi_taliases, sc_err: idx.pi_err, sc_srcnames: idx.pi_srcnames, sc_srcbase: idx.pi_srcbase, sc_binds: idx.pi_binds, sc_bindbase: idx.pi_bindbase, sc_is_main: str::eq(mangled, "main") };
    let param_tys = resolve_param_tys(a, ar, &sc, &f.params);
    let ret_ty = resolve_sig_ret(a, ar, &sc, f.ret_ty);
    let mut env: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    build_param_env(a, ar, &sc, &f.params, &env);
    // A generic skeleton (type params, no bindings) carries an empty body —
    // only its monomorphic instances have real bodies.
    let is_skeleton = eff_tparams.length() > 0 as u32 && tbinds.length() == 0 as u32;
    // Body scope carries the resolved return type so `try` can build its
    // early-return value on the enclosing fn's instance.
    let scb = scope_with_ret(&sc, ret_ty);
    let raw_body = elab_skeleton_or_body(a, ar, g, &scb, gensym, &env, ret_ty, f, is_skeleton);
    // Lift block-shaped sub-expressions into `__lift_N` temps (per-fn).
    let mut lift_ctr: u32 = 0 as u32;
    let body = lift_stmts(a, ar, &lift_ctr, &raw_body);
    let lets = collect_body_lets(a, &body);
    let no_pos: Option<Pos> = Option::None;
    let path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    // `tf_func` only feeds the dump's flags + param names; rebuild it with
    // copied params and empty generic / body fields (the elaborated body
    // lives in `tf_body`).
    let tparams: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let tbounds: Vec<TraitBound> = Vec::with_capacity(a, 8 as u32);
    let dummy_body: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    let tf_func = Func {
        name: f.name, c_name: f.c_name, tparams: tparams, tbounds: tbounds,
        params: params, ret_ty: f.ret_ty, body: dummy_body, is_pub: f.is_pub,
        is_extern: f.is_extern, is_variadic: f.is_variadic, amiga_lib: f.amiga_lib,
        tier_hint: f.tier_hint, must_use: f.must_use, escapes_hatch: f.escapes_hatch, pos: f.pos,
    };
    return Tfunc {
        tf_path: path, tf_func: tf_func, tf_mangled: mangled, tf_param_tys: param_tys,
        tf_ret_ty: ret_ty, tf_body: body, tf_lets: lets, tf_origin_pos: no_pos,
    };
}

// A module's functions are flattened with a `mod__name` C symbol (recursing
// into nested modules), at the module's source position.
fn path_push(a: Allocator, path: *const Vec<str>, name: str) -> Vec<str> {
    let mut out = copy_strs(a, path);
    out.push(name);
    return out;
}
// `modpath ++ suffix` — qualify an item path (struct / impl target) declared
// inside `mod m { ... }` with its enclosing module path, so `mod pos { struct
// Pos }` registers under `pos::Pos` (the path a `pos::Pos` reference resolves
// to) rather than a bare `Pos`.  An empty modpath leaves the suffix unchanged.
fn path_concat(a: Allocator, prefix: *const Vec<str>, suffix: *const Vec<str>) -> Vec<str> {
    let mut out = copy_strs(a, prefix);
    let n = suffix.length();
    let sl = suffix.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}
// `modpath ++ [name]` rendered `a::b::name` — the membership marker for a
// module-nested type, registered alongside the bare name so resolution can
// tell that a bare `Pos` inside `mod pos` denotes the module-local `pos::Pos`
// (rather than blindly qualifying every bare name, which would mis-route a
// prelude reference like `StringBuilder`).
fn join_colons(a: Allocator, ar: *Arena, modpath: *const Vec<str>, name: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    let n = modpath.length();
    let sl = modpath.as_slice();
    let mut i = 0 as u32;
    while i < n { sb.push_str(sl[i]); sb.push_str("::"); i = i + 1 as u32; }
    sb.push_str(name);
    return str::from_slice(ar, sb.as_slice());
}
// Module-relative qualification for an expression-position type path (a struct
// literal's name): a bare `Pos` inside `mod pos` becomes `pos::Pos` when that
// marker is registered, mirroring resolve_named_ty for annotations.  Already-
// qualified paths and prelude names pass through unchanged.
fn qualify_type_path(a: Allocator, ar: *Arena, sc: *const TyScope, path: *const Vec<str>) -> Vec<str> {
    if path.length() == 1 as u32 {
        let last = path_last(path);
        if sc.sc_modpath.length() > 0 as u32 {
            let marker = join_colons(a, ar, sc.sc_modpath, last);
            if name_in(sc.sc_structs, marker) { return path_push(a, sc.sc_modpath, last); }
            if name_in(sc.sc_enums, marker) { return path_push(a, sc.sc_modpath, last); }
        }
        let ti = talias_idx(sc, last);
        if ti >= 0 as int { return copy_strs(a, &sc.sc_taliases.as_slice()[ti as u32].ta_path); }
    }
    return copy_strs(a, path);
}
fn elaborate_module_fn(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx,
                       path: *const Vec<str>, f: *const Func, funcs: *Vec<Tfunc>) {
    // An extern fn keeps its raw C name as the emitted symbol even in a module.
    let m = if f.is_extern { f.c_name } else { mangle_path(a, ar, path, f.name) };
    funcs.push(elaborate_fn(a, ar, g, gensym, idx, idx.pi_tbinds, path, m, f, none_ty(), &f.tparams));
}
fn elaborate_module_items(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx,
                          path: *const Vec<str>, items: *const Vec<Item>, funcs: *Vec<Tfunc>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        match sl[i] {
            Item::Function(f) => { elaborate_module_fn(a, ar, g, gensym, idx, path, &f, funcs); }
            | Item::Module(md) => {
                let p2 = path_push(a, path, md.mname);
                elaborate_module_items(a, ar, g, gensym, idx, &p2, &md.mitems, funcs);
            }
            | _e => { }
        }
        i = i + 1 as u32;
    }
}

fn elaborate_item(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32,
                  idx: *const ProgIdx, it: *const Item, funcs: *Vec<Tfunc>) {
    match *it {
        Item::Function(f) => { funcs.push(elaborate_fn(a, ar, g, gensym, idx, idx.pi_tbinds, idx.pi_modpath, mangle_fn(a, ar, &f), &f, none_ty(), &f.tparams)); }
        | Item::View(vd) => { elaborate_view(a, ar, g, gensym, idx, &vd, funcs); }
        | Item::Module(md) => {
            let mut p: Vec<str> = Vec::with_capacity(a, 8 as u32);
            p.push(md.mname);
            elaborate_module_items(a, ar, g, gensym, idx, &p, &md.mitems, funcs);
        }
        | _e => { }
    }
}

// An inherent / trait method `impl T { fn m(...) }` elaborates as a free
// function whose C symbol is `T__m` (the target path joined by `__`, then
// the method name).  The oracle flattens every method AFTER the top-level
// free functions, so impls are elaborated in a second pass.
fn method_mangle(a: Allocator, ar: *Arena, target: *const Vec<str>, name: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    let n = target.length();
    let sl = target.as_slice();
    let mut i = 0 as u32;
    while i < n { sb.push_str(sl[i]); sb.push_str("__"); i = i + 1 as u32; }
    sb.push_str(name);
    return str::from_slice(ar, sb.as_slice());
}

// Push happens behind a fn boundary so `f` is a parameter (not the address
// of a local slice element) — same shape the free-fn path relies on to
// satisfy the escape checker.
// Override tparams for a method skeleton: the impl's parameters when the
// method declares none of its own, else empty (use the method's own).
fn skel_xtparams(f: *const Func, itparams: *const Vec<str>, empty: *const Vec<str>) -> *const Vec<str> {
    if f.tparams.length() == 0 as u32 { return itparams; }
    return empty;
}
fn elaborate_method_into(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32,
                         idx: *const ProgIdx, modpath: *const Vec<str>, target: *const Vec<str>, itparams: *const Vec<str>, f: *const Func, funcs: *Vec<Tfunc>) {
    // A method on a generic struct with no parameters of its own is emitted
    // as a skeleton over the impl's type parameters (empty body, `struct-app`
    // self type); its monomorphic instances carry the real bodies.  The body
    // elaborates under the impl's module path so a bare `Pos` in `mod pos`
    // (the self type, a return type, a struct literal) resolves to `pos::Pos`.
    let no_tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let xtp = skel_xtparams(f, itparams, &no_tp);
    funcs.push(elaborate_fn(a, ar, g, gensym, idx, idx.pi_tbinds, modpath,
                            method_mangle(a, ar, target, f.name), f, none_ty(), xtp));
}

// Synthesise a trait default method for `target`: like an impl method but
// `Self` in the trait-decl signature resolves to the target type.  v1
// substitutes `Self` only in the signature (params / ret); a default body
// that annotates a local with `Self` is not yet handled (none in the
// catalog).
fn elaborate_default_into(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32,
                          idx: *const ProgIdx, modpath: *const Vec<str>, target: *const Vec<str>, f: *const Func, funcs: *Vec<Tfunc>) {
    let self_ty = ty_node(ar, Typ::TStruct(copy_strs(a, target)));
    funcs.push(elaborate_fn(a, ar, g, gensym, idx, idx.pi_tbinds, modpath,
                            method_mangle(a, ar, target, f.name), f, Option::Some(self_ty), &f.tparams));
}

fn emit_one_default(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx,
                    modpath: *const Vec<str>, target: *const Vec<str>, impl_methods: *const Vec<Func>, defaults: *const Vec<str>, f: *const Func, funcs: *Vec<Tfunc>) {
    if !name_in(defaults, f.name) { return; }
    if impl_has_method(impl_methods, f.name) { return; }
    elaborate_default_into(a, ar, g, gensym, idx, modpath, target, f, funcs);
}
fn emit_td_defaults(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx,
                    modpath: *const Vec<str>, target: *const Vec<str>, impl_methods: *const Vec<Func>, td: *const TraitDecl, funcs: *Vec<Tfunc>) {
    let n = td.trmethods.length();
    let ms = td.trmethods.as_slice();
    let mut j = 0 as u32;
    while j < n { emit_one_default(a, ar, g, gensym, idx, modpath, target, impl_methods, &td.trdefaults, &ms[j], funcs); j = j + 1 as u32; }
}
fn emit_impl_defaults(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx,
                      items: *const Vec<Item>, modpath: *const Vec<str>, ti: u32, target: *const Vec<str>, impl_methods: *const Vec<Func>, funcs: *Vec<Tfunc>) {
    let sl = items.as_slice();
    match sl[ti] {
        Item::Trait(td) => { emit_td_defaults(a, ar, g, gensym, idx, modpath, target, impl_methods, &td, funcs); }
        | _e => { }
    }
}

fn elaborate_impl(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32,
                  idx: *const ProgIdx, items: *const Vec<Item>, modpath: *const Vec<str>, ib: *const ImplBlock, funcs: *Vec<Tfunc>) {
    // A module-nested impl's target qualifies with its enclosing module path,
    // so `mod pos { impl Pos { fn zero } }` emits `pos__Pos__zero`.
    let target = path_concat(a, modpath, &ib.itarget);
    let n = ib.iitems.length();
    let sl = ib.iitems.as_slice();
    let mut i = 0 as u32;
    while i < n {
        elaborate_method_into(a, ar, g, gensym, idx, modpath, &target, &ib.itparams, &sl[i], funcs);
        i = i + 1 as u32;
    }
    // Synthesised trait defaults follow the impl's own methods (matching the
    // oracle's per-impl ordering).
    let tname = impl_trait_name(ib);
    if !str::eq(tname, "") {
        let ti = find_trait_idx(items, tname);
        if ti >= 0 as int { emit_impl_defaults(a, ar, g, gensym, idx, items, modpath, ti as u32, &target, &ib.iitems, funcs); }
    }
}

fn elaborate_impl_item(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32,
                       idx: *const ProgIdx, items: *const Vec<Item>, modpath: *const Vec<str>, it: *const Item, funcs: *Vec<Tfunc>) {
    match *it {
        Item::Impl(ib) => { elaborate_impl(a, ar, g, gensym, idx, items, modpath, &ib, funcs); }
        | Item::Module(md) => {
            // Module-nested impls flatten alongside top-level ones (second
            // pass), their targets qualified by the module path.
            let p2 = path_push(a, modpath, md.mname);
            let mn = md.mitems.length();
            let msl = md.mitems.as_slice();
            let mut k = 0 as u32;
            while k < mn { elaborate_impl_item(a, ar, g, gensym, idx, items, &p2, &msl[k], funcs); k = k + 1 as u32; }
        }
        | _e => { }
    }
}

// Collect every user-declared struct / enum name (recursing into modules)
// so signatures resolve them and the mono-instances footer lists them.
// Record each user type's bare name, plus — for a module-nested type — a
// `mod::Name` marker so module-relative resolution can recognise it (see
// resolve_named_ty).  The bare name keeps the existing last-segment membership
// checks working; the marker is an additive entry only the qualifier queries.
// `out` is the resolution registry (bare last segment for `mod::Name`
// resolution, plus the `mod::Name` marker for module-relative bare refs);
// `fout` is the footer registry, which lists only the canonical name (the
// qualified form for a module-nested type), matching the oracle footer.
fn push_type_name(a: Allocator, ar: *Arena, modpath: *const Vec<str>, name: str, out: *Vec<str>, fout: *Vec<str>) {
    if modpath.length() == 0 as u32 {
        out.push(name);
        fout.push(name);
        return;
    }
    let q = join_colons(a, ar, modpath, name);
    out.push(name);
    out.push(q);
    fout.push(q);
}
fn collect_type_names_one(a: Allocator, ar: *Arena, modpath: *const Vec<str>, it: *const Item, snames: *Vec<str>, enames: *Vec<str>, fstructs: *Vec<str>, fenums: *Vec<str>) {
    match *it {
        Item::Struct(sd) => { push_type_name(a, ar, modpath, sd.sname, snames, fstructs); }
        | Item::Enum(ed) => { push_type_name(a, ar, modpath, ed.ename, enames, fenums); }
        | Item::View(vd) => { push_type_name(a, ar, modpath, vd.vname, enames, fenums); }
        | Item::Module(md) => { collect_type_names(a, ar, &path_push(a, modpath, md.mname), &md.mitems, snames, enames, fstructs, fenums); }
        | _e => { }
    }
}

fn collect_type_names(a: Allocator, ar: *Arena, modpath: *const Vec<str>, items: *const Vec<Item>, snames: *Vec<str>, enames: *Vec<str>, fstructs: *Vec<str>, fenums: *Vec<str>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        collect_type_names_one(a, ar, modpath, &sl[i], snames, enames, fstructs, fenums);
        i = i + 1 as u32;
    }
}

// A `use foo::Bar;` where `foo::Bar` names a declared type registers the
// bare→qualified type alias `Bar -> foo::Bar`.  The loader has already
// expanded `use foo::*;` into per-name `pub use foo::Bar;`, so a plain 2+
// segment `use` path is exactly one importable name; its marker
// (`foo::Bar` in snames/enames) confirms it is a type, not a function.
fn record_use_alias(a: Allocator, ar: *Arena, path: *const Vec<str>, snames: *const Vec<str>, enames: *const Vec<str>,
                    fstructs: *const Vec<str>, fenums: *const Vec<str>, out: *Vec<TypeAlias>) {
    if path.length() < 2 as u32 { return; }
    let last = path_last(path);
    // A locally-declared root type shadows a `use`-imported one of the same
    // name (the oracle resolves a bare name to the same-file definition
    // first) — fstructs/fenums hold a root type under its bare name.
    if name_in(fstructs, last) { return; }
    if name_in(fenums, last) { return; }
    let init = path_init(a, path);
    let marker = join_colons(a, ar, &init, last);
    let is_e = name_in(enames, marker);
    if is_e || name_in(snames, marker) {
        out.push(TypeAlias { ta_name: last, ta_path: copy_strs(a, path), ta_is_enum: is_e });
    }
    return;
}
fn collect_type_aliases_one(a: Allocator, ar: *Arena, it: *const Item, snames: *const Vec<str>, enames: *const Vec<str>,
                            fstructs: *const Vec<str>, fenums: *const Vec<str>, out: *Vec<TypeAlias>) {
    match *it {
        Item::Use { path, is_wildcard, is_pub } => { record_use_alias(a, ar, &path, snames, enames, fstructs, fenums, out); }
        | Item::Module(md) => { collect_type_aliases(a, ar, &md.mitems, snames, enames, fstructs, fenums, out); }
        | _other => { }
    }
}
fn collect_type_aliases(a: Allocator, ar: *Arena, items: *const Vec<Item>, snames: *const Vec<str>, enames: *const Vec<str>,
                        fstructs: *const Vec<str>, fenums: *const Vec<str>, out: *Vec<TypeAlias>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        collect_type_aliases_one(a, ar, &sl[i], snames, enames, fstructs, fenums, out);
        i = i + 1 as u32;
    }
}

// Collect `extern struct` / `extern type` names (recursing into modules) so
// signatures resolve them to TExtStruct / TExtAlias.
// `@c_include("...")` / `extern const NAME: T;` / `extern var NAME: T;` —
// emitted verbatim in the C preamble.  They recurse into modules (the FFI
// hygiene rule keeps them inside a `pub mod raw`), and their names stay
// unmangled: the linker resolves them against real C symbols.
fn collect_ffi_decls_one(a: Allocator, ar: *Arena, sc: *const TyScope, it: *const Item,
                         cincludes: *Vec<str>, econsts: *Vec<FieldTy>, evars: *Vec<FieldTy>) {
    match *it {
        Item::CInclude { path, pos } => { cincludes.push(path); }
        | Item::ExternConst(ec) => { econsts.push(FieldTy { name: ec.ecname, ty: resolve_sig_ty(a, ar, sc, ec.ecty) }); }
        | Item::ExternVar(ev) => { evars.push(FieldTy { name: ev.evname, ty: resolve_sig_ty(a, ar, sc, ev.evty) }); }
        | Item::Module(md) => { collect_ffi_decls(a, ar, sc, &md.mitems, cincludes, econsts, evars); }
        | _e => { }
    }
}
fn collect_ffi_decls(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>,
                     cincludes: *Vec<str>, econsts: *Vec<FieldTy>, evars: *Vec<FieldTy>) {
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < items.length() {
        collect_ffi_decls_one(a, ar, sc, &sl[i], cincludes, econsts, evars);
        i = i + 1 as u32;
    }
    return;
}
fn collect_ext_types_one(it: *const Item, xstructs: *Vec<str>, xaliases: *Vec<str>) {
    match *it {
        Item::ExternStruct(es) => { xstructs.push(es.esname); }
        | Item::ExternType(xt) => { xaliases.push(xt.xtname); }
        | Item::Module(md) => { collect_ext_types(&md.mitems, xstructs, xaliases); }
        | _e => { }
    }
}
fn collect_ext_types(items: *const Vec<Item>, xstructs: *Vec<str>, xaliases: *Vec<str>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        collect_ext_types_one(&sl[i], xstructs, xaliases);
        i = i + 1 as u32;
    }
}

// Collect top-level integer constants with a literal value so array sizes
// `[T; N]` and other size expressions can fold `N`.
fn collect_int_consts_one(it: *const Item, out: *Vec<IntConst>) {
    match *it {
        Item::Const(c) => {
            match *c.kvalue {
                Expr::IntLit(n, _q) => { out.push(IntConst { ic_name: c.kname, ic_val: n }); }
                | _e => { }
            }
        }
        | Item::Module(md) => { collect_int_consts(&md.mitems, out); }
        | _e => { }
    }
}

fn collect_int_consts(items: *const Vec<Item>, out: *Vec<IntConst>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        collect_int_consts_one(&sl[i], out);
        i = i + 1 as u32;
    }
}

// Compile-time constant folding for `#define` emission (tp_consts).  Each
// `const NAME = <expr>` folds to an integer (bool -> 0/1); references to
// earlier consts resolve through the running value table (source order, which
// the common `const A = ...; const B = A * 2;` idiom follows).  Non-integer
// forms fall through to 0 — visibly off rather than crashing, matching
// array_size_of.  Ops mirror the C the value would compile to.
fn eval_binop_c(op: BinOp, l: int, r: int) -> int {
    return match op {
        BinOp::Add => l + r | BinOp::Sub => l - r | BinOp::Mul => l * r
        | BinOp::Div => if r == 0 as int { 0 as int } else { l / r }
        | BinOp::Mod => if r == 0 as int { 0 as int } else { l % r }
        | BinOp::BitAnd => l & r | BinOp::BitOr => { l | r } | BinOp::BitXor => l ^ r
        | BinOp::Shl => l << r | BinOp::Shr => l >> r
        | BinOp::And => if l != 0 as int && r != 0 as int { 1 as int } else { 0 as int }
        | BinOp::Or => if l != 0 as int || r != 0 as int { 1 as int } else { 0 as int }
        | BinOp::Lt => if l < r { 1 as int } else { 0 as int }
        | BinOp::Gt => if l > r { 1 as int } else { 0 as int }
        | BinOp::LtEq => if l <= r { 1 as int } else { 0 as int }
        | BinOp::GtEq => if l >= r { 1 as int } else { 0 as int }
        | BinOp::EqEq => if l == r { 1 as int } else { 0 as int }
        | BinOp::NotEq => if l != r { 1 as int } else { 0 as int }
        | _o => 0 as int
    };
}
fn eval_const_c(e: *const Expr, table: *const Vec<IntConst>) -> int {
    return match *e {
        Expr::IntLit(n, _q) => n
        | Expr::BoolLit(b, _q) => if b { 1 as int } else { 0 as int }
        | Expr::Var(nm, _q) => iconst_lookup(table, nm)
        | Expr::Neg(x, _q) => 0 as int - eval_const_c(x, table)
        | Expr::BitNot(x, _q) => 0 as int - eval_const_c(x, table) - 1 as int
        | Expr::Not(x, _q) => if eval_const_c(x, table) == 0 as int { 1 as int } else { 0 as int }
        | Expr::BinOp(op, l, r, _q) => eval_binop_c(op, eval_const_c(l, table), eval_const_c(r, table))
        | _o => 0 as int
    };
}
fn int_to_str_c(a: Allocator, ar: *Arena, n: int) -> str {
    let mut sb = StringBuilder::with_capacity(a, 16 as u32);
    sb.push_int(n);
    return str::from_slice(ar, sb.as_slice());
}
// Fold every user `const` (recursing into modules, extending the mangle path)
// into a `(mangled-name, literal)` pair for `#define` emission, threading the
// running value table so later consts can reference earlier ones.
fn collect_tp_consts(a: Allocator, ar: *Arena, items: *const Vec<Item>, path: *const Vec<str>, table: *Vec<IntConst>, out: *Vec<StrPair>) {
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < items.length() {
        match sl[i] {
            Item::Const(c) => {
                let v = eval_const_c(c.kvalue, table);
                out.push(StrPair { a: mangle_path(a, ar, path, c.kname), b: int_to_str_c(a, ar, v) });
                table.push(IntConst { ic_name: c.kname, ic_val: v });
            }
            | Item::Module(md) => {
                let mut sub: Vec<str> = copy_strs(a, path);
                sub.push(md.mname);
                collect_tp_consts(a, ar, &md.mitems, &sub, table, out);
            }
            | _o => {}
        }
        i = i + 1 as u32;
    }
}

// Build the struct field-layout index: a flat list of (owning struct path,
// field name, resolved field type).  Field types resolve through a
// name-scope since they may reference other structs / enums.
fn push_one_field(a: Allocator, ar: *Arena, sc: *const TyScope, spath: *const Vec<str>,
                  fd: *const FieldDef, out: *Vec<StructField>) {
    out.push(StructField { sf_path: copy_strs(a, spath), sf_name: fd.name, sf_ty: resolve_sig_ty(a, ar, sc, fd.ty) });
}

fn push_struct_fields(a: Allocator, ar: *Arena, sc: *const TyScope, spath: *const Vec<str>,
                      fields: *const Vec<FieldDef>, out: *Vec<StructField>) {
    let n = fields.length();
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < n {
        push_one_field(a, ar, sc, spath, &sl[i], out);
        i = i + 1 as u32;
    }
}

// Skeleton fields of the generic prelude structs, registered in the struct
// index so construction infers the instance and a parameter's field / index
// accesses resolve.  `ptr` is `*const T`, `len` a `u32`.
fn push_prelude_field(a: Allocator, sname: str, fname: str, fty: *const Typ, out: *Vec<StructField>) {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(sname);
    out.push(StructField { sf_path: path, sf_name: fname, sf_ty: fty });
}
fn prelude_struct_info(a: Allocator, ar: *Arena, out: *Vec<StructField>) {
    push_prelude_field(a, "Slice", "ptr", ty_node(ar, Typ::TConstPtr(ty_node(ar, Typ::TVar("T")))), out);
    push_prelude_field(a, "Slice", "len", t_u32(ar), out);
    push_prelude_field(a, "Range", "lo", ty_node(ar, Typ::TVar("T")), out);
    push_prelude_field(a, "Range", "hi", ty_node(ar, Typ::TVar("T")), out);
    push_prelude_field(a, "RangeInclusive", "lo", ty_node(ar, Typ::TVar("T")), out);
    push_prelude_field(a, "RangeInclusive", "hi", ty_node(ar, Typ::TVar("T")), out);
    push_prelude_field(a, "Vec", "ptr", ty_node(ar, Typ::TOwnPtr(ty_node(ar, Typ::TVar("T")))), out);
    push_prelude_field(a, "Vec", "count", t_u32(ar), out);
    push_prelude_field(a, "Vec", "cap", t_u32(ar), out);
    push_prelude_field(a, "Vec", "alloc", ty_node(ar, Typ::TStruct(allocator_path(a))), out);
    push_prelude_field(a, "VecIter", "data", ty_node(ar, Typ::TConstPtr(ty_node(ar, Typ::TVar("T")))), out);
    push_prelude_field(a, "VecIter", "len", t_u32(ar), out);
    push_prelude_field(a, "VecIter", "pos", t_u32(ar), out);
    // Allocator seam fields — needed by the synthesised `<Struct>__drop`
    // bodies, which call `self.alloc.free_fn(self.alloc.state, ..)` directly
    // (DR-030 drop synthesis; the only direct field-access on Allocator).
    let cvoid_ptr = ty_node(ar, Typ::TPtr(ty_node(ar, Typ::TCVoid)));
    push_prelude_field(a, "Allocator", "state", cvoid_ptr, out);
    let mut afp: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    afp.push(ty_node(ar, Typ::TPtr(ty_node(ar, Typ::TCVoid))));
    afp.push(t_u32(ar));
    push_prelude_field(a, "Allocator", "alloc_fn", ty_node(ar, Typ::TFnPtr { params: afp, ret: Option::Some(ty_node(ar, Typ::TPtr(ty_node(ar, Typ::TCVoid)))) }), out);
    let mut ffp: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    ffp.push(ty_node(ar, Typ::TPtr(ty_node(ar, Typ::TCVoid))));
    ffp.push(ty_node(ar, Typ::TPtr(ty_node(ar, Typ::TCVoid))));
    ffp.push(t_u32(ar));
    let none_fret: Option<*const Typ> = Option::None;
    push_prelude_field(a, "Allocator", "free_fn", ty_node(ar, Typ::TFnPtr { params: ffp, ret: none_fret }), out);
    // DR-026 lazy iterator adapters: `inner: I` plus the per-adapter state.
    push_prelude_field(a, "Map", "inner", ty_node(ar, Typ::TVar("I")), out);
    push_prelude_field(a, "Map", "f", ty_node(ar, Typ::TVar("F")), out);
    push_prelude_field(a, "Filter", "inner", ty_node(ar, Typ::TVar("I")), out);
    push_prelude_field(a, "Filter", "p", ty_node(ar, Typ::TVar("P")), out);
    push_prelude_field(a, "Take", "inner", ty_node(ar, Typ::TVar("I")), out);
    push_prelude_field(a, "Take", "remaining", t_u32(ar), out);
    push_prelude_field(a, "Enumerate", "inner", ty_node(ar, Typ::TVar("I")), out);
    push_prelude_field(a, "Enumerate", "idx", t_u32(ar), out);
    // DR-007 HashMap / Slot<K,V> open-addressing table.
    push_prelude_field(a, "Slot", "state", t_u8(ar), out);
    push_prelude_field(a, "Slot", "hash", t_u32(ar), out);
    push_prelude_field(a, "Slot", "key", ty_node(ar, Typ::TVar("K")), out);
    push_prelude_field(a, "Slot", "value", ty_node(ar, Typ::TVar("V")), out);
    push_prelude_field(a, "HashMap", "slots", ty_node(ar, Typ::TOwnPtr(slot_kv_ty(a, ar))), out);
    push_prelude_field(a, "HashMap", "count", t_u32(ar), out);
    push_prelude_field(a, "HashMap", "cap", t_u32(ar), out);
    push_prelude_field(a, "HashMap", "alloc", ty_node(ar, Typ::TStruct(allocator_path(a))), out);
    push_prelude_field(a, "HashMapIter", "data", ty_node(ar, Typ::TConstPtr(slot_kv_ty(a, ar))), out);
    push_prelude_field(a, "HashMapIter", "len", t_u32(ar), out);
    push_prelude_field(a, "HashMapIter", "pos", t_u32(ar), out);
}
fn slot_kv_ty(a: Allocator, ar: *Arena) -> *const Typ {
    let mut sp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    sp.push("Slot");
    let mut sa: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    sa.push(ty_node(ar, Typ::TVar("K")));
    sa.push(ty_node(ar, Typ::TVar("V")));
    return ty_node(ar, Typ::TStructApp { path: sp, args: sa });
}

// A copy of the scope with a different tparam list — used to resolve a
// generic type's own field/variant types (where its tparams are in scope).
// A scope with its module path set, so type references collected / elaborated
// inside `mod m { ... }` resolve module-relative (a bare `Pos` declared in `m`
// resolves to `m::Pos`).  Used by the collectors + the method-body elaborator.
fn scope_with_modpath(base: *const TyScope, modpath: *const Vec<str>) -> TyScope {
    return TyScope {
        sc_structs: base.sc_structs, sc_enums: base.sc_enums, sc_tparams: base.sc_tparams,
        sc_iconsts: base.sc_iconsts, sc_sinfo: base.sc_sinfo, sc_etags: base.sc_etags,
        sc_efields: base.sc_efields, sc_methods: base.sc_methods,
        sc_mono_structs: base.sc_mono_structs, sc_mono_sargs: base.sc_mono_sargs, sc_mono_enums: base.sc_mono_enums, sc_mono_eargs: base.sc_mono_eargs,
        sc_mono_fields: base.sc_mono_fields, sc_mono_efields: base.sc_mono_efields,
        sc_tbinds: base.sc_tbinds, sc_genfns: base.sc_genfns,
        sc_genjobs: base.sc_genjobs, sc_geninsts: base.sc_geninsts, sc_etps: base.sc_etps, sc_stps: base.sc_stps, sc_assoc: base.sc_assoc, sc_lifted: base.sc_lifted, sc_gensym: base.sc_gensym, sc_modpath: modpath,
        sc_ret: base.sc_ret,
        sc_self: base.sc_self,
        sc_gsigs: base.sc_gsigs,
        sc_xstructs: base.sc_xstructs, sc_xaliases: base.sc_xaliases, sc_taliases: base.sc_taliases,
        sc_is_main: base.sc_is_main, sc_err: base.sc_err, sc_srcnames: base.sc_srcnames, sc_srcbase: base.sc_srcbase, sc_binds: base.sc_binds, sc_bindbase: base.sc_bindbase,
    };
}
// A scope with the full struct-field skeleton in place, used for a second
// field-type resolution pass that registers generic-instance fields (a
// `Vec<TypeAlias>` struct field) into the shared mono-fields table so tparam
// recovery works regardless of construction order.
fn scope_with_sinfo(base: *const TyScope, sinfo: *const Vec<StructField>) -> TyScope {
    return TyScope {
        sc_structs: base.sc_structs, sc_enums: base.sc_enums, sc_tparams: base.sc_tparams,
        sc_iconsts: base.sc_iconsts, sc_sinfo: sinfo, sc_etags: base.sc_etags,
        sc_efields: base.sc_efields, sc_methods: base.sc_methods,
        sc_mono_structs: base.sc_mono_structs, sc_mono_sargs: base.sc_mono_sargs, sc_mono_enums: base.sc_mono_enums, sc_mono_eargs: base.sc_mono_eargs,
        sc_mono_fields: base.sc_mono_fields, sc_mono_efields: base.sc_mono_efields,
        sc_tbinds: base.sc_tbinds, sc_genfns: base.sc_genfns,
        sc_genjobs: base.sc_genjobs, sc_geninsts: base.sc_geninsts, sc_etps: base.sc_etps, sc_stps: base.sc_stps, sc_assoc: base.sc_assoc, sc_lifted: base.sc_lifted, sc_gensym: base.sc_gensym, sc_modpath: base.sc_modpath,
        sc_ret: base.sc_ret,
        sc_self: base.sc_self,
        sc_gsigs: base.sc_gsigs,
        sc_xstructs: base.sc_xstructs, sc_xaliases: base.sc_xaliases, sc_taliases: base.sc_taliases,
        sc_is_main: base.sc_is_main, sc_err: base.sc_err, sc_srcnames: base.sc_srcnames, sc_srcbase: base.sc_srcbase, sc_binds: base.sc_binds, sc_bindbase: base.sc_bindbase,
    };
}
fn scope_with_tparams(base: *const TyScope, tparams: *const Vec<str>) -> TyScope {
    return TyScope {
        sc_structs: base.sc_structs, sc_enums: base.sc_enums, sc_tparams: tparams,
        sc_iconsts: base.sc_iconsts, sc_sinfo: base.sc_sinfo, sc_etags: base.sc_etags,
        sc_efields: base.sc_efields, sc_methods: base.sc_methods,
        sc_mono_structs: base.sc_mono_structs, sc_mono_sargs: base.sc_mono_sargs, sc_mono_enums: base.sc_mono_enums, sc_mono_eargs: base.sc_mono_eargs,
        sc_mono_fields: base.sc_mono_fields, sc_mono_efields: base.sc_mono_efields,
        sc_tbinds: base.sc_tbinds, sc_genfns: base.sc_genfns,
        sc_genjobs: base.sc_genjobs, sc_geninsts: base.sc_geninsts, sc_etps: base.sc_etps, sc_stps: base.sc_stps, sc_assoc: base.sc_assoc, sc_lifted: base.sc_lifted, sc_gensym: base.sc_gensym, sc_modpath: base.sc_modpath,
        sc_ret: base.sc_ret,
        sc_self: base.sc_self,
        sc_gsigs: base.sc_gsigs,
        sc_xstructs: base.sc_xstructs, sc_xaliases: base.sc_xaliases, sc_taliases: base.sc_taliases,
        sc_is_main: base.sc_is_main, sc_err: base.sc_err, sc_srcnames: base.sc_srcnames, sc_srcbase: base.sc_srcbase, sc_binds: base.sc_binds, sc_bindbase: base.sc_bindbase,
    };
}

// A copy of the scope with a tparam list AND concrete bindings for them, so a
// type mentioning those tparams (a generic-struct method's return) resolves to
// the monomorphic instance directly (no post-hoc substitution).
fn scope_with_tbinds(base: *const TyScope, tparams: *const Vec<str>, tbinds: *const Vec<TVarBind>) -> TyScope {
    return TyScope {
        sc_structs: base.sc_structs, sc_enums: base.sc_enums, sc_tparams: tparams,
        sc_iconsts: base.sc_iconsts, sc_sinfo: base.sc_sinfo, sc_etags: base.sc_etags,
        sc_efields: base.sc_efields, sc_methods: base.sc_methods,
        sc_mono_structs: base.sc_mono_structs, sc_mono_sargs: base.sc_mono_sargs, sc_mono_enums: base.sc_mono_enums, sc_mono_eargs: base.sc_mono_eargs,
        sc_mono_fields: base.sc_mono_fields, sc_mono_efields: base.sc_mono_efields,
        sc_tbinds: tbinds, sc_genfns: base.sc_genfns,
        sc_genjobs: base.sc_genjobs, sc_geninsts: base.sc_geninsts, sc_etps: base.sc_etps, sc_stps: base.sc_stps, sc_assoc: base.sc_assoc, sc_lifted: base.sc_lifted, sc_gensym: base.sc_gensym, sc_modpath: base.sc_modpath,
        sc_ret: base.sc_ret,
        sc_self: base.sc_self,
        sc_gsigs: base.sc_gsigs,
        sc_xstructs: base.sc_xstructs, sc_xaliases: base.sc_xaliases, sc_taliases: base.sc_taliases,
        sc_is_main: base.sc_is_main, sc_err: base.sc_err, sc_srcnames: base.sc_srcnames, sc_srcbase: base.sc_srcbase, sc_binds: base.sc_binds, sc_bindbase: base.sc_bindbase,
    };
}

// A copy of the scope carrying the enclosing fn's resolved return type.
fn scope_with_ret(base: *const TyScope, ret: Option<*const Typ>) -> TyScope {
    return TyScope {
        sc_structs: base.sc_structs, sc_enums: base.sc_enums, sc_tparams: base.sc_tparams,
        sc_iconsts: base.sc_iconsts, sc_sinfo: base.sc_sinfo, sc_etags: base.sc_etags,
        sc_efields: base.sc_efields, sc_methods: base.sc_methods,
        sc_mono_structs: base.sc_mono_structs, sc_mono_sargs: base.sc_mono_sargs, sc_mono_enums: base.sc_mono_enums, sc_mono_eargs: base.sc_mono_eargs,
        sc_mono_fields: base.sc_mono_fields, sc_mono_efields: base.sc_mono_efields,
        sc_tbinds: base.sc_tbinds, sc_genfns: base.sc_genfns,
        sc_genjobs: base.sc_genjobs, sc_geninsts: base.sc_geninsts, sc_etps: base.sc_etps, sc_stps: base.sc_stps, sc_assoc: base.sc_assoc, sc_lifted: base.sc_lifted, sc_gensym: base.sc_gensym, sc_modpath: base.sc_modpath,
        sc_ret: ret,
        sc_self: base.sc_self,
        sc_gsigs: base.sc_gsigs,
        sc_xstructs: base.sc_xstructs, sc_xaliases: base.sc_xaliases, sc_taliases: base.sc_taliases,
        sc_is_main: base.sc_is_main, sc_err: base.sc_err, sc_srcnames: base.sc_srcnames, sc_srcbase: base.sc_srcbase, sc_binds: base.sc_binds, sc_bindbase: base.sc_bindbase,
    };
}

fn collect_struct_info_one(a: Allocator, ar: *Arena, sc: *const TyScope, modpath: *const Vec<str>, it: *const Item, out: *Vec<StructField>) {
    match *it {
        Item::Struct(sd) => {
            let msc = scope_with_modpath(sc, modpath);
            let sc2 = scope_with_tparams(&msc, &sd.stparams);
            let spath = path_push(a, modpath, sd.sname);
            push_struct_fields(a, ar, &sc2, &spath, &sd.sfields, out);
        }
        | Item::Module(md) => { collect_struct_info(a, ar, sc, &path_push(a, modpath, md.mname), &md.mitems, out); }
        | _e => { }
    }
}

fn collect_struct_info(a: Allocator, ar: *Arena, sc: *const TyScope, modpath: *const Vec<str>, items: *const Vec<Item>, out: *Vec<StructField>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        collect_struct_info_one(a, ar, sc, modpath, &sl[i], out);
        i = i + 1 as u32;
    }
}

// Build the enum index: a variant→tag list plus a flat per-variant-field
// list (tuple payloads named `_0`, `_1`, …; struct payloads by declared
// name).  Tag is the variant's declaration order.
fn tuple_field_name(a: Allocator, ar: *Arena, k: u32) -> str {
    let mut sb = StringBuilder::with_capacity(a, 8 as u32);
    sb.push_str("_");
    sb.push_int(k as int);
    return str::from_slice(ar, sb.as_slice());
}

fn push_etag(a: Allocator, epath: *const Vec<str>, vname: str, tag: int, out: *Vec<EnumVariantTag>) {
    out.push(EnumVariantTag { et_path: copy_strs(a, epath), et_name: vname, et_tag: tag, et_is_struct: false });
}
fn push_etag_kind(a: Allocator, epath: *const Vec<str>, vname: str, tag: int, kind: *const VariantKind, out: *Vec<EnumVariantTag>) {
    let is_struct = match *kind {
        VariantKind::VStruct(_fds) => true
        | _k => false
    };
    out.push(EnumVariantTag { et_path: copy_strs(a, epath), et_name: vname, et_tag: tag, et_is_struct: is_struct });
}

fn push_efield(a: Allocator, epath: *const Vec<str>, vname: str, fname: str, ty: *const Typ, out: *Vec<EnumFieldE>) {
    out.push(EnumFieldE { ef_path: copy_strs(a, epath), ef_variant: vname, ef_name: fname, ef_ty: ty });
}

fn push_variant_fields(a: Allocator, ar: *Arena, sc: *const TyScope, epath: *const Vec<str>, vname: str,
                       vk: *const VariantKind, efields: *Vec<EnumFieldE>) {
    match *vk {
        VariantKind::VUnit => { }
        | VariantKind::VTuple(tys) => {
            let nt = tys.length();
            let tsl = tys.as_slice();
            let mut kt = 0 as u32;
            while kt < nt {
                push_efield(a, epath, vname, tuple_field_name(a, ar, kt), resolve_sig_ty(a, ar, sc, tsl[kt]), efields);
                kt = kt + 1 as u32;
            }
        }
        | VariantKind::VStruct(fds) => {
            let ns = fds.length();
            let fsl = fds.as_slice();
            let mut ks = 0 as u32;
            while ks < ns {
                push_efield(a, epath, vname, fsl[ks].name, resolve_sig_ty(a, ar, sc, fsl[ks].ty), efields);
                ks = ks + 1 as u32;
            }
        }
    }
}

fn collect_one_variant(a: Allocator, ar: *Arena, sc: *const TyScope, epath: *const Vec<str>, ev: *const EnumVariant,
                       tag: int, etags: *Vec<EnumVariantTag>, efields: *Vec<EnumFieldE>) {
    push_etag_kind(a, epath, ev.vname, tag, &ev.vkind, etags);
    push_variant_fields(a, ar, sc, epath, ev.vname, &ev.vkind, efields);
}

fn collect_enum_variants(a: Allocator, ar: *Arena, sc: *const TyScope, epath: *const Vec<str>,
                         variants: *const Vec<EnumVariant>, etags: *Vec<EnumVariantTag>, efields: *Vec<EnumFieldE>) {
    let n = variants.length();
    let sl = variants.as_slice();
    let mut i = 0 as u32;
    while i < n {
        collect_one_variant(a, ar, sc, epath, &sl[i], i as int, etags, efields);
        i = i + 1 as u32;
    }
}

fn collect_enum_info_one(a: Allocator, ar: *Arena, sc: *const TyScope, modpath: *const Vec<str>, it: *const Item,
                         etags: *Vec<EnumVariantTag>, efields: *Vec<EnumFieldE>) {
    match *it {
        Item::Enum(ed) => {
            let msc = scope_with_modpath(sc, modpath);
            let sc2 = scope_with_tparams(&msc, &ed.etparams);
            let epath = path_push(a, modpath, ed.ename);
            collect_enum_variants(a, ar, &sc2, &epath, &ed.evariants, etags, efields);
        }
        | Item::View(vd) => { let vpath = path_push(a, modpath, vd.vname); collect_view_variants(a, ar, sc, &vpath, &vd.vcases, etags, efields); }
        | Item::Module(md) => { collect_enum_info(a, ar, sc, &path_push(a, modpath, md.mname), &md.mitems, etags, efields); }
        | _e => { }
    }
}

// Register the prelude generic enums' variants so `Option::`/`Result::`
// constructors and patterns resolve their tags + payload tparams.
fn prelude_enum_variants(a: Allocator, ar: *Arena, etags: *Vec<EnumVariantTag>, efields: *Vec<EnumFieldE>) {
    let opt_path = single_str(a, "Option");
    let res_path = single_str(a, "Result");
    push_etag(a, &opt_path, "None", 0 as int, etags);
    push_etag(a, &opt_path, "Some", 1 as int, etags);
    push_efield(a, &opt_path, "Some", "_0", ty_node(ar, Typ::TVar("T")), efields);
    push_etag(a, &res_path, "Ok", 0 as int, etags);
    push_etag(a, &res_path, "Err", 1 as int, etags);
    push_efield(a, &res_path, "Ok", "_0", ty_node(ar, Typ::TVar("T")), efields);
    push_efield(a, &res_path, "Err", "_0", ty_node(ar, Typ::TVar("E")), efields);
}

fn collect_enum_info(a: Allocator, ar: *Arena, sc: *const TyScope, modpath: *const Vec<str>, items: *const Vec<Item>,
                     etags: *Vec<EnumVariantTag>, efields: *Vec<EnumFieldE>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        collect_enum_info_one(a, ar, sc, modpath, &sl[i], etags, efields);
        i = i + 1 as u32;
    }
}

// Build the method index from every impl block (recursing into modules).
fn is_ptr_ann(ann: *const TypeAnn) -> bool {
    return match *ann {
        TypeAnn::TyPtr(_t) => true
        | TypeAnn::TyConstPtr(_t) => true
        | TypeAnn::TyOwnPtr(_t) => true
        | _e => false
    };
}
fn method_has_self(f: *const Func) -> bool {
    if f.params.length() == 0 as u32 { return false; }
    let sl = f.params.as_slice();
    return str::eq(sl[0 as u32].pname, "self");
}
fn method_self_ptr(f: *const Func) -> bool {
    if !method_has_self(f) { return false; }
    let sl = f.params.as_slice();
    return is_ptr_ann(sl[0 as u32].pty);
}
fn is_const_ptr_ann(ann: *const TypeAnn) -> bool {
    return match *ann {
        TypeAnn::TyConstPtr(_t) => true
        | _e => false
    };
}
fn method_self_const(f: *const Func) -> bool {
    if !method_has_self(f) { return false; }
    let sl = f.params.as_slice();
    return is_const_ptr_ann(sl[0 as u32].pty);
}
fn push_one_method(a: Allocator, ar: *Arena, sc: *const TyScope, target: *const Vec<str>, itparams: *const Vec<str>,
                   f: *const Func, impl_idx: u32, meth_idx: u32, out: *Vec<MethodInfo>) {
    // A method on a generic struct with no parameters of its own carries the
    // impl's type parameters, bound at the call site from the receiver
    // instance.  A method-generic method keeps its own.
    let struct_gen = itparams.length() > 0 as u32 && f.tparams.length() == 0 as u32;
    let tparams = if struct_gen { copy_strs(a, itparams) } else { copy_strs(a, &f.tparams) };
    // A generic-struct method's return mentions the impl tparams (out of scope
    // here); the call site resolves it under the receiver's bindings, so leave
    // it unresolved rather than mangle a bogus `Pair_B_A` instance.
    let mret = if struct_gen { none_ty() } else { resolve_sig_ret(a, ar, sc, f.ret_ty) };
    out.push(MethodInfo {
        mi_path: copy_strs(a, target), mi_name: f.name,
        mi_mangled: method_mangle(a, ar, target, f.name),
        mi_ret: mret,
        mi_has_self: method_has_self(f), mi_self_ptr: method_self_ptr(f), mi_self_const: method_self_const(f),
        mi_tparams: tparams, mi_params: copy_param_anns(a, &f.params),
        mi_ret_ann: f.ret_ty, mi_impl_idx: impl_idx, mi_meth_idx: meth_idx, mi_prelude: false,
        mi_struct_gen: struct_gen,
    });
}
fn collect_methods_impl(a: Allocator, ar: *Arena, sc: *const TyScope, target: *const Vec<str>, itparams: *const Vec<str>,
                        methods: *const Vec<Func>, impl_idx: u32, out: *Vec<MethodInfo>) {
    let n = methods.length();
    let sl = methods.as_slice();
    let mut i = 0 as u32;
    while i < n { push_one_method(a, ar, sc, target, itparams, &sl[i], impl_idx, i, out); i = i + 1 as u32; }
}
// `top_idx` is the index of the enclosing top-level item, so a generic
// method's body can be re-derived in the drain.  Module-nested impls pass
// the module's own top index (a nested generic method is out of scope for
// v1, matching the top-level-only generic-fn registry).
fn collect_method_info_one(a: Allocator, ar: *Arena, sc: *const TyScope, modpath: *const Vec<str>, it: *const Item, top_idx: u32, out: *Vec<MethodInfo>) {
    match *it {
        Item::Impl(ib) => {
            let msc = scope_with_modpath(sc, modpath);
            let target = path_concat(a, modpath, &ib.itarget);
            collect_methods_impl(a, ar, &msc, &target, &ib.itparams, &ib.iitems, top_idx, out);
        }
        | Item::Module(md) => { collect_method_info_nested(a, ar, sc, &path_push(a, modpath, md.mname), &md.mitems, top_idx, out); }
        | _e => { }
    }
}
fn collect_method_info_nested(a: Allocator, ar: *Arena, sc: *const TyScope, modpath: *const Vec<str>, items: *const Vec<Item>, top_idx: u32, out: *Vec<MethodInfo>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n { collect_method_info_one(a, ar, sc, modpath, &sl[i], top_idx, out); i = i + 1 as u32; }
}
fn collect_method_info(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>, out: *Vec<MethodInfo>) {
    let empty: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n { collect_method_info_one(a, ar, sc, &empty, &sl[i], i, out); i = i + 1 as u32; }
}

// ===== Prelude methods =====
//
// Generic methods on the prelude structs (Allocator / Vec / ...).  Their
// bodies are prelude-injected (filtered out of the `--user-only` dump), so a
// call only resolves + mangles + types — no instance is queued to elaborate.
fn ann_struct(a: Allocator, ar: *Arena, name: str) -> *const TypeAnn {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(name);
    let args: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    return ann_node(ar, TypeAnn::TyStruct { path: path, args: args });
}
fn ann_own_t(a: Allocator, ar: *Arena) -> *const TypeAnn {
    return ann_node(ar, TypeAnn::TyOwnPtr(ann_struct(a, ar, "T")));
}
fn ann_u32(ar: *Arena) -> *const TypeAnn {
    return ann_node(ar, TypeAnn::TyInt { is_signed: false, width: IntWidth::W32 });
}
// `Name<Arg>` as an annotation — a generic application over a single tparam
// name (`Option<T>`, `Slice<T>`, `VecIter<T>`).
fn ann_app1(a: Allocator, ar: *Arena, name: str, argname: str) -> *const TypeAnn {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(name);
    let mut args: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    args.push(ann_struct(a, ar, argname));
    return ann_node(ar, TypeAnn::TyStruct { path: path, args: args });
}
// `name<tp1, tp2, ...>` — a generic application over bare tparam names.
fn ann_app_tps(a: Allocator, ar: *Arena, name: str, tps: *const Vec<str>) -> *const TypeAnn {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(name);
    let mut args: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    let n = tps.length();
    let sl = tps.as_slice();
    let mut i = 0 as u32;
    while i < n { args.push(ann_struct(a, ar, sl[i])); i = i + 1 as u32; }
    return ann_node(ar, TypeAnn::TyStruct { path: path, args: args });
}
// A two-segment associated-projection annotation, e.g. `F::Output`.
fn ann_proj(a: Allocator, ar: *Arena, head: str, assoc: str) -> *const TypeAnn {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(head);
    path.push(assoc);
    let args: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    return ann_node(ar, TypeAnn::TyStruct { path: path, args: args });
}
// `Option<inner>` wrapping an arbitrary annotation.
fn ann_opt_of(a: Allocator, ar: *Arena, inner: *const TypeAnn) -> *const TypeAnn {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push("Option");
    let mut args: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    args.push(inner);
    return ann_node(ar, TypeAnn::TyStruct { path: path, args: args });
}
fn one_tparam(a: Allocator) -> Vec<str> {
    let mut t: Vec<str> = Vec::with_capacity(a, 8 as u32);
    t.push("T");
    return t;
}
// A method-generic prelude method with an explicit tparam list and self
// shape — used by the DR-026 iterator adapter default methods (`.map`,
// `.take`, ...), which bind the receiver's tparam plus their own from the
// call site and return an adapter instance.
fn push_prelude_gen_method(a: Allocator, ar: *Arena, target: str, name: str, tparams: Vec<str>,
                           params: Vec<*const TypeAnn>, ret_ann: Option<*const TypeAnn>,
                           self_ptr: bool, self_const: bool, out: *Vec<MethodInfo>) {
    let mut tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    tp.push(target);
    out.push(MethodInfo {
        mi_path: tp, mi_name: name,
        mi_mangled: str2(a, ar, str2(a, ar, target, "__"), name),
        mi_ret: none_ty(), mi_has_self: true, mi_self_ptr: self_ptr, mi_self_const: self_const,
        mi_tparams: tparams, mi_params: params, mi_ret_ann: ret_ann,
        mi_impl_idx: 0 as u32, mi_meth_idx: 0 as u32, mi_prelude: true,
        // Adapter methods bind the receiver's tparam by field-recovery (like a
        // struct-gen method) plus their own from the args.
        mi_struct_gen: true,
    });
}
// An iterator adapter default method on receiver `recv`: binds the receiver's
// own tparams by field-recovery plus an optional `extra_tp` (the callable's
// type) from the argument, returning `Adapter<Self, extra_tp?>`.  Models the
// DR-026 Iterator default methods (`.map`/`.filter`/`.take`/`.enumerate`),
// available on every iterator so chains like `.filter(..).map(..)` compose.
fn register_adapter(a: Allocator, ar: *Arena, recv: str, method: str, adapter: str,
                    extra_tp: str, arg_ann: Option<*const TypeAnn>, out: *Vec<MethodInfo>) {
    let mut recv_tps: Vec<str> = Vec::with_capacity(a, 8 as u32);
    prelude_struct_tparams(recv, &recv_tps);
    let mut mtps = copy_strs(a, &recv_tps);
    let has_extra = !str::eq(extra_tp, "");
    if has_extra { mtps.push(extra_tp); }
    let mut params: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    params.push(ann_app_tps(a, ar, recv, &recv_tps));
    match arg_ann { Option::Some(aa) => params.push(aa) | Option::None => {} }
    let mut radargs: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    radargs.push(ann_app_tps(a, ar, recv, &recv_tps));
    if has_extra { radargs.push(ann_struct(a, ar, extra_tp)); }
    let mut apath: Vec<str> = Vec::with_capacity(a, 8 as u32);
    apath.push(adapter);
    let ret = ann_node(ar, TypeAnn::TyStruct { path: apath, args: radargs });
    push_prelude_gen_method(a, ar, recv, method, mtps, params, Option::Some(ret), false, false, out);
}
// `fold<Acc, G>(self, init: Acc, g: G) -> Acc` — a consuming terminal.  Acc /
// G bind from the args (the adapter-method unify path), the return is `Acc`.
fn register_fold(a: Allocator, ar: *Arena, recv: str, out: *Vec<MethodInfo>) {
    let mut recv_tps: Vec<str> = Vec::with_capacity(a, 8 as u32);
    prelude_struct_tparams(recv, &recv_tps);
    let mut mtps = copy_strs(a, &recv_tps);
    mtps.push("Acc");
    mtps.push("G");
    let mut params: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    params.push(ann_app_tps(a, ar, recv, &recv_tps));
    params.push(ann_struct(a, ar, "Acc"));
    params.push(ann_struct(a, ar, "G"));
    push_prelude_gen_method(a, ar, recv, "fold", mtps, params, Option::Some(ann_struct(a, ar, "Acc")), false, false, out);
}
// The `Iterator::Item` annotation for a prelude iterator (mirrors the assoc
// bindings) — used by `collect`'s `Vec<Self::Item>` return.
fn iter_item_ann(a: Allocator, ar: *Arena, recv: str) -> *const TypeAnn {
    if str::eq(recv, "VecIter") { return ann_struct(a, ar, "T"); }
    if str::eq(recv, "Map") { return ann_proj(a, ar, "F", "Output"); }
    if str::eq(recv, "Filter") { return ann_proj(a, ar, "I", "Item"); }
    if str::eq(recv, "Take") { return ann_proj(a, ar, "I", "Item"); }
    let mut tup: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    tup.push(ann_u32(ar));
    tup.push(ann_proj(a, ar, "I", "Item"));
    return ann_node(ar, TypeAnn::TyTuple(tup));
}
// `collect<>(self, a: Allocator) -> Vec<Self::Item>` — a consuming terminal
// draining the iterator into a fresh Vec.
fn register_collect(a: Allocator, ar: *Arena, recv: str, out: *Vec<MethodInfo>) {
    let mut recv_tps: Vec<str> = Vec::with_capacity(a, 8 as u32);
    prelude_struct_tparams(recv, &recv_tps);
    let mtps = copy_strs(a, &recv_tps);
    let mut params: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    params.push(ann_app_tps(a, ar, recv, &recv_tps));
    params.push(ann_struct(a, ar, "Allocator"));
    let mut vargs: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    vargs.push(iter_item_ann(a, ar, recv));
    let mut vpath: Vec<str> = Vec::with_capacity(a, 8 as u32);
    vpath.push("Vec");
    let ret = ann_node(ar, TypeAnn::TyStruct { path: vpath, args: vargs });
    push_prelude_gen_method(a, ar, recv, "collect", mtps, params, Option::Some(ret), false, false, out);
}
// Register the adapter-constructor + terminal default methods on one iterator.
fn register_adapters_on(a: Allocator, ar: *Arena, recv: str, out: *Vec<MethodInfo>) {
    let no_arg: Option<*const TypeAnn> = Option::None;
    register_adapter(a, ar, recv, "map", "Map", "F", Option::Some(ann_struct(a, ar, "F")), out);
    register_adapter(a, ar, recv, "filter", "Filter", "P", Option::Some(ann_struct(a, ar, "P")), out);
    register_adapter(a, ar, recv, "take", "Take", "", Option::Some(ann_u32(ar)), out);
    register_adapter(a, ar, recv, "enumerate", "Enumerate", "", no_arg, out);
    register_fold(a, ar, recv, out);
    register_collect(a, ar, recv, out);
}
fn push_prelude_method(a: Allocator, ar: *Arena, target: str, name: str,
                       params: Vec<*const TypeAnn>, ret_ann: Option<*const TypeAnn>, out: *Vec<MethodInfo>) {
    let mut tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    tp.push(target);
    out.push(MethodInfo {
        mi_path: tp, mi_name: name,
        mi_mangled: str2(a, ar, str2(a, ar, target, "__"), name),
        mi_ret: none_ty(), mi_has_self: true, mi_self_ptr: false, mi_self_const: false,
        mi_tparams: one_tparam(a), mi_params: params, mi_ret_ann: ret_ann,
        mi_impl_idx: 0 as u32, mi_meth_idx: 0 as u32, mi_prelude: true,
        mi_struct_gen: false,
    });
}
fn prelude_struct_ty(a: Allocator, ar: *Arena, name: str) -> *const Typ {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(name);
    return ty_node(ar, Typ::TStruct(path));
}
// A non-generic prelude method (StringBuilder / String / ...): registered with
// its self shape + resolved return type; the call resolves directly.
fn push_prelude_method_ng(a: Allocator, ar: *Arena, target: str, name: str, has_self: bool,
                          self_ptr: bool, self_const: bool, ret: Option<*const Typ>, out: *Vec<MethodInfo>) {
    let mut tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    tp.push(target);
    let empty_tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let empty_params: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    let none_ann: Option<*const TypeAnn> = Option::None;
    out.push(MethodInfo {
        mi_path: tp, mi_name: name,
        mi_mangled: str2(a, ar, str2(a, ar, target, "__"), name),
        mi_ret: ret, mi_has_self: has_self, mi_self_ptr: self_ptr, mi_self_const: self_const,
        mi_tparams: empty_tp, mi_params: empty_params, mi_ret_ann: none_ann,
        mi_impl_idx: 0 as u32, mi_meth_idx: 0 as u32, mi_prelude: true,
        mi_struct_gen: false,
    });
}
// A struct-generic prelude method (`Vec<T>::push` / `get` / ...): its impl
// tparam `T` is bound from the receiver instance and its body is prelude-
// injected, so it carries `mi_struct_gen` + `mi_prelude`.  The return
// annotation (`Option<T>` / `Slice<T>` / ...) resolves under that binding.
fn push_prelude_sg_method(a: Allocator, ar: *Arena, target: str, name: str, has_self: bool,
                          self_ptr: bool, self_const: bool, ret_ann: Option<*const TypeAnn>, out: *Vec<MethodInfo>) {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(target);
    // The method's tparams are the receiver struct's (Vec/VecIter → [T],
    // Map → [I, F], ...), so `next`'s mangle picks up the full instance.
    let mut tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    prelude_struct_tparams(target, &tp);
    if tp.length() == 0 as u32 { tp.push("T"); }
    let empty_params: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    // A static generic method (no self, e.g. `with_capacity`) is not
    // receiver-dispatched; it recovers its tparam from the expected type.
    out.push(MethodInfo {
        mi_path: path, mi_name: name,
        mi_mangled: str2(a, ar, str2(a, ar, target, "__"), name),
        mi_ret: none_ty(), mi_has_self: has_self, mi_self_ptr: self_ptr, mi_self_const: self_const,
        mi_tparams: tp, mi_params: empty_params, mi_ret_ann: ret_ann,
        mi_impl_idx: 0 as u32, mi_meth_idx: 0 as u32, mi_prelude: true,
        mi_struct_gen: has_self,
    });
}
// Param-type signatures for prelude methods whose explicit arguments need
// coercion (auto-ref of a value to a `*const self`-shaped param).  Self is
// param 0; `String::eq(*const self, other: *const String)` needs both.
fn register_prelude_sigs(a: Allocator, ar: *Arena, out: *Vec<FnSig>) {
    let cps = ty_node(ar, Typ::TConstPtr(prelude_struct_ty(a, ar, "String")));
    let mut p: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    p.push(cps);
    p.push(cps);
    out.push(FnSig { fs_mangled: "String__eq", fs_params: p });
}
fn register_prelude_methods(a: Allocator, ar: *Arena, out: *Vec<MethodInfo>) {
    // Allocator: alloc<T>(self) -> own *T ;  free<T>(self, p: own *T)
    let mut alloc_params: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    alloc_params.push(ann_struct(a, ar, "Allocator"));
    push_prelude_method(a, ar, "Allocator", "alloc", alloc_params, Option::Some(ann_own_t(a, ar)), out);
    let mut free_params: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    free_params.push(ann_struct(a, ar, "Allocator"));
    free_params.push(ann_own_t(a, ar));
    let none_ann: Option<*const TypeAnn> = Option::None;
    push_prelude_method(a, ar, "Allocator", "free", free_params, none_ann, out);
    // StringBuilder: with_capacity(static) / push_*( *self ) / length+as_slice( *const self )
    let none_ret: Option<*const Typ> = Option::None;
    push_prelude_method_ng(a, ar, "StringBuilder", "with_capacity", false, false, false, Option::Some(prelude_struct_ty(a, ar, "StringBuilder")), out);
    push_prelude_method_ng(a, ar, "StringBuilder", "grow", true, true, false, none_ret, out);
    push_prelude_method_ng(a, ar, "StringBuilder", "push_byte", true, true, false, none_ret, out);
    push_prelude_method_ng(a, ar, "StringBuilder", "push_str", true, true, false, none_ret, out);
    push_prelude_method_ng(a, ar, "StringBuilder", "push_int", true, true, false, none_ret, out);
    push_prelude_method_ng(a, ar, "StringBuilder", "length", true, true, true, Option::Some(t_u32(ar)), out);
    push_prelude_method_ng(a, ar, "StringBuilder", "as_slice", true, true, true, Option::Some(prelude_struct_ty(a, ar, "Slice_u8")), out);
    // String: with_str/empty/build (static) / length+as_slice+as_str ( *const self ) / free (by-value self)
    let string_ty = prelude_struct_ty(a, ar, "String");
    push_prelude_method_ng(a, ar, "String", "with_str", false, false, false, Option::Some(string_ty), out);
    push_prelude_method_ng(a, ar, "String", "empty", false, false, false, Option::Some(string_ty), out);
    push_prelude_method_ng(a, ar, "String", "build", false, false, false, Option::Some(string_ty), out);
    push_prelude_method_ng(a, ar, "String", "length", true, true, true, Option::Some(t_u32(ar)), out);
    push_prelude_method_ng(a, ar, "String", "as_slice", true, true, true, Option::Some(prelude_struct_ty(a, ar, "Slice_u8")), out);
    push_prelude_method_ng(a, ar, "String", "as_str", true, true, true, Option::Some(t_str(ar)), out);
    push_prelude_method_ng(a, ar, "String", "free", true, false, false, none_ret, out);
    // String trait methods (Eq / Hash / Clone): content-equal delegating to str::*
    push_prelude_method_ng(a, ar, "String", "eq", true, true, true, Option::Some(ty_node(ar, Typ::TBool)), out);
    push_prelude_method_ng(a, ar, "String", "hash", true, true, true, Option::Some(t_u32(ar)), out);
    push_prelude_method_ng(a, ar, "String", "clone", true, true, true, Option::Some(string_ty), out);
    // Vec<T>: push (*self, x: T) / length (*const self) -> u32 / get (*const
    // self, i) -> Option<T> / as_slice -> Slice<T> / iter -> VecIter<T>.
    let none_ret_ann: Option<*const TypeAnn> = Option::None;
    push_prelude_sg_method(a, ar, "Vec", "with_capacity", false, false, false, Option::Some(ann_app1(a, ar, "Vec", "T")), out);
    // grow is the private geometric-resize helper; register it so `self.grow`
    // inside `push`'s materialized body resolves (never user-called).
    push_prelude_sg_method(a, ar, "Vec", "grow", true, true, false, none_ret_ann, out);
    push_prelude_sg_method(a, ar, "Vec", "push", true, true, false, none_ret_ann, out);
    push_prelude_sg_method(a, ar, "Vec", "length", true, true, true, Option::Some(ann_u32(ar)), out);
    push_prelude_sg_method(a, ar, "Vec", "get", true, true, true, Option::Some(ann_app1(a, ar, "Option", "T")), out);
    push_prelude_sg_method(a, ar, "Vec", "as_slice", true, true, true, Option::Some(ann_app1(a, ar, "Slice", "T")), out);
    push_prelude_sg_method(a, ar, "Vec", "iter", true, true, true, Option::Some(ann_app1(a, ar, "VecIter", "T")), out);
    // VecIter<T>: next (*self) -> Option<T>, the iterator protocol `for` lowers to.
    push_prelude_sg_method(a, ar, "VecIter", "next", true, true, false, Option::Some(ann_app1(a, ar, "Option", "T")), out);
    // DR-026 lazy adapters: `next(*self)` drives the fused `for` loop.  Map
    // yields `F::Output`, Take/Enumerate/Filter pass `I::Item` through
    // (Enumerate as a `(u32, I::Item)` pair).
    push_prelude_sg_method(a, ar, "Map", "next", true, true, false, Option::Some(ann_opt_of(a, ar, ann_proj(a, ar, "F", "Output"))), out);
    push_prelude_sg_method(a, ar, "Take", "next", true, true, false, Option::Some(ann_opt_of(a, ar, ann_proj(a, ar, "I", "Item"))), out);
    push_prelude_sg_method(a, ar, "Filter", "next", true, true, false, Option::Some(ann_opt_of(a, ar, ann_proj(a, ar, "I", "Item"))), out);
    // Enumerate yields `(u32, I::Item)` pairs.
    let mut enum_tup: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    enum_tup.push(ann_u32(ar));
    enum_tup.push(ann_proj(a, ar, "I", "Item"));
    push_prelude_sg_method(a, ar, "Enumerate", "next", true, true, false, Option::Some(ann_opt_of(a, ar, ann_node(ar, TypeAnn::TyTuple(enum_tup)))), out);
    // DR-026 Iterator adapter default methods (`.map`/`.filter`/`.take`/
    // `.enumerate`) on every iterator type so dot-chains compose.
    register_adapters_on(a, ar, "VecIter", out);
    register_adapters_on(a, ar, "Map", out);
    register_adapters_on(a, ar, "Filter", out);
    register_adapters_on(a, ar, "Take", out);
    register_adapters_on(a, ar, "Enumerate", out);
    // DR-007 HashMap<K,V>: with_capacity(static) / insert / get->Option<V> /
    // contains->bool / length->u32 / remove / iter->HashMapIter<K,V>; the
    // iterator yields `(K, V)` pairs.
    let hm_none: Option<*const TypeAnn> = Option::None;
    push_prelude_sg_method(a, ar, "HashMap", "with_capacity", false, false, false, Option::Some(ann_kv(a, ar, "HashMap")), out);
    // Private geometric-rehash helper; registered so `self.grow` inside the
    // materialized `insert` body resolves (never user-called).
    push_prelude_sg_method(a, ar, "HashMap", "grow", true, true, false, hm_none, out);
    push_prelude_sg_method(a, ar, "HashMap", "insert", true, true, false, hm_none, out);
    push_prelude_sg_method(a, ar, "HashMap", "get", true, true, true, Option::Some(ann_app1(a, ar, "Option", "V")), out);
    push_prelude_sg_method(a, ar, "HashMap", "contains", true, true, true, Option::Some(ann_bool(ar)), out);
    push_prelude_sg_method(a, ar, "HashMap", "length", true, true, true, Option::Some(ann_u32(ar)), out);
    push_prelude_sg_method(a, ar, "HashMap", "remove", true, true, false, hm_none, out);
    push_prelude_sg_method(a, ar, "HashMap", "iter", true, true, true, Option::Some(ann_kv(a, ar, "HashMapIter")), out);
    let mut hm_tup: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    hm_tup.push(ann_struct(a, ar, "K"));
    hm_tup.push(ann_struct(a, ar, "V"));
    push_prelude_sg_method(a, ar, "HashMapIter", "next", true, true, false, Option::Some(ann_opt_of(a, ar, ann_node(ar, TypeAnn::TyTuple(hm_tup)))), out);
    // Arena: with_capacity (static) -> Arena (the interning allocator).
    push_prelude_method_ng(a, ar, "Arena", "with_capacity", false, false, false, Option::Some(prelude_struct_ty(a, ar, "Arena")), out);
    // alloc_borrowed<T>(*self) -> *T : a plain borrow into the arena buffer.
    // T is unreachable through self/args, so it pins from the expected type
    // (`let n: *Expr = ar.alloc_borrowed()`), mangling Arena__alloc_borrowed_ex_<T>.
    // Self is a `*Arena` (mi_self_ptr) so `ar.alloc_borrowed()` passes the ptr
    // directly and `tiny.alloc_borrowed()` auto-refs the value receiver.
    let mut ab_params: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    ab_params.push(ann_node(ar, TypeAnn::TyPtr(ann_struct(a, ar, "Arena"))));
    let ab_path: Vec<str> = arena_method_path(a);
    out.push(MethodInfo {
        mi_path: ab_path, mi_name: "alloc_borrowed",
        mi_mangled: "Arena__alloc_borrowed",
        mi_ret: none_ty(), mi_has_self: true, mi_self_ptr: true, mi_self_const: false,
        mi_tparams: one_tparam(a), mi_params: ab_params,
        mi_ret_ann: Option::Some(ann_node(ar, TypeAnn::TyPtr(ann_struct(a, ar, "T")))),
        mi_impl_idx: 0 as u32, mi_meth_idx: 0 as u32, mi_prelude: true,
        mi_struct_gen: false,
    });
}
fn arena_method_path(a: Allocator) -> Vec<str> {
    let mut p: Vec<str> = Vec::with_capacity(a, 8 as u32);
    p.push("Arena");
    return p;
}
fn ann_kv(a: Allocator, ar: *Arena, name: str) -> *const TypeAnn {
    let mut tps: Vec<str> = Vec::with_capacity(a, 8 as u32);
    tps.push("K");
    tps.push("V");
    return ann_app_tps(a, ar, name, &tps);
}

// ===== Trait default methods =====
//
// A trait method with a `{ ... }` body is a default an `impl` may omit; it is
// synthesised per implementing type (`Rect__bbox`), with `Self` resolved to
// that type, and may call the type's other trait methods.

fn impl_has_method(methods: *const Vec<Func>, name: str) -> bool {
    let n = methods.length();
    let sl = methods.as_slice();
    let mut i = 0 as u32;
    while i < n { if str::eq(sl[i].name, name) { return true; } i = i + 1 as u32; }
    return false;
}
fn item_trait_name(it: *const Item) -> str {
    return match *it {
        Item::Trait(td) => td.trname
        | _e => ""
    };
}
fn find_trait_idx(items: *const Vec<Item>, name: str) -> int {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if str::eq(item_trait_name(&sl[i]), name) { return i as int; }
        i = i + 1 as u32;
    }
    return 0 as int - 1 as int;
}
fn impl_trait_name(ib: *const ImplBlock) -> str {
    return match ib.itrait {
        Option::Some(tp) => path_last(&tp)
        | Option::None => ""
    };
}

fn register_one_default(a: Allocator, ar: *Arena, sc: *const TyScope, target: *const Vec<str>,
                        impl_methods: *const Vec<Func>, defaults: *const Vec<str>, f: *const Func, ti: u32, j: u32, out: *Vec<MethodInfo>) {
    if !name_in(defaults, f.name) { return; }
    if impl_has_method(impl_methods, f.name) { return; }
    let no_itparams: Vec<str> = Vec::with_capacity(a, 8 as u32);
    push_one_method(a, ar, sc, target, &no_itparams, f, ti, j, out);
}
fn register_td_defaults(a: Allocator, ar: *Arena, sc: *const TyScope, target: *const Vec<str>,
                        impl_methods: *const Vec<Func>, td: *const TraitDecl, ti: u32, out: *Vec<MethodInfo>) {
    let n = td.trmethods.length();
    let ms = td.trmethods.as_slice();
    let mut j = 0 as u32;
    while j < n { register_one_default(a, ar, sc, target, impl_methods, &td.trdefaults, &ms[j], ti, j, out); j = j + 1 as u32; }
}
fn register_impl_defaults(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>, ti: u32,
                          target: *const Vec<str>, impl_methods: *const Vec<Func>, out: *Vec<MethodInfo>) {
    let sl = items.as_slice();
    match sl[ti] {
        Item::Trait(td) => { register_td_defaults(a, ar, sc, target, impl_methods, &td, ti, out); }
        | _e => { }
    }
}
fn collect_one_impl_defaults(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>, ib: *const ImplBlock, out: *Vec<MethodInfo>) {
    let tname = impl_trait_name(ib);
    if str::eq(tname, "") { return; }
    let ti = find_trait_idx(items, tname);
    if ti < 0 as int { return; }
    register_impl_defaults(a, ar, sc, items, ti as u32, &ib.itarget, &ib.iitems, out);
}
fn collect_impl_defaults(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>, it: *const Item, out: *Vec<MethodInfo>) {
    match *it {
        Item::Impl(ib) => { collect_one_impl_defaults(a, ar, sc, items, &ib, out); }
        | _e => { }
    }
}
// A second method-collection pass: register synthesised trait defaults so a
// `recv.default_method()` call resolves (top-level impls only, matching the
// generic-method registry).
fn collect_trait_default_methods(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>, out: *Vec<MethodInfo>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n { collect_impl_defaults(a, ar, sc, items, &sl[i], out); i = i + 1 as u32; }
}

// Register every top-level generic function (a fn with type parameters),
// keyed by its top-level item index, so its calls can be instantiated.
fn copy_param_anns(a: Allocator, params: *const Vec<Param>) -> Vec<*const TypeAnn> {
    let mut out: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    let n = params.length();
    let sl = params.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(sl[i].pty); i = i + 1 as u32; }
    return out;
}
fn push_gen_fn(a: Allocator, ar: *Arena, f: *const Func, gidx: u32, out: *Vec<GenFn>) {
    if f.tparams.length() == 0 as u32 { return; }
    out.push(GenFn { gn_name: f.name, gn_mangled: mangle_fn(a, ar, f), gn_idx: gidx,
                     gn_tparams: copy_strs(a, &f.tparams), gn_params: copy_param_anns(a, &f.params),
                     gn_ret: f.ret_ty });
}
fn collect_gen_fns_one(a: Allocator, ar: *Arena, it: *const Item, gidx: u32, out: *Vec<GenFn>) {
    match *it {
        Item::Function(f) => { push_gen_fn(a, ar, &f, gidx, out); }
        | _e => { }
    }
}
fn collect_gen_fns(a: Allocator, ar: *Arena, items: *const Vec<Item>, out: *Vec<GenFn>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n { collect_gen_fns_one(a, ar, &sl[i], i, out); i = i + 1 as u32; }
}

fn push_enum_tp(a: Allocator, ename: str, params: *const Vec<str>, out: *Vec<EnumTP>) {
    out.push(EnumTP { etp_name: ename, etp_params: copy_strs(a, params) });
}
fn collect_enum_tps_one(a: Allocator, it: *const Item, out: *Vec<EnumTP>) {
    match *it {
        Item::Enum(ed) => { push_enum_tp(a, ed.ename, &ed.etparams, out); }
        | Item::View(vd) => { let etp: Vec<str> = Vec::with_capacity(a, 8 as u32); push_enum_tp(a, vd.vname, &etp, out); }
        | Item::Module(md) => { collect_enum_tps(a, &md.mitems, out); }
        | _e => { }
    }
}
fn collect_enum_tps(a: Allocator, items: *const Vec<Item>, out: *Vec<EnumTP>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n { collect_enum_tps_one(a, &sl[i], out); i = i + 1 as u32; }
}
fn push_struct_tp(a: Allocator, sname: str, params: *const Vec<str>, out: *Vec<StructTP>) {
    out.push(StructTP { stp_name: sname, stp_params: copy_strs(a, params) });
}
fn collect_struct_tps_one(a: Allocator, it: *const Item, out: *Vec<StructTP>) {
    match *it {
        Item::Struct(sd) => { push_struct_tp(a, sd.sname, &sd.stparams, out); }
        | Item::Module(md) => { collect_struct_tps(a, &md.mitems, out); }
        | _e => { }
    }
}
// The prelude generic structs' tparams in the StructTP registry, so a nested
// generic instance (`Slot<K,V>` inside `HashMap`) recovers + registers.
fn push_prelude_stp(a: Allocator, name: str, out: *Vec<StructTP>) {
    let mut tps: Vec<str> = Vec::with_capacity(a, 8 as u32);
    prelude_struct_tparams(name, &tps);
    push_struct_tp(a, name, &tps, out);
}
fn prelude_struct_tps(a: Allocator, out: *Vec<StructTP>) {
    push_prelude_stp(a, "Slice", out);
    push_prelude_stp(a, "Vec", out);
    push_prelude_stp(a, "VecIter", out);
    push_prelude_stp(a, "Map", out);
    push_prelude_stp(a, "Filter", out);
    push_prelude_stp(a, "Take", out);
    push_prelude_stp(a, "Enumerate", out);
    push_prelude_stp(a, "HashMap", out);
    push_prelude_stp(a, "Slot", out);
    push_prelude_stp(a, "HashMapIter", out);
}
fn collect_struct_tps(a: Allocator, items: *const Vec<Item>, out: *Vec<StructTP>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n { collect_struct_tps_one(a, &sl[i], out); i = i + 1 as u32; }
    return;
}
fn push_one_assoc(a: Allocator, trname: str, target: str, name: str, ty: *const TypeAnn, tparams: *const Vec<str>, out: *Vec<AssocBind>) {
    out.push(AssocBind { ab_trait: trname, ab_target: target, ab_name: name, ab_ty: ty, ab_tparams: copy_strs(a, tparams) });
}
fn push_impl_assoc(a: Allocator, ib: *const ImplBlock, out: *Vec<AssocBind>) {
    let n = ib.iassoc.length();
    let sl = ib.iassoc.as_slice();
    let tgt = path_last(&ib.itarget);
    let trn = impl_trait_name(ib);
    let mut i = 0 as u32;
    while i < n {
        push_one_assoc(a, trn, tgt, sl[i].name, sl[i].ty, &ib.itparams, out);
        i = i + 1 as u32;
    }
}
fn collect_assoc_binds_one(a: Allocator, it: *const Item, out: *Vec<AssocBind>) {
    match *it {
        Item::Impl(ib) => { push_impl_assoc(a, &ib, out); }
        | Item::Module(md) => { collect_assoc_binds(a, &md.mitems, out); }
        | _e => { }
    }
}
// The prelude iterators' `Iterator::Item` associated types, so an adapter's
// `next` return (`Option<I::Item>`) projects through a chained inner iterator.
fn register_prelude_assoc(a: Allocator, ar: *Arena, out: *Vec<AssocBind>) {
    let tp_t = single_str(a, "T");
    push_one_assoc(a, "Iterator", "VecIter", "Item", ann_struct(a, ar, "T"), &tp_t, out);
    let mut tp_if: Vec<str> = Vec::with_capacity(a, 8 as u32);
    tp_if.push("I");
    tp_if.push("F");
    push_one_assoc(a, "Iterator", "Map", "Item", ann_proj(a, ar, "F", "Output"), &tp_if, out);
    let mut tp_ip: Vec<str> = Vec::with_capacity(a, 8 as u32);
    tp_ip.push("I");
    tp_ip.push("P");
    push_one_assoc(a, "Iterator", "Filter", "Item", ann_proj(a, ar, "I", "Item"), &tp_ip, out);
    let tp_i = single_str(a, "I");
    push_one_assoc(a, "Iterator", "Take", "Item", ann_proj(a, ar, "I", "Item"), &tp_i, out);
    let mut tupargs: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    tupargs.push(ann_u32(ar));
    tupargs.push(ann_proj(a, ar, "I", "Item"));
    let tup = ann_node(ar, TypeAnn::TyTuple(tupargs));
    let tp_i2 = single_str(a, "I");
    push_one_assoc(a, "Iterator", "Enumerate", "Item", tup, &tp_i2, out);
}
fn collect_assoc_binds(a: Allocator, items: *const Vec<Item>, out: *Vec<AssocBind>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n { collect_assoc_binds_one(a, &sl[i], out); i = i + 1 as u32; }
}
// ===== A2 closure pre-pass: synthesise env struct + impl FnN =====
//
// Run during check_program setup (the registries are still mutable).
// Walks every fn body threading an annotation-scope (params + annotated
// lets); at each capturing lambda it registers a `__closure_N` env struct,
// a `Fn{arity}` `call` method and the trait's `Arg`/`Output` assoc bindings,
// and records a drain entry whose body is the capture-substituted lambda
// body.  The lambda expression itself is replaced (at elab time) with a
// struct literal building the env — matched back by pointer identity.

fn copy_fielddefs(a: Allocator, src: *const Vec<FieldDef>) -> Vec<FieldDef> {
    let mut out: Vec<FieldDef> = Vec::with_capacity(a, 8 as u32);
    let n = src.length();
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < n { out.push(FieldDef { name: sl[i].name, ty: sl[i].ty }); i = i + 1 as u32; }
    return out;
}
fn single_str(a: Allocator, s: str) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    out.push(s);
    return out;
}
fn closure_struct_ann(a: Allocator, ar: *Arena, cn: str) -> *const TypeAnn {
    let path = single_str(a, cn);
    let args: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    return tyann_node(ar, TypeAnn::TyStruct { path: path, args: args });
}
fn push_closure_field(a: Allocator, cn: str, fname: str, fty: *const Typ, out: *Vec<StructField>) {
    out.push(StructField { sf_path: single_str(a, cn), sf_name: fname, sf_ty: fty });
}
// MethodInfo for the synthetic `call(*const self, params..) -> ret`,
// hand-built (no owned `Func`, which would pull drop instances the oracle
// never synthesises for borrowed program items).
fn push_call_method(a: Allocator, ar: *Arena, sc: *const TyScope, cn: str, cnpath: *const Vec<str>, params: *const Vec<FieldDef>, ret_ty: Option<*const TypeAnn>, out: *Vec<MethodInfo>) {
    let self_ann = tyann_node(ar, TypeAnn::TyConstPtr(closure_struct_ann(a, ar, cn)));
    let mut manns: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    manns.push(self_ann);
    let n = params.length();
    let sl = params.as_slice();
    let mut i = 0 as u32;
    while i < n { manns.push(sl[i].ty); i = i + 1 as u32; }
    let empty_tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    out.push(MethodInfo {
        mi_path: copy_strs(a, cnpath), mi_name: "call", mi_mangled: method_mangle(a, ar, cnpath, "call"),
        mi_ret: resolve_sig_ret(a, ar, sc, ret_ty),
        mi_has_self: true, mi_self_ptr: true, mi_self_const: true,
        mi_tparams: empty_tp, mi_params: manns, mi_ret_ann: ret_ty,
        mi_impl_idx: 0 as u32, mi_meth_idx: 0 as u32, mi_prelude: false, mi_struct_gen: false
    });
}
fn cvoid_ann(ar: *Arena) -> *const TypeAnn {
    return tyann_node(ar, TypeAnn::TyCVoid);
}
fn push_closure_assoc(a: Allocator, ar: *Arena, trname: str, cn: str, params: *const Vec<FieldDef>, ret_ty: Option<*const TypeAnn>, out: *Vec<AssocBind>) {
    let empty_tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let n = params.length();
    let sl = params.as_slice();
    if n == 1 as u32 {
        push_one_assoc(a, trname, cn, "Arg", sl[0 as u32].ty, &empty_tp, out);
    } else {
        let mut i = 0 as u32;
        while i < n {
            let an = gensym_name(a, ar, "Arg", i + 1 as u32);
            push_one_assoc(a, trname, cn, an, sl[i].ty, &empty_tp, out);
            i = i + 1 as u32;
        }
    }
    let ret_ann = match ret_ty { Option::Some(t) => t | Option::None => cvoid_ann(ar) };
    push_one_assoc(a, trname, cn, "Output", ret_ann, &empty_tp, out);
}
fn synth_closure(a: Allocator, ar: *Arena, sc: *const TyScope, num: u32,
                 caps_names: *const Vec<str>, caps_anns: *const Vec<*const TypeAnn>, caps_brefs: *const Vec<str>,
                 params: *const Vec<FieldDef>, ret_ty: Option<*const TypeAnn>, subst_body: *const Expr, lambda: *const Expr,
                 sinfo: *Vec<StructField>, methods: *Vec<MethodInfo>, assoc: *Vec<AssocBind>, stps: *Vec<StructTP>, lifted: *Vec<LiftedLambda>) {
    let cn = gensym_name(a, ar, "__closure_", num);
    let cnpath = single_str(a, cn);
    let ncap = caps_names.length();
    let nsl = caps_names.as_slice();
    let asl = caps_anns.as_slice();
    let mut i = 0 as u32;
    while i < ncap {
        let fty0 = resolve_sig_ty(a, ar, sc, asl[i]);
        let fty = if name_in(caps_brefs, nsl[i]) { ty_node(ar, Typ::TConstPtr(fty0)) } else { fty0 };
        push_closure_field(a, cn, nsl[i], fty, sinfo);
        i = i + 1 as u32;
    }
    if ncap == 0 as u32 { push_closure_field(a, cn, "_pad", t_u8(ar), sinfo); }
    let empty_tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    push_struct_tp(a, cn, &empty_tp, stps);
    register_mono_struct(a, sc, &cnpath);
    push_call_method(a, ar, sc, cn, &cnpath, params, ret_ty, methods);
    let trname = gensym_name(a, ar, "Fn", params.length());
    push_closure_assoc(a, ar, trname, cn, params, ret_ty, assoc);
    let mangled = method_mangle(a, ar, &cnpath, "call");
    lifted.push(LiftedLambda {
        ll_mangled: mangled, ll_name: mangled, ll_expr: subst_body, ll_kind: 1 as int,
        ll_closure: cn, ll_params: copy_fielddefs(a, params), ll_ret: ret_ty,
        ll_caps: copy_strs(a, caps_names), ll_brefs: copy_strs(a, caps_brefs), ll_lambda: lambda
    });
}

// Index of `n` in the parallel annotation-scope (names), or -1.
fn scope_index(names: *const Vec<str>, n: str) -> int {
    let m = names.length();
    let sl = names.as_slice();
    let mut i = 0 as u32;
    while i < m { if str::eq(sl[i], n) { return i as int; } i = i + 1 as u32; }
    return -1 as int;
}
// By-ref capture names from a lambda's explicit `[&name]` capture list.
fn byref_names(a: Allocator, caps: *const Vec<Capture>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let n = caps.length();
    let sl = caps.as_slice();
    let mut i = 0 as u32;
    while i < n { if sl[i].by_ref { out.push(sl[i].name); } i = i + 1 as u32; }
    return out;
}
fn prepass_at_lambda(a: Allocator, ar: *Arena, sc: *const TyScope, scn: *const Vec<str>, sca: *const Vec<*const TypeAnn>,
                     params: *const Vec<FieldDef>, ret_ty: Option<*const TypeAnn>, body: *const Expr, ecaps: *const Vec<Capture>,
                     ctr: *u32, sinfo: *Vec<StructField>, methods: *Vec<MethodInfo>, assoc: *Vec<AssocBind>, stps: *Vec<StructTP>, lifted: *Vec<LiftedLambda>, lambda: *const Expr) {
    // Free vars of the body (lambda params are bound).
    let mut pnames: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let pn = params.length();
    let psl = params.as_slice();
    let mut pi = 0 as u32;
    while pi < pn { pnames.push(psl[pi].name); pi = pi + 1 as u32; }
    let mut free: Vec<str> = Vec::with_capacity(a, 8 as u32);
    fv_expr(a, &pnames, body, &free);
    // Captures = free vars visible in the annotation-scope; by-ref ones come
    // from the explicit `[&name]` list (DR-033).
    let brn = byref_names(a, ecaps);
    let mut cnames: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut canns: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    let fn2 = free.length();
    let fsl = free.as_slice();
    let asl = sca.as_slice();
    let mut fi = 0 as u32;
    while fi < fn2 {
        let si = scope_index(scn, fsl[fi]);
        if si >= 0 as int {
            cnames.push(fsl[fi]);
            canns.push(asl[si as u32]);
        }
        fi = fi + 1 as u32;
    }
    if cnames.length() == 0 as u32 { return; }
    let sbody = subst_caps_expr(a, ar, &cnames, &brn, &pnames, body);
    synth_closure(a, ar, sc, *ctr, &cnames, &canns, &brn, params, ret_ty, sbody, lambda, sinfo, methods, assoc, stps, lifted);
    *ctr = *ctr + 1 as u32;
}
fn prepass_exprs(a: Allocator, ar: *Arena, sc: *const TyScope, scn: *const Vec<str>, sca: *const Vec<*const TypeAnn>,
                 es: *const Vec<*const Expr>, ctr: *u32, sinfo: *Vec<StructField>, methods: *Vec<MethodInfo>, assoc: *Vec<AssocBind>, stps: *Vec<StructTP>, lifted: *Vec<LiftedLambda>) {
    let n = es.length();
    let sl = es.as_slice();
    let mut i = 0 as u32;
    while i < n { prepass_expr(a, ar, sc, scn, sca, sl[i], ctr, sinfo, methods, assoc, stps, lifted); i = i + 1 as u32; }
}
fn prepass_opt(a: Allocator, ar: *Arena, sc: *const TyScope, scn: *const Vec<str>, sca: *const Vec<*const TypeAnn>,
               oe: Option<*const Expr>, ctr: *u32, sinfo: *Vec<StructField>, methods: *Vec<MethodInfo>, assoc: *Vec<AssocBind>, stps: *Vec<StructTP>, lifted: *Vec<LiftedLambda>) {
    match oe { Option::Some(e) => prepass_expr(a, ar, sc, scn, sca, e, ctr, sinfo, methods, assoc, stps, lifted) | Option::None => {} }
}
fn prepass_fields(a: Allocator, ar: *Arena, sc: *const TyScope, scn: *const Vec<str>, sca: *const Vec<*const TypeAnn>,
                  fields: *const Vec<Field>, ctr: *u32, sinfo: *Vec<StructField>, methods: *Vec<MethodInfo>, assoc: *Vec<AssocBind>, stps: *Vec<StructTP>, lifted: *Vec<LiftedLambda>) {
    let n = fields.length();
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < n { prepass_expr(a, ar, sc, scn, sca, sl[i].value, ctr, sinfo, methods, assoc, stps, lifted); i = i + 1 as u32; }
}
fn prepass_expr(a: Allocator, ar: *Arena, sc: *const TyScope, scn: *const Vec<str>, sca: *const Vec<*const TypeAnn>,
                e: *const Expr, ctr: *u32, sinfo: *Vec<StructField>, methods: *Vec<MethodInfo>, assoc: *Vec<AssocBind>, stps: *Vec<StructTP>, lifted: *Vec<LiftedLambda>) {
    match *e {
        Expr::Neg(s, _q) => prepass_expr(a, ar, sc, scn, sca, s, ctr, sinfo, methods, assoc, stps, lifted)
        | Expr::BitNot(s, _q) => prepass_expr(a, ar, sc, scn, sca, s, ctr, sinfo, methods, assoc, stps, lifted)
        | Expr::Not(s, _q) => prepass_expr(a, ar, sc, scn, sca, s, ctr, sinfo, methods, assoc, stps, lifted)
        | Expr::Try(s, _q) => prepass_expr(a, ar, sc, scn, sca, s, ctr, sinfo, methods, assoc, stps, lifted)
        | Expr::Cast(s, _t, _q) => prepass_expr(a, ar, sc, scn, sca, s, ctr, sinfo, methods, assoc, stps, lifted)
        | Expr::FieldAccess(s, _f, _q) => prepass_expr(a, ar, sc, scn, sca, s, ctr, sinfo, methods, assoc, stps, lifted)
        | Expr::Ref(s, _q) => prepass_expr(a, ar, sc, scn, sca, s, ctr, sinfo, methods, assoc, stps, lifted)
        | Expr::Deref(s, _q) => prepass_expr(a, ar, sc, scn, sca, s, ctr, sinfo, methods, assoc, stps, lifted)
        | Expr::BinOp(_op, l, r, _q) => { prepass_expr(a, ar, sc, scn, sca, l, ctr, sinfo, methods, assoc, stps, lifted); prepass_expr(a, ar, sc, scn, sca, r, ctr, sinfo, methods, assoc, stps, lifted); }
        | Expr::Orelse(l, r, _q) => { prepass_expr(a, ar, sc, scn, sca, l, ctr, sinfo, methods, assoc, stps, lifted); prepass_expr(a, ar, sc, scn, sca, r, ctr, sinfo, methods, assoc, stps, lifted); }
        | Expr::Index { base, index } => { prepass_expr(a, ar, sc, scn, sca, base, ctr, sinfo, methods, assoc, stps, lifted); prepass_expr(a, ar, sc, scn, sca, index, ctr, sinfo, methods, assoc, stps, lifted); }
        | Expr::Range { lo, hi, inclusive } => { prepass_expr(a, ar, sc, scn, sca, lo, ctr, sinfo, methods, assoc, stps, lifted); prepass_expr(a, ar, sc, scn, sca, hi, ctr, sinfo, methods, assoc, stps, lifted); }
        | Expr::Call { callee, args } => prepass_exprs(a, ar, sc, scn, sca, &args, ctr, sinfo, methods, assoc, stps, lifted)
        | Expr::MethodCall { receiver, name, args } => { prepass_expr(a, ar, sc, scn, sca, receiver, ctr, sinfo, methods, assoc, stps, lifted); prepass_exprs(a, ar, sc, scn, sca, &args, ctr, sinfo, methods, assoc, stps, lifted); }
        | Expr::TupleLit(es, _q) => prepass_exprs(a, ar, sc, scn, sca, &es, ctr, sinfo, methods, assoc, stps, lifted)
        | Expr::ArrayLit(es, _q) => prepass_exprs(a, ar, sc, scn, sca, &es, ctr, sinfo, methods, assoc, stps, lifted)
        | Expr::ArrayRepeat { value, count } => { prepass_expr(a, ar, sc, scn, sca, value, ctr, sinfo, methods, assoc, stps, lifted); prepass_expr(a, ar, sc, scn, sca, count, ctr, sinfo, methods, assoc, stps, lifted); }
        | Expr::StructLit { tname, fields, base } => { prepass_fields(a, ar, sc, scn, sca, &fields, ctr, sinfo, methods, assoc, stps, lifted); prepass_opt(a, ar, sc, scn, sca, base, ctr, sinfo, methods, assoc, stps, lifted); }
        | Expr::New { tname, fields, base, alloc } => { prepass_fields(a, ar, sc, scn, sca, &fields, ctr, sinfo, methods, assoc, stps, lifted); prepass_opt(a, ar, sc, scn, sca, base, ctr, sinfo, methods, assoc, stps, lifted); prepass_opt(a, ar, sc, scn, sca, alloc, ctr, sinfo, methods, assoc, stps, lifted); }
        | Expr::NewEnum { tname, args, alloc } => { prepass_exprs(a, ar, sc, scn, sca, &args, ctr, sinfo, methods, assoc, stps, lifted); prepass_opt(a, ar, sc, scn, sca, alloc, ctr, sinfo, methods, assoc, stps, lifted); }
        | Expr::Lambda { params, ret_ty, body, captures } => prepass_at_lambda(a, ar, sc, scn, sca, &params, ret_ty, body, &captures, ctr, sinfo, methods, assoc, stps, lifted, e)
        | _other => {}
    }
}
fn prepass_stmts(a: Allocator, ar: *Arena, sc: *const TyScope, scn: *const Vec<str>, sca: *const Vec<*const TypeAnn>,
                 stmts: *const Vec<Stmt>, ctr: *u32, sinfo: *Vec<StructField>, methods: *Vec<MethodInfo>, assoc: *Vec<AssocBind>, stps: *Vec<StructTP>, lifted: *Vec<LiftedLambda>) {
    let mut ln: Vec<str> = copy_strs(a, scn);
    let mut la: Vec<*const TypeAnn> = copy_tyanns(a, sca);
    let n = stmts.length();
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < n {
        match sl[i] {
            Stmt::Let { name, value, ty_ann, is_mut } => {
                prepass_expr(a, ar, sc, &ln, &la, value, ctr, sinfo, methods, assoc, stps, lifted);
                match ty_ann { Option::Some(t) => { ln.push(name); la.push(t); } | Option::None => {} }
            }
            | Stmt::ExprStmt(e) => prepass_expr(a, ar, sc, &ln, &la, e, ctr, sinfo, methods, assoc, stps, lifted)
            | Stmt::Tail(e) => prepass_expr(a, ar, sc, &ln, &la, e, ctr, sinfo, methods, assoc, stps, lifted)
            | Stmt::Return(oe, _q) => prepass_opt(a, ar, sc, &ln, &la, oe, ctr, sinfo, methods, assoc, stps, lifted)
            | Stmt::Assign { path, value } => prepass_expr(a, ar, sc, &ln, &la, value, ctr, sinfo, methods, assoc, stps, lifted)
            | Stmt::AssignField { target, field, value } => { prepass_expr(a, ar, sc, &ln, &la, target, ctr, sinfo, methods, assoc, stps, lifted); prepass_expr(a, ar, sc, &ln, &la, value, ctr, sinfo, methods, assoc, stps, lifted); }
            | Stmt::AssignIndex { base, index, value } => { prepass_expr(a, ar, sc, &ln, &la, base, ctr, sinfo, methods, assoc, stps, lifted); prepass_expr(a, ar, sc, &ln, &la, index, ctr, sinfo, methods, assoc, stps, lifted); prepass_expr(a, ar, sc, &ln, &la, value, ctr, sinfo, methods, assoc, stps, lifted); }
            | Stmt::AssignDeref { target, value } => { prepass_expr(a, ar, sc, &ln, &la, target, ctr, sinfo, methods, assoc, stps, lifted); prepass_expr(a, ar, sc, &ln, &la, value, ctr, sinfo, methods, assoc, stps, lifted); }
            | Stmt::While { cond, body } => { prepass_expr(a, ar, sc, &ln, &la, cond, ctr, sinfo, methods, assoc, stps, lifted); prepass_stmts(a, ar, sc, &ln, &la, &body, ctr, sinfo, methods, assoc, stps, lifted); }
            | Stmt::For { iter_var, range, body } => { prepass_expr(a, ar, sc, &ln, &la, range, ctr, sinfo, methods, assoc, stps, lifted); prepass_stmts(a, ar, sc, &ln, &la, &body, ctr, sinfo, methods, assoc, stps, lifted); }
            | Stmt::Defer { body } => prepass_stmts(a, ar, sc, &ln, &la, &body, ctr, sinfo, methods, assoc, stps, lifted)
            | Stmt::With { target, name, body } => { prepass_expr(a, ar, sc, &ln, &la, target, ctr, sinfo, methods, assoc, stps, lifted); prepass_stmts(a, ar, sc, &ln, &la, &body, ctr, sinfo, methods, assoc, stps, lifted); }
            | _other => {}
        }
        i = i + 1 as u32;
    }
}
fn params_scope(params: *const Vec<Param>, names: *Vec<str>, anns: *Vec<*const TypeAnn>) {
    let n = params.length();
    let sl = params.as_slice();
    let mut i = 0 as u32;
    while i < n { names.push(sl[i].pname); anns.push(sl[i].pty); i = i + 1 as u32; }
}
fn prepass_fn(a: Allocator, ar: *Arena, sc: *const TyScope, f: *const Func, ctr: *u32, sinfo: *Vec<StructField>, methods: *Vec<MethodInfo>, assoc: *Vec<AssocBind>, stps: *Vec<StructTP>, lifted: *Vec<LiftedLambda>) {
    let mut names: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut anns: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    params_scope(&f.params, &names, &anns);
    prepass_stmts(a, ar, sc, &names, &anns, &f.body, ctr, sinfo, methods, assoc, stps, lifted);
}
fn prepass_funcs(a: Allocator, ar: *Arena, sc: *const TyScope, funcs: *const Vec<Func>, ctr: *u32, sinfo: *Vec<StructField>, methods: *Vec<MethodInfo>, assoc: *Vec<AssocBind>, stps: *Vec<StructTP>, lifted: *Vec<LiftedLambda>) {
    let n = funcs.length();
    let sl = funcs.as_slice();
    let mut i = 0 as u32;
    while i < n { prepass_fn(a, ar, sc, &sl[i], ctr, sinfo, methods, assoc, stps, lifted); i = i + 1 as u32; }
}
fn prepass_items(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>, ctr: *u32, sinfo: *Vec<StructField>, methods: *Vec<MethodInfo>, assoc: *Vec<AssocBind>, stps: *Vec<StructTP>, lifted: *Vec<LiftedLambda>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n { prepass_item(a, ar, sc, &sl[i], ctr, sinfo, methods, assoc, stps, lifted); i = i + 1 as u32; }
}
fn prepass_item(a: Allocator, ar: *Arena, sc: *const TyScope, it: *const Item, ctr: *u32, sinfo: *Vec<StructField>, methods: *Vec<MethodInfo>, assoc: *Vec<AssocBind>, stps: *Vec<StructTP>, lifted: *Vec<LiftedLambda>) {
    match *it {
        Item::Function(f) => prepass_fn(a, ar, sc, &f, ctr, sinfo, methods, assoc, stps, lifted)
        | Item::Impl(ib) => prepass_funcs(a, ar, sc, &ib.iitems, ctr, sinfo, methods, assoc, stps, lifted)
        | Item::Module(md) => prepass_items(a, ar, sc, &md.mitems, ctr, sinfo, methods, assoc, stps, lifted)
        | _other => {}
    }
}
fn prepass_closures(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>, sinfo: *Vec<StructField>, methods: *Vec<MethodInfo>, assoc: *Vec<AssocBind>, stps: *Vec<StructTP>, lifted: *Vec<LiftedLambda>) {
    let mut ctr: u32 = 0 as u32;
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n { prepass_item(a, ar, sc, &sl[i], &ctr, sinfo, methods, assoc, stps, lifted); i = i + 1 as u32; }
}

// ===== @derive synthesis (Eq / Hash / Clone / Debug) =====
//
// Mirrors the oracle's expand_derives pre-pass: a method per derived trait
// is synthesised for each `@derive`'d struct/enum.  Bodies are built in
// already-lowered form (`==` for field equality, `*31` hash fold, struct-lit
// clone, nested match for enums), so the int-field corpus needs no primitive
// `.eq()/.clone()` dispatch.  Each method registers a MethodInfo; all but the
// Eq default `ne` (resolved here, emitted downstream) drain a Tfunc after the
// user fns, before the generic instances.
fn dv_var(ar: *Arena, n: str, p: Pos) -> *const Expr { return ast_node(ar, Expr::Var(n, p)); }
fn dv_field(ar: *Arena, recv: str, f: str, p: Pos) -> *const Expr {
    return ast_node(ar, Expr::FieldAccess(dv_var(ar, recv, p), f, p));
}
fn dv_cast_u32(ar: *Arena, e: *const Expr, p: Pos) -> *const Expr {
    return ast_node(ar, Expr::Cast(e, tyann_node(ar, TypeAnn::TyInt { is_signed: false, width: IntWidth::W32 }), p));
}
fn ann_bool(ar: *Arena) -> *const TypeAnn { return tyann_node(ar, TypeAnn::TyBool); }
fn dv_const_ptr(a: Allocator, ar: *Arena, target: str) -> *const TypeAnn {
    return tyann_node(ar, TypeAnn::TyConstPtr(closure_struct_ann(a, ar, target)));
}
fn dv_and_fold(ar: *Arena, exprs: *const Vec<*const Expr>, p: Pos) -> *const Expr {
    let n = exprs.length();
    let sl = exprs.as_slice();
    if n == 0 as u32 { return ast_node(ar, Expr::BoolLit(true, p)); }
    let mut acc = sl[0 as u32];
    let mut i = 1 as u32;
    while i < n { acc = ast_node(ar, Expr::BinOp(BinOp::And, acc, sl[i], p)); i = i + 1 as u32; }
    return acc;
}
// `acc = acc*31 + cast_u32(v)` folded over `vals` from `seed`.
fn dv_hash_fold(ar: *Arena, seed: *const Expr, vals: *const Vec<*const Expr>, p: Pos) -> *const Expr {
    let n = vals.length();
    let sl = vals.as_slice();
    let mut acc = seed;
    let mut i = 0 as u32;
    while i < n {
        let m = ast_node(ar, Expr::BinOp(BinOp::Mul, acc, ast_node(ar, Expr::IntLit(31 as int, p)), p));
        acc = ast_node(ar, Expr::BinOp(BinOp::Add, m, dv_cast_u32(ar, sl[i], p), p));
        i = i + 1 as u32;
    }
    return acc;
}
fn derive_eq_struct_body(a: Allocator, ar: *Arena, sfields: *const Vec<FieldDef>, p: Pos) -> *const Expr {
    let n = sfields.length();
    let sl = sfields.as_slice();
    let mut cmps: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    let mut i = 0 as u32;
    while i < n {
        cmps.push(ast_node(ar, Expr::BinOp(BinOp::EqEq, dv_field(ar, "self", sl[i].name, p), dv_field(ar, "other", sl[i].name, p), p)));
        i = i + 1 as u32;
    }
    return dv_and_fold(ar, &cmps, p);
}
fn derive_hash_struct_body(a: Allocator, ar: *Arena, sfields: *const Vec<FieldDef>, p: Pos) -> *const Expr {
    let n = sfields.length();
    let sl = sfields.as_slice();
    if n == 0 as u32 { return dv_cast_u32(ar, ast_node(ar, Expr::IntLit(0 as int, p)), p); }
    let seed = dv_cast_u32(ar, dv_field(ar, "self", sl[0 as u32].name, p), p);
    let mut vals: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    let mut i = 1 as u32;
    while i < n { vals.push(dv_field(ar, "self", sl[i].name, p)); i = i + 1 as u32; }
    return dv_hash_fold(ar, seed, &vals, p);
}
fn derive_clone_struct_body(a: Allocator, ar: *Arena, sname: str, sfields: *const Vec<FieldDef>, p: Pos) -> *const Expr {
    let mut fields: Vec<Field> = Vec::with_capacity(a, 8 as u32);
    let n = sfields.length();
    let sl = sfields.as_slice();
    let mut i = 0 as u32;
    while i < n { fields.push(Field { name: sl[i].name, value: dv_field(ar, "self", sl[i].name, p) }); i = i + 1 as u32; }
    let nb: Option<*const Expr> = Option::None;
    return ast_node(ar, Expr::StructLit { tname: single_str(a, sname), fields: fields, base: nb, pos: p });
}
// Register a derived method's MethodInfo and (if `do_drain`) a kind-2 drain
// entry; `has_other` adds the second `*const T` param (Eq's eq/ne).
// A synthesized method's home file.  `@derive(Eq)` writes a real `eq` into the
// USER's file, but `ne` is the Eq trait's DEFAULT — it lives in the prelude, so
// it is excluded from `--user-only` dumps and is DCE-able when nothing calls it
// (`Point__ne` survives because `p.ne(r)` exists; `Shape__ne` does not).
fn lifted_pos(kind: int) -> Pos {
    if kind == 4 as int { return prelude_file_pos(); }
    return zero_pos();
}
fn push_derive_method(a: Allocator, ar: *Arena, sc: *const TyScope, target: str, mname: str,
                      ret_ann: *const TypeAnn, has_other: bool, body: *const Expr, do_drain: bool,
                      methods: *Vec<MethodInfo>, lifted: *Vec<LiftedLambda>, gsigs: *Vec<FnSig>) {
    push_derive_method_k(a, ar, sc, target, mname, ret_ann, has_other, body, do_drain, 2 as int, methods, lifted, gsigs);
    return;
}
fn push_derive_method_k(a: Allocator, ar: *Arena, sc: *const TyScope, target: str, mname: str,
                        ret_ann: *const TypeAnn, has_other: bool, body: *const Expr, do_drain: bool,
                        kind: int, methods: *Vec<MethodInfo>, lifted: *Vec<LiftedLambda>, gsigs: *Vec<FnSig>) {
    let tp = single_str(a, target);
    let mangled = method_mangle(a, ar, &tp, mname);
    let mut manns: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    manns.push(dv_const_ptr(a, ar, target));
    if has_other { manns.push(dv_const_ptr(a, ar, target)); }
    // Register the call signature so the arg coercion auto-refs a value
    // `other` to `&other` (the `*const T` param).
    let self_ty = resolve_sig_ty(a, ar, sc, dv_const_ptr(a, ar, target));
    let mut fs_params: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    fs_params.push(self_ty);
    if has_other { fs_params.push(resolve_sig_ty(a, ar, sc, dv_const_ptr(a, ar, target))); }
    gsigs.push(FnSig { fs_mangled: mangled, fs_params: fs_params });
    let empty_tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    methods.push(MethodInfo {
        mi_path: single_str(a, target), mi_name: mname, mi_mangled: mangled,
        mi_ret: resolve_sig_ret(a, ar, sc, Option::Some(ret_ann)),
        mi_has_self: true, mi_self_ptr: true, mi_self_const: true,
        mi_tparams: empty_tp, mi_params: manns, mi_ret_ann: Option::Some(ret_ann),
        mi_impl_idx: 0 as u32, mi_meth_idx: 0 as u32, mi_prelude: false, mi_struct_gen: false
    });
    if do_drain {
        let mut params: Vec<FieldDef> = Vec::with_capacity(a, 8 as u32);
        if has_other { params.push(FieldDef { name: "other", ty: dv_const_ptr(a, ar, target) }); }
        let ec: Vec<str> = Vec::with_capacity(a, 8 as u32);
        let eb: Vec<str> = Vec::with_capacity(a, 8 as u32);
        lifted.push(LiftedLambda {
            ll_mangled: mangled, ll_name: mangled, ll_expr: body, ll_kind: kind,
            ll_closure: target, ll_params: params, ll_ret: Option::Some(ret_ann),
            ll_caps: ec, ll_brefs: eb, ll_lambda: body
        });
    }
}
// `ne` defaults to `!(*self).eq(*other)`.  Both params are `*const Self`, so the
// body derefs them — otherwise method dispatch sees a pointer receiver, hits the
// built-in primitive-pointer eq path and silently lowers to a pointer compare.
fn derive_ne_body(a: Allocator, ar: *Arena, p: Pos) -> *const Expr {
    let mut args: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    args.push(ast_node(ar, Expr::Deref(dv_var(ar, "other", p), p)));
    let call = ast_node(ar, Expr::MethodCall {
        receiver: ast_node(ar, Expr::Deref(dv_var(ar, "self", p), p)), name: "eq", args: args, pos: p });
    return ast_node(ar, Expr::Not(call, p));
}
fn collect_derives_struct(a: Allocator, ar: *Arena, sc: *const TyScope, sd: *const StructDecl, methods: *Vec<MethodInfo>, lifted: *Vec<LiftedLambda>, gsigs: *Vec<FnSig>) {
    let n = sd.sderives.length();
    let sl = sd.sderives.as_slice();
    let p = sd.spos;
    let mut i = 0 as u32;
    while i < n {
        let tr = sl[i];
        if str::eq(tr, "Eq") {
            push_derive_method(a, ar, sc, sd.sname, "eq", ann_bool(ar), true, derive_eq_struct_body(a, ar, &sd.sfields, p), true, methods, lifted, gsigs);
            push_derive_method_k(a, ar, sc, sd.sname, "ne", ann_bool(ar), true, derive_ne_body(a, ar, p), true, 4 as int, methods, lifted, gsigs);
        }
        if str::eq(tr, "Hash") {
            push_derive_method(a, ar, sc, sd.sname, "hash", tyann_node(ar, TypeAnn::TyInt { is_signed: false, width: IntWidth::W32 }), false, derive_hash_struct_body(a, ar, &sd.sfields, p), true, methods, lifted, gsigs);
        }
        if str::eq(tr, "Clone") {
            push_derive_method(a, ar, sc, sd.sname, "clone", closure_struct_ann(a, ar, sd.sname), false, derive_clone_struct_body(a, ar, sd.sname, &sd.sfields, p), true, methods, lifted, gsigs);
        }
        if str::eq(tr, "Debug") {
            push_fmt_debug(a, ar, sd.sname, fmt_debug_struct_body(a, ar, sd.sname, &sd.sfields, p), methods, lifted);
        }
        i = i + 1 as u32;
    }
}
fn dv_payload_tuple_name(a: Allocator, ar: *Arena, base: str, i: u32) -> str { return gensym_name(a, ar, base, i); }
fn dv_payload_struct_name(a: Allocator, ar: *Arena, base: str, field: str) -> str { return str2(a, ar, str2(a, ar, base, "_"), field); }
fn variant_binds(a: Allocator, ar: *Arena, vkind: *const VariantKind, base: str) -> PatBinds {
    return match *vkind {
        VariantKind::VUnit => { let e: Vec<Pattern> = Vec::with_capacity(a, 8 as u32); PatBinds::PBTuple(e) }
        | VariantKind::VTuple(tys) => {
            let mut ps: Vec<Pattern> = Vec::with_capacity(a, 8 as u32);
            let nt = tys.length();
            let mut it = 0 as u32;
            while it < nt { ps.push(Pattern::PVar(dv_payload_tuple_name(a, ar, base, it), zero_pos())); it = it + 1 as u32; }
            PatBinds::PBTuple(ps)
        }
        | VariantKind::VStruct(fields) => {
            let mut fps: Vec<FieldPat> = Vec::with_capacity(a, 8 as u32);
            let nf = fields.length();
            let fsl = fields.as_slice();
            let mut jf = 0 as u32;
            while jf < nf { fps.push(FieldPat { name: fsl[jf].name, pat: Pattern::PVar(dv_payload_struct_name(a, ar, base, fsl[jf].name), zero_pos()) }); jf = jf + 1 as u32; }
            PatBinds::PBStruct(fps)
        }
    };
}
fn variant_payload_vars(a: Allocator, ar: *Arena, vkind: *const VariantKind, base: str, p: Pos) -> Vec<*const Expr> {
    let mut out: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    match *vkind {
        VariantKind::VUnit => {}
        | VariantKind::VTuple(tys) => { let nt = tys.length(); let mut it = 0 as u32; while it < nt { out.push(dv_var(ar, dv_payload_tuple_name(a, ar, base, it), p)); it = it + 1 as u32; } }
        | VariantKind::VStruct(fields) => { let nf = fields.length(); let fsl = fields.as_slice(); let mut jf = 0 as u32; while jf < nf { out.push(dv_var(ar, dv_payload_struct_name(a, ar, base, fsl[jf].name), p)); jf = jf + 1 as u32; } }
    }
    return out;
}
fn build_variant_pat(a: Allocator, ar: *Arena, ename: str, vname: str, vkind: *const VariantKind, base: str) -> Pattern {
    return Pattern::PVariant { tname: single_str(a, ename), variant: vname, binds: variant_binds(a, ar, vkind, base), pos: zero_pos() };
}
fn push_eq_arm(a: Allocator, ar: *Arena, ename: str, vname: str, vkind: *const VariantKind, nvar: u32, p: Pos, out: *Vec<MatchArm>) {
    let no_guard: Option<*const Expr> = Option::None;
    let self_pat = build_variant_pat(a, ar, ename, vname, vkind, "__de_a");
    let inner_pat = build_variant_pat(a, ar, ename, vname, vkind, "__de_b");
    let avars = variant_payload_vars(a, ar, vkind, "__de_a", p);
    let bvars = variant_payload_vars(a, ar, vkind, "__de_b", p);
    let mut cmps: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    let np = avars.length();
    let asl = avars.as_slice();
    let bsl = bvars.as_slice();
    let mut k = 0 as u32;
    while k < np { cmps.push(ast_node(ar, Expr::BinOp(BinOp::EqEq, asl[k], bsl[k], p))); k = k + 1 as u32; }
    let cmp = dv_and_fold(ar, &cmps, p);
    let mut inner_arms: Vec<MatchArm> = Vec::with_capacity(a, 8 as u32);
    inner_arms.push(MatchArm { pat: inner_pat, guard: no_guard, body: cmp, arm_pos: zero_pos() });
    if nvar > 1 as u32 { inner_arms.push(MatchArm { pat: Pattern::PWildcard(zero_pos()), guard: no_guard, body: ast_node(ar, Expr::BoolLit(false, p)), arm_pos: zero_pos() }); }
    let inner_match = ast_node(ar, Expr::Match { scrutinee: ast_node(ar, Expr::Deref(dv_var(ar, "other", p), p)), arms: inner_arms, pos: p });
    out.push(MatchArm { pat: self_pat, guard: no_guard, body: inner_match, arm_pos: zero_pos() });
}
fn derive_eq_enum_body(a: Allocator, ar: *Arena, ename: str, variants: *const Vec<EnumVariant>, p: Pos) -> *const Expr {
    let nvar = variants.length();
    let vsl = variants.as_slice();
    let mut outer_arms: Vec<MatchArm> = Vec::with_capacity(a, 8 as u32);
    let mut vi = 0 as u32;
    while vi < nvar { push_eq_arm(a, ar, ename, vsl[vi].vname, &vsl[vi].vkind, nvar, p, &outer_arms); vi = vi + 1 as u32; }
    return ast_node(ar, Expr::Match { scrutinee: ast_node(ar, Expr::Deref(dv_var(ar, "self", p), p)), arms: outer_arms, pos: p });
}
fn push_hash_arm(a: Allocator, ar: *Arena, ename: str, vname: str, vkind: *const VariantKind, tag: u32, p: Pos, out: *Vec<MatchArm>) {
    let no_guard: Option<*const Expr> = Option::None;
    let self_pat = build_variant_pat(a, ar, ename, vname, vkind, "__dh");
    let seed = dv_cast_u32(ar, ast_node(ar, Expr::IntLit(tag as int, p)), p);
    let vals = variant_payload_vars(a, ar, vkind, "__dh", p);
    let body = dv_hash_fold(ar, seed, &vals, p);
    out.push(MatchArm { pat: self_pat, guard: no_guard, body: body, arm_pos: zero_pos() });
}
fn derive_hash_enum_body(a: Allocator, ar: *Arena, ename: str, variants: *const Vec<EnumVariant>, p: Pos) -> *const Expr {
    let nvar = variants.length();
    let vsl = variants.as_slice();
    let mut outer_arms: Vec<MatchArm> = Vec::with_capacity(a, 8 as u32);
    let mut vi = 0 as u32;
    while vi < nvar { push_hash_arm(a, ar, ename, vsl[vi].vname, &vsl[vi].vkind, vi, p, &outer_arms); vi = vi + 1 as u32; }
    return ast_node(ar, Expr::Match { scrutinee: ast_node(ar, Expr::Deref(dv_var(ar, "self", p), p)), arms: outer_arms, pos: p });
}
fn collect_derives_enum(a: Allocator, ar: *Arena, sc: *const TyScope, ed: *const EnumDecl, methods: *Vec<MethodInfo>, lifted: *Vec<LiftedLambda>, gsigs: *Vec<FnSig>) {
    let n = ed.ederives.length();
    let sl = ed.ederives.as_slice();
    let p = ed.epos;
    let mut i = 0 as u32;
    while i < n {
        let tr = sl[i];
        if str::eq(tr, "Eq") {
            push_derive_method(a, ar, sc, ed.ename, "eq", ann_bool(ar), true, derive_eq_enum_body(a, ar, ed.ename, &ed.evariants, p), true, methods, lifted, gsigs);
            push_derive_method_k(a, ar, sc, ed.ename, "ne", ann_bool(ar), true, derive_ne_body(a, ar, p), true, 4 as int, methods, lifted, gsigs);
        }
        if str::eq(tr, "Hash") {
            push_derive_method(a, ar, sc, ed.ename, "hash", tyann_node(ar, TypeAnn::TyInt { is_signed: false, width: IntWidth::W32 }), false, derive_hash_enum_body(a, ar, ed.ename, &ed.evariants, p), true, methods, lifted, gsigs);
        }
        if str::eq(tr, "Debug") {
            push_fmt_debug(a, ar, ed.ename, fmt_debug_enum_body(a, ar, ed.ename, &ed.evariants, p), methods, lifted);
        }
        i = i + 1 as u32;
    }
}
// ----- @derive(Debug) → fmt_debug (writer-pattern, void) -----
fn dv_cast_i32(ar: *Arena, e: *const Expr, p: Pos) -> *const Expr {
    return ast_node(ar, Expr::Cast(e, tyann_node(ar, TypeAnn::TyInt { is_signed: true, width: IntWidth::W32 }), p));
}
fn is_str_ann(t: *const TypeAnn) -> bool {
    return match *t { TypeAnn::TyStr => true | _other => false };
}
fn out_push_stmt(a: Allocator, ar: *Arena, mname: str, arg: *const Expr, p: Pos) -> Stmt {
    let mut args: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    args.push(arg);
    return Stmt::ExprStmt(ast_node(ar, Expr::MethodCall { receiver: dv_var(ar, "out", p), name: mname, args: args, pos: p }));
}
fn push_lit(a: Allocator, ar: *Arena, s: str, p: Pos) -> Stmt {
    return out_push_stmt(a, ar, "push_str", ast_node(ar, Expr::StringLit(s, p)), p);
}
fn push_byte_lit(a: Allocator, ar: *Arena, b: int, p: Pos) -> Stmt {
    let bv = ast_node(ar, Expr::Cast(ast_node(ar, Expr::IntLit(b, p)), tyann_node(ar, TypeAnn::TyInt { is_signed: false, width: IntWidth::W8 }), p));
    return out_push_stmt(a, ar, "push_byte", bv, p);
}
// Emit the formatting of one value (int → push_int; str → quoted push_str).
fn push_value(a: Allocator, ar: *Arena, value: *const Expr, is_str: bool, p: Pos, out: *Vec<Stmt>) {
    if is_str {
        out.push(push_byte_lit(a, ar, 34 as int, p));
        out.push(out_push_stmt(a, ar, "push_str", value, p));
        out.push(push_byte_lit(a, ar, 34 as int, p));
    } else {
        out.push(out_push_stmt(a, ar, "push_int", dv_cast_i32(ar, value, p), p));
    }
}
fn fmt_debug_struct_body(a: Allocator, ar: *Arena, sname: str, sfields: *const Vec<FieldDef>, p: Pos) -> *const Expr {
    let mut stmts: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    stmts.push(push_lit(a, ar, str2(a, ar, sname, " { "), p));
    let n = sfields.length();
    let sl = sfields.as_slice();
    let mut i = 0 as u32;
    while i < n {
        if i > 0 as u32 { stmts.push(push_lit(a, ar, ", ", p)); }
        stmts.push(push_lit(a, ar, str2(a, ar, sl[i].name, ": "), p));
        push_value(a, ar, dv_field(ar, "self", sl[i].name, p), is_str_ann(sl[i].ty), p, &stmts);
        i = i + 1 as u32;
    }
    stmts.push(push_lit(a, ar, " }", p));
    return ast_node(ar, Expr::Block(stmts, p));
}
// One match arm formatting a variant into `out`.
fn push_fmt_arm(a: Allocator, ar: *Arena, ename: str, v: *const EnumVariant, p: Pos, out: *Vec<MatchArm>) {
    let no_guard: Option<*const Expr> = Option::None;
    let qual = str2(a, ar, str2(a, ar, ename, "::"), v.vname);
    let self_pat = build_variant_pat(a, ar, ename, v.vname, &v.vkind, "__dd");
    let mut bstmts: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    match v.vkind {
        VariantKind::VUnit => { bstmts.push(push_lit(a, ar, qual, p)); }
        | VariantKind::VTuple(tys) => {
            bstmts.push(push_lit(a, ar, str2(a, ar, qual, "("), p));
            let nt = tys.length();
            let tsl = tys.as_slice();
            let mut it = 0 as u32;
            while it < nt {
                if it > 0 as u32 { bstmts.push(push_lit(a, ar, ", ", p)); }
                push_value(a, ar, dv_var(ar, dv_payload_tuple_name(a, ar, "__dd", it), p), is_str_ann(tsl[it]), p, &bstmts);
                it = it + 1 as u32;
            }
            bstmts.push(push_byte_lit(a, ar, 41 as int, p));
        }
        | VariantKind::VStruct(fields) => {
            bstmts.push(push_lit(a, ar, str2(a, ar, qual, " { "), p));
            let nf = fields.length();
            let fsl = fields.as_slice();
            let mut jf = 0 as u32;
            while jf < nf {
                if jf > 0 as u32 { bstmts.push(push_lit(a, ar, ", ", p)); }
                bstmts.push(push_lit(a, ar, str2(a, ar, fsl[jf].name, ": "), p));
                push_value(a, ar, dv_var(ar, dv_payload_struct_name(a, ar, "__dd", fsl[jf].name), p), is_str_ann(fsl[jf].ty), p, &bstmts);
                jf = jf + 1 as u32;
            }
            bstmts.push(push_lit(a, ar, " }", p));
        }
    }
    out.push(MatchArm { pat: self_pat, guard: no_guard, body: ast_node(ar, Expr::Block(bstmts, p)), arm_pos: zero_pos() });
}
fn fmt_debug_enum_body(a: Allocator, ar: *Arena, ename: str, variants: *const Vec<EnumVariant>, p: Pos) -> *const Expr {
    let nvar = variants.length();
    let vsl = variants.as_slice();
    let mut arms: Vec<MatchArm> = Vec::with_capacity(a, 8 as u32);
    let mut vi = 0 as u32;
    while vi < nvar { push_fmt_arm(a, ar, ename, &vsl[vi], p, &arms); vi = vi + 1 as u32; }
    let m = ast_node(ar, Expr::Match { scrutinee: ast_node(ar, Expr::Deref(dv_var(ar, "self", p), p)), arms: arms, pos: p });
    let mut stmts: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    stmts.push(Stmt::ExprStmt(m));
    return ast_node(ar, Expr::Block(stmts, p));
}
// Register fmt_debug (params self + `out: *StringBuilder`, void) and drain it.
fn push_fmt_debug(a: Allocator, ar: *Arena, target: str, body: *const Expr,
                  methods: *Vec<MethodInfo>, lifted: *Vec<LiftedLambda>) {
    let tp = single_str(a, target);
    let mangled = method_mangle(a, ar, &tp, "fmt_debug");
    let out_ann = tyann_node(ar, TypeAnn::TyPtr(closure_struct_ann(a, ar, "StringBuilder")));
    let mut manns: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    manns.push(dv_const_ptr(a, ar, target));
    manns.push(out_ann);
    let none_ret: Option<*const TypeAnn> = Option::None;
    let empty_tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    methods.push(MethodInfo {
        mi_path: single_str(a, target), mi_name: "fmt_debug", mi_mangled: mangled,
        mi_ret: none_ty(), mi_has_self: true, mi_self_ptr: true, mi_self_const: true,
        mi_tparams: empty_tp, mi_params: manns, mi_ret_ann: none_ret,
        mi_impl_idx: 0 as u32, mi_meth_idx: 0 as u32, mi_prelude: false, mi_struct_gen: false
    });
    let mut params: Vec<FieldDef> = Vec::with_capacity(a, 8 as u32);
    params.push(FieldDef { name: "out", ty: tyann_node(ar, TypeAnn::TyPtr(closure_struct_ann(a, ar, "StringBuilder"))) });
    let ec: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let eb: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let nr: Option<*const TypeAnn> = Option::None;
    lifted.push(LiftedLambda {
        ll_mangled: mangled, ll_name: mangled, ll_expr: body, ll_kind: 2 as int,
        ll_closure: target, ll_params: params, ll_ret: nr, ll_caps: ec, ll_brefs: eb, ll_lambda: body
    });
}
fn collect_derives_item(a: Allocator, ar: *Arena, sc: *const TyScope, it: *const Item, methods: *Vec<MethodInfo>, lifted: *Vec<LiftedLambda>, gsigs: *Vec<FnSig>) {
    match *it {
        Item::Struct(sd) => collect_derives_struct(a, ar, sc, &sd, methods, lifted, gsigs)
        | Item::Enum(ed) => collect_derives_enum(a, ar, sc, &ed, methods, lifted, gsigs)
        | _other => {}
    }
}
fn collect_derives(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>, methods: *Vec<MethodInfo>, lifted: *Vec<LiftedLambda>, gsigs: *Vec<FnSig>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n { collect_derives_item(a, ar, sc, &sl[i], methods, lifted, gsigs); i = i + 1 as u32; }
}

// ===== DR-030 drop synthesis ===========================================
// Every struct with an `own *T` field gets a `<Struct>__drop(*self)` that
// frees each own field through the allocator seam:
//   self.alloc.free_fn(self.alloc.state, self.<f> as *c_void, size_of(T) as u32)
// (Auto-drop INJECTION at scope-exit is a post-typecheck pass, so the
// typed-IR dump carries the method but no calls to it.)
fn dv_field_of(ar: *Arena, recv: *const Expr, f: str, p: Pos) -> *const Expr {
    return ast_node(ar, Expr::FieldAccess(recv, f, p));
}
fn dv_cvoid_ptr_ann(ar: *Arena) -> *const TypeAnn {
    return tyann_node(ar, TypeAnn::TyPtr(tyann_node(ar, TypeAnn::TyCVoid)));
}
fn ann_is_own(t: *const TypeAnn) -> bool {
    return match *t { TypeAnn::TyOwnPtr(inner) => true | _other => false };
}
fn push_drop_free(a: Allocator, ar: *Arena, fname: str, pointee: *const TypeAnn, p: Pos, out: *Vec<Stmt>) {
    let recv = dv_field(ar, "self", "alloc", p);
    let state_arg = dv_field_of(ar, dv_field(ar, "self", "alloc", p), "state", p);
    let ptr_arg = ast_node(ar, Expr::Cast(dv_field(ar, "self", fname, p), dv_cvoid_ptr_ann(ar), p));
    let size_arg = ast_node(ar, Expr::Cast(ast_node(ar, Expr::SizeOf(pointee, p)), tyann_node(ar, TypeAnn::TyInt { is_signed: false, width: IntWidth::W32 }), p));
    let mut args: Vec<*const Expr> = Vec::with_capacity(a, 8 as u32);
    args.push(state_arg);
    args.push(ptr_arg);
    args.push(size_arg);
    out.push(Stmt::ExprStmt(ast_node(ar, Expr::MethodCall { receiver: recv, name: "free_fn", args: args, pos: p })));
}
fn drop_body(a: Allocator, ar: *Arena, sfields: *const Vec<FieldDef>, p: Pos) -> *const Expr {
    let mut stmts: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    let n = sfields.length();
    let sl = sfields.as_slice();
    let mut i = 0 as u32;
    while i < n {
        match *sl[i].ty { TypeAnn::TyOwnPtr(pointee) => push_drop_free(a, ar, sl[i].name, pointee, p, &stmts) | _other => {} }
        i = i + 1 as u32;
    }
    return ast_node(ar, Expr::Block(stmts, p));
}
fn struct_has_own(sfields: *const Vec<FieldDef>) -> bool {
    let n = sfields.length();
    let sl = sfields.as_slice();
    let mut i = 0 as u32;
    while i < n { if ann_is_own(sl[i].ty) { return true; } i = i + 1 as u32; }
    return false;
}
fn push_drop_method(a: Allocator, ar: *Arena, sname: str, body: *const Expr, methods: *Vec<MethodInfo>, lifted: *Vec<LiftedLambda>) {
    let tp = single_str(a, sname);
    let mangled = method_mangle(a, ar, &tp, "drop");
    let self_ann = tyann_node(ar, TypeAnn::TyPtr(closure_struct_ann(a, ar, sname)));
    let mut manns: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    manns.push(self_ann);
    let none_ret: Option<*const TypeAnn> = Option::None;
    let empty_tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    methods.push(MethodInfo {
        mi_path: single_str(a, sname), mi_name: "drop", mi_mangled: mangled,
        mi_ret: none_ty(), mi_has_self: true, mi_self_ptr: true, mi_self_const: false,
        mi_tparams: empty_tp, mi_params: manns, mi_ret_ann: none_ret,
        mi_impl_idx: 0 as u32, mi_meth_idx: 0 as u32, mi_prelude: false, mi_struct_gen: false
    });
    let mut params: Vec<FieldDef> = Vec::with_capacity(a, 8 as u32);
    params.push(FieldDef { name: "self", ty: tyann_node(ar, TypeAnn::TyPtr(closure_struct_ann(a, ar, sname))) });
    let nr: Option<*const TypeAnn> = Option::None;
    let ec: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let eb: Vec<str> = Vec::with_capacity(a, 8 as u32);
    lifted.push(LiftedLambda {
        ll_mangled: mangled, ll_name: mangled, ll_expr: body, ll_kind: 3 as int,
        ll_closure: sname, ll_params: params, ll_ret: nr, ll_caps: ec, ll_brefs: eb, ll_lambda: body
    });
}
fn collect_drops_struct(a: Allocator, ar: *Arena, sd: *const StructDecl, methods: *Vec<MethodInfo>, lifted: *Vec<LiftedLambda>) {
    if struct_has_own(&sd.sfields) { push_drop_method(a, ar, sd.sname, drop_body(a, ar, &sd.sfields, sd.spos), methods, lifted); }
    return;
}
fn collect_drops_item(a: Allocator, ar: *Arena, it: *const Item, methods: *Vec<MethodInfo>, lifted: *Vec<LiftedLambda>) {
    match *it {
        Item::Struct(sd) => collect_drops_struct(a, ar, &sd, methods, lifted)
        | _other => {}
    }
}
fn collect_drops(a: Allocator, ar: *Arena, items: *const Vec<Item>, methods: *Vec<MethodInfo>, lifted: *Vec<LiftedLambda>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n { collect_drops_item(a, ar, &sl[i], methods, lifted); i = i + 1 as u32; }
}

// ===== DR-009 active patterns (`view`) =================================
// A `view Name(p: T) -> A | B(U) { body }` desugars to a choice ENUM `Name`
// plus a FUNCTION `Name(p: T) -> Name` whose body is `body`.  A `match scr {
// Name::A => .. }` whose scrutinee isn't already the enum is rewritten to
// `match Name(scr) { .. }` (the view-fn call) at elab time.
fn view_case_kind(a: Allocator, c: *const ViewCase) -> VariantKind {
    if c.vcis_struct { return VariantKind::VStruct(copy_fielddefs(a, &c.vcfields)); }
    if c.vcfields.length() == 0 as u32 { return VariantKind::VUnit; }
    let mut tys: Vec<*const TypeAnn> = Vec::with_capacity(a, 8 as u32);
    let n = c.vcfields.length();
    let sl = c.vcfields.as_slice();
    let mut i = 0 as u32;
    while i < n { tys.push(sl[i].ty); i = i + 1 as u32; }
    return VariantKind::VTuple(tys);
}
fn collect_view_one(a: Allocator, ar: *Arena, sc: *const TyScope, epath: *const Vec<str>, c: *const ViewCase, tag: int, etags: *Vec<EnumVariantTag>, efields: *Vec<EnumFieldE>) {
    push_etag(a, epath, c.vcname, tag, etags);
    let vk = view_case_kind(a, c);
    push_variant_fields(a, ar, sc, epath, c.vcname, &vk, efields);
}
fn collect_view_variants(a: Allocator, ar: *Arena, sc: *const TyScope, epath: *const Vec<str>, vcases: *const Vec<ViewCase>, etags: *Vec<EnumVariantTag>, efields: *Vec<EnumFieldE>) {
    let n = vcases.length();
    let sl = vcases.as_slice();
    let mut i = 0 as u32;
    while i < n { collect_view_one(a, ar, sc, epath, &sl[i], i as int, etags, efields); i = i + 1 as u32; }
}
// Elaborate the view function `<vname>(p) -> <vname>` (mirrors elaborate_lifted
// but its body is a statement list, not a single expr).
fn elaborate_view(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx, vd: *const ViewDecl, funcs: *Vec<Tfunc>) {
    let name = mangle_path(a, ar, idx.pi_modpath, vd.vname);
    let mut params_fd: Vec<FieldDef> = Vec::with_capacity(a, 8 as u32);
    params_fd.push(FieldDef { name: vd.vparam.pname, ty: vd.vparam.pty });
    let lparams = lam_to_params(a, &params_fd);
    let params = copy_params(a, &lparams);
    let empty_tp: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let ret_ann: Option<*const TypeAnn> = Option::Some(closure_struct_ann(a, ar, vd.vname));
    let sc = TyScope { sc_structs: idx.pi_snames, sc_enums: idx.pi_enames, sc_tparams: &empty_tp,
                       sc_iconsts: idx.pi_iconsts, sc_sinfo: idx.pi_sinfo, sc_etags: idx.pi_etags, sc_efields: idx.pi_efields, sc_methods: idx.pi_methods,
                       sc_mono_structs: idx.pi_mono_structs, sc_mono_sargs: idx.pi_mono_sargs, sc_mono_enums: idx.pi_mono_enums, sc_mono_eargs: idx.pi_mono_eargs, sc_mono_fields: idx.pi_mono_fields, sc_mono_efields: idx.pi_mono_efields,
                       sc_tbinds: idx.pi_tbinds, sc_genfns: idx.pi_genfns, sc_genjobs: idx.pi_genjobs, sc_geninsts: idx.pi_geninsts, sc_etps: idx.pi_etps, sc_stps: idx.pi_stps, sc_assoc: idx.pi_assoc, sc_lifted: idx.pi_lifted, sc_gensym: gensym, sc_modpath: idx.pi_modpath, sc_ret: none_ty(), sc_self: none_ty(), sc_gsigs: idx.pi_gsigs, sc_xstructs: idx.pi_xstructs, sc_xaliases: idx.pi_xaliases, sc_taliases: idx.pi_taliases, sc_err: idx.pi_err, sc_srcnames: idx.pi_srcnames, sc_srcbase: idx.pi_srcbase, sc_binds: idx.pi_binds, sc_bindbase: idx.pi_bindbase, sc_is_main: false };
    let param_tys = resolve_param_tys(a, ar, &sc, &lparams);
    let ret = resolve_sig_ret(a, ar, &sc, ret_ann);
    let mut env: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    build_param_env(a, ar, &sc, &lparams, &env);
    let scb = scope_with_ret(&sc, ret);
    let raw_body = elab_body(a, ar, g, &scb, gensym, &env, ret, &vd.vbody);
    let mut lift_ctr: u32 = 0 as u32;
    let body = lift_stmts(a, ar, &lift_ctr, &raw_body);
    let lets = collect_body_lets(a, &body);
    let no_pos: Option<Pos> = Option::None;
    let path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let tparams2: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let tbounds: Vec<TraitBound> = Vec::with_capacity(a, 8 as u32);
    let dummy_body: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    let no_lib: Option<str> = Option::None;
    let no_tier: Option<str> = Option::None;
    let tf_func = Func {
        name: name, c_name: name, tparams: tparams2, tbounds: tbounds,
        params: params, ret_ty: ret_ann, body: dummy_body, is_pub: vd.vis_pub,
        is_extern: false, is_variadic: false, amiga_lib: no_lib,
        tier_hint: no_tier, must_use: false, escapes_hatch: false, pos: zero_pos(),
    };
    funcs.push(Tfunc {
        tf_path: path, tf_func: tf_func, tf_mangled: name, tf_param_tys: param_tys,
        tf_ret_ty: ret, tf_body: body, tf_lets: lets, tf_origin_pos: no_pos,
    });
}

fn prelude_enum_tps(a: Allocator, out: *Vec<EnumTP>) {
    let mut t1: Vec<str> = Vec::with_capacity(a, 8 as u32);
    t1.push("T");
    push_enum_tp(a, "Option", &t1, out);
    let mut t2: Vec<str> = Vec::with_capacity(a, 8 as u32);
    t2.push("T");
    t2.push("E");
    push_enum_tp(a, "Result", &t2, out);
}

// Elaborate one generic-fn instance: re-derive the source fn from its item
// index (a stable borrow into `items`) and elaborate it under the bindings.
fn elaborate_instance(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx,
                      items: *const Vec<Item>, gi: u32, tbinds: *const Vec<TVarBind>, mangled: str, funcs: *Vec<Tfunc>) {
    let sl = items.as_slice();
    match sl[gi] {
        Item::Function(f) => { funcs.push(elaborate_fn(a, ar, g, gensym, idx, tbinds, idx.pi_modpath, mangled, &f, none_ty(), &f.tparams)); }
        | _e => { }
    }
}

// Push happens behind a fn boundary so `f` is a parameter (not the address
// of a local slice element) — same escape-checker shape as the free-fn path.
fn push_method_inst(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx,
                    tbinds: *const Vec<TVarBind>, mangled: str, f: *const Func, self_ty: Option<*const Typ>, funcs: *Vec<Tfunc>) {
    funcs.push(elaborate_fn(a, ar, g, gensym, idx, tbinds, idx.pi_modpath, mangled, f, self_ty, &f.tparams));
}
fn elaborate_impl_method_at(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx,
                            methods: *const Vec<Func>, meth_idx: u32, tbinds: *const Vec<TVarBind>,
                            mangled: str, self_ty: Option<*const Typ>, funcs: *Vec<Tfunc>) {
    let msl = methods.as_slice();
    push_method_inst(a, ar, g, gensym, idx, tbinds, mangled, &msl[meth_idx], self_ty, funcs);
}

// Elaborate one generic-method instance: re-derive the method fn from its
// source item + method index, then elaborate its body under the bindings.  A
// regular impl method has its `self` parser-stamped; a generic default (whose
// source fn is in the trait at `impl_idx`) gets `Self` from `target`.
fn elaborate_method_instance(a: Allocator, ar: *Arena, g: *const Vec<GlobalFn>, gensym: *u32, idx: *const ProgIdx,
                             items: *const Vec<Item>, impl_idx: u32, meth_idx: u32, tbinds: *const Vec<TVarBind>,
                             mangled: str, target: *const Vec<str>, funcs: *Vec<Tfunc>) {
    let sl = items.as_slice();
    match sl[impl_idx] {
        Item::Impl(ib) => { elaborate_impl_method_at(a, ar, g, gensym, idx, &ib.iitems, meth_idx, tbinds, mangled, none_ty(), funcs); }
        | Item::Trait(td) => {
            let sty = ty_node(ar, Typ::TStruct(copy_strs(a, target)));
            elaborate_impl_method_at(a, ar, g, gensym, idx, &td.trmethods, meth_idx, tbinds, mangled, Option::Some(sty), funcs);
        }
        // `mod str` free function: elaborate as a plain free fn under the module
        // path so its body's sibling `str::*` calls resolve, with the mangled
        // name fixed by the registry (str__eq / str__as_bytes / ...).
        | Item::Module(md) => {
            let mmsl = md.mitems.as_slice();
            match mmsl[meth_idx] {
                Item::Function(mf) => {
                    let mut mp: Vec<str> = Vec::with_capacity(a, 8 as u32);
                    mp.push(md.mname);
                    funcs.push(elaborate_fn(a, ar, g, gensym, idx, tbinds, &mp, mangled, &mf, none_ty(), &mf.tparams));
                }
                | _mo => { }
            }
        }
        | _e => { }
    }
}

// First pass: collect the signature of every top-level fn so a direct call
// resolves to (mangled symbol, return type) before bodies are elaborated.
// `is_top` is true only at the top level (path empty); module-internal
// symbols are reachable solely via their `mod::name` path.  An `extern fn`
// keeps its C name; otherwise `mangle_path` applies.
fn collect_one(a: Allocator, ar: *Arena, sc: *const TyScope, it: *const Item, path: *const Vec<str>, g: *Vec<GlobalFn>) {
    let is_top = path.length() == 0 as u32;
    match *it {
        Item::Function(f) => {
            // An extern fn keeps its C name when emitted, but a module-nested
            // one still resolves via its `mod__name` path key.
            let lk = if f.is_extern && !is_top { mangle_path(a, ar, path, f.name) } else { collect_fn_mangle(a, ar, &f, path) };
            let em = if f.is_extern { f.c_name } else { lk };
            // Resolve the return under the fn's own type parameters so a generic
            // fn's `Option<I::Item>` stays an assoc-projection marker (the real
            // result types come per-instance via elab_gen_call) instead of
            // mangling a bogus `Option_I__Item` instance into the footer.  The
            // module path must ride along too: a module fn's bare return type
            // (`IdentPos` inside `mod parser`) resolves module-relative to
            // `parser::IdentPos`, matching how the type is registered.
            let msc = scope_with_modpath(sc, path);
            let fsc = scope_with_tparams(&msc, &f.tparams);
            g.push(GlobalFn { name: f.name, mangled: lk, gf_emit: em, ret: resolve_sig_ret(a, ar, &fsc, f.ret_ty),
                              is_const: false, is_top: is_top });
        }
        | Item::View(vd) => {
            // The view fn `Name(p) -> Name` (DR-009); the choice enum shares its name.
            let vm = mangle_path(a, ar, path, vd.vname);
            g.push(GlobalFn { name: vd.vname, mangled: vm, gf_emit: vm,
                              ret: Option::Some(ty_node(ar, Typ::TEnum(single_str(a, vd.vname)))),
                              is_const: false, is_top: is_top });
        }
        | Item::Const(c) => {
            let cm = mangle_path(a, ar, path, c.kname);
            g.push(GlobalFn { name: c.kname, mangled: cm, gf_emit: cm,
                              ret: Option::Some(resolve_sig_ty(a, ar, sc, c.kty)),
                              is_const: true, is_top: is_top });
        }
        | Item::ExternConst(ec) => {
            // A linker-resolved global value; its C symbol is visible
            // unqualified everywhere (no module mangling).
            g.push(GlobalFn { name: ec.ecname, mangled: ec.ecname, gf_emit: ec.ecname,
                              ret: Option::Some(resolve_sig_ty(a, ar, sc, ec.ecty)),
                              is_const: true, is_top: true });
        }
        | Item::ExternVar(ev) => {
            g.push(GlobalFn { name: ev.evname, mangled: ev.evname, gf_emit: ev.evname,
                              ret: Option::Some(resolve_sig_ty(a, ar, sc, ev.evty)),
                              is_const: true, is_top: true });
        }
        | Item::Module(md) => {
            let mut p2: Vec<str> = copy_strs(a, path);
            p2.push(md.mname);
            collect_into(a, ar, sc, &md.mitems, &p2, g);
        }
        | Item::Use { path, is_wildcard, is_pub } => { collect_use(a, ar, &path, is_wildcard, g); }
        | _e => { }
    }
}

// `use mod::name;` re-exports `name` into the enclosing scope: alias the
// last segment to the target's already-collected symbol (wildcard
// re-exports are not yet supported).
fn push_use_alias(g: *Vec<GlobalFn>, target_mangled: str, alias: str) {
    match global_lookup_by_mangled(g, target_mangled) {
        Option::Some(gf) => { g.push(GlobalFn { name: alias, mangled: gf.mangled, gf_emit: gf.gf_emit, ret: gf.ret,
                                                is_const: gf.is_const, is_top: true }); }
        | Option::None => { }
    }
}
fn collect_use(a: Allocator, ar: *Arena, path: *const Vec<str>, is_wildcard: bool, g: *Vec<GlobalFn>) {
    if is_wildcard { return; }
    if path.length() < 2 as u32 { return; }
    let last = path_last(path);
    let init = path_init(a, path);
    let m = mangle_path(a, ar, &init, last);
    push_use_alias(g, m, last);
}

fn collect_fn_mangle(a: Allocator, ar: *Arena, f: *const Func, path: *const Vec<str>) -> str {
    if f.is_extern { return f.c_name; }
    if path.length() == 0 as u32 && str::eq(f.name, "main") { return "main"; }
    return mangle_path(a, ar, path, f.name);
}

fn collect_into(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>, path: *const Vec<str>, g: *Vec<GlobalFn>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n {
        collect_one(a, ar, sc, &sl[i], path, g);
        i = i + 1 as u32;
    }
}

fn collect_globals(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>) -> Vec<GlobalFn> {
    let mut g: Vec<GlobalFn> = Vec::with_capacity(a, 16 as u32);
    let top: Vec<str> = Vec::with_capacity(a, 8 as u32);
    collect_into(a, ar, sc, items, &top, &g);
    register_prelude_globals(a, ar, &g);
    return g;
}

// An extern `sys` seam fn (DR-032): module-internal (reachable solely via
// `sys::name` -> mangled `sys__name`), emitted by its raw C name.
fn push_sys_fn(a: Allocator, ar: *Arena, name: str, ret: Option<*const Typ>, g: *Vec<GlobalFn>) {
    g.push(GlobalFn { name: name, mangled: str2(a, ar, "sys__", name), gf_emit: name,
                      ret: ret, is_const: false, is_top: false });
}

// The synthesised `sys` module — extern syscalls over the host/amiga seam.
// Mirrors the oracle's prelude `sys` module: bodies are extern, so only the
// return type participates in typecheck; `sys::sys_open(...)` resolves through
// the `sys__sys_open` mangle to a `(call sys_open ...)` of the declared result.
fn register_prelude_globals(a: Allocator, ar: *Arena, g: *Vec<GlobalFn>) {
    let cint: Option<*const Typ> = Option::Some(ty_node(ar, Typ::TCInt { is_signed: true }));
    let clong: Option<*const Typ> = Option::Some(ty_node(ar, Typ::TCLong { is_signed: true }));
    let cvoidp: Option<*const Typ> = Option::Some(ty_node(ar, Typ::TPtr(ty_node(ar, Typ::TCVoid))));
    let novoid: Option<*const Typ> = Option::None;
    push_sys_fn(a, ar, "sys_alloc", cvoidp, g);
    push_sys_fn(a, ar, "sys_free", novoid, g);
    push_sys_fn(a, ar, "sys_write", clong, g);
    push_sys_fn(a, ar, "sys_read", clong, g);
    push_sys_fn(a, ar, "sys_open", cint, g);
    push_sys_fn(a, ar, "sys_close", cint, g);
    // Round-trip float formatting for codegen (libc snprintf over the seam);
    // compile-time only, never in a user program's output.
    let culong: Option<*const Typ> = Option::Some(ty_node(ar, Typ::TCLong { is_signed: false }));
    push_sys_fn(a, ar, "sys_fmt_f64", culong, g);
}

fn collect_fn_sigs_one(a: Allocator, ar: *Arena, sc: *const TyScope, it: *const Item, path: *const Vec<str>, out: *Vec<FnSig>) {
    match *it {
        Item::Function(f) => {
            out.push(FnSig { fs_mangled: collect_fn_mangle(a, ar, &f, path), fs_params: resolve_param_tys(a, ar, sc, &f.params) });
        }
        | Item::View(vd) => {
            let mut vp: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
            vp.push(resolve_sig_ty(a, ar, sc, vd.vparam.pty));
            out.push(FnSig { fs_mangled: mangle_path(a, ar, path, vd.vname), fs_params: vp });
        }
        | Item::Module(md) => {
            let p2 = path_push(a, path, md.mname);
            collect_fn_sigs_into(a, ar, sc, &md.mitems, &p2, out);
        }
        | _e => { }
    }
}
fn collect_fn_sigs_into(a: Allocator, ar: *Arena, sc: *const TyScope, items: *const Vec<Item>, path: *const Vec<str>, out: *Vec<FnSig>) {
    let n = items.length();
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < n { collect_fn_sigs_one(a, ar, sc, &sl[i], path, out); i = i + 1 as u32; }
}

// ===== Prelude `mono-instances` footprint =====
//
// Every IR dump carries the registered prelude struct / enum skeletons.
// Until the prelude itself is ported these are registered by name only
// (the dump renders just `sname_path` / `ename_path`).

fn push_struct_name(a: Allocator, sigs: *Vec<StructSig>, name: str) {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(name);
    let fields: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let tparams: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let no_args: Option<Vec<*const Typ>> = Option::None;
    sigs.push(StructSig {
        sname_path: path, sfields_ty: fields, sis_pub: true, stparams: tparams,
        sinstance_args: no_args, sis_debug: false, ss_is_move: false,
    });
}

fn push_enum_name(a: Allocator, sigs: *Vec<EnumSig>, name: str) {
    let mut path: Vec<str> = Vec::with_capacity(a, 8 as u32);
    path.push(name);
    let variants: Vec<VariantSig> = Vec::with_capacity(a, 8 as u32);
    let tparams: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let no_args: Option<Vec<*const Typ>> = Option::None;
    sigs.push(EnumSig {
        ename_path: path, evariants: variants, eis_pub: true, etparams: tparams,
        einstance_args: no_args, eis_must_use: false, eis_debug: false,
    });
}

// Register a generated instance (an already-mangled path) in the footer.
// Append every field of struct [path] found in [src] (a flat sf_path/sf_name/
// sf_ty table), deduped by name against [out].
fn collect_from(src: *const Vec<StructField>, path: *const Vec<str>, out: *Vec<FieldTy>) {
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < src.length() {
        if path_eq(&sl[i].sf_path, path) && !fieldty_has(out, sl[i].sf_name) {
            out.push(FieldTy { name: sl[i].sf_name, ty: sl[i].sf_ty });
        }
        i = i + 1 as u32;
    }
    return;
}

fn collect_struct_fields(a: Allocator, path: *const Vec<str>,
                         sinfo: *const Vec<StructField>, mono_fields: *const Vec<StructField>) -> Vec<FieldTy> {
    let mut out: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    // collect_from matches via the normalised path_eq, so a module struct's
    // split-form field keys match its colon-joined sname_path directly.
    collect_from(sinfo, path, &out);
    collect_from(mono_fields, path, &out);
    return out;
}

// Fill a struct sig's field list (if still empty — prelude + user structs
// are pushed field-less) from the flat field tables, so the drop pass can
// walk any struct's field tree hunting `own *T`.
fn fill_one(a: Allocator, ar: *Arena, s: *StructSig, sinfo: *const Vec<StructField>,
            mono_fields: *const Vec<StructField>) {
    if s.sfields_ty.length() > 0 as u32 { return; }
    let nm = path_last(&s.sname_path);
    if is_named_prelude_name(nm) {
        s.sfields_ty = named_prelude_fields(a, ar, nm);
        return;
    }
    s.sfields_ty = collect_struct_fields(a, &s.sname_path, sinfo, mono_fields);
    return;
}

fn fill_struct_fields(a: Allocator, ar: *Arena, structs: *Vec<StructSig>, ci: u32,
                      sinfo: *const Vec<StructField>, mono_fields: *const Vec<StructField>) {
    with s in structs[ci] { fill_one(a, ar, s, sinfo, mono_fields); }
    return;
}

// Enum variant backfill — the mirror of the struct field backfill, so the
// drop pass can tell whether an enum owns anything (a variant payload of
// `own *T` / droppable type).
// A module path is stored both split (["ast","Stmt"]) and colon-joined
// (["ast::Stmt"]) depending on source (type resolution vs name collection),
// so the enum backfill compares the "::"-joined byte streams — otherwise a
// module enum's variants never match its ename_path and stay empty.
fn path_eq_norm(a: Allocator, x: *const Vec<str>, y: *const Vec<str>) -> bool {
    if x.length() == y.length() { return path_eq(x, y); }
    let jx = tc_join_sb(a, x);
    let jy = tc_join_sb(a, y);
    if jx.length() != jy.length() { return false; }
    let bx = jx.as_slice();
    let by = jy.as_slice();
    let mut k = 0 as u32;
    while k < jx.length() { if bx[k] != by[k] { return false; } k = k + 1 as u32; }
    return true;
}

fn collect_efields_from(a: Allocator, src: *const Vec<EnumFieldE>, path: *const Vec<str>, variant: str, out: *Vec<FieldTy>) {
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < src.length() {
        if path_eq_norm(a, &sl[i].ef_path, path) && str::eq(sl[i].ef_variant, variant) && !fieldty_has(out, sl[i].ef_name) {
            out.push(FieldTy { name: sl[i].ef_name, ty: sl[i].ef_ty });
        }
        i = i + 1 as u32;
    }
    return;
}

fn collect_variant_fields(a: Allocator, path: *const Vec<str>, variant: str,
                          efields: *const Vec<EnumFieldE>, mono_efields: *const Vec<EnumFieldE>) -> Vec<FieldTy> {
    let mut out: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    collect_efields_from(a, efields, path, variant, &out);
    collect_efields_from(a, mono_efields, path, variant, &out);
    return out;
}

fn variant_seen(vs: *const Vec<VariantSig>, name: str) -> bool {
    let sl = vs.as_slice();
    let mut i = 0 as u32;
    while i < vs.length() { if str::eq(sl[i].vsname, name) { return true; } i = i + 1 as u32; }
    return false;
}

fn collect_variants(a: Allocator, path: *const Vec<str>, etags: *const Vec<EnumVariantTag>,
                    efields: *const Vec<EnumFieldE>, mono_efields: *const Vec<EnumFieldE>) -> Vec<VariantSig> {
    let mut out: Vec<VariantSig> = Vec::with_capacity(a, 8 as u32);
    let tl = etags.as_slice();
    let mut i = 0 as u32;
    while i < etags.length() {
        // A mono instance of a USER generic enum (`Maybe_i32`) carries no etags
        // of its own — they are registered under the SKELETON path (`Maybe`), so
        // match the instance against its base too.  Without this the instance
        // got zero variants: `enum ex_Maybe_i32_tag { };` (invalid C) and a SEGV
        // in codegen's variant_field_ty fallback.  The prelude generic enums
        // (Option / Result) already had their own special-case below.
        let hit = path_eq_norm(a, &tl[i].et_path, path)
                  || inst_of_base(path_last(path), path_last(&tl[i].et_path));
        if hit && !variant_seen(&out, tl[i].et_name) {
            push_variant(a, &out, path, tl[i].et_name, efields, mono_efields, tl[i].et_is_struct);
        }
        i = i + 1 as u32;
    }
    // Prelude enum instances (Option_i32, Result_x_y) carry no etags — their
    // variants are fixed by the prelude shape, so synthesize them in tag order
    // (the payload fields are already in mono_efields via
    // register_prelude_enum_efields).
    let last = path_last(path);
    if str::eq(last, "Option") || str_starts_with(last, "Option_") {
        if !variant_seen(&out, "None") { push_variant(a, &out, path, "None", efields, mono_efields, false); }
        if !variant_seen(&out, "Some") { push_variant(a, &out, path, "Some", efields, mono_efields, false); }
    } else if str::eq(last, "Result") || str_starts_with(last, "Result_") {
        if !variant_seen(&out, "Ok") { push_variant(a, &out, path, "Ok", efields, mono_efields, false); }
        if !variant_seen(&out, "Err") { push_variant(a, &out, path, "Err", efields, mono_efields, false); }
    }
    return out;
}

fn push_variant(a: Allocator, out: *Vec<VariantSig>, path: *const Vec<str>, name: str,
                efields: *const Vec<EnumFieldE>, mono_efields: *const Vec<EnumFieldE>, is_struct: bool) {
    let vf = collect_variant_fields(a, path, name, efields, mono_efields);
    out.push(VariantSig { vsname: name, vsfields: vf, vsis_struct: is_struct });
    return;
}

fn fill_enum_one(a: Allocator, e: *EnumSig, etags: *const Vec<EnumVariantTag>,
                 efields: *const Vec<EnumFieldE>, mono_efields: *const Vec<EnumFieldE>) {
    if e.evariants.length() > 0 as u32 { return; }
    e.evariants = collect_variants(a, &e.ename_path, etags, efields, mono_efields);
    return;
}

fn fill_enum_variants(a: Allocator, enums: *Vec<EnumSig>, ci: u32, etags: *const Vec<EnumVariantTag>,
                      efields: *const Vec<EnumFieldE>, mono_efields: *const Vec<EnumFieldE>) {
    with e in enums[ci] { fill_enum_one(a, e, etags, efields, mono_efields); }
    return;
}

fn fieldty_has(fields: *const Vec<FieldTy>, name: str) -> bool {
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < fields.length() { if str::eq(sl[i].name, name) { return true; } i = i + 1 as u32; }
    return false;
}

// ===== Mono-instance DCE (mirrors the oracle's `mentioned_paths` pass) =====
//
// A demand-driven prelude leaves behind instances whose only consumer was never
// materialized.  A mono struct/enum survives when its path is mentioned in a
// surviving fn's signature or hoisted lets, in a top-level struct/enum (those
// are always emitted), or — transitively — in the fields of anything already
// reachable.  Premise: every prelude body that will ever exist already does
// (true once the last family, the combinators, materializes).
fn path_in_paths(ps: *const Vec<Vec<str>>, p: *const Vec<str>) -> bool {
    let sl = ps.as_slice();
    let mut i = 0 as u32;
    while i < ps.length() { if path_eq(&sl[i], p) { return true; } i = i + 1 as u32; }
    return false;
}
fn add_path_uniq(a: Allocator, out: *Vec<Vec<str>>, p: *const Vec<str>) {
    if path_in_paths(out, p) { return; }
    out.push(copy_strs(a, p));
}
fn mention_tys(a: Allocator, ts: *const Vec<*const Typ>, out: *Vec<Vec<str>>) {
    let sl = ts.as_slice();
    let mut i = 0 as u32;
    while i < ts.length() { mention_ty(a, sl[i], out); i = i + 1 as u32; }
}
fn mention_ty(a: Allocator, t: *const Typ, out: *Vec<Vec<str>>) {
    match *t {
        Typ::TStruct(p) => add_path_uniq(a, out, &p)
        | Typ::TEnum(p) => add_path_uniq(a, out, &p)
        | Typ::TStructApp { path, args } => { add_path_uniq(a, out, &path); mention_tys(a, &args, out); }
        | Typ::TEnumApp { path, args } => { add_path_uniq(a, out, &path); mention_tys(a, &args, out); }
        | Typ::TPtr(i) => mention_ty(a, i, out)
        | Typ::TOwnPtr(i) => mention_ty(a, i, out)
        | Typ::TConstPtr(i) => mention_ty(a, i, out)
        | Typ::TArray { elem, size } => mention_ty(a, elem, out)
        | Typ::TTuple(ts) => mention_tys(a, &ts, out)
        | Typ::TFnPtr { params, ret } => {
            mention_tys(a, &params, out);
            match ret { Option::Some(r) => mention_ty(a, r, out) | Option::None => { } }
        }
        | _o => { }
    }
}
fn mention_funcs(a: Allocator, funcs: *const Vec<Tfunc>, out: *Vec<Vec<str>>) {
    let sl = funcs.as_slice();
    let mut i = 0 as u32;
    while i < funcs.length() {
        mention_tys(a, &sl[i].tf_param_tys, out);
        match sl[i].tf_ret_ty { Option::Some(rt) => mention_ty(a, rt, out) | Option::None => { } }
        let lsl = sl[i].tf_lets.as_slice();
        let mut j = 0 as u32;
        while j < sl[i].tf_lets.length() { mention_ty(a, lsl[j].ty, out); j = j + 1 as u32; }
        i = i + 1 as u32;
    }
}
fn mention_fields_round(a: Allocator, sinfo: *const Vec<StructField>, efields: *const Vec<EnumFieldE>, out: *Vec<Vec<str>>) {
    let ssl = sinfo.as_slice();
    let mut i = 0 as u32;
    while i < sinfo.length() {
        if path_in_paths(out, &ssl[i].sf_path) { mention_ty(a, ssl[i].sf_ty, out); }
        i = i + 1 as u32;
    }
    let esl = efields.as_slice();
    let mut j = 0 as u32;
    while j < efields.length() {
        if path_in_paths(out, &esl[j].ef_path) { mention_ty(a, esl[j].ef_ty, out); }
        j = j + 1 as u32;
    }
}
// `@debug` names, collected straight off the AST (the port has no struct-decl
// table in Tprogram).  A mono instance inherits the flag from its skeleton, so
// the lookup also matches `Pair_i32_bool` against the base name `Pair`.
fn dbg_push_struct(ds: *Vec<str>, sd: *const StructDecl) {
    if sd.sis_debug { ds.push(sd.sname); }
    return;
}
fn dbg_push_enum(de: *Vec<str>, ed: *const EnumDecl) {
    if ed.eis_debug { de.push(ed.ename); }
    return;
}
fn collect_debug_names_one(a: Allocator, ar: *Arena, it: *const Item, ds: *Vec<str>, de: *Vec<str>) {
    match *it {
        Item::Struct(sd) => { dbg_push_struct(ds, &sd); }
        | Item::Enum(ed) => { dbg_push_enum(de, &ed); }
        | Item::Module(md) => { collect_debug_names(a, ar, &md.mitems, ds, de); }
        | _e => { }
    }
}
fn collect_debug_names(a: Allocator, ar: *Arena, items: *const Vec<Item>, ds: *Vec<str>, de: *Vec<str>) {
    let sl = items.as_slice();
    let mut i = 0 as u32;
    while i < items.length() {
        collect_debug_names_one(a, ar, &sl[i], ds, de);
        i = i + 1 as u32;
    }
}
fn debug_name_hit(names: *const Vec<str>, last: str) -> bool {
    let sl = names.as_slice();
    let mut i = 0 as u32;
    while i < names.length() {
        if str::eq(sl[i], last) || inst_of_base(last, sl[i]) { return true; }
        i = i + 1 as u32;
    }
    return false;
}
fn mark_struct_debug(structs: *Vec<StructSig>, ci: u32, names: *const Vec<str>) {
    with s in structs[ci] {
        if debug_name_hit(names, path_last(&s.sname_path)) { s.sis_debug = true; }
    }
    return;
}
fn mark_enum_debug(enums: *Vec<EnumSig>, ci: u32, names: *const Vec<str>) {
    with e in enums[ci] {
        if debug_name_hit(names, path_last(&e.ename_path)) { e.eis_debug = true; }
    }
    return;
}
fn push_struct_path(a: Allocator, sigs: *Vec<StructSig>, srcpath: *const Vec<str>,
                    mono_fields: *const Vec<StructField>, args: *const Vec<*const Typ>) {
    // Fill the mono instance's resolved fields (from the flat mono-field
    // table, keyed by instance path) so downstream passes that walk a
    // struct's field tree — the drop pass in particular, hunting `own *T`
    // fields — see them, not an empty shell.
    let mut fields: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let fl = mono_fields.as_slice();
    let mut fi = 0 as u32;
    while fi < mono_fields.length() {
        if path_eq(&fl[fi].sf_path, srcpath) && !fieldty_has(&fields, fl[fi].sf_name) {
            // The flat mono-field table can carry the same instance field more
            // than once (registered per construction site); dedup by name so a
            // field-tree walk (drop pass) sees each own-field once, not N times.
            fields.push(FieldTy { name: fl[fi].sf_name, ty: fl[fi].sf_ty });
        }
        fi = fi + 1 as u32;
    }
    let tparams: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut iargs: Option<Vec<*const Typ>> = Option::None;
    if args.length() > 0 as u32 { iargs = Option::Some(copy_typs(a, args)); }
    sigs.push(StructSig {
        sname_path: copy_strs(a, srcpath), sfields_ty: fields, sis_pub: true, stparams: tparams,
        sinstance_args: iargs, sis_debug: false, ss_is_move: false,
    });
}
fn push_enum_path(a: Allocator, sigs: *Vec<EnumSig>, srcpath: *const Vec<str>, args: *const Vec<*const Typ>) {
    let variants: Vec<VariantSig> = Vec::with_capacity(a, 8 as u32);
    let tparams: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut iargs: Option<Vec<*const Typ>> = Option::None;
    if args.length() > 0 as u32 { iargs = Option::Some(copy_typs(a, args)); }
    sigs.push(EnumSig {
        ename_path: copy_strs(a, srcpath), evariants: variants, eis_pub: true, etparams: tparams,
        einstance_args: iargs, eis_must_use: false, eis_debug: false,
    });
}

// Declaration rank of a non-generic prelude struct (the order they are declared
// in the oracle's prepended prelude), or -1 for anything else.  Used to emit
// them ahead of the true generic mono instances in the struct index.
fn nongeneric_prelude_rank(name: str) -> int {
    if str::eq(name, "Allocator") { return 0 as int; }
    if str::eq(name, "StringBuilder") { return 1 as int; }
    if str::eq(name, "String") { return 2 as int; }
    if str::eq(name, "Arena") { return 3 as int; }
    return 0 as int - 1 as int;
}
fn prelude_struct_index(a: Allocator) -> Vec<StructSig> {
    let mut sigs: Vec<StructSig> = Vec::with_capacity(a, 16 as u32);
    push_struct_name(a, &sigs, "Enumerate");
    push_struct_name(a, &sigs, "Filter");
    push_struct_name(a, &sigs, "HashMap");
    push_struct_name(a, &sigs, "HashMapIter");
    push_struct_name(a, &sigs, "Map");
    push_struct_name(a, &sigs, "Range");
    push_struct_name(a, &sigs, "RangeInclusive");
    push_struct_name(a, &sigs, "Slice");
    push_struct_name(a, &sigs, "Slot");
    push_struct_name(a, &sigs, "Take");
    push_struct_name(a, &sigs, "Vec");
    push_struct_name(a, &sigs, "VecIter");
    return sigs;
}

fn prelude_enum_index(a: Allocator) -> Vec<EnumSig> {
    let mut sigs: Vec<EnumSig> = Vec::with_capacity(a, 8 as u32);
    push_enum_name(a, &sigs, "Option");
    push_enum_name(a, &sigs, "Result");
    return sigs;
}

// ===== Hoisted let-declaration collection (codegen support) =====
//
// C89 requires locals declared at block top, so codegen emits every `let`
// (user binding + lift temp) as a decl hoisted to the function top (tf_lets)
// and the TLet itself becomes a plain assignment.  Collect them by walking the
// elaborated body — TLet / TLetTuple names with their value types, deduped by
// name, descending through nested blocks / if / while / match arm bodies.
fn lets_push(out: *Vec<FieldTy>, name: str, ty: *const Typ) {
    if !fieldty_has(out, name) { out.push(FieldTy { name: name, ty: ty }); }
}
fn lets_expr(te: *const Texpr, out: *Vec<FieldTy>) {
    match te.e {
        TexprNode::TBlock { stmts, trailing } => { lets_stmts(&stmts, out); match trailing { Option::Some(t) => lets_expr(t, out) | Option::None => {} } }
        | TexprNode::TMatch { scrutinee, ename_path, arms } => { let sl = arms.as_slice(); let mut i = 0 as u32; while i < arms.length() { lets_expr(sl[i].tbody, out); i = i + 1 as u32; } }
        | TexprNode::TIfExpr { cond, then_val, else_val } => { lets_expr(then_val, out); lets_expr(else_val, out); }
        | _o => {}
    }
}
fn lets_stmt(s: *const Tstmt, out: *Vec<FieldTy>) {
    match *s {
        Tstmt::TLet { name, value, decl_ty } => { lets_push(out, name, decl_ty); lets_expr(value, out); }
        | Tstmt::TLetTuple { names, value, pos } => { lets_tuple(&names, value.ty, out); lets_expr(value, out); }
        | Tstmt::TAssign { path, value, pos } => lets_expr(value, out)
        | Tstmt::TAssignField { target, field, value, pos } => lets_expr(value, out)
        | Tstmt::TAssignIndex { base, index, value, pos } => lets_expr(value, out)
        | Tstmt::TAssignDeref { target, value, pos } => lets_expr(value, out)
        | Tstmt::TExprStmt(e) => lets_expr(e, out)
        | Tstmt::TReturn { value, pos } => match value { Option::Some(e) => lets_expr(e, out) | Option::None => {} }
        | Tstmt::TIf { cond, then_body, else_body } => { lets_stmts(&then_body, out); lets_stmts(&else_body, out); }
        | Tstmt::TWhile { cond, body, post } => { lets_stmts(&body, out); lets_stmts(&post, out); }
        | Tstmt::TDefer { body, pos } => lets_stmts(&body, out)
        | _o => {}
    }
}
fn lets_tuple(names: *const Vec<str>, ty: *const Typ, out: *Vec<FieldTy>) {
    match *ty {
        Typ::TTuple(elems) => {
            let nsl = names.as_slice();
            let esl = elems.as_slice();
            let mut i = 0 as u32;
            while i < names.length() && i < elems.length() { lets_push(out, nsl[i], esl[i]); i = i + 1 as u32; }
        }
        | _o => {}
    }
}
fn lets_stmts(stmts: *const Vec<Tstmt>, out: *Vec<FieldTy>) {
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() { lets_stmt(&sl[i], out); i = i + 1 as u32; }
}
// Only lift-pass `__lift_N` temps sort after the elaboration-order decls
// (the oracle appends them post-elaboration).  For-loop `__fv/__fe/__it`
// temps are created during elaboration and stay in body (= creation) order,
// so the partition keys on the `__lift` prefix specifically, not any `__`.
fn lets_is_temp(name: str) -> bool {
    let n = str::length(name);
    if n < 6 as u32 { return false; }
    let b = str::as_bytes(name);
    return b[0 as u32] == 95 as u8 && b[1 as u32] == 95 as u8
        && b[2 as u32] == 108 as u8 && b[3 as u32] == 105 as u8
        && b[4 as u32] == 102 as u8 && b[5 as u32] == 116 as u8;
}
fn collect_body_lets(a: Allocator, body: *const Vec<Tstmt>) -> Vec<FieldTy> {
    let mut raw0: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    lets_stmts(body, &raw0);
    // The for-desugar emits the `__feK` init before the `__fvK` init (bound is
    // pinned first), but the oracle's decl list registers the counter before
    // the end bound (`add_decl counter; add_decl end`).  TLet couples decl+init,
    // so restore the counter-before-end decl order by swapping each adjacent
    // (`__fe`, `__fv`) pair the body-walk produced.
    let mut raw: Vec<FieldTy> = Vec::with_capacity(a, raw0.length() + 1 as u32);
    let r0 = raw0.as_slice();
    let mut k = 0 as u32;
    while k < raw0.length() {
        if k + 1 as u32 < raw0.length() && name4(r0[k].name, 102 as u8, 101 as u8) && name4(r0[k + 1 as u32].name, 102 as u8, 118 as u8) {
            raw.push(r0[k + 1 as u32]); raw.push(r0[k]); k = k + 2 as u32;
        } else {
            raw.push(r0[k]); k = k + 1 as u32;
        }
    }
    // Oracle order: elaboration-order decls (user + for-loop `__fv/__fe`)
    // precede the lift pass's `__lift_N` temps (appended post-elaboration).
    // Reproduce by partitioning on the `__lift` prefix specifically.
    let mut out: Vec<FieldTy> = Vec::with_capacity(a, raw.length() + 1 as u32);
    let sl = raw.as_slice();
    let mut i = 0 as u32;
    while i < raw.length() { if !lets_is_temp(sl[i].name) { out.push(sl[i]); } i = i + 1 as u32; }
    let mut j = 0 as u32;
    while j < raw.length() { if lets_is_temp(sl[j].name) { out.push(sl[j]); } j = j + 1 as u32; }
    return out;
}
// True when `name` is `__<c2><c3>...` (a 4-byte gensym prefix like `__fe`/`__fv`).
fn name4(name: str, c2: u8, c3: u8) -> bool {
    let n = str::length(name);
    if n < 4 as u32 { return false; }
    let b = str::as_bytes(name);
    return b[0 as u32] == 95 as u8 && b[1 as u32] == 95 as u8 && b[2 as u32] == c2 && b[3 as u32] == c3;
}

// ===== Footer type collection (codegen support) =====
//
// Codegen needs a typedef for every distinct tuple / fn-ptr / fixed-array
// shape the program uses, plus include-gating flags.  Mirror the oracle's
// `collect_tuple_types_of`: one post-pass walk over every tfn (resolved
// signature + lets + body expression types) and struct/enum field types,
// gathering unique shapes (dedup by structural equality; array-of-array is
// post-order so the inner shape's typedef precedes it).  Generic skeletons
// (any TVar-carrying shape) are skipped — only their mono instances reach
// codegen.  Port-note: this runs WITHOUT DCE (that is codegen stage g), so a
// dead prelude method's shapes over-collect vs the oracle — a known diff until
// DCE lands; it never drops a shape the program actually uses.

// Complete TVar check (the checker's `ty_has_tvar` stops at TTuple/TArray/TFnPtr).
fn ftr_has_tvar(t: *const Typ) -> bool {
    return match *t {
        Typ::TVar(_n) => true
        | Typ::TAssocProj { head, assoc } => ftr_has_tvar(head)
        | Typ::TPtr(i) => ftr_has_tvar(i)
        | Typ::TOwnPtr(i) => ftr_has_tvar(i)
        | Typ::TConstPtr(i) => ftr_has_tvar(i)
        | Typ::TArray { elem, size } => ftr_has_tvar(elem)
        | Typ::TTuple(ts) => tys_have_tvar(&ts)
        | Typ::TFnPtr { params, ret } => tys_have_tvar(&params) || opt_ty_has_tvar(ret)
        | Typ::TStructApp { path, args } => tys_have_tvar(&args)
        | Typ::TEnumApp { path, args } => tys_have_tvar(&args)
        | _e => false
    };
}
fn opt_ty_has_tvar(o: Option<*const Typ>) -> bool {
    return match o { Option::Some(t) => ftr_has_tvar(t) | Option::None => false };
}

// Structural type equality — the footer dedup key (avoids depending on
// codegen's mangle_typ).

fn ty_in(acc: *const Vec<*const Typ>, t: *const Typ) -> bool {
    let sl = acc.as_slice();
    let mut i = 0 as u32;
    while i < acc.length() { if typ_eq(sl[i], t) { return true; } i = i + 1 as u32; }
    return false;
}
fn add_uniq_ty(acc: *Vec<*const Typ>, t: *const Typ) {
    if !ftr_has_tvar(t) && !ty_in(acc, t) { acc.push(t); }
}

struct FtrAcc {
    tup: Vec<*const Typ>,
    fnp: Vec<*const Typ>,
    arr: Vec<*const Typ>,
}

// Collect tuple / fn-ptr / array shapes reachable by value from `t`.  Array is
// post-order (inner shape's typedef must precede the array-of-array wrapper).
fn walk_typ_collect(t: *const Typ, acc: *FtrAcc) {
    match *t {
        Typ::TTuple(ts) => {
            add_uniq_ty(&acc.tup, t);
            let tsl = ts.as_slice();
            let mut ti = 0 as u32;
            while ti < ts.length() { walk_typ_collect(tsl[ti], acc); ti = ti + 1 as u32; }
        }
        | Typ::TFnPtr { params, ret } => {
            add_uniq_ty(&acc.fnp, t);
            let psl = params.as_slice();
            let mut pi = 0 as u32;
            while pi < params.length() { walk_typ_collect(psl[pi], acc); pi = pi + 1 as u32; }
            match ret { Option::Some(rt) => walk_typ_collect(rt, acc) | Option::None => {} }
        }
        | Typ::TArray { elem, size } => {
            walk_typ_collect(elem, acc);
            add_uniq_ty(&acc.arr, t);
        }
        | Typ::TPtr(pp) => walk_typ_collect(pp, acc)
        | Typ::TOwnPtr(pp) => walk_typ_collect(pp, acc)
        | Typ::TConstPtr(pp) => walk_typ_collect(pp, acc)
        | _e => {}
    }
}

fn collect_texpr(te: *const Texpr, acc: *FtrAcc) {
    walk_typ_collect(te.ty, acc);
    match te.e {
        TexprNode::TSizeOf(t) => walk_typ_collect(t, acc)
        | TexprNode::TNeg(s) => collect_texpr(s, acc)
        | TexprNode::TBitNot(s) => collect_texpr(s, acc)
        | TexprNode::TNot(s) => collect_texpr(s, acc)
        | TexprNode::TRef(s) => collect_texpr(s, acc)
        | TexprNode::TDeref(s) => collect_texpr(s, acc)
        | TexprNode::TCast(s, ann) => collect_texpr(s, acc)
        | TexprNode::TBinOp(op, l, r) => { collect_texpr(l, acc); collect_texpr(r, acc); }
        | TexprNode::TCall { mangled, args } => collect_args(&args, acc)
        | TexprNode::TBuiltinCall { name, args } => collect_args(&args, acc)
        | TexprNode::TIndirectCall { fn_expr, args } => { collect_texpr(fn_expr, acc); collect_args(&args, acc); }
        | TexprNode::TTupleLit(es) => collect_args(&es, acc)
        | TexprNode::TArrayLit(es) => collect_args(&es, acc)
        | TexprNode::TArrayRepeat { value, count } => collect_texpr(value, acc)
        | TexprNode::TStructLit { sname_path, fields, base } => { collect_fields(&fields, acc); collect_opt(base, acc); }
        | TexprNode::TNew { sname_path, fields, base, alloc } => { collect_fields(&fields, acc); collect_opt(base, acc); collect_opt(alloc, acc); }
        | TexprNode::TEnumLit { ename_path, variant, tag, args } => collect_fields(&args, acc)
        | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => { collect_fields(&args, acc); collect_opt(alloc, acc); }
        | TexprNode::TFieldAccess { target, field } => collect_texpr(target, acc)
        | TexprNode::TIndex { base, index } => { collect_texpr(base, acc); collect_texpr(index, acc); }
        | TexprNode::TIfExpr { cond, then_val, else_val } => { collect_texpr(cond, acc); collect_texpr(then_val, acc); collect_texpr(else_val, acc); }
        | TexprNode::TMatch { scrutinee, ename_path, arms } => { collect_texpr(scrutinee, acc); collect_arms(&arms, acc); }
        | TexprNode::TBlock { stmts, trailing } => { collect_stmts(&stmts, acc); collect_opt(trailing, acc); }
        | _leaf => {}
    }
}
fn collect_args(args: *const Vec<*const Texpr>, acc: *FtrAcc) {
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < args.length() { collect_texpr(sl[i], acc); i = i + 1 as u32; }
}
fn collect_fields(fields: *const Vec<TexprField>, acc: *FtrAcc) {
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < fields.length() { collect_texpr(sl[i].value, acc); i = i + 1 as u32; }
}
fn collect_opt(o: Option<*const Texpr>, acc: *FtrAcc) {
    match o { Option::Some(e) => collect_texpr(e, acc) | Option::None => {} }
}
fn collect_arms(arms: *const Vec<TmatchArm>, acc: *FtrAcc) {
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < arms.length() {
        match sl[i].tguard { Option::Some(g) => collect_texpr(g, acc) | Option::None => {} }
        collect_texpr(sl[i].tbody, acc);
        i = i + 1 as u32;
    }
}
fn collect_stmts(stmts: *const Vec<Tstmt>, acc: *FtrAcc) {
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() { collect_tstmt(&sl[i], acc); i = i + 1 as u32; }
}
fn collect_tstmt(s: *const Tstmt, acc: *FtrAcc) {
    match *s {
        Tstmt::TLet { name, value, pos } => collect_texpr(value, acc)
        | Tstmt::TLetTuple { names, value, pos } => collect_texpr(value, acc)
        | Tstmt::TAssign { path, value, pos } => collect_texpr(value, acc)
        | Tstmt::TAssignField { target, field, value, pos } => { collect_texpr(target, acc); collect_texpr(value, acc); }
        | Tstmt::TAssignIndex { base, index, value, pos } => { collect_texpr(base, acc); collect_texpr(index, acc); collect_texpr(value, acc); }
        | Tstmt::TAssignDeref { target, value, pos } => { collect_texpr(target, acc); collect_texpr(value, acc); }
        | Tstmt::TReturn { value, pos } => match value { Option::Some(e) => collect_texpr(e, acc) | Option::None => {} }
        | Tstmt::TExprStmt(e) => collect_texpr(e, acc)
        | Tstmt::TIf { cond, then_body, else_body } => { collect_texpr(cond, acc); collect_stmts(&then_body, acc); collect_stmts(&else_body, acc); }
        | Tstmt::TWhile { cond, body, post } => { collect_texpr(cond, acc); collect_stmts(&body, acc); collect_stmts(&post, acc); }
        | Tstmt::TDefer { body, pos } => collect_stmts(&body, acc)
        | _leaf => {}
    }
}

// True once a NON-GENERIC owning prelude struct (StringBuilder / String /
// Arena) is in the struct index.  The oracle keeps their synthesized
// `<T>__drop` in tp_funcs, walked ahead of their `with_capacity` (declaration
// order), and those drops free via `self.alloc.free_fn` — so the free-seam
// fn-ptr is discovered before the alloc-seam exactly in that case.  A program
// using only the GENERIC collections (Vec / HashMap) has no such early drop:
// its first discovery is `Vec__with_capacity_i32`'s alloc_fn, matching the
// oracle.  Measured by oracle instrumentation (vec vs hashmap), not assumed.
fn owning_prelude_struct_present(structs: *const Vec<StructSig>) -> bool {
    let sl = structs.as_slice();
    let mut i = 0 as u32;
    while i < structs.length() {
        let n = path_last(&sl[i].sname_path);
        if str::eq(n, "StringBuilder") || str::eq(n, "String") || str::eq(n, "Arena") { return true; }
        i = i + 1 as u32;
    }
    return false;
}

// Walk the Allocator's `free_fn` field type into `acc` (seeds the free-seam
// fn-ptr).  Void, not a `-> *const Typ`, so the borrow into `structs` is
// consumed here rather than returned (which the escape pass rejects).
fn seed_allocator_free_fn(structs: *const Vec<StructSig>, acc: *FtrAcc) {
    let sl = structs.as_slice();
    let mut i = 0 as u32;
    while i < structs.length() {
        if str::eq(path_last(&sl[i].sname_path), "Allocator") {
            let fl = sl[i].sfields_ty.as_slice();
            let mut j = 0 as u32;
            while j < sl[i].sfields_ty.length() {
                if str::eq(fl[j].name, "free_fn") { walk_typ_collect(fl[j].ty, acc); }
                j = j + 1 as u32;
            }
        }
        i = i + 1 as u32;
    }
}

// Walk one function list's signature + hoisted lets + body into the accumulator.
fn walk_funcs_footer(funcs: *const Vec<Tfunc>, acc: *FtrAcc) {
    let fsl = funcs.as_slice();
    let mut fi = 0 as u32;
    while fi < funcs.length() {
        match fsl[fi].tf_ret_ty { Option::Some(rt) => walk_typ_collect(rt, acc) | Option::None => {} }
        let psl = fsl[fi].tf_param_tys.as_slice();
        let mut pi = 0 as u32;
        while pi < fsl[fi].tf_param_tys.length() { walk_typ_collect(psl[pi], acc); pi = pi + 1 as u32; }
        collect_stmts(&fsl[fi].tf_body, acc);
        fi = fi + 1 as u32;
    }
    return;
}
// Footer types over the WHOLE program: user fns, then the prelude non-generic
// methods (they were at the tail of tp_funcs before tp_pmeth split them out —
// `push_int`'s `[u8; 10]` array type is collected here), then the structs/enums.
fn collect_footer_types2(a: Allocator, ar: *Arena, funcs: *const Vec<Tfunc>, pmeth: *const Vec<Tfunc>,
                         structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>) -> FtrAcc {
    let tv: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let fv: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let av: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let mut acc = FtrAcc { tup: tv, fnp: fv, arr: av };
    if owning_prelude_struct_present(structs) { seed_allocator_free_fn(structs, &acc); }
    walk_funcs_footer(funcs, &acc);
    walk_funcs_footer(pmeth, &acc);
    // Ghost type: the oracle's prepended prelude puts EVERY StringBuilder method
    // in tp_funcs at footer-collection time, so `push_int`'s `[u8; 10]` digit
    // buffer is collected even in a program that never calls push_int (the
    // method is DCE'd afterwards, but the array type stays).  The port only
    // materializes DEMANDED methods, so seed the array type whenever
    // StringBuilder is in play.  Deduped by add_uniq_ty when push_int IS
    // demanded.  Measured on own_ptr (oracle emits ex_arr10_u8, no push_int).
    if struct_named_present(structs, "StringBuilder") {
        walk_typ_collect(ty_node(ar, Typ::TArray { elem: t_u8(ar), size: 10 as int }), &acc);
    }
    walk_structs_enums_footer(structs, enums, &acc);
    return acc;
}
fn struct_named_present(structs: *const Vec<StructSig>, name: str) -> bool {
    let sl = structs.as_slice();
    let mut i = 0 as u32;
    while i < structs.length() { if str::eq(path_last(&sl[i].sname_path), name) { return true; } i = i + 1 as u32; }
    return false;
}
fn walk_structs_enums_footer(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, acc: *FtrAcc) {
    let ssl = structs.as_slice();
    let mut si = 0 as u32;
    while si < structs.length() {
        let flsl = ssl[si].sfields_ty.as_slice();
        let mut sj = 0 as u32;
        while sj < ssl[si].sfields_ty.length() { walk_typ_collect(flsl[sj].ty, acc); sj = sj + 1 as u32; }
        si = si + 1 as u32;
    }
    let esl = enums.as_slice();
    let mut ei = 0 as u32;
    while ei < enums.length() {
        let vsl = esl[ei].evariants.as_slice();
        let mut ej = 0 as u32;
        while ej < esl[ei].evariants.length() {
            let vfl = vsl[ej].vsfields.as_slice();
            let mut ek = 0 as u32;
            while ek < vsl[ej].vsfields.length() { walk_typ_collect(vfl[ek].ty, acc); ek = ek + 1 as u32; }
            ej = ej + 1 as u32;
        }
        ei = ei + 1 as u32;
    }
    return;
}
fn ftr_to_fieldtys(a: Allocator, tys: *const Vec<*const Typ>) -> Vec<FieldTy> {
    let mut out: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    let sl = tys.as_slice();
    let mut i = 0 as u32;
    while i < tys.length() { out.push(FieldTy { name: "", ty: sl[i] }); i = i + 1 as u32; }
    return out;
}

// Include-gating flags: does any tfn body use heap (TNew / free / default
// allocator), the default allocator, or string.h (cstr_len / mem_zero)?
// kind: 0 = heap, 1 = default_allocator, 2 = string.h.
fn builtin_expr_hit(te: *const Texpr, kind: int) -> bool {
    let here = match te.e {
        TexprNode::TNew { sname_path, fields, base, alloc } => (kind == 0 as int)
        | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => (kind == 0 as int)
        | TexprNode::TBuiltinCall { name, args } => builtin_name_hit(name, kind)
        | _e => false
    };
    if here { return true; }
    return match te.e {
        TexprNode::TNeg(s) => builtin_expr_hit(s, kind) | TexprNode::TBitNot(s) => builtin_expr_hit(s, kind)
        | TexprNode::TNot(s) => builtin_expr_hit(s, kind) | TexprNode::TRef(s) => builtin_expr_hit(s, kind)
        | TexprNode::TDeref(s) => builtin_expr_hit(s, kind) | TexprNode::TCast(s, ann) => builtin_expr_hit(s, kind)
        | TexprNode::TBinOp(op, l, r) => builtin_expr_hit(l, kind) || builtin_expr_hit(r, kind)
        | TexprNode::TCall { mangled, args } => builtin_args_hit(&args, kind)
        | TexprNode::TBuiltinCall { name, args } => builtin_args_hit(&args, kind)
        | TexprNode::TIndirectCall { fn_expr, args } => builtin_expr_hit(fn_expr, kind) || builtin_args_hit(&args, kind)
        | TexprNode::TTupleLit(es) => builtin_args_hit(&es, kind) | TexprNode::TArrayLit(es) => builtin_args_hit(&es, kind)
        | TexprNode::TArrayRepeat { value, count } => builtin_expr_hit(value, kind)
        | TexprNode::TStructLit { sname_path, fields, base } => builtin_fields_hit(&fields, kind) || builtin_opt_hit(base, kind)
        | TexprNode::TNew { sname_path, fields, base, alloc } => builtin_fields_hit(&fields, kind) || builtin_opt_hit(base, kind) || builtin_opt_hit(alloc, kind)
        | TexprNode::TEnumLit { ename_path, variant, tag, args } => builtin_fields_hit(&args, kind)
        | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => builtin_fields_hit(&args, kind) || builtin_opt_hit(alloc, kind)
        | TexprNode::TFieldAccess { target, field } => builtin_expr_hit(target, kind)
        | TexprNode::TIndex { base, index } => builtin_expr_hit(base, kind) || builtin_expr_hit(index, kind)
        | TexprNode::TIfExpr { cond, then_val, else_val } => builtin_expr_hit(cond, kind) || builtin_expr_hit(then_val, kind) || builtin_expr_hit(else_val, kind)
        | TexprNode::TMatch { scrutinee, ename_path, arms } => builtin_expr_hit(scrutinee, kind) || builtin_arms_hit(&arms, kind)
        | TexprNode::TBlock { stmts, trailing } => builtin_stmts_hit(&stmts, kind) || builtin_opt_hit(trailing, kind)
        | _leaf => false
    };
}
fn builtin_name_hit(name: str, kind: int) -> bool {
    if kind == 0 as int { return str::eq(name, "free") || str::eq(name, "default_allocator"); }
    if kind == 1 as int { return str::eq(name, "default_allocator"); }
    return str::eq(name, "cstr_len") || str::eq(name, "mem_zero");
}
fn builtin_args_hit(args: *const Vec<*const Texpr>, kind: int) -> bool {
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < args.length() { if builtin_expr_hit(sl[i], kind) { return true; } i = i + 1 as u32; }
    return false;
}
fn builtin_fields_hit(fields: *const Vec<TexprField>, kind: int) -> bool {
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < fields.length() { if builtin_expr_hit(sl[i].value, kind) { return true; } i = i + 1 as u32; }
    return false;
}
fn builtin_opt_hit(o: Option<*const Texpr>, kind: int) -> bool {
    return match o { Option::Some(e) => builtin_expr_hit(e, kind) | Option::None => false };
}
fn builtin_arms_hit(arms: *const Vec<TmatchArm>, kind: int) -> bool {
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < arms.length() { if builtin_expr_hit(sl[i].tbody, kind) { return true; } i = i + 1 as u32; }
    return false;
}
fn builtin_stmts_hit(stmts: *const Vec<Tstmt>, kind: int) -> bool {
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() { if builtin_scan_stmt(&sl[i], kind) { return true; } i = i + 1 as u32; }
    return false;
}
fn builtin_scan_stmt(s: *const Tstmt, kind: int) -> bool {
    return match *s {
        Tstmt::TLet { name, value, pos } => builtin_expr_hit(value, kind)
        | Tstmt::TLetTuple { names, value, pos } => builtin_expr_hit(value, kind)
        | Tstmt::TAssign { path, value, pos } => builtin_expr_hit(value, kind)
        | Tstmt::TAssignField { target, field, value, pos } => builtin_expr_hit(target, kind) || builtin_expr_hit(value, kind)
        | Tstmt::TAssignIndex { base, index, value, pos } => builtin_expr_hit(base, kind) || builtin_expr_hit(index, kind) || builtin_expr_hit(value, kind)
        | Tstmt::TAssignDeref { target, value, pos } => builtin_expr_hit(target, kind) || builtin_expr_hit(value, kind)
        | Tstmt::TReturn { value, pos } => builtin_opt_hit(value, kind)
        | Tstmt::TExprStmt(e) => builtin_expr_hit(e, kind)
        | Tstmt::TIf { cond, then_body, else_body } => builtin_expr_hit(cond, kind) || builtin_stmts_hit(&then_body, kind) || builtin_stmts_hit(&else_body, kind)
        | Tstmt::TWhile { cond, body, post } => builtin_expr_hit(cond, kind) || builtin_stmts_hit(&body, kind) || builtin_stmts_hit(&post, kind)
        | Tstmt::TDefer { body, pos } => builtin_stmts_hit(&body, kind)
        | _leaf => false
    };
}
fn any_builtin(funcs: *const Vec<Tfunc>, kind: int) -> bool {
    let sl = funcs.as_slice();
    let mut i = 0 as u32;
    while i < funcs.length() {
        if builtin_stmts_hit(&sl[i].tf_body, kind) { return true; }
        i = i + 1 as u32;
    }
    return false;
}

// ===== Program assembly =====

// The Exile-source prelude (workstream-B): method bodies the compiler would
// otherwise hand-build in OCaml.  Parsed by the port's own lexer/parser once at
// check_program start (file "<prelude>", so `--user-only` drops it from the
// typed-IR dump while codegen still emits the bodies).  Unlike the oracle,
// which prepends the whole prelude and DCE-prunes it, the port keeps its
// verified DEMAND-DRIVEN materialization: the parsed methods sit in a passive
// registry and are elaborated into tp_funcs only when a use-site demands them.
fn prelude_source(a: Allocator, ar: *Arena) -> str {
    let mut sb = StringBuilder::with_capacity(a, 1024 as u32);
    sb.push_str("impl Allocator {\n");
    sb.push_str("    pub fn alloc<T>(self) -> own *T {\n");
    sb.push_str("        return self.alloc_fn(self.state, size_of(T) as u32) as own *T;\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn free<T>(self, p: own *T) {\n");
    sb.push_str("        self.free_fn(self.state, p as *c_void, size_of(T) as u32);\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("mod str {\n");
    sb.push_str("    pub fn length(s: str) -> u32 { return cstr_len(s); }\n");
    sb.push_str("    pub fn as_bytes(s: str) -> Slice<u8> {\n");
    sb.push_str("        let n: u32 = cstr_len(s);\n");
    sb.push_str("        return Slice { ptr: s as *const u8, len: n };\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn eq(a: str, b: str) -> bool {\n");
    sb.push_str("        let la: u32 = cstr_len(a);\n");
    sb.push_str("        let lb: u32 = cstr_len(b);\n");
    sb.push_str("        if la != lb { return false; }\n");
    sb.push_str("        let ba: Slice<u8> = str::as_bytes(a);\n");
    sb.push_str("        let bb: Slice<u8> = str::as_bytes(b);\n");
    sb.push_str("        let mut i: u32 = 0 as u32;\n");
    sb.push_str("        while i < la {\n");
    sb.push_str("            if ba[i] != bb[i] { return false; }\n");
    sb.push_str("            i = i + 1 as u32;\n");
    sb.push_str("        }\n");
    sb.push_str("        return true;\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn cmp(a: str, b: str) -> i32 {\n");
    sb.push_str("        let la: u32 = cstr_len(a);\n");
    sb.push_str("        let lb: u32 = cstr_len(b);\n");
    sb.push_str("        let ba: Slice<u8> = str::as_bytes(a);\n");
    sb.push_str("        let bb: Slice<u8> = str::as_bytes(b);\n");
    sb.push_str("        let m: u32 = if la < lb { la } else { lb };\n");
    sb.push_str("        let mut i: u32 = 0 as u32;\n");
    sb.push_str("        while i < m {\n");
    sb.push_str("            if ba[i] != bb[i] { return ba[i] as i32 - bb[i] as i32; }\n");
    sb.push_str("            i = i + 1 as u32;\n");
    sb.push_str("        }\n");
    sb.push_str("        return la as i32 - lb as i32;\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn hash(s: str) -> u32 {\n");
    sb.push_str("        let bytes: Slice<u8> = str::as_bytes(s);\n");
    sb.push_str("        let n: u32 = bytes.len;\n");
    sb.push_str("        let mut acc: u32 = 0 as u32;\n");
    sb.push_str("        let mut i: u32 = 0 as u32;\n");
    sb.push_str("        while i < n {\n");
    sb.push_str("            acc = acc * 31 + bytes[i] as u32;\n");
    sb.push_str("            i = i + 1 as u32;\n");
    sb.push_str("        }\n");
    sb.push_str("        return acc;\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn from_slice(arena: *Arena, s: Slice<u8>) -> str {\n");
    sb.push_str("        let n: u32 = s.len;\n");
    sb.push_str("        let start: u32 = arena.off;\n");
    sb.push_str("        if start + n + 1 as u32 > arena.cap { return \"\"; }\n");
    sb.push_str("        let mut i: u32 = 0 as u32;\n");
    sb.push_str("        while i < n {\n");
    sb.push_str("            arena.buf[start + i] = s[i];\n");
    sb.push_str("            i = i + 1 as u32;\n");
    sb.push_str("        }\n");
    sb.push_str("        arena.buf[start + n] = 0 as u8;\n");
    sb.push_str("        arena.off = start + n + 1 as u32;\n");
    sb.push_str("        let p: *u8 = ptr_offset(arena.buf, start);\n");
    sb.push_str("        return p as *const c_char as str;\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("struct StringBuilder { buf: own *u8, len: u32, cap: u32, alloc: Allocator }\n");
    sb.push_str("impl StringBuilder {\n");
    sb.push_str("    pub fn with_capacity(a: Allocator, hint: u32) -> StringBuilder {\n");
    sb.push_str("        let cap: u32 = if hint < 16 as u32 { 16 as u32 } else { hint };\n");
    sb.push_str("        let buf: own *u8 = a.alloc_fn(a.state, cap) as own *u8;\n");
    sb.push_str("        return StringBuilder { buf: buf, len: 0 as u32, cap: cap, alloc: a };\n");
    sb.push_str("    }\n");
    sb.push_str("    fn grow(*self, new_cap: u32) {\n");
    sb.push_str("        let new_buf: own *u8 = self.alloc.alloc_fn(self.alloc.state, new_cap) as own *u8;\n");
    sb.push_str("        let src: Slice<u8> = Slice { ptr: self.buf as *const u8, len: self.len };\n");
    sb.push_str("        let mut i: u32 = 0 as u32;\n");
    sb.push_str("        while i < self.len { new_buf[i] = src[i]; i = i + 1 as u32; }\n");
    sb.push_str("        self.alloc.free_fn(self.alloc.state, self.buf as *c_void, self.cap);\n");
    sb.push_str("        self.buf = new_buf;\n");
    sb.push_str("        self.cap = new_cap;\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn push_byte(*self, b: u8) {\n");
    sb.push_str("        if self.len + 1 as u32 > self.cap { self.grow(self.cap * 2 as u32); }\n");
    sb.push_str("        self.buf[self.len] = b;\n");
    sb.push_str("        self.len = self.len + 1 as u32;\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn push_str(*self, s: str) {\n");
    sb.push_str("        let n: u32 = cstr_len(s);\n");
    sb.push_str("        let need: u32 = self.len + n;\n");
    sb.push_str("        if need > self.cap {\n");
    sb.push_str("            let mut new_cap: u32 = self.cap;\n");
    sb.push_str("            while new_cap < need { new_cap = new_cap * 2 as u32; }\n");
    sb.push_str("            self.grow(new_cap);\n");
    sb.push_str("        }\n");
    sb.push_str("        let src: Slice<u8> = Slice { ptr: s as *const u8, len: n };\n");
    sb.push_str("        let mut i: u32 = 0 as u32;\n");
    sb.push_str("        while i < n { self.buf[self.len + i] = src[i]; i = i + 1 as u32; }\n");
    sb.push_str("        self.len = self.len + n;\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn push_int(*self, n: int) {\n");
    sb.push_str("        if n == 0 { self.push_byte(48 as u8); return; }\n");
    sb.push_str("        let mut u: u32 = 0 as u32;\n");
    sb.push_str("        if n < 0 { self.push_byte(45 as u8); u = 0 as u32 - n as u32; } else { u = n as u32; }\n");
    sb.push_str("        let mut digits: [u8; 10] = [0 as u8; 10];\n");
    sb.push_str("        let mut idx: u32 = 0 as u32;\n");
    sb.push_str("        while u > 0 as u32 {\n");
    sb.push_str("            digits[idx] = (48 as u32 + u % 10 as u32) as u8;\n");
    sb.push_str("            u = u / 10 as u32;\n");
    sb.push_str("            idx = idx + 1 as u32;\n");
    sb.push_str("        }\n");
    sb.push_str("        while idx > 0 as u32 { idx = idx - 1 as u32; self.push_byte(digits[idx]); }\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn length(*const self) -> u32 { return self.len; }\n");
    sb.push_str("    pub fn as_slice(*const self) -> Slice<u8> {\n");
    sb.push_str("        return Slice { ptr: self.buf as *const u8, len: self.len };\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("struct String { ptr: own *u8, len: u32, alloc: Allocator }\n");
    sb.push_str("impl String {\n");
    sb.push_str("    pub fn with_str(a: Allocator, s: str) -> String {\n");
    sb.push_str("        let n: u32 = cstr_len(s);\n");
    sb.push_str("        let buf: own *u8 = a.alloc_fn(a.state, n + 1 as u32) as own *u8;\n");
    sb.push_str("        let src: Slice<u8> = Slice { ptr: s as *const u8, len: n };\n");
    sb.push_str("        let mut i: u32 = 0 as u32;\n");
    sb.push_str("        while i < n { buf[i] = src[i]; i = i + 1 as u32; }\n");
    sb.push_str("        buf[n] = 0 as u8;\n");
    sb.push_str("        return String { ptr: buf, len: n, alloc: a };\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn empty(a: Allocator) -> String {\n");
    sb.push_str("        let buf: own *u8 = a.alloc_fn(a.state, 1 as u32) as own *u8;\n");
    sb.push_str("        buf[0 as u32] = 0 as u8;\n");
    sb.push_str("        return String { ptr: buf, len: 0 as u32, alloc: a };\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn build(sb: StringBuilder) -> String {\n");
    sb.push_str("        sb.buf[sb.len] = 0 as u8;\n");
    sb.push_str("        return String { ptr: sb.buf as own *u8, len: sb.len, alloc: sb.alloc };\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn length(*const self) -> u32 { return self.len; }\n");
    sb.push_str("    pub fn as_slice(*const self) -> Slice<u8> {\n");
    sb.push_str("        return Slice { ptr: self.ptr as *const u8, len: self.len };\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn as_str(*const self) -> str { return self.ptr as str; }\n");
    sb.push_str("    pub fn free(self) {\n");
    sb.push_str("        self.alloc.free_fn(self.alloc.state, self.ptr as *c_void, self.len + 1 as u32);\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("impl Eq for String {\n");
    sb.push_str("    pub fn eq(*const self, other: *const String) -> bool {\n");
    sb.push_str("        return str::eq(self.as_str(), other.as_str());\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("impl Hash for String {\n");
    sb.push_str("    pub fn hash(*const self) -> u32 { return str::hash(self.as_str()); }\n");
    sb.push_str("}\n");
    sb.push_str("impl Clone for String {\n");
    sb.push_str("    pub fn clone(*const self) -> String {\n");
    sb.push_str("        return String::with_str(self.alloc, self.as_str());\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("struct Vec<T> { ptr: own *T, count: u32, cap: u32, alloc: Allocator }\n");
    sb.push_str("struct VecIter<T> { data: *const T, len: u32, pos: u32 }\n");
    sb.push_str("impl Vec<T> {\n");
    sb.push_str("    pub fn with_capacity(a: Allocator, hint: u32) -> Vec<T> {\n");
    sb.push_str("        let cap: u32 = if hint < 8 as u32 { 8 as u32 } else { hint };\n");
    sb.push_str("        let bytes: u32 = size_of(T) as u32 * cap;\n");
    sb.push_str("        let p: own *T = a.alloc_fn(a.state, bytes) as own *T;\n");
    sb.push_str("        return Vec { ptr: p, count: 0 as u32, cap: cap, alloc: a };\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn length(*const self) -> u32 { return self.count; }\n");
    sb.push_str("    fn grow(*self, new_cap: u32) {\n");
    sb.push_str("        let bytes: u32 = size_of(T) as u32 * new_cap;\n");
    sb.push_str("        let new_ptr: own *T = self.alloc.alloc_fn(self.alloc.state, bytes) as own *T;\n");
    sb.push_str("        let src: Slice<T> = Slice { ptr: self.ptr as *const T, len: self.count };\n");
    sb.push_str("        let mut i: u32 = 0 as u32;\n");
    sb.push_str("        while i < self.count { new_ptr[i] = src[i] as T; i = i + 1 as u32; }\n");
    sb.push_str("        let old_bytes: u32 = size_of(T) as u32 * self.cap;\n");
    sb.push_str("        self.alloc.free_fn(self.alloc.state, self.ptr as *c_void, old_bytes);\n");
    sb.push_str("        self.ptr = new_ptr;\n");
    sb.push_str("        self.cap = new_cap;\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn push(*self, x: T) {\n");
    sb.push_str("        if self.count + 1 as u32 > self.cap { self.grow(self.cap * 2 as u32); }\n");
    sb.push_str("        self.ptr[self.count] = x;\n");
    sb.push_str("        self.count = self.count + 1 as u32;\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn get(*const self, i: u32) -> Option<T> {\n");
    sb.push_str("        if i >= self.count { return Option::None; }\n");
    sb.push_str("        let s: Slice<T> = Slice { ptr: self.ptr as *const T, len: self.count };\n");
    sb.push_str("        return Option::Some(s[i]);\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn as_slice(*const self) -> Slice<T> {\n");
    sb.push_str("        return Slice { ptr: self.ptr as *const T, len: self.count };\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn iter(*const self) -> VecIter<T> {\n");
    sb.push_str("        return VecIter { data: self.ptr as *const T, len: self.count, pos: 0 as u32 };\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("impl Slice<T> {\n");
    sb.push_str("    pub fn length(*const self) -> u32 { return self.len; }\n");
    sb.push_str("}\n");
    sb.push_str("impl Iterator for VecIter<T> {\n");
    sb.push_str("    pub fn next(*self) -> Option<T> {\n");
    sb.push_str("        if self.pos >= self.len { return Option::None; }\n");
    sb.push_str("        let s: Slice<T> = Slice { ptr: self.data, len: self.len };\n");
    sb.push_str("        let v: T = s[self.pos];\n");
    sb.push_str("        self.pos = self.pos + 1 as u32;\n");
    sb.push_str("        return Option::Some(v);\n");
    sb.push_str("    }\n");
    sb.push_str("}\n");
    sb.push_str("struct Slot<K, V> { state: u8, hash: u32, key: K, value: V }\n");
    sb.push_str("struct HashMap<K, V> { slots: own *Slot<K, V>, count: u32, cap: u32, alloc: Allocator }\n");
    sb.push_str("struct HashMapIter<K, V> { data: *const Slot<K, V>, len: u32, pos: u32 }\n");
    sb.push_str("impl HashMap<K, V> {\n");
    sb.push_str("    pub fn with_capacity(a: Allocator, hint: u32) -> HashMap<K, V> {\n");
    sb.push_str("        let raw: u32 = if hint < 8 as u32 { 8 as u32 } else { hint };\n");
    sb.push_str("        let mut cap: u32 = 1 as u32;\n");
    sb.push_str("        while cap < raw { cap = cap << 1 as u32; }\n");
    sb.push_str("        let bytes: u32 = size_of(Slot<K, V>) as u32 * cap;\n");
    sb.push_str("        let p: own *Slot<K, V> = a.alloc_fn(a.state, bytes) as own *Slot<K, V>;\n");
    sb.push_str("        mem_zero(p, bytes);\n");
    sb.push_str("        return HashMap { slots: p, count: 0 as u32, cap: cap, alloc: a };\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn length(*const self) -> u32 { return self.count; }\n");
    sb.push_str("    fn grow(*self, new_cap: u32) {\n");
    sb.push_str("        let bytes: u32 = size_of(Slot<K, V>) as u32 * new_cap;\n");
    sb.push_str("        let new_p: own *Slot<K, V> = self.alloc.alloc_fn(self.alloc.state, bytes) as own *Slot<K, V>;\n");
    sb.push_str("        mem_zero(new_p, bytes);\n");
    sb.push_str("        let old_cap: u32 = self.cap;\n");
    sb.push_str("        let old_view: Slice<Slot<K, V>> = Slice { ptr: self.slots as *const Slot<K, V>, len: self.cap };\n");
    sb.push_str("        let mut j: u32 = 0 as u32;\n");
    sb.push_str("        while j < old_cap {\n");
    sb.push_str("            let s: Slot<K, V> = old_view[j];\n");
    sb.push_str("            if s.state == 1 as u8 {\n");
    sb.push_str("                let new_view: Slice<Slot<K, V>> = Slice { ptr: new_p as *const Slot<K, V>, len: new_cap };\n");
    sb.push_str("                let mut i: u32 = s.hash & (new_cap - 1 as u32);\n");
    sb.push_str("                while true {\n");
    sb.push_str("                    let n: Slot<K, V> = new_view[i];\n");
    sb.push_str("                    if n.state != 1 as u8 {\n");
    sb.push_str("                        new_p[i] = Slot { state: 1 as u8, hash: s.hash, key: s.key, value: s.value };\n");
    sb.push_str("                        break;\n");
    sb.push_str("                    }\n");
    sb.push_str("                    i = (i + 1 as u32) & (new_cap - 1 as u32);\n");
    sb.push_str("                }\n");
    sb.push_str("            }\n");
    sb.push_str("            j = j + 1 as u32;\n");
    sb.push_str("        }\n");
    sb.push_str("        let old_bytes: u32 = size_of(Slot<K, V>) as u32 * old_cap;\n");
    sb.push_str("        self.alloc.free_fn(self.alloc.state, self.slots as *c_void, old_bytes);\n");
    sb.push_str("        self.slots = new_p;\n");
    sb.push_str("        self.cap = new_cap;\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn contains(*const self, k: K) -> bool {\n");
    sb.push_str("        let h: u32 = k.hash();\n");
    sb.push_str("        let sview: Slice<Slot<K, V>> = Slice { ptr: self.slots as *const Slot<K, V>, len: self.cap };\n");
    sb.push_str("        let mut i: u32 = h & (self.cap - 1 as u32);\n");
    sb.push_str("        while true {\n");
    sb.push_str("            let s: Slot<K, V> = sview[i];\n");
    sb.push_str("            if s.state == 0 as u8 { return false; }\n");
    sb.push_str("            if s.state == 1 as u8 && s.hash == h {\n");
    sb.push_str("                if k.eq(s.key) { return true; }\n");
    sb.push_str("            }\n");
    sb.push_str("            i = (i + 1 as u32) & (self.cap - 1 as u32);\n");
    sb.push_str("        }\n");
    sb.push_str("    }\n");
    sb.push_str("    pub fn get(*const self, k: K) -> Option<V> {\n");
    sb.push_str("        let h: u32 = k.hash();\n");
    sb.push_str("        let sview: Slice<Slot<K, V>> = Slice { ptr: self.slots as *const Slot<K, V>, len: self.cap };\n");
    sb.push_str("        let mut i: u32 = h & (self.cap - 1 as u32);\n");
    sb.push_str("        while true {\n");
    sb.push_str("            let s: Slot<K, V> = sview[i];\n");
    sb.push_str("            if s.state == 0 as u8 { return Option::None; }\n");
    sb.push_str("            if s.state == 1 as u8 && s.hash == h {\n");
    sb.push_str("                if k.eq(s.key) { return Option::Some(s.value); }\n");
    sb.push_str("            }\n");
    sb.push_str("            i = (i + 1 as u32) & (self.cap - 1 as u32);\n");
