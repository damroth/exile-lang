// `trait Hash: Eq`. The supertrait question is asked against the whole program,
// not against what the walk has passed so far, because the required impl may be
// written after this one.
struct P { x: int }
impl Hash for P {
    fn hash(*const self) -> u32 { return 1 as u32; }
}
fn main() { let p = P { x: 1 }; println(p.x); }
