// A prelude collection method carries a real parameter list now, so a bad
// element binds T a second time and the CONFLICT is what fires - which is the
// reference's first answer here, not the slot mismatch that follows it.
pub mod raw { extern fn make_c_allocator() -> Allocator; }
fn main() {
    let a = raw::make_c_allocator();
    let mut v: Vec<int> = Vec::with_capacity(a, 8 as u32);
    v.push(true);
    println(v.length() as int);
}
