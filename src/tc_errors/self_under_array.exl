// `Self` as an array element. Also a parameter type, also not a pointer chain.
//
// This one crashed the port rather than refusing it: the marker degraded to
// `c_void`, an array of `c_void` reached codegen and there was no C form for it
// (rc=134). A refusal the reference gives and the port turns into an abort is
// worse than a missing check - the reader gets no line at all.
struct S { v: int }
impl S { pub fn go(*const self, o: [Self; 1]) -> int { return o[0].v; } }
fn main() { let s: S = S { v: 1 }; println(s.go([S { v: 4 }])); }
