// A module view whose body calls a private method of a module struct.
mod m {
    pub struct P { x: int }
    impl P { fn neg(*const self) -> bool { return self.x < 0; } }
    pub view Quad(p: P) -> Left | Right {
        if p.neg() { return Quad::Left; }
        return Quad::Right;
    }
    pub fn q(x: int) -> int { let p = P { x: x }; return match p { Quad::Left => 0 - 1 | Quad::Right => 1 }; }
}
fn main() { println(m::q(0 - 2)); println(m::q(2)); }
