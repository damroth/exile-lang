// A missing supertrait names the target by its whole path (#198).
trait Base { fn b(*const self) -> int; }
trait Sub: Base { fn s(*const self) -> int; }
mod a { pub struct D { t: int } }
impl Sub for a::D { fn s(*const self) -> int { return self.t; } }
fn main() { let d = a::D { t: 2 }; println(d.s()); }
