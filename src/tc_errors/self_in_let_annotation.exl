// `Self` on a local inside an impl method's BODY. The fold touches parameter
// types; a body annotation is not one, and the position the reader is given is
// their `let`, not the method.
struct S { v: int }
impl S { pub fn go(*const self) -> int { let t: Self = S { v: 2 }; return t.v; } }
fn main() { let s: S = S { v: 1 }; println(s.go()); }
