// `Self` inside a function-pointer parameter. This IS a parameter type, so the
// fold looks at it - and walks only `*` and `*const`, so the marker under
// `fn(..)` survives. The narrowness of the walk is the rule.
struct S { v: int }
fn helper(p: *const S) -> int { return p.v; }
impl S { pub fn go(*const self, f: fn(*const Self) -> int) -> int { return f(self); } }
fn main() { let s: S = S { v: 3 }; println(s.go(helper)); }
