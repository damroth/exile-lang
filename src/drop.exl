// Self-host port of lib/drop.ml — the unified auto-drop / own-lifecycle
// pass.  Runs AFTER Move.check, BEFORE codegen; rewrites each user function
// body to release every owned binding exactly once at scope exit (L1), drop
// the old value before an overwriting assignment (L2), and resurrect a
// consumed binding on rebind (L3).  Consume detection is DELEGATED to the
// move-pass walker (`move::states_by`, the OWN-D2 seam) so the compiler has
// one consume model.
//
// Reproduces the shallow drops (bare `own *T` and direct own-fields freed
// inline through their sibling `alloc`) AND the deep-drop glue CALLS — a
// droppable pointee / Vec-element / HashMap-slot emits a call to the
// synthesized `__drop_{ptr,vec,hm}_N` helper (whose DEFINITION carries a
// <prelude> position and is filtered from the --user-only dump).
//
// Tracked entries carry the struct's INDEX in `tp_struct_index` rather than
// its path, so a `DEntry` is copyable (no owned Vec field) and the live
// list threads without any move-out-of-field.

use pos::*;
use ast::*;
use ir::*;
use error::*;
use move::*;

// ---------- arena node builders ----------

fn d_ty(ar: *Arena, t: Typ) -> *const Typ {
    let n: *Typ = ar.alloc_borrowed();
    if n == null { arena_oom(); }
    *n = t;
    return n as *const Typ;
}

fn d_te(ar: *Arena, node: TexprNode, ty: *const Typ, pos: Pos) -> *const Texpr {
    let n: *Texpr = ar.alloc_borrowed();
    if n == null { arena_oom(); }
    *n = Texpr { e: node, ty: ty, pos: pos };
    return n as *const Texpr;
}

fn d_ann(ar: *Arena, t: TypeAnn) -> *const TypeAnn {
    let n: *TypeAnn = ar.alloc_borrowed();
    if n == null { arena_oom(); }
    *n = t;
    return n as *const TypeAnn;
}

fn one_str(a: Allocator, s: str) -> Vec<str> {
    let mut v: Vec<str> = Vec::with_capacity(a, 8 as u32);
    v.push(s);
    return v;
}

// ---------- shared types ----------

fn ty_cvoidptr(ar: *Arena) -> *const Typ {
    return d_ty(ar, Typ::TPtr(d_ty(ar, Typ::TCVoid)));
}
fn ty_u32(ar: *Arena) -> *const Typ {
    return d_ty(ar, Typ::TInt(IntKind { is_signed: false, width: IntWidth::W32 }));
}
fn ty_i32(ar: *Arena) -> *const Typ {
    return d_ty(ar, Typ::TInt(IntKind { is_signed: true, width: IntWidth::W32 }));
}
fn ty_allocator(a: Allocator, ar: *Arena) -> *const Typ {
    return d_ty(ar, Typ::TStruct(one_str(a, "Allocator")));
}
fn ty_free_fn_ptr(a: Allocator, ar: *Arena) -> *const Typ {
    let mut ps: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    ps.push(ty_cvoidptr(ar));
    ps.push(ty_cvoidptr(ar));
    ps.push(ty_u32(ar));
    let nr: Option<*const Typ> = Option::None;
    return d_ty(ar, Typ::TFnPtr { params: ps, ret: nr });
}

// `(alloc.free_fn)(alloc.state, ptr as *c_void, bytes)` (drop.ml:189).
fn free_via(a: Allocator, ar: *Arena, alloc_expr: *const Texpr,
            ptr_expr: *const Texpr, bytes: *const Texpr, pos: Pos) -> Tstmt {
    let ffn = d_te(ar, TexprNode::TFieldAccess { target: alloc_expr, field: "free_fn" },
                   ty_free_fn_ptr(a, ar), pos);
    let stt = d_te(ar, TexprNode::TFieldAccess { target: alloc_expr, field: "state" },
                   ty_cvoidptr(ar), pos);
    let cvann = d_ann(ar, TypeAnn::TyPtr(d_ann(ar, TypeAnn::TyCVoid)));
    let castp = d_te(ar, TexprNode::TCast(ptr_expr, cvann), ty_cvoidptr(ar), pos);
    let mut args: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    args.push(stt);
    args.push(castp);
    args.push(bytes);
    let ic = d_te(ar, TexprNode::TIndirectCall { fn_expr: ffn, args: args }, ty_i32(ar), pos);
    return Tstmt::TExprStmt(ic);
}

// `(size-of inner) as u32` (drop.ml:181) — `(cast (size-of T) :c_int-unsigned :u32)`.
fn size_of_u32(ar: *Arena, inner: *const Typ, pos: Pos) -> *const Texpr {
    let so = d_te(ar, TexprNode::TSizeOf(inner), d_ty(ar, Typ::TCInt { is_signed: false }), pos);
    let u32ann = d_ann(ar, TypeAnn::TyInt { is_signed: false, width: IntWidth::W32 });
    return d_te(ar, TexprNode::TCast(so, u32ann), ty_u32(ar), pos);
}

// ---------- struct-index lookup + droppability ----------

fn find_struct_idx(structs: *const Vec<StructSig>, path: *const Vec<str>) -> int {
    let sl = structs.as_slice();
    let mut i = 0 as u32;
    while i < structs.length() {
        if mpath_eq2(&sl[i].sname_path, path) { return i as int; }
        i = i + 1 as u32;
    }
    return 0 - 1;
}

fn dp_join(a: Allocator, p: *const Vec<str>) -> StringBuilder {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    let sl = p.as_slice();
    let mut i = 0 as u32;
    while i < p.length() { if i > 0 as u32 { sb.push_str("::"); } sb.push_str(sl[i]); i = i + 1 as u32; }
    return sb;
}

fn mpath_eq2(a: *const Vec<str>, b: *const Vec<str>) -> bool {
    if a.length() == b.length() {
        let sa = a.as_slice();
        let sb = b.as_slice();
        let mut i = 0 as u32;
        while i < a.length() { if !str::eq(sa[i], sb[i]) { return false; } i = i + 1 as u32; }
        return true;
    }
    let al = default_allocator();
    let ja = dp_join(al, a);
    let jb = dp_join(al, b);
    if ja.length() != jb.length() { return false; }
    let ba = ja.as_slice();
    let bb = jb.as_slice();
    let mut k = 0 as u32;
    while k < ja.length() { if ba[k] != bb[k] { return false; } k = k + 1 as u32; }
    return true;
}

// Transitive: the struct's field tree (through struct-VALUE fields) reaches
// an `own *T` (drop.ml:108).  Droppable subset of is_affine (no @move-only).
fn has_drop_deep(structs: *const Vec<StructSig>, t: *const Typ) -> bool {
    return match *t {
        Typ::TStruct(path) => struct_owns_by_path(structs, &path)
        | _other => false
    };
}

fn struct_owns_by_path(structs: *const Vec<StructSig>, path: *const Vec<str>) -> bool {
    let idx = find_struct_idx(structs, path);
    if idx < 0 as int { return false; }
    let sl = structs.as_slice();
    let fs = sl[idx as u32].sfields_ty.as_slice();
    let mut i = 0 as u32;
    let mut r = false;
    while i < sl[idx as u32].sfields_ty.length() {
        if field_owns(structs, fs[i].ty) { r = true; }
        i = i + 1 as u32;
    }
    return r;
}

fn field_owns(structs: *const Vec<StructSig>, ft: *const Typ) -> bool {
    return match *ft {
        Typ::TOwnPtr(_i) => true
        | Typ::TStruct(_p) => has_drop_deep(structs, ft)
        | _other => false
    };
}

// Does dropping a VALUE of this type require real work? (drop.ml:259).
// Enums recurse through payloads; used to route own-fields to glue (which
// this slice skips) vs an inline free.
fn droppable_deep(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, t: *const Typ) -> bool {
    return match *t {
        Typ::TOwnPtr(_i) => true
        | Typ::TStruct(_p) => has_drop_deep(structs, t)
        | Typ::TEnum(path) => enum_owns(structs, enums, &path)
        | Typ::TEnumApp { path, args } => enum_owns(structs, enums, &path)
        | _other => false
    };
}

fn enum_owns(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, path: *const Vec<str>) -> bool {
    let el = enums.as_slice();
    let mut i = 0 as u32;
    while i < enums.length() {
        if mpath_eq2(&el[i].ename_path, path) {
            let vl = el[i].evariants.as_slice();
            let mut j = 0 as u32;
            while j < el[i].evariants.length() {
                let fl = vl[j].vsfields.as_slice();
                let mut k = 0 as u32;
                while k < vl[j].vsfields.length() {
                    if droppable_deep(structs, enums, fl[k].ty) { return true; }
                    k = k + 1 as u32;
                }
                j = j + 1 as u32;
            }
            return false;
        }
        i = i + 1 as u32;
    }
    return false;
}

// ---------- deep-drop glue requests ----------
//
// A droppable pointee / Vec-element / HashMap-slot needs a recursive drop
// helper.  Its DEFINITION is synthesized with a <prelude> position (filtered
// from the --user-only dump), so only the CALL sites are differentially
// checked.  Names are `__drop_<prefix>_<N>` where N is the global request
// order (deduped by key) — the port walks functions and drops in the same
// order as the oracle, so the counters line up.

pub struct GlueState {
    // The drop pass had NO error channel: fourteen `Error.failf` sites in the
    // reference against zero here, and `merge_branches` said so in its own
    // comment ("valid source never mismatches, so take then"). The latch rides
    // in the glue state because that already reaches every reporting site -
    // threading a parameter through fourteen functions to reach nine of them
    // would have been the same change, spelt longer.
    //
    // First error wins, like `move.exl`'s `Mv`: the walk order matches the
    // reference's, so the first latched IS the one it would have raised.
    gs_err: *Option<*const CompileError>,
    // Minted C name -> what the user wrote, so a diagnostic quotes the source.
    gs_srcnames: *Vec<StrPair>,
    gs_keys: Vec<str>,
    gs_names: Vec<str>,
    // Per request: the type to build the glue body from (vec/hm: the container
    // instance as TStruct; ptr: the pointee), and the kind (0=vec, 1=hm, 2=ptr).
    gs_meta: Vec<*const Typ>,
    gs_kind: Vec<u32>,
}

fn join_colons(a: Allocator, ar: *Arena, path: *const Vec<str>) -> str {
    let mut sb = StringBuilder::with_capacity(a, 16 as u32);
    let sl = path.as_slice();
    let mut i = 0 as u32;
    while i < path.length() {
        if i > 0 as u32 { sb.push_str("::"); }
        sb.push_str(sl[i]);
        i = i + 1 as u32;
    }
    return str::from_slice(ar, sb.as_slice());
}

// A type key that dedups identically to the oracle's `mangle_typ` for the
// pointee shapes deep-drop glue ever sees (structs / enums carrying owned
// fields): the instance path uniquely identifies the type.
fn type_key(a: Allocator, ar: *Arena, t: *const Typ) -> str {
    return match *t {
        Typ::TStruct(p) => join_colons(a, ar, &p)
        | Typ::TEnum(p) => join_colons(a, ar, &p)
        | Typ::TEnumApp { path, args } => join_colons(a, ar, &path)
        | Typ::TStructApp { path, args } => join_colons(a, ar, &path)
        // A shared constant here is worse than an abort: two unnameable pointee
        // shapes would DEDUP to one glue function.  The comment above claims
        // glue only ever sees named types — this is that claim, enforced.
        | _other => drop_key_unnameable()
    };
}
fn drop_key_unnameable() -> str {
    ice("internal: deep-drop glue reached a pointee with no named type key");
    return "";
}

fn glue_find(gs: *const GlueState, key: str) -> int {
    let kl = gs.gs_keys.as_slice();
    let mut i = 0 as u32;
    while i < gs.gs_keys.length() { if str::eq(kl[i], key) { return i as int; } i = i + 1 as u32; }
    return 0 - 1;
}

fn request_glue(a: Allocator, ar: *Arena, gs: *GlueState, key: str, prefix: str, meta: *const Typ, kind: u32) -> str {
    let idx = glue_find(gs, key);
    if idx >= 0 as int { let nl = gs.gs_names.as_slice(); return nl[idx as u32]; }
    let mut sb = StringBuilder::with_capacity(a, 20 as u32);
    sb.push_str("__drop_");
    sb.push_str(prefix);
    sb.push_str("_");
    sb.push_int(gs.gs_keys.length() as int);
    let name = str::from_slice(ar, sb.as_slice());
    gs.gs_keys.push(key);
    gs.gs_names.push(name);
    gs.gs_meta.push(meta);
    gs.gs_kind.push(kind);
    return name;
}

fn key_with_prefix(a: Allocator, ar: *Arena, pfx: str, body: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 20 as u32);
    sb.push_str(pfx);
    sb.push_str(body);
    return str::from_slice(ar, sb.as_slice());
}

fn request_ptr_glue(a: Allocator, ar: *Arena, gs: *GlueState, pointee: *const Typ) -> str {
    return request_glue(a, ar, gs, key_with_prefix(a, ar, "ptr:", type_key(a, ar, pointee)), "ptr", pointee, 2 as u32);
}
fn request_vec_glue(a: Allocator, ar: *Arena, gs: *GlueState, path: *const Vec<str>) -> str {
    return request_glue(a, ar, gs, key_with_prefix(a, ar, "vec:", join_colons(a, ar, path)), "vec", d_ty(ar, Typ::TStruct(copy_strs_d(a, path))), 0 as u32);
}
fn request_hm_glue(a: Allocator, ar: *Arena, gs: *GlueState, path: *const Vec<str>) -> str {
    return request_glue(a, ar, gs, key_with_prefix(a, ar, "hm:", join_colons(a, ar, path)), "hm", d_ty(ar, Typ::TStruct(copy_strs_d(a, path))), 1 as u32);
}

fn glue_call(ar: *Arena, name: str, args: Vec<*const Texpr>, pos: Pos) -> Tstmt {
    let ic = d_te(ar, TexprNode::TCall { mangled: name, args: args }, ty_i32(ar), pos);
    return Tstmt::TExprStmt(ic);
}


fn copy_strs_d(a: Allocator, src: *const Vec<str>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < src.length() { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}
fn glue_pos() -> Pos { return Pos { line: 0 as int, col: 0 as int, file: "<prelude>" }; }

// A Typ -> TypeAnn for glue-fn parameters (mirrors the oracle's ann_of): only
// the shapes glue params ever take (struct / the three pointer flavours).
fn ann_of_ty(ar: *Arena, t: *const Typ) -> *const TypeAnn {
    let no_args: Vec<*const TypeAnn> = Vec::with_capacity(default_allocator(), 8 as u32);
    return match *t {
        Typ::TStruct(p) => d_ann(ar, TypeAnn::TyStruct { path: p, args: no_args })
        | Typ::TPtr(i) => d_ann(ar, TypeAnn::TyPtr(ann_of_ty(ar, i)))
        | Typ::TOwnPtr(i) => d_ann(ar, TypeAnn::TyOwnPtr(ann_of_ty(ar, i)))
        | Typ::TConstPtr(i) => d_ann(ar, TypeAnn::TyConstPtr(ann_of_ty(ar, i)))
        | _o => d_ann(ar, TypeAnn::TyPtr(d_ann(ar, TypeAnn::TyCVoid)))
    };
}
fn mk_glue_param(ar: *Arena, name: str, ty: *const Typ) -> Param {
    let no_reg: Option<str> = Option::None;
    return Param { pname: name, pty: ann_of_ty(ar, ty), is_mut: false, preg: no_reg };
}
// Assemble a glue Tfunc: <prelude>-positioned (filtered from the IR dump,
// emitted in C), no return, a single `__i` u32 let for the count loop.
fn mk_glue_tfunc(a: Allocator, _ar: *Arena, name: str, params: Vec<Param>, param_tys: Vec<*const Typ>,
                 lets: Vec<FieldTy>, body: Vec<Tstmt>) -> Tfunc {
    let none_ret: Option<*const TypeAnn> = Option::None;
    let none_ret2: Option<*const Typ> = Option::None;
    let none_str: Option<str> = Option::None;
    let mut tpath: Vec<str> = Vec::with_capacity(a, 8 as u32);
    tpath.push(name);
    let ftparams: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let ftbounds: Vec<TraitBound> = Vec::with_capacity(a, 8 as u32);
    let fbody: Vec<Stmt> = Vec::with_capacity(a, 8 as u32);
    let f = Func { name: name, c_name: name, tparams: ftparams,
                   tbounds: ftbounds, params: params, ret_ty: none_ret,
                   body: fbody, is_pub: false, is_extern: false,
                   is_variadic: false, amiga_lib: none_str, tier_hint: none_str, must_use: false,
                   escapes_hatch: false, pos: glue_pos() };
    let none_origin: Option<Pos> = Option::None;
    // Synthesized glue: every name here is the compiler's own, so there is
    // nothing to map back to a user's source name.
    let no_srcnames2: Vec<StrPair> = Vec::with_capacity(a, 8 as u32);
    return Tfunc { tf_path: tpath, tf_func: f, tf_mangled: name, tf_param_tys: param_tys,
                   tf_ret_ty: none_ret2, tf_body: body, tf_lets: lets, tf_srcnames: no_srcnames2, tf_origin_pos: none_origin };
}
// `__i = 0; while __i < bound { <inner>; __i = __i + 1 }`.
fn count_loop(a: Allocator, ar: *Arena, bound: *const Texpr, inner: Vec<Tstmt>, pos: Pos) -> Vec<Tstmt> {
    let iv = d_te(ar, TexprNode::TVar("__i"), ty_u32(ar), pos);
    let zero = d_te(ar, TexprNode::TIntLit(0 as int), ty_u32(ar), pos);
    let one = d_te(ar, TexprNode::TIntLit(1 as int), ty_u32(ar), pos);
    let cond = d_te(ar, TexprNode::TBinOp(BinOp::Lt, iv, bound), d_ty(ar, Typ::TBool), pos);
    let stepv = d_te(ar, TexprNode::TBinOp(BinOp::Add, iv, one), ty_u32(ar), pos);
    let mut ip: Vec<str> = Vec::with_capacity(a, 8 as u32);
    ip.push("__i");
    let mut body: Vec<Tstmt> = Vec::with_capacity(a, inner.length() + 1 as u32);
    let isl = inner.as_slice();
    let mut k = 0 as u32;
    while k < inner.length() { body.push(isl[k]); k = k + 1 as u32; }
    body.push(Tstmt::TAssign { path: ip, value: stepv, pos: pos });
    let empty_post: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let mut out: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    out.push(Tstmt::TLet { name: "__i", value: zero, decl_ty: ty_u32(ar), pos: pos });
    out.push(Tstmt::TWhile { cond: cond, body: body, post: empty_post });
    return out;
}
// Drop one container element at lvalue `lv`: recurse for a droppable struct,
// glue/free for an own-ptr (mirrors the oracle's elem_drop_stmts).
fn elem_drop_stmts(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                   gs: *GlueState, container_alloc: *const Texpr, lv: *const Texpr, pos: Pos, out: *Vec<Tstmt>) {
    match *lv.ty {
        Typ::TStruct(p) => {
            let sidx = find_struct_idx(structs, &p);
            drop_stmts_for_struct(a, ar, structs, enums, gs, lv, sidx, pos, out);
        }
        | Typ::TOwnPtr(inner) => {
            maybe_free_own(a, ar, structs, enums, gs, container_alloc, lv, inner, size_of_u32(ar, inner, pos), pos, out);
        }
        | _o => { }
    }
    return;
}
// __drop_vec_N(v): per-element drop over [0, count), then free the buffer.
fn build_vec_glue(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                  gs: *GlueState, name: str, inst_path: *const Vec<str>) -> Tfunc {
    let pos = glue_pos();
    let sidx = find_struct_idx(structs, inst_path);
    let sl = structs.as_slice();
    let sig: *const StructSig = &sl[sidx as u32];
    let elem = match own_field_pointee(sig, "ptr") { Option::Some(e) => e | Option::None => ty_u32(ar) };
    let count_field = if struct_has_field(sig, "count") { "count" } else { "len" };
    let vty = d_ty(ar, Typ::TPtr(d_ty(ar, Typ::TStruct(copy_strs_d(a, inst_path)))));
    let vv = d_te(ar, TexprNode::TVar("__v"), vty, pos);
    let valloc = field_access(ar, vv, "alloc", ty_allocator(a, ar), pos);
    let ptrf = field_access(ar, vv, "ptr", d_ty(ar, Typ::TOwnPtr(elem)), pos);
    let iv = d_te(ar, TexprNode::TVar("__i"), ty_u32(ar), pos);
    let elem_lv = d_te(ar, TexprNode::TIndex { base: ptrf, index: iv }, elem, pos);
    let mut inner: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    elem_drop_stmts(a, ar, structs, enums, gs, valloc, elem_lv, pos, &inner);
    let bound = field_access(ar, vv, count_field, ty_u32(ar), pos);
    let mut body = count_loop(a, ar, bound, inner, pos);
    let capf = field_access(ar, vv, "cap", ty_u32(ar), pos);
    let bytes = d_te(ar, TexprNode::TBinOp(BinOp::Mul, capf, size_of_u32(ar, elem, pos)), ty_u32(ar), pos);
    body.push(free_via(a, ar, valloc, ptrf, bytes, pos));
    let mut params: Vec<Param> = Vec::with_capacity(a, 8 as u32);
    params.push(mk_glue_param(ar, "__v", vty));
    let mut ptys: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    ptys.push(vty);
    let mut lets: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    lets.push(FieldTy { name: "__i", ty: ty_u32(ar) });
    return mk_glue_tfunc(a, ar, name, params, ptys, lets, body);
}
// A field that owns the NEXT node of the same aggregate (`own *Self`).
fn is_self_ptr(ft: *const Typ, path: *const Vec<str>, want_enum: bool) -> bool {
    return match *ft {
        Typ::TOwnPtr(inner) => match *inner {
            Typ::TStruct(p2) => !want_enum && mpath_eq2(&p2, path)
            | Typ::TEnum(p2) => want_enum && mpath_eq2(&p2, path)
            | _i => false
        }
        | _o => false
    };
}
fn self_struct_fields(a: Allocator, structs: *const Vec<StructSig>, sidx: int, sp: *const Vec<str>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    if sidx < 0 as int { return out; }
    let sl = structs.as_slice();
    let sig: *const StructSig = &sl[sidx as u32];
    let fs = sig.sfields_ty.as_slice();
    let mut i = 0 as u32;
    while i < sig.sfields_ty.length() {
        if is_self_ptr(fs[i].ty, sp, false) { out.push(fs[i].name); }
        i = i + 1 as u32;
    }
    return out;
}
fn find_enum_idx(enums: *const Vec<EnumSig>, path: *const Vec<str>) -> int {
    let el = enums.as_slice();
    let mut i = 0 as u32;
    while i < enums.length() {
        if mpath_eq2(&el[i].ename_path, path) { return i as int; }
        i = i + 1 as u32;
    }
    return 0 as int - 1 as int;
}
fn bind_name(a: Allocator, ar: *Arena, fname: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 16 as u32);
    sb.push_str("__d_");
    sb.push_str(fname);
    return str::from_slice(ar, sb.as_slice());
}
fn null_lit_d(ar: *Arena, pos: Pos) -> *const Texpr {
    return d_te(ar, TexprNode::TNullLit, d_ty(ar, Typ::TNullPtr), pos);
}
// `__p != null` / `__p == null`.
fn p_null_cmp(ar: *Arena, pv: *const Texpr, op: BinOp, pos: Pos) -> *const Texpr {
    return d_te(ar, TexprNode::TBinOp(op, pv, null_lit_d(ar, pos)), d_ty(ar, Typ::TBool), pos);
}
fn assign_var(a: Allocator, name: str, value: *const Texpr, pos: Pos) -> Tstmt {
    let mut ip: Vec<str> = Vec::with_capacity(a, 8 as u32);
    ip.push(name);
    return Tstmt::TAssign { path: ip, value: value, pos: pos };
}
// A null guard at the top of the recursive form: an `own *Self` can hold a raw
// null (not just a terminator variant), and the recursive call re-enters this
// same glue, so one guard makes every level null-safe.
fn null_guard(a: Allocator, ar: *Arena, pv: *const Texpr, pos: Pos) -> Tstmt {
    let mut then_body: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let no_val: Option<*const Texpr> = Option::None;
    then_body.push(Tstmt::TReturn { value: no_val, pos: pos });
    let else_body: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    return Tstmt::TIf { cond: p_null_cmp(ar, pv, BinOp::EqEq, pos), then_body: then_body, else_body: else_body };
}
// One arm per variant: bind every droppable payload field and drop it.  When
// `self_next` is set, a field owning the next node of the SAME enum is not
// recursed into — it is stashed in `__next` and the spine walks iteratively.
fn build_enum_arm(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                  gs: *GlueState, av: *const Texpr, v: *const VariantSig, ep: *const Vec<str>,
                  tag: int, self_next: bool, pos: Pos) -> TmatchArm {
    let mut binds: Vec<TFieldPat> = Vec::with_capacity(a, 8 as u32);
    let mut stmts: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let fl = v.vsfields.as_slice();
    let mut fi = 0 as u32;
    while fi < v.vsfields.length() {
        let want = match *fl[fi].ty {
            Typ::TOwnPtr(_i) => true
            | Typ::TStruct(_p) => has_drop_deep(structs, fl[fi].ty)
            | _o => false
        };
        if want {
            let bn = bind_name(a, ar, fl[fi].name);
            binds.push(TFieldPat { name: fl[fi].name, pat: Tpattern::TPVar(bn) });
            let bv = d_te(ar, TexprNode::TVar(bn), fl[fi].ty, pos);
            if self_next && is_self_ptr(fl[fi].ty, ep, true) {
                stmts.push(assign_var(a, "__next", bv, pos));
            } else {
                elem_drop_stmts(a, ar, structs, enums, gs, av, bv, pos, &stmts);
            }
        }
        fi = fi + 1 as u32;
    }
    let no_trail: Option<*const Texpr> = Option::None;
    let body = d_te(ar, TexprNode::TBlock { stmts: stmts, trailing: no_trail }, ty_i32(ar), pos);
    let no_guard: Option<*const Texpr> = Option::None;
    return TmatchArm {
        tpat: Tpattern::TPVariant { variant: v.vsname, tag: tag, binds: binds },
        tguard: no_guard, tbody: body, tdiverges: false, tarm_pos: pos,
    };
}
// One arm per variant: bind every droppable payload field and drop it.  When
// `self_next` is set, a field owning the next node of the SAME enum is not
// recursed into — it is stashed in `__next` and the spine walks iteratively.
fn build_enum_arms(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                   gs: *GlueState, av: *const Texpr, es: *const EnumSig, ep: *const Vec<str>,
                   self_next: bool, pos: Pos) -> Vec<TmatchArm> {
    let mut arms: Vec<TmatchArm> = Vec::with_capacity(a, 8 as u32);
    let vl = es.evariants.as_slice();
    let mut vi = 0 as u32;
    while vi < es.evariants.length() {
        arms.push(build_enum_arm(a, ar, structs, enums, gs, av, &vl[vi], ep, vi as int, self_next, pos));
        vi = vi + 1 as u32;
    }
    return arms;
}
fn match_stmt_d(a: Allocator, ar: *Arena, deref: *const Texpr, ep: *const Vec<str>,
                arms: Vec<TmatchArm>, pos: Pos) -> Tstmt {
    let m = d_te(ar, TexprNode::TMatch { scrutinee: deref, ename_path: copy_strs_d(a, ep), arms: arms }, ty_i32(ar), pos);
    return Tstmt::TExprStmt(m);
}
// Every variant owns at most one next-node of the same enum, and at least one
// does: a linear list, torn down iteratively.  A genuine tree (a variant with
// two self-owned children) keeps recursion — C-stack depth, a documented limit.
fn enum_is_linear(es: *const EnumSig, ep: *const Vec<str>) -> bool {
    let vl = es.evariants.as_slice();
    let mut any = false;
    let mut vi = 0 as u32;
    while vi < es.evariants.length() {
        let fl = vl[vi].vsfields.as_slice();
        let mut n = 0 as u32;
        let mut fi = 0 as u32;
        while fi < vl[vi].vsfields.length() {
            if is_self_ptr(fl[fi].ty, ep, true) { n = n + 1 as u32; }
            fi = fi + 1 as u32;
        }
        if n > 1 as u32 { return false; }
        if n == 1 as u32 { any = true; }
        vi = vi + 1 as u32;
    }
    return any;
}
// __drop_ptr_N(a, p): drop the pointee's owned fields, then free the box.
//
// A pointee that owns the next node of its own type is a SPINE: recursing burns
// one non-tail C frame per node, so a long owned list overruns a small (kernel)
// stack at scope exit.  When the spine is linear — one self-owned next per
// struct / per variant — tear it down iteratively with a `__next` cursor:
// O(1) stack however long the list grows, and the `__p != null` loop guard also
// covers the terminator the recursive form would have dereferenced.
// The struct spine / tree body.  Returns true when it emitted the iterative form.
fn ptr_glue_struct(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                   gs: *GlueState, av: *const Texpr, pv: *const Texpr, pty: *const Typ,
                   deref: *const Texpr, pointee: *const Typ, sp: *const Vec<str>, pos: Pos,
                   body: *Vec<Tstmt>, lets: *Vec<FieldTy>) -> bool {
    let sidx = find_struct_idx(structs, sp);
    let selfs = self_struct_fields(a, structs, sidx, sp);
    if selfs.length() != 1 as u32 {
        body.push(null_guard(a, ar, pv, pos));
        drop_stmts_for_struct(a, ar, structs, enums, gs, deref, sidx, pos, body);
        body.push(free_via(a, ar, av, pv, size_of_u32(ar, pointee, pos), pos));
        return false;
    }
    let self_fn = selfs.as_slice()[0 as u32];
    let mut wb: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    wb.push(assign_var(a, "__next", field_access(ar, deref, self_fn, pty, pos), pos));
    drop_stmts_for_struct_skip(a, ar, structs, enums, gs, deref, sidx, self_fn, pos, &wb);
    wb.push(free_via(a, ar, av, pv, size_of_u32(ar, pointee, pos), pos));
    wb.push(assign_var(a, "__p", d_te(ar, TexprNode::TVar("__next"), pty, pos), pos));
    let post: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    body.push(Tstmt::TWhile { cond: p_null_cmp(ar, pv, BinOp::NotEq, pos), body: wb, post: post });
    lets.push(FieldTy { name: "__next", ty: pty });
    return true;
}
fn ptr_glue_enum(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                 gs: *GlueState, av: *const Texpr, pv: *const Texpr, pty: *const Typ,
                 deref: *const Texpr, pointee: *const Typ, ep: *const Vec<str>, pos: Pos,
                 body: *Vec<Tstmt>, lets: *Vec<FieldTy>) -> bool {
    let eidx = find_enum_idx(enums, ep);
    if eidx < 0 as int {
        body.push(free_via(a, ar, av, pv, size_of_u32(ar, pointee, pos), pos));
        return false;
    }
    let el = enums.as_slice();
    let es: *const EnumSig = &el[eidx as u32];
    if !enum_is_linear(es, ep) {
        let rec_arms = build_enum_arms(a, ar, structs, enums, gs, av, es, ep, false, pos);
        body.push(null_guard(a, ar, pv, pos));
        body.push(match_stmt_d(a, ar, deref, ep, rec_arms, pos));
        body.push(free_via(a, ar, av, pv, size_of_u32(ar, pointee, pos), pos));
        return false;
    }
    let arms = build_enum_arms(a, ar, structs, enums, gs, av, es, ep, true, pos);
    let mut wb: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    wb.push(assign_var(a, "__next", null_lit_d(ar, pos), pos));
    wb.push(match_stmt_d(a, ar, deref, ep, arms, pos));
    wb.push(free_via(a, ar, av, pv, size_of_u32(ar, pointee, pos), pos));
    wb.push(assign_var(a, "__p", d_te(ar, TexprNode::TVar("__next"), pty, pos), pos));
    let post: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    body.push(Tstmt::TWhile { cond: p_null_cmp(ar, pv, BinOp::NotEq, pos), body: wb, post: post });
    lets.push(FieldTy { name: "__next", ty: pty });
    return true;
}
fn build_ptr_glue(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                  gs: *GlueState, name: str, pointee: *const Typ) -> Tfunc {
    let pos = glue_pos();
    let av = d_te(ar, TexprNode::TVar("__a"), ty_allocator(a, ar), pos);
    let pty = d_ty(ar, Typ::TOwnPtr(pointee));
    let pv = d_te(ar, TexprNode::TVar("__p"), pty, pos);
    let deref = d_te(ar, TexprNode::TDeref(pv), pointee, pos);
    let mut body: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let mut lets: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    match *pointee {
        Typ::TStruct(sp) => {
            ptr_glue_struct(a, ar, structs, enums, gs, av, pv, pty, deref, pointee, &sp, pos, &body, &lets);
        }
        | Typ::TEnum(ep) => {
            ptr_glue_enum(a, ar, structs, enums, gs, av, pv, pty, deref, pointee, &ep, pos, &body, &lets);
        }
        | _o => { body.push(free_via(a, ar, av, pv, size_of_u32(ar, pointee, pos), pos)); }
    }
    let mut params: Vec<Param> = Vec::with_capacity(a, 8 as u32);
    params.push(mk_glue_param(ar, "__a", ty_allocator(a, ar)));
    params.push(mk_glue_param(ar, "__p", pty));
    let mut ptys: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    ptys.push(ty_allocator(a, ar));
    ptys.push(pty);
    return mk_glue_tfunc(a, ar, name, params, ptys, lets, body);
}
// __drop_hm_N(m): per-slot key/value drop over Occupied slots, then free buffer.
fn build_hm_glue(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                 gs: *GlueState, name: str, inst_path: *const Vec<str>) -> Tfunc {
    let pos = glue_pos();
    let sidx = find_struct_idx(structs, inst_path);
    let sl = structs.as_slice();
    let sig: *const StructSig = &sl[sidx as u32];
    let slot = match own_field_pointee(sig, "slots") { Option::Some(e) => e | Option::None => ty_u32(ar) };
    let mty = d_ty(ar, Typ::TPtr(d_ty(ar, Typ::TStruct(copy_strs_d(a, inst_path)))));
    let mv = d_te(ar, TexprNode::TVar("__m"), mty, pos);
    let malloc = field_access(ar, mv, "alloc", ty_allocator(a, ar), pos);
    let slotsf = field_access(ar, mv, "slots", d_ty(ar, Typ::TOwnPtr(slot)), pos);
    let iv = d_te(ar, TexprNode::TVar("__i"), ty_u32(ar), pos);
    let slot_lv = d_te(ar, TexprNode::TIndex { base: slotsf, index: iv }, slot, pos);
    let statef = field_access(ar, slot_lv, "state", d_ty(ar, Typ::TInt(IntKind { is_signed: false, width: IntWidth::W8 })), pos);
    let one8 = d_te(ar, TexprNode::TIntLit(1 as int), d_ty(ar, Typ::TInt(IntKind { is_signed: false, width: IntWidth::W8 })), pos);
    let occ = d_te(ar, TexprNode::TBinOp(BinOp::EqEq, statef, one8), d_ty(ar, Typ::TBool), pos);
    let slot_sidx = find_struct_idx(structs, &slot_path_of(a, slot));
    let ssl = structs.as_slice();
    let mut kv: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    if slot_sidx >= 0 as int {
        let kty = own_or_field_ty(&ssl[slot_sidx as u32], "key", ar);
        let vty = own_or_field_ty(&ssl[slot_sidx as u32], "value", ar);
        let klv = field_access(ar, slot_lv, "key", kty, pos);
        elem_drop_stmts(a, ar, structs, enums, gs, malloc, klv, pos, &kv);
        let vlv = field_access(ar, slot_lv, "value", vty, pos);
        elem_drop_stmts(a, ar, structs, enums, gs, malloc, vlv, pos, &kv);
    }
    // hm glue is only requested when a K or V is droppable, so `kv` is never
    // empty here — emit the Occupied-guarded drop unconditionally.
    let mut inner: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let empty_else: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    inner.push(Tstmt::TIf { cond: occ, then_body: kv, else_body: empty_else });
    let bound = field_access(ar, mv, "cap", ty_u32(ar), pos);
    let mut body = count_loop(a, ar, bound, inner, pos);
    let capf = field_access(ar, mv, "cap", ty_u32(ar), pos);
    let bytes = d_te(ar, TexprNode::TBinOp(BinOp::Mul, capf, size_of_u32(ar, slot, pos)), ty_u32(ar), pos);
    body.push(free_via(a, ar, malloc, slotsf, bytes, pos));
    let mut params: Vec<Param> = Vec::with_capacity(a, 8 as u32);
    params.push(mk_glue_param(ar, "__m", mty));
    let mut ptys: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    ptys.push(mty);
    let mut lets: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
    lets.push(FieldTy { name: "__i", ty: ty_u32(ar) });
    return mk_glue_tfunc(a, ar, name, params, ptys, lets, body);
}
// COPY the path out of the Typ node: binding `p` and returning it yields a
// shallow Vec sharing the arena node's heap buffer, and the local's auto-drop
// then frees it — the Typ is left dangling and later reads print whatever now
// occupies that memory (a live heap-use-after-free, caught by ASan).
fn slot_path_of(a: Allocator, slot: *const Typ) -> Vec<str> {
    let empty: Vec<str> = Vec::with_capacity(a, 8 as u32);
    return match *slot { Typ::TStruct(p) => copy_strs_d(a, &p) | _o => empty };
}
fn own_or_field_ty(sig: *const StructSig, fname: str, ar: *Arena) -> *const Typ {
    let fs = sig.sfields_ty.as_slice();
    let mut i = 0 as u32;
    while i < sig.sfields_ty.length() { if str::eq(fs[i].name, fname) { return fs[i].ty; } i = i + 1 as u32; }
    return ty_u32(ar);
}
// Build every requested glue body to a fixpoint (a body may request more).
fn drain_glue(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
              gs: *GlueState, out: *Vec<Tfunc>) {
    let mut i = 0 as u32;
    while i < gs.gs_names.length() {
        let name = gs.gs_names.as_slice()[i];
        let kind = gs.gs_kind.as_slice()[i];
        let meta = gs.gs_meta.as_slice()[i];
        if kind == 0 as u32 {
            match *meta { Typ::TStruct(pth) => { out.push(build_vec_glue(a, ar, structs, enums, gs, name, &pth)); } | _o => { } }
        } else {
            if kind == 1 as u32 {
                match *meta { Typ::TStruct(pth) => { out.push(build_hm_glue(a, ar, structs, enums, gs, name, &pth)); } | _o => { } }
            } else {
                out.push(build_ptr_glue(a, ar, structs, enums, gs, name, meta));
            }
        }
        i = i + 1 as u32;
    }
    return;
}

// ---------- entry model (struct-index based → DEntry is copyable) ----------

pub enum DStatus { DLive | DConsumed | DPartial }

pub enum DKind {
    DStructDrop(int)
    | DArrayDrop { da_sidx: int, da_size: int }
    | DBareOwn { bo_pointee: *const Typ, bo_prov: Option<str> }
}

pub struct DEntry {
    den_name: str,
    den_status: DStatus,
    den_kind: DKind,
    den_pos: Pos,
}

fn prov_of(value: *const Texpr) -> Option<str> {
    return match value.e {
        TexprNode::TNew { sname_path, fields, base, alloc } => prov_of_alloc(alloc)
        | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => prov_of_alloc(alloc)
        | TexprNode::TCall { mangled, args } => prov_of_call(mangled, &args)
        | _other => { let x: Option<str> = Option::None; x }
    };
}

fn prov_of_call(mangled: str, args: *const Vec<*const Texpr>) -> Option<str> {
    let x: Option<str> = Option::None;
    if !str_starts_with(mangled, "Allocator__alloc") { return x; }
    if args.length() == 0 as u32 { return x; }
    let al = args.as_slice();
    return match al[0].e {
        TexprNode::TVar(n) => Option::Some(n)
        | _o => x
    };
}

fn prov_of_alloc(alloc: Option<*const Texpr>) -> Option<str> {
    let nn: Option<str> = Option::None;
    return match alloc {
        Option::Some(ae) => match ae.e {
            TexprNode::TVar(n) => Option::Some(n)
            | _o => nn
        }
        | Option::None => nn
    };
}

fn raise_dp(ar: *Arena, gs: *GlueState, pos: Pos, msg: str) {
    match *gs.gs_err {
        Option::Some(_e) => { }
        | Option::None => { *gs.gs_err = Option::Some(error::alloc(ar, pos, msg)); }
    }
    return;
}
fn dp_disp(gs: *const GlueState, n: str) -> str {
    let sl = gs.gs_srcnames.as_slice();
    let mut i = 0 as u32;
    while i < gs.gs_srcnames.length() {
        if str::eq(sl[i].a, n) { return sl[i].b; }
        i = i + 1 as u32;
    }
    return n;
}
// An expression statement that produces an owning value: nothing tracks it and
// nothing releases it.
fn discarded_struct(structs: *const Vec<StructSig>, ar: *Arena, gs: *GlueState, e: *const Texpr) {
    if !has_drop_deep(structs, e.ty) { return; }
    raise_dp(ar, gs, e.pos, "this expression produces an owning value that is silently discarded (and leaked) — bind it with `let` so it can be dropped or consumed");
    return;
}
fn check_discarded_own(structs: *const Vec<StructSig>, a: Allocator, ar: *Arena, gs: *GlueState, e: *const Texpr) {
    match *e.ty {
        Typ::TOwnPtr(_i) => {
            raise_dp(ar, gs, e.pos, "this call returns an owned pointer that is silently discarded (and leaked) — bind it with `let`, then free, move, or return it");
        }
        // A struct whose field tree reaches an `own *T` owns just as much as a
        // bare pointer does, and dropping it on the floor leaks the same way.
        | Typ::TStruct(_p) => { discarded_struct(structs, ar, gs, e); }
        | _o => { }
    }
    return;
}
// Assigning over a live owner whose allocator is not known drops the old value
// on the floor - there is nothing to release it with.
fn check_assign_leak(a: Allocator, ar: *Arena, gs: *GlueState, e: *const DEntry, pos: Pos) {
    match e.den_kind {
        DKind::DBareOwn { bo_pointee, bo_prov } => {
            match bo_prov {
                Option::Some(_an) => { }
                | Option::None => {
                    let d = dp_disp(gs, e.den_name);
                    let mut sb = StringBuilder::with_capacity(a, 200 as u32);
                    sb.push_str("assigning to '"); sb.push_str(d);
                    sb.push_str("' would silently leak its current value (allocator provenance unknown) — free it or move it first");
                    raise_dp(ar, gs, pos, str::from_slice(ar, sb.as_slice()));
                }
            }
        }
        | _o => { }
    }
    return;
}
// An array of bare `own *T` has no allocator at hand to release its elements
// with - silent-leak territory, so the reference rejects it rather than emitting
// a drop it cannot write.
fn check_array_of_own(a: Allocator, ar: *Arena, gs: *GlueState, ty: *const Typ, pos: Pos) {
    match *ty {
        Typ::TArray { elem, size } => {
            match *elem {
                Typ::TOwnPtr(_i) => {
                    raise_dp(ar, gs, pos, "an array of bare `own *T` cannot be auto-dropped (no allocator at hand for the elements) — wrap the pointers in an allocator-carrying struct, or use a Vec");
                }
                | _o => { }
            }
        }
        | _o => { }
    }
    return;
}
fn entry_for(structs: *const Vec<StructSig>, name: str, ty: *const Typ, pos: Pos) -> Option<DEntry> {
    let none_e: Option<DEntry> = Option::None;
    return match *ty {
        Typ::TStruct(path) => entry_for_struct(structs, name, ty, &path, pos)
        | Typ::TOwnPtr(inner) => {
            let np: Option<str> = Option::None;
            Option::Some(DEntry { den_name: name, den_status: DStatus::DLive,
                                  den_kind: DKind::DBareOwn { bo_pointee: inner, bo_prov: np }, den_pos: pos })
        }
        | _other => none_e
    };
}

fn entry_for_struct(structs: *const Vec<StructSig>, name: str, ty: *const Typ,
                    path: *const Vec<str>, pos: Pos) -> Option<DEntry> {
    if !has_drop_deep(structs, ty) { let x: Option<DEntry> = Option::None; return x; }
    let idx = find_struct_idx(structs, path);
    return Option::Some(DEntry { den_name: name, den_status: DStatus::DLive,
                                 den_kind: DKind::DStructDrop(idx), den_pos: pos });
}

// ---------- drop emission ----------

fn field_access(ar: *Arena, base: *const Texpr, name: str, ty: *const Typ, pos: Pos) -> *const Texpr {
    return d_te(ar, TexprNode::TFieldAccess { target: base, field: name }, ty, pos);
}

fn struct_has_field(sig: *const StructSig, name: str) -> bool {
    let fs = sig.sfields_ty.as_slice();
    let mut i = 0 as u32;
    while i < sig.sfields_ty.length() {
        if str::eq(fs[i].name, name) { return true; }
        i = i + 1 as u32;
    }
    return false;
}

// Byte-count heuristic (drop.ml:370): cap -> cap*size / len -> len+1 / else size.
fn bytes_expr(_a: Allocator, ar: *Arena, sig: *const StructSig, base: *const Texpr,
              inner: *const Typ, pos: Pos) -> *const Texpr {
    if struct_has_field(sig, "cap") {
        let cap = field_access(ar, base, "cap", ty_u32(ar), pos);
        return d_te(ar, TexprNode::TBinOp(BinOp::Mul, cap, size_of_u32(ar, inner, pos)), ty_u32(ar), pos);
    }
    if struct_has_field(sig, "len") {
        let len = field_access(ar, base, "len", ty_u32(ar), pos);
        let one = d_te(ar, TexprNode::TIntLit(1), ty_u32(ar), pos);
        return d_te(ar, TexprNode::TBinOp(BinOp::Add, len, one), ty_u32(ar), pos);
    }
    return size_of_u32(ar, inner, pos);
}

fn own_field_pointee(sig: *const StructSig, fname: str) -> Option<*const Typ> {
    let none_t: Option<*const Typ> = Option::None;
    let fs = sig.sfields_ty.as_slice();
    let mut i = 0 as u32;
    while i < sig.sfields_ty.length() {
        if str::eq(fs[i].name, fname) {
            return match *fs[i].ty { Typ::TOwnPtr(inner) => Option::Some(inner) | _o => none_t };
        }
        i = i + 1 as u32;
    }
    return none_t;
}

fn is_stringbuilder(path: *const Vec<str>) -> bool {
    if path.length() == 0 as u32 { return false; }
    let sl = path.as_slice();
    return str::eq(sl[path.length() - 1 as u32], "StringBuilder");
}

fn elem_droppable(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, inner: *const Typ) -> bool {
    if droppable_deep(structs, enums, inner) { return true; }
    return match *inner { Typ::TOwnPtr(_i) => true | _o => false };
}

// A HashMap Slot struct owns droppable contents iff its `key` or `value`
// field is itself droppable (drop.ml:339).
fn slot_kv_droppable(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, slot_ty: *const Typ) -> bool {
    let idx = struct_idx_of_ty(structs, slot_ty);
    if idx < 0 as int { return false; }
    let sl = structs.as_slice();
    let fs = sl[idx as u32].sfields_ty.as_slice();
    let mut i = 0 as u32;
    while i < sl[idx as u32].sfields_ty.length() {
        let is_kv = str::eq(fs[i].name, "key") || str::eq(fs[i].name, "value");
        if is_kv && elem_droppable(structs, enums, fs[i].ty) { return true; }
        i = i + 1 as u32;
    }
    return false;
}

fn base_ref_of(ar: *Arena, base: *const Texpr, pos: Pos) -> *const Texpr {
    return match *base.ty {
        Typ::TPtr(_i) => base
        | Typ::TOwnPtr(_i) => base
        | Typ::TConstPtr(_i) => base
        | _o => d_te(ar, TexprNode::TRef(base), d_ty(ar, Typ::TPtr(base.ty)), pos)
    };
}

// Release everything [base] (a droppable struct value at struct index [sidx])
// owns.  Vec / StringBuilder / HashMap instances with droppable elements
// divert to their synthesized glue (a call to `__drop_{vec,hm}_N`); otherwise
// free each direct own-field through the sibling `alloc` (recursing via glue
// when the pointee is itself droppable) and recurse into droppable struct
// fields (drop.ml:310).
fn drop_stmts_for_struct(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>,
                         enums: *const Vec<EnumSig>, gs: *GlueState, base: *const Texpr, sidx: int,
                         pos: Pos, out: *Vec<Tstmt>) {
    drop_stmts_for_struct_skip(a, ar, structs, enums, gs, base, sidx, "", pos, out);
    return;
}
// `skip` names the spine field the iterative tear-down handles itself ("" = none).
fn drop_stmts_for_struct_skip(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>,
                              enums: *const Vec<EnumSig>, gs: *GlueState, base: *const Texpr, sidx: int,
                              skip: str, pos: Pos, out: *Vec<Tstmt>) {
    if sidx < 0 as int { return; }
    let sl = structs.as_slice();
    if try_container_glue(a, ar, structs, enums, gs, base, &sl[sidx as u32], sidx, pos, out) { return; }
    let alloc_f = field_access(ar, base, "alloc", ty_allocator(a, ar), pos);
    let fs = sl[sidx as u32].sfields_ty.as_slice();
    let mut i = 0 as u32;
    while i < sl[sidx as u32].sfields_ty.length() {
        if !str::eq(fs[i].name, skip) {
            drop_one_field(a, ar, structs, enums, gs, base, &sl[sidx as u32], alloc_f, fs[i].name, fs[i].ty, pos, out);
        }
        i = i + 1 as u32;
    }
    return;
}

// Divert a Vec / StringBuilder / HashMap value to its element-drop glue;
// returns true when it emitted the glue call (caller then skips per-field).
fn try_container_glue(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                      gs: *GlueState, base: *const Texpr, sig: *const StructSig, _sidx: int,
                      pos: Pos, out: *Vec<Tstmt>) -> bool {
    if try_vec_glue(a, ar, structs, enums, gs, base, sig, pos, out) { return true; }
    if try_hm_glue(a, ar, structs, enums, gs, base, sig, pos, out) { return true; }
    return false;
}

fn try_vec_glue(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                gs: *GlueState, base: *const Texpr, sig: *const StructSig, pos: Pos, out: *Vec<Tstmt>) -> bool {
    if !is_vec_instance2(&sig.sname_path) && !is_stringbuilder(&sig.sname_path) { return false; }
    return match own_field_pointee(sig, "ptr") {
        Option::Some(elem) => vec_glue_emit(a, ar, structs, enums, gs, base, sig, elem, pos, out)
        | Option::None => false
    };
}

fn vec_glue_emit(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                 gs: *GlueState, base: *const Texpr, sig: *const StructSig, elem: *const Typ,
                 pos: Pos, out: *Vec<Tstmt>) -> bool {
    if !elem_droppable(structs, enums, elem) { return false; }
    let g = request_vec_glue(a, ar, gs, &sig.sname_path);
    let mut args: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    args.push(base_ref_of(ar, base, pos));
    out.push(glue_call(ar, g, args, pos));
    return true;
}

fn try_hm_glue(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
               gs: *GlueState, base: *const Texpr, sig: *const StructSig, pos: Pos, out: *Vec<Tstmt>) -> bool {
    if !is_hashmap2(&sig.sname_path) { return false; }
    return match own_field_pointee(sig, "slots") {
        Option::Some(slot) => hm_glue_emit(a, ar, structs, enums, gs, base, sig, slot, pos, out)
        | Option::None => false
    };
}

fn hm_glue_emit(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                gs: *GlueState, base: *const Texpr, sig: *const StructSig, slot: *const Typ,
                pos: Pos, out: *Vec<Tstmt>) -> bool {
    if !slot_kv_droppable(structs, enums, slot) { return false; }
    let g = request_hm_glue(a, ar, gs, &sig.sname_path);
    let mut args: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
    args.push(base_ref_of(ar, base, pos));
    out.push(glue_call(ar, g, args, pos));
    return true;
}

fn is_vec_instance2(path: *const Vec<str>) -> bool {
    if path.length() == 0 as u32 { return false; }
    let sl = path.as_slice();
    let nm = sl[path.length() - 1 as u32];
    return str::eq(nm, "Vec") || str_starts_with(nm, "Vec_");
}
fn is_hashmap2(path: *const Vec<str>) -> bool {
    if path.length() == 0 as u32 { return false; }
    let sl = path.as_slice();
    let nm = sl[path.length() - 1 as u32];
    return str::eq(nm, "HashMap") || str_starts_with(nm, "HashMap_");
}

// Emit `free_via` for a shallow own-ptr, OR a `__drop_ptr_N` glue call when
// the pointee is itself droppable (recursive tree — drop.ml:389).
fn maybe_free_own(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                  gs: *GlueState, alloc_e: *const Texpr, ptr_e: *const Texpr, pointee: *const Typ,
                  bytes: *const Texpr, pos: Pos, out: *Vec<Tstmt>) {
    if droppable_deep(structs, enums, pointee) {
        let g = request_ptr_glue(a, ar, gs, pointee);
        let mut args: Vec<*const Texpr> = Vec::with_capacity(a, 8 as u32);
        args.push(alloc_e);
        args.push(ptr_e);
        out.push(glue_call(ar, g, args, pos));
        return;
    }
    out.push(free_via(a, ar, alloc_e, ptr_e, bytes, pos));
    return;
}

fn drop_one_field(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                  gs: *GlueState, base: *const Texpr, sig: *const StructSig, alloc_f: *const Texpr,
                  fname: str, fty: *const Typ, pos: Pos, out: *Vec<Tstmt>) {
    match *fty {
        Typ::TOwnPtr(inner) => {
            let fa = field_access(ar, base, fname, fty, pos);
            maybe_free_own(a, ar, structs, enums, gs, alloc_f, fa, inner, bytes_expr(a, ar, sig, base, inner, pos), pos, out);
        }
        | Typ::TStruct(p2) => emit_struct_field(a, ar, structs, enums, gs, base, fname, fty, pos, out)
        | _other => {}
    }
    return;
}

fn emit_struct_field(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                     gs: *GlueState, base: *const Texpr, fname: str, fty: *const Typ, pos: Pos, out: *Vec<Tstmt>) {
    if !has_drop_deep(structs, fty) { return; }
    let sub = field_access(ar, base, fname, fty, pos);
    drop_stmts_for_struct(a, ar, structs, enums, gs, sub, struct_idx_of_ty(structs, fty), pos, out);
    return;
}

fn struct_idx_of_ty(structs: *const Vec<StructSig>, ty: *const Typ) -> int {
    return match *ty {
        Typ::TStruct(p) => find_struct_idx(structs, &p)
        | _other => 0 - 1
    };
}

fn drop_stmts_for_entry(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>,
                        enums: *const Vec<EnumSig>, gs: *GlueState, e: *const DEntry, out: *Vec<Tstmt>) {
    match e.den_kind {
        DKind::DStructDrop(sidx) => {
            let ty = d_ty(ar, Typ::TStruct(struct_path_at(a, structs, sidx)));
            let base = d_te(ar, TexprNode::TVar(e.den_name), ty, e.den_pos);
            drop_stmts_for_struct(a, ar, structs, enums, gs, base, sidx, e.den_pos, out);
        }
        | DKind::DBareOwn { bo_pointee, bo_prov } => {
            match bo_prov {
                Option::Some(an) => {
                    let alloc_e = d_te(ar, TexprNode::TVar(an), ty_allocator(a, ar), e.den_pos);
                    let pty = d_ty(ar, Typ::TOwnPtr(bo_pointee));
                    let ptr_e = d_te(ar, TexprNode::TVar(e.den_name), pty, e.den_pos);
                    maybe_free_own(a, ar, structs, enums, gs, alloc_e, ptr_e, bo_pointee,
                                   size_of_u32(ar, bo_pointee, e.den_pos), e.den_pos, out);
                }
                // L1: nothing to release it with, and silence here IS the leak.
                // This needed the defer threading above: `let q = ...; defer
                // free(a, q);` reaches scope exit Live without it, and the rule
                // fires on valid code - measured, on examples/heap.exl.
                | Option::None => {
                    let d = dp_disp(gs, e.den_name);
                    let mut sb = StringBuilder::with_capacity(a, 176 as u32);
                    sb.push_str("own value '"); sb.push_str(d);
                    sb.push_str("' is never consumed — free it, move it, or return it (its allocator is not known here, so it cannot be auto-dropped)");
                    raise_dp(ar, gs, e.den_pos, str::from_slice(ar, sb.as_slice()));
                }
            }
        }
        | DKind::DArrayDrop { da_sidx, da_size } => {}   // deferred (rare)
    }
    return;
}

fn struct_path_at(a: Allocator, structs: *const Vec<StructSig>, sidx: int) -> Vec<str> {
    if sidx < 0 as int { return Vec::with_capacity(a, 8 as u32); }
    let sl = structs.as_slice();
    let src = sl[sidx as u32].sname_path.as_slice();
    let mut v: Vec<str> = Vec::with_capacity(a, sl[sidx as u32].sname_path.length() + 1 as u32);
    let mut i = 0 as u32;
    while i < sl[sidx as u32].sname_path.length() { v.push(src[i]); i = i + 1 as u32; }
    return v;
}

fn partial_at_exit(a: Allocator, ar: *Arena, gs: *GlueState, e: *const DEntry) {
    let d = dp_disp(gs, e.den_name);
    let mut sb = StringBuilder::with_capacity(a, 176 as u32);
    sb.push_str("'"); sb.push_str(d);
    sb.push_str("' had its payload moved out and still owns its storage at scope exit — release it explicitly with `free(alloc, ");
    sb.push_str(d); sb.push_str(")`");
    raise_dp(ar, gs, e.den_pos, str::from_slice(ar, sb.as_slice()));
    return;
}
// Drops for every Live entry, newest-first (LIFO — st keeps newest at head).
fn drops_for_live(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>,
                  enums: *const Vec<EnumSig>, gs: *GlueState, st: *const Vec<DEntry>, out: *Vec<Tstmt>) {
    // LIFO — newest binding first.  The oracle keeps newest at the list head
    // (`e :: st`); the port pushes newest at the tail, so iterate in reverse.
    let sl = st.as_slice();
    let mut i = st.length();
    while i > 0 as u32 {
        i = i - 1 as u32;
        match sl[i].den_status {
            DStatus::DLive => drop_stmts_for_entry(a, ar, structs, enums, gs, &sl[i], out)
            // The eighth rule, and the only route to this state is narrow: a
            // `match` over a DEREF-rooted owned tree (`match *t`) moves the
            // children out and leaves the root storage releasable. Nothing else
            // in the reference produces PartialMoved, which is why the shape had
            // to come from reading that producer rather than from guessing.
            | DStatus::DPartial => partial_at_exit(a, ar, gs, &sl[i])
            | DStatus::DConsumed => {}
        }
    }
    return;
}

// ---------- entry-list state ----------

fn copy_dentries(a: Allocator, st: *const Vec<DEntry>) -> Vec<DEntry> {
    let mut out: Vec<DEntry> = Vec::with_capacity(a, st.length() + 1 as u32);
    let sl = st.as_slice();
    let mut i = 0 as u32;
    while i < st.length() { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}

fn names_of(a: Allocator, st: *const Vec<DEntry>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, st.length() + 1 as u32);
    let sl = st.as_slice();
    let mut i = 0 as u32;
    while i < st.length() { out.push(sl[i].den_name); i = i + 1 as u32; }
    return out;
}

fn name_in(names: *const Vec<str>, n: str) -> bool {
    let sl = names.as_slice();
    let mut i = 0 as u32;
    while i < names.length() { if str::eq(sl[i], n) { return true; } i = i + 1 as u32; }
    return false;
}

fn mark_consumed(a: Allocator, st: *const Vec<DEntry>, names: *const Vec<str>) -> Vec<DEntry> {
    let mut out: Vec<DEntry> = Vec::with_capacity(a, st.length() + 1 as u32);
    let sl = st.as_slice();
    let mut i = 0 as u32;
    while i < st.length() {
        let hit = name_in(names, sl[i].den_name);
        let live_or_partial = match sl[i].den_status {
            DStatus::DLive => true | DStatus::DPartial => true | DStatus::DConsumed => false
        };
        if hit && live_or_partial {
            out.push(DEntry { den_name: sl[i].den_name, den_status: DStatus::DConsumed,
                              den_kind: sl[i].den_kind, den_pos: sl[i].den_pos });
        } else { out.push(sl[i]); }
        i = i + 1 as u32;
    }
    return out;
}

fn mark_partial(a: Allocator, st: *const Vec<DEntry>, names: *const Vec<str>) -> Vec<DEntry> {
    let mut out: Vec<DEntry> = Vec::with_capacity(a, st.length() + 1 as u32);
    let sl = st.as_slice();
    let mut i = 0 as u32;
    while i < st.length() {
        let hit = name_in(names, sl[i].den_name);
        let is_live = match sl[i].den_status {
            DStatus::DLive => true | _other => false
        };
        if hit && is_live {
            out.push(DEntry { den_name: sl[i].den_name, den_status: DStatus::DPartial,
                              den_kind: sl[i].den_kind, den_pos: sl[i].den_pos });
        } else { out.push(sl[i]); }
        i = i + 1 as u32;
    }
    return out;
}

// Apply an expression's consume set (move::states_by seam) to the state.
fn apply_expr(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena,
              st: *const Vec<DEntry>, te: *const Texpr) -> Vec<DEntry> {
    let names = names_of(a, st);
    let res = states_by(structs, enums, a, ar, &names, te);
    let st2 = mark_consumed(a, st, &res.cr_consumed);
    return mark_partial(a, &st2, &res.cr_partial);
}

// OWN-D2 consume parity: a transfer's bare affine TVar RHS is consumed by
// Move.walk_stmt but not by walk_expr alone (drop.ml consume_rhs_var).
fn consume_rhs_var(structs: *const Vec<StructSig>, a: Allocator,
                   st: *const Vec<DEntry>, value: *const Texpr) -> Vec<DEntry> {
    return match value.e {
        TexprNode::TVar(n) => {
            if is_affine_typ(structs, value.ty) { consume_one(a, st, n) }
            else { copy_dentries(a, st) }
        }
        | _other => copy_dentries(a, st)
    };
}

fn consume_one(a: Allocator, st: *const Vec<DEntry>, n: str) -> Vec<DEntry> {
    let mut names: Vec<str> = Vec::with_capacity(a, 8 as u32);
    names.push(n);
    return mark_consumed(a, st, &names);
}

// ---------- statement rewriter ----------

fn ends_in_return(out: *const Vec<Tstmt>) -> bool {
    if out.length() == 0 as u32 { return false; }
    let sl = out.as_slice();
    return match sl[out.length() - 1 as u32] {
        Tstmt::TReturn { value, pos } => true
        | _other => false
    };
}

// Walk a block: thread [st], emit rewritten statements into [out], drop this
// block's surviving Live locals at close, return the survivors (entries that
// existed on entry).
// The consumes a statement list performs, applied to the tracked state. Written
// EXHAUSTIVELY: a missed arm here does not lose a diagnostic, it INVENTS one -
// an owner whose `free` this walk failed to see is reported as never consumed,
// and that is a rejection of valid code.
fn apply_stmts_consumes(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena,
                        st: *const Vec<DEntry>, stmts: *const Vec<Tstmt>) -> Vec<DEntry> {
    let mut cur = copy_dentries(a, st);
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() {
        cur = apply_stmt_consumes(structs, enums, a, ar, cur, &sl[i]);
        i = i + 1 as u32;
    }
    return cur;
}
fn apply_stmt_consumes(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena,
                       st: Vec<DEntry>, s: *const Tstmt) -> Vec<DEntry> {
    return match *s {
        Tstmt::TLet { name, value, decl_ty, pos } => apply_expr(structs, enums, a, ar, &st, value)
        | Tstmt::TLetTuple { names, value, pos } => apply_expr(structs, enums, a, ar, &st, value)
        | Tstmt::TAssign { path, value, pos } => apply_expr(structs, enums, a, ar, &st, value)
        | Tstmt::TAssignField { target, field, value, pos } => apply_two(structs, enums, a, ar, st, target, value)
        | Tstmt::TAssignDeref { target, value, pos } => apply_two(structs, enums, a, ar, st, target, value)
        | Tstmt::TAssignIndex { base, index, value, pos } => apply_three(structs, enums, a, ar, st, base, index, value)
        | Tstmt::TReturn { value, pos } => apply_opt(structs, enums, a, ar, st, value)
        | Tstmt::TExprStmt(e) => apply_expr(structs, enums, a, ar, &st, e)
        | Tstmt::TIf { cond, then_body, else_body } => {
            let s1 = apply_expr(structs, enums, a, ar, &st, cond);
            let s2 = apply_stmts_consumes(structs, enums, a, ar, &s1, &then_body);
            apply_stmts_consumes(structs, enums, a, ar, &s2, &else_body)
        }
        | Tstmt::TWhile { cond, body, post } => {
            let s1 = apply_expr(structs, enums, a, ar, &st, cond);
            let s2 = apply_stmts_consumes(structs, enums, a, ar, &s1, &body);
            apply_stmts_consumes(structs, enums, a, ar, &s2, &post)
        }
        | Tstmt::TDefer { body, pos } => apply_stmts_consumes(structs, enums, a, ar, &st, &body)
        | Tstmt::TSeal { body, pos } => apply_stmts_consumes(structs, enums, a, ar, &st, &body)
        | Tstmt::TFor { counter, end_var, range_temp, lo, hi, inclusive, body, pos } =>
            apply_stmts_consumes(structs, enums, a, ar, &st, &body)
        | Tstmt::TForEach { it_var, it_init, body, pos } =>
            apply_stmts_consumes(structs, enums, a, ar, &st, &body)
        | Tstmt::TBreak(q) => copy_dentries(a, &st)
        | Tstmt::TContinue(q) => copy_dentries(a, &st)
    };
}
fn apply_two(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena,
             st: Vec<DEntry>, x: *const Texpr, y: *const Texpr) -> Vec<DEntry> {
    let s1 = apply_expr(structs, enums, a, ar, &st, x);
    return apply_expr(structs, enums, a, ar, &s1, y);
}
fn apply_three(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena,
               st: Vec<DEntry>, x: *const Texpr, y: *const Texpr, z: *const Texpr) -> Vec<DEntry> {
    let s1 = apply_two(structs, enums, a, ar, st, x, y);
    return apply_expr(structs, enums, a, ar, &s1, z);
}
fn apply_opt(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena,
             st: Vec<DEntry>, v: Option<*const Texpr>) -> Vec<DEntry> {
    return match v {
        Option::Some(e) => apply_expr(structs, enums, a, ar, &st, e)
        | Option::None => copy_dentries(a, &st)
    };
}
// A block's own `defer` bodies run at its exit, so their consumes land BEFORE
// the surviving locals are dropped - which is what makes `let q = ...; defer
// free(a, q);` a consumed owner rather than a leaked one.
fn apply_block_defers(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena,
                      st: *const Vec<DEntry>, stmts: *const Vec<Tstmt>) -> Vec<DEntry> {
    let mut cur = copy_dentries(a, st);
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() {
        match sl[i] {
            Tstmt::TDefer { body, pos } => { cur = apply_stmts_consumes(structs, enums, a, ar, &cur, &body); }
            | _o => { }
        }
        i = i + 1 as u32;
    }
    return cur;
}
// A `defer` body that READS a tracked owner which it does not also consume runs
// against storage the auto-drop already released - the drop is emitted at scope
// exit, the deferred code runs after it. A defer that CONSUMES the binding
// (`free(a, p)`, `s.free()`) elides that drop and stays legal.
fn check_defer_reads(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena,
                     gs: *GlueState, st: *const Vec<DEntry>, body: *const Vec<Tstmt>, pos: Pos) {
    let after = apply_stmts_consumes(structs, enums, a, ar, st, body);
    let mut reads: Vec<str> = Vec::with_capacity(a, 8 as u32);
    collect_tstmts_vars_own(body, &reads);
    let sl = st.as_slice();
    let asl = after.as_slice();
    let mut i = 0 as u32;
    while i < st.length() {
        let n = sl[i].den_name;
        let was_live = match sl[i].den_status { DStatus::DConsumed => false | _o => true };
        let now_consumed = match asl[i].den_status { DStatus::DConsumed => true | _o => false };
        if was_live && !now_consumed && name_in(&reads, n) {
            let d = dp_disp(gs, n);
            let mut sb = StringBuilder::with_capacity(a, 200 as u32);
            sb.push_str("defer body reads '"); sb.push_str(d);
            sb.push_str("', but '"); sb.push_str(d);
            sb.push_str("' is auto-dropped before deferred code runs — consume it inside the defer (free/drop) or restructure without defer");
            raise_dp(ar, gs, pos, str::from_slice(ar, sb.as_slice()));
            return;
        }
        i = i + 1 as u32;
    }
    return;
}
fn walk_stmts(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena, gs: *GlueState,
              st_in: *const Vec<DEntry>, stmts: *const Vec<Tstmt>, out: *Vec<Tstmt>) -> Vec<DEntry> {
    let baseline = names_of(a, st_in);
    let mut st = copy_dentries(a, st_in);
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() {
        // `st = step(st, ...)` moves st into the call (consumed), so the
        // reassign is an L3 rebind — no drop-old-before-borrowed-read UAF,
        // and no loop-local-consume false positive (st is not loop-local).
        st = step(structs, enums, a, ar, gs, st, &sl[i], out);
        i = i + 1 as u32;
    }
    let ret = ends_in_return(out);
    // Block close: the defer consumes land first, then this block's surviving
    // locals drop.
    st = apply_block_defers(structs, enums, a, ar, &st, stmts);
    // partition: locals (not in baseline) vs survivors (in baseline)
    let mut survivors: Vec<DEntry> = Vec::with_capacity(a, st.length() + 1 as u32);
    let mut locals: Vec<DEntry> = Vec::with_capacity(a, st.length() + 1 as u32);
    let es = st.as_slice();
    let mut j = 0 as u32;
    while j < st.length() {
        if name_in(&baseline, es[j].den_name) { survivors.push(es[j]); }
        else { locals.push(es[j]); }
        j = j + 1 as u32;
    }
    if !ret { drops_for_live(a, ar, structs, enums, gs, &locals, out); }
    return survivors;
}

// By-value wrapper so the walk_stmts loop can rebind `st` without a
// self-referential-borrow (see the loop comment).  Takes st owned, borrows
// it to walk_stmt, returns the successor state.
fn step(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena, gs: *GlueState,
        st: Vec<DEntry>, s: *const Tstmt, out: *Vec<Tstmt>) -> Vec<DEntry> {
    return walk_stmt(structs, enums, a, ar, gs, &st, s, out);
}

fn walk_stmt(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena, gs: *GlueState,
             st: *const Vec<DEntry>, s: *const Tstmt, out: *Vec<Tstmt>) -> Vec<DEntry> {
    return match *s {
        Tstmt::TLet { name, value, pos } => walk_let(structs, enums, a, ar, gs, st, name, value, pos, s, out)
        | Tstmt::TAssign { path, value, pos } => walk_assign(structs, enums, a, ar, gs, st, &path, value, pos, s, out)
        | Tstmt::TReturn { value, pos } => walk_return(structs, enums, a, ar, gs, st, value, pos, out)
        | Tstmt::TIf { cond, then_body, else_body } => walk_if(structs, enums, a, ar, gs, st, cond, &then_body, &else_body, out)
        | Tstmt::TWhile { cond, body, post } => walk_while(structs, enums, a, ar, gs, st, cond, &body, &post, s, out)
        | Tstmt::TExprStmt(e) => {
            // Freeze-audit B12: an expression statement whose value owns
            // discards that ownership on the floor - the never-consumed check
            // only ever sees BINDINGS, so nothing else would catch it.
            check_discarded_own(structs, a, ar, gs, e);
            let st2 = apply_expr(structs, enums, a, ar, st, e);
            out.push(*s);
            st2
        }
        | Tstmt::TDefer { body, pos } => {
            check_defer_reads(structs, enums, a, ar, gs, st, &body, pos);
            out.push(*s);
            copy_dentries(a, st)
        }
        | Tstmt::TAssignField { target, field, value, pos } => walk_apply_one(structs, enums, a, ar, st, value, s, out)
        | Tstmt::TAssignIndex { base, index, value, pos } => walk_apply_one(structs, enums, a, ar, st, value, s, out)
        | Tstmt::TAssignDeref { target, value, pos } => walk_apply_one(structs, enums, a, ar, st, value, s, out)
        | _other => { out.push(*s); copy_dentries(a, st) }
    };
}

fn walk_apply_one(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena,
                  st: *const Vec<DEntry>, value: *const Texpr, s: *const Tstmt, out: *Vec<Tstmt>) -> Vec<DEntry> {
    let st1 = apply_expr(structs, enums, a, ar, st, value);
    let st2 = consume_rhs_var(structs, a, &st1, value);
    out.push(*s);
    return st2;
}

fn walk_let(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena, gs: *GlueState,
            st: *const Vec<DEntry>, name: str, value: *const Texpr, pos: Pos, s: *const Tstmt,
            out: *Vec<Tstmt>) -> Vec<DEntry> {
    let st1 = apply_expr(structs, enums, a, ar, st, value);
    let st2 = consume_rhs_var(structs, a, &st1, value);
    // shadow-drop a still-Live tracked binding of the same name
    let es = st2.as_slice();
    let mut k = 0 as u32;
    while k < st2.length() {
        let same = str::eq(es[k].den_name, name);
        let live = match es[k].den_status { DStatus::DLive => true | _o => false };
        if same && live { drop_stmts_for_entry(a, ar, structs, enums, gs, &es[k], out); }
        k = k + 1 as u32;
    }
    out.push(*s);
    // drop old entry of this name, register the new one
    let mut st3: Vec<DEntry> = Vec::with_capacity(a, st2.length() + 1 as u32);
    let es2 = st2.as_slice();
    let mut m = 0 as u32;
    while m < st2.length() {
        if !str::eq(es2[m].den_name, name) { st3.push(es2[m]); }
        m = m + 1 as u32;
    }
    check_array_of_own(a, ar, gs, value.ty, pos);
    match entry_for(structs, name, value.ty, pos) {
        Option::Some(e) => {
            let e2 = match e.den_kind {
                DKind::DBareOwn { bo_pointee, bo_prov } =>
                    DEntry { den_name: e.den_name, den_status: e.den_status,
                             den_kind: DKind::DBareOwn { bo_pointee: bo_pointee, bo_prov: prov_of(value) },
                             den_pos: e.den_pos }
                | _o => e
            };
            st3.push(e2);
        }
        | Option::None => {}
    }
    return st3;
}

fn walk_assign(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena, gs: *GlueState,
               st: *const Vec<DEntry>, path: *const Vec<str>, value: *const Texpr, pos: Pos,
               s: *const Tstmt, out: *Vec<Tstmt>) -> Vec<DEntry> {
    // single-name assign to a tracked binding: L2 drop-old + L3 rebind
    if path.length() == 1 as u32 {
        let pl = path.as_slice();
        let n = pl[0];
        if entry_index(st, n) >= 0 as int {
            let st1 = apply_expr(structs, enums, a, ar, st, value);
            let st2 = consume_rhs_var(structs, a, &st1, value);
            let idx = entry_index(&st2, n);
            let es = st2.as_slice();
            let old_live = match es[idx as u32].den_status { DStatus::DLive => true | _o => false };
            if old_live { check_assign_leak(a, ar, gs, &es[idx as u32], pos); }
            let mut drop_buf: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
            if old_live { drop_stmts_for_entry(a, ar, structs, enums, gs, &es[idx as u32], &drop_buf); }
            // Sequencing (mirrors walk_return): the RHS may read the old
            // binding by borrow (`x = f(&x)`), so with drops present and a
            // non-bare-var RHS, evaluate it into a temp BEFORE the old value is
            // dropped — otherwise `drop(x); x = f(&x)` reads freed storage.
            if drop_buf.length() > 0 as u32 && assign_needs_temp(value) {
                let tmp = mk_drop_old_tmp(a, ar, pos);
                out.push(Tstmt::TLet { name: tmp, value: value, decl_ty: value.ty, pos: pos });
                push_all(&drop_buf, out);
                let tv = d_te(ar, TexprNode::TVar(tmp), value.ty, value.pos);
                let mut np: Vec<str> = Vec::with_capacity(a, 8 as u32);
                np.push(n);
                out.push(Tstmt::TAssign { path: np, value: tv, pos: pos });
            } else {
                push_all(&drop_buf, out);
                out.push(*s);
            }
            // rebind: n becomes Live with new provenance
            let mut st3: Vec<DEntry> = Vec::with_capacity(a, st2.length() + 1 as u32);
            let mut i = 0 as u32;
            while i < st2.length() {
                if str::eq(es[i].den_name, n) {
                    let nk = match es[i].den_kind {
                        DKind::DBareOwn { bo_pointee, bo_prov } =>
                            DKind::DBareOwn { bo_pointee: bo_pointee, bo_prov: prov_of(value) }
                        | k => k
                    };
                    st3.push(DEntry { den_name: n, den_status: DStatus::DLive, den_kind: nk, den_pos: es[i].den_pos });
                } else { st3.push(es[i]); }
                i = i + 1 as u32;
            }
            return st3;
        }
    }
    return walk_apply_one(structs, enums, a, ar, st, value, s, out);
}

fn entry_index(st: *const Vec<DEntry>, n: str) -> int {
    let sl = st.as_slice();
    let mut i = 0 as u32;
    while i < st.length() { if str::eq(sl[i].den_name, n) { return i as int; } i = i + 1 as u32; }
    return 0 - 1;
}

fn walk_return(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena, gs: *GlueState,
               st: *const Vec<DEntry>, value: Option<*const Texpr>, pos: Pos, out: *Vec<Tstmt>) -> Vec<DEntry> {
    // a returned bare TVar transfers ownership to the caller (consume it);
    // any other return value may consume bindings inside.
    let st1 = match value {
        Option::Some(v) => match v.e {
            TexprNode::TVar(n) => {
                let mut names: Vec<str> = Vec::with_capacity(a, 8 as u32);
                names.push(n);
                mark_consumed(a, st, &names)
            }
            | _o => apply_expr(structs, enums, a, ar, st, v)
        }
        | Option::None => copy_dentries(a, st)
    };
    // release every remaining Live owner before the return
    let mut drop_buf: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    drops_for_live(a, ar, structs, enums, gs, &st1, &drop_buf);
    // Sequencing: the return VALUE may read a to-be-dropped binding
    // (`return *buf.p`), so when there are drops and the value is not already
    // a bare var, evaluate it into a temp BEFORE the drops.
    if drop_buf.length() > 0 as u32 && ret_needs_temp(value) {
        emit_ret_temp(a, ar, value, pos, &drop_buf, out);
    } else {
        push_all(&drop_buf, out);
        out.push(Tstmt::TReturn { value: value, pos: pos });
    }
    return st1;
}

fn ret_needs_temp(value: Option<*const Texpr>) -> bool {
    return match value {
        Option::Some(v) => match v.e { TexprNode::TVar(_n) => false | _o => true }
        | Option::None => false
    };
}

// A bare-TVar RHS (`y = x`) needs no temp — it already consumed the old
// binding, so drop_old is empty anyway; anything else may read the old value.
fn assign_needs_temp(value: *const Texpr) -> bool {
    return match value.e { TexprNode::TVar(_n) => false | _o => true };
}

fn push_all(src: *const Vec<Tstmt>, out: *Vec<Tstmt>) {
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < src.length() { out.push(sl[i]); i = i + 1 as u32; }
    return;
}

fn mk_drop_tmp(a: Allocator, ar: *Arena, pos: Pos) -> str {
    let mut sb = StringBuilder::with_capacity(a, 24 as u32);
    sb.push_str("__drop_ret_");
    sb.push_int(pos.line);
    sb.push_str("_");
    sb.push_int(pos.col);
    return str::from_slice(ar, sb.as_slice());
}

fn mk_drop_old_tmp(a: Allocator, ar: *Arena, pos: Pos) -> str {
    let mut sb = StringBuilder::with_capacity(a, 24 as u32);
    sb.push_str("__drop_old_");
    sb.push_int(pos.line);
    sb.push_str("_");
    sb.push_int(pos.col);
    return str::from_slice(ar, sb.as_slice());
}

fn emit_ret_temp(a: Allocator, ar: *Arena, value: Option<*const Texpr>, pos: Pos,
                 drop_buf: *const Vec<Tstmt>, out: *Vec<Tstmt>) {
    match value {
        Option::Some(v) => {
            let tmp = mk_drop_tmp(a, ar, pos);
            out.push(Tstmt::TLet { name: tmp, value: v, decl_ty: v.ty, pos: pos });
            push_all(drop_buf, out);
            let tv = d_te(ar, TexprNode::TVar(tmp), v.ty, v.pos);
            out.push(Tstmt::TReturn { value: Option::Some(tv), pos: pos });
        }
        | Option::None => {}
    }
    return;
}

fn walk_if(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena, gs: *GlueState,
           st: *const Vec<DEntry>, cond: *const Texpr, then_body: *const Vec<Tstmt>,
           else_body: *const Vec<Tstmt>, out: *Vec<Tstmt>) -> Vec<DEntry> {
    let st0 = apply_expr(structs, enums, a, ar, st, cond);
    let mut then_out: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let st_then = walk_stmts(structs, enums, a, ar, gs, &st0, then_body, &then_out);
    let mut else_out: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let st_else = walk_stmts(structs, enums, a, ar, gs, &st0, else_body, &else_out);
    out.push(Tstmt::TIf { cond: cond, then_body: then_out, else_body: else_out });
    let td = stmts_diverge(then_body);
    let ed = stmts_diverge(else_body);
    // Return a FRESH copy in every branch so st0 / st_then / st_else are all
    // dropped uniformly at fn exit — returning a different owned local per
    // branch is a conditional-consume the static drop pass cannot track
    // (it would free the returned buffer).
    if td { if ed { copy_dentries(a, &st0) } else { copy_dentries(a, &st_else) } }
    else { if ed { copy_dentries(a, &st_then) } else { merge_branches(a, ar, gs, cond.pos, &st_then, &st_else) } }
}

// OWN-D3: tracked states after two non-diverging branches must agree — a static
// drop cannot follow a runtime-dependent owner state.  This used to assume
// "valid source never mismatches" and take `then`, which made the port compile
// programs the reference rejects: an `own` freed inside a null-guard and left
// owned outside it is the shape every allocator example starts from.
//
// The rule is the PROPERTY, not a list of constructs: every tracked entry's
// status must agree across the join, whatever produced the branches.
fn merge_branches(a: Allocator, ar: *Arena, gs: *GlueState, pos: Pos,
                  st_then: *const Vec<DEntry>, st_else: *const Vec<DEntry>) -> Vec<DEntry> {
    let tl = st_then.as_slice();
    let el = st_else.as_slice();
    let n = if st_then.length() < st_else.length() { st_then.length() } else { st_else.length() };
    let mut i = 0 as u32;
    while i < n {
        if !dstatus_eq(tl[i].den_status, el[i].den_status) {
            let d = dp_disp(gs, tl[i].den_name);
            let mut sb = StringBuilder::with_capacity(a, 200 as u32);
            sb.push_str("'"); sb.push_str(d);
            sb.push_str("' is moved out on one branch but stays owned on the other — auto-drop is static (no runtime drop flags); consume it on every path or on none");
            raise_dp(ar, gs, pos, str::from_slice(ar, sb.as_slice()));
            return copy_dentries(a, st_then);
        }
        i = i + 1 as u32;
    }
    return copy_dentries(a, st_then);
}
fn dstatus_eq(x: DStatus, y: DStatus) -> bool {
    return match x {
        DStatus::DLive => match y { DStatus::DLive => true | _o => false }
        | DStatus::DConsumed => match y { DStatus::DConsumed => true | _o => false }
        | DStatus::DPartial => match y { DStatus::DPartial => true | _o => false }
    };
}

fn walk_while(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena, gs: *GlueState,
              st: *const Vec<DEntry>, cond: *const Texpr, body: *const Vec<Tstmt>,
              post: *const Vec<Tstmt>, _s: *const Tstmt, out: *Vec<Tstmt>) -> Vec<DEntry> {
    // Move.check guarantees loop-invariant tracked states; one symbolic pass
    // gives the exit state.  Bodies are walked into fresh buffers.
    let st0 = apply_expr(structs, enums, a, ar, st, cond);
    let mut body_out: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let st_body = walk_stmts(structs, enums, a, ar, gs, &st0, body, &body_out);
    let mut post_out: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let st_post = walk_stmts(structs, enums, a, ar, gs, &st_body, post, &post_out);
    out.push(Tstmt::TWhile { cond: cond, body: body_out, post: post_out });
    return st_post;
}

// ---------- per-fn / whole-program ----------

// The drop pass inserts `__drop_ret_<pos>` / `__drop_old_<pos>` temps as TLets
// in the rewritten body, but tf_lets was fixed in typecheck (before drop), so
// codegen — which lowers a TLet to an assignment and declares the name from
// tf_lets — would emit an undeclared temp.  Mirror the oracle's tmp_decls:
// append each drop temp's (name, decl_ty) to tf_lets, in body (= creation)
// order, after the existing lets.
fn is_drop_temp(name: str) -> bool {
    if str::length(name) < 7 as u32 { return false; }
    let b = str::as_bytes(name);
    // "__drop_"
    return b[0 as u32] == 95 as u8 && b[1 as u32] == 95 as u8 && b[2 as u32] == 100 as u8
        && b[3 as u32] == 114 as u8 && b[4 as u32] == 111 as u8 && b[5 as u32] == 112 as u8
        && b[6 as u32] == 95 as u8;
}
fn drop_lets_has(lets: *const Vec<FieldTy>, name: str) -> bool {
    let sl = lets.as_slice();
    let mut i = 0 as u32;
    while i < lets.length() { if str::eq(sl[i].name, name) { return true; } i = i + 1 as u32; }
    return false;
}
fn maybe_push_drop_temp(lets: *Vec<FieldTy>, name: str, decl_ty: *const Typ) {
    if is_drop_temp(name) && !drop_lets_has(lets, name) { lets.push(FieldTy { name: name, ty: decl_ty }); }
    return;
}
fn collect_drop_temps(stmts: *const Vec<Tstmt>, lets: *Vec<FieldTy>) {
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() {
        match sl[i] {
            Tstmt::TLet { name, value, decl_ty, pos } => maybe_push_drop_temp(lets, name, decl_ty)
            | Tstmt::TIf { cond, then_body, else_body } => { collect_drop_temps(&then_body, lets); collect_drop_temps(&else_body, lets); }
            | Tstmt::TWhile { cond, body, post } => { collect_drop_temps(&body, lets); collect_drop_temps(&post, lets); }
            | Tstmt::TDefer { body, pos } => collect_drop_temps(&body, lets)
            | Tstmt::TSeal { body, pos } => collect_drop_temps(&body, lets)
            | _o => {}
        }
        i = i + 1 as u32;
    }
    return;
}
fn rewrite_fn(structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>, a: Allocator, ar: *Arena,
              gs: *GlueState, f: *Tfunc) {
    // Skip prelude fns — they predate auto-drop and free by hand.
    if str::eq(f.tf_func.pos.file, "<prelude>") { return; }
    // Seed affine by-value params Live (S3 / L1).
    let mut st: Vec<DEntry> = Vec::with_capacity(a, 8 as u32);
    let ps = f.tf_func.params.as_slice();
    let pts = f.tf_param_tys.as_slice();
    let mut i = 0 as u32;
    while i < f.tf_func.params.length() && i < f.tf_param_tys.length() {
        check_array_of_own(a, ar, gs, pts[i], f.tf_func.pos);
        match entry_for(structs, ps[i].pname, pts[i], f.tf_func.pos) {
            Option::Some(e) => st.push(e)
            | Option::None => {}
        }
        i = i + 1 as u32;
    }
    let mut body_out: Vec<Tstmt> = Vec::with_capacity(a, f.tf_body.length() + 4 as u32);
    let survivors = walk_stmts(structs, enums, a, ar, gs, &st, &f.tf_body, &body_out);
    // params (the baseline) survive — release them unless the body returned.
    if !ends_in_return(&body_out) {
        drops_for_live(a, ar, structs, enums, gs, &survivors, &body_out);
    }
    collect_drop_temps(&body_out, &f.tf_lets);
    f.tf_body = body_out;
    return;
}

pub fn drop_insert(a: Allocator, ar: *Arena, tp: *Tprogram) -> Option<*const CompileError> {
    // One glue table for the whole program — the request counter is global,
    // so glue-fn names (`__drop_ptr_0`, ...) match the oracle's request order.
    let gk: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let gn: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let gm: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let gkd: Vec<u32> = Vec::with_capacity(a, 8 as u32);
    let mut err: Option<*const CompileError> = Option::None;
    let mut srcnames: Vec<StrPair> = Vec::with_capacity(a, 8 as u32);
    let mut glue = GlueState { gs_err: &err, gs_srcnames: &srcnames,
                               gs_keys: gk, gs_names: gn, gs_meta: gm, gs_kind: gkd };
    let n = tp.tp_funcs.length();
    let mut i = 0 as u32;
    while i < n {
        with f in tp.tp_funcs[i] {
            // Display names are per-FUNCTION; point the latch at this one's
            // before walking it, so a diagnostic quotes what the user wrote
            // rather than the minted `v__1`.
            glue.gs_srcnames = &f.tf_srcnames;
            rewrite_fn(&tp.tp_struct_index, &tp.tp_enum_index, a, ar, &glue, f);
        }
        i = i + 1 as u32;
    }
    // Synthesize the deep-drop glue bodies whose calls were emitted above and
    // append them to tp_funcs (mirrors the oracle's `funcs @ List.rev glue_fns`).
    // drain_glue pushes each freshly-built Tfunc straight in — never copying one
    // out of a slice (the affine-Vec-fields footgun).
    drain_glue(a, ar, &tp.tp_struct_index, &tp.tp_enum_index, &glue, &tp.tp_funcs);
    return err;
}
