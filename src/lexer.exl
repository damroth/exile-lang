// Self-host port — `lib/lexer.ml`.
//
// The first real processing stage: source `str` -> `Vec<TokenPos>`.  A
// byte-at-a-time scanner over `str::as_bytes(src)`, tracking line/col so
// each token carries its start `Pos`.  Identifiers and string literals
// are slices of the source; `str::from_slice(arena, …)` materialises
// them as NUL-terminated `str`s owned by the arena (so a name lives as
// long as the AST it ends up in).
//
// The mutable scan state lives in a `Lexer` struct mutated through
// `*self`; `Slice<u8>` indexing gives O(1) byte access (computed once,
// no per-byte `cstr_len`).  Byte comparisons use char literals — exile
// char literals ARE their byte value (`'(' == 40`).
//
// Errors are threaded as values: OCaml `Error.failf` raises from any
// depth; exile has no exceptions, so every fallible scan returns
// `Result<bool, *const CompileError>` (the `bool` is a no-value
// sentinel — there is no unit type) and `tokenize` returns
// `Result<Vec<TokenPos>, *const CompileError>`, propagated with `try`.
// The recursive-descent parser inherits this same shape.
//
// Deferred (verified on inputs that avoid them, like the `%h` float
// dump): the float-literal VALUE (the `.`/exponent/suffix syntax is
// consumed so a float never mis-tokenises, but the value is a 0.0
// placeholder — a `str -> f64` parser is a later prelude pass), and
// string-escape DECODING (the scan is escape-aware and VALIDATES escapes
// — unknown / embedded-NUL still error — but the interned bytes are raw;
// a decode pass lands with the float parser).  Two OCaml error sites are
// also deferred: invalid-float-VALUE (no parse yet) and the 63-bit
// integer-OVERFLOW check (OCaml-int-specific message; exile int wraps).

use pos::*;
use token::*;
use error::*;

// ===== Character classes (over byte values) =====

fn is_digit(b: u8) -> bool {
    return b >= '0' as u8 && b <= '9' as u8;
}

fn is_alpha(b: u8) -> bool {
    return (b >= 'a' as u8 && b <= 'z' as u8)
        || (b >= 'A' as u8 && b <= 'Z' as u8)
        || b == '_' as u8;
}

fn is_alnum(b: u8) -> bool {
    return is_alpha(b) || is_digit(b);
}

fn is_hex_digit(b: u8) -> bool {
    return is_digit(b)
        || (b >= 'a' as u8 && b <= 'f' as u8)
        || (b >= 'A' as u8 && b <= 'F' as u8);
}

// ===== Keyword table =====
//
// OCaml's `keyword_or_ident` match becomes a `str::eq` chain — a word
// that matches a keyword is that token, otherwise it is an identifier
// (interned by the caller before reaching here).

fn keyword_or_ident(word: str) -> Token {
    if str::eq(word, "fn") { return Token::Fn; }
    if str::eq(word, "let") { return Token::Let; }
    if str::eq(word, "mut") { return Token::Mut; }
    if str::eq(word, "return") { return Token::Return; }
    if str::eq(word, "if") { return Token::If; }
    if str::eq(word, "else") { return Token::Else; }
    if str::eq(word, "while") { return Token::While; }
    if str::eq(word, "loop") { return Token::Loop; }
    if str::eq(word, "break") { return Token::Break; }
    if str::eq(word, "continue") { return Token::Continue; }
    if str::eq(word, "for") { return Token::For; }
    if str::eq(word, "in") { return Token::In; }
    if str::eq(word, "mod") { return Token::Mod; }
    if str::eq(word, "pub") { return Token::Pub; }
    if str::eq(word, "use") { return Token::Use; }
    if str::eq(word, "as") { return Token::As; }
    if str::eq(word, "defer") { return Token::Defer; }
    if str::eq(word, "struct") { return Token::Struct; }
    if str::eq(word, "impl") { return Token::Impl; }
    if str::eq(word, "trait") { return Token::Trait; }
    if str::eq(word, "view") { return Token::View; }
    if str::eq(word, "with") { return Token::With; }
    if str::eq(word, "enum") { return Token::Enum; }
    if str::eq(word, "match") { return Token::Match; }
    if str::eq(word, "orelse") { return Token::Orelse; }
    if str::eq(word, "try") { return Token::Try; }
    if str::eq(word, "extern") { return Token::Extern; }
    if str::eq(word, "type") { return Token::Type; }
    if str::eq(word, "const") { return Token::Const; }
    if str::eq(word, "var") { return Token::Var; }
    if str::eq(word, "size_of") { return Token::SizeOf; }
    if str::eq(word, "new") { return Token::New; }
    if str::eq(word, "own") { return Token::Own; }
    if str::eq(word, "rune") { return Token::Rune; }
    if str::eq(word, "ward") { return Token::Ward; }
    if str::eq(word, "sigil") { return Token::Sigil; }
    if str::eq(word, "seal") { return Token::Seal; }
    if str::eq(word, "null") { return Token::Null; }
    if str::eq(word, "true") { return Token::True; }
    if str::eq(word, "false") { return Token::False; }
    return Token::Ident(word);
}

// ===== Integer parsing =====

fn parse_dec(bytes: Slice<u8>, start: u32, stop: u32) -> int {
    let mut n = 0;
    let mut j = start;
    while j < stop {
        n = n * 10 + (bytes[j] as int - 48);
        j = j + 1 as u32;
    }
    return n;
}

fn hex_val(b: u8) -> int {
    if b >= '0' as u8 && b <= '9' as u8 { return b as int - 48; }
    if b >= 'a' as u8 && b <= 'f' as u8 { return b as int - 97 + 10; }
    return b as int - 65 + 10;
}

fn parse_hex(bytes: Slice<u8>, start: u32, stop: u32) -> int {
    let mut n = 0;
    let mut j = start;
    while j < stop {
        n = n * 16 + hex_val(bytes[j]);
        j = j + 1 as u32;
    }
    return n;
}

// Scale `mant` by `10^dexp`.  For the literals exile accepts (mantissa
// `< 2^53`, `|dexp| <= 22`), `10^|dexp|` is itself exact in f64 and the single
// final multiply / divide is correctly rounded — Clinger's fast path, so the
// result matches a correctly-rounded `strtod` bit-for-bit.
fn scale_pow10(mant: f64, dexp: int) -> f64 {
    if dexp == 0 { return mant; }
    let neg = dexp < 0;
    let m = if neg { 0 - dexp } else { dexp };
    let mut p: f64 = 1.0;
    let mut k = 0;
    while k < m { p = p * 10.0; k = k + 1; }
    if neg { return mant / p; }
    return mant * p;
}

// Decode a decimal float literal `[start, stop)` (`3.14159`, `6.022e23`) into
// f64.  Mantissa digits accumulate as an exact integer (one f64 value); the
// fraction length and explicit exponent give the decimal scale.
fn parse_float(bytes: Slice<u8>, start: u32, stop: u32) -> f64 {
    let mut mant: f64 = 0.0;
    let mut fexp: int = 0;
    let mut seen_dot: bool = false;
    let mut eexp: int = 0;
    let mut esign: int = 1;
    let mut i = start;
    while i < stop {
        let b = bytes[i];
        if b == '.' as u8 {
            seen_dot = true;
            i = i + 1 as u32;
        } else {
            if b == 'e' as u8 || b == 'E' as u8 {
                i = i + 1 as u32;
                if i < stop {
                    if bytes[i] == '+' as u8 { i = i + 1 as u32; }
                    else { if bytes[i] == '-' as u8 { esign = 0 - 1; i = i + 1 as u32; } }
                }
                while i < stop {
                    eexp = eexp * 10 + ((bytes[i] as int) - 48);
                    i = i + 1 as u32;
                }
            } else {
                mant = mant * 10.0 + (((b as int) - 48) as f64);
                if seen_dot { fexp = fexp + 1; }
                i = i + 1 as u32;
            }
        }
    }
    let dexp = (esign * eexp) - fexp;
    return scale_pow10(mant, dexp);
}

// `'\n'`-style escape in a char literal -> its byte value.
fn char_escape(b: u8) -> int {
    if b == 'n' as u8 { return 10; }
    if b == 't' as u8 { return 9; }
    if b == 'r' as u8 { return 13; }
    if b == 'b' as u8 { return 8; }
    if b == '0' as u8 { return 0; }
    if b == 92 as u8 { return 92; }      // backslash
    if b == 39 as u8 { return 39; }      // single quote
    if b == 34 as u8 { return 34; }      // double quote
    return b as int;
}

// ===== The scanner =====

struct Lexer {
    bytes: Slice<u8>,
    len: u32,
    i: u32,
    line: int,
    col: int,
    file: str,
    a: Allocator,
    ar: *Arena,
}

impl Lexer {
    pub fn here(self: *const Lexer) -> Pos {
        return Pos { line: self.line, col: self.col, file: self.file };
    }

    // Byte at absolute index `j`, or 0 past the end (a harmless sentinel
    // — lookahead never acts on it without a `< len` check elsewhere).
    pub fn at(self: *const Lexer, j: u32) -> u8 {
        if j < self.len { return self.bytes[j]; }
        return 0 as u8;
    }

    pub fn cur(self: *const Lexer) -> u8 { return self.at(self.i); }
    pub fn peek1(self: *const Lexer) -> u8 { return self.at(self.i + 1 as u32); }
    pub fn peek2(self: *const Lexer) -> u8 { return self.at(self.i + 2 as u32); }

    // Consume the current byte, advancing line/col (newline resets col).
    pub fn advance(self: *Lexer) {
        if self.bytes[self.i] == 10 as u8 {
            self.line = self.line + 1;
            self.col = 1;
        } else {
            self.col = self.col + 1;
        }
        self.i = self.i + 1 as u32;
    }
}

fn emit(toks: *Vec<TokenPos>, tok: Token, p: Pos) {
    toks.push(TokenPos { tok: tok, pos: p });
}

// ===== Lexical errors =====
//
// Static messages pass a `str` literal straight to `error::alloc`;
// dynamic ones build the text in a StringBuilder (embedding the
// offending byte / word like OCaml's `%c` / `%C` / `%s`) and intern it
// into the arena.  Both mirror `lib/lexer.ml`'s `Error.failf` text
// byte-for-byte.
fn mk_dyn(lx: *const Lexer, p: Pos, sb: *const StringBuilder) -> *const CompileError {
    return alloc(lx.ar, p, str::from_slice(lx.ar, sb.as_slice()));
}

// Char-literal escapes accept `\0` (the byte 0); string escapes do NOT
// (an embedded NUL truncates a NUL-terminated str — its own error).
fn is_char_escape(b: u8) -> bool {
    return b == 'n' as u8 || b == 't' as u8 || b == 'r' as u8 || b == 'b' as u8
        || b == '0' as u8 || b == 92 as u8 || b == 39 as u8 || b == 34 as u8;
}

fn is_string_escape(b: u8) -> bool {
    return b == 'n' as u8 || b == 't' as u8 || b == 'r' as u8 || b == 'b' as u8
        || b == 92 as u8 || b == 34 as u8;
}

// Reserved words (capability model + future integer widths) —
// valid identifiers lexically, rejected so no source claims them before
// they become real syntax.
fn is_reserved_capability(w: str) -> bool {
    return str::eq(w, "shared");
}

fn is_reserved_intwidth(w: str) -> bool {
    return str::eq(w, "i64") || str::eq(w, "u64") || str::eq(w, "i128")
        || str::eq(w, "u128") || str::eq(w, "usize") || str::eq(w, "isize");
}

// Scan an identifier / keyword starting at the current alpha byte.
fn lex_word(lx: *Lexer, toks: *Vec<TokenPos>, start_i: u32, p: Pos)
        -> Result<bool, *const CompileError> {
    lx.advance();
    while lx.i < lx.len && is_alnum(lx.cur()) { lx.advance(); }
    let word = str::from_slice(lx.ar, lx.bytes[start_i..lx.i]);
    if is_reserved_capability(word) || is_reserved_intwidth(word) {
        let mut sb = StringBuilder::with_capacity(lx.a, 96 as u32);
        sb.push_str("'");
        sb.push_str(word);
        if is_reserved_capability(word) {
            sb.push_str("' is a reserved word (capability model, future syntax) — pick a different name");
        } else {
            sb.push_str("' is a reserved word (future integer width) — pick a different name");
        }
        return Result::Err(mk_dyn(lx, p, &sb));
    }
    emit(toks, keyword_or_ident(word), p);
    return Result::Ok(true);
}

// A trailing `f32` / `f64` width suffix on a float literal -> the is32
// flag (`f32` -> true, `f64` or no suffix -> false).  Mirrors OCaml's
// suffix scan; the literal's value is deferred but the width tag is exact.
fn lex_float_suffix(lx: *Lexer) -> bool {
    if lx.cur() == 'f' as u8 && lx.peek1() == '3' as u8 && lx.peek2() == '2' as u8 {
        lx.advance(); lx.advance(); lx.advance();
        return true;
    }
    if lx.cur() == 'f' as u8 && lx.peek1() == '6' as u8 && lx.peek2() == '4' as u8 {
        lx.advance(); lx.advance(); lx.advance();
        return false;
    }
    return false;
}

// Scan a number: hex (`0x…`), float (`…​.…`, value deferred), or decimal.
fn lex_number(lx: *Lexer, toks: *Vec<TokenPos>, start_i: u32, p: Pos)
        -> Result<bool, *const CompileError> {
    if lx.cur() == '0' as u8
       && (lx.peek1() == 'x' as u8 || lx.peek1() == 'X' as u8) {
        let xch = lx.peek1();
        lx.advance();
        lx.advance();
        let hstart = lx.i;
        while lx.i < lx.len && is_hex_digit(lx.cur()) { lx.advance(); }
        if lx.i == hstart {
            let mut sb = StringBuilder::with_capacity(lx.a, 32 as u32);
            sb.push_str("hex literal '0");
            sb.push_byte(xch);
            sb.push_str("' has no digits");
            return Result::Err(mk_dyn(lx, p, &sb));
        }
        emit(toks, Token::Int(parse_hex(lx.bytes, hstart, lx.i)), p);
    } else {
        lx.advance();
        while lx.i < lx.len && is_digit(lx.cur()) { lx.advance(); }
        if lx.cur() == '.' as u8 && is_digit(lx.peek1()) {
            // Float: fractional part, then optional exponent and optional
            // f32/f64 suffix.  Consuming the full syntax keeps the token
            // boundary + width tag exact; only the VALUE is deferred (0.0
            // placeholder until a `str -> f64` parser lands).
            lx.advance();                                  // '.'
            while lx.i < lx.len && is_digit(lx.cur()) { lx.advance(); }
            if lx.cur() == 'e' as u8 || lx.cur() == 'E' as u8 {
                lx.advance();
                if lx.cur() == '+' as u8 || lx.cur() == '-' as u8 { lx.advance(); }
                if lx.i >= lx.len || !is_digit(lx.cur()) {
                    return Result::Err(
                        alloc(lx.ar, p, "float literal exponent has no digits"));
                }
                while lx.i < lx.len && is_digit(lx.cur()) { lx.advance(); }
            }
            let fend = lx.i;
            let is32 = lex_float_suffix(lx);
            emit(toks, Token::Float(parse_float(lx.bytes, start_i, fend), is32), p);
        } else {
            emit(toks, Token::Int(parse_dec(lx.bytes, start_i, lx.i)), p);
        }
    }
    return Result::Ok(true);
}

// Scan a `'c'` char literal -> the byte's integer value (an Int token).
fn lex_char(lx: *Lexer, toks: *Vec<TokenPos>, p: Pos)
        -> Result<bool, *const CompileError> {
    lx.advance();                         // opening '
    if lx.i >= lx.len {
        return Result::Err(alloc(lx.ar, p, "unterminated char literal"));
    }
    let mut code = 0;
    if lx.cur() == 92 as u8 {             // backslash escape
        lx.advance();
        if lx.i >= lx.len {
            return Result::Err(alloc(lx.ar, p, "unterminated char literal"));
        }
        let ec = lx.cur();
        if !is_char_escape(ec) {
            let mut sb = StringBuilder::with_capacity(lx.a, 40 as u32);
            sb.push_str("unknown escape \\");
            sb.push_byte(ec);
            sb.push_str(" in char literal");
            return Result::Err(mk_dyn(lx, p, &sb));
        }
        code = char_escape(ec);
        lx.advance();
    } else if lx.cur() == 39 as u8 {      // '' — empty
        return Result::Err(alloc(lx.ar, p, "empty char literal"));
    } else {
        code = lx.cur() as int;
        lx.advance();
    }
    if lx.i >= lx.len || lx.cur() != 39 as u8 {
        return Result::Err(
            alloc(lx.ar, p, "char literal holds exactly one byte — missing closing '"));
    }
    lx.advance();                         // closing '
    emit(toks, Token::Int(code), p);
    return Result::Ok(true);
}

// Scan a `"…"` string literal.  The scan is escape-aware (so `\"` does
// not end it) and VALIDATES each escape, but the interned bytes are RAW
// (escape decoding deferred — see header).
fn lex_string(lx: *Lexer, toks: *Vec<TokenPos>, p: Pos)
        -> Result<bool, *const CompileError> {
    lx.advance();                         // opening "
    // Decode escapes into the interned bytes (`\n` -> byte 0x0A), so the
    // emitted `str` carries the real bytes — the dumper re-escapes them.
    let mut sb = StringBuilder::with_capacity(lx.a, 32 as u32);
    while lx.i < lx.len && lx.cur() != 34 as u8 {
        if lx.cur() == 92 as u8 {         // backslash escape
            lx.advance();                 // consume backslash
            let esc_pos = lx.here();
            if lx.i >= lx.len {
                return Result::Err(alloc(lx.ar, p, "unterminated string literal"));
            }
            let ec = lx.cur();
            if ec == '0' as u8 {
                return Result::Err(alloc(lx.ar, esc_pos,
                    "embedded \\0 would silently truncate the string (exile str is NUL-terminated) — use a byte buffer for binary data"));
            }
            if !is_string_escape(ec) {
                let mut eb = StringBuilder::with_capacity(lx.a, 24 as u32);
                eb.push_str("unknown escape \\");
                eb.push_byte(ec);
                return Result::Err(mk_dyn(lx, esc_pos, &eb));
            }
            sb.push_byte(char_escape(ec) as u8);
            lx.advance();                 // consume escape char
        } else {
            sb.push_byte(lx.cur());
            lx.advance();
        }
    }
    if lx.i >= lx.len {
        return Result::Err(alloc(lx.ar, p, "unterminated string literal"));
    }
    lx.advance();                         // closing "
    emit(toks, Token::String(str::from_slice(lx.ar, sb.as_slice())), p);
    return Result::Ok(true);
}

// Skip a `//` line comment or `/* … */` block comment (no token).
fn skip_line_comment(lx: *Lexer) {
    lx.advance();
    lx.advance();
    while lx.i < lx.len && lx.cur() != 10 as u8 { lx.advance(); }
}

fn skip_block_comment(lx: *Lexer, p: Pos) -> Result<bool, *const CompileError> {
    lx.advance();
    lx.advance();
    while lx.i < lx.len && !(lx.cur() == '*' as u8 && lx.peek1() == '/' as u8) {
        lx.advance();
    }
    if lx.i >= lx.len {
        return Result::Err(alloc(lx.ar, p, "unterminated block comment"));
    }
    lx.advance(); lx.advance();   // consume */
    return Result::Ok(true);
}

// Handle one token (or whitespace / comment) at the current position.
fn lex_one(lx: *Lexer, toks: *Vec<TokenPos>) -> Result<bool, *const CompileError> {
    let start_i = lx.i;
    let c = lx.cur();
    let p = lx.here();
    if c == ' ' as u8 || c == 9 as u8 || c == 13 as u8 || c == 10 as u8 {
        lx.advance();
    } else if c == '(' as u8 { lx.advance(); emit(toks, Token::LParen, p); }
    else if c == ')' as u8 { lx.advance(); emit(toks, Token::RParen, p); }
    else if c == '{' as u8 { lx.advance(); emit(toks, Token::LBrace, p); }
    else if c == '}' as u8 { lx.advance(); emit(toks, Token::RBrace, p); }
    else if c == '[' as u8 { lx.advance(); emit(toks, Token::LBracket, p); }
    else if c == ']' as u8 { lx.advance(); emit(toks, Token::RBracket, p); }
    else if c == ';' as u8 { lx.advance(); emit(toks, Token::Semicolon, p); }
    else if c == ',' as u8 { lx.advance(); emit(toks, Token::Comma, p); }
    else if c == '.' as u8 {
        if lx.peek1() == '.' as u8 && lx.peek2() == '.' as u8 {
            lx.advance(); lx.advance(); lx.advance(); emit(toks, Token::Ellipsis, p);
        } else if lx.peek1() == '.' as u8 && lx.peek2() == '=' as u8 {
            lx.advance(); lx.advance(); lx.advance(); emit(toks, Token::DotDotEq, p);
        } else if lx.peek1() == '.' as u8 {
            lx.advance(); lx.advance(); emit(toks, Token::DotDot, p);
        } else {
            lx.advance(); emit(toks, Token::Dot, p);
        }
    }
    else if c == '&' as u8 {
        if lx.peek1() == '&' as u8 { lx.advance(); lx.advance(); emit(toks, Token::AmpAmp, p); }
        else { lx.advance(); emit(toks, Token::Amp, p); }
    }
    else if c == ':' as u8 {
        if lx.peek1() == ':' as u8 { lx.advance(); lx.advance(); emit(toks, Token::DoubleColon, p); }
        else { lx.advance(); emit(toks, Token::Colon, p); }
    }
    else if c == '+' as u8 {
        if lx.peek1() == '+' as u8 { lx.advance(); lx.advance(); emit(toks, Token::PlusPlus, p); }
        else { lx.advance(); emit(toks, Token::Plus, p); }
    }
    else if c == '*' as u8 { lx.advance(); emit(toks, Token::Star, p); }
    else if c == '/' as u8 {
        if lx.peek1() == '/' as u8 { skip_line_comment(lx); }
        else if lx.peek1() == '*' as u8 { return skip_block_comment(lx, p); }
        else { lx.advance(); emit(toks, Token::Slash, p); }
    }
    else if c == '-' as u8 {
        if lx.peek1() == '>' as u8 { lx.advance(); lx.advance(); emit(toks, Token::Arrow, p); }
        else { lx.advance(); emit(toks, Token::Minus, p); }
    }
    else if c == '<' as u8 {
        if lx.peek1() == '=' as u8 { lx.advance(); lx.advance(); emit(toks, Token::LtEq, p); }
        else if lx.peek1() == '<' as u8 { lx.advance(); lx.advance(); emit(toks, Token::Shl, p); }
        else { lx.advance(); emit(toks, Token::Lt, p); }
    }
    else if c == '>' as u8 {
        if lx.peek1() == '=' as u8 { lx.advance(); lx.advance(); emit(toks, Token::GtEq, p); }
        else if lx.peek1() == '>' as u8 { lx.advance(); lx.advance(); emit(toks, Token::Shr, p); }
        else { lx.advance(); emit(toks, Token::Gt, p); }
    }
    else if c == '=' as u8 {
        if lx.peek1() == '=' as u8 { lx.advance(); lx.advance(); emit(toks, Token::EqEq, p); }
        else if lx.peek1() == '>' as u8 { lx.advance(); lx.advance(); emit(toks, Token::FatArrow, p); }
        else { lx.advance(); emit(toks, Token::Eq, p); }
    }
    else if c == '!' as u8 {
        if lx.peek1() == '=' as u8 { lx.advance(); lx.advance(); emit(toks, Token::NotEq, p); }
        else { lx.advance(); emit(toks, Token::Bang, p); }
    }
    else if c == '|' as u8 {
        if lx.peek1() == '|' as u8 { lx.advance(); lx.advance(); emit(toks, Token::PipePipe, p); }
        else if lx.peek1() == '>' as u8 { lx.advance(); lx.advance(); emit(toks, Token::PipeGt, p); }
        else { lx.advance(); emit(toks, Token::Pipe, p); }
    }
    else if c == '^' as u8 { lx.advance(); emit(toks, Token::Caret, p); }
    else if c == '~' as u8 { lx.advance(); emit(toks, Token::Tilde, p); }
    else if c == '%' as u8 { lx.advance(); emit(toks, Token::Percent, p); }
    else if c == '?' as u8 { lx.advance(); emit(toks, Token::Question, p); }
    else if c == '@' as u8 { lx.advance(); emit(toks, Token::At, p); }
    else if c == 39 as u8 { return lex_char(lx, toks, p); }
    else if c == 34 as u8 { return lex_string(lx, toks, p); }
    else if is_digit(c) { return lex_number(lx, toks, start_i, p); }
    else if is_alpha(c) { return lex_word(lx, toks, start_i, p); }
    else {
        let mut sb = StringBuilder::with_capacity(lx.a, 32 as u32);
        sb.push_str("unexpected character '");
        sb.push_byte(c);
        sb.push_str("'");
        return Result::Err(mk_dyn(lx, p, &sb));
    }
    // Every successful branch consumes at least one byte; report that
    // progress so `tokenize` can guard against a non-advancing scanner.
    return Result::Ok(lx.i > start_i);
}

// `tokenize` — scan `src` into the token stream, terminated by `Eof`.
// Mirrors OCaml `tokenize`.
pub fn tokenize(a: Allocator, ar: *Arena, file: str, src: str)
        -> Result<Vec<TokenPos>, *const CompileError> {
    let mut lx = Lexer {
        bytes: str::as_bytes(src),
        len: str::length(src),
        i: 0 as u32,
        line: 1,
        col: 1,
        file: file,
        a: a,
        ar: ar,
    };
    let mut toks: Vec<TokenPos> = Vec::with_capacity(a, 64 as u32);
    while lx.i < lx.len {
        // `try` propagates a lexical error; the bool is the progress flag
        // — a false would mean a scanner branch failed to advance, so we
        // break rather than spin (it never happens for well-formed input).
        if !(try lex_one(&lx, &toks)) { break; }
    }
    toks.push(TokenPos { tok: Token::Eof, pos: lx.here() });
    return Result::Ok(toks);
}
