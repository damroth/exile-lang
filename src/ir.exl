// Self-host port — `lib/ir.ml` (data types).
//
// The typed intermediate representation: what typecheck produces and
// codegen consumes.  It mirrors `ast` but every expression node carries
// the type elaboration computed for it (`Texpr.ty`), and names are
// resolved to absolute paths + mangled C symbols.
//
// This module ports the IR's DATA TYPES — the frozen typecheck↔codegen
// contract.  `ir.ml`'s pure utilities (typ_name / mangle_typ /
// c_type_prefix / type_of_ann / subst_typ / the texpr·tstmt traversal
// family / …) are consumed by codegen, typecheck, mono and lint — they
// ride with those stages, where they are exercised and verifiable.  The
// only consumer at this stage, the IR dumper, is self-contained (it has
// its own `render_typ_canonical`), so it needs none of them.
//
// Representation idioms follow `ast`: `Typ` and
// `Texpr` recurse through `*const T` (read-only borrows into the arena),
// node lists are `Vec<*const T>`, name/payload pairs are named structs.

use pos::*;
use ast::*;

// ===== Shared name-payload pairs =====

// `(string * typ)` — a struct/enum field, a fn-let, a named type table.
pub struct FieldTy {
    name: str,
    ty: *const Typ,
}

// `(string * texpr)` — a struct-literal / enum-ctor field initialiser.
pub struct TexprField {
    name: str,
    value: *const Texpr,
}

// `(string * tpattern)` — a struct-variant pattern field.
pub struct TFieldPat {
    name: str,
    pat: Tpattern,
}

// ===== The type domain =====

pub struct IntKind {
    is_signed: bool,
    width: IntWidth,
}

// Every type the pipeline reasons about.  `TStruct` / `TEnum` carry the
// absolute path; `TStructApp` / `TEnumApp` hold a still-generic
// application (free `TVar`s) normalised away by mono before codegen;
// `TVar` / `TAssocProj` are likewise pre-codegen only.
pub enum Typ {
    TInt(IntKind)
    | TCInt { is_signed: bool }
    | TCShort { is_signed: bool }
    | TCLong { is_signed: bool }
    | TCChar
    | TCSChar
    | TCUChar
    | TCVoid
    | TBool
    | TFloat(FloatWidth)
    | TString
    | TTuple(Vec<*const Typ>)
    | TStruct(Vec<str>)
    | TExtAlias(str)
    | TExtStruct(str)
    | TEnum(Vec<str>)
    | TStructApp { path: Vec<str>, args: Vec<*const Typ> }
    | TEnumApp { path: Vec<str>, args: Vec<*const Typ> }
    | TPtr(*const Typ)
    | TOwnPtr(*const Typ)
    | TConstPtr(*const Typ)
    // An MMIO window.  Lowers to `volatile T *`; `dir` gates its method set.
    // The base address is NOT in the type — it lives in the emitted pointer
    // value, so a rune is a first-class value whose address flows at runtime,
    // not compiler metadata.
    | TRune { elem: *const Typ, dir: Direction }
    | TArray { elem: *const Typ, size: int }
    | TFnPtr { params: Vec<*const Typ>, ret: Option<*const Typ> }
    | TNullPtr
    | TVar(str)
    | TAssocProj { head: *const Typ, assoc: str }
    // A `ward` overlay INSTANCE: a typed view at `base`, zero
    // runtime storage.  `path` names the ward TYPE (its field layout lives
    // in the ward registry); `base` is the instance's fixed integer base.  A field
    // access `w.f` folds to a rune at `base + offset`; the instance itself is never
    // a C value.
    // `base_sym` is "" for an integer (MMIO) base, or a global symbol name for a
    // `&GLOBAL` (RAM) base — the field then folds to `(char*)&SYM + offset`.
    | TWard { path: Vec<str>, base: int, base_sym: str }
}

// ===== Signatures =====

pub struct FnSig {
    param_tys: Vec<*const Typ>,
    ret_ty: Option<*const Typ>,
    mangled: str,
    fn_pub: bool,
    fn_tparams: Vec<str>,
    fn_variadic: bool,
}

// A struct signature.  `sinstance_args` is `None` for the generic
// skeleton, `Some args` for a monomorphic instance.
pub struct StructSig {
    sname_path: Vec<str>,
    sfields_ty: Vec<FieldTy>,
    sis_pub: bool,
    stparams: Vec<str>,
    sinstance_args: Option<Vec<*const Typ>>,
    sis_debug: bool,
    ss_is_move: bool,
}

// Variant order is preserved so each gets a stable C tag (= list index).
pub struct VariantSig {
    vsname: str,
    vsfields: Vec<FieldTy>,
    vsis_struct: bool,
}

pub struct EnumSig {
    ename_path: Vec<str>,
    evariants: Vec<VariantSig>,
    eis_pub: bool,
    etparams: Vec<str>,
    einstance_args: Option<Vec<*const Typ>>,
    eis_must_use: bool,
    eis_debug: bool,
}

// ===== The typed AST =====
//
// Mirrors `ast::Expr` but every node is wrapped in `Texpr { e, ty, pos }`
// — codegen reads `.ty` directly, never re-infers.

pub enum TexprNode {
    TIntLit(int)
    | TFloatLit(f64, FloatWidth)
    | TBoolLit(bool)
    | TNullLit
    | TStringLit(str)
    | TVar(str)
    | TFnRef(str)
    | TNeg(*const Texpr)
    | TBitNot(*const Texpr)
    | TNot(*const Texpr)
    | TBinOp(BinOp, *const Texpr, *const Texpr)
    | TCall { mangled: str, args: Vec<*const Texpr> }
    | TBuiltinCall { name: str, args: Vec<*const Texpr> }
    | TIndirectCall { fn_expr: *const Texpr, args: Vec<*const Texpr> }
    | TCast(*const Texpr, *const TypeAnn)
    | TTupleLit(Vec<*const Texpr>)
    | TStructLit { sname_path: Vec<str>, fields: Vec<TexprField>,
                   base: Option<*const Texpr> }
    | TFieldAccess { target: *const Texpr, field: str }
    | TRef(*const Texpr)
    | TDeref(*const Texpr)
    | TNew { sname_path: Vec<str>, fields: Vec<TexprField>,
             base: Option<*const Texpr>, alloc: Option<*const Texpr> }
    | TEnumLit { ename_path: Vec<str>, variant: str, tag: int,
                 args: Vec<TexprField> }
    | TNewEnum { ename_path: Vec<str>, variant: str, tag: int,
                 args: Vec<TexprField>, alloc: Option<*const Texpr> }
    | TMatch { scrutinee: *const Texpr, ename_path: Vec<str>,
               arms: Vec<TmatchArm> }
    | TArrayLit(Vec<*const Texpr>)
    | TArrayRepeat { value: *const Texpr, count: int }
    | TIndex { base: *const Texpr, index: *const Texpr }
    | TIfExpr { cond: *const Texpr, then_val: *const Texpr, else_val: *const Texpr }
    | TSizeOf(*const Typ)
    | TBlock { stmts: Vec<Tstmt>, trailing: Option<*const Texpr> }
    // The folded base address of a rune, materialised as the
    // pointer value of its `volatile T *` binding.  Carries only the address;
    // the element width comes from the node's `ty` (a `TRune`).  Emits
    // `(volatile <T> *)<addr>UL` — the `UL` keeps the cast pointer-width so a
    // 64-bit host cc raises no int-to-pointer size warning.
    | TRuneAddr(int)
    // A ward field's address `(volatile <elem>*)(base + offset)` — the
    // base and offset kept SEPARATE (not folded), readable and the shape the
    // 68000's `d16(An)` mode wants once the base is a value (v2).  Node `ty` is the
    // field's `rune<T>`; `elem` is the register scalar.
    | TWardAddr { elem: *const Typ, base: int, base_sym: str, offset: int }
}

// A match arm.  `tdiverges` marks `try`-desugar arms that `return`
// straight out of the enclosing fn rather than yielding a value.
pub struct TmatchArm {
    tpat: Tpattern,
    tguard: Option<*const Texpr>,
    tbody: *const Texpr,
    tdiverges: bool,
    tarm_pos: Pos,
}

pub enum Tpattern {
    TPWildcard
    | TPVar(str)
    | TPLit(int)
    | TPBool(bool)
    | TPVariant { variant: str, tag: int, binds: Vec<TFieldPat> }
    | TPOr(Vec<Tpattern>)
}

// Every expression node, tagged with its elaborated type and position.
pub struct Texpr {
    e: TexprNode,
    ty: *const Typ,
    pos: Pos,
}

pub enum Tstmt {
    TLet { name: str, value: *const Texpr, decl_ty: *const Typ, pos: Pos }
    | TLetTuple { names: Vec<str>, value: *const Texpr, pos: Pos }
    | TAssign { path: Vec<str>, value: *const Texpr, pos: Pos }
    | TAssignField { target: *const Texpr, field: str, value: *const Texpr, pos: Pos }
    | TAssignIndex { base: *const Texpr, index: *const Texpr,
                     value: *const Texpr, pos: Pos }
    | TAssignDeref { target: *const Texpr, value: *const Texpr, pos: Pos }
    | TReturn { value: Option<*const Texpr>, pos: Pos }
    | TExprStmt(*const Texpr)
    | TIf { cond: *const Texpr, then_body: Vec<Tstmt>, else_body: Vec<Tstmt> }
    | TWhile { cond: *const Texpr, body: Vec<Tstmt>, post: Vec<Tstmt> }
    | TBreak(Pos)
    | TContinue(Pos)
    // Transient: lifted away before codegen (and the dump).  Kept in the
    // contract so the lift pass has a node to rewrite; the dumper flags
    // any that survive as an internal-compiler bug.
    | TFor { counter: str, end_var: str, range_temp: Option<TexprField>,
             lo: *const Texpr, hi: *const Texpr, inclusive: bool,
             body: Vec<Tstmt>, pos: Pos }
    | TForEach { it_var: str, it_init: *const Texpr, body: Vec<Tstmt>, pos: Pos }
    | TDefer { body: Vec<Tstmt>, pos: Pos }
    // `seal { … }`.  A scope whose body ALREADY begins with the
    // seam token binding and the `defer` that restores it, so every exit path —
    // fall-through, return, break, continue, try — is handled by the defer
    // machinery and NOT by a second mechanism.  Codegen only opens the scope.
    | TSeal { body: Vec<Tstmt>, pos: Pos }
}

// ===== Function + program =====

// `(string list * Ast.struct_decl)` — a struct decl with its module path.
pub struct StructDeclEntry {
    path: Vec<str>,
    decl: StructDecl,
}

// `(string list * string * fn_sig)` — a global fn entry (path, name, sig).
pub struct GlobalEntry {
    path: Vec<str>,
    name: str,
    sig: FnSig,
}

// `(string list * bool)` — a module's path and its public flag.
pub struct ModuleEntry {
    path: Vec<str>,
    is_pub: bool,
}

// `(string * string)` — a folded `const` (mangled C name, literal value).
pub struct StrPair {
    a: str,
    b: str,
}

// A top-level `rune`: emitted as a file-scope
// `volatile T *const NAME = <value>;`.  `rg_ty` is the `TRune` (its C type is the
// `volatile T *`); `rg_value` is the base-address cast (`(volatile T*)ADDR`).
pub struct RuneGlobal {
    rg_name: str,
    rg_ty: *const Typ,
    rg_value: *const Texpr,
}

// Per-function codegen payload: the original `ast::Func` for user trivia,
// the resolved C name, scope-resolved param/return types, the elaborated
// body, and the hoisted let-decl list.
pub struct Tfunc {
    tf_path: Vec<str>,
    tf_func: Func,
    tf_mangled: str,
    tf_param_tys: Vec<*const Typ>,
    tf_ret_ty: Option<*const Typ>,
    tf_body: Vec<Tstmt>,
    tf_lets: Vec<FieldTy>,
    // C name -> the name the USER wrote, for the bindings the compiler renamed:
    // disjoint siblings (`v` -> `v__1`), the `for` counter (`i` -> `__fv1`), a
    // scoped projection (`x` -> `x__with0`).  Only the entries that differ.
    // Diagnostics render through `src_name` so they quote the user's source, not
    // the compiler's bookkeeping.  Never emitted — codegen uses the C names.
    tf_srcnames: Vec<StrPair>,
    tf_origin_pos: Option<Pos>,
}


// The whole checked + elaborated program codegen consumes.
pub struct Tprogram {
    tp_funcs: Vec<Tfunc>,
    // Prelude FREE functions (`str::*`) materialized on demand.  Held apart
    // from tp_funcs because the oracle prepends the prelude, so these emit in
    // the free-function section BEFORE user free fns (e.g. `main`); codegen
    // emits tp_pfree ahead of tp_funcs.
    tp_pfree: Vec<Tfunc>,
    // Prelude NON-GENERIC impl methods (StringBuilder / String / Arena).  The
    // oracle's prepended prelude puts them at the head of the impl-method
    // section — measured: `main, StringBuilder__*, Point__fmt` — while the port
    // materializes them on demand, i.e. last.  Held apart so codegen can emit
    // them between the user free fns and the user impls.  Generic prelude
    // instances (Vec_i32 / Map_*) ride the genjob drain and stay in tp_funcs:
    // the oracle emits those AFTER the user impls, which the drain already
    // reproduces.
    tp_pmeth: Vec<Tfunc>,
    // Index into tp_funcs one past the last user FREE fn (the elaborate_item
    // pass): the boundary tp_pmeth is emitted at.
    tp_free_end: u32,
    tp_struct_decls: Vec<StructDeclEntry>,
    tp_struct_index: Vec<StructSig>,
    tp_enum_index: Vec<EnumSig>,
    tp_global: Vec<GlobalEntry>,
    tp_modules: Vec<ModuleEntry>,
    tp_uses_heap: bool,
    tp_uses_string_h: bool,
    tp_uses_default_allocator: bool,
    tp_tuple_types: Vec<FieldTy>,
    tp_fnptr_types: Vec<FieldTy>,
    tp_c_includes: Vec<str>,
    tp_ext_consts: Vec<FieldTy>,
    tp_ext_vars: Vec<FieldTy>,
    tp_array_types: Vec<FieldTy>,
    tp_consts: Vec<StrPair>,
    tp_runes: Vec<RuneGlobal>,
}


// ===== The user-facing type renderer =====
//
// `typ_name` prints a type the way the SOURCE spells it (`*const Vec<int>`,
// `Result<i32, str>`), which is what a diagnostic and `type_name(x)` must show — a
// user writes exile, so they read exile back, not the C mangling (that is
// `mangle_typ`'s job, and it lives with codegen).
//
// It sits HERE, in the IR, because both consumers need it and neither may depend on
// the other: typecheck names types in its diagnostics, codegen names them in
// `type_name`.  Mirrors the reference, where it lives in `ir.ml`.
pub fn int_typ_name(is_signed: bool, width: IntWidth) -> str {
    if is_signed {
        return match width { IntWidth::W8 => "i8" | IntWidth::W16 => "i16" | IntWidth::W32 => "i32" };
    }
    return match width { IntWidth::W8 => "u8" | IntWidth::W16 => "u16" | IntWidth::W32 => "u32" };
}

fn typ_names_join(a: Allocator, ar: *Arena, ts: *const Vec<*const Typ>, sep: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    let sl = ts.as_slice();
    let mut i = 0 as u32;
    while i < ts.length() {
        if i > 0 as u32 { sb.push_str(sep); }
        sb.push_str(typ_name(a, ar, sl[i]));
        i = i + 1 as u32;
    }
    return str::from_slice(ar, sb.as_slice());
}
fn path_join_cg(a: Allocator, ar: *Arena, p: *const Vec<str>) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    let sl = p.as_slice();
    let mut i = 0 as u32;
    while i < p.length() {
        if i > 0 as u32 { sb.push_str("::"); }
        sb.push_str(sl[i]);
        i = i + 1 as u32;
    }
    return str::from_slice(ar, sb.as_slice());
}
fn typ_name_app(a: Allocator, ar: *Arena, p: *const Vec<str>, args: *const Vec<*const Typ>) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(path_join_cg(a, ar, p));
    sb.push_str("<");
    sb.push_str(typ_names_join(a, ar, args, ", "));
    sb.push_str(">");
    return str::from_slice(ar, sb.as_slice());
}
fn typ_name_pfx(a: Allocator, ar: *Arena, pfx: str, inner: *const Typ) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(pfx);
    sb.push_str(typ_name(a, ar, inner));
    return str::from_slice(ar, sb.as_slice());
}
// `write rune<T>` — the SIGNATURE form, direction included.
// It has to be: the direction is part of type identity (`typ_eq` compares it), so
// a printer that dropped it would render a direction mismatch as
// "expected rune<u16>, got rune<u16>".  Printed form == source form.
fn typ_name_rune(a: Allocator, ar: *Arena, elem: *const Typ, dir: Direction) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(match dir { Direction::DRead => "read " | Direction::DWrite => "write " | Direction::DReadWrite => "readwrite " });
    sb.push_str("rune<");
    sb.push_str(typ_name(a, ar, elem));
    sb.push_str(">");
    return str::from_slice(ar, sb.as_slice());
}
fn typ_name_arr(a: Allocator, ar: *Arena, elem: *const Typ, size: int) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str("[");
    sb.push_str(typ_name(a, ar, elem));
    sb.push_str("; ");
    sb.push_int(size);
    sb.push_str("]");
    return str::from_slice(ar, sb.as_slice());
}
fn typ_name_fnptr(a: Allocator, ar: *Arena, params: *const Vec<*const Typ>, ret: Option<*const Typ>) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str("fn(");
    sb.push_str(typ_names_join(a, ar, params, ", "));
    sb.push_str(")");
    match ret {
        Option::Some(rt) => { sb.push_str(" -> "); sb.push_str(typ_name(a, ar, rt)); }
        | Option::None => { }
    }
    return str::from_slice(ar, sb.as_slice());
}
fn typ_name_proj(a: Allocator, ar: *Arena, head: *const Typ, assoc: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(typ_name(a, ar, head));
    sb.push_str("::");
    sb.push_str(assoc);
    return str::from_slice(ar, sb.as_slice());
}
fn typ_name_tuple(a: Allocator, ar: *Arena, ts: *const Vec<*const Typ>) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str("(");
    sb.push_str(typ_names_join(a, ar, ts, ", "));
    sb.push_str(")");
    return str::from_slice(ar, sb.as_slice());
}
pub fn typ_name(a: Allocator, ar: *Arena, t: *const Typ) -> str {
    return match *t {
        Typ::TInt(k) => int_typ_name(k.is_signed, k.width)
        | Typ::TCInt { is_signed } => { if is_signed { "c_int" } else { "c_uint" } }
        | Typ::TCShort { is_signed } => { if is_signed { "c_short" } else { "c_ushort" } }
        | Typ::TCLong { is_signed } => { if is_signed { "c_long" } else { "c_ulong" } }
        | Typ::TCChar => "c_char" | Typ::TCSChar => "c_schar" | Typ::TCUChar => "c_uchar"
        | Typ::TCVoid => "c_void"
        | Typ::TBool => "bool" | Typ::TString => "str"
        | Typ::TFloat(w) => match w { FloatWidth::F32 => "f32" | FloatWidth::F64 => "f64" }
        | Typ::TTuple(ts) => typ_name_tuple(a, ar, &ts)
        | Typ::TStruct(p) => path_join_cg(a, ar, &p)
        | Typ::TEnum(p) => path_join_cg(a, ar, &p)
        | Typ::TExtStruct(n) => n
        | Typ::TExtAlias(n) => n
        | Typ::TStructApp { path, args } => typ_name_app(a, ar, &path, &args)
        | Typ::TEnumApp { path, args } => typ_name_app(a, ar, &path, &args)
        | Typ::TPtr(i) => typ_name_pfx(a, ar, "*", i)
        | Typ::TOwnPtr(i) => typ_name_pfx(a, ar, "own *", i)
        | Typ::TConstPtr(i) => typ_name_pfx(a, ar, "*const ", i)
        | Typ::TRune { elem, dir } => typ_name_rune(a, ar, elem, dir)
        | Typ::TArray { elem, size } => typ_name_arr(a, ar, elem, size)
        | Typ::TFnPtr { params, ret } => typ_name_fnptr(a, ar, &params, ret)
        | Typ::TNullPtr => "*<null>"
        | Typ::TVar(n) => n
        | Typ::TAssocProj { head, assoc } => typ_name_proj(a, ar, head, assoc)
        | Typ::TWard { path, base, base_sym } => path_join_cg(a, ar, &path)
    };
}


// ===== The type-compatibility relation =====
//
// Where the reference keeps it (`ir.ml`), and for the same reason `typ_name` is
// here: typecheck needs it to VALIDATE, codegen needs `typ_eq` to dedup, and
// neither module may depend on the other.

pub fn intwidth_eq(x: IntWidth, y: IntWidth) -> bool {
    return match x {
        IntWidth::W8 => match y { IntWidth::W8 => true | _e => false }
        | IntWidth::W16 => match y { IntWidth::W16 => true | _e => false }
        | IntWidth::W32 => match y { IntWidth::W32 => true | _e => false }
    };
}

pub fn floatwidth_eq(x: FloatWidth, y: FloatWidth) -> bool {
    return match x {
        FloatWidth::F32 => match y { FloatWidth::F32 => true | _e => false }
        | FloatWidth::F64 => match y { FloatWidth::F64 => true | _e => false }
    };
}

pub fn dir_eq(x: Direction, y: Direction) -> bool {
    return match x {
        Direction::DRead => match y { Direction::DRead => true | _e => false }
        | Direction::DWrite => match y { Direction::DWrite => true | _e => false }
        | Direction::DReadWrite => match y { Direction::DReadWrite => true | _e => false }
    };
}

pub fn tc_join_sb(a: Allocator, p: *const Vec<str>) -> StringBuilder {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    let sl = p.as_slice();
    let mut i = 0 as u32;
    while i < p.length() { if i > 0 as u32 { sb.push_str("::"); } sb.push_str(sl[i]); i = i + 1 as u32; }
    return sb;
}

pub fn path_eq(a: *const Vec<str>, b: *const Vec<str>) -> bool {
    let n = a.length();
    if n == b.length() {
        let sa = a.as_slice();
        let sb = b.as_slice();
        let mut i = 0 as u32;
        while i < n {
            if !str::eq(sa[i], sb[i]) { return false; }
            i = i + 1 as u32;
        }
        return true;
    }
    let al = default_allocator();
    let ja = tc_join_sb(al, a);
    let jb = tc_join_sb(al, b);
    if ja.length() != jb.length() { return false; }
    let ba = ja.as_slice();
    let bb = jb.as_slice();
    let mut k = 0 as u32;
    while k < ja.length() { if ba[k] != bb[k] { return false; } k = k + 1 as u32; }
    return true;
}

pub fn opt_typ_eq(x: Option<*const Typ>, y: Option<*const Typ>) -> bool {
    return match x {
        Option::Some(xt) => match y { Option::Some(yt) => typ_eq(xt, yt) | Option::None => false }
        | Option::None => match y { Option::Some(yt2) => false | Option::None => true }
    };
}

pub fn tys_eq(xs: *const Vec<*const Typ>, ys: *const Vec<*const Typ>) -> bool {
    if xs.length() != ys.length() { return false; }
    let sx = xs.as_slice();
    let sy = ys.as_slice();
    let mut i = 0 as u32;
    while i < xs.length() { if !typ_eq(sx[i], sy[i]) { return false; } i = i + 1 as u32; }
    return true;
}

// Equality used for type-MATCH decisions (let / return / arg / field / assign).
// Plain structural equality would reject `null` against any concrete pointer type;
// the null literal is polymorphic over pointer types, so it is matched here rather
// than special-cased at every site.  (The port's own typ_eq lacked this until the
// let-annotation check exposed it: `let p: *c_void = null` was rejected.)
pub fn typ_eq(x: *const Typ, y: *const Typ) -> bool {
    if is_nullish(x) { return is_ptr_like(y); }
    if is_nullish(y) { return is_ptr_like(x); }
    return match *x {
        Typ::TInt(kx) => match *y { Typ::TInt(ky) => (kx.is_signed == ky.is_signed) && intwidth_eq(kx.width, ky.width) | _e => false }
        | Typ::TBool => match *y { Typ::TBool => true | _e => false }
        | Typ::TString => match *y { Typ::TString => true | _e => false }
        | Typ::TFloat(wx) => match *y { Typ::TFloat(wy) => floatwidth_eq(wx, wy) | _e => false }
        | Typ::TCInt { is_signed } => match *y { Typ::TCInt { is_signed: s2 } => is_signed == s2 | _e => false }
        | Typ::TCShort { is_signed } => match *y { Typ::TCShort { is_signed: s2 } => is_signed == s2 | _e => false }
        | Typ::TCLong { is_signed } => match *y { Typ::TCLong { is_signed: s2 } => is_signed == s2 | _e => false }
        | Typ::TCChar => match *y { Typ::TCChar => true | _e => false }
        | Typ::TCSChar => match *y { Typ::TCSChar => true | _e => false }
        | Typ::TCUChar => match *y { Typ::TCUChar => true | _e => false }
        | Typ::TCVoid => match *y { Typ::TCVoid => true | _e => false }
        | Typ::TStruct(px) => match *y { Typ::TStruct(py) => path_eq(&px, &py) | _e => false }
        | Typ::TEnum(px) => match *y { Typ::TEnum(py) => path_eq(&px, &py) | _e => false }
        | Typ::TExtStruct(nx) => match *y { Typ::TExtStruct(ny) => str::eq(nx, ny) | _e => false }
        | Typ::TExtAlias(nx) => match *y { Typ::TExtAlias(ny) => str::eq(nx, ny) | _e => false }
        | Typ::TPtr(ix) => match *y { Typ::TPtr(iy) => typ_eq(ix, iy) | _e => false }
        | Typ::TOwnPtr(ix) => match *y { Typ::TOwnPtr(iy) => typ_eq(ix, iy) | _e => false }
        | Typ::TConstPtr(ix) => match *y { Typ::TConstPtr(iy) => typ_eq(ix, iy) | _e => false }
        | Typ::TRune { elem, dir } => match *y { Typ::TRune { elem: e2, dir: d2 } => typ_eq(elem, e2) && dir_eq(dir, d2) | _e => false }
        | Typ::TTuple(tx) => match *y { Typ::TTuple(ty2) => tys_eq(&tx, &ty2) | _e => false }
        | Typ::TArray { elem, size } => match *y { Typ::TArray { elem: e2, size: s2 } => (size == s2) && typ_eq(elem, e2) | _e => false }
        | Typ::TFnPtr { params, ret } => match *y { Typ::TFnPtr { params: p2, ret: r2 } => tys_eq(&params, &p2) && opt_typ_eq(ret, r2) | _e => false }
        | Typ::TWard { path, base, base_sym } => match *y { Typ::TWard { path: p2, base: b2, base_sym: s2 } => (base == b2) && str::eq(base_sym, s2) && path_eq(&path, &p2) | _e => false }
        | _e => false
    };
}

// The `null` literal's type.  Every relation that reasons about pointers must ask
// THROUGH these two rather than matching `TNullPtr` inline: three separate relations
// (typ_eq, is_ptr_ty, and the let-inference path) each shipped without a null case
// and each was found only when something finally asked.  Centralising the question
// is what makes a fourth instance structurally harder.
pub fn is_nullish(t: *const Typ) -> bool {
    return match *t { Typ::TNullPtr => true | _o => false };
}
pub fn is_ptr_like(t: *const Typ) -> bool {
    return match *t {
        Typ::TPtr(_i) => true
        | Typ::TOwnPtr(_i) => true
        | Typ::TConstPtr(_i) => true
        | Typ::TNullPtr => true
        | _o => false
    };
}
// The pointee of a rune's `volatile T *` — the register's SCALAR width.  For a
// standalone rune it is the element itself; for a register file (`rune x: [T;N]`)
// it is the array's element — the pointer is to one register, indexed by
// position.  The extent lives in the `TArray.size`.
pub fn rune_ptr_pointee(elem: *const Typ) -> *const Typ {
    return match *elem { Typ::TArray { elem: e, size } => e | _o => elem };
}
// A register-file rune's extent (`N` in `[T; N]`), or 0 for a standalone rune.
pub fn rune_extent(elem: *const Typ) -> int {
    return match *elem { Typ::TArray { elem: e, size } => size | _o => 0 as int };
}
// A `*T` may be handed to a `*const T` slot (you can always drop write capability),
// and an `own *T` may lend itself out as a borrow — never the reverse: ownership
// cannot be fabricated from a loan.  Pointer-to-pointer through nested `*` keeps
// strict identity (no deep const-ification — that would change C aliasing rules).
pub fn coercible_to(from: *const Typ, to: *const Typ) -> bool {
    if typ_eq(from, to) { return true; }
    return match *from {
        Typ::TPtr(x) => match *to { Typ::TConstPtr(y) => typ_eq(x, y) | _o => false }
        | Typ::TOwnPtr(x) => match *to {
            Typ::TPtr(y) => typ_eq(x, y)
            | Typ::TConstPtr(y) => typ_eq(x, y)
            | _o => false
        }
        // Direction ATTENUATION (P1): a `readwrite` rune may be lent where a
        // `read` or `write` one is expected — fewer rights than you hold.  The
        // reverse would fabricate a capability from a loan, forbidden by the same
        // sentence that forbids making an `own *T` out of a borrow.
        | Typ::TRune { elem, dir } => match *to {
            Typ::TRune { elem: e2, dir: d2 } => typ_eq(elem, e2) && dir_attenuates(dir, d2)
            | _o => false
        }
        | _o => false
    };
}
// `readwrite` covers both, so it may narrow to either; anything else must match.
pub fn dir_attenuates(from: Direction, to: Direction) -> bool {
    return match from {
        Direction::DReadWrite => true
        | _o => dir_eq(from, to)
    };
}

// Does an integer literal fit the slot it is being written into?  `c_long` is >= 32
// bits per the C standard, so any literal an exile `int` can hold is accepted and the
// C compiler catches overflow against the real target width.  An `extern type` alias
// is opaque — allow anything an i32 holds and let C decide.
pub fn int_fits(n: int, t: *const Typ) -> bool {
    return match *t {
        Typ::TInt(k) => int_fits_width(n, k.is_signed, k.width)
        | Typ::TCInt { is_signed } => int_fits_bounds(n, is_signed, 32 as u32)
        | Typ::TCShort { is_signed } => int_fits_bounds(n, is_signed, 16 as u32)
        | Typ::TCLong { is_signed } => { if is_signed { true } else { n >= 0 as int } }
        | Typ::TCChar => n >= 0 as int - 128 as int && n <= 255 as int
        | Typ::TCSChar => n >= 0 as int - 128 as int && n <= 127 as int
        | Typ::TCUChar => n >= 0 as int && n <= 255 as int
        | Typ::TExtAlias(_x) => int_fits_bounds(n, true, 32 as u32)
        | _o => false
    };
}
fn int_fits_width(n: int, is_signed: bool, w: IntWidth) -> bool {
    return match w {
        IntWidth::W8 => int_fits_bounds(n, is_signed, 8 as u32)
        | IntWidth::W16 => int_fits_bounds(n, is_signed, 16 as u32)
        | IntWidth::W32 => int_fits_bounds(n, is_signed, 32 as u32)
    };
}
fn int_fits_bounds(n: int, is_signed: bool, bits: u32) -> bool {
    if bits == 8 as u32 {
        if is_signed { return n >= 0 as int - 128 as int && n <= 127 as int; }
        return n >= 0 as int && n <= 255 as int;
    }
    if bits == 16 as u32 {
        if is_signed { return n >= 0 as int - 32768 as int && n <= 32767 as int; }
        return n >= 0 as int && n <= 65535 as int;
    }
    if is_signed { return n >= 0 as int - 2147483648 as int && n <= 2147483647 as int; }
    return n >= 0 as int && n <= 4294967295 as int;
}

// ===== Variable-read collection over a typed expression =====
//
// Every `TVar` occurrence in an expression tree, for the passes that need to
// know what a body READS rather than what it consumes. Shared here because the
// first consumer (drop's defer-reads rule) will not be the last, and building it
// inside one rule would make the next one build it again.
//
// EXHAUSTIVE, with no catch-all, and the reason is the failure mode: a missing
// arm does not crash and does not mis-name anything - it silently drops a read,
// and a rule keyed on reads then fails to fire. A checker that goes quiet is the
// hardest kind of wrong to notice.
pub fn collect_texpr_vars(te: *const Texpr, out: *Vec<str>) {
    match te.e {
        TexprNode::TIntLit(_v) => { }
        | TexprNode::TFloatLit(_v, _w) => { }
        | TexprNode::TBoolLit(_v) => { }
        | TexprNode::TNullLit => { }
        | TexprNode::TStringLit(_v) => { }
        | TexprNode::TVar(n) => { out.push(n); }
        | TexprNode::TFnRef(_n) => { }
        | TexprNode::TNeg(i) => { collect_texpr_vars(i, out); }
        | TexprNode::TBitNot(i) => { collect_texpr_vars(i, out); }
        | TexprNode::TNot(i) => { collect_texpr_vars(i, out); }
        | TexprNode::TBinOp(_op, l, r) => { collect_texpr_vars(l, out); collect_texpr_vars(r, out); }
        | TexprNode::TCall { mangled, args } => { collect_vars_args(&args, out); }
        | TexprNode::TBuiltinCall { name, args } => { collect_vars_args(&args, out); }
        | TexprNode::TIndirectCall { fn_expr, args } => { collect_texpr_vars(fn_expr, out); collect_vars_args(&args, out); }
        | TexprNode::TCast(i, _ann) => { collect_texpr_vars(i, out); }
        | TexprNode::TTupleLit(es) => { collect_vars_args(&es, out); }
        | TexprNode::TStructLit { sname_path, fields, base } => {
            collect_vars_fields(&fields, out); collect_vars_opt(base, out);
        }
        | TexprNode::TFieldAccess { target, field } => { collect_texpr_vars(target, out); }
        | TexprNode::TRef(i) => { collect_texpr_vars(i, out); }
        | TexprNode::TDeref(i) => { collect_texpr_vars(i, out); }
        | TexprNode::TNew { sname_path, fields, base, alloc } => {
            collect_vars_fields(&fields, out); collect_vars_opt(base, out); collect_vars_opt(alloc, out);
        }
        | TexprNode::TEnumLit { ename_path, variant, tag, args } => { collect_vars_fields(&args, out); }
        | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => {
            collect_vars_fields(&args, out); collect_vars_opt(alloc, out);
        }
        | TexprNode::TMatch { scrutinee, ename_path, arms } => {
            collect_texpr_vars(scrutinee, out);
            collect_vars_arms(&arms, out);
        }
        | TexprNode::TArrayLit(es) => { collect_vars_args(&es, out); }
        | TexprNode::TArrayRepeat { value, count } => { collect_texpr_vars(value, out); }
        | TexprNode::TIndex { base, index } => { collect_texpr_vars(base, out); collect_texpr_vars(index, out); }
        | TexprNode::TIfExpr { cond, then_val, else_val } => {
            collect_texpr_vars(cond, out); collect_texpr_vars(then_val, out); collect_texpr_vars(else_val, out);
        }
        | TexprNode::TSizeOf(_t) => { }
        | TexprNode::TBlock { stmts, trailing } => {
            collect_tstmts_vars(&stmts, out); collect_vars_opt(trailing, out);
        }
        | TexprNode::TRuneAddr(_addr) => { }
        | TexprNode::TWardAddr { elem, base, base_sym, offset } => { }
    }
    return;
}
// Through a POINTER, not `arms.as_slice()[i].field` at the match site: the port
// cannot resolve the element type of a Vec bound by a pattern that way and
// answers `got c_void`. Measured on itself - the oracle compiles that shape, the
// port does not, so src/ has to stay inside what BOTH accept.
fn collect_vars_arms(arms: *const Vec<TmatchArm>, out: *Vec<str>) {
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < arms.length() {
        collect_vars_opt(sl[i].tguard, out);
        collect_texpr_vars(sl[i].tbody, out);
        i = i + 1 as u32;
    }
    return;
}
fn collect_vars_args(es: *const Vec<*const Texpr>, out: *Vec<str>) {
    let sl = es.as_slice();
    let mut i = 0 as u32;
    while i < es.length() { collect_texpr_vars(sl[i], out); i = i + 1 as u32; }
    return;
}
fn collect_vars_fields(fs: *const Vec<TexprField>, out: *Vec<str>) {
    let sl = fs.as_slice();
    let mut i = 0 as u32;
    while i < fs.length() { collect_texpr_vars(sl[i].value, out); i = i + 1 as u32; }
    return;
}
fn collect_vars_opt(e: Option<*const Texpr>, out: *Vec<str>) {
    match e {
        Option::Some(x) => { collect_texpr_vars(x, out); }
        | Option::None => { }
    }
    return;
}
// Statements, for the `TBlock` arm above and for callers holding a body.
pub fn collect_tstmts_vars(stmts: *const Vec<Tstmt>, out: *Vec<str>) {
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() { collect_tstmt_vars(&sl[i], out); i = i + 1 as u32; }
    return;
}
fn collect_tstmt_vars(s: *const Tstmt, out: *Vec<str>) {
    match *s {
        Tstmt::TLet { name, value, decl_ty, pos } => { collect_texpr_vars(value, out); }
        | Tstmt::TLetTuple { names, value, pos } => { collect_texpr_vars(value, out); }
        | Tstmt::TAssign { path, value, pos } => { collect_texpr_vars(value, out); }
        | Tstmt::TAssignField { target, field, value, pos } => { collect_texpr_vars(target, out); collect_texpr_vars(value, out); }
        | Tstmt::TAssignDeref { target, value, pos } => { collect_texpr_vars(target, out); collect_texpr_vars(value, out); }
        | Tstmt::TAssignIndex { base, index, value, pos } => {
            collect_texpr_vars(base, out); collect_texpr_vars(index, out); collect_texpr_vars(value, out);
        }
        | Tstmt::TReturn { value, pos } => { collect_vars_opt(value, out); }
        | Tstmt::TExprStmt(e) => { collect_texpr_vars(e, out); }
        | Tstmt::TIf { cond, then_body, else_body } => {
            collect_texpr_vars(cond, out); collect_tstmts_vars(&then_body, out); collect_tstmts_vars(&else_body, out);
        }
        | Tstmt::TWhile { cond, body, post } => {
            collect_texpr_vars(cond, out); collect_tstmts_vars(&body, out); collect_tstmts_vars(&post, out);
        }
        | Tstmt::TDefer { body, pos } => { collect_tstmts_vars(&body, out); }
        | Tstmt::TSeal { body, pos } => { collect_tstmts_vars(&body, out); }
        | Tstmt::TFor { counter, end_var, range_temp, lo, hi, inclusive, body, pos } => {
            collect_texpr_vars(lo, out); collect_texpr_vars(hi, out); collect_tstmts_vars(&body, out);
        }
        | Tstmt::TForEach { it_var, it_init, body, pos } => {
            collect_texpr_vars(it_init, out); collect_tstmts_vars(&body, out);
        }
        | Tstmt::TBreak(_q) => { }
        | Tstmt::TContinue(_q) => { }
    }
    return;
}

// A MIRROR of the reference's `stmt_exprs` (lib/drop.ml:91), not a model of it.
// Two models were fitted to the observed behaviour and both died: reachability
// (killed by `if/else` with the read in both branches, accepted), then
// "each statement's own expressions" (killed by a read in an `if` or `while`
// CONDITION, also accepted). The source is an explicit list of six statement
// forms; everything else - `TIf`, `TWhile`, `TFor`, `TForEach`, `TReturn`,
// `TDefer`, `TSeal`, `TBreak`, `TContinue` - contributes nothing at all.
//
// So a `match`'s arms are counted not because arms are special but because a
// match in statement position IS a `TExprStmt`, and expression descent reaches
// its arms.
pub fn collect_tstmts_vars_own(stmts: *const Vec<Tstmt>, out: *Vec<str>) {
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() { collect_tstmt_vars_own(&sl[i], out); i = i + 1 as u32; }
    return;
}
fn collect_tstmt_vars_own(s: *const Tstmt, out: *Vec<str>) {
    match *s {
        Tstmt::TLet { name, value, decl_ty, pos } => { collect_texpr_vars(value, out); }
        | Tstmt::TLetTuple { names, value, pos } => { collect_texpr_vars(value, out); }
        | Tstmt::TAssign { path, value, pos } => { collect_texpr_vars(value, out); }
        | Tstmt::TAssignDeref { target, value, pos } => { collect_texpr_vars(value, out); }
        | Tstmt::TExprStmt(e) => { collect_texpr_vars(e, out); }
        | Tstmt::TAssignField { target, field, value, pos } => {
            collect_texpr_vars(target, out); collect_texpr_vars(value, out);
        }
        | Tstmt::TAssignIndex { base, index, value, pos } => {
            collect_texpr_vars(base, out); collect_texpr_vars(index, out); collect_texpr_vars(value, out);
        }
        | Tstmt::TReturn { value, pos } => { }
        | Tstmt::TIf { cond, then_body, else_body } => { }
        | Tstmt::TWhile { cond, body, post } => { }
        | Tstmt::TFor { counter, end_var, range_temp, lo, hi, inclusive, body, pos } => { }
        | Tstmt::TForEach { it_var, it_init, body, pos } => { }
        | Tstmt::TDefer { body, pos } => { }
        | Tstmt::TSeal { body, pos } => { }
        | Tstmt::TBreak(_q) => { }
        | Tstmt::TContinue(_q) => { }
    }
    return;
}
