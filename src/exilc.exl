// exilc — the self-hosted compiler driver (Faza B).
//
// Stitches the pipeline the six corpus drivers exercised separately into one
// argv-driven binary, matching the OCaml oracle's `bin/main.ml` flag surface.
// This round covers the read-only emit modes and `--target c` transpile — the
// flags the differential gates stand on — so the gate contract can migrate to
// one binary without a byte moving.  `--target host` (the cc call over a
// `sys_exec` seam) is the next round.
//
// The command line arrives through the DR-006 argv seam: `sys_argv(i)` hands
// back a NUL-terminated `*const c_char`, which is a valid `str` (and a valid
// path for `load` / `sys_open`) with no copy.
//
// Output goes to stdout by default, or to `-o <path>` — matching the oracle's
// `write_dump`, whose emit modes print to stdout unless `-o` redirects them.

use pos;
use token::*;
use lexer::*;
use ast::*;
use ir::*;
use error::*;
use parser::*;
use loader::*;
use typecheck::*;
use move::*;
use escape::*;
use drop::*;
use codegen::*;
use dump_token::*;
use dump_ast::*;
use dump_ir::*;

// ===== output =====

fn flush_stdout(sb: *const StringBuilder) {
    let bytes = sb.as_slice();
    sys::sys_write(1 as c_int, &bytes[0] as *const c_uchar, sb.length() as c_ulong);
    return;
}

// `-o <path>` — O_WRONLY | O_CREAT | O_TRUNC = 1 | 64 | 512 = 577 (Linux).
fn write_file(path: str, sb: *const StringBuilder) -> bool {
    let fd: c_int = sys::sys_open(path as *const c_char, 577 as c_int);
    if fd < 0 as c_int { return false; }
    let bytes = sb.as_slice();
    sys::sys_write(fd, &bytes[0] as *const c_uchar, sb.length() as c_ulong);
    sys::sys_close(fd);
    return true;
}

fn write_dump(out: Option<str>, sb: *const StringBuilder) {
    match out {
        Option::Some(p) => { write_file(p, sb); }
        | Option::None => { flush_stdout(sb); }
    }
    return;
}

fn report_error(a: Allocator, e: *const CompileError) {
    let mut sb = StringBuilder::with_capacity(a, 128 as u32);
    e.fmt(&sb);
    sb.push_str("\n");
    let sl = sb.as_slice();
    sys::sys_write(2 as c_int, &sl[0] as *const c_uchar, sb.length() as c_ulong);
    // The oracle ends a failed compile with `exit 1`.  Reporting a rejected
    // program with a success status is a bug a Makefile cannot see.
    sys::sys_exit(1 as c_int);
    return;
}

fn err_line(msg: str) {
    let m = str::as_bytes(msg);
    sys::sys_write(2 as c_int, &m[0] as *const c_uchar, str::length(msg) as c_ulong);
    let nl = str::as_bytes("\n");
    sys::sys_write(2 as c_int, &nl[0] as *const c_uchar, 1 as c_ulong);
    return;
}

// ===== flags =====

// ca_emit: 0 = full pipeline; 1 = tokens; 2 = ast; 3 = typed-ir.
// ca_target: 0 = c (transpile only); 1 = host (transpile + cc-invoke).
struct CliArgs {
    ca_emit: int,
    ca_user_only: bool,
    ca_after_drop: bool,
    ca_target: int,
    ca_show_cc: bool,
    ca_input: str,
    ca_output: Option<str>,
    ca_c_out: Option<str>,
    ca_links: Vec<str>,
    ca_ok: bool,
}

fn arg_str(i: c_int) -> str {
    return sys::sys_argv(i) as str;
}

// Every accepted flag, in the oracle's dispatch order.  An unknown flag or a
// second input file is an error the same way the reference reports it.
fn parse_cli(a: Allocator) -> CliArgs {
    let none_s: Option<str> = Option::None;
    let links0: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut ca = CliArgs { ca_emit: 0 as int, ca_user_only: false, ca_after_drop: false,
                           ca_target: 0 as int, ca_show_cc: false, ca_input: "", ca_output: none_s,
                           ca_c_out: none_s, ca_links: links0, ca_ok: true };
    let argc = sys::sys_argc();
    let mut i = 1 as c_int;
    while i < argc {
        let arg = arg_str(i);
        if str::eq(arg, "--target") {
            i = i + 1 as c_int;
            if i >= argc { err_line("--target needs an argument"); ca.ca_ok = false; return ca; }
            let t = arg_str(i);
            if str::eq(t, "c") { ca.ca_target = 0 as int; }
            else if str::eq(t, "host") { ca.ca_target = 1 as int; }
            else { err_line("unknown target (expected: c, host)"); ca.ca_ok = false; return ca; }
        }
        else if str::eq(arg, "-o") {
            i = i + 1 as c_int;
            if i >= argc { err_line("-o needs an argument"); ca.ca_ok = false; return ca; }
            ca.ca_output = Option::Some(arg_str(i));
        }
        else if str::eq(arg, "--c-out") {
            i = i + 1 as c_int;
            if i >= argc { err_line("--c-out needs an argument"); ca.ca_ok = false; return ca; }
            ca.ca_c_out = Option::Some(arg_str(i));
        }
        else if str::eq(arg, "--link") {
            i = i + 1 as c_int;
            if i >= argc { err_line("--link needs an argument"); ca.ca_ok = false; return ca; }
            ca.ca_links.push(arg_str(i));
        }
        else if str::eq(arg, "--show-cc-warnings") { ca.ca_show_cc = true; }
        else if str::eq(arg, "--emit-tokens") { ca.ca_emit = set_emit(&ca, 1 as int); }
        else if str::eq(arg, "--emit-ast") { ca.ca_emit = set_emit(&ca, 2 as int); }
        else if str::eq(arg, "--emit-typed-ir") { ca.ca_emit = set_emit(&ca, 3 as int); }
        else if str::eq(arg, "--user-only") { ca.ca_user_only = true; }
        else if str::eq(arg, "--after-drop") { ca.ca_after_drop = true; }
        else if is_input_arg(arg) {
            if !str::eq(ca.ca_input, "") { err_line("multiple input files given"); ca.ca_ok = false; return ca; }
            ca.ca_input = arg;
        }
        else { unknown_flag(arg); ca.ca_ok = false; return ca; }
        i = i + 1 as c_int;
    }
    if str::eq(ca.ca_input, "") { err_line("usage: exilc [--target c|host] [--emit-tokens|--emit-ast|--emit-typed-ir [--user-only] [--after-drop]] [-o out] [--c-out c] [--link stub]... [--show-cc-warnings] <file.exl>"); ca.ca_ok = false; }
    return ca;
}

fn set_emit(ca: *const CliArgs, kind: int) -> int {
    if ca.ca_emit != 0 as int {
        err_line("only one of --emit-tokens / --emit-ast / --emit-typed-ir at a time");
    }
    return kind;
}

// A non-flag token (not starting with '-') is the input file.
fn is_input_arg(arg: str) -> bool {
    if str::length(arg) == 0 as u32 { return false; }
    return str::as_bytes(arg)[0 as u32] != 45 as u8;
}

fn unknown_flag(arg: str) {
    let mut sb = StringBuilder::with_capacity(default_allocator(), 48 as u32);
    sb.push_str("unknown flag: "); sb.push_str(arg);
    err_line(str::from_slice(&mk_tmp_arena(), sb.as_slice()));
    return;
}
fn mk_tmp_arena() -> Arena {
    return Arena::with_capacity(default_allocator(), 256 as u32);
}

// ===== pipeline =====

fn arena_cap_for(srclen: u32) -> u32 {
    return 1048576 as u32 + srclen * 128 as u32;
}

fn run_emit_tokens(a: Allocator, ar: *Arena, ca: *const CliArgs) {
    let src = read_source(a, ar, ca.ca_input);
    match tokenize(a, ar, ca.ca_input, src) {
        Result::Ok(toks) => {
            let mut out = StringBuilder::with_capacity(a, 16384 as u32);
            dump_tokens(&toks, ca.ca_input, &out);
            write_dump(ca.ca_output, &out);
        }
        | Result::Err(e) => { report_error(a, e); }
    }
    return;
}

fn run_emit_ast(a: Allocator, ar: *Arena, ca: *const CliArgs) {
    match load(a, ar, ca.ca_input) {
        Result::Ok(prog) => {
            let mut out = StringBuilder::with_capacity(a, 16384 as u32);
            dump_ast(&prog, ca.ca_input, &out);
            write_dump(ca.ca_output, &out);
        }
        | Result::Err(e) => { report_error(a, e); }
    }
    return;
}

fn run_emit_ir(a: Allocator, ar: *Arena, ca: *const CliArgs) {
    match load(a, ar, ca.ca_input) {
        Result::Ok(prog) => { run_emit_ir_checked(a, ar, ca, &prog); }
        | Result::Err(e) => { report_error(a, e); }
    }
    return;
}
fn run_emit_ir_checked(a: Allocator, ar: *Arena, ca: *const CliArgs, prog: *const Vec<Item>) {
    match check_program(a, ar, prog) {
        Result::Ok(tp) => {
            let mut tprog = tp;
            // `--after-drop` mirrors the reference's pipeline prefix:
            // Move.check; Escape.check; Drop.insert.
            if ca.ca_after_drop { check_move(a, ar, &tprog); check_escape(a, ar, &tprog); drop_insert(a, ar, &tprog); }
            let mut out = StringBuilder::with_capacity(a, 16384 as u32);
            dump_typed_ir(&tprog, ca.ca_input, ca.ca_user_only, &out);
            write_dump(ca.ca_output, &out);
        }
        | Result::Err(e) => { report_error(a, e); }
    }
    return;
}

// `<dir>` of a path — everything before the last `/`, or `.` if none.  The
// oracle adds `-I <dir>` so `@c_include("local.h")` resolves next to the source.
fn input_dir(ar: *Arena, path: str) -> str {
    let bytes = str::as_bytes(path);
    let n = str::length(path);
    let mut i = n;
    while i > 0 as u32 {
        if bytes[i - 1 as u32] == 47 as u8 {
            return str::from_slice(ar, bytes[0 as u32..i - 1 as u32]);
        }
        i = i - 1 as u32;
    }
    return ".";
}

// `<path>` without its extension — strip after the last `.` in the basename.
fn strip_ext(ar: *Arena, path: str) -> str {
    let bytes = str::as_bytes(path);
    let n = str::length(path);
    let mut i = n;
    while i > 0 as u32 {
        let c = bytes[i - 1 as u32];
        if c == 47 as u8 { break; }                                   // '/'
        if c == 46 as u8 { return str::from_slice(ar, bytes[0 as u32..i - 1 as u32]); }  // '.'
        i = i - 1 as u32;
    }
    return path;
}

// c_path = `--c-out`, else `<input>.c` — matching the oracle; the C is always a
// file (never stdout) on the transpile/build path.
fn resolve_cpath(a: Allocator, ar: *Arena, ca: *const CliArgs) -> str {
    let mut have = false;
    let mut r: str = "";
    match ca.ca_c_out {
        Option::Some(p) => { r = p; have = true; }
        | Option::None => { }
    }
    if have { return r; }
    let mut sb = StringBuilder::with_capacity(a, 64 as u32);
    sb.push_str(strip_ext(ar, ca.ca_input)); sb.push_str(".c");
    return str::from_slice(ar, sb.as_slice());
}

// binary path = `-o`, else `<input>` without extension — the oracle's default.
fn resolve_out(ar: *Arena, ca: *const CliArgs) -> str {
    let mut r = strip_ext(ar, ca.ca_input);
    match ca.ca_output {
        Option::Some(p) => { r = p; }
        | Option::None => { }
    }
    return r;
}

// `--target c`/`host`: full pipeline to C.  c goes to a file and reports
// `wrote`; host additionally cc-invokes that C into a binary.
fn run_codegen(a: Allocator, ar: *Arena, ca: *const CliArgs) {
    match load(a, ar, ca.ca_input) {
        Result::Ok(prog) => { run_codegen_checked(a, ar, ca, &prog); }
        | Result::Err(e) => { report_error(a, e); }
    }
    return;
}
fn run_codegen_checked(a: Allocator, ar: *Arena, ca: *const CliArgs, prog: *const Vec<Item>) {
    match check_program(a, ar, prog) {
        Result::Ok(tp) => {
            let mut tprog = tp;
            // The reference's order: Move.check -> Escape.check -> Drop.insert
            // -> Lint.lint.  Lint is not ported yet (Faza D).
            check_move(a, ar, &tprog);
            check_escape(a, ar, &tprog);
            drop_insert(a, ar, &tprog);
            let mut out = StringBuilder::with_capacity(a, 16384 as u32);
            gen_program(a, ar, &tprog, &out);
            let cpath = resolve_cpath(a, ar, ca);
            write_file(cpath, &out);
            emit_output(a, ar, ca, cpath);
        }
        | Result::Err(e) => { report_error(a, e); }
    }
    return;
}

// Transpile reports `wrote`; host hands the C to cc and reports `built`.
fn emit_output(a: Allocator, ar: *Arena, ca: *const CliArgs, cpath: str) {
    if ca.ca_target == 1 as int { build_host(a, ar, ca, cpath); return; }
    report_wrote(a, cpath);
    return;
}

// The cc argv — the SAME flags the oracle hands to Sys.command, but as a real
// argv (no shell, no quoting).  The flag DATA mirrors the oracle byte for byte;
// the PLUMBING (argv array vs shell string) is the driver-zone divergence, gated
// behaviorally, not by comparing a command string.
fn build_cc_argv(a: Allocator, ar: *Arena, ca: *const CliArgs, out: str, cpath: str) -> Vec<str> {
    let mut v: Vec<str> = Vec::with_capacity(a, 16 as u32);
    v.push("cc"); v.push("-ansi"); v.push("-pedantic"); v.push("-Wall");
    if !ca.ca_show_cc {
        v.push("-Wno-unused-variable");
        v.push("-Wno-unused-but-set-variable");
        v.push("-Wno-unused-function");
    }
    let dir = input_dir(ar, ca.ca_input);
    if !str::eq(dir, "") && !str::eq(dir, ".") { v.push("-I"); v.push(dir); }
    v.push("-o"); v.push(out); v.push(cpath);
    let links = ca.ca_links.as_slice();
    let mut i = 0 as u32;
    while i < ca.ca_links.length() { v.push(links[i]); i = i + 1 as u32; }
    return v;
}

fn build_host(a: Allocator, ar: *Arena, ca: *const CliArgs, cpath: str) {
    let out = resolve_out(ar, ca);
    let argv = build_cc_argv(a, ar, ca, out, cpath);
    let sl = argv.as_slice();
    let rc: c_int = sys::sys_spawn(&sl[0] as *const str, argv.length() as c_int);
    // cc failed — report and exit non-zero, like the oracle's `exit 1`.
    // sys_exit terminates, so report_built runs only on success.
    if rc != 0 as c_int { err_line("command failed: cc"); sys::sys_exit(1 as c_int); }
    report_built(a, out);
    return;
}

// move::check returns the FIRST diagnostic; report_error exits 1, so a rejected
// program never reaches escape, drop, or codegen.
fn check_move(a: Allocator, ar: *Arena, tprog: *Tprogram) {
    match move::check(a, ar, tprog) {
        Option::Some(e) => { report_error(a, e); }
        | Option::None => { }
    }
    return;
}

// escape::check returns the FIRST diagnostic (the reference raises on it).
// report_error exits 1, so a rejected program never reaches codegen.
fn check_escape(a: Allocator, ar: *Arena, tprog: *Tprogram) {
    match escape::check(a, ar, tprog) {
        Option::Some(e) => { report_error(a, e); }
        | Option::None => { }
    }
    return;
}

fn report_wrote(a: Allocator, cpath: str) {
    let mut sb = StringBuilder::with_capacity(a, 128 as u32);
    sb.push_str("wrote "); sb.push_str(cpath); sb.push_str(" [profile=full, target=c]\n");
    flush_stdout(&sb);
    return;
}
fn report_built(a: Allocator, out: str) {
    let mut sb = StringBuilder::with_capacity(a, 128 as u32);
    sb.push_str("built host binary: "); sb.push_str(out); sb.push_str(" [profile=full, target=host]\n");
    flush_stdout(&sb);
    return;
}

fn read_source(a: Allocator, ar: *Arena, path: str) -> str {
    // The lexer path needs the raw bytes; load() re-reads for the AST/IR paths.
    let fd: c_int = sys::sys_open(path as *const c_char, 0 as c_int);
    // Same contract as the loader: an unreadable input is an error, not an
    // empty program.  This path bypasses the loader, so it needs its own gate.
    if fd < 0 as c_int {
        let mut eb = StringBuilder::with_capacity(a, 64 as u32);
        eb.push_str("cannot read file: "); eb.push_str(path);
        report_error(a, error::alloc(ar, pos::Pos::zero(), str::from_slice(ar, eb.as_slice())));
        return "";
    }
    let mut sb = StringBuilder::with_capacity(a, 8192 as u32);
    let mut buf: [u8; 4096] = [0 as u8; 4096];
    loop {
        let n: c_long = sys::sys_read(fd, &buf as *u8 as *c_uchar, 4096 as c_ulong);
        if n <= 0 as c_long { break; }
        let mut k = 0 as u32;
        while k < n as u32 { sb.push_byte(buf[k]); k = k + 1 as u32; }
    }
    sys::sys_close(fd);
    return str::from_slice(ar, sb.as_slice());
}

fn main() {
    let a = default_allocator();
    let ca = parse_cli(a);
    // A rejected command line ends non-zero, like the reference: usage and
    // unknown-flag errors were reported on stderr and then exited 0.
    if !ca.ca_ok { sys::sys_exit(1 as c_int); }

    let mut ar = Arena::with_capacity(a, arena_cap_for(total_source_bytes(a, ca.ca_input)));

    if ca.ca_emit == 1 as int { run_emit_tokens(a, &ar, &ca); }
    else if ca.ca_emit == 2 as int { run_emit_ast(a, &ar, &ca); }
    else if ca.ca_emit == 3 as int { run_emit_ir(a, &ar, &ca); }
    else { run_codegen(a, &ar, &ca); }
}
