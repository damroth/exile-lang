// Self-host escape — the DR-010 escape-pass verification driver.
//
// Read a source path on stdin, lex / parse / type-check it, run `Move.check`'s
// position in the pipeline (the port's move pass is a pure checker and elides
// diagnostics, so nothing to call), then the ported `Escape.check`.
//
// The escape pass emits no output — its entire observable behaviour is its
// diagnostics.  So the driver prints the FIRST diagnostic in the oracle's
// `show_error` first-line format, or "escape: ok" when the program is clean.
// Diffing that against the oracle (which raises the same error from the same
// pipeline slot) is the pass's differential gate, both ways: every corpus
// example must stay clean, and every negative probe must produce a byte-equal
// message.

use pos;
use token::*;
use lexer::*;
use ast::*;
use ir::*;
use error::*;
use parser::*;
use loader::*;
use typecheck::*;
use escape::*;

fn read_all(fd: c_int, sb: *StringBuilder) {
    let mut buf: [u8; 4096] = [0 as u8; 4096];
    loop {
        let n: c_long = sys::sys_read(fd, &buf as *u8 as *c_uchar, 4096 as c_ulong);
        if n <= 0 as c_long { break; }
        let mut k = 0 as u32;
        while k < n as u32 {
            sb.push_byte(buf[k]);
            k = k + 1 as u32;
        }
    }
}

fn path_len(sl: Slice<u8>, n: u32) -> u32 {
    let mut end = n;
    while end > 0 as u32
          && (sl[end - 1 as u32] == 10 as u8 || sl[end - 1 as u32] == 13 as u8) {
        end = end - 1 as u32;
    }
    return end;
}

fn emit(_a: Allocator, sb: *const StringBuilder) {
    let bytes = sb.as_slice();
    sys::sys_write(1 as c_int, &bytes[0] as *const c_uchar, sb.length() as c_ulong);
}

fn report_error(a: Allocator, e: *const CompileError) {
    let mut sb = StringBuilder::with_capacity(a, 256 as u32);
    e.fmt(&sb);
    sb.push_str("\n");
    emit(a, &sb);
}

fn report_ok(a: Allocator) {
    let mut sb = StringBuilder::with_capacity(a, 16 as u32);
    sb.push_str("escape: ok\n");
    emit(a, &sb);
}

fn arena_cap_for(srclen: u32) -> u32 {
    return 1048576 as u32 + srclen * 128 as u32;
}

fn run_escape(a: Allocator, ar: *Arena, tp: *const Tprogram) {
    match check(a, ar, tp) {
        Option::Some(e) => { report_error(a, e); }
        | Option::None => { report_ok(a); }
    }
}

fn main() {
    let a = default_allocator();

    let mut pbuf = StringBuilder::with_capacity(a, 256 as u32);
    read_all(0 as c_int, &pbuf);
    let plen = path_len(pbuf.as_slice(), pbuf.length());
    let mut parena = Arena::with_capacity(a, 1024 as u32);
    let path = str::from_slice(&parena, pbuf.as_slice()[0 as u32..plen]);

    let fd: c_int = sys::sys_open(path as *const c_char, 0 as c_int);
    if fd < 0 as c_int { return; }
    sys::sys_close(fd);

    let mut ar = Arena::with_capacity(a, arena_cap_for(total_source_bytes(a, path)));

    match load(a, &ar, path) {
        Result::Ok(prog) => {
            match check_program(a, &ar, &prog) {
                Result::Ok(tp) => { run_escape(a, &ar, &tp); }
                | Result::Err(e) => { report_error(a, e); }
            }
        }
        | Result::Err(e) => { report_error(a, e); }
    }
}
