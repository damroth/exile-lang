// Self-host port — `lib/codegen.ml` (+ the C-rendering utilities that live in
// `lib/ir.ml`: mangle_typ / c_type_prefix / c_decl).
//
// The final pass: typed-IR (post Move / Escape / Drop) -> C89 text.  This file
// is filled in STAGE by stage, mirroring how typecheck was sub-staged:
//   (a) type rendering    — mangle_typ / c_type_prefix / c_decl  [THIS STAGE]
//   (b) aggregate typedefs — struct / enum / tuple / array decls, topo-sorted
//   (c) gen_expr           — expression -> C
//   (d) stmt / block / if  — statement -> C
//   (e) emit_match_stmt    — match -> C (the gnarliest, ~400 LOC)
//   (f) gen_function       — signature + body
//   (g) gen_program        — includes / sections / DCE / footer
//   (h) @debug printers / default_allocator / builtin emitters
//
// The differential is the emitted C compared byte-for-byte against the oracle's
// `--c-out`; a `codegen_corpus.exl` driver runs the pipeline and flushes C to
// stdout, the same playbook that drove the tc and drop layers.

use ast::*;
use ir::*;
use error::*;

// ===== Stage (a): type rendering =====

// `i32` / `u16` / ... — the fixed-width integer mangled name.

// A named-type C symbol: top-level `name` -> `ex_name`, a module-nested path
// `["parser","Deco"]` -> `parser__Deco` (segments joined by `__`).
fn mangle_name(a: Allocator, ar: *Arena, path: *const Vec<str>, name: str) -> str {
    if path.length() == 0 as u32 {
        let mut eb = StringBuilder::with_capacity(a, 16 as u32);
        eb.push_str("ex_");
        eb.push_str(name);
        return str::from_slice(ar, eb.as_slice());
    }
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    let sl = path.as_slice();
    let mut i = 0 as u32;
    while i < path.length() { sb.push_str(sl[i]); sb.push_str("__"); i = i + 1 as u32; }
    sb.push_str(name);
    return str::from_slice(ar, sb.as_slice());
}

// Split any colon-joined path segment so `["pos::Pos"]` becomes `["pos","Pos"]`.
// The port's typed-IR stores a module type path colon-joined in the struct/enum
// index but the oracle mangles from the split form; normalising here keeps the
// C symbol (`pos__Pos`, not `pos::Pos`) byte-identical.
fn split_colons(a: Allocator, ar: *Arena, path: *const Vec<str>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let sl = path.as_slice();
    let mut i = 0 as u32;
    while i < path.length() {
        let seg = sl[i];
        let bytes = str::as_bytes(seg);
        let n = str::length(seg);
        let mut start = 0 as u32;
        let mut j = 0 as u32;
        while j < n {
            if j + 1 as u32 < n && bytes[j] == 58 as u8 && bytes[j + 1 as u32] == 58 as u8 {
                if j > start { out.push(str::from_slice(ar, bytes[start..j])); }
                j = j + 2 as u32;
                start = j;
            } else {
                j = j + 1 as u32;
            }
        }
        if n > start { out.push(str::from_slice(ar, bytes[start..n])); }
        i = i + 1 as u32;
    }
    return out;
}

// A named-type path `["a","b","Name"]` splits into the module prefix `["a","b"]`
// and the final `Name`, then mangles as `a__b__Name`.
fn mangle_named_path(a: Allocator, ar: *Arena, path0: *const Vec<str>) -> str {
    let path = split_colons(a, ar, path0);
    let n = path.length();
    if n == 0 as u32 { return "ex_"; }
    let sl = path.as_slice();
    let name = sl[n - 1 as u32];
    let mut prefix: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut i = 0 as u32;
    while i < n - 1 as u32 { prefix.push(sl[i]); i = i + 1 as u32; }
    return mangle_name(a, ar, &prefix, name);
}

// The C-identifier-safe mangle of a type (used to build emitted C symbol
// names).  Distinct from `typ_name`, which reproduces source syntax for
// diagnostics.  `TVar` / `TStructApp` / `TEnumApp` / `TAssocProj` / `TNullPtr`
// are pre-mono / never-mangled: reaching this function with one is a compiler bug,
// so it aborts (`ice`) rather than emitting a marker that would look like output.
pub fn mangle_typ(a: Allocator, ar: *Arena, t: *const Typ) -> str {
    return match *t {
        Typ::TInt(k) => int_typ_name(k.is_signed, k.width)
        | Typ::TCInt { is_signed } => { if is_signed { "cint" } else { "cuint" } }
        | Typ::TCShort { is_signed } => { if is_signed { "cshort" } else { "cushort" } }
        | Typ::TCLong { is_signed } => { if is_signed { "clong" } else { "culong" } }
        | Typ::TCChar => "cchar"
        | Typ::TCSChar => "cschar"
        | Typ::TCUChar => "cuchar"
        | Typ::TCVoid => "cvoid"
        | Typ::TBool => "bool"
        | Typ::TFloat(w) => { match w { FloatWidth::F32 => "f32" | FloatWidth::F64 => "f64" } }
        | Typ::TString => "str"
        | Typ::TTuple(ts) => {
            let mut tb = StringBuilder::with_capacity(a, 32 as u32);
            tb.push_str("tup");
            tb.push_int(ts.length() as int);
            let sl = ts.as_slice();
            let mut ti = 0 as u32;
            while ti < ts.length() { tb.push_str("_"); tb.push_str(mangle_typ(a, ar, sl[ti])); ti = ti + 1 as u32; }
            str::from_slice(ar, tb.as_slice())
        }
        | Typ::TStruct(path) => mangle_named_path(a, ar, &path)
        | Typ::TEnum(path) => mangle_named_path(a, ar, &path)
        | Typ::TExtStruct(n) => n
        | Typ::TExtAlias(n) => n
        | Typ::TPtr(inner) => concat2(a, ar, "ptr_", mangle_typ(a, ar, inner))
        | Typ::TOwnPtr(inner) => concat2(a, ar, "ownptr_", mangle_typ(a, ar, inner))
        | Typ::TConstPtr(inner) => concat2(a, ar, "cptr_", mangle_typ(a, ar, inner))
        | Typ::TRune { elem, dir } => concat2(a, ar, "rune_", mangle_typ(a, ar, elem))
        | Typ::TArray { elem, size } => {
            let mut arb = StringBuilder::with_capacity(a, 24 as u32);
            arb.push_str("arr");
            arb.push_int(size);
            arb.push_str("_");
            arb.push_str(mangle_typ(a, ar, elem));
            str::from_slice(ar, arb.as_slice())
        }
        | Typ::TFnPtr { params, ret } => {
            let mut fb = StringBuilder::with_capacity(a, 32 as u32);
            fb.push_str("fn");
            fb.push_int(params.length() as int);
            fb.push_str("_");
            let psl = params.as_slice();
            let mut fi = 0 as u32;
            while fi < params.length() { if fi > 0 as u32 { fb.push_str("_"); } fb.push_str(mangle_typ(a, ar, psl[fi])); fi = fi + 1 as u32; }
            fb.push_str("_to_");
            match ret { Option::Some(rt) => fb.push_str(mangle_typ(a, ar, rt)) | Option::None => fb.push_str("void") }
            str::from_slice(ar, fb.as_slice())
        }
        | _other => { ice("internal: no C mangling for this IR type"); "" }
    };
}

// `ex_tupN_...` — the C struct name of a tuple shape.
pub fn tuple_struct_name(a: Allocator, ar: *Arena, ts: *const Vec<*const Typ>) -> str {
    let tt = ty_node(ar, Typ::TTuple(copy_typs(a, ts)));
    return concat2(a, ar, "ex_", mangle_typ(a, ar, tt));
}

fn concat2(a: Allocator, ar: *Arena, x: str, y: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(x);
    sb.push_str(y);
    return str::from_slice(ar, sb.as_slice());
}

fn copy_typs(a: Allocator, src: *const Vec<*const Typ>) -> Vec<*const Typ> {
    let mut out: Vec<*const Typ> = Vec::with_capacity(a, 8 as u32);
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < src.length() { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}

fn ty_node(ar: *Arena, node: Typ) -> *const Typ {
    let n: *Typ = ar.alloc_borrowed();
    if n == null { arena_oom(); }
    *n = node;
    return n as *const Typ;
}

// Drop a single trailing space so `c_decl prefix name` reads `<base> *name`.
fn strip_trailing_space(ar: *Arena, s: str) -> str {
    let n = str::length(s);
    if n > 0 as u32 {
        let bytes = str::as_bytes(s);
        if bytes[n - 1 as u32] == 32 as u8 {
            return str::from_slice(ar, bytes[0 as u32..n - 1 as u32]);
        }
    }
    return s;
}

fn str_starts_with_const(s: str) -> bool {
    let n = str::length(s);
    if n < 6 as u32 { return false; }
    let b = str::as_bytes(s);
    // "const "
    return b[0 as u32] == 99 as u8 && b[1 as u32] == 111 as u8 && b[2 as u32] == 110 as u8
        && b[3 as u32] == 115 as u8 && b[4 as u32] == 116 as u8 && b[5 as u32] == 32 as u8;
}

// The C declaration prefix for a type — width-variable c_* map to the target's
// native int/short/long; fixed i32/u32 map to `long` for cross-compiler width
// stability (C89 only guarantees int>=16, long>=32).  Own/const pointers erase
// entirely (ownership lives in the checker, not the C type).
pub fn c_type_prefix(a: Allocator, ar: *Arena, t: *const Typ) -> str {
    return match *t {
        Typ::TCInt { is_signed } => { if is_signed { "int " } else { "unsigned int " } }
        | Typ::TCShort { is_signed } => { if is_signed { "short " } else { "unsigned short " } }
        | Typ::TCLong { is_signed } => { if is_signed { "long " } else { "unsigned long " } }
        | Typ::TCChar => "char "
        | Typ::TCSChar => "signed char "
        | Typ::TCUChar => "unsigned char "
        // Naked `c_void` has no C spelling — only `*c_void` does, and that goes
        // through c_ptr_prefix.  The reference asserts here for the same reason.
        | Typ::TCVoid => { ice("internal: naked c_void reached c_type_prefix — only *c_void is allowed; typecheck should have caught this"); "" }
        | Typ::TInt(k) => {
            let s = if k.is_signed { "" } else { "unsigned " };
            let core = match k.width { IntWidth::W8 => "char" | IntWidth::W16 => "short" | IntWidth::W32 => "long" };
            let signed_core = if k.is_signed { match k.width { IntWidth::W8 => "signed char " | _o => concat2(a, ar, core, " ") } } else { concat2(a, ar, core, " ") };
            concat2(a, ar, s, signed_core)
        }
        | Typ::TBool => "int "
        | Typ::TFloat(w) => { match w { FloatWidth::F32 => "float " | FloatWidth::F64 => "double " } }
        | Typ::TString => "const char *"
        | Typ::TTuple(ts) => concat3(a, ar, "struct ", tuple_struct_name(a, ar, &ts), " ")
        | Typ::TStruct(_p) => concat3(a, ar, "struct ", mangle_typ(a, ar, t), " ")
        | Typ::TEnum(_p) => concat3(a, ar, "struct ", mangle_typ(a, ar, t), " ")
        | Typ::TExtStruct(n) => concat3(a, ar, "struct ", n, " ")
        | Typ::TExtAlias(n) => concat2(a, ar, n, " ")
        | Typ::TArray { elem: _e, size: _s } => concat3(a, ar, "struct ex_", mangle_typ(a, ar, t), " ")
        | Typ::TPtr(inner) => c_ptr_prefix(a, ar, inner, false)
        | Typ::TOwnPtr(inner) => c_ptr_prefix(a, ar, inner, false)
        | Typ::TConstPtr(inner) => c_ptr_prefix(a, ar, inner, true)
        | Typ::TRune { elem, dir } => c_rune_prefix(a, ar, elem)
        | Typ::TFnPtr { params: _p, ret: _r } => concat2(a, ar, mangle_typ(a, ar, t), " ")
        // `null` has no C spelling: it is the type of the literal, always consumed
        // under a concrete pointer.  Reaching here means typecheck let it through —
        // a compiler bug, not a user error, so say so instead of emitting `<ctype?>`
        // and letting `cc` produce the confusing message.
        | _other => { ice("internal: no C type for this IR type (typecheck should have rejected it)"); "" }
    };
}

// Shared pointer rendering.  `*c_void` -> `void *` (or `const void *`);
// otherwise `<base> *`, with a single `const ` for const pointers (skipped
// when the base already renders const, e.g. `str` = `const char *`).
fn c_ptr_prefix(a: Allocator, ar: *Arena, inner: *const Typ, is_const: bool) -> str {
    let is_void = match *inner { Typ::TCVoid => true | _o => false };
    if is_void {
        if is_const { return "const void *"; }
        return "void *";
    }
    let inner_c = strip_trailing_space(ar, c_type_prefix(a, ar, inner));
    if is_const {
        if str_starts_with_const(inner_c) { return concat2(a, ar, inner_c, " *"); }
        return concat3(a, ar, "const ", inner_c, " *");
    }
    return concat2(a, ar, inner_c, " *");
}

// A rune lowers to a pointer whose POINTEE is volatile — `volatile <T> *`
// The volatile qualifier IS the guarantee: a store
// through this pointer is a volatile access the backend may not elide or
// reorder.  Ownership/direction are erased; only volatile survives into C.
fn c_rune_prefix(a: Allocator, ar: *Arena, elem: *const Typ) -> str {
    return concat2(a, ar, "volatile ", c_ptr_prefix(a, ar, rune_ptr_pointee(elem), false));
}

fn concat3(a: Allocator, ar: *Arena, x: str, y: str, z: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(x);
    sb.push_str(y);
    sb.push_str(z);
    return str::from_slice(ar, sb.as_slice());
}

// `c_decl t name` = the full declarator, `<prefix>name`.
pub fn c_decl(a: Allocator, ar: *Arena, t: *const Typ, name: str) -> str {
    return concat2(a, ar, c_type_prefix(a, ar, t), name);
}

// ===== Stage (b): aggregate typedefs (struct / enum / tuple / array) =====
//
// Every C-level typedef the program needs, topologically ordered so each
// precedes any other that embeds it BY VALUE (struct field / tuple element /
// array element).  Ordering stops at pointers and fn-ptrs (a `*T` field needs
// only a forward name, satisfied by C's incomplete-type rule).  Generic decls
// (any field carrying a TVar) are skipped — the monomorphiser emits concrete
// instances.

// No TVar anywhere in the type — the codegen concreteness filter.
fn is_concrete(t: *const Typ) -> bool {
    return match *t {
        Typ::TVar(_n) => false
        | Typ::TPtr(i) => is_concrete(i)
        | Typ::TOwnPtr(i) => is_concrete(i)
        | Typ::TConstPtr(i) => is_concrete(i)
        | Typ::TTuple(ts) => all_concrete(&ts)
        | Typ::TArray { elem, size } => is_concrete(elem)
        | Typ::TFnPtr { params, ret } => all_concrete(&params) && match ret { Option::Some(rt) => is_concrete(rt) | Option::None => true }
        | Typ::TStructApp { path, args } => all_concrete(&args)
        | Typ::TEnumApp { path, args } => all_concrete(&args)
        | Typ::TAssocProj { head, assoc } => is_concrete(head)
        | _other => true
    };
}
fn all_concrete(ts: *const Vec<*const Typ>) -> bool {
    let sl = ts.as_slice();
    let mut i = 0 as u32;
    while i < ts.length() { if !is_concrete(sl[i]) { return false; } i = i + 1 as u32; }
    return true;
}
fn fields_concrete(fs: *const Vec<FieldTy>) -> bool {
    let sl = fs.as_slice();
    let mut i = 0 as u32;
    while i < fs.length() { if !is_concrete(sl[i].ty) { return false; } i = i + 1 as u32; }
    return true;
}

// `struct <cname> { <c_decl>; <c_decl>; };` on one line.
fn emit_struct_decl(a: Allocator, ar: *Arena, out: *StringBuilder, cname: str, fields: *const Vec<FieldTy>) {
    out.push_str("struct ");
    out.push_str(cname);
    out.push_str(" {");
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < fields.length() {
        out.push_str(" ");
        out.push_str(c_decl(a, ar, sl[i].ty, sl[i].name));
        out.push_str(";");
        i = i + 1 as u32;
    }
    out.push_str(" };\n");
}

fn emit_named_struct(a: Allocator, ar: *Arena, out: *StringBuilder, s: *const StructSig) {
    let cname = mangle_typ(a, ar, ty_node(ar, Typ::TStruct(copy_strs_cg(a, &s.sname_path))));
    emit_struct_decl(a, ar, out, cname, &s.sfields_ty);
}

// Tuple wrapper `struct ex_tupN_... { T _0; T _1; };`.
fn emit_tuple_struct(a: Allocator, ar: *Arena, out: *StringBuilder, ty: *const Typ) {
    match *ty {
        Typ::TTuple(ts) => {
            let mut fields: Vec<FieldTy> = Vec::with_capacity(a, 8 as u32);
            let sl = ts.as_slice();
            let mut i = 0 as u32;
            while i < ts.length() {
                let mut nb = StringBuilder::with_capacity(a, 8 as u32);
                nb.push_str("_");
                nb.push_int(i as int);
                fields.push(FieldTy { name: str::from_slice(ar, nb.as_slice()), ty: sl[i] });
                i = i + 1 as u32;
            }
            emit_struct_decl(a, ar, out, tuple_struct_name(a, ar, &ts), &fields);
        }
        | _o => {}
    }
}

// Array wrapper `struct ex_arrN_T { T data[N]; };`.
fn emit_array_struct(a: Allocator, ar: *Arena, out: *StringBuilder, ty: *const Typ) {
    match *ty {
        Typ::TArray { elem, size } => {
            out.push_str("struct ex_");
            out.push_str(mangle_typ(a, ar, ty));
            out.push_str(" { ");
            out.push_str(c_decl(a, ar, elem, "data"));
            out.push_str("[");
            out.push_int(size);
            out.push_str("]; };\n");
        }
        | _o => {}
    }
}

// Tag enum + wrapper struct; a `union data` of per-variant inner structs when
// any variant carries payload (unit variants stay out of the union — C89
// forbids empty structs).
fn emit_named_enum(a: Allocator, ar: *Arena, out: *StringBuilder, e: *const EnumSig) {
    let cname = mangle_typ(a, ar, ty_node(ar, Typ::TEnum(copy_strs_cg(a, &e.ename_path))));
    out.push_str("enum ");
    out.push_str(cname);
    out.push_str("_tag {");
    let vs = e.evariants.as_slice();
    let mut i = 0 as u32;
    while i < e.evariants.length() {
        if i > 0 as u32 { out.push_str(","); }
        out.push_str(" ");
        out.push_str(cname);
        out.push_str("_");
        out.push_str(vs[i].vsname);
        i = i + 1 as u32;
    }
    out.push_str(" };\n");
    out.push_str("struct ");
    out.push_str(cname);
    out.push_str(" { enum ");
    out.push_str(cname);
    out.push_str("_tag tag;");
    let mut has_payload = false;
    let mut j = 0 as u32;
    while j < e.evariants.length() { if vs[j].vsfields.length() > 0 as u32 { has_payload = true; } j = j + 1 as u32; }
    if has_payload {
        out.push_str(" union {");
        let mut k = 0 as u32;
        while k < e.evariants.length() {
            if vs[k].vsfields.length() > 0 as u32 {
                out.push_str(" struct {");
                let fsl = vs[k].vsfields.as_slice();
                let mut f = 0 as u32;
                while f < vs[k].vsfields.length() {
                    out.push_str(" ");
                    out.push_str(c_decl(a, ar, fsl[f].ty, fsl[f].name));
                    out.push_str(";");
                    f = f + 1 as u32;
                }
                out.push_str(" } ");
                out.push_str(vs[k].vsname);
                out.push_str(";");
            }
            k = k + 1 as u32;
        }
        out.push_str(" } data;");
    }
    out.push_str(" };\n");
}

fn copy_strs_cg(a: Allocator, src: *const Vec<str>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < src.length() { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}

// The unified aggregate view for topo-ordered emission.  Structs / enums are
// referenced by pointer into the program's indices (avoids copying their
// owned Vec fields); tuples / arrays carry their mangled name + shape.
enum Agg {
    AStruct(*const StructSig)
    | AEnum(*const EnumSig)
    | ATuple { aname: str, aty: *const Typ }
    | AArray { aname: str, aty: *const Typ }
}

fn agg_cname(a: Allocator, ar: *Arena, agg: *const Agg) -> str {
    return match *agg {
        Agg::AStruct(s) => mangle_typ(a, ar, ty_node(ar, Typ::TStruct(copy_strs_cg(a, &s.sname_path))))
        | Agg::AEnum(e) => mangle_typ(a, ar, ty_node(ar, Typ::TEnum(copy_strs_cg(a, &e.ename_path))))
        | Agg::ATuple { aname, aty } => concat2(a, ar, "ex_", mangle_typ(a, ar, aty))
        | Agg::AArray { aname, aty } => concat2(a, ar, "ex_", mangle_typ(a, ar, aty))
    };
}

// C struct names this type embeds BY VALUE (stops at pointers / fn-ptrs).
fn value_agg_keys(a: Allocator, ar: *Arena, t: *const Typ, out: *Vec<str>) {
    match *t {
        Typ::TStruct(_p) => out.push(mangle_typ(a, ar, t))
        | Typ::TEnum(_p) => out.push(mangle_typ(a, ar, t))
        | Typ::TTuple(ts) => {
            out.push(concat2(a, ar, "ex_", mangle_typ(a, ar, t)));
            let sl = ts.as_slice();
            let mut i = 0 as u32;
            while i < ts.length() { value_agg_keys(a, ar, sl[i], out); i = i + 1 as u32; }
        }
        | Typ::TArray { elem, size } => {
            out.push(concat2(a, ar, "ex_", mangle_typ(a, ar, t)));
            value_agg_keys(a, ar, elem, out);
        }
        | _o => {}
    }
}

fn agg_deps(a: Allocator, ar: *Arena, agg: *const Agg) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 8 as u32);
    match *agg {
        Agg::AStruct(s) => {
            let ssl = s.sfields_ty.as_slice();
            let mut si = 0 as u32;
            while si < s.sfields_ty.length() { value_agg_keys(a, ar, ssl[si].ty, &out); si = si + 1 as u32; }
        }
        | Agg::AEnum(e) => {
            let vs = e.evariants.as_slice();
            let mut ei = 0 as u32;
            while ei < e.evariants.length() {
                let fsl = vs[ei].vsfields.as_slice();
                let mut f = 0 as u32;
                while f < vs[ei].vsfields.length() { value_agg_keys(a, ar, fsl[f].ty, &out); f = f + 1 as u32; }
                ei = ei + 1 as u32;
            }
        }
        | Agg::ATuple { aname, aty } => {
            match *aty { Typ::TTuple(ts) => { let tsl = ts.as_slice(); let mut ti = 0 as u32; while ti < ts.length() { value_agg_keys(a, ar, tsl[ti], &out); ti = ti + 1 as u32; } } | _o => {} }
        }
        | Agg::AArray { aname, aty } => {
            match *aty { Typ::TArray { elem, size } => value_agg_keys(a, ar, elem, &out) | _o => {} }
        }
    }
    return out;
}

fn emit_agg(a: Allocator, ar: *Arena, out: *StringBuilder, agg: *const Agg) {
    match *agg {
        Agg::AStruct(s) => emit_named_struct(a, ar, out, s)
        | Agg::AEnum(e) => emit_named_enum(a, ar, out, e)
        | Agg::ATuple { aname, aty } => emit_tuple_struct(a, ar, out, aty)
        | Agg::AArray { aname, aty } => emit_array_struct(a, ar, out, aty)
    }
}

// Each aggregate's C name, computed ONCE.  `agg_cname` arena-allocates a Typ
// node to mangle through, so recomputing it inside the DFS's per-dependency
// lookup was quadratic in arena bytes — enough to exhaust the arena (and then
// write through the null it returns) when the port compiles its own parser.
fn agg_cnames(a: Allocator, ar: *Arena, aggs: *const Vec<Agg>) -> Vec<str> {
    let mut out: Vec<str> = Vec::with_capacity(a, 16 as u32);
    let sl = aggs.as_slice();
    let mut i = 0 as u32;
    while i < aggs.length() { out.push(agg_cname(a, ar, &sl[i])); i = i + 1 as u32; }
    return out;
}
fn agg_index_by_key(names: *const Vec<str>, key: str) -> int {
    let sl = names.as_slice();
    let mut i = 0 as u32;
    while i < names.length() { if str::eq(sl[i], key) { return i as int; } i = i + 1 as u32; }
    return 0 - 1;
}

// DFS on the input list in source order, recursing into each entry's value
// deps first (post-order emit); `done` dedups.  Deps not in the list are
// primitives / externs / fn-ptrs and skip.
fn visit_agg(a: Allocator, ar: *Arena, out: *StringBuilder, aggs: *const Vec<Agg>, names: *const Vec<str>, idx: u32, done: *Vec<str>) {
    let sl = aggs.as_slice();
    let key = names.as_slice()[idx];
    if str_in_cg(done, key) { return; }
    done.push(key);
    let deps = agg_deps(a, ar, &sl[idx]);
    let dsl = deps.as_slice();
    let mut i = 0 as u32;
    while i < deps.length() {
        let di = agg_index_by_key(names, dsl[i]);
        if di >= 0 as int { visit_agg(a, ar, out, aggs, names, di as u32, done); }
        i = i + 1 as u32;
    }
    emit_agg(a, ar, out, &sl[idx]);
}

fn str_in_cg(v: *const Vec<str>, s: str) -> bool {
    let sl = v.as_slice();
    let mut i = 0 as u32;
    while i < v.length() { if str::eq(sl[i], s) { return true; } i = i + 1 as u32; }
    return false;
}

fn emit_aggs_topo(a: Allocator, ar: *Arena, out: *StringBuilder, aggs: *const Vec<Agg>) {
    let names = agg_cnames(a, ar, aggs);
    let mut done: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut i = 0 as u32;
    while i < aggs.length() { visit_agg(a, ar, out, aggs, &names, i, &done); i = i + 1 as u32; }
}

// fn-ptr typedef: `typedef <r>(*<name>)(<ps>);`.
fn emit_fnptr_typedef(a: Allocator, ar: *Arena, out: *StringBuilder, name: str, t: *const Typ) {
    match *t {
        Typ::TFnPtr { params, ret } => {
            out.push_str("typedef ");
            match ret { Option::Some(rt) => out.push_str(c_type_prefix(a, ar, rt)) | Option::None => out.push_str("void ") }
            out.push_str("(*");
            out.push_str(name);
            out.push_str(")(");
            if params.length() == 0 as u32 {
                out.push_str("void");
            } else {
                let sl = params.as_slice();
                let mut i = 0 as u32;
                while i < params.length() {
                    if i > 0 as u32 { out.push_str(", "); }
                    out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, sl[i])));
                    i = i + 1 as u32;
                }
            }
            out.push_str(");\n");
        }
        | _o => {}
    }
}

// Stage-(b) entry: the fn-ptr typedefs + topo-ordered aggregate typedefs.  The
// concreteness filter drops generic skeletons; struct / enum indices seed the
// aggregate list in source order (tuples then arrays after).
pub fn emit_type_decls(a: Allocator, ar: *Arena, tp: *const Tprogram, out: *StringBuilder) {
    let fpt = tp.tp_fnptr_types.as_slice();
    if tp.tp_fnptr_types.length() > 0 as u32 { out.push_str("\n"); }
    let mut i = 0 as u32;
    while i < tp.tp_fnptr_types.length() { emit_fnptr_typedef(a, ar, out, mangle_typ(a, ar, fpt[i].ty), fpt[i].ty); i = i + 1 as u32; }

    let mut aggs: Vec<Agg> = Vec::with_capacity(a, 8 as u32);
    let ssl = tp.tp_struct_index.as_slice();
    let mut si = 0 as u32;
    while si < tp.tp_struct_index.length() {
        if fields_concrete(&ssl[si].sfields_ty) { aggs.push(Agg::AStruct(&ssl[si])); }
        si = si + 1 as u32;
    }
    let esl = tp.tp_enum_index.as_slice();
    let mut ei = 0 as u32;
    while ei < tp.tp_enum_index.length() {
        if enum_concrete(&esl[ei]) { aggs.push(Agg::AEnum(&esl[ei])); }
        ei = ei + 1 as u32;
    }
    let tsl = tp.tp_tuple_types.as_slice();
    let mut ti = 0 as u32;
    while ti < tp.tp_tuple_types.length() { aggs.push(Agg::ATuple { aname: tsl[ti].name, aty: tsl[ti].ty }); ti = ti + 1 as u32; }
    let asl = tp.tp_array_types.as_slice();
    let mut ai = 0 as u32;
    while ai < tp.tp_array_types.length() { aggs.push(Agg::AArray { aname: asl[ai].name, aty: asl[ai].ty }); ai = ai + 1 as u32; }

    if aggs.length() > 0 as u32 { out.push_str("\n"); }
    emit_aggs_topo(a, ar, out, &aggs);
}

fn enum_concrete(e: *const EnumSig) -> bool {
    let vs = e.evariants.as_slice();
    let mut i = 0 as u32;
    while i < e.evariants.length() { if !fields_concrete(&vs[i].vsfields) { return false; } i = i + 1 as u32; }
    return true;
}

// ===== Stage (c): gen_expr — expression -> C =====
//
// Block-shaped expressions (tuple/struct/new/enum-lit/match/if-expr/array
// lit/repeat/block) never reach here: the typecheck lift pass hoisted them to
// `__lift_N` temps.  TBuiltinCall dispatches to the builtin emitters (stage h);
// TFloatLit's decimal-round-trip value format is deferred (same as the typed-IR
// dump) — the self-host source is integer-only so no literal reaches codegen.

fn prec(op: BinOp) -> int {
    return match op {
        BinOp::Mul => 10 | BinOp::Div => 10 | BinOp::Mod => 10
        | BinOp::Add => 9 | BinOp::Sub => 9
        | BinOp::Shl => 8 | BinOp::Shr => 8
        | BinOp::Lt => 7 | BinOp::Gt => 7 | BinOp::LtEq => 7 | BinOp::GtEq => 7
        | BinOp::EqEq => 6 | BinOp::NotEq => 6
        | BinOp::BitAnd => 5
        | BinOp::BitXor => 4
        | BinOp::BitOr => 3
        | BinOp::And => 2
        | BinOp::Or => 1
        | BinOp::Concat => 0
    };
}

fn binop_str(op: BinOp) -> str {
    return match op {
        BinOp::Add => " + " | BinOp::Sub => " - " | BinOp::Mul => " * "
        | BinOp::Div => " / " | BinOp::Mod => " % "
        | BinOp::BitAnd => " & " | BinOp::BitOr => " | " | BinOp::BitXor => " ^ "
        | BinOp::Shl => " << " | BinOp::Shr => " >> "
        | BinOp::And => " && " | BinOp::Or => " || "
        | BinOp::Lt => " < " | BinOp::Gt => " > "
        | BinOp::LtEq => " <= " | BinOp::GtEq => " >= "
        | BinOp::EqEq => " == " | BinOp::NotEq => " != "
        // `++` is constant-folded to a string literal during typecheck; a
        // TBinOp(Concat) in the IR means the fold did not happen.
        | BinOp::Concat => { ice("internal: `++` reached codegen — it is folded to a string literal at typecheck"); "" }
    };
}

// `a - (b - c)` / `/` / `%` / `<<` / `>>` change meaning without parens on a
// same-precedence right operand; commutative ops are exempt.
fn is_left_assoc(op: BinOp) -> bool {
    return match op {
        BinOp::Sub => true | BinOp::Div => true | BinOp::Mod => true
        | BinOp::Shl => true | BinOp::Shr => true | _o => false
    };
}

// `-Wparentheses` fires (Wall) on `&&` under `||` and on `+`/`-` under a
// bitwise op even where C precedence is unambiguous — paren those children.
fn nest_warn(op: BinOp, child: BinOp) -> bool {
    let child_and = match child { BinOp::And => true | _o => false };
    let child_addsub = match child { BinOp::Add => true | BinOp::Sub => true | _o => false };
    // Register #7: a bitwise or shift operand under a bitwise parent of DIFFERENT
    // precedence. gcc warns there too — `SETCLR | (old & BLTEN)`, the shape a
    // driver writes constantly, emitted unparenthesised and failed -Werror.
    // CANONICAL rather than source-driven: the source's own parentheses are not
    // recorded in the AST, and emission should follow what C needs rather than
    // how the program happened to be formatted.
    let child_bits = match child {
        BinOp::BitAnd => true | BinOp::BitOr => true | BinOp::BitXor => true
        | BinOp::Shl => true | BinOp::Shr => true | _o => false
    };
    let mixed = child_bits && prec(op) != prec(child);
    return match op {
        BinOp::Or => child_and
        | BinOp::BitAnd => child_addsub || mixed
        | BinOp::BitOr => child_addsub || mixed
        | BinOp::BitXor => child_addsub || mixed
        | BinOp::Shl => child_addsub
        | BinOp::Shr => child_addsub
        | _o => false
    };
}

fn lvalue_like(n: *const TexprNode) -> bool {
    return match *n { TexprNode::TVar(_x) => true | TexprNode::TFieldAccess { target, field } => true | TexprNode::TDeref(_s) => true | _o => false };
}

fn is_slice_path(path: *const Vec<str>) -> bool {
    let n = path.length();
    if n == 0 as u32 { return false; }
    let last = path.as_slice()[n - 1 as u32];
    return str::eq(last, "Slice") || str_starts_with_pfx(last, "Slice_");
}
fn is_vec_path(path: *const Vec<str>) -> bool {
    let n = path.length();
    if n == 0 as u32 { return false; }
    let last = path.as_slice()[n - 1 as u32];
    return str::eq(last, "Vec") || str_starts_with_pfx(last, "Vec_");
}
fn str_starts_with_pfx(s: str, pfx: str) -> bool {
    let pn = str::length(pfx);
    if str::length(s) < pn { return false; }
    let sb = str::as_bytes(s);
    let pb = str::as_bytes(pfx);
    let mut i = 0 as u32;
    while i < pn { if sb[i] != pb[i] { return false; } i = i + 1 as u32; }
    return true;
}

fn escape_c_into(out: *StringBuilder, s: str) {
    let b = str::as_bytes(s);
    let n = str::length(s);
    let mut i = 0 as u32;
    while i < n {
        let c = b[i];
        if c == 10 as u8 { out.push_str("\\n"); }
        else if c == 13 as u8 { out.push_str("\\r"); }
        else if c == 9 as u8 { out.push_str("\\t"); }
        else if c == 8 as u8 { out.push_str("\\b"); }
        else if c == 0 as u8 { out.push_str("\\0"); }
        else if c == 92 as u8 { out.push_str("\\\\"); }
        else if c == 34 as u8 { out.push_str("\\\""); }
        else { out.push_byte(c); }
        i = i + 1 as u32;
    }
}

// unary prefix; the operand is parenthesised unless `simple`.
fn emit_unary(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, prefix: str, simple: bool, sub: *const Texpr) {
    out.push_str(prefix);
    if simple { gen_expr(a, ar, out, cg, sub); }
    else { out.push_str("("); gen_expr(a, ar, out, cg, sub); out.push_str(")"); }
}

fn is_atom_cast(n: *const TexprNode) -> bool {
    return match *n {
        TexprNode::TIntLit(_x) => true | TexprNode::TFloatLit(_f, _w) => true
        | TexprNode::TBoolLit(_b) => true | TexprNode::TVar(_v) => true | _o => false
    };
}
fn is_simple_field_target(n: *const TexprNode) -> bool {
    return match *n {
        TexprNode::TVar(_x) => true | TexprNode::TFieldAccess { target, field } => true
        | TexprNode::TIndex { base, index } => true | TexprNode::TCall { mangled, args } => true
        | TexprNode::TBuiltinCall { name, args } => true | TexprNode::TIndirectCall { fn_expr, args } => true
        | _o => false
    };
}
fn is_ptr_ty(t: *const Typ) -> bool {
    return match *t { Typ::TPtr(_i) => true | Typ::TOwnPtr(_i) => true | Typ::TConstPtr(_i) => true | _o => false };
}

fn emit_args(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, args: *const Vec<*const Texpr>) {
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < args.length() {
        if i > 0 as u32 { out.push_str(", "); }
        gen_expr(a, ar, out, cg, sl[i]);
        i = i + 1 as u32;
    }
}

// A C float literal.  The seam's snprintf renders the round-trip decimal
// (`%.9g` / `%.17g`, matching the oracle's OCaml Printf); then a decimal point
// or exponent is forced so C parses it as float (`1` -> `1.0`), and an `f`
// suffix tags f32 so the literal is not widened to double.
fn emit_float_lit(out: *StringBuilder, f: f64, w: FloatWidth) {
    let is32 = match w { FloatWidth::F32 => true | _o => false };
    let mut buf: [u8; 40] = [0 as u8; 40];
    let flag: c_int = if is32 { 1 as c_int } else { 0 as c_int };
    let n = sys::sys_fmt_f64(f, flag, &buf[0] as *c_uchar) as u32;
    let mut has_de = false;
    let mut i = 0 as u32;
    while i < n {
        let c = buf[i];
        if c == 46 as u8 || c == 101 as u8 || c == 69 as u8 { has_de = true; }
        out.push_byte(c);
        i = i + 1 as u32;
    }
    if !has_de { out.push_str(".0"); }
    if is32 { out.push_str("f"); }
}
pub fn gen_expr(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, te: *const Texpr) {
    match te.e {
        TexprNode::TIntLit(n) => out.push_int(n)
        | TexprNode::TFloatLit(f, w) => emit_float_lit(out, f, w)
        | TexprNode::TBoolLit(b) => { let s = if b { "1" } else { "0" }; out.push_str(s); }
        | TexprNode::TNullLit => out.push_str("((void *)0)")
        | TexprNode::TStringLit(s) => { out.push_str("\""); escape_c_into(out, s); out.push_str("\""); }
        | TexprNode::TVar(name) => out.push_str(name)
        | TexprNode::TFnRef(name) => out.push_str(name)
        | TexprNode::TNeg(sub) => emit_unary(a, ar, out, cg, "-", is_atom_int_var(sub.e), sub)
        | TexprNode::TBitNot(sub) => emit_unary(a, ar, out, cg, "~", is_atom_int_var(sub.e), sub)
        | TexprNode::TNot(sub) => emit_unary(a, ar, out, cg, "!", is_atom_bool_var(sub.e), sub)
        | TexprNode::TRef(sub) => emit_unary(a, ar, out, cg, "&", lvalue_like(&sub.e), sub)
        | TexprNode::TDeref(sub) => emit_unary(a, ar, out, cg, "*", lvalue_like(&sub.e), sub)
        | TexprNode::TCast(sub, ann) => {
            out.push_str("((");
            out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, te.ty)));
            out.push_str(")");
            if is_atom_cast(&sub.e) { gen_expr(a, ar, out, cg, sub); }
            else { out.push_str("("); gen_expr(a, ar, out, cg, sub); out.push_str(")"); }
            out.push_str(")");
        }
        | TexprNode::TBinOp(op, l, r) => {
            let p = prec(op);
            emit_binop_operand(a, ar, out, cg, l, p, op, false);
            out.push_str(binop_str(op));
            emit_binop_operand(a, ar, out, cg, r, p, op, true);
        }
        | TexprNode::TBuiltinCall { name, args } => emit_builtin(a, ar, out, cg, name, &args)
        | TexprNode::TCall { mangled, args } => {
            out.push_str(mangled);
            out.push_str("(");
            emit_args(a, ar, out, cg, &args);
            out.push_str(")");
        }
        | TexprNode::TIndirectCall { fn_expr, args } => {
            out.push_str("(");
            gen_expr(a, ar, out, cg, fn_expr);
            out.push_str(")(");
            emit_args(a, ar, out, cg, &args);
            out.push_str(")");
        }
        | TexprNode::TIndex { base, index } => {
            let suffix = index_suffix(base.ty);
            if is_index_simple_base(base.e) { gen_expr(a, ar, out, cg, base); }
            else { out.push_str("("); gen_expr(a, ar, out, cg, base); out.push_str(")"); }
            out.push_str(suffix);
            gen_expr(a, ar, out, cg, index);
            out.push_str("]");
        }
        | TexprNode::TFieldAccess { target, field } => emit_field_access(a, ar, out, cg, target, field)
        | TexprNode::TSizeOf(t) => { out.push_str("sizeof("); out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, t))); out.push_str(")"); }
        | TexprNode::TRuneAddr(addr) => emit_rune_addr(a, ar, out, te, addr)
        | TexprNode::TWardAddr { elem, base, base_sym, offset } => emit_ward_addr(a, ar, out, elem, base, base_sym, offset)
        | _other => { ice("internal: no C form for this IR expression"); }
    }
}

// The base address of a rune, materialised as its `volatile <T> *` value:
// `(volatile <T> *)<addr>UL`.  The `UL` suffix keeps the integer constant
// pointer-width, so a 64-bit host cc raises no int-to-pointer size warning
// while the m68k build (int == pointer == 32-bit) is unaffected.
fn emit_rune_addr(a: Allocator, ar: *Arena, out: *StringBuilder, te: *const Texpr, addr: int) {
    match *te.ty {
        Typ::TRune { elem, dir } => {
            out.push_str("(volatile ");
            out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, rune_ptr_pointee(elem))));
            out.push_str(" *)");
            out.push_int(addr);
            out.push_str("UL");
        }
        | _o => { ice("internal: TRuneAddr node without a rune type"); }
    }
}

// A ward field's address: `(volatile <elem>*)(base + offset)`, base
// and offset kept separate — readable, and the `d16(An)` shape the 68k wants once
// the base is a value.  `UL` on each keeps the constants pointer-width.
fn emit_ward_addr(a: Allocator, ar: *Arena, out: *StringBuilder, elem: *const Typ, base: int, base_sym: str, offset: int) {
    out.push_str("(volatile ");
    out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, elem)));
    out.push_str(" *)(");
    if str::eq(base_sym, "") {
        out.push_int(base);
        out.push_str("UL + ");
        out.push_int(offset);
        out.push_str("UL)");
    } else {
        // `&GLOBAL` (RAM) base: `(char*)&SYM + offset` — byte arithmetic, then the
        // volatile-T* cast.  The witness's aliased global lives at a link-time base.
        out.push_str("(char *)&");
        out.push_str(base_sym);
        out.push_str(" + ");
        out.push_int(offset);
        out.push_str("UL)");
    }
}

// A top-level rune: a file-scope
// `volatile T *const NAME = (volatile T*)ADDR;`.  The `const` on the pointer is
// stronger than the local form's plain binding — a global register handle is
// never rebound.  Typecheck restricts the base to an integer, so the value is
// always a `TRuneAddr`.
fn emit_rune_global(a: Allocator, ar: *Arena, out: *StringBuilder, rg: *const RuneGlobal) {
    out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, rg.rg_ty)));
    out.push_str("const ");
    out.push_str(rg.rg_name);
    out.push_str(" = ");
    match rg.rg_value.e {
        TexprNode::TRuneAddr(addr) => emit_rune_addr(a, ar, out, rg.rg_value, addr)
        | _o => { ice("internal: top-level rune value is not an address literal (typecheck restricts it to an integer)"); }
    }
    out.push_str(";\n");
}

fn is_atom_int_var(n: TexprNode) -> bool {
    return match n { TexprNode::TIntLit(_x) => true | TexprNode::TVar(_v) => true | _o => false };
}
fn is_atom_bool_var(n: TexprNode) -> bool {
    return match n { TexprNode::TBoolLit(_x) => true | TexprNode::TVar(_v) => true | _o => false };
}
fn is_index_simple_base(n: TexprNode) -> bool {
    return match n { TexprNode::TVar(_x) => true | TexprNode::TFieldAccess { target, field } => true | TexprNode::TIndex { base, index } => true | _o => false };
}
fn is_ward_addr_node(n: TexprNode) -> bool {
    return match n { TexprNode::TWardAddr { elem, base, base_sym, offset } => true | _o => false };
}

fn index_suffix(bty: *const Typ) -> str {
    return match *bty {
        Typ::TStruct(path) => { if is_slice_path(&path) || is_vec_path(&path) { ".ptr[" } else { ".data[" } }
        | Typ::TPtr(_i) => "["
        | Typ::TOwnPtr(_i) => "["
        | Typ::TConstPtr(_i) => "["
        // A register-file rune is a `volatile T *`; index it straight.
        // Only a register file ever reaches here — typecheck rejects
        // indexing a standalone rune.
        | Typ::TRune { elem, dir } => "["
        | _o => ".data["
    };
}

// `(*p).field` -> `p->field` (C `.` binds tighter than leading `*`); a
// pointer-typed target auto-derefs via `->`, else `.`; non-postfix targets
// are parenthesised.
fn emit_field_access(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, target: *const Texpr, field: str) {
    match target.e {
        TexprNode::TDeref(inner) => { gen_expr(a, ar, out, cg, inner); out.push_str("->"); out.push_str(field); }
        | _o => {
            let sep = if is_ptr_ty(target.ty) { "->" } else { "." };
            if is_simple_field_target(&target.e) { gen_expr(a, ar, out, cg, target); }
            else { out.push_str("("); gen_expr(a, ar, out, cg, target); out.push_str(")"); }
            out.push_str(sep);
            out.push_str(field);
        }
    }
}

fn binop_operand_parens(operand: *const Texpr, p: int, op: BinOp, is_right: bool) -> bool {
    return match operand.e {
        TexprNode::TBinOp(cop, cl, cr) => {
            let cp = prec(cop);
            cp < p || (is_right && cp == p && is_left_assoc(op)) || nest_warn(op, cop)
        }
        | _o => false
    };
}
fn emit_binop_operand(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, operand: *const Texpr, p: int, op: BinOp, is_right: bool) {
    if binop_operand_parens(operand, p, op, is_right) { out.push_str("("); gen_expr(a, ar, out, cg, operand); out.push_str(")"); }
    else { gen_expr(a, ar, out, cg, operand); }
}

// Ambient codegen state threaded through the statement / match emitters:
// the enum index (variant-sig lookup for match binds), the array-repeat fill
// counter and the match-label counter (both reset per program by
// gen_function).  Bundled so a single `cg` pointer rides the recursion.
struct Cg {
    cg_enums: *const Vec<EnumSig>,
    cg_structs: *const Vec<StructSig>,
    cg_fill: *u32,
    cg_ml: *u32,
    // Current defer chain (flattened, LIFO order) at the point being emitted;
    // gen_block keeps it in sync so a `try` desugar's return flushes defers.
    cg_defers: *Vec<Vec<Tstmt>>,
    // How many chain entries belong OUTSIDE the innermost enclosing loop — the
    // watermark `break` / `continue` flush down to (P3).  A loop jump must run the
    // defers registered INSIDE the loop and leave the enclosing scope's alone; the
    // chain is LIFO with the innermost first, so those are exactly its first
    // `length - cg_loopmark` entries.
    cg_loopmark: *u32,
}

// ===== Stage (d): statement / block / if emission =====
//
// emit_simple_stmt is the defer-body-leaf statement emitter (no return/defer);
// emit_value_into_temp initialises an already-declared temp from a block-shaped
// value (tuple/struct/new/enum-lit/if-expr/array/block) field-by-field.  The
// function-body walker gen_block/gen_if (defer + return control flow) lands in
// stage (f); TMatch lowering is stage (e) — stubbed here.

fn cg_indent(a: Allocator, ar: *Arena, indent: str) -> str {
    return concat2(a, ar, indent, "    ");
}

// `<indent><lhs> = <expr>;\n`
fn asn(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, indent: str, lhs: str, e: *const Texpr) {
    out.push_str(indent); out.push_str(lhs); out.push_str(" = ");
    gen_expr(a, ar, out, cg, e);
    out.push_str(";\n");
}
// `<base>._<i>`
fn lhs_tup(a: Allocator, ar: *Arena, base: str, i: u32) -> str {
    let mut sb = StringBuilder::with_capacity(a, 24 as u32);
    sb.push_str(base); sb.push_str("._"); sb.push_int(i as int);
    return str::from_slice(ar, sb.as_slice());
}
fn lhs_dot(a: Allocator, ar: *Arena, base: str, field: str) -> str { return concat3(a, ar, base, ".", field); }
fn lhs_arrow(a: Allocator, ar: *Arena, base: str, field: str) -> str { return concat3(a, ar, base, "->", field); }
// `<base>.data.<variant>.<field>`
fn lhs_variant(a: Allocator, ar: *Arena, base: str, sep: str, variant: str, field: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(base); sb.push_str(sep); sb.push_str("data."); sb.push_str(variant); sb.push_str("."); sb.push_str(field);
    return str::from_slice(ar, sb.as_slice());
}

fn struct_cname(a: Allocator, ar: *Arena, path: *const Vec<str>) -> str {
    return concat2(a, ar, "struct ", mangle_typ(a, ar, ty_node(ar, Typ::TStruct(copy_strs_cg(a, path)))));
}
fn enum_cname_str(a: Allocator, ar: *Arena, path: *const Vec<str>) -> str {
    return mangle_typ(a, ar, ty_node(ar, Typ::TEnum(copy_strs_cg(a, path))));
}

// `malloc(sizeof(<cname>))` or the seam alloc `((<cname> *)(ae.alloc_fn)(ae.state, ((unsigned long)sizeof(<cname>))))`.
fn emit_alloc_rhs(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, cname: str, alloc: Option<*const Texpr>) {
    match alloc {
        Option::None => { out.push_str("malloc(sizeof("); out.push_str(cname); out.push_str("))"); }
        | Option::Some(ae) => {
            out.push_str("(("); out.push_str(cname); out.push_str(" *)(");
            gen_expr(a, ar, out, cg, ae);
            out.push_str(".alloc_fn)(");
            gen_expr(a, ar, out, cg, ae);
            out.push_str(".state, ((unsigned long)sizeof("); out.push_str(cname); out.push_str("))))");
        }
    }
}

fn emit_fields_into(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, indent: str, temp: str, sep: str, fields: *const Vec<TexprField>) {
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < fields.length() {
        let lhs = if str::eq(sep, "->") { lhs_arrow(a, ar, temp, sl[i].name) } else { lhs_dot(a, ar, temp, sl[i].name) };
        asn(a, ar, out, cg, indent, lhs, sl[i].value);
        i = i + 1 as u32;
    }
}

fn emit_variant_args(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, indent: str, temp: str, sep: str, variant: str, args: *const Vec<TexprField>) {
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < args.length() {
        asn(a, ar, out, cg, indent, lhs_variant(a, ar, temp, sep, variant, sl[i].name), sl[i].value);
        i = i + 1 as u32;
    }
}

pub fn emit_value_into_temp(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, temp: str, value: *const Texpr) {
    match value.e {
        TexprNode::TTupleLit(es) => {
            let sl = es.as_slice();
            let mut i = 0 as u32;
            while i < es.length() { asn(a, ar, out, cg, indent, lhs_tup(a, ar, temp, i), sl[i]); i = i + 1 as u32; }
        }
        | TexprNode::TStructLit { sname_path, fields, base } => {
            match base { Option::Some(be) => asn(a, ar, out, cg, indent, temp, be) | Option::None => {} }
            emit_fields_into(a, ar, out, cg, indent, temp, ".", &fields);
        }
        | TexprNode::TNew { sname_path, fields, base, alloc } => {
            let cname = struct_cname(a, ar, &sname_path);
            out.push_str(indent); out.push_str(temp); out.push_str(" = ");
            emit_alloc_rhs(a, ar, out, cg, cname, alloc);
            out.push_str(";\n");
            match base { Option::Some(be) => asn(a, ar, out, cg, indent, concat2(a, ar, "*", temp), be) | Option::None => {} }
            emit_fields_into(a, ar, out, cg, indent, temp, "->", &fields);
        }
        | TexprNode::TEnumLit { ename_path, variant, tag, args } => {
            let cn = enum_cname_str(a, ar, &ename_path);
            out.push_str(indent); out.push_str(lhs_dot(a, ar, temp, "tag")); out.push_str(" = ");
            out.push_str(cn); out.push_str("_"); out.push_str(variant); out.push_str(";\n");
            emit_variant_args(a, ar, out, cg, indent, temp, ".", variant, &args);
        }
        | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => {
            let necname = concat2(a, ar, "struct ", enum_cname_str(a, ar, &ename_path));
            out.push_str(indent); out.push_str(temp); out.push_str(" = ");
            emit_alloc_rhs(a, ar, out, cg, necname, alloc);
            out.push_str(";\n");
            let necn = enum_cname_str(a, ar, &ename_path);
            out.push_str(indent); out.push_str(lhs_arrow(a, ar, temp, "tag")); out.push_str(" = ");
            out.push_str(necn); out.push_str("_"); out.push_str(variant); out.push_str(";\n");
            emit_variant_args(a, ar, out, cg, indent, temp, "->", variant, &args);
        }
        | TexprNode::TMatch { scrutinee, ename_path, arms } => emit_match_stmt(a, ar, out, indent, cg, Option::Some(temp), scrutinee, &ename_path, &arms)
        | TexprNode::TIfExpr { cond, then_val, else_val } => {
            let inner = cg_indent(a, ar, indent);
            out.push_str(indent); out.push_str("if (");
            gen_expr(a, ar, out, cg, cond);
            out.push_str(") {\n");
            emit_value_into_temp(a, ar, out, inner, cg, temp, then_val);
            out.push_str(indent); out.push_str("} else {\n");
            emit_value_into_temp(a, ar, out, inner, cg, temp, else_val);
            out.push_str(indent); out.push_str("}\n");
        }
        | TexprNode::TArrayLit(es) => {
            let alsl = es.as_slice();
            let mut ali = 0 as u32;
            while ali < es.length() {
                let mut lb = StringBuilder::with_capacity(a, 24 as u32);
                lb.push_str(temp); lb.push_str(".data["); lb.push_int(ali as int); lb.push_str("]");
                asn(a, ar, out, cg, indent, str::from_slice(ar, lb.as_slice()), alsl[ali]);
                ali = ali + 1 as u32;
            }
        }
        | TexprNode::TArrayRepeat { value, count } => {
            let k = *cg.cg_fill;
            *cg.cg_fill = *cg.cg_fill + 1 as u32;
            let iv = gensym_af(a, ar, k);
            let arinner = cg_indent(a, ar, indent);
            let arinner2 = cg_indent(a, ar, arinner);
            out.push_str(indent); out.push_str("{\n");
            out.push_str(arinner); out.push_str("int "); out.push_str(iv); out.push_str(";\n");
            out.push_str(arinner); out.push_str("for ("); out.push_str(iv); out.push_str(" = 0; "); out.push_str(iv); out.push_str(" < ");
            out.push_int(count); out.push_str("; "); out.push_str(iv); out.push_str(" = "); out.push_str(iv); out.push_str(" + 1) {\n");
            let mut eb = StringBuilder::with_capacity(a, 32 as u32);
            eb.push_str(temp); eb.push_str(".data["); eb.push_str(iv); eb.push_str("]");
            emit_value_into_temp(a, ar, out, arinner2, cg, str::from_slice(ar, eb.as_slice()), value);
            out.push_str(arinner); out.push_str("}\n");
            out.push_str(indent); out.push_str("}\n");
        }
        | TexprNode::TBlock { stmts, trailing } => {
            let bssl = stmts.as_slice();
            let mut bi = 0 as u32;
            while bi < stmts.length() { emit_simple_stmt(a, ar, out, indent, cg, &bssl[bi]); bi = bi + 1 as u32; }
            match trailing { Option::Some(tr) => emit_value_into_temp(a, ar, out, indent, cg, temp, tr) | Option::None => {} }
        }
        | _other => asn(a, ar, out, cg, indent, temp, value)
    }
}

fn gensym_af(a: Allocator, ar: *Arena, k: u32) -> str {
    let mut sb = StringBuilder::with_capacity(a, 16 as u32);
    sb.push_str("__af"); sb.push_int(k as int);
    return str::from_slice(ar, sb.as_slice());
}

// Does any sub-expression read variable `name`?  Used for the L2/L3
// loop-consume idiom (`head = new(a) Cons(i, head)`) where the allocation
// overwrites the lvalue before the payload writes read it.
fn texpr_has_var(te: *const Texpr, name: str) -> bool {
    return match te.e {
        TexprNode::TVar(n) => str::eq(n, name)
        | TexprNode::TNeg(s) => texpr_has_var(s, name)
        | TexprNode::TBitNot(s) => texpr_has_var(s, name)
        | TexprNode::TNot(s) => texpr_has_var(s, name)
        | TexprNode::TRef(s) => texpr_has_var(s, name)
        | TexprNode::TDeref(s) => texpr_has_var(s, name)
        | TexprNode::TCast(s, ann) => texpr_has_var(s, name)
        | TexprNode::TBinOp(op, l, r) => texpr_has_var(l, name) || texpr_has_var(r, name)
        | TexprNode::TFieldAccess { target, field } => texpr_has_var(target, name)
        | TexprNode::TIndex { base, index } => texpr_has_var(base, name) || texpr_has_var(index, name)
        | TexprNode::TCall { mangled, args } => args_have_var(&args, name)
        | TexprNode::TBuiltinCall { name: bn, args } => args_have_var(&args, name)
        | TexprNode::TIndirectCall { fn_expr, args } => texpr_has_var(fn_expr, name) || args_have_var(&args, name)
        | TexprNode::TNew { sname_path, fields, base, alloc } => fields_have_var(&fields, name) || opt_has_var(base, name) || opt_has_var(alloc, name)
        | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => fields_have_var(&args, name) || opt_has_var(alloc, name)
        | TexprNode::TStructLit { sname_path, fields, base } => fields_have_var(&fields, name) || opt_has_var(base, name)
        | TexprNode::TEnumLit { ename_path, variant, tag, args } => fields_have_var(&args, name)
        | TexprNode::TTupleLit(es) => args_have_var(&es, name)
        | TexprNode::TArrayLit(es) => args_have_var(&es, name)
        | TexprNode::TArrayRepeat { value, count } => texpr_has_var(value, name)
        | TexprNode::TIfExpr { cond, then_val, else_val } => texpr_has_var(cond, name) || texpr_has_var(then_val, name) || texpr_has_var(else_val, name)
        | TexprNode::TMatch { scrutinee, ename_path, arms } => texpr_has_var(scrutinee, name) || arms_have_var(&arms, name)
        | TexprNode::TBlock { stmts, trailing } => stmts_have_var(&stmts, name) || (match trailing { Option::Some(t) => texpr_has_var(t, name) | Option::None => false })
        | _other => false
    };
}
fn arms_have_var(arms: *const Vec<TmatchArm>, name: str) -> bool {
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < arms.length() {
        if texpr_has_var(sl[i].tbody, name) { return true; }
        let g = match sl[i].tguard { Option::Some(gg) => texpr_has_var(gg, name) | Option::None => false };
        if g { return true; }
        i = i + 1 as u32;
    }
    return false;
}
fn stmt_has_var(s: *const Tstmt, name: str) -> bool {
    return match *s {
        Tstmt::TLet { name: ln, value, pos } => texpr_has_var(value, name)
        | Tstmt::TLetTuple { names, value, pos } => texpr_has_var(value, name)
        | Tstmt::TAssign { path, value, pos } => texpr_has_var(value, name)
        | Tstmt::TExprStmt(e) => texpr_has_var(e, name)
        | Tstmt::TReturn { value, pos } => match value { Option::Some(e) => texpr_has_var(e, name) | Option::None => false }
        | Tstmt::TAssignField { target, field, value, pos } => texpr_has_var(target, name) || texpr_has_var(value, name)
        | Tstmt::TAssignDeref { target, value, pos } => texpr_has_var(target, name) || texpr_has_var(value, name)
        | Tstmt::TAssignIndex { base, index, value, pos } => texpr_has_var(base, name) || texpr_has_var(index, name) || texpr_has_var(value, name)
        | Tstmt::TIf { cond, then_body, else_body } => texpr_has_var(cond, name) || stmts_have_var(&then_body, name) || stmts_have_var(&else_body, name)
        | Tstmt::TWhile { cond, body, post } => texpr_has_var(cond, name) || stmts_have_var(&body, name) || stmts_have_var(&post, name)
        | _o => false
    };
}
fn stmts_have_var(stmts: *const Vec<Tstmt>, name: str) -> bool {
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() { if stmt_has_var(&sl[i], name) { return true; } i = i + 1 as u32; }
    return false;
}
fn args_have_var(args: *const Vec<*const Texpr>, name: str) -> bool {
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < args.length() { if texpr_has_var(sl[i], name) { return true; } i = i + 1 as u32; }
    return false;
}
fn fields_have_var(fields: *const Vec<TexprField>, name: str) -> bool {
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < fields.length() { if texpr_has_var(sl[i].value, name) { return true; } i = i + 1 as u32; }
    return false;
}
fn opt_has_var(o: Option<*const Texpr>, name: str) -> bool {
    return match o { Option::Some(e) => texpr_has_var(e, name) | Option::None => false };
}

fn last_seg_str(path: *const Vec<str>) -> str {
    let n = path.length();
    if n == 0 as u32 { return ""; }
    return path.as_slice()[n - 1 as u32];
}

fn is_new_or_newenum(te: *const Texpr) -> bool {
    return match te.e { TexprNode::TNew { sname_path, fields, base, alloc } => true | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => true | _o => false };
}

pub fn emit_simple_stmt(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, stmt: *const Tstmt) {
    match *stmt {
        Tstmt::TLet { name, value, pos } => emit_value_into_temp(a, ar, out, indent, cg, name, value)
        | Tstmt::TAssign { path, value, pos } => emit_assign_stmt(a, ar, out, indent, cg, &path, value)
        | Tstmt::TLetTuple { names, value, pos } => emit_let_tuple(a, ar, out, indent, cg, &names, value)
        | Tstmt::TAssignField { target, field, value, pos } => {
            let sep = if is_ptr_ty(target.ty) { "->" } else { "." };
            out.push_str(indent);
            if is_simple_field_target(&target.e) { gen_expr(a, ar, out, cg, target); }
            else { out.push_str("("); gen_expr(a, ar, out, cg, target); out.push_str(")"); }
            out.push_str(sep); out.push_str(field); out.push_str(" = ");
            gen_expr(a, ar, out, cg, value);
            out.push_str(";\n");
        }
        | Tstmt::TAssignDeref { target, value, pos } => {
            out.push_str(indent);
            emit_unary(a, ar, out, cg, "*", is_deref_simple(target.e), target);
            out.push_str(" = ");
            gen_expr(a, ar, out, cg, value);
            out.push_str(";\n");
        }
        | Tstmt::TAssignIndex { base, index, value, pos } => {
            let mut lb = StringBuilder::with_capacity(a, 32 as u32);
            // A ward register-file field's base is a `(volatile T*)(...)` CAST, and
            // `[i]` would bind to the cast's operand without parens — wrap only that
            // node, so every existing base's bytes are unchanged.
            if is_ward_addr_node(base.e) { lb.push_str("("); gen_expr(a, ar, &lb, cg, base); lb.push_str(")"); }
            else { gen_expr(a, ar, &lb, cg, base); }
            match *base.ty { Typ::TPtr(_i) => lb.push_str("[") | Typ::TOwnPtr(_i) => lb.push_str("[") | Typ::TRune { elem, dir } => lb.push_str("[") | _o => lb.push_str(".data[") }
            gen_expr(a, ar, &lb, cg, index);
            lb.push_str("]");
            emit_value_into_temp(a, ar, out, indent, cg, str::from_slice(ar, lb.as_slice()), value);
        }
        | Tstmt::TExprStmt(e) => {
            match e.e {
                TexprNode::TMatch { scrutinee, ename_path, arms } => { let no_lhs: Option<str> = Option::None; emit_match_stmt(a, ar, out, indent, cg, no_lhs, scrutinee, &ename_path, &arms); }
                | TexprNode::TBlock { stmts, trailing } => {
                    let ssl = stmts.as_slice();
                    let mut i = 0 as u32;
                    while i < stmts.length() { emit_simple_stmt(a, ar, out, indent, cg, &ssl[i]); i = i + 1 as u32; }
                }
                | _o => { out.push_str(indent); gen_expr(a, ar, out, cg, e); out.push_str(";\n"); }
            }
        }
        | Tstmt::TIf { cond, then_body, else_body } => emit_if_stmt(a, ar, out, indent, cg, cond, &then_body, &else_body)
        | Tstmt::TWhile { cond, body, post } => {
            out.push_str(indent);
            if post.length() == 0 as u32 {
                out.push_str("while ("); gen_expr(a, ar, out, cg, cond); out.push_str(") {\n");
            } else {
                out.push_str("for (; "); gen_expr(a, ar, out, cg, cond); out.push_str("; ");
                emit_for_post(a, ar, out, cg, &post);
                out.push_str(") {\n");
            }
            emit_stmts(a, ar, out, cg_indent(a, ar, indent), cg, &body);
            out.push_str(indent); out.push_str("}\n");
        }
        | Tstmt::TBreak(p) => { out.push_str(indent); out.push_str("break;\n"); }
        | Tstmt::TContinue(p) => { out.push_str(indent); out.push_str("continue;\n"); }
        // A `return` inside a nested statement list (a diverging match arm's
        // block — `let-else`) flushes the defer chain active HERE; the arm has
        // no defer scope of its own.
        | Tstmt::TReturn { value, pos } => emit_return(a, ar, out, indent, cg, value, cg.cg_defers)
        // A seal in a scope that has no defer chain of its own — a defer body, or
        // a diverging match arm's block. The region still needs one (its own exit
        // rides a defer), so it opens a real block over the chain active HERE.
        //
        // The chain is then RESTORED, and that is not bookkeeping: `gen_block`
        // publishes its chain into `cg` as it walks, and this walker has no
        // republish step of its own to undo it. Without the restore the region's
        // exit outlives the region — a `return` after it re-runs the exit, and a
        // sibling arm that never sealed runs it on an uninitialised token.
        | Tstmt::TSeal { body, pos } => {
            let none: Vec<Vec<Tstmt>> = Vec::with_capacity(a, 8 as u32);
            let ambient = flatten_defers(a, &none, cg.cg_defers);
            out.push_str(indent); out.push_str("{\n");
            gen_block(a, ar, out, cg_indent(a, ar, indent), cg, &ambient, &body);
            set_defers(cg, &ambient);
            out.push_str(indent); out.push_str("}\n");
        }
        | _other => { ice("internal: no C form for this IR statement — did a transient node survive the lift pass?"); }
    }
}

// Single-name assign; the L2/L3 read-by-value idiom (`head = new(a) Cons(i,
// head)`) builds into a scratch and publishes last so the allocation does not
// overwrite the lvalue before the payload writes read it.
fn emit_assign_stmt(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, path: *const Vec<str>, value: *const Texpr) {
    let lhs = last_seg_str(path);
    if is_new_or_newenum(value) && texpr_has_var(value, lhs) {
        let inner = cg_indent(a, ar, indent);
        out.push_str(indent); out.push_str("{\n");
        out.push_str(inner); out.push_str(c_decl(a, ar, value.ty, "__newv")); out.push_str(";\n");
        emit_value_into_temp(a, ar, out, inner, cg, "__newv", value);
        out.push_str(inner); out.push_str(lhs); out.push_str(" = __newv;\n");
        out.push_str(indent); out.push_str("}\n");
        return;
    }
    emit_value_into_temp(a, ar, out, indent, cg, lhs, value);
}

// A statement-position `if` (defer-body leaf — no return/defer inside).
fn emit_if_stmt(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, cond: *const Texpr, then_body: *const Vec<Tstmt>, else_body: *const Vec<Tstmt>) {
    out.push_str(indent); out.push_str("if ("); gen_expr(a, ar, out, cg, cond); out.push_str(") {\n");
    emit_stmts(a, ar, out, cg_indent(a, ar, indent), cg, then_body);
    out.push_str(indent); out.push_str("}");
    if else_body.length() == 0 as u32 { out.push_str("\n"); return; }
    out.push_str(" else {\n");
    emit_stmts(a, ar, out, cg_indent(a, ar, indent), cg, else_body);
    out.push_str(indent); out.push_str("}\n");
}

fn is_deref_simple(n: TexprNode) -> bool {
    return match n { TexprNode::TVar(_x) => true | TexprNode::TFieldAccess { target, field } => true | _o => false };
}

fn emit_stmts(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, stmts: *const Vec<Tstmt>) {
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() { emit_simple_stmt(a, ar, out, indent, cg, &sl[i]); i = i + 1 as u32; }
}

// `for`-post rendered as the comma-joined third clause of `for (; cond; <here>)`.
fn emit_for_post(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, post: *const Vec<Tstmt>) {
    let sl = post.as_slice();
    let mut i = 0 as u32;
    while i < post.length() {
        if i > 0 as u32 { out.push_str(", "); }
        match sl[i] {
            Tstmt::TAssign { path, value, pos } => {
                out.push_str(last_seg_str(&path)); out.push_str(" = "); gen_expr(a, ar, out, cg, value);
            }
            | Tstmt::TExprStmt(e) => gen_expr(a, ar, out, cg, e)
            | _o => { ice("internal: no C form for this loop-post statement"); }
        }
        i = i + 1 as u32;
    }
}

pub fn emit_let_tuple(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, names: *const Vec<str>, value: *const Texpr) {
    let inner = cg_indent(a, ar, indent);
    out.push_str(indent); out.push_str("{\n");
    out.push_str(inner); out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, value.ty))); out.push_str(" __t;\n");
    emit_value_into_temp(a, ar, out, inner, cg, "__t", value);
    let sl = names.as_slice();
    let mut i = 0 as u32;
    while i < names.length() {
        out.push_str(inner); out.push_str(sl[i]); out.push_str(" = __t._"); out.push_int(i as int); out.push_str(";\n");
        i = i + 1 as u32;
    }
    out.push_str(indent); out.push_str("}\n");
}

// ===== Stage (e): match emission =====
//
// A flat match (var/wildcard binds only, no guards, no outer-loop break in an
// arm) compiles to a tag `switch`; anything nested / guarded / loop-breaking
// falls back to an if-else (or goto, when guarded) decision chain.  The
// scrutinee is hoisted into `__m`; `assign_to = Some lhs` makes every arm body
// assign its value to `lhs` (match-as-value), None discards it (stmt match).
// Bind names come from the pattern (no position-generated temps); only the
// guard chain's `__mdoneK` label uses a counter.

struct CgBind { b_name: str, b_lval: str, b_ty: *const Typ }
struct PatC { pc_tests: Vec<str>, pc_binds: Vec<CgBind> }

// Canonical enum-path key (mangle splits colon-joined module paths, so this is
// path-form normalised).
fn enum_key(a: Allocator, ar: *Arena, path: *const Vec<str>) -> str {
    return mangle_typ(a, ar, ty_node(ar, Typ::TEnum(copy_strs_cg(a, path))));
}
@escapes
fn enum_sig_of(a: Allocator, ar: *Arena, enums: *const Vec<EnumSig>, path: *const Vec<str>) -> Option<*const EnumSig> {
    let key = enum_key(a, ar, path);
    let sl = enums.as_slice();
    let mut i = 0 as u32;
    while i < enums.length() {
        if str::eq(enum_key(a, ar, &sl[i].ename_path), key) { return Option::Some(&sl[i] as *const EnumSig); }
        i = i + 1 as u32;
    }
    let n: Option<*const EnumSig> = Option::None;
    return n;
}
@escapes
fn variant_field_ty(ar: *Arena, es: *const EnumSig, variant: str, fname: str) -> *const Typ {
    let vs = es.evariants.as_slice();
    let mut i = 0 as u32;
    while i < es.evariants.length() {
        if str::eq(vs[i].vsname, variant) {
            let fl = vs[i].vsfields.as_slice();
            let mut j = 0 as u32;
            while j < vs[i].vsfields.length() { if str::eq(fl[j].name, fname) { return fl[j].ty; } j = j + 1 as u32; }
        }
        i = i + 1 as u32;
    }
    // No such (variant, field).  The old fallback indexed evariants[0].vsfields[0],
    // which reads out of bounds when the first variant is field-less (`Nothing`)
    // — a real SEGV, hit by tier.exl.  Fall back to a void type instead.
    return ty_node(ar, Typ::TCVoid);
}

fn tpat_nested(pat: *const Tpattern) -> bool {
    return match *pat {
        Tpattern::TPVariant { variant, tag, binds } => binds_nested(&binds)
        | _o => false
    };
}
fn binds_nested(binds: *const Vec<TFieldPat>) -> bool {
    let sl = binds.as_slice();
    let mut i = 0 as u32;
    while i < binds.length() {
        let direct = match sl[i].pat { Tpattern::TPVariant { variant, tag, binds: bb } => true | _o => false };
        if direct { return true; }
        if tpat_nested(&sl[i].pat) { return true; }
        i = i + 1 as u32;
    }
    return false;
}

fn stmt_has_loop_break(s: *const Tstmt) -> bool {
    return match *s {
        Tstmt::TBreak(p) => true | Tstmt::TContinue(p) => true
        | Tstmt::TIf { cond, then_body, else_body } => stmts_have_break(&then_body) || stmts_have_break(&else_body)
        | Tstmt::TWhile { cond, body, post } => false
        | Tstmt::TExprStmt(e) => expr_has_loop_break(e)
        | Tstmt::TLet { name, value, pos } => expr_has_loop_break(value)
        | Tstmt::TAssign { path, value, pos } => expr_has_loop_break(value)
        | Tstmt::TLetTuple { names, value, pos } => expr_has_loop_break(value)
        | Tstmt::TAssignField { target, field, value, pos } => expr_has_loop_break(value)
        | Tstmt::TAssignDeref { target, value, pos } => expr_has_loop_break(value)
        | Tstmt::TAssignIndex { base, index, value, pos } => expr_has_loop_break(base) || expr_has_loop_break(index) || expr_has_loop_break(value)
        | Tstmt::TReturn { value, pos } => match value { Option::Some(e) => expr_has_loop_break(e) | Option::None => false }
        | _o => false
    };
}
fn stmts_have_break(stmts: *const Vec<Tstmt>) -> bool {
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() { if stmt_has_loop_break(&sl[i]) { return true; } i = i + 1 as u32; }
    return false;
}
fn expr_has_loop_break(te: *const Texpr) -> bool {
    return match te.e {
        TexprNode::TBlock { stmts, trailing } => stmts_have_break(&stmts) || (match trailing { Option::Some(t) => expr_has_loop_break(t) | Option::None => false })
        | TexprNode::TMatch { scrutinee, ename_path, arms } => arms_have_break(&arms)
        | TexprNode::TIfExpr { cond, then_val, else_val } => expr_has_loop_break(then_val) || expr_has_loop_break(else_val)
        | _o => false
    };
}
fn arms_have_break(arms: *const Vec<TmatchArm>) -> bool {
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < arms.length() { if expr_has_loop_break(sl[i].tbody) { return true; } i = i + 1 as u32; }
    return false;
}

fn arm_uses_bind(arm: *const TmatchArm, name: str) -> bool {
    if texpr_has_var(arm.tbody, name) { return true; }
    return match arm.tguard { Option::Some(g) => texpr_has_var(g, name) | Option::None => false };
}

fn needs_decision(arms: *const Vec<TmatchArm>) -> bool {
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < arms.length() {
        let g = match sl[i].tguard { Option::Some(_x) => true | Option::None => false };
        if tpat_nested(&sl[i].tpat) || g || expr_has_loop_break(sl[i].tbody) { return true; }
        i = i + 1 as u32;
    }
    return false;
}

// compile a pattern into tag-tests + binds against C l-value `scrut` of type ty.
fn compile_pat(a: Allocator, ar: *Arena, enums: *const Vec<EnumSig>, scrut: str, ty: *const Typ, pat: *const Tpattern) -> PatC {
    let mut tests: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut binds: Vec<CgBind> = Vec::with_capacity(a, 8 as u32);
    match *pat {
        Tpattern::TPWildcard => {}
        | Tpattern::TPVar(n) => binds.push(CgBind { b_name: n, b_lval: scrut, b_ty: ty })
        | Tpattern::TPLit(v) => { let mut sb = StringBuilder::with_capacity(a, 24 as u32); sb.push_str(scrut); sb.push_str(" == "); sb.push_int(v); tests.push(str::from_slice(ar, sb.as_slice())); }
        | Tpattern::TPBool(b) => { let mut bsb = StringBuilder::with_capacity(a, 24 as u32); bsb.push_str(scrut); bsb.push_str(" == "); bsb.push_str(if b { "1" } else { "0" }); tests.push(str::from_slice(ar, bsb.as_slice())); }
        | Tpattern::TPVariant { variant, tag, binds: vbinds } => {
            let cname = mangle_typ(a, ar, ty);
            let mut tb = StringBuilder::with_capacity(a, 32 as u32);
            tb.push_str(scrut); tb.push_str(".tag == "); tb.push_str(cname); tb.push_str("_"); tb.push_str(variant);
            tests.push(str::from_slice(ar, tb.as_slice()));
            let es_opt = match *ty { Typ::TEnum(ep) => enum_sig_of(a, ar, enums, &ep) | _o => { let nn: Option<*const EnumSig> = Option::None; nn } };
            let es = match es_opt { Option::Some(e) => e | Option::None => &enums.as_slice()[0 as u32] as *const EnumSig };
            let bsl = vbinds.as_slice();
            let mut i = 0 as u32;
            while i < vbinds.length() {
                let ft = variant_field_ty(ar, es, variant, bsl[i].name);
                let mut ss = StringBuilder::with_capacity(a, 32 as u32);
                ss.push_str(scrut); ss.push_str(".data."); ss.push_str(variant); ss.push_str("."); ss.push_str(bsl[i].name);
                let sub = compile_pat(a, ar, enums, str::from_slice(ar, ss.as_slice()), ft, &bsl[i].pat);
                append_tests(&tests, &sub.pc_tests);
                append_binds(&binds, &sub.pc_binds);
                i = i + 1 as u32;
            }
        }
        | Tpattern::TPOr(alts) => compile_or_pat(a, ar, enums, scrut, ty, &alts, &tests)
    }
    return PatC { pc_tests: tests, pc_binds: binds };
}
// Or-pattern tests: `||`-join each alt's `&&`-joined tests; a wildcard alt
// (zero tests) collapses the whole disjunction to always-true (no test).
fn compile_or_pat(a: Allocator, ar: *Arena, enums: *const Vec<EnumSig>, scrut: str, ty: *const Typ, alts: *const Vec<Tpattern>, tests: *Vec<str>) {
    let asl = alts.as_slice();
    let mut any_empty = false;
    let mut joined: Vec<str> = Vec::with_capacity(a, 8 as u32);
    let mut oi = 0 as u32;
    while oi < alts.length() {
        let osub = compile_pat(a, ar, enums, scrut, ty, &asl[oi]);
        if osub.pc_tests.length() == 0 as u32 { any_empty = true; }
        else { joined.push(and_join(a, ar, &osub.pc_tests)); }
        oi = oi + 1 as u32;
    }
    if any_empty { return; }
    let mut ob = StringBuilder::with_capacity(a, 32 as u32);
    ob.push_str("(");
    let jsl = joined.as_slice();
    let mut j = 0 as u32;
    while j < joined.length() { if j > 0 as u32 { ob.push_str(" || "); } ob.push_str(jsl[j]); j = j + 1 as u32; }
    ob.push_str(")");
    tests.push(str::from_slice(ar, ob.as_slice()));
}

fn append_tests(dst: *Vec<str>, src: *const Vec<str>) { let sl = src.as_slice(); let mut i = 0 as u32; while i < src.length() { dst.push(sl[i]); i = i + 1 as u32; } }
fn append_binds(dst: *Vec<CgBind>, src: *const Vec<CgBind>) { let sl = src.as_slice(); let mut i = 0 as u32; while i < src.length() { dst.push(sl[i]); i = i + 1 as u32; } }
fn and_join(a: Allocator, ar: *Arena, tests: *const Vec<str>) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str("(");
    let sl = tests.as_slice();
    let mut i = 0 as u32;
    while i < tests.length() { if i > 0 as u32 { sb.push_str(" && "); } sb.push_str(sl[i]); i = i + 1 as u32; }
    sb.push_str(")");
    return str::from_slice(ar, sb.as_slice());
}
fn join_tests_amp(out: *StringBuilder, tests: *const Vec<str>) {
    let sl = tests.as_slice();
    let mut i = 0 as u32;
    while i < tests.length() { if i > 0 as u32 { out.push_str(" && "); } out.push_str(sl[i]); i = i + 1 as u32; }
}

fn emit_pat_binds(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, arm: *const TmatchArm, binds: *const Vec<CgBind>) {
    let sl = binds.as_slice();
    let mut i = 0 as u32;
    while i < binds.length() {
        if arm_uses_bind(arm, sl[i].b_name) {
            out.push_str(indent); out.push_str(c_decl(a, ar, sl[i].b_ty, sl[i].b_name)); out.push_str(" = "); out.push_str(sl[i].b_lval); out.push_str(";\n");
        }
        i = i + 1 as u32;
    }
}

fn emit_arm_result(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, assign_to: Option<str>, arm: *const TmatchArm) {
    if arm.tdiverges {
        match arm.tbody.e {
            TexprNode::TEnumLit { ename_path, variant, tag, args } => {
                // `try` desugar: build the Err/None value, flush active defers, return.
                out.push_str(indent); out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, arm.tbody.ty))); out.push_str(" __try_ret;\n");
                emit_value_into_temp(a, ar, out, indent, cg, "__try_ret", arm.tbody);
                emit_cleanups(a, ar, out, indent, cg, cg.cg_defers);
                out.push_str(indent); out.push_str("return __try_ret;\n");
            }
            | TexprNode::TBlock { stmts, trailing } => emit_stmts(a, ar, out, indent, cg, &stmts)
            | _o => { ice("internal: no C form for this diverging match arm"); }
        }
        return;
    }
    match assign_to {
        Option::Some(lhs) => emit_arm_value(a, ar, out, indent, cg, lhs, arm.tbody)
        | Option::None => emit_arm_void(a, ar, out, indent, cg, arm.tbody)
    }
}
fn emit_arm_value(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, lhs: str, tbody: *const Texpr) {
    match tbody.e {
        TexprNode::TMatch { scrutinee, ename_path, arms } => emit_match_stmt(a, ar, out, indent, cg, Option::Some(lhs), scrutinee, &ename_path, &arms)
        | TexprNode::TBlock { stmts, trailing } => {
            emit_stmts(a, ar, out, indent, cg, &stmts);
            match trailing { Option::Some(te) => emit_arm_value(a, ar, out, indent, cg, lhs, te) | Option::None => {} }
        }
        | TexprNode::TStructLit { sname_path, fields, base } => emit_value_into_temp(a, ar, out, indent, cg, lhs, tbody)
        | TexprNode::TNew { sname_path, fields, base, alloc } => emit_value_into_temp(a, ar, out, indent, cg, lhs, tbody)
        | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => emit_value_into_temp(a, ar, out, indent, cg, lhs, tbody)
        | TexprNode::TEnumLit { ename_path, variant, tag, args } => emit_value_into_temp(a, ar, out, indent, cg, lhs, tbody)
        | TexprNode::TTupleLit(es) => emit_value_into_temp(a, ar, out, indent, cg, lhs, tbody)
        | TexprNode::TArrayLit(es) => emit_value_into_temp(a, ar, out, indent, cg, lhs, tbody)
        | TexprNode::TArrayRepeat { value, count } => emit_value_into_temp(a, ar, out, indent, cg, lhs, tbody)
        | TexprNode::TIfExpr { cond, then_val, else_val } => emit_value_into_temp(a, ar, out, indent, cg, lhs, tbody)
        | _o => { out.push_str(indent); out.push_str(lhs); out.push_str(" = "); gen_expr(a, ar, out, cg, tbody); out.push_str(";\n"); }
    }
}
fn emit_arm_void(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, tbody: *const Texpr) {
    match tbody.e {
        TexprNode::TMatch { scrutinee, ename_path, arms } => { let no_lhs: Option<str> = Option::None; emit_match_stmt(a, ar, out, indent, cg, no_lhs, scrutinee, &ename_path, &arms); }
        | TexprNode::TBlock { stmts, trailing } => {
            emit_stmts(a, ar, out, indent, cg, &stmts);
            match trailing { Option::Some(te) => emit_arm_void(a, ar, out, indent, cg, te) | Option::None => {} }
        }
        | _o => { out.push_str(indent); gen_expr(a, ar, out, cg, tbody); out.push_str(";\n"); }
    }
}

fn emit_arms_if_else(a: Allocator, ar: *Arena, out: *StringBuilder, inner: str, body_indent: str, cg: *const Cg, ty: *const Typ, enums: *const Vec<EnumSig>, assign_to: Option<str>, arms: *const Vec<TmatchArm>) {
    let n = arms.length();
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < n {
        let is_last = i == n - 1 as u32;
        let pc = compile_pat(a, ar, enums, "__m", ty, &sl[i].tpat);
        out.push_str(inner);
        if is_last && i > 0 as u32 { out.push_str("else {\n"); }
        else if is_last { out.push_str("{\n"); }
        else {
            out.push_str(if i == 0 as u32 { "if (" } else { "else if (" });
            join_tests_amp(out, &pc.pc_tests);
            out.push_str(") {\n");
        }
        emit_pat_binds(a, ar, out, body_indent, &sl[i], &pc.pc_binds);
        emit_arm_result(a, ar, out, body_indent, cg, assign_to, &sl[i]);
        out.push_str(inner); out.push_str("}\n");
        i = i + 1 as u32;
    }
}

fn emit_arms_goto(a: Allocator, ar: *Arena, out: *StringBuilder, inner: str, body_indent: str, cg: *const Cg, ty: *const Typ, enums: *const Vec<EnumSig>, assign_to: Option<str>, arms: *const Vec<TmatchArm>) {
    let k = *cg.cg_ml;
    *cg.cg_ml = *cg.cg_ml + 1 as u32;
    let mut lb = StringBuilder::with_capacity(a, 16 as u32);
    lb.push_str("__mdone"); lb.push_int(k as int);
    let label = str::from_slice(ar, lb.as_slice());
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < arms.length() {
        let pc = compile_pat(a, ar, enums, "__m", ty, &sl[i].tpat);
        out.push_str(inner);
        if pc.pc_tests.length() == 0 as u32 { out.push_str("{\n"); }
        else { out.push_str("if ("); join_tests_amp(out, &pc.pc_tests); out.push_str(") {\n"); }
        emit_pat_binds(a, ar, out, body_indent, &sl[i], &pc.pc_binds);
        let stmt_indent = match sl[i].tguard {
            Option::Some(g) => { out.push_str(body_indent); out.push_str("if ("); gen_expr(a, ar, out, cg, g); out.push_str(") {\n"); cg_indent(a, ar, body_indent) }
            | Option::None => body_indent
        };
        emit_arm_result(a, ar, out, stmt_indent, cg, assign_to, &sl[i]);
        if !sl[i].tdiverges { out.push_str(stmt_indent); out.push_str("goto "); out.push_str(label); out.push_str(";\n"); }
        match sl[i].tguard { Option::Some(g2) => { out.push_str(body_indent); out.push_str("}\n"); } | Option::None => {} }
        out.push_str(inner); out.push_str("}\n");
        i = i + 1 as u32;
    }
    out.push_str(inner); out.push_str(label); out.push_str(": ;\n");
}

fn emit_match_decision(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, assign_to: Option<str>, ename_path: *const Vec<str>, arms: *const Vec<TmatchArm>, scrutinee: *const Texpr) {
    let inner = cg_indent(a, ar, indent);
    let body_indent = cg_indent(a, ar, inner);
    let scalar = ename_path.length() == 0 as u32;
    out.push_str(indent); out.push_str("{\n");
    if scalar { out.push_str(inner); out.push_str(c_decl(a, ar, scrutinee.ty, "__m")); out.push_str(";\n"); }
    else { out.push_str(inner); out.push_str("struct "); out.push_str(enum_key(a, ar, ename_path)); out.push_str(" __m;\n"); }
    emit_value_into_temp(a, ar, out, inner, cg, "__m", scrutinee);
    let mty = if scalar { scrutinee.ty } else { ty_node(ar, Typ::TEnum(copy_strs_cg(a, ename_path))) };
    let has_guard = any_guard(arms);
    let enums = cg.cg_enums;
    if has_guard { emit_arms_goto(a, ar, out, inner, body_indent, cg, mty, enums, assign_to, arms); }
    else { emit_arms_if_else(a, ar, out, inner, body_indent, cg, mty, enums, assign_to, arms); }
    out.push_str(indent); out.push_str("}\n");
}
fn any_guard(arms: *const Vec<TmatchArm>) -> bool {
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < arms.length() {
        let has = match sl[i].tguard { Option::Some(_g) => true | Option::None => false };
        if has { return true; }
        i = i + 1 as u32;
    }
    return false;
}

// Flat-switch arm case labels: or-alts -> stacked case labels; a wildcard alt
// -> default; the last arm additionally stacks `default:` (proved exhaustive).
fn emit_case_labels(a: Allocator, out: *StringBuilder, inner: str, cname: str, arm: *const TmatchArm, is_last: bool) {
    let alts = match arm.tpat { Tpattern::TPOr(xs) => xs | _o => single_pat(a, arm.tpat) };
    let asl = alts.as_slice();
    let mut has_wild = false;
    let mut i = 0 as u32;
    while i < alts.length() { match asl[i] { Tpattern::TPWildcard => { has_wild = true; } | Tpattern::TPVar(_n) => { has_wild = true; } | _o => {} } i = i + 1 as u32; }
    if has_wild { out.push_str("default:\n"); return; }
    let mut j = 0 as u32;
    while j < alts.length() {
        if j > 0 as u32 { out.push_str(inner); }
        match asl[j] {
            Tpattern::TPVariant { variant, tag, binds } => { out.push_str("case "); out.push_str(cname); out.push_str("_"); out.push_str(variant); out.push_str(":\n"); }
            | Tpattern::TPLit(v) => { out.push_str("case "); out.push_int(v); out.push_str(":\n"); }
            | Tpattern::TPBool(b) => { out.push_str("case "); out.push_str(if b { "1" } else { "0" }); out.push_str(":\n"); }
            | _o => {}
        }
        j = j + 1 as u32;
    }
    if is_last { out.push_str(inner); out.push_str("default:\n"); }
}
fn single_pat(a: Allocator, pat: Tpattern) -> Vec<Tpattern> {
    let mut out: Vec<Tpattern> = Vec::with_capacity(a, 8 as u32);
    out.push(pat);
    return out;
}

fn emit_scalar_bind(a: Allocator, ar: *Arena, out: *StringBuilder, body_indent: str, scrutinee: *const Texpr, arm: *const TmatchArm, n: str) {
    if arm_uses_bind(arm, n) { out.push_str(body_indent); out.push_str(c_decl(a, ar, scrutinee.ty, n)); out.push_str(" = __m;\n"); }
}
fn emit_switch_binds(a: Allocator, ar: *Arena, out: *StringBuilder, body_indent: str, cg: *const Cg, ename_path: *const Vec<str>, scrutinee: *const Texpr, arm: *const TmatchArm) {
    match arm.tpat {
        Tpattern::TPVar(n) => emit_scalar_bind(a, ar, out, body_indent, scrutinee, arm, n)
        | Tpattern::TPVariant { variant, tag, binds } => {
            let es = match enum_sig_of(a, ar, cg.cg_enums, ename_path) { Option::Some(e) => e | Option::None => &cg.cg_enums.as_slice()[0 as u32] as *const EnumSig };
            let bsl = binds.as_slice();
            let mut i = 0 as u32;
            while i < binds.length() { emit_variant_field_bind(a, ar, out, body_indent, es, variant, arm, &bsl[i]); i = i + 1 as u32; }
        }
        | _o => {}
    }
}

fn emit_variant_field_bind(a: Allocator, ar: *Arena, out: *StringBuilder, body_indent: str, es: *const EnumSig, variant: str, arm: *const TmatchArm, fp: *const TFieldPat) {
    let n = match fp.pat { Tpattern::TPVar(x) => x | _o => "" };
    if str::eq(n, "") { return; }
    if !arm_uses_bind(arm, n) { return; }
    let ft = variant_field_ty(ar, es, variant, fp.name);
    out.push_str(body_indent); out.push_str(c_decl(a, ar, ft, n)); out.push_str(" = __m.data."); out.push_str(variant); out.push_str("."); out.push_str(fp.name); out.push_str(";\n");
}

pub fn emit_match_stmt(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, assign_to: Option<str>, scrutinee: *const Texpr, ename_path: *const Vec<str>, arms: *const Vec<TmatchArm>) {
    if needs_decision(arms) { emit_match_decision(a, ar, out, indent, cg, assign_to, ename_path, arms, scrutinee); return; }
    let inner = cg_indent(a, ar, indent);
    let case_indent = cg_indent(a, ar, inner);
    let body_indent = cg_indent(a, ar, case_indent);
    let scalar = ename_path.length() == 0 as u32;
    let cname = if scalar { "" } else { enum_key(a, ar, ename_path) };
    out.push_str(indent); out.push_str("{\n");
    if scalar { out.push_str(inner); out.push_str(c_decl(a, ar, scrutinee.ty, "__m")); out.push_str(";\n"); }
    else { out.push_str(inner); out.push_str("struct "); out.push_str(cname); out.push_str(" __m;\n"); }
    emit_value_into_temp(a, ar, out, inner, cg, "__m", scrutinee);
    out.push_str(inner);
    if scalar { out.push_str("switch (__m) {\n"); } else { out.push_str("switch (__m.tag) {\n"); }
    let n = arms.length();
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < n {
        out.push_str(inner);
        emit_case_labels(a, out, inner, cname, &sl[i], i == n - 1 as u32);
        out.push_str(case_indent); out.push_str("{\n");
        emit_switch_binds(a, ar, out, body_indent, cg, ename_path, scrutinee, &sl[i]);
        emit_arm_result(a, ar, out, body_indent, cg, assign_to, &sl[i]);
        if !sl[i].tdiverges { out.push_str(body_indent); out.push_str("break;\n"); }
        out.push_str(case_indent); out.push_str("}\n");
        i = i + 1 as u32;
    }
    out.push_str(inner); out.push_str("}\n");
    out.push_str(indent); out.push_str("}\n");
}

// ===== Stage (f): function signature + body =====
//
// gen_block is the function-body walker: it threads the defer chain, flushes
// it LIFO on every `return` (capturing a block-shaped or defer-guarded value
// into `__exile_ret` first), and dispatches simple statements to stage (d),
// `if` to gen_if, matches through emit_simple_stmt.  emit_simple_stmt's own
// TIf/TWhile leaf forms are for defer bodies; the real body control flow
// (return-aware) lives here.

fn emit_cleanups(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, defers: *const Vec<Vec<Tstmt>>) {
    let sl = defers.as_slice();
    let mut i = 0 as u32;
    while i < defers.length() { emit_stmts(a, ar, out, indent, cg, &sl[i]); i = i + 1 as u32; }
}

// The first `k` entries of a LIFO chain — the defers registered since the innermost
// loop began, which is what a `break` / `continue` must run (P3).
fn emit_cleanups_upto(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, defers: *const Vec<Vec<Tstmt>>, k: u32) {
    let sl = defers.as_slice();
    let mut i = 0 as u32;
    while i < k && i < defers.length() { emit_stmts(a, ar, out, indent, cg, &sl[i]); i = i + 1 as u32; }
}

// reverse(my_defers) ++ outer — the full LIFO defer chain at a point.
fn flatten_defers(a: Allocator, my_defers: *const Vec<Vec<Tstmt>>, outer: *const Vec<Vec<Tstmt>>) -> Vec<Vec<Tstmt>> {
    let mut out: Vec<Vec<Tstmt>> = Vec::with_capacity(a, 8 as u32);
    let msl = my_defers.as_slice();
    let n = my_defers.length();
    let mut i = n;
    while i > 0 as u32 { out.push(copy_tstmts(a, &msl[i - 1 as u32])); i = i - 1 as u32; }
    let osl = outer.as_slice();
    let mut j = 0 as u32;
    while j < outer.length() { out.push(copy_tstmts(a, &osl[j])); j = j + 1 as u32; }
    return out;
}
fn copy_tstmts(a: Allocator, src: *const Vec<Tstmt>) -> Vec<Tstmt> {
    let mut out: Vec<Tstmt> = Vec::with_capacity(a, 8 as u32);
    let sl = src.as_slice();
    let mut i = 0 as u32;
    while i < src.length() { out.push(sl[i]); i = i + 1 as u32; }
    return out;
}
fn set_defers(cg: *const Cg, chain: *const Vec<Vec<Tstmt>>) {
    let mut nv: Vec<Vec<Tstmt>> = Vec::with_capacity(default_allocator(), 8 as u32);
    let sl = chain.as_slice();
    let mut i = 0 as u32;
    while i < chain.length() { nv.push(copy_tstmts(default_allocator(), &sl[i])); i = i + 1 as u32; }
    *cg.cg_defers = nv;
}

fn value_needs_block(v: *const Texpr) -> bool {
    return match v.e {
        TexprNode::TTupleLit(_e) => true | TexprNode::TStructLit { sname_path, fields, base } => true
        | TexprNode::TNew { sname_path, fields, base, alloc } => true | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => true
        | TexprNode::TMatch { scrutinee, ename_path, arms } => true | TexprNode::TEnumLit { ename_path, variant, tag, args } => true
        | TexprNode::TIfExpr { cond, then_val, else_val } => true | TexprNode::TArrayLit(_e2) => true
        | TexprNode::TArrayRepeat { value, count } => true | _o => false
    };
}

fn emit_return(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, value: Option<*const Texpr>, all: *const Vec<Vec<Tstmt>>) {
    match value {
        Option::None => { emit_cleanups(a, ar, out, indent, cg, all); out.push_str(indent); out.push_str("return;\n"); }
        | Option::Some(v) => emit_return_value(a, ar, out, indent, cg, v, all)
    }
}
fn emit_return_value(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, v: *const Texpr, all: *const Vec<Vec<Tstmt>>) {
    let needs = all.length() > 0 as u32 || value_needs_block(v);
    if !needs { out.push_str(indent); out.push_str("return "); gen_expr(a, ar, out, cg, v); out.push_str(";\n"); return; }
    let inner = cg_indent(a, ar, indent);
    out.push_str(indent); out.push_str("{\n");
    out.push_str(inner); out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, v.ty))); out.push_str(" __exile_ret;\n");
    emit_value_into_temp(a, ar, out, inner, cg, "__exile_ret", v);
    emit_cleanups(a, ar, out, inner, cg, all);
    out.push_str(inner); out.push_str("return __exile_ret;\n");
    out.push_str(indent); out.push_str("}\n");
}

fn gen_if(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, outer: *const Vec<Vec<Tstmt>>, my_defers: *const Vec<Vec<Tstmt>>, cond: *const Texpr, then_body: *const Vec<Tstmt>, else_body: *const Vec<Tstmt>) {
    out.push_str("if ("); gen_expr(a, ar, out, cg, cond); out.push_str(") {\n");
    let nested = flatten_defers(a, my_defers, outer);
    gen_block(a, ar, out, cg_indent(a, ar, indent), cg, &nested, then_body);
    out.push_str(indent); out.push_str("}");
    if else_body.length() == 0 as u32 { out.push_str("\n"); return; }
    // `else if` chain: a lone TIf in the else body flattens (no extra braces).
    if is_lone_if(else_body) {
        match else_body.as_slice()[0 as u32] {
            Tstmt::TIf { cond: ec, then_body: et, else_body: ee } => { out.push_str(" else "); gen_if(a, ar, out, indent, cg, outer, my_defers, ec, &et, &ee); }
            | _o => {}
        }
        return;
    }
    out.push_str(" else {\n");
    gen_block(a, ar, out, cg_indent(a, ar, indent), cg, &nested, else_body);
    out.push_str(indent); out.push_str("}\n");
}
fn is_lone_if(body: *const Vec<Tstmt>) -> bool {
    if body.length() != 1 as u32 { return false; }
    return match body.as_slice()[0 as u32] { Tstmt::TIf { cond, then_body, else_body } => true | _o => false };
}

pub fn gen_block(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, outer: *const Vec<Vec<Tstmt>>, stmts: *const Vec<Tstmt>) {
    let mut my_defers: Vec<Vec<Tstmt>> = Vec::with_capacity(a, 8 as u32);
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    let mut returned = false;
    while i < stmts.length() {
        let chain = flatten_defers(a, &my_defers, outer);
        set_defers(cg, &chain);
        match sl[i] {
            Tstmt::TDefer { body, pos } => my_defers.push(copy_tstmts(a, &body))
            | Tstmt::TReturn { value, pos } => {
                // A return terminates the block: emit it (emit_return flushes
                // the reversed defer chain).  The oracle discards any statements
                // past the return and emits no fall-through cleanup.
                emit_return(a, ar, out, indent, cg, value, &chain);
                returned = true;
            }
            // A loop jump leaves every scope opened inside the loop, so it runs
            // their defers — LIFO, down to the loop's watermark — before jumping
            // (P3; before this, `break` silently swallowed them).
            | Tstmt::TBreak(bp) => {
                emit_cleanups_upto(a, ar, out, indent, cg, &chain, chain.length() - *cg.cg_loopmark);
                out.push_str(indent); out.push_str("break;\n");
                returned = true;
            }
            | Tstmt::TContinue(cp) => {
                emit_cleanups_upto(a, ar, out, indent, cg, &chain, chain.length() - *cg.cg_loopmark);
                out.push_str(indent); out.push_str("continue;\n");
                returned = true;
            }
            // The seal's body already carries its token binding and the `defer`
            // that restores it, so this opens a C scope and hands the body to
            // gen_block — every exit path is served by the defer machinery, and
            // seal contributes no exit code of its own.
            | Tstmt::TSeal { body, pos } => {
                out.push_str(indent); out.push_str("{\n");
                gen_block(a, ar, out, cg_indent(a, ar, indent), cg, &chain, &body);
                out.push_str(indent); out.push_str("}\n");
            }
            | Tstmt::TLetTuple { names, value, pos } => emit_let_tuple(a, ar, out, indent, cg, &names, value)
            | Tstmt::TIf { cond, then_body, else_body } => { out.push_str(indent); gen_if(a, ar, out, indent, cg, outer, &my_defers, cond, &then_body, &else_body); }
            | Tstmt::TWhile { cond, body, post } => gen_while(a, ar, out, indent, cg, outer, &my_defers, cond, &body, &post)
            | _o => emit_simple_stmt(a, ar, out, indent, cg, &sl[i])
        }
        if returned { break; }
        i = i + 1 as u32;
    }
    if !returned {
        // Fall-through cleanup: this block's own defers only, LIFO (reverse of
        // registration order).  flatten_defers reverses my_defers; the empty
        // outer keeps enclosing-scope defers for their own block-end.
        let empty_outer: Vec<Vec<Tstmt>> = Vec::with_capacity(a, 8 as u32);
        let endchain = flatten_defers(a, &my_defers, &empty_outer);
        emit_cleanups(a, ar, out, indent, cg, &endchain);
    }
}

fn gen_while(a: Allocator, ar: *Arena, out: *StringBuilder, indent: str, cg: *const Cg, outer: *const Vec<Vec<Tstmt>>, my_defers: *const Vec<Vec<Tstmt>>, cond: *const Texpr, body: *const Vec<Tstmt>, post: *const Vec<Tstmt>) {
    out.push_str(indent);
    if post.length() == 0 as u32 { out.push_str("while ("); gen_expr(a, ar, out, cg, cond); out.push_str(") {\n"); }
    else { out.push_str("for (; "); gen_expr(a, ar, out, cg, cond); out.push_str("; "); emit_for_post(a, ar, out, cg, post); out.push_str(") {\n"); }
    let nested = flatten_defers(a, my_defers, outer);
    // Everything already on the chain belongs OUTSIDE this loop; a `break` must not
    // run it.  Saved and restored so nested loops each get their own watermark.
    let saved_mark = *cg.cg_loopmark;
    *cg.cg_loopmark = nested.length();
    gen_block(a, ar, out, cg_indent(a, ar, indent), cg, &nested, body);
    *cg.cg_loopmark = saved_mark;
    out.push_str(indent); out.push_str("}\n");
}

// `[extern|static ]<ret> <mangled>(<params>|void)[, ...]`; `main` is special.
fn emit_fn_sig(a: Allocator, ar: *Arena, out: *StringBuilder, tf: *const Tfunc) {
    if str::eq(tf.tf_func.name, "main") { out.push_str("int main(void)"); return; }
    if tf.tf_func.is_extern { out.push_str("extern "); }
    else if !tf.tf_func.is_pub { out.push_str("static "); }
    match tf.tf_ret_ty { Option::Some(rt) => out.push_str(c_type_prefix(a, ar, rt)) | Option::None => out.push_str("void ") }
    out.push_str(tf.tf_mangled);
    out.push_str("(");
    let ps = tf.tf_func.params.as_slice();
    let pts = tf.tf_param_tys.as_slice();
    if tf.tf_func.params.length() == 0 as u32 { out.push_str("void"); }
    else {
        let mut i = 0 as u32;
        while i < tf.tf_func.params.length() {
            if i > 0 as u32 { out.push_str(", "); }
            out.push_str(c_decl(a, ar, pts[i], ps[i].pname));
            i = i + 1 as u32;
        }
    }
    if tf.tf_func.is_variadic { out.push_str(", ..."); }
    out.push_str(")");
}

pub fn gen_function(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, tf: *const Tfunc) {
    emit_fn_sig(a, ar, out, tf);
    out.push_str(" {\n");
    let lsl = tf.tf_lets.as_slice();
    let mut i = 0 as u32;
    while i < tf.tf_lets.length() {
        out.push_str("    "); out.push_str(c_decl(a, ar, lsl[i].ty, lsl[i].name)); out.push_str(";\n");
        i = i + 1 as u32;
    }
    let empty: Vec<Vec<Tstmt>> = Vec::with_capacity(a, 8 as u32);
    let mut dchain: Vec<Vec<Tstmt>> = Vec::with_capacity(a, 8 as u32);
    let cg2 = Cg { cg_enums: cg.cg_enums, cg_structs: cg.cg_structs, cg_fill: cg.cg_fill, cg_ml: cg.cg_ml, cg_defers: &dchain, cg_loopmark: cg.cg_loopmark };
    gen_block(a, ar, out, "    ", &cg2, &empty, &tf.tf_body);
    if str::eq(tf.tf_func.name, "main") { out.push_str("    return 0;\n"); }
    out.push_str("}\n");
}

fn fn_concrete(tf: *const Tfunc) -> bool {
    let pts = tf.tf_param_tys.as_slice();
    let mut i = 0 as u32;
    while i < tf.tf_param_tys.length() { if !is_concrete(pts[i]) { return false; } i = i + 1 as u32; }
    return match tf.tf_ret_ty { Option::Some(rt) => is_concrete(rt) | Option::None => true };
}

// Stage-(f) driver entry: emit every concrete, non-extern function definition.
// (Full gen_program — includes / fwd-decls / DCE / ordering — is stage g; this
// reaches gen_function so the match emitter's mono instances are generated and
// the c/d/e/f emission is diffable per function.)
// ===== Dead-prelude elision =====
//
// A prelude-positioned fn nobody references is not emitted.  The port
// materializes the prelude on demand, so the only such fns are synthesized trait
// DEFAULTS: `@derive(Eq)` writes `Foo__ne` for every deriving type, but the
// oracle only emits the ones something calls.  Self-references do not count —
// a fn that only calls itself is still unreachable.
fn args_call_m_cg(args: *const Vec<*const Texpr>, m: str) -> bool {
    let sl = args.as_slice();
    let mut i = 0 as u32;
    while i < args.length() { if expr_calls_m_cg(sl[i], m) { return true; } i = i + 1 as u32; }
    return false;
}
fn arms_call_m_cg(arms: *const Vec<TmatchArm>, m: str) -> bool {
    let sl = arms.as_slice();
    let mut i = 0 as u32;
    while i < arms.length() {
        if expr_calls_m_cg(sl[i].tbody, m) { return true; }
        let gh = match sl[i].tguard { Option::Some(gg) => expr_calls_m_cg(gg, m) | Option::None => false };
        if gh { return true; }
        i = i + 1 as u32;
    }
    return false;
}
fn fields_call_m_cg(fields: *const Vec<TexprField>, m: str) -> bool {
    let sl = fields.as_slice();
    let mut i = 0 as u32;
    while i < fields.length() { if expr_calls_m_cg(sl[i].value, m) { return true; } i = i + 1 as u32; }
    return false;
}
fn opt_call_m_cg(o: Option<*const Texpr>, m: str) -> bool {
    return match o { Option::Some(e) => expr_calls_m_cg(e, m) | Option::None => false };
}
fn stmts_call_m_cg(stmts: *const Vec<Tstmt>, m: str) -> bool {
    let sl = stmts.as_slice();
    let mut i = 0 as u32;
    while i < stmts.length() { if stmt_calls_m_cg(&sl[i], m) { return true; } i = i + 1 as u32; }
    return false;
}
fn stmt_calls_m_cg(s: *const Tstmt, m: str) -> bool {
    return match *s {
        Tstmt::TLet { name, value, decl_ty, pos } => expr_calls_m_cg(value, m)
        | Tstmt::TLetTuple { names, value, pos } => expr_calls_m_cg(value, m)
        | Tstmt::TAssign { path, value, pos } => expr_calls_m_cg(value, m)
        | Tstmt::TAssignField { target, field, value, pos } => expr_calls_m_cg(target, m) || expr_calls_m_cg(value, m)
        | Tstmt::TAssignDeref { target, value, pos } => expr_calls_m_cg(target, m) || expr_calls_m_cg(value, m)
        | Tstmt::TAssignIndex { base, index, value, pos } => expr_calls_m_cg(base, m) || expr_calls_m_cg(index, m) || expr_calls_m_cg(value, m)
        | Tstmt::TReturn { value, pos } => match value { Option::Some(e) => expr_calls_m_cg(e, m) | Option::None => false }
        | Tstmt::TExprStmt(e) => expr_calls_m_cg(e, m)
        | Tstmt::TIf { cond, then_body, else_body } => expr_calls_m_cg(cond, m) || stmts_call_m_cg(&then_body, m) || stmts_call_m_cg(&else_body, m)
        | Tstmt::TWhile { cond, body, post } => expr_calls_m_cg(cond, m) || stmts_call_m_cg(&body, m) || stmts_call_m_cg(&post, m)
        | Tstmt::TDefer { body, pos } => stmts_call_m_cg(&body, m)
        | _leaf => false
    };
}
fn expr_calls_m_cg(te: *const Texpr, m: str) -> bool {
    return match te.e {
        TexprNode::TCall { mangled, args } => str::eq(mangled, m) || args_call_m_cg(&args, m)
        | TexprNode::TBuiltinCall { name, args } => args_call_m_cg(&args, m)
        | TexprNode::TIndirectCall { fn_expr, args } => expr_calls_m_cg(fn_expr, m) || args_call_m_cg(&args, m)
        | TexprNode::TNeg(s) => expr_calls_m_cg(s, m)
        | TexprNode::TBitNot(s) => expr_calls_m_cg(s, m)
        | TexprNode::TNot(s) => expr_calls_m_cg(s, m)
        | TexprNode::TRef(s) => expr_calls_m_cg(s, m)
        | TexprNode::TDeref(s) => expr_calls_m_cg(s, m)
        | TexprNode::TCast(s, ann) => expr_calls_m_cg(s, m)
        | TexprNode::TBinOp(op, l, r) => expr_calls_m_cg(l, m) || expr_calls_m_cg(r, m)
        | TexprNode::TFieldAccess { target, field } => expr_calls_m_cg(target, m)
        | TexprNode::TIndex { base, index } => expr_calls_m_cg(base, m) || expr_calls_m_cg(index, m)
        | TexprNode::TTupleLit(es) => args_call_m_cg(&es, m)
        | TexprNode::TArrayLit(es) => args_call_m_cg(&es, m)
        | TexprNode::TArrayRepeat { value, count } => expr_calls_m_cg(value, m)
        | TexprNode::TIfExpr { cond, then_val, else_val } => expr_calls_m_cg(cond, m) || expr_calls_m_cg(then_val, m) || expr_calls_m_cg(else_val, m)
        | TexprNode::TMatch { scrutinee, ename_path, arms } => expr_calls_m_cg(scrutinee, m) || arms_call_m_cg(&arms, m)
        | TexprNode::TBlock { stmts, trailing } => stmts_call_m_cg(&stmts, m) || opt_call_m_cg(trailing, m)
        | TexprNode::TNew { sname_path, fields, base, alloc } => fields_call_m_cg(&fields, m) || opt_call_m_cg(base, m) || opt_call_m_cg(alloc, m)
        | TexprNode::TNewEnum { ename_path, variant, tag, args, alloc } => fields_call_m_cg(&args, m) || opt_call_m_cg(alloc, m)
        | TexprNode::TStructLit { sname_path, fields, base } => fields_call_m_cg(&fields, m) || opt_call_m_cg(base, m)
        | TexprNode::TEnumLit { ename_path, variant, tag, args } => fields_call_m_cg(&args, m)
        | _leaf => false
    };
}
fn referenced_by(funcs: *const Vec<Tfunc>, m: str, skip: int) -> bool {
    let sl = funcs.as_slice();
    let mut i = 0 as u32;
    while i < funcs.length() {
        if i as int != skip {
            if stmts_call_m_cg(&sl[i].tf_body, m) { return true; }
        }
        i = i + 1 as u32;
    }
    return false;
}
fn fn_dead(tp: *const Tprogram, tf: *const Tfunc, idx: int) -> bool {
    if !str::eq(tf.tf_func.pos.file, "<prelude>") { return false; }
    if referenced_by(&tp.tp_funcs, tf.tf_mangled, idx) { return false; }
    let no_skip = 0 as int - 1 as int;
    if referenced_by(&tp.tp_pfree, tf.tf_mangled, no_skip) { return false; }
    if referenced_by(&tp.tp_pmeth, tf.tf_mangled, no_skip) { return false; }
    return true;
}

pub fn emit_all_functions(a: Allocator, ar: *Arena, tp: *const Tprogram, out: *StringBuilder) {
    let mut fillctr: u32 = 0 as u32;
    let mut mlctr: u32 = 0 as u32;
    let mut dchain: Vec<Vec<Tstmt>> = Vec::with_capacity(a, 8 as u32);
    let mut loopmark = 0 as u32;
    let cg = Cg { cg_enums: &tp.tp_enum_index, cg_structs: &tp.tp_struct_index, cg_fill: &fillctr, cg_ml: &mlctr, cg_defers: &dchain, cg_loopmark: &loopmark };
    // Prelude free-fns (str::*) emit first — the oracle prepends the prelude, so
    // they precede user free-fns in the definition section.
    // Emission order (measured against the oracle's prepended prelude):
    //   prelude free-fns | user free-fns | prelude non-generic methods |
    //   user impls + lifted + generic instances
    let pfl = tp.tp_pfree.as_slice();
    let mut ip = 0 as u32;
    while ip < tp.tp_pfree.length() {
        if fn_concrete(&pfl[ip]) && !pfl[ip].tf_func.is_extern {
            out.push_str("\n");
            gen_function(a, ar, out, &cg, &pfl[ip]);
        }
        ip = ip + 1 as u32;
    }
    let fsl = tp.tp_funcs.as_slice();
    let mut i = 0 as u32;
    while i < tp.tp_free_end && i < tp.tp_funcs.length() {
        if fn_concrete(&fsl[i]) && !fsl[i].tf_func.is_extern && !fn_dead(tp, &fsl[i], i as int) {
            out.push_str("\n");
            gen_function(a, ar, out, &cg, &fsl[i]);
        }
        i = i + 1 as u32;
    }
    let pml = tp.tp_pmeth.as_slice();
    let mut im = 0 as u32;
    while im < tp.tp_pmeth.length() {
        if fn_concrete(&pml[im]) && !pml[im].tf_func.is_extern {
            out.push_str("\n");
            gen_function(a, ar, out, &cg, &pml[im]);
        }
        im = im + 1 as u32;
    }
    let mut j = tp.tp_free_end;
    while j < tp.tp_funcs.length() {
        if fn_concrete(&fsl[j]) && !fsl[j].tf_func.is_extern && !fn_dead(tp, &fsl[j], j as int) {
            out.push_str("\n");
            gen_function(a, ar, out, &cg, &fsl[j]);
        }
        j = j + 1 as u32;
    }
}

// Stage (g): whole-file assembler.  Reproduces the oracle gen_program's
// section order and blank-line choreography for the host (non-freestanding)
// target: includes -> @c_include -> #define consts -> extern const/var ->
// fnptr+aggregate typedefs -> non-main fwd-decls -> fn bodies.  Each optional
// section is blank-prefixed when non-empty (oracle `emit_section`).  The
// per-body `\n` in emit_all_functions reproduces the oracle's always-blank
// after the fwd-decl section plus the blank-between-bodies.
//
// Workstream-B (prelude method bodies not yet elaborated into tp_funcs):
// transitive DCE of dead prelude fns, @debug printer synthesis, and the
// default_allocator helper's body-separation interaction are all no-ops today
// because no prelude fn reaches tp_funcs; they land with prelude elaboration.

// ===== @debug printer synthesis =====
//
// `@debug` structs / enums get a synthesized `<mangle>__debug(self)` printer
// (Rust-Debug shaped, printf-based).  Fwd-decls first so one printer can call
// another regardless of declaration order, then the bodies.  The user-facing
// header name comes from render_typ_user_facing: `Point` for a plain struct,
// `Pair<i32, bool>` for a generic instance — not the mangled `Pair_i32_bool`.

// Recover a mono instance's source-level rendering from the index: the sig's
// instance args are the type arguments, and the mangled suffix is stripped off
// the instance name to get the base.
fn find_struct_sig(structs: *const Vec<StructSig>, path: *const Vec<str>) -> int {
    let sl = structs.as_slice();
    let mut i = 0 as u32;
    while i < structs.length() { if path_eq_cg(&sl[i].sname_path, path) { return i as int; } i = i + 1 as u32; }
    return 0 as int - 1 as int;
}
fn find_enum_sig(enums: *const Vec<EnumSig>, path: *const Vec<str>) -> int {
    let sl = enums.as_slice();
    let mut i = 0 as u32;
    while i < enums.length() { if path_eq_cg(&sl[i].ename_path, path) { return i as int; } i = i + 1 as u32; }
    return 0 as int - 1 as int;
}
fn path_eq_cg(a: *const Vec<str>, b: *const Vec<str>) -> bool {
    if a.length() != b.length() { return false; }
    let sa = a.as_slice();
    let sb = b.as_slice();
    let mut i = 0 as u32;
    while i < a.length() { if !str::eq(sa[i], sb[i]) { return false; } i = i + 1 as u32; }
    return true;
}
fn strip_suffix_cg(a: Allocator, ar: *Arena, name: str, suffix: str) -> str {
    let nl = str::length(name);
    let sl2 = str::length(suffix);
    if nl <= sl2 { return name; }
    let nb = str::as_bytes(name);
    let sb2 = str::as_bytes(suffix);
    let off = nl - sl2;
    let mut i = 0 as u32;
    while i < sl2 { if nb[off + i] != sb2[i] { return name; } i = i + 1 as u32; }
    let mut out = StringBuilder::with_capacity(a, 32 as u32);
    let mut k = 0 as u32;
    while k < off { out.push_byte(nb[k]); k = k + 1 as u32; }
    return str::from_slice(ar, out.as_slice());
}
fn render_named_with_args(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                          path: *const Vec<str>, args: *const Vec<*const Typ>) -> str {
    let last = path_last_cg(path);
    let mut suf = StringBuilder::with_capacity(a, 32 as u32);
    let asl = args.as_slice();
    let mut i = 0 as u32;
    while i < args.length() { suf.push_str("_"); suf.push_str(mangle_typ(a, ar, asl[i])); i = i + 1 as u32; }
    let base = strip_suffix_cg(a, ar, last, str::from_slice(ar, suf.as_slice()));
    let mut sb = StringBuilder::with_capacity(a, 48 as u32);
    let psl = path.as_slice();
    let mut j = 0 as u32;
    while j + 1 as u32 < path.length() { sb.push_str(psl[j]); sb.push_str("::"); j = j + 1 as u32; }
    sb.push_str(base);
    sb.push_str("<");
    let mut k = 0 as u32;
    while k < args.length() {
        if k > 0 as u32 { sb.push_str(", "); }
        sb.push_str(render_typ_user_facing(a, ar, structs, enums, asl[k]));
        k = k + 1 as u32;
    }
    sb.push_str(">");
    return str::from_slice(ar, sb.as_slice());
}
fn path_last_cg(p: *const Vec<str>) -> str {
    if p.length() == 0 as u32 { return ""; }
    return p.as_slice()[p.length() - 1 as u32];
}
fn render_typ_user_facing(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
                          t: *const Typ) -> str {
    return match *t {
        Typ::TStruct(p) => {
            let si = find_struct_sig(structs, &p);
            if si < 0 as int { typ_name(a, ar, t) }
            else {
                match structs.as_slice()[si as u32].sinstance_args {
                    Option::Some(args) => { if args.length() > 0 as u32 { render_named_with_args(a, ar, structs, enums, &p, &args) } else { typ_name(a, ar, t) } }
                    | Option::None => typ_name(a, ar, t)
                }
            }
        }
        | Typ::TEnum(p) => {
            let ei = find_enum_sig(enums, &p);
            if ei < 0 as int { typ_name(a, ar, t) }
            else {
                match enums.as_slice()[ei as u32].einstance_args {
                    Option::Some(args) => { if args.length() > 0 as u32 { render_named_with_args(a, ar, structs, enums, &p, &args) } else { typ_name(a, ar, t) } }
                    | Option::None => typ_name(a, ar, t)
                }
            }
        }
        | Typ::TPtr(i) => rtuf_pfx(a, ar, structs, enums, "*", i)
        | Typ::TOwnPtr(i) => rtuf_pfx(a, ar, structs, enums, "own *", i)
        | Typ::TTuple(ts) => rtuf_tuple(a, ar, structs, enums, &ts)
        | _o => typ_name(a, ar, t)
    };
}
fn rtuf_pfx(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
            pfx: str, inner: *const Typ) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(pfx);
    sb.push_str(render_typ_user_facing(a, ar, structs, enums, inner));
    return str::from_slice(ar, sb.as_slice());
}
fn rtuf_tuple(a: Allocator, ar: *Arena, structs: *const Vec<StructSig>, enums: *const Vec<EnumSig>,
              ts: *const Vec<*const Typ>) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str("(");
    let sl = ts.as_slice();
    let mut i = 0 as u32;
    while i < ts.length() {
        if i > 0 as u32 { sb.push_str(", "); }
        sb.push_str(render_typ_user_facing(a, ar, structs, enums, sl[i]));
        i = i + 1 as u32;
    }
    sb.push_str(")");
    return str::from_slice(ar, sb.as_slice());
}
// `printf("<lit>");` with the literal C-escaped.
fn emit_dbg_lit(out: *StringBuilder, indent: str, lit: str) {
    out.push_str(indent);
    out.push_str("printf(\"");
    escape_c_into(out, lit);
    out.push_str("\");\n");
    return;
}
// One printf fragment rendering `access` (a C l-value of type `ty`), no newline.
fn emit_field_debug(a: Allocator, ar: *Arena, out: *StringBuilder, ty: *const Typ, access: str) {
    match *ty {
        Typ::TBool => { out.push_str("printf(\"%s\", ("); out.push_str(access); out.push_str(") ? \"true\" : \"false\")"); }
        | Typ::TString => { out.push_str("printf(\"\\\"%s\\\"\", "); out.push_str(access); out.push_str(")"); }
        | Typ::TPtr(_i) => { out.push_str("printf(\"%p\", (void*)("); out.push_str(access); out.push_str("))"); }
        | Typ::TOwnPtr(_i) => { out.push_str("printf(\"%p\", (void*)("); out.push_str(access); out.push_str("))"); }
        | Typ::TStruct(_p) => { out.push_str(mangle_typ(a, ar, ty)); out.push_str("__debug("); out.push_str(access); out.push_str(")"); }
        | Typ::TEnum(_p) => { out.push_str(mangle_typ(a, ar, ty)); out.push_str("__debug("); out.push_str(access); out.push_str(")"); }
        | _o => {
            let fm = print_fmt(ty);
            out.push_str("printf(\""); out.push_str(fm.f_spec); out.push_str("\", ");
            if str::eq(fm.f_cast, "") { out.push_str(access); }
            else { out.push_str("("); out.push_str(fm.f_cast); out.push_str(")("); out.push_str(access); out.push_str(")"); }
            out.push_str(")");
        }
    }
    return;
}
fn dbg_access(a: Allocator, ar: *Arena, prefix: str, field: str) -> str {
    let mut sb = StringBuilder::with_capacity(a, 32 as u32);
    sb.push_str(prefix);
    sb.push_str(field);
    return str::from_slice(ar, sb.as_slice());
}
fn emit_struct_debug_def(a: Allocator, ar: *Arena, out: *StringBuilder, structs: *const Vec<StructSig>,
                         enums: *const Vec<EnumSig>, s: *const StructSig) {
    let cname = mangle_typ(a, ar, ty_node(ar, Typ::TStruct(copy_strs_cg(a, &s.sname_path))));
    let name = render_typ_user_facing(a, ar, structs, enums, ty_node(ar, Typ::TStruct(copy_strs_cg(a, &s.sname_path))));
    out.push_str("static void "); out.push_str(cname); out.push_str("__debug(struct "); out.push_str(cname); out.push_str(" self) {\n");
    emit_dbg_lit(out, "    ", concat2(a, ar, name, " { "));
    let fs = s.sfields_ty.as_slice();
    let mut i = 0 as u32;
    while i < s.sfields_ty.length() {
        if i > 0 as u32 { emit_dbg_lit(out, "    ", ", "); }
        emit_dbg_lit(out, "    ", concat2(a, ar, fs[i].name, ": "));
        out.push_str("    ");
        emit_field_debug(a, ar, out, fs[i].ty, dbg_access(a, ar, "self.", fs[i].name));
        out.push_str(";\n");
        i = i + 1 as u32;
    }
    emit_dbg_lit(out, "    ", " }");
    out.push_str("}\n");
    return;
}
fn emit_enum_debug_def(a: Allocator, ar: *Arena, out: *StringBuilder, structs: *const Vec<StructSig>,
                       enums: *const Vec<EnumSig>, e: *const EnumSig) {
    let cname = mangle_typ(a, ar, ty_node(ar, Typ::TEnum(copy_strs_cg(a, &e.ename_path))));
    let name = render_typ_user_facing(a, ar, structs, enums, ty_node(ar, Typ::TEnum(copy_strs_cg(a, &e.ename_path))));
    out.push_str("static void "); out.push_str(cname); out.push_str("__debug(struct "); out.push_str(cname); out.push_str(" self) {\n");
    out.push_str("    switch (self.tag) {\n");
    let vs = e.evariants.as_slice();
    let mut i = 0 as u32;
    while i < e.evariants.length() {
        out.push_str("    case "); out.push_str(cname); out.push_str("_"); out.push_str(vs[i].vsname); out.push_str(":\n");
        emit_variant_debug(a, ar, out, cname, name, &vs[i]);
        out.push_str("        break;\n");
        i = i + 1 as u32;
    }
    out.push_str("    }\n");
    out.push_str("}\n");
    return;
}
fn emit_variant_debug(a: Allocator, ar: *Arena, out: *StringBuilder, _cname: str, name: str, v: *const VariantSig) {
    let hdr = concat2(a, ar, concat2(a, ar, name, "::"), v.vsname);
    if v.vsfields.length() == 0 as u32 { emit_dbg_lit(out, "        ", hdr); return; }
    let opener = if v.vsis_struct { " { " } else { "(" };
    emit_dbg_lit(out, "        ", concat2(a, ar, hdr, opener));
    let mut pfx = StringBuilder::with_capacity(a, 32 as u32);
    pfx.push_str("self.data."); pfx.push_str(v.vsname); pfx.push_str(".");
    let prefix = str::from_slice(ar, pfx.as_slice());
    let fs = v.vsfields.as_slice();
    let mut i = 0 as u32;
    while i < v.vsfields.length() {
        if i > 0 as u32 { emit_dbg_lit(out, "        ", ", "); }
        if v.vsis_struct { emit_dbg_lit(out, "        ", concat2(a, ar, fs[i].name, ": ")); }
        out.push_str("        ");
        emit_field_debug(a, ar, out, fs[i].ty, dbg_access(a, ar, prefix, fs[i].name));
        out.push_str(";\n");
        i = i + 1 as u32;
    }
    let closer = if v.vsis_struct { " }" } else { ")" };
    emit_dbg_lit(out, "        ", closer);
    return;
}
// The `@debug` section: fwd-decls then bodies, right after the aggregate typedefs.
pub fn emit_debug_printers(a: Allocator, ar: *Arena, tp: *const Tprogram, out: *StringBuilder) {
    let ssl = tp.tp_struct_index.as_slice();
    let esl = tp.tp_enum_index.as_slice();
    let mut n = 0 as u32;
    let mut i = 0 as u32;
    while i < tp.tp_struct_index.length() {
        if ssl[i].sis_debug && fields_concrete(&ssl[i].sfields_ty) { n = n + 1 as u32; }
        i = i + 1 as u32;
    }
    let mut j = 0 as u32;
    while j < tp.tp_enum_index.length() {
        if esl[j].eis_debug && enum_concrete(&esl[j]) { n = n + 1 as u32; }
        j = j + 1 as u32;
    }
    if n == 0 as u32 { return; }
    out.push_str("\n");
    let mut k = 0 as u32;
    while k < tp.tp_struct_index.length() {
        if ssl[k].sis_debug && fields_concrete(&ssl[k].sfields_ty) {
            let cn = mangle_typ(a, ar, ty_node(ar, Typ::TStruct(copy_strs_cg(a, &ssl[k].sname_path))));
            out.push_str("static void "); out.push_str(cn); out.push_str("__debug(struct "); out.push_str(cn); out.push_str(" self);\n");
        }
        k = k + 1 as u32;
    }
    let mut m = 0 as u32;
    while m < tp.tp_enum_index.length() {
        if esl[m].eis_debug && enum_concrete(&esl[m]) {
            let cne = mangle_typ(a, ar, ty_node(ar, Typ::TEnum(copy_strs_cg(a, &esl[m].ename_path))));
            out.push_str("static void "); out.push_str(cne); out.push_str("__debug(struct "); out.push_str(cne); out.push_str(" self);\n");
        }
        m = m + 1 as u32;
    }
    out.push_str("\n");
    let mut p = 0 as u32;
    while p < tp.tp_struct_index.length() {
        if ssl[p].sis_debug && fields_concrete(&ssl[p].sfields_ty) {
            emit_struct_debug_def(a, ar, out, &tp.tp_struct_index, &tp.tp_enum_index, &ssl[p]);
            out.push_str("\n");
        }
        p = p + 1 as u32;
    }
    let mut q = 0 as u32;
    while q < tp.tp_enum_index.length() {
        if esl[q].eis_debug && enum_concrete(&esl[q]) {
            emit_enum_debug_def(a, ar, out, &tp.tp_struct_index, &tp.tp_enum_index, &esl[q]);
            out.push_str("\n");
        }
        q = q + 1 as u32;
    }
    return;
}

pub fn gen_program(a: Allocator, ar: *Arena, tp: *const Tprogram, out: *StringBuilder) {
    out.push_str("#include <stdio.h>\n");
    if tp.tp_uses_heap { out.push_str("#include <stdlib.h>\n"); }
    if tp.tp_uses_string_h { out.push_str("#include <string.h>\n"); }

    let cin = tp.tp_c_includes.as_slice();
    let mut ci = 0 as u32;
    while ci < tp.tp_c_includes.length() {
        out.push_str("#include \""); out.push_str(cin[ci]); out.push_str("\"\n");
        ci = ci + 1 as u32;
    }

    if tp.tp_consts.length() > 0 as u32 {
        out.push_str("\n");
        let cs = tp.tp_consts.as_slice();
        let mut di = 0 as u32;
        while di < tp.tp_consts.length() {
            out.push_str("#define "); out.push_str(cs[di].a); out.push_str(" "); out.push_str(cs[di].b); out.push_str("\n");
            di = di + 1 as u32;
        }
    }
    if tp.tp_ext_consts.length() > 0 as u32 {
        out.push_str("\n");
        let es = tp.tp_ext_consts.as_slice();
        let mut eci = 0 as u32;
        while eci < tp.tp_ext_consts.length() {
            out.push_str("extern const "); out.push_str(c_decl(a, ar, es[eci].ty, es[eci].name)); out.push_str(";\n");
            eci = eci + 1 as u32;
        }
    }
    if tp.tp_ext_vars.length() > 0 as u32 {
        out.push_str("\n");
        let vs = tp.tp_ext_vars.as_slice();
        let mut evi = 0 as u32;
        while evi < tp.tp_ext_vars.length() {
            out.push_str("extern "); out.push_str(c_decl(a, ar, vs[evi].ty, vs[evi].name)); out.push_str(";\n");
            evi = evi + 1 as u32;
        }
    }
    if tp.tp_runes.length() > 0 as u32 {
        out.push_str("\n");
        let rs = tp.tp_runes.as_slice();
        let mut ri = 0 as u32;
        while ri < tp.tp_runes.length() {
            emit_rune_global(a, ar, out, &rs[ri]);
            ri = ri + 1 as u32;
        }
    }

    emit_type_decls(a, ar, tp, out);
    emit_debug_printers(a, ar, tp, out);

    let pfl = tp.tp_pfree.as_slice();
    let pml = tp.tp_pmeth.as_slice();
    let fsl = tp.tp_funcs.as_slice();
    let mut nnm = 0 as u32;
    let mut kp = 0 as u32;
    while kp < tp.tp_pfree.length() {
        if fn_concrete(&pfl[kp]) && !str::eq(pfl[kp].tf_func.name, "main") { nnm = nnm + 1 as u32; }
        kp = kp + 1 as u32;
    }
    let mut km = 0 as u32;
    while km < tp.tp_pmeth.length() {
        if fn_concrete(&pml[km]) && !str::eq(pml[km].tf_func.name, "main") { nnm = nnm + 1 as u32; }
        km = km + 1 as u32;
    }
    let mut k = 0 as u32;
    while k < tp.tp_funcs.length() {
        if fn_concrete(&fsl[k]) && !str::eq(fsl[k].tf_func.name, "main") && !fn_dead(tp, &fsl[k], k as int) { nnm = nnm + 1 as u32; }
        k = k + 1 as u32;
    }
    if nnm > 0 as u32 || tp.tp_uses_default_allocator {
        out.push_str("\n");
        // The sys-seam externs are real Tfuncs in tp_pfree now (demand-driven,
        // in `mod sys` declaration order), so they emit with everything else.
        let mut jp = 0 as u32;
        while jp < tp.tp_pfree.length() {
            if fn_concrete(&pfl[jp]) && !str::eq(pfl[jp].tf_func.name, "main") {
                emit_fn_sig(a, ar, out, &pfl[jp]);
                out.push_str(";\n");
            }
            jp = jp + 1 as u32;
        }
        let mut j = 0 as u32;
        while j < tp.tp_free_end && j < tp.tp_funcs.length() {
            if fn_concrete(&fsl[j]) && !str::eq(fsl[j].tf_func.name, "main") && !fn_dead(tp, &fsl[j], j as int) {
                emit_fn_sig(a, ar, out, &fsl[j]);
                out.push_str(";\n");
            }
            j = j + 1 as u32;
        }
        let mut jm = 0 as u32;
        while jm < tp.tp_pmeth.length() {
            if fn_concrete(&pml[jm]) && !str::eq(pml[jm].tf_func.name, "main") {
                emit_fn_sig(a, ar, out, &pml[jm]);
                out.push_str(";\n");
            }
            jm = jm + 1 as u32;
        }
        let mut jj = tp.tp_free_end;
        while jj < tp.tp_funcs.length() {
            if fn_concrete(&fsl[jj]) && !str::eq(fsl[jj].tf_func.name, "main") && !fn_dead(tp, &fsl[jj], jj as int) {
                emit_fn_sig(a, ar, out, &fsl[jj]);
                out.push_str(";\n");
            }
            jj = jj + 1 as u32;
        }
    }

    // The helper is emitted AFTER the extern fwd-decls, before any fn body.
    if tp.tp_uses_default_allocator {
        out.push_str("\n\nstatic struct ex_Allocator exile_default_allocator(void) {\n");
        out.push_str("    struct ex_Allocator a;\n");
        out.push_str("    a.state = 0;\n");
        out.push_str("    a.alloc_fn = sys_alloc;\n");
        out.push_str("    a.free_fn = sys_free;\n");
        out.push_str("    return a;\n");
        out.push_str("}\n");
    }

    emit_all_functions(a, ar, tp, out);
}

// ===== Stage (h): builtin call emitters =====
//
// Host (non-freestanding) lowering of the print/free/mem builtins.  print /
// println of a scalar/string picks a printf format + optional widening cast
// byte-exact with the oracle's emit_print_impl; a `@debug` aggregate dispatches
// to its synthesized `<mangle>__debug` printer.  (Display-dispatched println is
// lowered to a writer-pattern block in typed-IR before codegen; only the
// primitive println reaches here.)  --freestanding routing is stage-g.

struct Fmt { f_spec: str, f_cast: str }
fn int_spec_k(k: IntKind) -> Fmt {
    let w32 = match k.width { IntWidth::W32 => true | _o => false };
    if w32 {
        if k.is_signed { return Fmt { f_spec: "%ld", f_cast: "long" }; }
        return Fmt { f_spec: "%lu", f_cast: "unsigned long" };
    }
    if k.is_signed { return Fmt { f_spec: "%d", f_cast: "" }; }
    return Fmt { f_spec: "%u", f_cast: "" };
}
fn print_fmt(t: *const Typ) -> Fmt {
    return match *t {
        Typ::TBool => Fmt { f_spec: "%d", f_cast: "" }
        | Typ::TString => Fmt { f_spec: "%s", f_cast: "" }
        | Typ::TFloat(w) => match w { FloatWidth::F32 => Fmt { f_spec: "%g", f_cast: "double" } | FloatWidth::F64 => Fmt { f_spec: "%g", f_cast: "" } }
        | Typ::TInt(k) => int_spec_k(k)
        | Typ::TCInt { is_signed } => { if is_signed { Fmt { f_spec: "%d", f_cast: "" } } else { Fmt { f_spec: "%u", f_cast: "" } } }
        | _o => Fmt { f_spec: "%d", f_cast: "" }
    };
}
fn is_aggregate_ty(t: *const Typ) -> bool {
    return match *t { Typ::TStruct(_p) => true | Typ::TEnum(_p) => true | _o => false };
}
fn emit_print_impl(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, newline: bool, args: *const Vec<*const Texpr>) {
    let arg = args.as_slice()[0 as u32];
    if is_aggregate_ty(arg.ty) {
        out.push_str(mangle_typ(a, ar, arg.ty)); out.push_str("__debug(");
        gen_expr(a, ar, out, cg, arg);
        out.push_str(")");
        if newline { out.push_str("; printf(\"\\n\")"); }
        return;
    }
    let fm = print_fmt(arg.ty);
    out.push_str("printf(\""); out.push_str(fm.f_spec);
    if newline { out.push_str("\\n"); }
    out.push_str("\", ");
    if str::eq(fm.f_cast, "") { gen_expr(a, ar, out, cg, arg); }
    else { out.push_str("("); out.push_str(fm.f_cast); out.push_str(")("); gen_expr(a, ar, out, cg, arg); out.push_str(")"); }
    out.push_str(")");
}

fn emit_free_builtin(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, args: *const Vec<*const Texpr>) {
    let sl = args.as_slice();
    let alloc = sl[0 as u32];
    let ptr = sl[1 as u32];
    let pointee = match *ptr.ty { Typ::TOwnPtr(inner) => inner | _o => ptr.ty };
    out.push_str("(");
    gen_expr(a, ar, out, cg, alloc); out.push_str(".free_fn)(");
    gen_expr(a, ar, out, cg, alloc); out.push_str(".state, ((void *)");
    gen_expr(a, ar, out, cg, ptr); out.push_str("), ((unsigned long)sizeof(");
    out.push_str(strip_trailing_space(ar, c_type_prefix(a, ar, pointee)));
    out.push_str(")))");
}

fn emit_builtin(a: Allocator, ar: *Arena, out: *StringBuilder, cg: *const Cg, name: str, args: *const Vec<*const Texpr>) {
    let sl = args.as_slice();
    if str::eq(name, "print") { emit_print_impl(a, ar, out, cg, false, args); return; }
    if str::eq(name, "println") { emit_print_impl(a, ar, out, cg, true, args); return; }
    if str::eq(name, "free") { emit_free_builtin(a, ar, out, cg, args); return; }
    if str::eq(name, "ptr_offset") { out.push_str("("); gen_expr(a, ar, out, cg, sl[0 as u32]); out.push_str(" + "); gen_expr(a, ar, out, cg, sl[1 as u32]); out.push_str(")"); return; }
    if str::eq(name, "cstr_len") { out.push_str("((unsigned long)strlen("); gen_expr(a, ar, out, cg, sl[0 as u32]); out.push_str("))"); return; }
    if str::eq(name, "mem_zero") { out.push_str("memset("); gen_expr(a, ar, out, cg, sl[0 as u32]); out.push_str(", 0, "); gen_expr(a, ar, out, cg, sl[1 as u32]); out.push_str(")"); return; }
    if str::eq(name, "default_allocator") { out.push_str("exile_default_allocator()"); return; }
    if str::eq(name, "type_name") {
        // A mono instance reads back as the user wrote it (`Result<i32, str>`, not
        // `Result_i32_str`), which needs the struct/enum indices for the instance
        // args — they ride in Cg.
        out.push_str("((void)sizeof("); gen_expr(a, ar, out, cg, sl[0 as u32]); out.push_str("), \"");
        out.push_str(render_typ_user_facing(a, ar, cg.cg_structs, cg.cg_enums, sl[0 as u32].ty)); out.push_str("\")"); return;
    }
    out.push_str("/*builtin:"); out.push_str(name); out.push_str("*/");
}
// The SOURCE-facing type name `type_name(x)` renders (`Point`, `*const Vec<int>`)
// — the user writes exile, so they read exile back, not the C mangling.  Full
// port of ir.ml's typ_name.
