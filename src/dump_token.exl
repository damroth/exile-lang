// Self-host port — the `--emit-tokens` half of `lib/dump.ml`.
//
// Split out from the AST/IR dumper so a token-only driver (the lexer
// corpus harness) pulls in just this stage, not the AST/IR renderers
// and their generic `Vec` instantiations.  Shared string escaping comes
// from `dump_util`.
//
// One token per line, `<render_token> @<file>:<line>:<col>`.  The lexer
// carries only a start anchor per token (no end-span), so a single
// position is emitted.  Unit tokens render as their CamelCase tag;
// payload tokens carry their value.  `Float`'s value is deferred (`??`,
// matching the IR/AST `%h` float deferral) until a `f64 -> str`
// formatter lands; the f32/f64 width tag is exact.

use token::*;
use dump_util::*;

fn render_token(t: *const Token, out: *StringBuilder) {
    match *t {
        Token::Ident(s) => {
            out.push_str("(Ident ");
            out.push_str(s);
            out.push_str(")");
        }
        | Token::Int(n) => {
            out.push_str("(Int ");
            out.push_int(n);
            out.push_str(")");
        }
        | Token::Float(f, is32) => {
            out.push_str("(Float ");
            fmt_hexfloat(out, f);
            out.push_str(" ");
            if is32 { out.push_str("f32"); } else { out.push_str("f64"); }
            out.push_str(")");
        }
        | Token::String(s) => {
            out.push_str("(String ");
            escape_string(s, out);
            out.push_str(")");
        }
        | Token::Fn => { out.push_str("Fn"); }
        | Token::Let => { out.push_str("Let"); }
        | Token::Mut => { out.push_str("Mut"); }
        | Token::Return => { out.push_str("Return"); }
        | Token::If => { out.push_str("If"); }
        | Token::Else => { out.push_str("Else"); }
        | Token::While => { out.push_str("While"); }
        | Token::Loop => { out.push_str("Loop"); }
        | Token::Break => { out.push_str("Break"); }
        | Token::Continue => { out.push_str("Continue"); }
        | Token::For => { out.push_str("For"); }
        | Token::In => { out.push_str("In"); }
        | Token::Mod => { out.push_str("Mod"); }
        | Token::Pub => { out.push_str("Pub"); }
        | Token::Use => { out.push_str("Use"); }
        | Token::As => { out.push_str("As"); }
        | Token::Defer => { out.push_str("Defer"); }
        | Token::Struct => { out.push_str("Struct"); }
        | Token::Impl => { out.push_str("Impl"); }
        | Token::Trait => { out.push_str("Trait"); }
        | Token::View => { out.push_str("View"); }
        | Token::With => { out.push_str("With"); }
        | Token::Enum => { out.push_str("Enum"); }
        | Token::Match => { out.push_str("Match"); }
        | Token::FatArrow => { out.push_str("FatArrow"); }
        | Token::Pipe => { out.push_str("Pipe"); }
        | Token::PipePipe => { out.push_str("PipePipe"); }
        | Token::PipeGt => { out.push_str("PipeGt"); }
        | Token::AmpAmp => { out.push_str("AmpAmp"); }
        | Token::Dot => { out.push_str("Dot"); }
        | Token::DotDot => { out.push_str("DotDot"); }
        | Token::DotDotEq => { out.push_str("DotDotEq"); }
        | Token::Amp => { out.push_str("Amp"); }
        | Token::New => { out.push_str("New"); }
        | Token::Own => { out.push_str("Own"); }
        | Token::Rune => { out.push_str("Rune"); }
        | Token::Ward => { out.push_str("Ward"); }
        | Token::Sigil => { out.push_str("Sigil"); }
        | Token::Null => { out.push_str("Null"); }
        | Token::LParen => { out.push_str("LParen"); }
        | Token::RParen => { out.push_str("RParen"); }
        | Token::LBrace => { out.push_str("LBrace"); }
        | Token::RBrace => { out.push_str("RBrace"); }
        | Token::LBracket => { out.push_str("LBracket"); }
        | Token::RBracket => { out.push_str("RBracket"); }
        | Token::Semicolon => { out.push_str("Semicolon"); }
        | Token::Comma => { out.push_str("Comma"); }
        | Token::Colon => { out.push_str("Colon"); }
        | Token::DoubleColon => { out.push_str("DoubleColon"); }
        | Token::Arrow => { out.push_str("Arrow"); }
        | Token::Eq => { out.push_str("Eq"); }
        | Token::EqEq => { out.push_str("EqEq"); }
        | Token::NotEq => { out.push_str("NotEq"); }
        | Token::Bang => { out.push_str("Bang"); }
        | Token::Lt => { out.push_str("Lt"); }
        | Token::Gt => { out.push_str("Gt"); }
        | Token::LtEq => { out.push_str("LtEq"); }
        | Token::GtEq => { out.push_str("GtEq"); }
        | Token::Plus => { out.push_str("Plus"); }
        | Token::PlusPlus => { out.push_str("PlusPlus"); }
        | Token::Minus => { out.push_str("Minus"); }
        | Token::Star => { out.push_str("Star"); }
        | Token::Slash => { out.push_str("Slash"); }
        | Token::Percent => { out.push_str("Percent"); }
        | Token::Caret => { out.push_str("Caret"); }
        | Token::Tilde => { out.push_str("Tilde"); }
        | Token::Shl => { out.push_str("Shl"); }
        | Token::Shr => { out.push_str("Shr"); }
        | Token::True => { out.push_str("True"); }
        | Token::False => { out.push_str("False"); }
        | Token::Question => { out.push_str("Question"); }
        | Token::Orelse => { out.push_str("Orelse"); }
        | Token::Try => { out.push_str("Try"); }
        | Token::Extern => { out.push_str("Extern"); }
        | Token::Ellipsis => { out.push_str("Ellipsis"); }
        | Token::At => { out.push_str("At"); }
        | Token::Type => { out.push_str("Type"); }
        | Token::Const => { out.push_str("Const"); }
        | Token::Var => { out.push_str("Var"); }
        | Token::SizeOf => { out.push_str("SizeOf"); }
        | Token::Eof => { out.push_str("Eof"); }
    }
}

// `dump_tokens` — one `<token> @<file>:<line>:<col>` line per token,
// under the `;; exile-tokens-dump v1 <file>` header.  Mirrors OCaml
// `dump_tokens`.
pub fn dump_tokens(toks: *const Vec<TokenPos>, file: str, out: *StringBuilder) {
    out.push_str(";; exile-tokens-dump v1 ");
    out.push_str(file);
    out.push_str("\n");
    let n = toks.length();
    let sl = toks.as_slice();
    let mut i = 0 as u32;
    while i < n {
        render_token(&sl[i].tok, out);
        out.push_str(" @");
        out.push_str(sl[i].pos.file);
        out.push_str(":");
        out.push_int(sl[i].pos.line);
        out.push_str(":");
        out.push_int(sl[i].pos.col);
        out.push_str("\n");
        i = i + 1 as u32;
    }
}
