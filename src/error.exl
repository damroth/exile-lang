// Self-host port — `lib/error.ml` (the compile-error type).
//
// OCaml raises `Compile_error {pos; msg}` from any depth and catches it
// once at the top level.  Exile has no exceptions, so the error is a
// VALUE threaded through `Result<T, *const CompileError>` via `try`
// (same error type in and out, the Ok payload may differ).  The error
// lives in the same arena as the tree being built, so it outlives the
// `try` chain that carries it up to `main`.
//
// `Display` renders the first line of the OCaml `show_error` diagnostic;
// the source-line + caret it adds are a driver-level presentation layer,
// not part of the error value.

use pos::*;

pub struct CompileError {
    pos: Pos,
    msg: str,
}

// Backstop for arena exhaustion, shared across the port's node allocators.
// The arena contract returns null when full (the caller picks capacity — see
// arena.exl, which deliberately exhausts a tiny arena and checks for null);
// node construction REQUIRES success, so a null means the corpus under-sized
// the arena for this input.  Abort loudly in the allocator frame rather than
// writing through the null pointer: a silent `*0x0` reads as a generic crash
// (root-caused 2026-06-30 via ASan — token sat 88 bytes under a fixed cap).
// With tc_corpus's source-proportional sizing this never fires for real
// inputs; it turns any future mis-size from UB into a clean SIGABRT.
mod raw { extern fn abort(); }
pub fn arena_oom() { raw::abort(); }

// A state the compiler believes cannot happen.  Abort LOUDLY rather than emit
// something plausible: a placeholder that reaches the output ("<ctype?>", a NULL
// where a value was wanted) turns a compiler bug into a confusing error from `cc`,
// or worse into code that runs.  The reference does the same (`failwith "TNullPtr
// should never reach c_type_prefix"`).
pub fn ice(msg: str) {
    let m = str::as_bytes(msg);
    sys::sys_write(2 as c_int, &m[0] as *const c_uchar, str::length(msg) as c_ulong);
    let nl = str::as_bytes("\n");
    sys::sys_write(2 as c_int, &nl[0] as *const c_uchar, 1 as c_ulong);
    raw::abort();
}

// The source prelude is compiler-internal: a tokenize / parse failure there is
// an ICE, never a user error.  Swallowing it (returning an empty item list)
// silently disables the ENTIRE prelude registry, which surfaces downstream as a
// mass diff with no stated cause — the failure mode `arena_oom`'s "never
// silently" rule exists to prevent.  Print the position + message, then abort.
// Writes straight to fd 2: `abort()` does not flush stdio, so a buffered
// `print` would lose the message that makes this diagnosable at all.
pub fn prelude_ice(a: Allocator, e: *const CompileError) {
    let mut sb = StringBuilder::with_capacity(a, 160 as u32);
    sb.push_str("exilc internal error: the source prelude failed to parse: ");
    e.fmt(&sb);
    sb.push_str("\n");
    let sl = sb.as_slice();
    sys::sys_write(2 as c_int, &sl[0] as *const c_uchar, sb.length() as c_ulong);
    raw::abort();
}

// Allocate a `CompileError` in `ar` and hand back a read-only borrow —
// the shape the fallible stages return as `Result::Err(...)`.  Dynamic
// messages are built in a StringBuilder and interned with
// `str::from_slice` before being passed in as `msg`.
pub fn alloc(ar: *Arena, p: Pos, msg: str) -> *const CompileError {
    let e: *CompileError = ar.alloc_borrowed();
    if e == null { arena_oom(); }
    *e = CompileError { pos: p, msg: msg };
    return e as *const CompileError;
}

impl Display for CompileError {
    // `<file>:<line>:<col>: error: <msg>` — byte-for-byte the first line
    // the OCaml `show_error` prints (bin/main.ml).
    fn fmt(*const self, out: *StringBuilder) {
        out.push_str(self.pos.file);
        out.push_str(":");
        out.push_int(self.pos.line);
        out.push_str(":");
        out.push_int(self.pos.col);
        out.push_str(": error: ");
        out.push_str(self.msg);
    }
}
