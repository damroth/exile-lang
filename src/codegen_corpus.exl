// Self-host codegen — type-declaration section verification driver (stage b).
//
// Read a source path on stdin, run load / check / drop, then emit just the
// fn-ptr typedefs + topo-ordered aggregate typedefs (stage-(b) surface) and
// flush to stdout.  Diff against the same lines sliced from the oracle's
// `--c-out` (grep `^(struct |enum |typedef )`) — the aggregate topo order is
// the first codegen stage with a global ordering, so it is compared as a
// section, not per-type.

use pos;
use token::*;
use lexer::*;
use ast::*;
use ir::*;
use error::*;
use parser::*;
use loader::*;
use typecheck::*;
use drop::*;
use codegen::*;

fn read_all(fd: c_int, sb: *StringBuilder) {
    let mut buf: [u8; 4096] = [0 as u8; 4096];
    loop {
        let n: c_long = sys::sys_read(fd, &buf as *u8 as *c_uchar, 4096 as c_ulong);
        if n <= 0 as c_long { break; }
        let mut k = 0 as u32;
        while k < n as u32 {
            sb.push_byte(buf[k]);
            k = k + 1 as u32;
        }
    }
}

fn path_len(sl: Slice<u8>, n: u32) -> u32 {
    let mut end = n;
    while end > 0 as u32
          && (sl[end - 1 as u32] == 10 as u8 || sl[end - 1 as u32] == 13 as u8) {
        end = end - 1 as u32;
    }
    return end;
}

fn report_error(a: Allocator, e: *const CompileError) {
    let mut sb = StringBuilder::with_capacity(a, 128 as u32);
    e.fmt(&sb);
    sb.push_str("\n");
    let sl = sb.as_slice();
    sys::sys_write(2 as c_int, &sl[0] as *const c_uchar, sb.length() as c_ulong);
}

fn flush(sb: *const StringBuilder) {
    let bytes = sb.as_slice();
    sys::sys_write(1 as c_int, &bytes[0] as *const c_uchar, sb.length() as c_ulong);
}

fn arena_cap_for(srclen: u32) -> u32 {
    return 1048576 as u32 + srclen * 128 as u32;
}


// Drop's diagnostics arrive as a latch rather than a raise: the pass rewrites a
// whole program and the reference stops at the first, so the port latches the
// first and the driver reports it here.
fn drop_report(a: Allocator, e: Option<*const CompileError>) {
    match e {
        Option::Some(err) => { report_error(a, err); }
        | Option::None => { }
    }
    return;
}

fn main() {
    let a = default_allocator();

    let mut pbuf = StringBuilder::with_capacity(a, 256 as u32);
    read_all(0 as c_int, &pbuf);
    let plen = path_len(pbuf.as_slice(), pbuf.length());
    let mut parena = Arena::with_capacity(a, 1024 as u32);
    let path = str::from_slice(&parena, pbuf.as_slice()[0 as u32..plen]);

    let fd: c_int = sys::sys_open(path as *const c_char, 0 as c_int);
    if fd < 0 as c_int { return; }
    sys::sys_close(fd);

    let mut ar = Arena::with_capacity(a, arena_cap_for(total_source_bytes(a, path)));

    match load(a, &ar, path) {
        Result::Ok(prog) => {
            match check_program(a, &ar, &prog) {
                Result::Ok(tp) => {
                    let mut tprog = tp;
                    drop_report(a, drop_insert(a, &ar, &tprog));
                    let mut out = StringBuilder::with_capacity(a, 16384 as u32);
                    gen_program(a, &ar, &tprog, &out);
                    flush(&out);
                }
                | Result::Err(e) => { report_error(a, e); }
            }
        }
        | Result::Err(e) => { report_error(a, e); }
    }
}
