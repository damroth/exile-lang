// The same struct, BOUND - accepted, so the rule does not spread from the
// discarded shape to the ordinary one.
pub mod raw { extern fn make_c_allocator() -> Allocator; extern fn mk() -> own *int; }
struct Box { alloc: Allocator, p: own *int }
fn main() {
    let a = raw::make_c_allocator();
    let b = Box { alloc: a, p: raw::mk() };
    *b.p = 1; println(*b.p);
}
