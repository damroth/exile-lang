# dune build artifacts
_build/

# everything in examples/ except .exl sources, .expected stdout
# snapshots, and FFI stub C files (`_stub.c` / `_stub.h`).  Generated
# .c and per-target binaries stay excluded.
examples/*
!examples/*.exl
!examples/*.expected
!examples/*_stub.c
!examples/*_stub.h
!examples/multi_file/
examples/multi_file/*
!examples/multi_file/*.exl
!examples/multi_file/*.expected
!examples/prelude/
examples/prelude/*
!examples/prelude/*.exl
!examples/selfhost/
examples/selfhost/*
!examples/selfhost/*.exl
!examples/selfhost/lex_errors/
examples/selfhost/lex_errors/*
!examples/selfhost/lex_errors/*.exl

# opam
*.install
.opam-switch/

# internal worklog
WORKLOG.md
SELFHOST-WORKLOG.md

# editor
.merlin
*.annot
