# dune build artifacts
_build/

# ad-hoc `-o out/...` scratch binaries.  The real build output lives in
# _build/out (see OUT in the Makefile); a top-level out/ is always junk.
/out/

# The self-host compiler (src/) is Exile SOURCE — only .exl belongs in git.
# Generated .c / binaries dropped next to a source file stay excluded.
src/*
!src/*.exl
!src/lex_errors/
src/lex_errors/*
!src/lex_errors/*.exl
!src/parse_errors/
src/parse_errors/*
!src/parse_errors/*.exl
!src/tc_errors/
src/tc_errors/*
!src/tc_errors/*.exl
!src/tc_errors/README.md

# everything in examples/ except .exl sources, .expected stdout
# snapshots, and FFI stub C files (`_stub.c` / `_stub.h`).  Generated
# .c and per-target binaries stay excluded.
examples/*
!examples/*.exl
!examples/*.expected
!examples/*_stub.c
!examples/*_stub.h
!examples/multi_file/
examples/multi_file/*
!examples/multi_file/*.exl
!examples/multi_file/*.expected
!examples/prelude/
examples/prelude/*
!examples/prelude/*.exl

# opam
*.install
.opam-switch/

# internal worklog
WORKLOG.md
SELFHOST-WORKLOG.md
SELFHOST-PLUMBING-REGISTER.md

# editor
.merlin
*.annot

# Emitted C next to a fixture: a `--target host` build without `--c-out` drops
# its C beside the source.  The gates now pass `--c-out` into _build, and this
# is the belt: a fixture directory holds .exl, never build output.
tests/*/*.c
# ...but a hand-written C companion is not build output.  The rule above was
# written to stop emitted C and would have silently swallowed these: the gate
# would stay green locally and fail on a fresh clone with a missing stub.
!tests/*/*_stub.c
